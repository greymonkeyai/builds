{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#0240653018494cb09278c4db1a4252bf","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Demonstration harness: exercises the 11 observable demonstrations from\nprompt.md against a fresh runtime and writes evidence/demos/*.md transcripts.\n\nUsage: python scripts/demo.py          (fresh runtime under runtime/demo)\n       python scripts/demo.py --keep   (reuse existing runtime)\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport shutil\nimport sys\nimport time\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#0240653018494cb09278c4db1a4252bf","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Demonstration harness: exercises the 11 observable demonstrations from\nprompt.md against a fresh runtime and writes evidence/demos/*.md transcripts.\n\nUsage: python scripts/demo.py          (fresh runtime under runtime/demo)\n       python scripts/demo.py --keep   (reuse existing runtime)\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport shutil\nimport sys\nimport time\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(0, ROOT)\n\nfrom app.host import Ctx\nfrom app import builtins as B\nfrom app import needs as N\nfrom app import tools as T\nfrom app import seed as S\n\nOUT = os.path.join(ROOT, \"evidence\", \"demos\")\nRUNTIME = os.path.join(ROOT, \"runtime\", \"demo\")\n\nresults = []\n\n\ndef w(demo: int, title: str, body: list[str]):\n    path = os.path.join(OUT, f\"{demo:02d}-{title}.md\")\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"\\n\".join(body))\n    results.append({\"demo\": demo, \"title\": title, \"file\": os.path.basename(path)})\n    print(f\"demo {demo}: {title} -> {os.path.basename(path)}\")\n\n\ndef fmt(x, n=1600):\n    s = json.dumps(x, indent=1, ensure_ascii=False, default=str)\n    return s[:n] + (\"…\" if len(s) > n else \"\")\n\n\ndef rows(ctx, pred, subj=None, n=5):\n    rs = ctx.ledger.query(subject=subj, predicate=pred)\n    return [r.to_row() for r in rs[-n:]]\n\n\ndef main():\n    keep = \"--keep\" in sys.argv\n    if not keep:\n\u001b[0m[... 263 lines omitted ...]\n        f.write(f\"\\nledger at end: {ctx2.ledger.stats()}\\n\")\n    print(\"index written\")\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"Launch verification probe. Boots a second Meridian instance on port 9761\nwith an isolated runtime dir, polls the API, proves the steward runs while the\nserver answers, and writes evidence/launch/probe-<ts>.json.\n\nUsage: python scripts/probe.py\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nimport urllib.request\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n\n\ndef get(url, timeout=3.0):\n    with urllib.request.urlopen(url, timeout=timeout) as r:\n        return json.loads(r.read().decode())\n\n\ndef main():\n    runtime = os.path.join(ROOT, \"runtime\", \"probe\")\n    os.makedirs(runtime, exist_ok=True)\n    proc = subprocess.Popen(\n        [sys.executable, \"-m\", \"app\", \"--port\", \"9761\",\n         \"--runtime\", runtime],\n        cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n        text=True)\n    out = {\"launched\": False, \"checks\": {}, \"ok\": False}\n    try:\n        # wait for serve\n        base = \"http://127.0.0.1:9761\"\n        for _ in range(60):\n            try:\n                get(base + \"/api/honesty\", timeout=3.0)\n                out[\"launched\"] = True\n                break\n            except Exception:\n                time.sleep(0.5)\n        if not out[\"launched\"]:\n            print(\"FAIL: server did not come up\")\n            return out\n        st = get(base + \"/api/state\")\n        out[\"checks\"][\"state.roster\"] = len(st.get(\"roster\", []))\n        out[\"checks\"][\"state.tools\"] = len(st.get(\"tools\", []))\n        out[\"checks\"][\"honesty.ledger.durable\"] = st[\"honesty\"][\"ledger\"][\"durable\"]\n        out[\"checks\"][\"engine.llm.mode\"] = st[\"honesty\"][\"engines\"][\"llm\"][\"mode\"]\n        # chat round trip\n        t0 = time.time()\n        r = get(base + \"/api/state\")  # warm\n        chat = None\n        try:\n            req = urllib.request.Request(\n                base + \"/api/chat\", data=json.dumps(\n                    {\"text\": \"probe ping\"}).encode(),\n                headers={\"Content-Type\": \"application/json\"})\n            with urllib.request.urlopen(req, timeout=90) as resp:\n                chat = json.loads(resp.read().decode())\n        except Exception as e:\n            chat = {\"ok\": False, \"error\": repr(e)}\n        out[\"checks\"][\"chat.ms\"] = int((time.time() - t0) * 1000)\n        out[\"checks\"][\"chat.ok\"] = bool(chat and chat.get(\"ok\"))\n        out[\"checks\"][\"chat.intents\"] = (chat or {}).get(\"result\", {}).get(\"intents\")\n        # steward ran while serving?\n        runs = get(base + \"/api/log?kind=steward&limit=5\").get(\"rows\", [])\n        out[\"checks\"][\"steward.runs\"] = len(runs)\n        # durability: ledger file exists and non-empty\n        lp = os.path.join(runtime, \"ledger.jsonl\")\n        out[\"checks\"][\"ledger.file.bytes\"] = os.path.getsize(lp) if os.path.exists(lp) else 0\n        out[\"checks\"][\"launch.assertion\"] = bool(get(\n            base + \"/api/library?predicate=launch:report&limit=1\").get(\"rows\"))\n        out[\"ok\"] = (out[\"launched\"] and out[\"checks\"][\"chat.ok\"]\n                     and out[\"checks\"][\"state.tools\"] > 10\n                     and out[\"checks\"][\"ledger.file.bytes\"] > 0)\n        return out\n    finally:\n        proc.terminate()\n        try:\n            proc.wait(timeout=5)\n        except Exception:\n            proc.kill()\n        ts = time.strftime(\"%Y%m%d-%H%M%S\")\n        ep = os.path.join(ROOT, \"evidence\", \"launch\", f\"probe-{ts}.json\")\n        with open(ep, \"w\") as f:\n            json.dump(out, f, indent=2)\n        print(json.dumps(out, indent=2))\n        print(\"probe evidence:\", ep)\n\n\nif __name__ == \"__main__\":\n    main()"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
