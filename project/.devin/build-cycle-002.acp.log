{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call","toolCallId":"exec:0#083f99f3583b49d0a58858cf55c69eca","title":"Ran python in .\\version 0.3.0.002","kind":"execute","content":[{"type":"content","content":{"type":"resource","resource":{"mimeType":"text/x-shellscript","text":"python -c \"\nimport os, tempfile\nfrom app.host import Ctx\nimport app.builtins as B\nctx = Ctx(os.path.abspath(''), tempfile.mkdtemp())\nB.register_builtins(ctx)\nimport app.connectors as C\nics = '''BEGIN:VCALENDAR\nBEGIN:VEVENT\nSUMMARY:test event\nDTSTART:20300101T1500\nEND:VEVENT\nEND:VCALENDAR'''\np = os.path.join(ctx.runtime, 't.ics'); open(p,'w').write(ics)\nC.configure(ctx, 'ics-calendar', p)\nprint('ics:', C.run(ctx, 'ics-calendar'))\nprint('events:', [a.value['v'] for a in ctx.ledger.query(predicate='calendar:event')])\nC.configure(ctx, 'files', ctx.runtime)\nprint('files:', C.run(ctx, 'files'))\nC.configure(ctx, 'rss', 'https://feeds.bbci.co.uk/news/rss.xml')\nprint('rss:', C.run(ctx, 'rss', {'max': 3}))\" 2>&1","uri":"tool://preview"},"_meta":{"cognition.ai/preview_is_shell_command":true}}}],"rawInput":{"command":"cd \"C:/builds/project/version 0.3.0.002\" && python -c \"\nimport os, tempfile\nfrom app.host import Ctx\nimport app.builtins as B\nctx = Ctx(os.path.abspath(''), tempfile.mkdtemp())\nB.register_builtins(ctx)\nimport app.connectors as C\nics = '''BEGIN:VCALENDAR\nBEGIN:VEVENT\nSUMMARY:test event\nDTSTART:20300101T1500\nEND:VEVENT\nEND:VCALENDAR'''\np = os.path.join(ctx.runtime, 't.ics'); open(p,'w').write(ics)\nC.configure(ctx, 'ics-calendar', p)\nprint('ics:', C.run(ctx, 'ics-calendar'))\nprint('events:', [a.value['v'] for a in ctx.ledger.query(predicate='calendar:event')])\nC.configure(ctx, 'files', ctx.runtime)\nprint('files:', C.run(ctx, 'files'))\nC.configure(ctx, 'rss', 'https://feeds.bbci.co.uk/news/rss.xml')\nprint('rss:', C.run(ctx, 'rss', {'max': 3}))\" 2>&1 | tail -8"},"_meta":{"cognition