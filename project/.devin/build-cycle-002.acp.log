{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:1#5953406476994a7db99a241c3b426f96","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"# Direction gate (UserPromptSubmit): injects the cycle-gate rule into the agent's context.\n# A stricter check — e.g. detecting ambiguous directions — evolves per project with use.\n@{\n  hookSpecificOutput = @{\n    hookEventName    = 'UserPromptSubmit'\n    additionalContext = 'Cycle gate: clarify the direction sufficiently before building; reject ambiguous directions as\u001b[0m \u001b[0m\ninadequate rather than running them.'\n  }\n} | ConvertTo-Json -Depth 5 -Compress\n# Completion gate (Stop): blocks the session from stopping until the cycle entry's\n# Result field is filled. Evolved 2026-11-18: the coordinator seeds cycle entries, so\n# '### Cycle' presence alone is insufficient. The JEV verdict is recorded afterward by\n# a separate session - requiring judge_model here would deadlock the builder.\nif ((Test-Path devlog.md) -and\n    (Select-String -Path devlog.md -Pattern '### Cycle' -Quiet) -and\n    -not (Select-String -Path devlog.md -Pattern '\\*\\*Result:\\*\\*\\s*<pending>' -Quiet)) {\n  exit 0\n}\n@{ decision = 'block'; reason = 'devlog.md cycle entry still shows Result: <pending> - record what this cycle built (or\u001b[0m \u001b[0m\nits failure) before stopping.' } | ConvertTo-Json -Compress\n{\n  \"UserPromptSubmit\": [\n    {\n      \"matcher\": \"\",\n      \"hooks\": [\n        { \"type\": \"command\", \"command\": \"powershell -NoProfile -File .devin/direction-gate.ps1\" }\n      ]\n    }\n  ],\n  \"Stop\": [\n    {\n      \"matcher\": \"\",\n      \"hooks\": [\n        { \"type\": \"command\", \"command\": \"powershell -NoProfile -File .devin/check-devlog.ps1\" }\n      ]\n    }\n  ]\n}\n===JEV-REF==="}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPrev