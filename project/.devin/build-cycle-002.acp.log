esent_attention(ctx, att[\"findings\"])\r\n            report[\"ran\"].append({\"temporal-attention\": att[\"context\"]})\r\n        except Exception as e:\r\n            report[\"ran\"].append({\"temporal-attention\": {\"error\": repr(e)}})\r\n    if \"compact-check\" in duties:'''\r\nassert old in s, \"7b\"\r\ns = s.replace(old, new, 1)\r\n\r\n# 8. fn_generate_portrait — rich generated art (C-PersonalityArt + glass)\r\nold = '''def fn_generate_portrait(ctx, inp, grant):\r\n    p = ctx.personas.get(inp[\"personaId\"])\r\n    if not p:\r\n        return {\"ok\": False, \"error\": \"no persona\"}\r\n    r = ctx.engines.portrait.render(p, ctx.artifacts)\r\n    ctx.append(f\"persona:{p['id']}\", \"persona:portrait\",\r\n               {\"artifact\": r.get(\"artifact\"), \"engine\": \"inproc-svg\"},\r\n               \"engine:portrait\", basis={\"kind\": \"execution\"})\r\n    return r'''\r\nnew = '''def fn_generate_portrait(ctx, inp, grant):\r\n    p = ctx.personas.get(inp[\"personaId\"])\r\n    if not p:\r\n        return {\"ok\": False, \"error\": \"no persona\"}\r\n    from . import art as ART\r\n    r = ART.render_art(ctx, p, os.path.join(ctx.artifacts, \"persona-art\"))\r\n    ctx.append(f\"persona:{p['id']}\", \"persona:portrait\",\r\n               {\"artifact\": r.get(\"artifact\"), \"engine\": \"inproc-svg-glass\",\r\n                \"motif\": r.get(\"motif\"), \"frame\": r.get(\"frame\")},\r\n               \"engine:portrait\", basis={\"kind\": \"execution\"})\r\n    p[\"art\"] = {\"artifact\": r[\"artifact\"], \"motif\": r[\"motif\"],\r\n                \"frame\": r[\"frame\"], \"dataUrl\": r[\"dataUrl\"]}\r\n    ctx.personas._save()\r\n    return {k: v for k, v in r.items() if k != \"svg\"}'''\r\nassert old in s, \"8\"\r\ns = s.replace(old, new, 1)\r\n\r\n# 9. fn_build_list — geographic set requests delegate to set-build machinery\r\nold = '''    criteria = (inp.get(\"criteria\") or \"\").strip()\r\n    raw = inp.get(\"items\") or []'''\r\nnew = '''    criteria = (inp.get(\"criteria\") or \"\").strip()\r\n    geo = re.search(\r\n        r\"(?:all\\\\s+)?(?:the\\\\s+)?(cities|city|towns?|municipalit(?:y|ies)|\"\r\n        r\"boroughs?|villages?)\\\\s+in\\\\s+([A-Z][A-Za-z .'-]+)$\", criteria, re.I)\r\n    if geo and not inp.get(\"items\"):\r\n        from . import setbuild as SB\r\n        kind = geo.group(1).lower()\r\n        kind = {\"cities\": \"city\", \"city\": \"city\", \"municipalities\":\r\n                \"municipality\"}.get(kind, kind.rstrip(\"s\"))\r\n        opened = SB.fn_set_project_open(ctx, {\r\n            \"region\": geo.group(2).strip().title(), \"memberKind\": kind,\r\n            \"criteria\": criteria, \"minCount\": inp.get(\"minCount\") or 1}, grant)\r\n        collected = SB.fn_set_build_collect(\r\n            ctx, {\"needId\": opened[\"needId\"]}, grant)\r\n        produced = collected.get(\"produced\") or []\r\n        return {\"ok\": collected.get(\"ok\", False), \"setBuild\": True,\r\n                \"projectId\": opened[\"projectId\"], \"needId\": opened[\"needId\"],\r\n                \"criteria\": criteria, \"matched\": produced,\r\n                \"produced\": produced, \"memberCount\": collected.get(\"memberCount\"),\r\n                \"artifact\": collected.get(\"artifact\"),\r\n                \"agreement\": collected.get(\"agreement\"),\r\n                \"competition\": collected.get(\"competition\"),\r\n                \"error\": collected.get(\"error\")}\r\n    raw = inp.get(\"items\") or []'''\r\nassert old in s, \"9\"\r\ns = s.replace(old, new, 1)\r\n\r\nopen(p, 'w', encoding='utf-8').write(s)\r\nast.parse(s)\r\nprint(\"builtins patch A ok\")\r\n","_meta":{"cognition.ai/toolCallId":"write:0#951b7ba8ad8541538a096385e9a9bba1","cognition.ai/suppressApproval":true}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call_update","toolCallId":"write:0#951b7ba8ad8541538a096385e9a9bba1","status":"in_progress","content":[{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\scripts\\_patch_builtins.py","newText":"# one-off integration patch for builtins.py (deleted after use)\nimport ast, io, re\n\np = 'app/builtins.py'\ns = open(p, encoding='utf-8').read()\n\n# 1. cmd_persona_mint — handle ethics-gate refusal\nold = '''def cmd_persona_mint(ctx, inp, grant):\n    p = ctx.personas.mint(\n        inp[\"name\"], inp.get(\"traits\") or [], inp.get(\"interests\") or [],\n        inp.get(\"lens\") or {}, inp.get(\"voice\"), inp.get(\"imitates\"),\n        inp.get(\"claimant\", \"principal\"), admonish_cb=ctx.admonish)\n    return {\"personaId\": p[\"id\"], \"admonished\": bool(p.get(\"imitates\"))}'''\nnew = '''def cmd_persona_mint(ctx, inp, grant):\n    p = ctx.personas.mint(\n        inp[\"name\"], inp.get(\"traits\") or [], inp.get(\"interests\") or [],\n        inp.get(\"lens\") or {}, inp.get(\"voice\"), inp.get(\"imitates\"),\n        inp.get(\"claimant\", \"principal\"), admonish_cb=ctx.admonish)\n    if p.get(\"refused\"):\n        return {\"ok\": False, \"refused\": True, \"gate\": p[\"gate\"]}\n    return {\"personaId\": p[\"id\"], \"admonished\": bool(p.get(\"imitates\")),\n            \"ethicsVerdict\": p.get(\"ethicsVerdict\")}'''\nassert old in s, \"1\"\ns = s.replace(old, new, 1)\n\n# 2. cmd_persona_speak — serialized speech floor (F6/C-SpeechFloor)\nold = '''    if inp.get(\"speak\", True):\n        ctx.invoke(\"speak-voice\", {\"text\": inp[\"text\"], \"personaId\": p[\"id\"]})\n    return card'''\nnew = '''    if inp.get(\"speak\", True):\n        adm = ctx.floor.enqueue(inp[\"text\"], persona=p,\n                                cause=inp.get(\"cause\", \"response\"))\n        card[\"floorAdmission\"] = adm[\"id\"]\n    return card'''\nassert old in s, \"2\"\ns = s.replace(old, new, 1)\n\n# 3. sequential respondents (F6/C-SequentialRespondents)\nold = '''    replies = []\n    for c in chosen:\n        p = ctx.personas.get(c[\"personaId\"])\n        if not p:\n            continue\n        comp = compose_for(ctx, p, text)\n        card = ctx.invoke(\"persona.speak\",\n                          {\"personaId\": p[\"id\"], \"text\": comp[\"text\"],\n                           \"cause\": \"need:response\", \"engine\": comp[\"engine\"],\n                           \"relates\": [st.get(\"assertionId\")]},)\n        replies.append({\"personaId\": p[\"id\"], \"name\": p[\"name\"],\n                        \"score\": c[\"score\"], \"engine\": comp[\"engine\"]})'''\nnew = '''    replies = []\n    for i, c in enumerate(chosen):\n        p = ctx.personas.get(c[\"personaId\"])\n        if not p:\n            continue\n        comp = compose_for(ctx, p, text)\n        ctx.invoke(\"persona.speak\",\n                   {\"personaId\": p[\"id\"], \"text\": comp[\"text\"],\n                    \"cause\": \"need:response\", \"engine\": comp[\"engine\"],\n                    \"relates\": [st.get(\"assertionId\")]},)\n        replies.append({\"personaId\": p[\"id\"], \"name\": p[\"name\"],\n                        \"score\": c[\"score\"], \"engine\": comp[\"engine\"],\n                        \"sequence\": i + 1})\n        ctx.append(\"chat\", \"decision:respondent\",\n                   {\"personaId\": p[\"id\"], \"sequence\": i + 1,\n                    \"score\": c[\"score\"], \"needId\": nid},\n                   \"model:decision\", basis={\"kind\": \"execution\"})'''\nassert old in s, \"3\"\ns = s.replace(old, new, 1)\n\n# 4. compose_for — temporal reasoning informs persona replies (F2)\nold = '''    hist = chat_history(ctx, 8)\n    lens = persona.get(\"lens\") or {}\n    style = lens.get(\"style\", \"measured\")\n    interests = \", \".join(persona.get(\"interests\") or [])'''\nnew = '''    hist = chat_history(ctx, 8)\n    lens = persona.get(\"lens\") or {}\n    style = lens.get(\"style\", \"measured\")\n    interests = \", \".join(persona.get(\"interests\") or [])\n    temporal_note = None\n    try:\n        from . import temporal as T_\n        temporal_note = T_.note_for_persona(ctx, persona, user_text)\n    except Exception:\n        temporal_note = None'''\nassert old in s, \"4\"\ns = s.replace(old, new, 1)\n\nold = '''              f\"Recent conversation: \" +\n              \"; \".join(f\"{h['role']}: {h['text']}\" for h in hist[-4:]) +\n              f\"\\\\nUser said: {user_text}\\\\nRespond in 1-3 sentences, in character, \"\n              f\"through your own lens only.\")'''\nnew = '''              f\"Recent conversation: \" +\n              \"; \".join(f\"{h['role']}: {h['text']}\" for h in hist[-4:]) +\n              (f\"\\\\n{temporal_note}\" if temporal_note else \"\") +\n              f\"\\\\nUser said: {user_text}\\\\nRespond in 1-3 sentences, in character, \"\n              f\"through your own lens only.\")'''\nassert old in s, \"4b\"\ns = s.replace(old, new, 1)\n\nold = '''        text = (f\"{persona['name']} ({style} lens on {interests or 'general'}): \"\n                f\"on \\u201c{focus}\\u201d \\u2014 my read is shaped by {interests or 'the ledger'}. \"\n                f\"Tell me which angle you want explored and I'll dig into the ledger for it.\")\n        return {\"text\": text, \"engine\": \"template-fallback (llm stub declared)\",\n                \"stub\": True}'''\nnew = '''        note_bit = f\" {temporal_note}\" if temporal_note else \"\"\n        text = (f\"{persona['name']} ({style} lens on {interests or 'general'}): \"\n                f\"on \\u201c{focus}\\u201d \\u2014 my read is shaped by {interests or 'the ledger'}.\"\n                + note_bit +\n                f\" Tell me which angle you want explored and I'll dig into the ledger for it.\")\n        return {\"text\": text, \"engine\": \"template-fallback (llm stub declared)\",\n                \"stub\": True, \"temporalNote\": bool(temporal_note)}'''\nassert old in s, \"4c\"\ns = s.replace(old, new, 1)\n\n# 5. fn_speak_voice — carry persona voice prefs to the competing renderers\nold = '''    for t in ranked:\n        r = ctx.invoke(t[\"id\"], {\"text\": text, \"personaId\": inp.get(\"personaId\")})'''\nnew = '''    voice = inp.get(\"voice\")\n    if not voice and inp.get(\"personaId\"):\n        p = ctx.personas.get(inp[\"personaId\"])\n        voice = (p or {}).get(\"voice\")\n    for t in ranked:\n        r = ctx.invoke(t[\"id\"], {\"text\": text, \"personaId\": inp.get(\"personaId\"),\n                                 \"voice\": voice})'''\nassert old in s, \"5\"\ns = s.replace(old, new, 1)\n\n# 6. fn_render_speech_sapi — voice passthrough\nold = '''def fn_render_speech_sapi(ctx, inp, grant):\n    return ctx.engines.tts.speak_local(inp[\"text\"])'''\nnew = '''def fn_render_speech_sapi(ctx, inp, grant):\n    return ctx.engines.tts.speak_local(inp[\"text\"], voice=inp.get(\"voice\"),\n                                       out_wav=inp.get(\"artifact\"))'''\nassert old in s, \"6\"\ns = s.replace(old, new, 1)\n\n# 7. steward duty: temporal attention (F2)\nold = '''              [\"drain-needs\", \"countdown\", \"calendar-scan\",\n               \"source-confidence\", \"compact-check\"])'''\nnew = '''              [\"drain-needs\", \"countdown\", \"calendar-scan\",\n               \"source-confidence\", \"compact-check\", \"temporal-attention\"])'''\nassert old in s, \"7\"\ns = s.replace(old, new, 1)\n\nold = '''    if \"compact-check\" in duties:'''\nnew = '''    if \"temporal-attention\" in duties:\n        try:\n            from . import temporal as T_\n            att = T_.steward_attention(ctx)\n            if att[\"findings\"]:\n                T_.present_attention(ctx, att[\"findings\"])\n            report[\"ran\"].append({\"temporal-attention\": att[\"context\"]})\n        except Exception as e:\n            report[\"ran\"].append({\"temporal-attention\": {\"error\": repr(e)}})\n    if \"compact-check\" in duties:'''\nassert old in s, \"7b\"\ns = s.replace(old, new, 1)\n\n# 8. fn_generate_portrait — rich generated art (C-PersonalityArt + glass)\nold = '''def fn_generate_portrait(ctx, inp, grant):\n    p = ctx.personas.get(inp[\"personaId\"])\n    if not p:\n        return {\"ok\": False, \"error\": \"no persona\"}\n    r = ctx.engines.portrait.render(p, ctx.artifacts)\n    ctx.append(f\"persona:{p['id']}\", \"persona:portrait\",\n               {\"artifact\": r.get(\"artifact\"), \"engine\": \"inproc-svg\"},\n               \"engine:portrait\", basis={\"kind\": \"execution\"})\n    return r'''\nnew = '''def fn_generate_portrait(ctx, inp, grant):\n    p = ctx.personas.get(inp[\"personaId\"])\n    if not p:\n        return {\"ok\": False, \"error\": \"no persona\"}\n    from . import art as ART\n    r = ART.render_art(ctx, p, os.path.join(ctx.artifacts, \"persona-art\"))\n    ctx.append(f\"persona:{p['id']}\", \"persona:portrait\",\n               {\"artifact\": r.get(\"artifact\"), \"engine\": \"inproc-svg-glass\",\n                \"motif\": r.get(\"motif\"), \"frame\": r.get(\"frame\")},\n               \"engine:portrait\", basis={\"kind\": \"execution\"})\n    p[\"art\"] = {\"artifact\": r[\"artifact\"], \"motif\": r[\"motif\"],\n                \"frame\": r[\"frame\"], \"dataUrl\": r[\"dataUrl\"]}\n    ctx.personas._save()\n    return {k: v for k, v in r.items() if k != \"svg\"}'''\nassert old in s, \"8\"\ns = s.replace(old, new, 1)\n\n# 9. fn_build_list — geographic set requests delegate to set-build machinery\nold = '''    criteria = (inp.get(\"criteria\") or \"\").strip()\n    raw = inp.get(\"items\") or []'''\nnew = '''    criteria = (inp.get(\"criteria\") or \"\").strip()\n    geo = re.search(\n        r\"(?:all\\\\s+)?(?:the\\\\s+)?(cities|city|towns?|municipalit(?:y|ies)|\"\n        r\"boroughs?|villages?)\\\\s+in\\\\s+([A-Z][A-Za-z .'-]+)$\", criteria, re.I)\n    if geo and not inp.get(\"items\"):\n        from . import setbuild as SB\n        kind = geo.group(1).lower()\n        kind = {\"cities\": \"city\", \"city\": \"city\", \"municipalities\":\n                \"municipality\"}.get(kind, kind.rstrip(\"s\"))\n        opened = SB.fn_set_project_open(ctx, {\n            \"region\": geo.group(2).strip().title(), \"memberKind\": kind,\n            \"criteria\": criteria, \"minCount\": inp.get(\"minCount\") or 1}, grant)\n        collected = SB.fn_set_build_collect(\n            ctx, {\"needId\": opened[\"needId\"]}, grant)\n        produced = collected.get(\"produced\") or []\n        return {\"ok\": collected.get(\"ok\", False), \"setBuild\": True,\n                \"projectId\": opened[\"projectId\"], \"needId\": opened[\"needId\"],\n                \"criteria\": criteria, \"matched\": produced,\n                \"produced\": produced, \"memberCount\": collected.get(\"memberCount\"),\n                \"artifact\": collected.get(\"artifact\"),\n                \"agreement\": collected.get(\"agreement\"),\n                \"competition\": collected.get(\"competition\"),\n                \"error\": collected.get(\"error\")}\n    raw = inp.get(\"items\") or []'''\nassert old in s, \"9\"\ns = s.replace(old, new, 1)\n\nopen(p, 'w', encoding='utf-8').write(s)\nast.parse(s)\nprint(\"builtins patch A ok\")\n","_meta":{"cognition.ai/linesAdded":219,"cognition.ai/linesRemoved":0}}],"_meta":{"cognition.ai/inferenceToolName":"write"}}}}
