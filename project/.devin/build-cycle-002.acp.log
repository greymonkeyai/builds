{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#13473ba8850f48c3b6cb89fe63a92eb1","status":"in_progress","content":[{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\engines.py","oldText":"\"\"\"Engine seams: LLM, TTS, STT, portrait. Honest modes only.\r\n\r\nEach engine reports its real mode (live/stub/unavailable) at probe time; modes\r\nare asserted to the ledger (engine:mode) and surfaced on the honesty banner.\r\nThere is no silent degradation: a stub fallback is always declared.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport base64\r\nimport hashlib\r\nimport json\r\nimport os\r\nimport subprocess\r\nimport urllib.request\r\nfrom typing import Optional\r\n\r\n\r\ndef _http_json(url: str, payload: Optional[dict] = None, timeout: float = 2.0):\r\n    try:\r\n        data = json.dumps(payload).encode() if payload is not None else None\r\n        req = urllib.request.Request(url, data=data,\r\n                                     headers={\"Content-Type\": \"application/json\"})\r\n        with urllib.request.urlopen(req, timeout=timeout) as r:\r\n            return json.loads(r.read().decode())\r\n    except Exception:\r\n        return None\r\n\r\n\r\nclass LLMEngine:\r\n    \"\"\"Local inference via Ollama when reachable; otherwise a DECLARED\r\n    template fallback (stubFallback: on, never silent).\"\"\"\r\n\r\n    def __init__(self, endpoint: str = \"http://localhost:11434\"):\r\n        self.endpoint = endpoint\r\n        self.mode = \"stub\"\r\n        self.model = None\r\n        self.probe()\r\n\r\n    def probe(self) -> dict:\r\n        tags = _http_json(f\"{self.endpoint}/api/tags\", timeout=1.0)\r\n        if tags and tags.get(\"models\"):\r\n            self.mode = \"live-ollama\"\r\n            names = [m.get(\"name\", \"\") for m in tags[\"models\"]]\r\n            prefer = (\"llama\", \"qwen\", \"mistral\", \"phi3\", \"phi4\", \"gemma\",\r\n                      \"deepseek\", \"granite\", \"smollm\")\r\n            self.model = next((n for n in names\r\n                               if any(p in n.lower() for p in prefer)),\r\n                              names[0] if names else None)\r\n        else:\r\n            self.mode = \"stub\"\r\n            self.model = None\r\n        return {\"engine\": \"llm\", \"mode\": self.mode, \"model\": self.model}\r\n\r\n    def complete(self, prompt: str, system: str = \"\", max_tokens: int = 220) -> dict:\r\n        if self.mode == \"live-ollama\" and self.model:\r\n            r = _http_json(f\"{self.endpoint}/api/generate\",\r\n                           {\"model\": self.model, \"prompt\": prompt,\r\n                            \"system\": system, \"stream\": False,\r\n                            \"options\": {\"num_predict\": max_tokens}}, timeout=60)\r\n            if r and r.get(\"response\"):\r\n                return {\"ok\": True, \"text\": r[\"response\"].strip(), \"engine\": \"ollama\",\r\n                        \"model\": self.model, \"stub\": False}\r\n        return {\"ok\": True, \"text\": self._fallback(prompt, system),\r\n                \"engine\": \"template\", \"stub\": True}\r\n\r\n    @staticmethod\r\n    def _fallback(prompt: str, system: str) -> str:\r\n        return (\"[declared stub — no local inference host reachable] \"\r\n                + (prompt[:400]))\r\n\r\n\r\nclass TTSEngine:\r\n    \"\"\"Speech as two independently-defined competing tools (A13):\r\n    local Windows SAPI vs. remote provider. Neither is hardcoded as primary;\r\n    the tool-ranking machinery chooses, and the remote tool honestly reports\r\n    'unconfigured' until a source grant exists.\"\"\"\r\n\r\n    def __init__(self):\r\n        self.local_ok = os.name == \"nt\"\r\n        self.remote_configured = False\r\n\r\n    def probe(self) -> dict:\r\n        return {\"engine\": \"tts\",\r\n                \"local\": \"sapi\" if self.local_ok else \"unavailable\",\r\n                \"remote\": \"unconfigured\"}\r\n\r\n    def speak_local(self, text: str, out_wav: Optional[str] = None) -> dict:\r\n        \"\"\"Synthesize via System.Speech (inproc, local). Returns artifact path\r\n        when out_wav given, else speaks aloud.\"\"\"\r\n        if not self.local_ok:\r\n            return {\"ok\": False, \"error\": \"SAPI unavailable on this host\"}\r\n        text_safe = text.replace(\"'\", \"''\")[:2000]\r\n        if out_wav:\r\n            ps = (\"Add-Type -AssemblyName System.Speech; \"\r\n                  \"$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \"\r\n                  f\"$s.SetOutputToWaveFile('{out_wav}'); \"\r\n                  f\"$s.Speak('{text_safe}'); $s.Dispose()\")\r\n        else:\r\n            ps = (\"Add-Type -AssemblyName System.Speech; \"\r\n                  \"$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \"\r\n                  f\"$s.Speak('{text_safe}'); $s.Dispose()\")\r\n        try:\r\n            subprocess.Popen([\"powershell\", \"-NoProfile\", \"-Command\", ps],\r\n                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n            return {\"ok\": True, \"engine\": \"sapi\", \"artifact\": out_wav}\r\n        except Exception as e:\r\n            return {\"ok\": False, \"error\": repr(e)}\r\n\r\n    def speak_remote(self, text: str) -> dict:\r\n        if not self.remote_configured:\r\n            return {\"ok\": False, \"error\": \"remote TTS not configured — no source grant\",\r\n                    \"unconfigured\": True}\r\n        return {\"ok\": False, \"error\": \"remote TTS unreachable\"}\r\n\r\n\r\nclass STTEngine:\r\n    \"\"\"Speech capture: browser-side Web Speech API posts transcripts; the\r\n    server records them as device:speech-transcript witnesses with the reported\r\n    confidence. If the browser lacks the API the UI declares it.\"\"\"\r\n\r\n    def probe(self) -> dict:\r\n        return {\"engine\": \"stt\", \"mode\": \"browser-webSpeech-or-declared-none\"}\r\n\r\n\r\nclass PortraitEngine:\r\n    \"\"\"Deterministic geometric SVG portrait per persona — a real artifact,\r\n    generated locally, no external model claim.\"\"\"\r\n\r\n    def render(self, persona: dict, out_dir: Optional[str] = None) -> dict:\r\n        pid = persona[\"id\"]\r\n        h = hashlib.sha256(pid.encode()).digest()\r\n        c1 = \"#\" + h[:3].hex()\r\n        c2 = \"#\" + h[3:6].hex()\r\n        c3 = \"#\" + h[6:9].hex()\r\n        eyes = h[9] % 4\r\n        mouth = h[10] % 4\r\n        mark = \"\"\r\n        if persona.get(\"imitates\"):\r\n            mark = ('<polygon points=\"88,4 96,12 88,20 80,12\" fill=\"#ffbf00\" '\r\n                    'stroke=\"#000\" stroke-width=\"1\"/>')\r\n        eye_shapes = [\r\n            '<circle cx=\"38\" cy=\"44\" r=\"4\"/><circle cx=\"62\" cy=\"44\" r=\"4\"/>',\r\n            '<rect x=\"34\" y=\"41\" width=\"8\" height=\"6\"/><rect x=\"58\" y=\"41\" width=\"8\" height=\"6\"/>',\r\n            '<circle cx=\"38\" cy=\"44\" r=\"5\" fill=\"none\" stroke-width=\"2\"/><circle cx=\"62\" cy=\"44\" r=\"5\" fill=\"none\" stroke-width=\"2\"/>',\r\n            '<path d=\"M33 44 h10 M57 44 h10\" stroke-width=\"3\"/>',\r\n        ]\r\n        mouth_shapes = [\r\n            '<path d=\"M40 66 q10 8 20 0\" fill=\"none\" stroke-width=\"3\"/>',\r\n            '<rect x=\"42\" y=\"64\" width=\"16\" height=\"4\"/>',\r\n            '<path d=\"M40 68 q10 -6 20 0\" fill=\"none\" stroke-width=\"3\"/>',\r\n            '<circle cx=\"50\" cy=\"66\" r=\"4\"/>',\r\n        ]\r\n        svg = (\r\n            f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\">'\r\n            f'<rect width=\"100\" height=\"100\" rx=\"14\" fill=\"{c1}\"/>'\r\n            f'<circle cx=\"50\" cy=\"50\" r=\"36\" fill=\"{c2}\"/>'\r\n            f'<g fill=\"{c3}\" stroke=\"{c3}\">{eye_shapes[eyes]}{mouth_shapes[mouth]}</g>'\r\n            f'{mark}</svg>')\r\n        artifact = None\r\n        if out_dir:\r\n            os.makedirs(out_dir, exist_ok=True)\r\n            artifact = os.path.join(out_dir, f\"{pid}.svg\")\r\n            with open(artifact, \"w\", encoding=\"utf-8\") as f:\r\n                f.write(svg)\r\n        return {\"ok\": True, \"svg\": svg, \"artifact\": artifact,\r\n                \"dataUrl\": \"data:image/svg+xml;base64,\" +\r\n                           base64.b64encode(svg.encode()).decode()}\r\n\r\n\r\nclass Engines:\r\n    def __init__(self):\r\n        self.llm = LLMEngine()\r\n        self.tts = TTSEngine()\r\n        self.stt = STTEngine()\r\n        self.portrait = PortraitEngine()\r\n\r\n    def report(self) -> dict:\r\n        return {\"llm\": self.llm.probe(), \"tts\": self.tts.probe(),\r\n                \"stt\": self.stt.probe(),\r\n                \"portrait\": {\"engine\": \"portrait\", \"mode\": \"inproc-svg\"}}\r\n","newText":"\"\"\"Engine seams: LLM, TTS, STT, portrait. Honest modes only.\r\n\r\nEach engine reports its real mode (live/stub/unavailable) at probe time; modes\r\nare asserted to the ledger (engine:mode) and surfaced on the honesty banner.\r\nThere is no silent degradation: a stub fallback is always declared.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport base64\r\nimport hashlib\r\nimport json\r\nimport os\r\nimport subprocess\r\nimport urllib.request\r\nfrom typing import Optional\r\n\r\n\r\ndef _http_json(url: str, payload: Optional[dict] = None, timeout: float = 2.0):\r\n    try:\r\n        data = json.dumps(payload).encode() if payload is not None else None\r\n        req = urllib.request.Request(url, data=data,\r\n                                     headers={\"Content-Type\": \"application/json\"})\r\n        with urllib.request.urlopen(req, timeout=timeout) as r:\r\n            return json.loads(r.read().decode())\r\n    except Exception:\r\n        return None\r\n\r\n\r\nclass LLMEngine:\r\n    \"\"\"Local inference via Ollama when reachable; otherwise a DECLARED\r\n    template fallback (stubFallback: on, never silent).\"\"\"\r\n\r\n    def __init__(self, endpoint: str = \"http://localhost:11434\"):\r\n        self.endpoint = endpoint\r\n        self.mode = \"stub\"\r\n        self.model = None\r\n        self.probe()\r\n\r\n    def probe(self) -> dict:\r\n        tags = _http_json(f\"{self.endpoint}/api/tags\", timeout=1.0)\r\n        if tags and tags.get(\"models\"):\r\n            self.mode = \"live-ollama\"\r\n            names = [m.get(\"name\", \"\") for m in tags[\"models\"]]\r\n            prefer = (\"llama\", \"qwen\", \"mistral\", \"phi3\", \"phi4\", \"gemma\",\r\n                      \"deepseek\", \"granite\", \"smollm\")\r\n            self.model = next((n for n in names\r\n                               if any(p in n.lower() for p in prefer)),\r\n                              names[0] if names else None)\r\n        else:\r\n            self.mode = \"stub\"\r\n            self.model = None\r\n        return {\"engine\": \"llm\", \"mode\": self.mode, \"model\": self.model}\r\n\r\n    def complete(self, prompt: str, system: str = \"\", max_tokens: int = 220) -> dict:\r\n        if self.mode == \"live-ollama\" and self.model:\r\n            r = _http_json(f\"{self.endpoint}/api/generate\",\r\n                           {\"model\": self.model, \"prompt\": prompt,\r\n                            \"system\": system, \"stream\": False,\r\n                            \"options\": {\"num_predict\": max_tokens}}, timeout=60)\r\n            if r and r.get(\"response\"):\r\n                return {\"ok\": True, \"text\": r[\"response\"].strip(), \"engine\": \"ollama\",\r\n                        \"model\": self.model, \"stub\": False}\r\n        return {\"ok\": True, \"text\": self._fallback(prompt, system),\r\n                \"engine\": \"template\", \"stub\": True}\r\n\r\n    @staticmethod\r\n    def _fallback(prompt: str, system: str) -> str:\r\n        return (\"[declared stub — no local inference host reachable] \"\r\n                + (prompt[:400]))\r\n\r\n\r\nclass TTSEngine:\r\n    \"\"\"Speech as two independently-defined competing tools (A13):\r\n    local Windows SAPI vs. remote provider. Neither is hardcoded as primary;\r\n    the tool-ranking machinery chooses, and the remote tool honestly reports\r\n    'unconfigured' until a source grant exists.\"\"\"\r\n\r\n    def __init__(self):\r\n        self.local_ok = os.name == \"nt\"\r\n        self.remote_configured = False\r\n        self._voices = None\r\n\r\n    def voices(self) -> list:\r\n        \"\"\"Enumerate installed SAPI voices (cached). Honest: empty when the\r\n        platform cannot enumerate; callers declare rather than fabricate.\"\"\"\r\n        if self._voices is not None:\r\n            return self._voices\r\n        self._voices = []\r\n        if not self.local_ok:\r\n            return self._voices\r\n        try:\r\n            ps = (\"Add-Type -AssemblyName System.Speech; \"\r\n                  \"$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \"\r\n                  \"$s.GetInstalledVoices() | ForEach-Object \"\r\n                  \"{ $_.VoiceInfo.Name }\")\r\n            r = subprocess.run([\"powershell\", \"-NoProfile\", \"-Command\", ps],\r\n                               capture_output=True, text=True, timeout=20)\r\n            self._voices = [v.strip() for v in r.stdout.splitlines() if v.strip()]\r\n        except Exception:\r\n            self._voices = []\r\n        return self._voices\r\n\r\n    def probe(self) -> dict:\r\n        return {\"engine\": \"tts\",\r\n                \"local\": \"sapi\" if self.local_ok else \"unavailable\",\r\n                \"remote\": \"unconfigured\"}\r\n\r\n    def speak_local(self, text: str, out_wav: Optional[str] = None,\r\n                    voice: Optional[dict] = None) -> dict:\r\n        \"\"\"Synthesize via System.Speech (inproc, local). A persona's voice\r\n        preferences (C-VoiceDiversity — portable modifiable settings) select\r\n        the SAPI voice and rate. Returns artifact path when out_wav given,\r\n        else speaks aloud.\"\"\"\r\n        if not self.local_ok:\r\n            return {\"ok\": False, \"error\": \"SAPI unavailable on this host\"}\r\n        voice = voice or {}\r\n        text_safe = text.replace(\"'\", \"''\")[:2000]\r\n        sel = \"\"\r\n        vname = voice.get(\"name\")\r\n        if vname and vname in self.voices():\r\n            sel = f\"$s.SelectVoice('{vname}'); \"\r\n        rate = voice.get(\"rate\")\r\n        if isinstance(rate, (int, float)) and -10 <= rate <= 10:\r\n            sel += f\"$s.Rate = {int(rate)}; \"\r\n        if out_wav:\r\n            ps = (\"Add-Type -AssemblyName System.Speech; \"\r\n                  \"$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \"\r\n                  f\"$s.SetOutputToWaveFile('{out_wav}'); \"\r\n                  f\"$s.Speak('{text_safe}'); $s.Dispose()\")\r\n        else:\r\n            ps = (\"Add-Type -AssemblyName System.Speech; \"\r\n                  \"$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \"\r\n                  f\"$s.Speak('{text_safe}'); $s.Dispose()\")\r\n        try:\r\n            subprocess.Popen([\"powershell\", \"-NoProfile\", \"-Command\", ps],\r\n                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n            return {\"ok\": True, \"engine\": \"sapi\", \"artifact\": out_wav,\r\n                    \"voice\": (voice or {}).get(\"name\") or \"sapi-default\",\r\n                    \"rate\": (voice or {}).get(\"rate\")}\r\n        except Exception as e:\r\n            return {\"ok\": False, \"error\": repr(e)}\r\n\r\n    def speak_remote(self, text: str) -> dict:\r\n        if not self.remote_configured:\r\n            return {\"ok\": False, \"error\": \"remote TTS not configured — no source grant\",\r\n                    \"unconfigured\": True}\r\n        return {\"ok\": False, \"error\": \"remote TTS unreachable\"}\r\n\r\n\r\nclass STTEngine:\r\n    \"\"\"Speech capture: browser-side Web Speech API posts transcripts; the\r\n    server records them as device:speech-transcript witnesses with the reported\r\n    confidence. If the browser lacks the API the UI declares it.\"\"\"\r\n\r\n    def probe(self) -> dict:\r\n        return {\"engine\": \"stt\", \"mode\": \"browser-webSpeech-or-declared-none\"}\r\n\r\n\r\nclass PortraitEngine:\r\n    \"\"\"Deterministic geometric SVG portrait per persona — a real artifact,\r\n    generated locally, no external model claim.\"\"\"\r\n\r\n    def render(self, persona: dict, out_dir: Optional[str] = None) -> dict:\r\n        pid = persona[\"id\"]\r\n        h = hashlib.sha256(pid.encode()).digest()\r\n        c1 = \"#\" + h[:3].hex()\r\n        c2 = \"#\" + h[3:6].hex()\r\n        c3 = \"#\" + h[6:9].hex()\r\n        eyes = h[9] % 4\r\n        mouth = h[10] % 4\r\n        mark = \"\"\r\n        if persona.get(\"imitates\"):\r\n            mark = ('<polygon points=\"88,4 96,12 88,20 80,12\" fill=\"#ffbf00\" '\r\n                    'stroke=\"#000\" stroke-width=\"1\"/>')\r\n        eye_shapes = [\r\n            '<circle cx=\"38\" cy=\"44\" r=\"4\"/><circle cx=\"62\" cy=\"44\" r=\"4\"/>',\r\n            '<rect x=\"34\" y=\"41\" width=\"8\" height=\"6\"/><rect x=\"58\" y=\"41\" width=\"8\" height=\"6\"/>',\r\n            '<circle cx=\"38\" cy=\"44\" r=\"5\" fill=\"none\" stroke-width=\"2\"/><circle cx=\"62\" cy=\"44\" r=\"5\" fill=\"none\" stroke-width=\"2\"/>',\r\n            '<path d=\"M33 44 h10 M57 44 h10\" stroke-width=\"3\"/>',\r\n        ]\r\n        mouth_shapes = [\r\n            '<path d=\"M40 66 q10 8 20 0\" fill=\"none\" stroke-width=\"3\"/>',\r\n            '<rect x=\"42\" y=\"64\" width=\"16\" height=\"4\"/>',\r\n            '<path d=\"M40 68 q10 -6 20 0\" fill=\"none\" stroke-width=\"3\"/>',\r\n            '<circle cx=\"50\" cy=\"66\" r=\"4\"/>',\r\n        ]\r\n        svg = (\r\n            f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\">'\r\n            f'<rect width=\"100\" height=\"100\" rx=\"14\" fill=\"{c1}\"/>'\r\n            f'<circle cx=\"50\" cy=\"50\" r=\"36\" fill=\"{c2}\"/>'\r\n            f'<g fill=\"{c3}\" stroke=\"{c3}\">{eye_shapes[eyes]}{mouth_shapes[mouth]}</g>'\r\n            f'{mark}</svg>')\r\n        artifact = None\r\n        if out_dir:\r\n            os.makedirs(out_dir, exist_ok=True)\r\n            artifact = os.path.join(out_dir, f\"{pid}.svg\")\r\n            with open(artifact, \"w\", encoding=\"utf-8\") as f:\r\n                f.write(svg)\r\n        return {\"ok\": True, \"svg\": svg, \"artifact\": artifact,\r\n                \"dataUrl\": \"data:image/svg+xml;base64,\" +\r\n                           base64.b64encode(svg.encode()).decode()}\r\n\r\n\r\nclass Engines:\r\n    def __init__(self):\r\n        self.llm = LLMEngine()\r\n        self.tts = TTSEngine()\r\n        self.stt = STTEngine()\r\n        self.portrait = PortraitEngine()\r\n\r\n    def report(self) -> dict:\r\n        return {\"llm\": self.llm.probe(), \"tts\": self.tts.probe(),\r\n                \"stt\": self.stt.probe(),\r\n                \"portrait\": {\"engine\": \"portrait\", \"mode\": \"inproc-svg\"}}\r\n","_meta":{"cognition.ai/linesAdded":38,"cognition.ai/linesRemoved":4}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\governance.py","oldText":"\"\"\"Governed predicate registry. Namespaces are a closed set; names within a\r\nnamespace are extensible but must be registered here before assertions are\r\nauthored with them.\r\n\"\"\"\r\n\r\nPREDICATES = {\r\n    \"product\":    {\"goal\", \"implementation\", \"feedback-policy\"},\r\n    \"project\":    {\"exists\", \"title\", \"kind\", \"goal\", \"status\", \"focus\", \"member-need\",\r\n                   \"progress\", \"created-via\"},\r\n    \"user\":       {\"name\", \"engagement\", \"mood\", \"mood-cleared\", \"editor-proficiency\",\r\n                   \"ephemeral-cleared\", \"tool-request\", \"persona-frame\"},\r\n    \"persona\":    {\"exists\", \"name\", \"trait\", \"confidence\", \"voice\", \"voice-remote\",\r\n                   \"interest\", \"label-color\", \"roster-priority\", \"portrait\", \"role\",\r\n                   \"style\", \"usagecredential\", \"tool-permission\", \"imitates\",\r\n                   \"imitation-mark\", \"admonished\", \"lens\", \"responsibility\",\r\n                   \"display-mode\"},\r\n    \"device\":     {\"input-capture\", \"speech-transcript\", \"voice-render\", \"ambient-pickup\"},\r\n    \"feedback\":   {\"sent\"},\r\n    \"maxim\":      {\"worldview-anchor\", \"objection\"},\r\n    \"gap\":        {\"research\"},\r\n    \"tool\":       {\"exists\", \"definition\", \"telemetry\", \"rank-adjustment\", \"success-rate\",\r\n                   \"refusal\", \"invocation\"},\r\n    \"chat\":       {\"user-message\", \"assistant-response\", \"response-depth\", \"topic\",\r\n                   \"cleared\", \"idle-turn-variant\", \"all-chat\"},\r\n    \"library\":    {\"acquisition-draft\", \"acquisition-sent\", \"recipient\", \"suggest\"},\r\n    \"home\":       {\"routine-suggest\", \"actuation-draft\", \"actuation-done\", \"device\"},\r\n    \"creator\":    {\"milestone-suggest\", \"publish-draft\", \"published\", \"target\"},\r\n    \"study\":      {\"plan-suggest\", \"export-draft\", \"export-sent\", \"recipient\"},\r\n    \"travel\":     {\"prep-suggest\", \"itinerary-draft\", \"itinerary-sent\", \"recipient\"},\r\n    \"routing\":    {\"turn-trace\", \"trace-step\", \"trace-invoke\", \"intent-override\",\r\n                   \"stewardship-assignment\", \"decision-trace\", \"surface\", \"binding\",\r\n                   \"respondent-rank\"},\r\n    \"prompt\":     {\"prep\"},\r\n    \"source\":     {\"trust-class\", \"confidence\", \"configured\", \"provenance\", \"use\",\r\n                   \"liveness\", \"model-available\", \"access-policy\", \"adequacy\"},\r\n    \"need\":       {\"tool-request\", \"response\", \"portrait\", \"countdown\", \"book-find\",\r\n                   \"open\", \"fulfilled\", \"cancelled\", \"superseded\", \"candidate\",\r\n                   \"deferred\", \"refined\", \"list-item\", \"generic\"},\r\n    \"search\":     {\"run\", \"adequacy\", \"source-adequacy\"},\r\n    \"idle\":       {\"drain-fragment\", \"steward-run\"},\r\n    \"image\":      {\"asset\", \"candidate\", \"review\", \"subject\"},\r\n    \"sound\":      {\"soundscape-plan\", \"soundscape-active\", \"cue\"},\r\n    \"ui\":         {\"panel-request\", \"shell-theme\", \"card\"},\r\n    \"avqr\":       {\"registration\"},\r\n    \"exchange\":   {\"bundle-draft\", \"bundle-sent\", \"recipient\", \"imported\", \"package\"},\r\n    \"storefront\": {\"exists\", \"definition\", \"status\", \"confidence\"},\r\n    \"codebook\":   {\"entry\", \"manifest\", \"source\"},\r\n    \"set\":        {\"member\", \"closure\"},\r\n    \"task\":       {\"plan\", \"step\"},\r\n    \"calendar\":   {\"event\", \"imported\", \"linked\"},\r\n    \"grant\":      {\"issued\", \"consumed\", \"revoked\"},\r\n    \"cleanup\":    {\"run\", \"compacted\", \"consolidated\", \"rule\"},\r\n    \"studio\":     {\"document\", \"export\"},\r\n    \"contact\":    {\"exists\", \"id\", \"name\", \"relationship\", \"status\", \"ask\"},\r\n    \"engine\":     {\"mode\", \"probe\"},\r\n    \"launch\":     {\"report\", \"honesty\"},\r\n    \"decision\":   {\"weights\", \"score\", \"churn\", \"respondent\"},\r\n    \"seed\":       {\"loaded\"},\r\n}\r\n\r\n# Namespaces whose assertions hold *operational* state subject to governed\r\n# cleanup compaction rules (spent rows may be consolidated).\r\nOPERATIONAL_NS = {\"need\", \"idle\", \"routing\"}\r\n\r\nACTION_THRESHOLD = 0.7      # minimum effective confidence for action/acceptance\r\nIMPORT_CEILING = 0.4        # imported assertions capped below ACTION_THRESHOLD\r\n\r\n\r\ndef known(predicate: str) -> bool:\r\n    if \":\" not in predicate:\r\n        return False\r\n    ns, name = predicate.split(\":\", 1)\r\n    return ns in PREDICATES and name in PREDICATES[ns]\r\n\r\n\r\ndef register(predicate: str) -> None:\r\n    \"\"\"Runtime registration for user-authored predicates (namespaces stay closed).\"\"\"\r\n    ns, name = predicate.split(\":\", 1)\r\n    if ns not in PREDICATES:\r\n        raise ValueError(f\"closed namespace set: '{ns}' is not a governed namespace\")\r\n    PREDICATES[ns].add(name)\r\n","newText":"\"\"\"Governed predicate registry. Namespaces are a closed set; names within a\r\nnamespace are extensible but must be registered here before assertions are\r\nauthored with them.\r\n\"\"\"\r\n\r\nPREDICATES = {\r\n    \"product\":    {\"goal\", \"implementation\", \"feedback-policy\"},\r\n    \"project\":    {\"exists\", \"title\", \"kind\", \"goal\", \"status\", \"focus\", \"member-need\",\r\n                   \"progress\", \"created-via\"},\r\n    \"user\":       {\"name\", \"engagement\", \"mood\", \"mood-cleared\", \"editor-proficiency\",\r\n                   \"ephemeral-cleared\", \"tool-request\", \"persona-frame\"},\r\n    \"persona\":    {\"exists\", \"name\", \"trait\", \"confidence\", \"voice\", \"voice-remote\",\r\n                   \"interest\", \"label-color\", \"roster-priority\", \"portrait\", \"role\",\r\n                   \"style\", \"usagecredential\", \"tool-permission\", \"imitates\",\r\n                   \"imitation-mark\", \"admonished\", \"lens\", \"responsibility\",\r\n                   \"display-mode\", \"art\", \"temporal-note\", \"characterization\",\r\n                   \"mint-refused\"},\r\n    \"device\":     {\"input-capture\", \"speech-transcript\", \"voice-render\", \"ambient-pickup\"},\r\n    \"feedback\":   {\"sent\"},\r\n    \"maxim\":      {\"worldview-anchor\", \"objection\"},\r\n    \"gap\":        {\"research\"},\r\n    \"tool\":       {\"exists\", \"definition\", \"telemetry\", \"rank-adjustment\", \"success-rate\",\r\n                   \"refusal\", \"invocation\"},\r\n    \"chat\":       {\"user-message\", \"assistant-response\", \"response-depth\", \"topic\",\r\n                   \"cleared\", \"idle-turn-variant\", \"all-chat\"},\r\n    \"library\":    {\"acquisition-draft\", \"acquisition-sent\", \"recipient\", \"suggest\"},\r\n    \"home\":       {\"routine-suggest\", \"actuation-draft\", \"actuation-done\", \"device\"},\r\n    \"creator\":    {\"milestone-suggest\", \"publish-draft\", \"published\", \"target\"},\r\n    \"study\":      {\"plan-suggest\", \"export-draft\", \"export-sent\", \"recipient\"},\r\n    \"travel\":     {\"prep-suggest\", \"itinerary-draft\", \"itinerary-sent\", \"recipient\"},\r\n    \"routing\":    {\"turn-trace\", \"trace-step\", \"trace-invoke\", \"intent-override\",\r\n                   \"stewardship-assignment\", \"decision-trace\", \"surface\", \"binding\",\r\n                   \"respondent-rank\"},\r\n    \"prompt\":     {\"prep\"},\r\n    \"source\":     {\"trust-class\", \"confidence\", \"configured\", \"provenance\", \"use\",\r\n                   \"liveness\", \"model-available\", \"access-policy\", \"adequacy\"},\r\n    \"need\":       {\"tool-request\", \"response\", \"portrait\", \"countdown\", \"book-find\",\r\n                   \"open\", \"fulfilled\", \"cancelled\", \"superseded\", \"candidate\",\r\n                   \"deferred\", \"refined\", \"list-item\", \"generic\", \"set-members\",\r\n                   \"characterization\", \"nonmatch\"},\r\n    \"search\":     {\"run\", \"adequacy\", \"source-adequacy\"},\r\n    \"idle\":       {\"drain-fragment\", \"steward-run\"},\r\n    \"image\":      {\"asset\", \"candidate\", \"review\", \"subject\"},\r\n    \"sound\":      {\"soundscape-plan\", \"soundscape-active\", \"cue\"},\r\n    \"ui\":         {\"panel-request\", \"shell-theme\", \"card\"},\r\n    \"avqr\":       {\"registration\"},\r\n    \"exchange\":   {\"bundle-draft\", \"bundle-sent\", \"recipient\", \"imported\", \"package\"},\r\n    \"storefront\": {\"exists\", \"definition\", \"status\", \"confidence\"},\r\n    \"codebook\":   {\"entry\", \"manifest\", \"source\"},\r\n    \"set\":        {\"member\", \"closure\", \"criteria\", \"member-source\"},\r\n    \"task\":       {\"plan\", \"step\"},\r\n    \"calendar\":   {\"event\", \"imported\", \"linked\"},\r\n    \"speech\":     {\"floor-admission\", \"floor-played\", \"voice-set\"},\r\n    \"comparison\": {\"run\", \"row\"},\r\n    \"connector\":  {\"configured\", \"run\", \"item\"},\r\n    \"temporal\":   {\"attention\", \"context\"},\r\n    \"archive\":    {\"segment\"},\r\n    \"ethics\":     {\"gate\"},\r\n    \"grant\":      {\"issued\", \"consumed\", \"revoked\"},\r\n    \"cleanup\":    {\"run\", \"compacted\", \"consolidated\", \"rule\"},\r\n    \"studio\":     {\"document\", \"export\"},\r\n    \"contact\":    {\"exists\", \"id\", \"name\", \"relationship\", \"status\", \"ask\"},\r\n    \"engine\":     {\"mode\", \"probe\"},\r\n    \"launch\":     {\"report\", \"honesty\"},\r\n    \"decision\":   {\"weights\", \"score\", \"churn\", \"respondent\"},\r\n    \"seed\":       {\"loaded\"},\r\n}\r\n\r\n# Namespaces whose assertions hold *operational* state subject to governed\r\n# cleanup compaction rules (spent rows may be consolidated).\r\nOPERATIONAL_NS = {\"need\", \"idle\", \"routing\"}\r\n\r\nACTION_THRESHOLD = 0.7      # minimum effective confidence for action/acceptance\r\nIMPORT_CEILING = 0.4        # imported assertions capped below ACTION_THRESHOLD\r\n\r\n\r\ndef known(predicate: str) -> bool:\r\n    if \":\" not in predicate:\r\n        return False\r\n    ns, name = predicate.split(\":\", 1)\r\n    return ns in PREDICATES and name in PREDICATES[ns]\r\n\r\n\r\ndef register(predicate: str) -> None:\r\n    \"\"\"Runtime registration for user-authored predicates (namespaces stay closed).\"\"\"\r\n    ns, name = predicate.split(\":\", 1)\r\n    if ns not in PREDICATES:\r\n        raise ValueError(f\"closed namespace set: '{ns}' is not a governed namespace\")\r\n    PREDICATES[ns].add(name)\r\n","_meta":{"cognition.ai/linesAdded":11,"cognition.ai/linesRemoved":3}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\host.py","oldText":"\"\"\"Runtime context + host wiring.\r\n\r\nCtx is the ToolContext every component receives: the ledger, the registry, the\r\ndecision model, personas, engines, the append seam (the synchronous face of\r\nthe ledger.append system command), the card/event bus, and helpers.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport os\r\nimport threading\r\nimport time\r\nfrom typing import Any, Optional\r\n\r\nfrom . import governance, needs, tools\r\nfrom .decision import DecisionModel\r\nfrom .engines import Engines\r\nfrom .ledger import Ledger\r\nfrom .model import now_ms\r\nfrom .personas import PersonaStore\r\n\r\n\r\nclass Bus:\r\n    \"\"\"In-process event bus: routed cards and stream events. Subscribers\r\n    (API layer, steward) receive (kind, payload); the last N are retained\r\n    for UI replay.\"\"\"\r\n\r\n    def __init__(self, keep: int = 500):\r\n        self._subs = []\r\n        self.recent: list[dict] = []\r\n        self._keep = keep\r\n        self._lock = threading.Lock()\r\n\r\n    def publish(self, kind: str, payload: Any):\r\n        ev = {\"kind\": kind, \"payload\": payload, \"at\": now_ms()}\r\n        with self._lock:\r\n            self.recent.append(ev)\r\n            self.recent = self.recent[-self._keep:]\r\n        for cb in list(self._subs):\r\n            try:\r\n                cb(ev)\r\n            except Exception:\r\n                pass\r\n\r\n    def subscribe(self, cb):\r\n        self._subs.append(cb)\r\n\r\n\r\nclass Ctx:\r\n    def __init__(self, root: str, runtime: Optional[str] = None):\r\n        self.root = root\r\n        self.runtime = runtime or os.path.join(root, \"runtime\")\r\n        self.artifacts = os.path.join(self.runtime, \"artifacts\")\r\n        self.outbox = os.path.join(self.runtime, \"outbox\")\r\n        for d in (self.runtime, self.artifacts, self.outbox):\r\n            os.makedirs(d, exist_ok=True)\r\n        self.ledger = Ledger(os.path.join(self.runtime, \"ledger.jsonl\"))\r\n        self.registry = tools.Registry()\r\n        self.decision = DecisionModel(self)\r\n        self.personas = PersonaStore(os.path.join(self.runtime, \"personalities.json\"), self)\r\n        self.engines = Engines()\r\n        self.bus = Bus()\r\n        self.admonitions: list[str] = []\r\n        self.boot_at = now_ms()\r\n        self._engine_report: Optional[dict] = None\r\n        self._engine_report_at = 0.0\r\n\r\n    # ---- write seam (synchronous face of the ledger.append system command) ----\r\n\r\n    def append(self, subject, predicate, value, claimant, **kw):\r\n        return self.ledger.append(subject, predicate, value, claimant, **kw)\r\n\r\n    # ---- component dispatch ----\r\n\r\n    def invoke(self, cid: str, input: Optional[dict] = None,\r\n               grant: Optional[dict] = None, need_id: Optional[str] = None) -> dict:\r\n        return tools.invoke(self, cid, input, grant=grant, need_id=need_id)\r\n\r\n    def engine_invoke(self, engine: str, method: str, args: dict) -> Any:\r\n        eng = getattr(self.engines, engine, None)\r\n        if eng is None:\r\n            return {\"ok\": False, \"error\": f\"unknown engine: {engine}\"}\r\n        fn = getattr(eng, method, None)\r\n        if fn is None:\r\n            return {\"ok\": False, \"error\": f\"unknown engine method: {engine}.{method}\"}\r\n        return fn(**(args or {}))\r\n\r\n    def emit(self, kind: str, payload: Any):\r\n        self.bus.publish(kind, payload)\r\n\r\n    # ---- config helpers (config assertions on subject user-settings) ----\r\n\r\n    def config(self, predicate: str, default=None):\r\n        rows = self.ledger.query(subject=\"user-settings\", predicate=predicate)\r\n        return rows[-1].value[\"v\"] if rows else default\r\n\r\n    def response_depth(self) -> int:\r\n        return int(self.config(\"chat:response-depth\", 2) or 2)\r\n\r\n    def honesty(self) -> dict:\r\n        if self._engine_report is None or time.time() - self._engine_report_at > 10:\r\n            self._engine_report = self.engines.report()\r\n            self._engine_report_at = time.time()\r\n        eng = self._engine_report\r\n        return {\r\n            \"ledger\": {\"durable\": True, \"path\": self.ledger.path,\r\n                     **self.ledger.stats()},\r\n            \"engines\": eng,\r\n            \"stubDeclarations\": {\r\n                \"llm\": \"stubFallback on — template replies declared per-card\"\r\n                       if eng[\"llm\"][\"mode\"] == \"stub\" else \"off\",\r\n                \"ttsRemote\": \"unconfigured — declared, never silently substituted\",\r\n                \"stt\": \"browser Web Speech API or declared-none\",\r\n            },\r\n            \"personaFrame\": self.personas.frame(),\r\n        }\r\n\r\n    def admonish(self, msg: str):\r\n        self.admonitions.append(msg)\r\n        self.emit(\"admonition\", {\"message\": msg})\r\n","newText":"\"\"\"Runtime context + host wiring.\r\n\r\nCtx is the ToolContext every component receives: the ledger, the registry, the\r\ndecision model, personas, engines, the append seam (the synchronous face of\r\nthe ledger.append system command), the card/event bus, and helpers.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport os\r\nimport threading\r\nimport time\r\nfrom typing import Any, Optional\r\n\r\nfrom . import governance, needs, tools\r\nfrom .decision import DecisionModel\r\nfrom .engines import Engines\r\nfrom .ledger import Ledger\r\nfrom .model import now_ms\r\nfrom .personas import PersonaStore\r\nfrom .speechfloor import SpeechFloor\r\n\r\n\r\nclass Bus:\r\n    \"\"\"In-process event bus: routed cards and stream events. Subscribers\r\n    (API layer, steward) receive (kind, payload); the last N are retained\r\n    for UI replay.\"\"\"\r\n\r\n    def __init__(self, keep: int = 500):\r\n        self._subs = []\r\n        self.recent: list[dict] = []\r\n        self._keep = keep\r\n        self._lock = threading.Lock()\r\n\r\n    def publish(self, kind: str, payload: Any):\r\n        ev = {\"kind\": kind, \"payload\": payload, \"at\": now_ms()}\r\n        with self._lock:\r\n            self.recent.append(ev)\r\n            self.recent = self.recent[-self._keep:]\r\n        for cb in list(self._subs):\r\n            try:\r\n                cb(ev)\r\n            except Exception:\r\n                pass\r\n\r\n    def subscribe(self, cb):\r\n        self._subs.append(cb)\r\n\r\n\r\nclass Ctx:\r\n    def __init__(self, root: str, runtime: Optional[str] = None):\r\n        self.root = root\r\n        self.runtime = runtime or os.path.join(root, \"runtime\")\r\n        self.artifacts = os.path.join(self.runtime, \"artifacts\")\r\n        self.outbox = os.path.join(self.runtime, \"outbox\")\r\n        for d in (self.runtime, self.artifacts, self.outbox):\r\n            os.makedirs(d, exist_ok=True)\r\n        self.ledger = Ledger(os.path.join(self.runtime, \"ledger.jsonl\"))\r\n        self.registry = tools.Registry()\r\n        self.decision = DecisionModel(self)\r\n        self.personas = PersonaStore(os.path.join(self.runtime, \"personalities.json\"), self)\r\n        self.engines = Engines()\r\n        self.bus = Bus()\r\n        self.floor = SpeechFloor(self)\r\n        self.admonitions: list[str] = []\r\n        self.boot_at = now_ms()\r\n        self._engine_report: Optional[dict] = None\r\n        self._engine_report_at = 0.0\r\n\r\n    # ---- write seam (synchronous face of the ledger.append system command) ----\r\n\r\n    def append(self, subject, predicate, value, claimant, **kw):\r\n        return self.ledger.append(subject, predicate, value, claimant, **kw)\r\n\r\n    # ---- component dispatch ----\r\n\r\n    def invoke(self, cid: str, input: Optional[dict] = None,\r\n               grant: Optional[dict] = None, need_id: Optional[str] = None) -> dict:\r\n        return tools.invoke(self, cid, input, grant=grant, need_id=need_id)\r\n\r\n    def engine_invoke(self, engine: str, method: str, args: dict) -> Any:\r\n        eng = getattr(self.engines, engine, None)\r\n        if eng is None:\r\n            return {\"ok\": False, \"error\": f\"unknown engine: {engine}\"}\r\n        fn = getattr(eng, method, None)\r\n        if fn is None:\r\n            return {\"ok\": False, \"error\": f\"unknown engine method: {engine}.{method}\"}\r\n        return fn(**(args or {}))\r\n\r\n    def emit(self, kind: str, payload: Any):\r\n        self.bus.publish(kind, payload)\r\n\r\n    # ---- config helpers (config assertions on subject user-settings) ----\r\n\r\n    def config(self, predicate: str, default=None):\r\n        rows = self.ledger.query(subject=\"user-settings\", predicate=predicate)\r\n        return rows[-1].value[\"v\"] if rows else default\r\n\r\n    def response_depth(self) -> int:\r\n        return int(self.config(\"chat:response-depth\", 2) or 2)\r\n\r\n    def honesty(self) -> dict:\r\n        if self._engine_report is None or time.time() - self._engine_report_at > 10:\r\n            self._engine_report = self.engines.report()\r\n            self._engine_report_at = time.time()\r\n        eng = self._engine_report\r\n        return {\r\n            \"ledger\": {\"durable\": True, \"path\": self.ledger.path,\r\n                     **self.ledger.stats()},\r\n            \"engines\": eng,\r\n            \"stubDeclarations\": {\r\n                \"llm\": \"stubFallback on — template replies declared per-card\"\r\n                       if eng[\"llm\"][\"mode\"] == \"stub\" else \"off\",\r\n                \"ttsRemote\": \"unconfigured — declared, never silently substituted\",\r\n                \"stt\": \"browser Web Speech API or declared-none\",\r\n            },\r\n            \"personaFrame\": self.personas.frame(),\r\n        }\r\n\r\n    def admonish(self, msg: str):\r\n        self.admonitions.append(msg)\r\n        self.emit(\"admonition\", {\"message\": msg})\r\n","_meta":{"cognition.ai/linesAdded":2,"cognition.ai/linesRemoved":0}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\speechfloor.py","oldText":"\"\"\"Speech floor — serialized playback admission (C-SpeechFloor), the manner\r\r\nbeneath C-PerceivableRespondents (contributions individually perceivable) and\r\r\nC-SequentialRespondents (respondents present in sequence).\r\r\n\r\r\nThe host admits exactly one speech render at a time through a FIFO queue.\r\r\nEvery admission and every completed playback is recorded as a ledger\r\r\nassertion — the floor is evidence, not just a lock. Persona voice preferences\r\r\n(portable, C-EngineMapping) ride on each admission and are mapped to engine\r\r\nsettings inside the renderer.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport queue\r\r\nimport threading\r\r\nfrom typing import Optional\r\r\n\r\r\nfrom .model import new_id, now_ms\r\r\n\r\r\n\r\r\nclass SpeechFloor(threading.Thread):\r\r\n    \"\"\"FIFO playback queue. One render at a time — never overlapping speech.\"\"\"\r\r\n\r\r\n    def __init__(self, ctx):\r\r\n        super().__init__(daemon=True, name=\"speech-floor\")\r\r\n        self.ctx = ctx\r\r\n        self.q: \"queue.Queue[dict]\" = queue.Queue()\r\r\n        self._stop = threading.Event()\r\r\n        self.played: list[dict] = []\r\r\n\r\r\n    # ---- admission ----\r\r\n\r\r\n    def enqueue(self, text: str, persona: Optional[dict] = None,\r\r\n                cause: str = \"response\", voice: Optional[dict] = None) -> dict:\r\r\n        \"\"\"Admit a playback request. Returns the admission record; the actual\r\r\n        render happens in order on the floor thread.\"\"\"\r\r\n        adm = {\"id\": new_id(\"sp\"), \"at\": now_ms(), \"text\": text,\r\r\n               \"personaId\": (persona or {}).get(\"id\"),\r\r\n               \"personaName\": (persona or {}).get(\"name\", \"Meridian\"),\r\r\n               \"cause\": cause, \"voice\": voice or (persona or {}).get(\"voice\") or {},\r\r\n               \"position\": self.q.qsize() + 1}\r\r\n        self.ctx.append(\"speech\", \"speech:floor-admission\", adm,\r\r\n                        \"system\", basis={\"kind\": \"execution\"})\r\r\n        self.q.put(adm)\r\r\n        return adm\r\r\n\r\r\n    def depth(self) -> int:\r\r\n        return self.q.qsize()\r\r\n\r\r\n    # ---- floor worker ----\r\r\n\r\r\n    def run(self):\r\r\n        while not self._stop.is_set():\r\r\n            try:\r\r\n                adm = self.q.get(timeout=0.5)\r\r\n            except queue.Empty:\r\r\n                continue\r\r\n            t0 = now_ms()\r\r\n            r = self.ctx.invoke(\"speak-voice\",\r\r\n                                {\"text\": adm[\"text\"], \"personaId\": adm[\"personaId\"],\r\r\n                                 \"voice\": adm[\"voice\"]})\r\r\n            rec = {\"admission\": adm[\"id\"], \"personaId\": adm[\"personaId\"],\r\r\n                   \"personaName\": adm[\"personaName\"],\r\r\n                   \"voice\": adm[\"voice\"], \"ok\": bool(r.get(\"ok\")),\r\r\n                   \"renderedBy\": (r.get(\"result\") or {}).get(\"renderedBy\"),\r\r\n                   \"ms\": now_ms() - t0,\r\r\n                   \"error\": r.get(\"error\") or\r\r\n                            (r.get(\"result\") or {}).get(\"error\")}\r\r\n            self.played.append(rec)\r\r\n            self.ctx.append(\"speech\", \"speech:floor-played\", rec,\r\r\n                            \"engine:tts\", basis={\"kind\": \"execution\"})\r\r\n            self.ctx.emit(\"card\", {\"kind\": \"speech\", \"summary\":\r\r\n                                   f\"{adm['personaName']} spoke \"\r\r\n                                   f\"({rec['renderedBy'] or 'unrendered'})\",\r\r\n                                   \"floor\": rec, \"at\": now_ms()})\r\r\n            self.q.task_done()\r\r\n\r\r\n    def drain(self, timeout: float = 30.0) -> bool:\r\r\n        \"\"\"Wait until the queue is empty (test/demo seam).\"\"\"\r\r\n        import time\r\r\n        t0 = time.time()\r\r\n        while not self.q.empty() and time.time() - t0 < timeout:\r\r\n            time.sleep(0.05)\r\r\n        t1 = time.time()\r\r\n        while self.played and time.time() - t1 < 10:\r\r\n            # give last render a beat to record\r\r\n            return True\r\r\n        return self.q.empty()\r\r\n\r\r\n    def stop(self):\r\r\n        self._stop.set()\r\r\n","newText":"\"\"\"Speech floor — serialized playback admission (C-SpeechFloor), the manner\r\n\r\nbeneath C-PerceivableRespondents (contributions individually perceivable) and\r\n\r\nC-SequentialRespondents (respondents present in sequence).\r\n\r\n\r\n\r\nThe host admits exactly one speech render at a time through a FIFO queue.\r\n\r\nEvery admission and every completed playback is recorded as a ledger\r\n\r\nassertion — the floor is evidence, not just a lock. Persona voice preferences\r\n\r\n(portable, C-EngineMapping) ride on each admission and are mapped to engine\r\n\r\nsettings inside the renderer.\r\n\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\n\r\n\r\nimport queue\r\n\r\nimport threading\r\n\r\nfrom typing import Optional\r\n\r\n\r\n\r\nfrom .model import new_id, now_ms\r\n\r\n\r\n\r\n\r\n\r\nclass SpeechFloor(threading.Thread):\r\n\r\n    \"\"\"FIFO playback queue. One render at a time — never overlapping speech.\"\"\"\r\n\r\n\r\n\r\n    def __init__(self, ctx):\r\n\r\n        super().__init__(daemon=True, name=\"speech-floor\")\r\n\r\n        self.ctx = ctx\r\n\r\n        self.q: \"queue.Queue[dict]\" = queue.Queue()\r\n\r\n        self._stop = threading.Event()\r\n\r\n        self.played: list[dict] = []\r\n\r\n\r\n\r\n    # ---- admission ----\r\n\r\n\r\n\r\n    def enqueue(self, text: str, persona: Optional[dict] = None,\r\n\r\n                cause: str = \"response\", voice: Optional[dict] = None) -> dict:\r\n\r\n        \"\"\"Admit a playback request. Returns the admission record; the actual\r\n\r\n        render happens in order on the floor thread.\"\"\"\r\n\r\n        adm = {\"id\": new_id(\"sp\"), \"at\": now_ms(), \"text\": text,\r\n\r\n               \"personaId\": (persona or {}).get(\"id\"),\r\n\r\n               \"personaName\": (persona or {}).get(\"name\", \"Meridian\"),\r\n\r\n               \"cause\": cause, \"voice\": voice or (persona or {}).get(\"voice\") or {},\r\n\r\n               \"position\": self.q.qsize() + 1}\r\n\r\n        self.ctx.append(\"speech\", \"speech:floor-admission\", adm,\r\n\r\n                        \"system\", basis={\"kind\": \"execution\"})\r\n\r\n        self.q.put(adm)\r\n\r\n        return adm\r\n\r\n\r\n\r\n    def depth(self) -> int:\r\n\r\n        return self.q.qsize()\r\n\r\n\r\n\r\n    # ---- floor worker ----\r\n\r\n\r\n\r\n    def run(self):\r\n\r\n        while not self._stop.is_set():\r\n\r\n            try:\r\n\r\n                adm = self.q.get(timeout=0.5)\r\n\r\n            except queue.Empty:\r\n\r\n                continue\r\n\r\n            t0 = now_ms()\r\n\r\n            r = self.ctx.invoke(\"speak-voice\",\r\n\r\n                                {\"text\": adm[\"text\"], \"personaId\": adm[\"personaId\"],\r\n\r\n                                 \"voice\": adm[\"voice\"]})\r\n\r\n            rec = {\"admission\": adm[\"id\"], \"personaId\": adm[\"personaId\"],\r\n\r\n                   \"personaName\": adm[\"personaName\"],\r\n\r\n                   \"voice\": adm[\"voice\"], \"ok\": bool(r.get(\"ok\")),\r\n\r\n                   \"renderedBy\": (r.get(\"result\") or {}).get(\"renderedBy\"),\r\n\r\n                   \"ms\": now_ms() - t0,\r\n\r\n                   \"error\": r.get(\"error\") or\r\n\r\n                            (r.get(\"result\") or {}).get(\"error\")}\r\n\r\n            self.played.append(rec)\r\n\r\n            self.ctx.append(\"speech\", \"speech:floor-played\", rec,\r\n\r\n                            \"engine:tts\", basis={\"kind\": \"execution\"})\r\n\r\n            self.ctx.emit(\"card\", {\"kind\": \"speech\", \"summary\":\r\n\r\n                                   f\"{adm['personaName']} spoke \"\r\n\r\n                                   f\"({rec['renderedBy'] or 'unrendered'})\",\r\n\r\n                                   \"floor\": rec, \"at\": now_ms()})\r\n\r\n            self.q.task_done()\r\n\r\n\r\n\r\n    def drain(self, timeout: float = 30.0) -> bool:\r\n\r\n        \"\"\"Wait until the queue is empty (test/demo seam).\"\"\"\r\n\r\n        import time\r\n\r\n        t0 = time.time()\r\n\r\n        while not self.q.empty() and time.time() - t0 < timeout:\r\n\r\n            time.sleep(0.05)\r\n\r\n        t1 = time.time()\r\n\r\n        while self.played and time.time() - t1 < 10:\r\n\r\n            # give last render a beat to record\r\n\r\n            return True\r\n\r\n        return self.q.empty()\r\n\r\n\r\n\r\n    def stop(self):\r\n\r\n        self._stop.set()\r\n\r\n","_meta":{"cognition.ai/linesAdded":90,"cognition.ai/linesRemoved":90}}],"_meta":{"cognition.ai/inferenceToolName":"exec"}}}}
