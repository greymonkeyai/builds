{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#d0a120fc003c4b6ea994d7ec96b9c2bf","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Tool-logic-as-data: a closed-op interpreter.\n\nTools are data: { template, steps }. Steps run over a bindings scope seeded\nwith { input, grant }. There is no eval — only this closed op set:\n\n  set | query | search | view | candidates | append | appendEach | when |\n  invoke | engine | emit | repeat | result | fail\n\nValue resolution:\n  {\"$ref\": \"input.name\"}        scope lookup (dotted path)\n  {\"$tpl\": \"Hello {name}\"}      string template over scope values\n  {\"$typed\": {...}}             TypedValue literal\n  {\"$now\": true}                epoch ms\n  {\"$uid\": \"p\"}                 fresh id with prefix\n  {\"$pipe\": [R, \"trim\", ...]}   transform pipeline"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#d0a120fc003c4b6ea994d7ec96b9c2bf","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Tool-logic-as-data: a closed-op interpreter.\n\nTools are data: { template, steps }. Steps run over a bindings scope seeded\nwith { input, grant }. There is no eval — only this closed op set:\n\n  set | query | search | view | candidates | append | appendEach | when |\n  invoke | engine | emit | repeat | result | fail\n\nValue resolution:\n  {\"$ref\": \"input.name\"}        scope lookup (dotted path)\n  {\"$tpl\": \"Hello {name}\"}      string template over scope values\n  {\"$typed\": {...}}             TypedValue literal\n  {\"$now\": true}                epoch ms\n  {\"$uid\": \"p\"}                 fresh id with prefix\n  {\"$pipe\": [R, \"trim\", ...]}   transform pipeline\n  {\"$first\": R} {\"$last\": R} {\"$len\": R} {\"$int\": R} {\"$get\": [R, \"k\"]}\n  {\"$join\": [R, \", \"]} {\"$coalesce\": [R, ...]} {\"$list\": [R, ...]}\n  {\"$map\": {\"of\": R, \"as\": \"x\", \"tpl\": R}}   per-item template\n  {\"$slugsig\": R}               normalized signature for matching\n\nConditions: truthy/eq/ne/gt/gte/lt/lte/matches/contains/not/and/or.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nimport time\nfrom typing import Any\n\nfrom .model import infer_typed, new_id\n\n\nclass ToolError(Exception):\n    def __init__(self, message: str, data: Any = None):\n        super().__init__(message)\n        self.data = data\n\n\nTRANSFORMS = {\n    \"trim\": lambda v: str(v).strip(),\n    \"lower\": lambda v: str(v).lower(),\n    \"upper\": lambda v: str(v).upper(),\n    \"slug\": lambda v: re.sub(r\"[^a-z0-9]+\", \"-\", str(v).lower()).strip(\"-\"),\n    \"titlecase\": lambda v: str(v).title(),\n    \"json\": lambda v: __import__(\"json\").dumps(v, ensure_ascii=False),\n    \"int\": lambda v: int(float(v)),\n    \"str\": lambda v: str(v),\n}\n\n\ndef _slugify(v: Any) -> str:\n\u001b[0m[... 283 lines omitted ...]\n    \"study\":      {\"plan-suggest\", \"export-draft\", \"export-sent\", \"recipient\"},\n    \"travel\":     {\"prep-suggest\", \"itinerary-draft\", \"itinerary-sent\", \"recipient\"},\n    \"routing\":    {\"turn-trace\", \"trace-step\", \"trace-invoke\", \"intent-override\",\n                   \"stewardship-assignment\", \"decision-trace\", \"surface\", \"binding\",\n                   \"respondent-rank\"},\n    \"prompt\":     {\"prep\"},\n    \"source\":     {\"trust-class\", \"confidence\", \"configured\", \"provenance\", \"use\",\n                   \"liveness\", \"model-available\", \"access-policy\", \"adequacy\"},\n    \"need\":       {\"tool-request\", \"response\", \"portrait\", \"countdown\", \"book-find\",\n                   \"open\", \"fulfilled\", \"cancelled\", \"superseded\", \"candidate\",\n                   \"deferred\", \"refined\", \"list-item\", \"generic\"},\n    \"search\":     {\"run\", \"adequacy\", \"source-adequacy\"},\n    \"idle\":       {\"drain-fragment\", \"steward-run\"},\n    \"image\":      {\"asset\", \"candidate\", \"review\", \"subject\"},\n    \"sound\":      {\"soundscape-plan\", \"soundscape-active\", \"cue\"},\n    \"ui\":         {\"panel-request\", \"shell-theme\", \"card\"},\n    \"avqr\":       {\"registration\"},\n    \"exchange\":   {\"bundle-draft\", \"bundle-sent\", \"recipient\", \"imported\", \"package\"},\n    \"storefront\": {\"exists\", \"definition\", \"status\", \"confidence\"},\n    \"codebook\":   {\"entry\", \"manifest\", \"source\"},\n    \"set\":        {\"member\", \"closure\"},\n    \"task\":       {\"plan\", \"step\"},\n    \"calendar\":   {\"event\", \"imported\", \"linked\"},\n    \"grant\":      {\"issued\", \"consumed\", \"revoked\"},\n    \"cleanup\":    {\"run\", \"compacted\", \"consolidated\", \"rule\"},\n    \"studio\":     {\"document\", \"export\"},\n    \"contact\":    {\"exists\", \"id\", \"name\", \"relationship\", \"status\", \"ask\"},\n    \"engine\":     {\"mode\", \"probe\"},\n    \"launch\":     {\"report\", \"honesty\"},\n    \"decision\":   {\"weights\", \"score\", \"churn\", \"respondent\"},\n    \"seed\":       {\"loaded\"},\n}\n\n# Namespaces whose assertions hold *operational* state subject to governed\n# cleanup compaction rules (spent rows may be consolidated).\nOPERATIONAL_NS = {\"need\", \"idle\", \"routing\"}\n\nACTION_THRESHOLD = 0.7      # minimum effective confidence for action/acceptance\nIMPORT_CEILING = 0.4        # imported assertions capped below ACTION_THRESHOLD\n\n\ndef known(predicate: str) -> bool:\n    if \":\" not in predicate:\n        return False\n    ns, name = predicate.split(\":\", 1)\n    return ns in PREDICATES and name in PREDICATES[ns]\n\n\ndef register(predicate: str) -> None:\n    \"\"\"Runtime registration for user-authored predicates (namespaces stay closed).\"\"\"\n    ns, name = predicate.split(\":\", 1)\n    if ns not in PREDICATES:\n        raise ValueError(f\"closed namespace set: '{ns}' is not a governed namespace\")\n    PREDICATES[ns].add(name)\n\"\"\"Install-time seed packs. Packs are JSON data loaded once per installation\n(marker row prevents re-seeding). Seed assertions carry claimant seed:*.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\n\n\ndef load_packs(ctx, packs_dir: str) -> dict:\n    loaded = []\n    if not os.path.isdir(packs_dir):\n        return {\"loaded\": []}\n    for fn in sorted(os.listdir(packs_dir)):\n        if not fn.endswith(\".json\"):\n            continue\n        pack_id = fn[:-5]\n        # seeds are idempotent per installation via a marker subject\n        existing = [a for a in ctx.ledger.all()\n                    if a.subjectKey == f\"pack:{pack_id}\"]\n        if existing:\n            continue\n        with open(os.path.join(packs_dir, fn), encoding=\"utf-8\") as f:\n            pack = json.load(f)\n        cl = f\"seed:{pack_id}\"\n        for p in pack.get(\"personas\") or []:\n            ctx.personas.mint(p.get(\"name\", \"unnamed\"), p.get(\"traits\") or [],\n                              p.get(\"interests\") or [], p.get(\"lens\") or {},\n                              p.get(\"voice\"), p.get(\"imitates\"), cl)\n        for a in pack.get(\"assertions\") or []:\n            ctx.append(a[\"subject\"], a[\"predicate\"], a.get(\"value\"), cl,\n                       certainty=a.get(\"certainty\", 0.9),\n                       basis={\"kind\": \"seed\", \"ref\": pack_id})\n        for t in pack.get(\"tools\") or []:\n            spec = dict(t); spec.setdefault(\"kind\", \"tool\"); spec[\"seed\"] = True\n            ctx.registry.register(spec)\n            ctx.append(f\"tool:{spec['id']}\", \"tool:exists\",\n                       {\"id\": spec[\"id\"], \"seed\": True}, cl)\n            ctx.append(f\"tool:{spec['id']}\", \"tool:definition\", spec, cl)\n        ctx.append(f\"pack:{pack_id}\", \"seed:loaded\",\n                   {\"id\": pack_id, \"personas\": len(pack.get(\"personas\") or []),\n                    \"assertions\": len(pack.get(\"assertions\") or []),\n                    \"tools\": len(pack.get(\"tools\") or [])}, cl,\n                   basis={\"kind\": \"seed\", \"ref\": pack_id})\n        loaded.append(pack_id)\n    return {\"loaded\": loaded}"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#d0a120fc003c4b6ea994d7ec96b9c2bf","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Tool-logic-as-data: a closed-op interpreter.\n\nTools are data: { template, steps }. Steps run over a bindings scope seeded\nwith { input, grant }. There is no eval — only this closed op set:\n\n  set | query | search | view | candidates | append | appendEach | when |\n  invoke | engine | emit | repeat | result | fail\n\nValue resolution:\n  {\"$ref\": \"input.name\"}        scope lookup (dotted path)\n  {\"$tpl\": \"Hello {name}\"}      string template over scope values\n  {\"$typed\": {...}}             TypedValue literal\n  {\"$now\": true}                epoch ms\n  {\"$uid\": \"p\"}                 fresh id with prefix\n  {\"$pipe\": [R, \"trim\", ...]}   transform pipeline\n  {\"$first\": R} {\"$last\": R} {\"$len\": R} {\"$int\": R} {\"$get\": [R, \"k\"]}\n  {\"$join\": [R, \", \"]} {\"$coalesce\": [R, ...]} {\"$list\": [R, ...]}\n  {\"$map\": {\"of\": R, \"as\": \"x\", \"tpl\": R}}   per-item template\n  {\"$slugsig\": R}               normalized signature for matching\n\nConditions: truthy/eq/ne/gt/gte/lt/lte/matches/contains/not/and/or.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nimport time\nfrom typing import Any\n\nfrom .model import infer_typed, new_id\n\n\nclass ToolError(Exception):\n    def __init__(self, message: str, data: Any = None):\n        super().__init__(message)\n        self.data = data\n\n\nTRANSFORMS = {\n    \"trim\": lambda v: str(v).strip(),\n    \"lower\": lambda v: str(v).lower(),\n    \"upper\": lambda v: str(v).upper(),\n    \"slug\": lambda v: re.sub(r\"[^a-z0-9]+\", \"-\", str(v).lower()).strip(\"-\"),\n    \"titlecase\": lambda v: str(v).title(),\n    \"json\": lambda v: __import__(\"json\").dumps(v, ensure_ascii=False),\n    \"int\": lambda v: int(float(v)),\n    \"str\": lambda v: str(v),\n}\n\n\ndef _slugify(v: Any) -> str:\n    return re.sub(r\"[^a-z0-9]+\", \"-\", str(v).lower()).strip(\"-\")\n\n\nclass Scope:\n    def __init__(self, bindings: dict):\n        self.b = bindings\n\n    def get(self, path: str) -> Any:\n        cur: Any = self.b\n        for part in path.split(\".\"):\n            if isinstance(cur, dict):\n                cur = cur.get(part)\n            elif isinstance(cur, list):\n                try:\n                    cur = cur[int(part)]\n                except (ValueError, IndexError):\n                    return None\n            else:\n                return None\n        return cur\n\n    def flatten(self) -> dict:\n        out = {}\n        def walk(prefix, v):\n            if isinstance(v, dict):\n                for k, vv in v.items():\n                    walk(f\"{prefix}{k}.\", vv)\n            out[prefix[:-1] if prefix.endswith(\".\") else prefix] = v\n        for k, v in self.b.items():\n            if isinstance(v, (str, int, float, bool)):\n                out[k] = v\n            else:\n                walk(f\"{k}.\", v)\n        return out\n\n\ndef resolve(v: Any, scope: Scope, ctx) -> Any:\n    if isinstance(v, dict):\n        keys = [k for k in v if k.startswith(\"$\")]\n        if len(keys) == 1:\n            k = keys[0]\n            if k == \"$ref\":\n                return scope.get(v[k])\n            if k == \"$tpl\":\n                flat = scope.flatten()\n                def sub(m):\n                    return str(flat.get(m.group(1), m.group(0)))\n                return re.sub(r\"\\{([a-zA-Z0-9_.]+)\\}\", sub, v[k])\n            if k == \"$typed\":\n                return dict(v[k])\n            if k == \"$now\":\n                return int(time.time() * 1000)\n            if k == \"$uid\":\n                return new_id(str(v[k]))\n            if k == \"$pipe\":\n                items = v[k]\n                cur = resolve(items[0], scope, ctx)\n                for t in items[1:]:\n                    fn = TRANSFORMS.get(str(t))\n                    if not fn:\n                        raise ToolError(f\"unknown transform: {t}\")\n                    cur = fn(cur)\n                return cur\n            if k == \"$first\":\n                arr = resolve(v[k], scope, ctx) or []\n                return arr[0] if arr else None\n            if k == \"$last\":\n                arr = resolve(v[k], scope, ctx) or []\n                return arr[-1] if arr else None\n            if k == \"$len\":\n                arr = resolve(v[k], scope, ctx)\n                return len(arr) if arr is not None else 0\n            if k == \"$int\":\n                return int(float(resolve(v[k], scope, ctx) or 0))\n            if k == \"$get\":\n                obj = resolve(v[k][0], scope, ctx)\n                return obj.get(v[k][1]) if isinstance(obj, dict) else None\n            if k == \"$join\":\n                arr = resolve(v[k][0], scope, ctx) or []\n                sep = v[k][1] if len(v[k]) > 1 else \", \"\n                return sep.join(str(x) for x in arr)\n            if k == \"$coalesce\":\n                for item in v[k]:\n                    r = resolve(item, scope, ctx)\n                    if r not in (None, \"\", []):\n                        return r\n                return None\n            if k == \"$list\":\n                return [resolve(x, scope, ctx) for x in v[k]]\n            if k == \"$map\":\n                spec = v[k]\n                arr = resolve(spec[\"of\"], scope, ctx) or []\n                name = spec.get(\"as\", \"item\")\n                out = []\n                for it in arr:\n                    scope.b[name] = it\n                    out.append(resolve(spec[\"tpl\"], scope, ctx))\n                scope.b.pop(name, None)\n                return out\n            if k == \"$filter\":\n                spec = v[k]\n                arr = resolve(spec[\"of\"], scope, ctx) or []\n                name = spec.get(\"as\", \"item\")\n                out = []\n                for it in arr:\n                    scope.b[name] = it\n                    if eval_cond(spec[\"where\"], scope, ctx):\n                        out.append(it)\n                scope.b.pop(name, None)\n                return out\n            if k == \"$slugsig\":\n                return _slugify(resolve(v[k], scope, ctx))\n        return {kk: resolve(vv, scope, ctx) for kk, vv in v.items()}\n    if isinstance(v, list):\n        return [resolve(x, scope, ctx) for x in v]\n    return v\n\n\ndef eval_cond(cond: Any, scope: Scope, ctx) -> bool:\n    if not isinstance(cond, dict):\n        return bool(resolve(cond, scope, ctx))\n    for k, v in cond.items():\n        if k == \"truthy\":\n            return bool(resolve(v, scope, ctx))\n        if k == \"eq\":\n            return resolve(v[0], scope, ctx) == resolve(v[1], scope, ctx)\n        if k == \"ne\":\n            return resolve(v[0], scope, ctx) != resolve(v[1], scope, ctx)\n        if k in (\"gt\", \"gte\", \"lt\", \"lte\"):\n            a, b = resolve(v[0], scope, ctx), resolve(v[1], scope, ctx)\n            a, b = float(a or 0), float(b or 0)\n            return {\"gt\": a > b, \"gte\": a >= b, \"lt\": a < b, \"lte\": a <= b}[k]\n        if k == \"matches\":\n            s = resolve(v[0], scope, ctx)\n            return bool(re.search(str(v[1]), str(s or \"\"), re.I))\n        if k == \"contains\":\n            hay = resolve(v[0], scope, ctx)\n            needle = resolve(v[1], scope, ctx)\n            if isinstance(hay, (list, tuple, set)):\n                return needle in hay\n            return str(needle).lower() in str(hay or \"\").lower()\n        if k == \"not\":\n            return not eval_cond(v, scope, ctx)\n        if k == \"and\":\n            return all(eval_cond(c, scope, ctx) for c in v)\n        if k == \"or\":\n            return any(eval_cond(c, scope, ctx) for c in v)\n    return False\n\n\ndef run_steps(steps: list, scope: Scope, ctx) -> Any:\n    for step in steps:\n        op = step.get(\"op\")\n        if op == \"set\":\n            scope.b[step[\"into\"]] = resolve(step[\"value\"], scope, ctx)\n        elif op == \"query\":\n            rows = ctx.ledger.query(\n                subject=resolve(step.get(\"subject\"), scope, ctx),\n                predicate=resolve(step.get(\"predicate\"), scope, ctx),\n                claimant=resolve(step.get(\"claimant\"), scope, ctx),\n                include_superseded=bool(step.get(\"includeSuperseded\")),\n                limit=int(resolve(step.get(\"limit\"), scope, ctx) or 0),\n                tag=resolve(step.get(\"tag\"), scope, ctx))\n            scope.b[step[\"into\"]] = [r.to_row() for r in rows]\n        elif op == \"search\":\n            rows = ctx.ledger.search(resolve(step[\"text\"], scope, ctx),\n                                     limit=int(resolve(step.get(\"limit\"), scope, ctx) or 20))\n            scope.b[step[\"into\"]] = [r.to_row() for r in rows]\n        elif op == \"view\":\n            scope.b[step[\"into\"]] = ctx.ledger.render_view(\n                resolve(step[\"subject\"], scope, ctx))\n        elif op == \"candidates\":\n            scope.b[step[\"into\"]] = ctx.ledger.candidates_for(\n                resolve(step[\"subject\"], scope, ctx),\n                resolve(step[\"predicate\"], scope, ctx))\n        elif op == \"append\":\n            a = ctx.append(\n                subject=resolve(step[\"subject\"], scope, ctx),\n                predicate=resolve(step[\"predicate\"], scope, ctx),\n                value=resolve(step.get(\"value\"), scope, ctx),\n                claimant=resolve(step.get(\"claimant\"), scope, ctx) or \"system\",\n                certainty=resolve(step.get(\"certainty\"), scope, ctx) or 1.0,\n                context=resolve(step.get(\"context\"), scope, ctx) or 1.0,\n                basis=resolve(step.get(\"basis\"), scope, ctx),\n                supersedes=resolve(step.get(\"supersedes\"), scope, ctx),\n                relates=resolve(step.get(\"relates\"), scope, ctx),\n                tags=resolve(step.get(\"tags\"), scope, ctx),\n                meta=resolve(step.get(\"meta\"), scope, ctx))\n            if step.get(\"into\"):\n                scope.b[step[\"into\"]] = a.to_row()\n        elif op == \"appendEach\":\n            arr = resolve(step[\"for\"], scope, ctx) or []\n            name = step.get(\"as\", \"item\")\n            out = []\n            for it in arr:\n                scope.b[name] = it\n                a = ctx.append(\n                    subject=resolve(step[\"subject\"], scope, ctx),\n                    predicate=resolve(step[\"predicate\"], scope, ctx),\n                    value=resolve(step.get(\"value\"), scope, ctx),\n                    claimant=resolve(step.get(\"claimant\"), scope, ctx) or \"system\",\n                    certainty=resolve(step.get(\"certainty\"), scope, ctx) or 1.0,\n                    basis=resolve(step.get(\"basis\"), scope, ctx),\n                    relates=resolve(step.get(\"relates\"), scope, ctx))\n                out.append(a.id)\n            scope.b.pop(name, None)\n            if step.get(\"into\"):\n                scope.b[step[\"into\"]] = out\n        elif op == \"when\":\n            branch = step[\"then\"] if eval_cond(step[\"if\"], scope, ctx) else step.get(\"else\", [])\n            r = run_steps(branch, scope, ctx)\n            if r is not None:\n                return r\n        elif op == \"invoke\":\n            r = ctx.invoke(resolve(step[\"component\"], scope, ctx),\n                           resolve(step.get(\"input\", {}), scope, ctx),\n                           grant=scope.b.get(\"grant\"))\n            if step.get(\"into\"):\n                scope.b[step[\"into\"]] = r\n        elif op == \"invokeEach\":\n            arr = resolve(step[\"for\"], scope, ctx) or []\n            name = step.get(\"as\", \"item\")\n            results = []\n            for it in arr:\n                scope.b[name] = it\n                r = ctx.invoke(resolve(step[\"component\"], scope, ctx),\n                               resolve(step.get(\"input\", {}), scope, ctx),\n                               grant=scope.b.get(\"grant\"))\n                results.append(r)\n            scope.b.pop(name, None)\n            if step.get(\"into\"):\n                scope.b[step[\"into\"]] = results\n        elif op == \"engine\":\n            r = ctx.engine_invoke(resolve(step[\"engine\"], scope, ctx),\n                                  resolve(step[\"method\"], scope, ctx),\n                                  resolve(step.get(\"args\", {}), scope, ctx))\n            if step.get(\"into\"):\n                scope.b[step[\"into\"]] = r\n        elif op == \"emit\":\n            ctx.emit(resolve(step[\"kind\"], scope, ctx),\n                     resolve(step.get(\"payload\"), scope, ctx))\n        elif op == \"repeat\":\n            times = int(resolve(step[\"times\"], scope, ctx) or 1)\n            for i in range(times):\n                scope.b[\"i\"] = i\n                r = run_steps(step[\"steps\"], scope, ctx)\n                if r is not None:\n                    return r\n        elif op == \"result\":\n            return resolve(step.get(\"value\"), scope, ctx)\n        elif op == \"fail\":\n            raise ToolError(str(resolve(step[\"error\"], scope, ctx)),\n                            resolve(step.get(\"data\"), scope, ctx))\n        else:\n            raise ToolError(f\"unknown op: {op}\")\n    return None\n\"\"\"Governed predicate registry. Namespaces are a closed set; names within a\nnamespace are extensible but must be registered here before assertions are\nauthored with them.\n\"\"\"\n\nPREDICATES = {\n    \"product\":    {\"goal\", \"implementation\", \"feedback-policy\"},\n    \"project\":    {\"exists\", \"title\", \"kind\", \"goal\", \"status\", \"focus\", \"member-need\",\n                   \"progress\", \"created-via\"},\n    \"user\":       {\"name\", \"engagement\", \"mood\", \"mood-cleared\", \"editor-proficiency\",\n                   \"ephemeral-cleared\", \"tool-request\", \"persona-frame\"},\n    \"persona\":    {\"exists\", \"name\", \"trait\", \"confidence\", \"voice\", \"voice-remote\",\n                   \"interest\", \"label-color\", \"roster-priority\", \"portrait\", \"role\",\n                   \"style\", \"usagecredential\", \"tool-permission\", \"imitates\",\n                   \"imitation-mark\", \"admonished\", \"lens\", \"responsibility\",\n                   \"display-mode\"},\n    \"device\":     {\"input-capture\", \"speech-transcript\", \"voice-render\", \"ambient-pickup\"},\n    \"feedback\":   {\"sent\"},\n    \"maxim\":      {\"worldview-anchor\", \"objection\"},\n    \"gap\":        {\"research\"},\n    \"tool\":       {\"exists\", \"definition\", \"telemetry\", \"rank-adjustment\", \"success-rate\",\n                   \"refusal\", \"invocation\"},\n    \"chat\":       {\"user-message\", \"assistant-response\", \"response-depth\", \"topic\",\n                   \"cleared\", \"idle-turn-variant\", \"all-chat\"},\n    \"library\":    {\"acquisition-draft\", \"acquisition-sent\", \"recipient\", \"suggest\"},\n    \"home\":       {\"routine-suggest\", \"actuation-draft\", \"actuation-done\", \"device\"},\n    \"creator\":    {\"milestone-suggest\", \"publish-draft\", \"published\", \"target\"},\n    \"study\":      {\"plan-suggest\", \"export-draft\", \"export-sent\", \"recipient\"},\n    \"travel\":     {\"prep-suggest\", \"itinerary-draft\", \"itinerary-sent\", \"recipient\"},\n    \"routing\":    {\"turn-trace\", \"trace-step\", \"trace-invoke\", \"intent-override\",\n                   \"stewardship-assignment\", \"decision-trace\", \"surface\", \"binding\",\n                   \"respondent-rank\"},\n    \"prompt\":     {\"prep\"},\n    \"source\":     {\"trust-class\", \"confidence\", \"configured\", \"provenance\", \"use\",\n                   \"liveness\", \"model-available\", \"access-policy\", \"adequacy\"},\n    \"need\":       {\"tool-request\", \"response\", \"portrait\", \"countdown\", \"book-find\",\n                   \"open\", \"fulfilled\", \"cancelled\", \"superseded\", \"candidate\",\n                   \"deferred\", \"refined\", \"list-item\", \"generic\"},\n    \"search\":     {\"run\", \"adequacy\", \"source-adequacy\"},\n    \"idle\":       {\"drain-fragment\", \"steward-run\"},\n    \"image\":      {\"asset\", \"candidate\", \"review\", \"subject\"},\n    \"sound\":      {\"soundscape-plan\", \"soundscape-active\", \"cue\"},\n    \"ui\":         {\"panel-request\", \"shell-theme\", \"card\"},\n    \"avqr\":       {\"registration\"},\n    \"exchange\":   {\"bundle-draft\", \"bundle-sent\", \"recipient\", \"imported\", \"package\"},\n    \"storefront\": {\"exists\", \"definition\", \"status\", \"confidence\"},\n    \"codebook\":   {\"entry\", \"manifest\", \"source\"},\n    \"set\":        {\"member\", \"closure\"},\n    \"task\":       {\"plan\", \"step\"},\n    \"calendar\":   {\"event\", \"imported\", \"linked\"},\n    \"grant\":      {\"issued\", \"consumed\", \"revoked\"},\n    \"cleanup\":    {\"run\", \"compacted\", \"consolidated\", \"rule\"},\n    \"studio\":     {\"document\", \"export\"},\n    \"contact\":    {\"exists\", \"id\", \"name\", \"relationship\", \"status\", \"ask\"},\n    \"engine\":     {\"mode\", \"probe\"},\n    \"launch\":     {\"report\", \"honesty\"},\n    \"decision\":   {\"weights\", \"score\", \"churn\", \"respondent\"},\n    \"seed\":       {\"loaded\"},\n}\n\n# Namespaces whose assertions hold *operational* state subject to governed\n# cleanup compaction rules (spent rows may be consolidated).\nOPERATIONAL_NS = {\"need\", \"idle\", \"routing\"}\n\nACTION_THRESHOLD = 0.7      # minimum effective confidence for action/acceptance\nIMPORT_CEILING = 0.4        # imported assertions capped below ACTION_THRESHOLD\n\n\ndef known(predicate: str) -> bool:\n    if \":\" not in predicate:\n        return False\n    ns, name = predicate.split(\":\", 1)\n    return ns in PREDICATES and name in PREDICATES[ns]\n\n\ndef register(predicate: str) -> None:\n    \"\"\"Runtime registration for user-authored predicates (namespaces stay closed).\"\"\"\n    ns, name = predicate.split(\":\", 1)\n    if ns not in PREDICATES:\n        raise ValueError(f\"closed namespace set: '{ns}' is not a governed namespace\")\n    PREDICATES[ns].add(name)\n\"\"\"Install-time seed packs. Packs are JSON data loaded once per installation\n(marker row prevents re-seeding). Seed assertions carry claimant seed:*.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\n\n\ndef load_packs(ctx, packs_dir: str) -> dict:\n    loaded = []\n    if not os.path.isdir(packs_dir):\n        return {\"loaded\": []}\n    for fn in sorted(os.listdir(packs_dir)):\n        if not fn.endswith(\".json\"):\n            continue\n        pack_id = fn[:-5]\n        # seeds are idempotent per installation via a marker subject\n        existing = [a for a in ctx.ledger.all()\n                    if a.subjectKey == f\"pack:{pack_id}\"]\n        if existing:\n            continue\n        with open(os.path.join(packs_dir, fn), encoding=\"utf-8\") as f:\n            pack = json.load(f)\n        cl = f\"seed:{pack_id}\"\n        for p in pack.get(\"personas\") or []:\n            ctx.personas.mint(p.get(\"name\", \"unnamed\"), p.get(\"traits\") or [],\n                              p.get(\"interests\") or [], p.get(\"lens\") or {},\n                              p.get(\"voice\"), p.get(\"imitates\"), cl)\n        for a in pack.get(\"assertions\") or []:\n            ctx.append(a[\"subject\"], a[\"predicate\"], a.get(\"value\"), cl,\n                       certainty=a.get(\"certainty\", 0.9),\n                       basis={\"kind\": \"seed\", \"ref\": pack_id})\n        for t in pack.get(\"tools\") or []:\n            spec = dict(t); spec.setdefault(\"kind\", \"tool\"); spec[\"seed\"] = True\n            ctx.registry.register(spec)\n            ctx.append(f\"tool:{spec['id']}\", \"tool:exists\",\n                       {\"id\": spec[\"id\"], \"seed\": True}, cl)\n            ctx.append(f\"tool:{spec['id']}\", \"tool:definition\", spec, cl)\n        ctx.append(f\"pack:{pack_id}\", \"seed:loaded\",\n                   {\"id\": pack_id, \"personas\": len(pack.get(\"personas\") or []),\n                    \"assertions\": len(pack.get(\"assertions\") or []),\n                    \"tools\": len(pack.get(\"tools\") or [])}, cl,\n                   basis={\"kind\": \"seed\", \"ref\": pack_id})\n        loaded.append(pack_id)\n    return {\"loaded\": loaded}"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","terminal_exit":{"terminal_id":"de95de","exit_code":0,"signal":null}}}}}
