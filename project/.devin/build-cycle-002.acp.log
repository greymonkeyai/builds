def drain(self, timeout: float = 30.0) -> bool:\n        \"\"\"Wait until the queue is empty (test/demo seam).\"\"\"\n        import time\n        t0 = time.time()\n        while not self.q.empty() and time.time() - t0 < timeout:\n            time.sleep(0.05)\n        t1 = time.time()\n        while self.played and time.time() - t1 < 10:\n            # give last render a beat to record\n            return True\n        return self.q.empty()\n\n    def stop(self):\n        self._stop.set()"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","terminal_exit":{"terminal_id":"c2882d","exit_code":0,"signal":null}}}}}
