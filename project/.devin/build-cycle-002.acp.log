s:18\", \"src/connectors/gmail/index.ts:633\", \"src/connectors/publish/index.ts:24\"], \"confidence\": 0.85, \"user_opinion\": null },\n    { \"name\": \"fleet install\", \"score\": 0.9, \"evidence\": [\"Deploy-GMK-LAN.cmd:33\", \"Deploy-RMT-LAN.cmd:19\", \"scripts/prepare-standalone.mjs\", \"src/install-identity.ts\", \"tests/s122-turnkey-install.test.ts\", \"docs/acceptance/node24-multi-device-smoke.md\", \"docs/decisions/D105-fleet-role-topology.md\"], \"confidence\": 0.85, \"user_opinion\": null },\n    { \"name\": \"exchange media\", \"score\": 0.95, \"evidence\": [\"src/tools/code-import/codec.ts:18\", \"src/tools/compose/qr-encode.ts:12\", \"src/engines/perception/qr-decode.ts\", \"src/tools/campaign-wave2.ts:690\", \"src/tools/code-import/import-tool.ts:54\", \"src/tools/storefronts.ts:79\", \"tests/s105-qr-import-quarantine.test.ts\", \"tests/s306-full-avqr-bare-grey-migrate.test.ts\"], \"confidence\": 0.9, \"user_opinion\": null }\n  ],\n  \"overall\": 0.94,\n  \"judge_model\": \"SWE-2 Medium\",\n  \"user_commentary\": [],\n  \"scenarios\": [\n    { \"id\": \"S-assertion-input\", \"score\": 0.95, \"evidence_class\": \"repository\", \"evidence\": [\"src/ledger/types.ts:30\", \"src/ledger/store.ts:323\", \"src/connectors/ingest-mappers.ts\", \"tests/s2-chat-turn.test.ts\", \"tests/s16-stt-transcription-lane.test.ts\"], \"notes\": \"Append-only typed assertions with closed claimant vocabulary, basis provenance, certainty; typed and spoken (whisper STT → device:speech-transcript) input paths both present.\" },\n    { \"id\": \"S-template-need\", \"score\": 0.9, \"evidence_class\": \"repository\", \"evidence\": [\"src/tools/needs.ts:109\", \"src/tools/tool-interface.ts:161\", \"src/tools/tool-interface.ts:765\", \"tests/s72-need-lifecycle.test.ts\", \"tests/s162-calltool-floor.test.ts\"], \"notes\": \"need:tool-request opened durably; evaluateToolGate blocks on required slots/witnessed grant; gated submits leave need open. Chat, card, and callTool entry paths.