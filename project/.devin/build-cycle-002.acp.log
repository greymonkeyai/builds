ers\"]}'''\nnew = '''    # union of adequate retrievals, flagged disagreements — member sets\n    # come from the competition run just performed (real tool results)\n    members_by_tool = comp.get(\"membersByTool\") or {}'''\nassert old in s, \"setbuild anchor missing\"\ns = s.replace(old, new)\nopen(p, 'w', encoding='utf-8').write(s)\nprint(\"patched ok\")\nEOF"},"_meta":{"cognition.ai/commandNames":["python"],"cognition.ai/inferenceToolName":"exec","cognition.ai/timestamp":"2026-11-21T05:55:08.892071400+00:00"}}}}
