{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#3060514af87d4a16b6b62cc8d0aa22e9","status":"in_progress","content":[{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\archive.py","oldText":"\"\"\"Conversation archive (C-ConversationArchive — per-turn archive + topic\r\r\nsegments).\r\r\n\r\r\nThe archive is a computed view over the ledger (not a second store): chat\r\r\nturns are grouped into segments bounded by topic changes and clear-chat\r\r\nmarkers. `archive:segment` summary assertions are emitted at segment\r\r\nboundaries (end-topic / clear-chat / on demand) so the sealing is itself\r\r\nledger evidence.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nfrom .model import now_ms\r\r\n\r\r\n\r\r\ndef turns(ctx) -> list[dict]:\r\r\n    \"\"\"Per-turn archive rows: each user input with its persona responses and\r\r\n    the needs it opened, in order.\"\"\"\r\r\n    rows = []\r\r\n    pend = None\r\r\n    for a in ctx.ledger.query():\r\r\n        if a.predicate == \"chat:user-message\":\r\r\n            if pend:\r\r\n                rows.append(pend)\r\r\n            pend = {\"input\": a.value[\"v\"].get(\"text\") if isinstance(a.value[\"v\"], dict)\r\r\n                    else a.value[\"v\"], \"at\": a.at, \"id\": a.id,\r\r\n                    \"claimant\": a.claimant, \"responses\": [], \"needs\": []}\r\r\n        elif a.predicate == \"chat:assistant-response\" and pend is not None:\r\r\n            v = a.value[\"v\"]\r\r\n            pend[\"responses\"].append({\"personaId\": v.get(\"personaId\"),\r\r\n                                      \"text\": v.get(\"text\"),\r\r\n                                      \"claimant\": a.claimant, \"at\": a.at})\r\r\n        elif a.predicate == \"need:open\" and pend is not None:\r\r\n            pend[\"needs\"].append({\"needId\": a.subjectKey.split(\":\", 1)[1],\r\r\n                                  \"kind\": a.value[\"v\"].get(\"kind\"),\r\r\n                                  \"summary\": (a.value[\"v\"].get(\"spec\") or {}).get(\"summary\")})\r\r\n    if pend:\r\r\n        rows.append(pend)\r\r\n    return rows\r\r\n\r\r\n\r\r\ndef segments(ctx) -> list[dict]:\r\r\n    \"\"\"Topic segments: groups of turns between topic changes and clear-chat\r\r\n    boundaries.\"\"\"\r\r\n    segs = []\r\r\n    cur = {\"index\": 1, \"topic\": None, \"turns\": [], \"startAt\": None,\r\r\n           \"boundary\": \"start\"}\r\r\n    cleared = {a.id: a for a in ctx.ledger.query(predicate=\"chat:cleared\")}\r\r\n    topic_rows = {a.at: (a.value[\"v\"] if isinstance(a.value[\"v\"], str)\r\r\n                         else a.value[\"v\"].get(\"v\", a.value[\"v\"]))\r\r\n                  for a in ctx.ledger.query(predicate=\"chat:topic\")}\r\r\n    topic_times = sorted(topic_rows)\r\r\n    t = turns(ctx)\r\r\n    topic_idx = 0\r\r\n    clear_times = sorted(a.at for a in cleared.values())\r\r\n    for turn in t:\r\r\n        # boundary events before this turn?\r\r\n        while clear_times and clear_times[0] <= turn[\"at\"]:\r\r\n            clear_times.pop(0)\r\r\n            if cur[\"turns\"]:\r\r\n                cur[\"endAt\"] = turn[\"at\"]\r\r\n                segs.append(cur)\r\r\n            cur = {\"index\": len(segs) + 1, \"topic\": cur[\"topic\"], \"turns\": [],\r\r\n                   \"startAt\": None, \"boundary\": \"clear-chat\"}\r\r\n        while topic_idx < len(topic_times) and topic_times[topic_idx] <= turn[\"at\"]:\r\r\n            new_topic = topic_rows[topic_times[topic_idx]] or None\r\r\n            topic_idx += 1\r\r\n            if cur[\"turns\"] and new_topic != cur[\"topic\"]:\r\r\n                cur[\"endAt\"] = turn[\"at\"]\r\r\n                segs.append(cur)\r\r\n                cur = {\"index\": len(segs) + 1, \"topic\": new_topic, \"turns\": [],\r\r\n                       \"startAt\": None, \"boundary\": \"topic-change\"}\r\r\n            else:\r\r\n                cur[\"topic\"] = new_topic\r\r\n        if cur[\"startAt\"] is None:\r\r\n            cur[\"startAt\"] = turn[\"at\"]\r\r\n        cur[\"turns\"].append(turn)\r\r\n    if cur[\"turns\"]:\r\r\n        cur[\"endAt\"] = cur[\"turns\"][-1][\"at\"]\r\r\n        segs.append(cur)\r\r\n    return segs\r\r\n\r\r\n\r\r\ndef seal(ctx, topic=None, reason: str = \"segment boundary\",\r\r\n         claimant: str = \"system\") -> dict:\r\r\n    \"\"\"Write an archive:segment summary row for the segment just closed —\r\r\n    durable-result evidence, computed from the live turns.\"\"\"\r\r\n    segs = segments(ctx)\r\r\n    last = segs[-1] if segs else {\"turns\": [], \"topic\": topic}\r\r\n    rec = {\"topic\": topic if topic is not None else last.get(\"topic\"),\r\r\n           \"turns\": len(last[\"turns\"]),\r\r\n           \"firstAt\": last.get(\"startAt\"), \"endAt\": last.get(\"endAt\"),\r\r\n           \"reason\": reason, \"sealedAt\": now_ms()}\r\r\n    ctx.append(\"archive\", \"archive:segment\", rec, claimant,\r\r\n               basis={\"kind\": \"durable-result\"})\r\r\n    return rec\r\r\n\r\r\n\r\r\ndef archive_view(ctx) -> dict:\r\r\n    segs = segments(ctx)\r\r\n    return {\"segments\": segs, \"turnCount\": sum(len(s[\"turns\"]) for s in segs),\r\r\n            \"segmentCount\": len(segs)}\r\r\n","newText":"\"\"\"Conversation archive (C-ConversationArchive — per-turn archive + topic\r\nsegments).\r\n\r\nThe archive is a computed view over the ledger (not a second store): chat\r\nturns are grouped into segments bounded by topic changes and clear-chat\r\nmarkers. `archive:segment` summary assertions are emitted at segment\r\nboundaries (end-topic / clear-chat / on demand) so the sealing is itself\r\nledger evidence.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom .model import now_ms\r\n\r\n\r\ndef turns(ctx) -> list[dict]:\r\n    \"\"\"Per-turn archive rows: each user input with its persona responses and\r\n    the needs it opened, in order.\"\"\"\r\n    rows = []\r\n    pend = None\r\n    for a in ctx.ledger.query():\r\n        if a.predicate == \"chat:user-message\":\r\n            if pend:\r\n                rows.append(pend)\r\n            pend = {\"input\": a.value[\"v\"].get(\"text\") if isinstance(a.value[\"v\"], dict)\r\n                    else a.value[\"v\"], \"at\": a.at, \"id\": a.id,\r\n                    \"claimant\": a.claimant, \"responses\": [], \"needs\": []}\r\n        elif a.predicate == \"chat:assistant-response\" and pend is not None:\r\n            v = a.value[\"v\"]\r\n            pend[\"responses\"].append({\"personaId\": v.get(\"personaId\"),\r\n                                      \"text\": v.get(\"text\"),\r\n                                      \"claimant\": a.claimant, \"at\": a.at})\r\n        elif a.predicate == \"need:open\" and pend is not None:\r\n            pend[\"needs\"].append({\"needId\": a.subjectKey.split(\":\", 1)[1],\r\n                                  \"kind\": a.value[\"v\"].get(\"kind\"),\r\n                                  \"summary\": (a.value[\"v\"].get(\"spec\") or {}).get(\"summary\")})\r\n    if pend:\r\n        rows.append(pend)\r\n    return rows\r\n\r\n\r\ndef segments(ctx) -> list[dict]:\r\n    \"\"\"Topic segments: groups of turns between topic changes and clear-chat\r\n    boundaries.\"\"\"\r\n    segs = []\r\n    cur = {\"index\": 1, \"topic\": None, \"turns\": [], \"startAt\": None,\r\n           \"boundary\": \"start\"}\r\n    cleared = {a.id: a for a in ctx.ledger.query(predicate=\"chat:cleared\")}\r\n    topic_rows = {a.at: (a.value[\"v\"] if isinstance(a.value[\"v\"], str)\r\n                         else a.value[\"v\"].get(\"v\", a.value[\"v\"]))\r\n                  for a in ctx.ledger.query(predicate=\"chat:topic\")}\r\n    topic_times = sorted(topic_rows)\r\n    t = turns(ctx)\r\n    topic_idx = 0\r\n    clear_times = sorted(a.at for a in cleared.values())\r\n    for turn in t:\r\n        # boundary events before this turn?\r\n        while clear_times and clear_times[0] <= turn[\"at\"]:\r\n            clear_times.pop(0)\r\n            if cur[\"turns\"]:\r\n                cur[\"endAt\"] = turn[\"at\"]\r\n                segs.append(cur)\r\n            cur = {\"index\": len(segs) + 1, \"topic\": cur[\"topic\"], \"turns\": [],\r\n                   \"startAt\": None, \"boundary\": \"clear-chat\"}\r\n        while topic_idx < len(topic_times) and topic_times[topic_idx] <= turn[\"at\"]:\r\n            new_topic = topic_rows[topic_times[topic_idx]] or None\r\n            topic_idx += 1\r\n            if cur[\"turns\"] and new_topic != cur[\"topic\"]:\r\n                cur[\"endAt\"] = turn[\"at\"]\r\n                segs.append(cur)\r\n                cur = {\"index\": len(segs) + 1, \"topic\": new_topic, \"turns\": [],\r\n                       \"startAt\": None, \"boundary\": \"topic-change\"}\r\n            else:\r\n                cur[\"topic\"] = new_topic\r\n        if cur[\"startAt\"] is None:\r\n            cur[\"startAt\"] = turn[\"at\"]\r\n        cur[\"turns\"].append(turn)\r\n    if cur[\"turns\"]:\r\n        cur[\"endAt\"] = cur[\"turns\"][-1][\"at\"]\r\n        segs.append(cur)\r\n    return segs\r\n\r\n\r\ndef seal(ctx, topic=None, reason: str = \"segment boundary\",\r\n         claimant: str = \"system\") -> dict:\r\n    \"\"\"Write an archive:segment summary row for the segment just closed —\r\n    durable-result evidence, computed from the live turns.\"\"\"\r\n    segs = segments(ctx)\r\n    last = segs[-1] if segs else {\"turns\": [], \"topic\": topic}\r\n    rec = {\"topic\": topic if topic is not None else last.get(\"topic\"),\r\n           \"turns\": len(last[\"turns\"]),\r\n           \"firstAt\": last.get(\"startAt\"), \"endAt\": last.get(\"endAt\"),\r\n           \"reason\": reason, \"sealedAt\": now_ms()}\r\n    ctx.append(\"archive\", \"archive:segment\", rec, claimant,\r\n               basis={\"kind\": \"durable-result\"})\r\n    return rec\r\n\r\n\r\ndef archive_view(ctx) -> dict:\r\n    segs = segments(ctx)\r\n    return {\"segments\": segs, \"turnCount\": sum(len(s[\"turns\"]) for s in segs),\r\n            \"segmentCount\": len(segs)}\r\n","_meta":{"cognition.ai/linesAdded":91,"cognition.ai/linesRemoved":192}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\art.py","oldText":"\"\"\"Per-personality generated art (C-PersonalityArt) + presentation glass\r\r\n(C-PresentationGlass: asset pipeline, portrait frames, ambient motion).\r\r\n\r\r\nEvery personality's art is *unique to that personality*: the composition is\r\r\nseeded from the persona's identity (id), name, traits, and interests — never\r\r\nshared or placeholder media. The generated SVG carries:\r\r\n- a deterministic motif family derived from the persona's interests\r\r\n- a palette derived from the persona's name + id\r\r\n- ambient motion (real SVG animation — drifting elements, not a static image)\r\r\n- a portrait frame keyed to the persona's display mode / imitation status\r\r\n\r\r\nThe asset pipeline is honest: `persona:art` assertions record the seed,\r\r\nmotif, palette, and artifact path. When a persona's traits change, a re-render\r\r\nproduces a *new* asset supplanting (not silently overwriting) the old.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport base64\r\r\nimport hashlib\r\r\nimport os\r\r\nimport re\r\r\nfrom typing import Optional\r\r\n\r\r\nMOTIFS = (\"orbits\", \"strata\", \"prism\", \"glyphs\", \"tide\", \"circuit\", \"garden\", \"halo\")\r\r\nFRAMES = (\"arc\", \"square\", \"notch\", \"double\")\r\r\n\r\r\n\r\r\ndef _seed(persona: dict) -> int:\r\r\n    h = hashlib.sha256(\r\r\n        (persona.get(\"id\", \"\") + \"|\" + persona.get(\"name\", \"\") + \"|\" +\r\r\n         \",\".join(persona.get(\"traits\") or []) + \"|\" +\r\r\n         \",\".join(persona.get(\"interests\") or [])).encode()).digest()\r\r\n    return int.from_bytes(h[:8], \"big\")\r\r\n\r\r\n\r\r\ndef _rng(seed: int):\r\r\n    state = [seed & 0xFFFFFFFFFFFFFFFF or 1]\r\r\n\r\r\n    def nxt() -> float:\r\r\n        state[0] = (state[0] * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF\r\r\n        return (state[0] >> 33) / 0x7FFFFFFF\r\r\n    return nxt\r\r\n\r\r\n\r\r\ndef _palette(persona: dict) -> list:\r\r\n    h = hashlib.md5((persona.get(\"id\", \"\") + persona.get(\"name\", \"\")).encode()).digest()\r\r\n    base = h[0] / 255 * 360\r\r\n    cols = []\r\r\n    for i in range(4):\r\r\n        hue = (base + i * (40 + h[1] % 90)) % 360\r\r\n        sat = 45 + (h[2 + i] % 45)\r\r\n        lit = 30 + (h[6 + i] % 45)\r\r\n        cols.append(f\"hsl({int(hue)},{sat}%,{lit}%)\")\r\r\n    return cols\r\r\n\r\r\n\r\r\ndef _motif_for(persona: dict, rng) -> str:\r\r\n    key = \" \".join(persona.get(\"interests\") or []) + \" \" + \" \".join(persona.get(\"traits\") or [])\r\r\n    key = (key or persona.get(\"name\", \"\")).lower()\r\r\n    words = re.findall(r\"[a-z]+\", key)\r\r\n    vocab = {\"orbits\": (\"star\", \"sky\", \"orbit\", \"space\", \"plan\", \"cycle\", \"calendar\", \"time\"),\r\r\n             \"strata\": (\"ledger\", \"record\", \"history\", \"layer\", \"archive\", \"data\", \"provenance\"),\r\r\n             \"prism\": (\"light\", \"glass\", \"spectrum\", \"clarity\", \"analyze\", \"inspect\"),\r\r\n             \"glyphs\": (\"word\", \"text\", \"write\", \"language\", \"chat\", \"story\", \"essay\"),\r\r\n             \"tide\": (\"water\", \"flow\", \"travel\", \"music\", \"sound\", \"voice\", \"speech\"),\r\r\n             \"circuit\": (\"tool\", \"compute\", \"machine\", \"engine\", \"system\", \"build\"),\r\r\n             \"garden\": (\"grow\", \"plant\", \"nature\", \"care\", \"tend\", \"garden\", \"cultivate\"),\r\r\n             \"halo\": (\"watch\", \"attention\", \"alert\", \"forward\", \"herald\", \"notify\")}\r\r\n    best, best_n = MOTIFS[int(rng() * len(MOTIFS))], 0\r\r\n    for m, words_m in vocab.items():\r\r\n        n = sum(1 for w in words if any(w.startswith(v) or v in w for v in words_m))\r\r\n        if n > best_n:\r\r\n            best, best_n = m, n\r\r\n    return best\r\r\n\r\r\n\r\r\ndef render_art(ctx, persona: dict, out_dir: Optional[str] = None) -> dict:\r\r\n    \"\"\"Generate the persona's unique portrait. Returns svg, artifact path,\r\r\n    and the composition record asserted to the ledger.\"\"\"\r\r\n    seed = _seed(persona)\r\r\n    rng = _rng(seed)\r\r\n    motif = _motif_for(persona, rng)\r\r\n    cols = _palette(persona)\r\r\n    frame = FRAMES[int(rng() * len(FRAMES))]\r\r\n    W = H = 160\r\r\n    parts = [f'<rect width=\"{W}\" height=\"{H}\" rx=\"18\" fill=\"{cols[0]}\"/>']\r\r\n    # ambient motion: two drifting halo layers (real SVG animation)\r\r\n    dur1 = 6 + rng() * 5\r\r\n    dur2 = 8 + rng() * 6\r\r\n    parts.append(\r\r\n        f'<g opacity=\"0.35\"><ellipse cx=\"{W/2}\" cy=\"{H/2}\" rx=\"{55+rng()*15:.0f}\" '\r\r\n        f'ry=\"{40+rng()*15:.0f}\" fill=\"{cols[1]}\">'\r\r\n        f'<animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 80 80\" '\r\r\n        f'to=\"360 80 80\" dur=\"{dur1:.1f}s\" repeatCount=\"indefinite\"/></ellipse></g>')\r\r\n    parts.append(\r\r\n        f'<g opacity=\"0.25\"><ellipse cx=\"{W/2}\" cy=\"{H/2}\" rx=\"{30+rng()*12:.0f}\" '\r\r\n        f'ry=\"{24+rng()*10:.0f}\" fill=\"{cols[2]}\">'\r\r\n        f'<animateTransform attributeName=\"transform\" type=\"rotate\" from=\"360 80 80\" '\r\r\n        f'to=\"0 80 80\" dur=\"{dur2:.1f}s\" repeatCount=\"indefinite\"/></ellipse></g>')\r\r\n    # motif layer\r\r\n    shapes = _motif_shapes(motif, rng, cols, W, H)\r\r\n    parts.append(shapes)\r\r\n    # portrait frame (presentation glass): frame style varies per persona\r\r\n    if frame == \"arc\":\r\r\n        parts.append(f'<path d=\"M14 {H-14} A {W-14} {H-14} 0 0 1 {W-14} 14\" fill=\"none\" '\r\r\n                     f'stroke=\"{cols[3]}\" stroke-width=\"4\"/>')\r\r\n    elif frame == \"square\":\r\r\n        parts.append(f'<rect x=\"6\" y=\"6\" width=\"{W-12}\" height=\"{H-12}\" rx=\"10\" '\r\r\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"3\" '\r\r\n                     f'stroke-dasharray=\"{8+int(rng()*8)} {4+int(rng()*6)}\"/>')\r\r\n    elif frame == \"notch\":\r\r\n        parts.append(f'<rect x=\"6\" y=\"6\" width=\"{W-12}\" height=\"{H-12}\" rx=\"10\" '\r\r\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"2\"/>'\r\r\n                     f'<rect x=\"2\" y=\"{H/2-14}\" width=\"8\" height=\"28\" fill=\"{cols[3]}\"/>')\r\r\n    else:\r\r\n        parts.append(f'<rect x=\"5\" y=\"5\" width=\"{W-10}\" height=\"{H-10}\" rx=\"12\" '\r\r\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"2\"/>'\r\r\n                     f'<rect x=\"11\" y=\"11\" width=\"{W-22}\" height=\"{H-22}\" rx=\"9\" '\r\r\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"1\" opacity=\"0.6\"/>')\r\r\n    # permanent imitation mark (prompt §Personalities): corner diamond, always present\r\r\n    if persona.get(\"imitates\"):\r\r\n        parts.append('<polygon points=\"132,8 148,24 132,40 116,24\" fill=\"#ffbf00\" '\r\r\n                     'stroke=\"#000\" stroke-width=\"1.5\"/>'\r\r\n                     '<text x=\"132\" y=\"28\" font-size=\"9\" text-anchor=\"middle\" '\r\r\n                     'font-family=\"monospace\" fill=\"#000\">IM</text>')\r\r\n    # initial monogram\r\r\n    parts.append(f'<text x=\"{W/2}\" y=\"{H/2+16}\" font-size=\"46\" text-anchor=\"middle\" '\r\r\n                 f'font-family=\"Georgia, serif\" fill=\"#fff\" opacity=\"0.92\">'\r\r\n                 f'{persona.get(\"name\", \"?\")[0].upper()}</text>')\r\r\n    svg = (f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {W} {H}\">'\r\r\n           + \"\".join(parts) + \"</svg>\")\r\r\n    artifact = None\r\r\n    if out_dir:\r\r\n        os.makedirs(out_dir, exist_ok=True)\r\r\n        artifact = os.path.join(out_dir, f\"persona-{persona['id']}.svg\")\r\r\n        with open(artifact, \"w\", encoding=\"utf-8\") as f:\r\r\n            f.write(svg)\r\r\n    rec = {\"seed\": seed, \"motif\": motif, \"palette\": cols, \"frame\": frame,\r\r\n           \"artifact\": artifact, \"ambient\": True,\r\r\n           \"engine\": \"inproc-svg-glass\"}\r\r\n    if ctx is not None:\r\r\n        prev = ctx.ledger.query(subject=f\"persona:{persona['id']}\",\r\r\n                                predicate=\"persona:art\")\r\r\n        ctx.append(f\"persona:{persona['id']}\", \"persona:art\", rec,\r\r\n                   \"engine:portrait\", basis={\"kind\": \"execution\"},\r\r\n                   supersedes=prev[-1].id if prev else None)\r\r\n    rec[\"svg\"] = svg\r\r\n    rec[\"dataUrl\"] = \"data:image/svg+xml;base64,\" + base64.b64encode(svg.encode()).decode()\r\r\n    return rec\r\r\n\r\r\n\r\r\ndef _motif_shapes(motif: str, rng, cols: list, W: int, H: int) -> str:\r\r\n    c = cols[2]\r\r\n    c2 = cols[3]\r\r\n    out = []\r\r\n    cx, cy = W / 2, H / 2\r\r\n    if motif == \"orbits\":\r\r\n        for i in range(2 + int(rng() * 3)):\r\r\n            rx, ry = 22 + i * (8 + rng() * 6), 14 + i * (6 + rng() * 5)\r\r\n            rot = rng() * 360\r\r\n            out.append(f'<ellipse cx=\"{cx}\" cy=\"{cy}\" rx=\"{rx:.0f}\" ry=\"{ry:.0f}\" '\r\r\n                       f'fill=\"none\" stroke=\"{c}\" stroke-width=\"1.4\" opacity=\"0.8\" '\r\r\n                       f'transform=\"rotate({rot:.0f} {cx} {cy})\"/>')\r\r\n        out.append(f'<circle cx=\"{cx+18}\" cy=\"{cy-12}\" r=\"4\" fill=\"{c2}\"/>')\r\r\n    elif motif == \"strata\":\r\r\n        y = 30\r\r\n        while y < H - 20:\r\r\n            h = 5 + rng() * 10\r\r\n            out.append(f'<path d=\"M8 {y:.0f} Q {cx} {y-8+rng()*16:.0f} {W-8} {y:.0f} '\r\r\n                       f'L {W-8} {y+h:.0f} Q {cx} {y+h-8+rng()*16:.0f} 8 {y+h:.0f} Z\" '\r\r\n                       f'fill=\"{c}\" opacity=\"{0.25+rng()*0.3:.2f}\"/>')\r\r\n            y += h + 4 + rng() * 8\r\r\n    elif motif == \"prism\":\r\r\n        for i in range(3):\r\r\n            x = 30 + i * 30 + rng() * 10\r\r\n            out.append(f'<polygon points=\"{x:.0f},110 {x+22:.0f},110 {x+11:.0f},'\r\r\n                       f'{52+rng()*20:.0f}\" fill=\"{c}\" opacity=\"{0.3+i*0.18:.2f}\"/>')\r\r\n        out.append(f'<path d=\"M20 40 L 140 120\" stroke=\"{c2}\" stroke-width=\"1.5\" opacity=\"0.7\"/>')\r\r\n    elif motif == \"glyphs\":\r\r\n        chars = \"ᚠᚢᚦᚨᚱᚲᚷᚹᚺᚾᛁᛃᛇᛈᛉᛊᛏᛒᛖᛗᛚᛜᛞᛟ\"\r\r\n        for i in range(5):\r\r\n            x, y = 24 + i * 26, 60 + (i % 2) * 34\r\r\n            ch = chars[int(rng() * len(chars))]\r\r\n            out.append(f'<text x=\"{x}\" y=\"{y}\" font-size=\"{18+rng()*10:.0f}\" '\r\r\n                       f'fill=\"{c}\" opacity=\"0.85\">{ch}</text>')\r\r\n    elif motif == \"tide\":\r\r\n        for i in range(3 + int(rng() * 2)):\r\r\n            y = 45 + i * 18\r\r\n            out.append(f'<path d=\"M6 {y} q 20 {-8-rng()*8:.0f} 40 0 t 40 0 t 40 0 t 40 0\" '\r\r\n                       f'fill=\"none\" stroke=\"{c}\" stroke-width=\"2.4\" opacity=\"{0.5+rng()*0.3:.2f}\"/>')\r\r\n    elif motif == \"circuit\":\r\r\n        nodes = [(20 + rng() * 120, 25 + rng() * 110) for _ in range(5)]\r\r\n        for i in range(len(nodes) - 1):\r\r\n            x1, y1 = nodes[i]; x2, y2 = nodes[i + 1]\r\r\n            out.append(f'<path d=\"M{x1:.0f} {y1:.0f} L{x1:.0f} {y2:.0f} L{x2:.0f} {y2:.0f}\" '\r\r\n                       f'fill=\"none\" stroke=\"{c}\" stroke-width=\"1.6\" opacity=\"0.7\"/>')\r\r\n        for x, y in nodes:\r\r\n            out.append(f'<circle cx=\"{x:.0f}\" cy=\"{y:.0f}\" r=\"3.4\" fill=\"{c2}\"/>')\r\r\n    elif motif == \"garden\":\r\r\n        for i in range(3 + int(rng() * 2)):\r\r\n            x = 35 + i * 30 + rng() * 8\r\r\n            out.append(f'<path d=\"M{x:.0f} 125 v {-30-rng()*25:.0f}\" stroke=\"{c}\" '\r\r\n                       f'stroke-width=\"2.6\" fill=\"none\"/>'\r\r\n                       f'<ellipse cx=\"{x:.0f}\" cy=\"{88-rng()*20:.0f}\" rx=\"{6+rng()*5:.0f}\" '\r\r\n                       f'ry=\"{9+rng()*6:.0f}\" fill=\"{c2}\" opacity=\"0.8\"/>')\r\r\n    else:  # halo\r\r\n        for i in range(3):\r\r\n            r = 18 + i * (10 + rng() * 6)\r\r\n            out.append(f'<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r:.0f}\" fill=\"none\" '\r\r\n                       f'stroke=\"{c}\" stroke-width=\"{2.4-i*0.6:.1f}\" '\r\r\n                       f'opacity=\"{0.85-i*0.2:.2f}\" stroke-dasharray=\"{r*4:.0f} {r:.0f}\"/>')\r\r\n    return \"\".join(out)\r\r\n","newText":"\"\"\"Per-personality generated art (C-PersonalityArt) + presentation glass\r\n(C-PresentationGlass: asset pipeline, portrait frames, ambient motion).\r\n\r\nEvery personality's art is *unique to that personality*: the composition is\r\nseeded from the persona's identity (id), name, traits, and interests — never\r\nshared or placeholder media. The generated SVG carries:\r\n- a deterministic motif family derived from the persona's interests\r\n- a palette derived from the persona's name + id\r\n- ambient motion (real SVG animation — drifting elements, not a static image)\r\n- a portrait frame keyed to the persona's display mode / imitation status\r\n\r\nThe asset pipeline is honest: `persona:art` assertions record the seed,\r\nmotif, palette, and artifact path. When a persona's traits change, a re-render\r\nproduces a *new* asset supplanting (not silently overwriting) the old.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport base64\r\nimport hashlib\r\nimport os\r\nimport re\r\nfrom typing import Optional\r\n\r\nMOTIFS = (\"orbits\", \"strata\", \"prism\", \"glyphs\", \"tide\", \"circuit\", \"garden\", \"halo\")\r\nFRAMES = (\"arc\", \"square\", \"notch\", \"double\")\r\n\r\n\r\ndef _seed(persona: dict) -> int:\r\n    h = hashlib.sha256(\r\n        (persona.get(\"id\", \"\") + \"|\" + persona.get(\"name\", \"\") + \"|\" +\r\n         \",\".join(persona.get(\"traits\") or []) + \"|\" +\r\n         \",\".join(persona.get(\"interests\") or [])).encode()).digest()\r\n    return int.from_bytes(h[:8], \"big\")\r\n\r\n\r\ndef _rng(seed: int):\r\n    state = [seed & 0xFFFFFFFFFFFFFFFF or 1]\r\n\r\n    def nxt() -> float:\r\n        state[0] = (state[0] * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF\r\n        return (state[0] >> 33) / 0x7FFFFFFF\r\n    return nxt\r\n\r\n\r\ndef _palette(persona: dict) -> list:\r\n    h = hashlib.md5((persona.get(\"id\", \"\") + persona.get(\"name\", \"\")).encode()).digest()\r\n    base = h[0] / 255 * 360\r\n    cols = []\r\n    for i in range(4):\r\n        hue = (base + i * (40 + h[1] % 90)) % 360\r\n        sat = 45 + (h[2 + i] % 45)\r\n        lit = 30 + (h[6 + i] % 45)\r\n        cols.append(f\"hsl({int(hue)},{sat}%,{lit}%)\")\r\n    return cols\r\n\r\n\r\ndef _motif_for(persona: dict, rng) -> str:\r\n    key = \" \".join(persona.get(\"interests\") or []) + \" \" + \" \".join(persona.get(\"traits\") or [])\r\n    key = (key or persona.get(\"name\", \"\")).lower()\r\n    words = re.findall(r\"[a-z]+\", key)\r\n    vocab = {\"orbits\": (\"star\", \"sky\", \"orbit\", \"space\", \"plan\", \"cycle\", \"calendar\", \"time\"),\r\n             \"strata\": (\"ledger\", \"record\", \"history\", \"layer\", \"archive\", \"data\", \"provenance\"),\r\n             \"prism\": (\"light\", \"glass\", \"spectrum\", \"clarity\", \"analyze\", \"inspect\"),\r\n             \"glyphs\": (\"word\", \"text\", \"write\", \"language\", \"chat\", \"story\", \"essay\"),\r\n             \"tide\": (\"water\", \"flow\", \"travel\", \"music\", \"sound\", \"voice\", \"speech\"),\r\n             \"circuit\": (\"tool\", \"compute\", \"machine\", \"engine\", \"system\", \"build\"),\r\n             \"garden\": (\"grow\", \"plant\", \"nature\", \"care\", \"tend\", \"garden\", \"cultivate\"),\r\n             \"halo\": (\"watch\", \"attention\", \"alert\", \"forward\", \"herald\", \"notify\")}\r\n    best, best_n = MOTIFS[int(rng() * len(MOTIFS))], 0\r\n    for m, words_m in vocab.items():\r\n        n = sum(1 for w in words if any(w.startswith(v) or v in w for v in words_m))\r\n        if n > best_n:\r\n            best, best_n = m, n\r\n    return best\r\n\r\n\r\ndef render_art(ctx, persona: dict, out_dir: Optional[str] = None) -> dict:\r\n    \"\"\"Generate the persona's unique portrait. Returns svg, artifact path,\r\n    and the composition record asserted to the ledger.\"\"\"\r\n    seed = _seed(persona)\r\n    rng = _rng(seed)\r\n    motif = _motif_for(persona, rng)\r\n    cols = _palette(persona)\r\n    frame = FRAMES[int(rng() * len(FRAMES))]\r\n    W = H = 160\r\n    parts = [f'<rect width=\"{W}\" height=\"{H}\" rx=\"18\" fill=\"{cols[0]}\"/>']\r\n    # ambient motion: two drifting halo layers (real SVG animation)\r\n    dur1 = 6 + rng() * 5\r\n    dur2 = 8 + rng() * 6\r\n    parts.append(\r\n        f'<g opacity=\"0.35\"><ellipse cx=\"{W/2}\" cy=\"{H/2}\" rx=\"{55+rng()*15:.0f}\" '\r\n        f'ry=\"{40+rng()*15:.0f}\" fill=\"{cols[1]}\">'\r\n        f'<animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 80 80\" '\r\n        f'to=\"360 80 80\" dur=\"{dur1:.1f}s\" repeatCount=\"indefinite\"/></ellipse></g>')\r\n    parts.append(\r\n        f'<g opacity=\"0.25\"><ellipse cx=\"{W/2}\" cy=\"{H/2}\" rx=\"{30+rng()*12:.0f}\" '\r\n        f'ry=\"{24+rng()*10:.0f}\" fill=\"{cols[2]}\">'\r\n        f'<animateTransform attributeName=\"transform\" type=\"rotate\" from=\"360 80 80\" '\r\n        f'to=\"0 80 80\" dur=\"{dur2:.1f}s\" repeatCount=\"indefinite\"/></ellipse></g>')\r\n    # motif layer\r\n    shapes = _motif_shapes(motif, rng, cols, W, H)\r\n    parts.append(shapes)\r\n    # portrait frame (presentation glass): frame style varies per persona\r\n    if frame == \"arc\":\r\n        parts.append(f'<path d=\"M14 {H-14} A {W-14} {H-14} 0 0 1 {W-14} 14\" fill=\"none\" '\r\n                     f'stroke=\"{cols[3]}\" stroke-width=\"4\"/>')\r\n    elif frame == \"square\":\r\n        parts.append(f'<rect x=\"6\" y=\"6\" width=\"{W-12}\" height=\"{H-12}\" rx=\"10\" '\r\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"3\" '\r\n                     f'stroke-dasharray=\"{8+int(rng()*8)} {4+int(rng()*6)}\"/>')\r\n    elif frame == \"notch\":\r\n        parts.append(f'<rect x=\"6\" y=\"6\" width=\"{W-12}\" height=\"{H-12}\" rx=\"10\" '\r\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"2\"/>'\r\n                     f'<rect x=\"2\" y=\"{H/2-14}\" width=\"8\" height=\"28\" fill=\"{cols[3]}\"/>')\r\n    else:\r\n        parts.append(f'<rect x=\"5\" y=\"5\" width=\"{W-10}\" height=\"{H-10}\" rx=\"12\" '\r\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"2\"/>'\r\n                     f'<rect x=\"11\" y=\"11\" width=\"{W-22}\" height=\"{H-22}\" rx=\"9\" '\r\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"1\" opacity=\"0.6\"/>')\r\n    # permanent imitation mark (prompt §Personalities): corner diamond, always present\r\n    if persona.get(\"imitates\"):\r\n        parts.append('<polygon points=\"132,8 148,24 132,40 116,24\" fill=\"#ffbf00\" '\r\n                     'stroke=\"#000\" stroke-width=\"1.5\"/>'\r\n                     '<text x=\"132\" y=\"28\" font-size=\"9\" text-anchor=\"middle\" '\r\n                     'font-family=\"monospace\" fill=\"#000\">IM</text>')\r\n    # initial monogram\r\n    parts.append(f'<text x=\"{W/2}\" y=\"{H/2+16}\" font-size=\"46\" text-anchor=\"middle\" '\r\n                 f'font-family=\"Georgia, serif\" fill=\"#fff\" opacity=\"0.92\">'\r\n                 f'{persona.get(\"name\", \"?\")[0].upper()}</text>')\r\n    svg = (f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {W} {H}\">'\r\n           + \"\".join(parts) + \"</svg>\")\r\n    artifact = None\r\n    if out_dir:\r\n        os.makedirs(out_dir, exist_ok=True)\r\n        artifact = os.path.join(out_dir, f\"persona-{persona['id']}.svg\")\r\n        with open(artifact, \"w\", encoding=\"utf-8\") as f:\r\n            f.write(svg)\r\n    rec = {\"seed\": seed, \"motif\": motif, \"palette\": cols, \"frame\": frame,\r\n           \"artifact\": artifact, \"ambient\": True,\r\n           \"engine\": \"inproc-svg-glass\"}\r\n    if ctx is not None:\r\n        prev = ctx.ledger.query(subject=f\"persona:{persona['id']}\",\r\n                                predicate=\"persona:art\")\r\n        ctx.append(f\"persona:{persona['id']}\", \"persona:art\", rec,\r\n                   \"engine:portrait\", basis={\"kind\": \"execution\"},\r\n                   supersedes=prev[-1].id if prev else None)\r\n    rec[\"svg\"] = svg\r\n    rec[\"dataUrl\"] = \"data:image/svg+xml;base64,\" + base64.b64encode(svg.encode()).decode()\r\n    return rec\r\n\r\n\r\ndef _motif_shapes(motif: str, rng, cols: list, W: int, H: int) -> str:\r\n    c = cols[2]\r\n    c2 = cols[3]\r\n    out = []\r\n    cx, cy = W / 2, H / 2\r\n    if motif == \"orbits\":\r\n        for i in range(2 + int(rng() * 3)):\r\n            rx, ry = 22 + i * (8 + rng() * 6), 14 + i * (6 + rng() * 5)\r\n            rot = rng() * 360\r\n            out.append(f'<ellipse cx=\"{cx}\" cy=\"{cy}\" rx=\"{rx:.0f}\" ry=\"{ry:.0f}\" '\r\n                       f'fill=\"none\" stroke=\"{c}\" stroke-width=\"1.4\" opacity=\"0.8\" '\r\n                       f'transform=\"rotate({rot:.0f} {cx} {cy})\"/>')\r\n        out.append(f'<circle cx=\"{cx+18}\" cy=\"{cy-12}\" r=\"4\" fill=\"{c2}\"/>')\r\n    elif motif == \"strata\":\r\n        y = 30\r\n        while y < H - 20:\r\n            h = 5 + rng() * 10\r\n            out.append(f'<path d=\"M8 {y:.0f} Q {cx} {y-8+rng()*16:.0f} {W-8} {y:.0f} '\r\n                       f'L {W-8} {y+h:.0f} Q {cx} {y+h-8+rng()*16:.0f} 8 {y+h:.0f} Z\" '\r\n                       f'fill=\"{c}\" opacity=\"{0.25+rng()*0.3:.2f}\"/>')\r\n            y += h + 4 + rng() * 8\r\n    elif motif == \"prism\":\r\n        for i in range(3):\r\n            x = 30 + i * 30 + rng() * 10\r\n            out.append(f'<polygon points=\"{x:.0f},110 {x+22:.0f},110 {x+11:.0f},'\r\n                       f'{52+rng()*20:.0f}\" fill=\"{c}\" opacity=\"{0.3+i*0.18:.2f}\"/>')\r\n        out.append(f'<path d=\"M20 40 L 140 120\" stroke=\"{c2}\" stroke-width=\"1.5\" opacity=\"0.7\"/>')\r\n    elif motif == \"glyphs\":\r\n        chars = \"ᚠᚢᚦᚨᚱᚲᚷᚹᚺᚾᛁᛃᛇᛈᛉᛊᛏᛒᛖᛗᛚᛜᛞᛟ\"\r\n        for i in range(5):\r\n            x, y = 24 + i * 26, 60 + (i % 2) * 34\r\n            ch = chars[int(rng() * len(chars))]\r\n            out.append(f'<text x=\"{x}\" y=\"{y}\" font-size=\"{18+rng()*10:.0f}\" '\r\n                       f'fill=\"{c}\" opacity=\"0.85\">{ch}</text>')\r\n    elif motif == \"tide\":\r\n        for i in range(3 + int(rng() * 2)):\r\n            y = 45 + i * 18\r\n            out.append(f'<path d=\"M6 {y} q 20 {-8-rng()*8:.0f} 40 0 t 40 0 t 40 0 t 40 0\" '\r\n                       f'fill=\"none\" stroke=\"{c}\" stroke-width=\"2.4\" opacity=\"{0.5+rng()*0.3:.2f}\"/>')\r\n    elif motif == \"circuit\":\r\n        nodes = [(20 + rng() * 120, 25 + rng() * 110) for _ in range(5)]\r\n        for i in range(len(nodes) - 1):\r\n            x1, y1 = nodes[i]; x2, y2 = nodes[i + 1]\r\n            out.append(f'<path d=\"M{x1:.0f} {y1:.0f} L{x1:.0f} {y2:.0f} L{x2:.0f} {y2:.0f}\" '\r\n                       f'fill=\"none\" stroke=\"{c}\" stroke-width=\"1.6\" opacity=\"0.7\"/>')\r\n        for x, y in nodes:\r\n            out.append(f'<circle cx=\"{x:.0f}\" cy=\"{y:.0f}\" r=\"3.4\" fill=\"{c2}\"/>')\r\n    elif motif == \"garden\":\r\n        for i in range(3 + int(rng() * 2)):\r\n            x = 35 + i * 30 + rng() * 8\r\n            out.append(f'<path d=\"M{x:.0f} 125 v {-30-rng()*25:.0f}\" stroke=\"{c}\" '\r\n                       f'stroke-width=\"2.6\" fill=\"none\"/>'\r\n                       f'<ellipse cx=\"{x:.0f}\" cy=\"{88-rng()*20:.0f}\" rx=\"{6+rng()*5:.0f}\" '\r\n                       f'ry=\"{9+rng()*6:.0f}\" fill=\"{c2}\" opacity=\"0.8\"/>')\r\n    else:  # halo\r\n        for i in range(3):\r\n            r = 18 + i * (10 + rng() * 6)\r\n            out.append(f'<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r:.0f}\" fill=\"none\" '\r\n                       f'stroke=\"{c}\" stroke-width=\"{2.4-i*0.6:.1f}\" '\r\n                       f'opacity=\"{0.85-i*0.2:.2f}\" stroke-dasharray=\"{r*4:.0f} {r:.0f}\"/>')\r\n    return \"\".join(out)\r\n","_meta":{"cognition.ai/linesAdded":195,"cognition.ai/linesRemoved":407}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\compare.py","oldText":"\"\"\"Competing-tool lifecycle (prompt §Tools and local comparison — F3).\r\n\r\n\r\n\r\nGeneral comparison machinery over genuinely competing tools: every registered\r\n\r\ntool that expresses the same `need:` is an eligible competitor. A competition\r\n\r\ninvokes each runnable competitor on the same input, normalizes the results\r\n\r\nunder a shared local understanding, records each row and the ranking, and\r\n\r\nfeeds outcomes back into the trust-churn loop — so a tool that keeps failing\r\n\r\nsinks among alternatives without ever becoming ineligible.\r\n\r\n\r\n\r\n\"Runnable\" is honest: an unconfigured competitor runs and reports its real\r\n\r\nstatus (unconfigured/error); the row records it, the rank drops, the tool\r\n\r\nstays eligible. Comparison is between *results*, not registration entries.\r\n\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\n\r\n\r\nfrom typing import Optional\r\n\r\n\r\n\r\nfrom .model import new_id, now_ms\r\n\r\n\r\n\r\n\r\n\r\ndef competitors(ctx, need: str) -> list[dict]:\r\n\r\n    return [t for t in ctx.registry.tools() if t.get(\"need\") == need]\r\n\r\n\r\n\r\n\r\n\r\ndef _normalize(res: dict) -> dict:\r\n\r\n    \"\"\"Shared local understanding: every competitor's result is folded to\r\n\r\n    {ok, summary, artifact, count, confidence, error}.\"\"\"\r\n\r\n    r = res.get(\"result\") if isinstance(res.get(\"result\"), dict) else {}\r\n\r\n    out = {\"ok\": bool(res.get(\"ok\")) and not (isinstance(r, dict) and r.get(\"ok\") is False),\r\n\r\n           \"error\": res.get(\"error\") or (r or {}).get(\"error\"),\r\n\r\n           \"ms\": res.get(\"ms\")}\r\n\r\n    if isinstance(r, dict):\r\n\r\n        for k in (\"summary\", \"artifact\", \"renderedBy\", \"items\", \"members\",\r\n\r\n                  \"unconfigured\"):\r\n\r\n            if k in r:\r\n\r\n                out[k] = r[k]\r\n\r\n        out[\"count\"] = (len(r[\"members\"]) if isinstance(r.get(\"members\"), list)\r\n\r\n                        else r.get(\"items\"))\r\n\r\n        out[\"confidence\"] = r.get(\"confidence\", 0.8 if out[\"ok\"] else 0.0)\r\n\r\n    else:\r\n\r\n        out[\"summary\"] = str(res.get(\"result\"))[:200]\r\n\r\n        out[\"confidence\"] = 0.8 if out[\"ok\"] else 0.0\r\n\r\n    return out\r\n\r\n\r\n\r\n\r\n\r\ndef run_competition(ctx, need: str, input: dict, claimant: str = \"principal\",\r\n\r\n                    need_id: Optional[str] = None) -> dict:\r\n\r\n    \"\"\"Invoke every tool expressing `need` on the same input; normalize and\r\n\r\n    rank the results; record the whole comparison as ledger evidence.\"\"\"\r\n\r\n    cands = competitors(ctx, need)\r\n\r\n    comp_id = new_id(\"cmp\")\r\n\r\n    rows = []\r\n\r\n    for t in cands:\r\n\r\n        t0 = now_ms()\r\n\r\n        res = ctx.invoke(t[\"id\"], input, need_id=need_id)\r\n\r\n        norm = _normalize(res)\r\n        _rr = res.get(\"result\") or {}\r\n        if isinstance(_rr, dict) and isinstance(_rr.get(\"members\"), list):\r\n            members_by_tool[t[\"id\"]] = {m[\"name\"]: m for m in _rr[\"members\"]}\r\n\r\n        norm[\"ms\"] = res.get(\"ms\", now_ms() - t0)\r\n\r\n        ok = bool(res.get(\"ok\"))\r\n\r\n        adequate = norm[\"ok\"] and not norm.get(\"unconfigured\")\r\n\r\n        ctx.decision.record_outcome(t[\"id\"], need_id, ok, adequate)\r\n\r\n        row = {\"competition\": comp_id, \"toolId\": t[\"id\"], \"need\": need,\r\n\r\n               \"ok\": norm[\"ok\"], \"adequate\": adequate,\r\n\r\n               \"unconfigured\": bool(norm.get(\"unconfigured\")),\r\n\r\n               \"error\": norm.get(\"error\"), \"ms\": norm[\"ms\"],\r\n\r\n               \"count\": norm.get(\"count\"), \"summary\": norm.get(\"summary\"),\r\n\r\n               \"artifact\": norm.get(\"artifact\"),\r\n\r\n               \"confidence\": norm.get(\"confidence\"),\r\n\r\n               \"rankMultiplier\": ctx.decision.rank_multiplier(t[\"id\"]),\r\n\r\n               \"successRate\": ctx.decision.success_rate(t[\"id\"])}\r\n\r\n        rows.append(row)\r\n\r\n        ctx.append(f\"comparison:{comp_id}\", \"comparison:row\", row,\r\n\r\n                   \"system\", basis={\"kind\": \"execution\"})\r\n\r\n    # rank: adequate rows first, then confidence x rank multiplier\r\n\r\n    def key(r):\r\n\r\n        return (r[\"adequate\"], r[\"confidence\"] * r[\"rankMultiplier\"], -r[\"ms\"] or 0)\r\n\r\n    ranked = sorted(rows, key=key, reverse=True)\r\n\r\n    for i, r in enumerate(ranked):\r\n\r\n        r[\"rank\"] = i + 1\r\n\r\n    rec = {\"id\": comp_id, \"need\": need, \"input\": {k: v for k, v in input.items()\r\n\r\n           if not k.endswith(\"__confidence\")},\r\n\r\n           \"competitors\": len(rows), \"adequate\": sum(1 for r in rows if r[\"adequate\"]),\r\n\r\n           \"ranking\": [{\"rank\": r[\"rank\"], \"toolId\": r[\"toolId\"], \"ok\": r[\"ok\"],\r\n\r\n                        \"adequate\": r[\"adequate\"], \"count\": r.get(\"count\"),\r\n\r\n                        \"confidence\": r[\"confidence\"], \"ms\": r[\"ms\"],\r\n\r\n                        \"unconfigured\": r[\"unconfigured\"]} for r in ranked]}\r\n\r\n    ctx.append(f\"comparison:{comp_id}\", \"comparison:run\", rec, \"system\",\r\n\r\n               basis={\"kind\": \"durable-result\"})\r\n\r\n    return {\"ok\": True, \"competition\": rec, \"rows\": rows,\r\n            \"membersByTool\": members_by_tool}\r\n\r\n","newText":"\"\"\"Competing-tool lifecycle (prompt §Tools and local comparison — F3).\r\n\r\nGeneral comparison machinery over genuinely competing tools: every registered\r\ntool that expresses the same `need:` is an eligible competitor. A competition\r\ninvokes each runnable competitor on the same input, normalizes the results\r\nunder a shared local understanding, records each row and the ranking, and\r\nfeeds outcomes back into the trust-churn loop — so a tool that keeps failing\r\nsinks among alternatives without ever becoming ineligible.\r\n\r\n\"Runnable\" is honest: an unconfigured competitor runs and reports its real\r\nstatus (unconfigured/error); the row records it, the rank drops, the tool\r\nstays eligible. Comparison is between *results*, not registration entries.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nfrom typing import Optional\r\n\r\nfrom .model import new_id, now_ms\r\n\r\n\r\ndef competitors(ctx, need: str) -> list[dict]:\r\n    return [t for t in ctx.registry.tools() if t.get(\"need\") == need]\r\n\r\n\r\ndef _normalize(res: dict) -> dict:\r\n    \"\"\"Shared local understanding: every competitor's result is folded to\r\n    {ok, summary, artifact, count, confidence, error}.\"\"\"\r\n    r = res.get(\"result\") if isinstance(res.get(\"result\"), dict) else {}\r\n    out = {\"ok\": bool(res.get(\"ok\")) and not (isinstance(r, dict) and r.get(\"ok\") is False),\r\n           \"error\": res.get(\"error\") or (r or {}).get(\"error\"),\r\n           \"ms\": res.get(\"ms\")}\r\n    if isinstance(r, dict):\r\n        for k in (\"summary\", \"artifact\", \"renderedBy\", \"items\", \"members\",\r\n                  \"unconfigured\"):\r\n            if k in r:\r\n                out[k] = r[k]\r\n        out[\"count\"] = (len(r[\"members\"]) if isinstance(r.get(\"members\"), list)\r\n                        else r.get(\"items\"))\r\n        out[\"confidence\"] = r.get(\"confidence\", 0.8 if out[\"ok\"] else 0.0)\r\n    else:\r\n        out[\"summary\"] = str(res.get(\"result\"))[:200]\r\n        out[\"confidence\"] = 0.8 if out[\"ok\"] else 0.0\r\n    return out\r\n\r\n\r\ndef run_competition(ctx, need: str, input: dict, claimant: str = \"principal\",\r\n                    need_id: Optional[str] = None) -> dict:\r\n    \"\"\"Invoke every tool expressing `need` on the same input; normalize and\r\n    rank the results; record the whole comparison as ledger evidence.\"\"\"\r\n    cands = competitors(ctx, need)\r\n    comp_id = new_id(\"cmp\")\r\n    rows = []\r\n    for t in cands:\r\n        t0 = now_ms()\r\n        res = ctx.invoke(t[\"id\"], input, need_id=need_id)\r\n        norm = _normalize(res)\r\n        _rr = res.get(\"result\") or {}\r\n        if isinstance(_rr, dict) and isinstance(_rr.get(\"members\"), list):\r\n            members_by_tool[t[\"id\"]] = {m[\"name\"]: m for m in _rr[\"members\"]}\r\n        norm[\"ms\"] = res.get(\"ms\", now_ms() - t0)\r\n        ok = bool(res.get(\"ok\"))\r\n        adequate = norm[\"ok\"] and not norm.get(\"unconfigured\")\r\n        ctx.decision.record_outcome(t[\"id\"], need_id, ok, adequate)\r\n        row = {\"competition\": comp_id, \"toolId\": t[\"id\"], \"need\": need,\r\n               \"ok\": norm[\"ok\"], \"adequate\": adequate,\r\n               \"unconfigured\": bool(norm.get(\"unconfigured\")),\r\n               \"error\": norm.get(\"error\"), \"ms\": norm[\"ms\"],\r\n               \"count\": norm.get(\"count\"), \"summary\": norm.get(\"summary\"),\r\n               \"artifact\": norm.get(\"artifact\"),\r\n               \"confidence\": norm.get(\"confidence\"),\r\n               \"rankMultiplier\": ctx.decision.rank_multiplier(t[\"id\"]),\r\n               \"successRate\": ctx.decision.success_rate(t[\"id\"])}\r\n        rows.append(row)\r\n        ctx.append(f\"comparison:{comp_id}\", \"comparison:row\", row,\r\n                   \"system\", basis={\"kind\": \"execution\"})\r\n    # rank: adequate rows first, then confidence x rank multiplier\r\n    def key(r):\r\n        return (r[\"adequate\"], r[\"confidence\"] * r[\"rankMultiplier\"], -r[\"ms\"] or 0)\r\n    ranked = sorted(rows, key=key, reverse=True)\r\n    for i, r in enumerate(ranked):\r\n        r[\"rank\"] = i + 1\r\n    rec = {\"id\": comp_id, \"need\": need, \"input\": {k: v for k, v in input.items()\r\n           if not k.endswith(\"__confidence\")},\r\n           \"competitors\": len(rows), \"adequate\": sum(1 for r in rows if r[\"adequate\"]),\r\n           \"ranking\": [{\"rank\": r[\"rank\"], \"toolId\": r[\"toolId\"], \"ok\": r[\"ok\"],\r\n                        \"adequate\": r[\"adequate\"], \"count\": r.get(\"count\"),\r\n                        \"confidence\": r[\"confidence\"], \"ms\": r[\"ms\"],\r\n                        \"unconfigured\": r[\"unconfigured\"]} for r in ranked]}\r\n    ctx.append(f\"comparison:{comp_id}\", \"comparison:run\", rec, \"system\",\r\n               basis={\"kind\": \"durable-result\"})\r\n    return {\"ok\": True, \"competition\": rec, \"rows\": rows,\r\n            \"membersByTool\": members_by_tool}\r\n","_meta":{"cognition.ai/linesAdded":0,"cognition.ai/linesRemoved":88}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\connectors.py","oldText":"\"\"\"Connector framework + the cycle's connector set (F8 — owner scope: 3 real,\r\r\nrunnable connectors end-to-end; recorded challenge to C-ConnectorSet's\r\r\n17-connector catalog — narrower set delivered on owner ruling, machinery is\r\r\ngeneral).\r\r\n\r\r\nA connector is a configured source adapter: it pulls external material and\r\r\nemits it as `source-evidence` assertions with provenance, and records each run\r\r\nunder `connector:run` — honest failures included (no ok:true-while-failing;\r\r\nan unreachable remote connector reports `error`, never fabricated items).\r\r\n\r\r\nConnectors this build:\r\r\n- `wikipedia`      live HTTP — page fetch, category members, page summary,\r\r\n                   title search. Backs set-build retrieval, search fan-out,\r\r\n                   and ethics-gate liveness research.\r\r\n- `ics-calendar`   local file — ingest a .ics path into calendar:event evidence\r\r\n                   (the temporal reasoning pipeline's source side).\r\r\n- `files`          local directory — enumerate + fingerprint + excerpt files\r\r\n                   into source-evidence (document corpus ingestion).\r\r\n- `rss`            live HTTP — feed fetch → item entries as source evidence.\r\r\n\r\r\nEach connector exposes `run(ctx, inp)` returning {ok, items|error, ms}.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport hashlib\r\r\nimport json\r\r\nimport os\r\r\nimport re\r\r\nimport urllib.request\r\r\nimport urllib.parse\r\r\nimport xml.etree.ElementTree as ET\r\r\nfrom typing import Optional\r\r\n\r\r\nfrom .model import new_id, now_ms\r\r\n\r\r\nUA = \"Meridian/0.3.0.002 (local-first ledger; research fetch)\"\r\r\n\r\r\n\r\r\ndef http_get(url: str, timeout: float = 12.0,\r\r\n             accept: str = \"text/html,application/json,*/*\") -> dict:\r\r\n    \"\"\"Honest HTTP fetch: returns {ok, body|error, status, url, ms}.\"\"\"\r\r\n    t0 = now_ms()\r\r\n    try:\r\r\n        req = urllib.request.Request(url, headers={\r\r\n            \"User-Agent\": UA, \"Accept\": accept})\r\r\n        with urllib.request.urlopen(req, timeout=timeout) as r:\r\r\n            body = r.read().decode(\"utf-8\", \"replace\")\r\r\n            return {\"ok\": True, \"body\": body, \"status\": getattr(r, \"status\", 200),\r\r\n                    \"url\": url, \"ms\": now_ms() - t0}\r\r\n    except Exception as e:\r\r\n        return {\"ok\": False, \"error\": repr(e), \"url\": url, \"ms\": now_ms() - t0}\r\r\n\r\r\n\r\r\n# ============================ connector registry ============================\r\r\n\r\r\ndef configured(ctx) -> list[dict]:\r\r\n    \"\"\"Configured connectors: connector:configured assertions on\r\r\n    subject connector:<id>.\"\"\"\r\r\n    out = []\r\r\n    for a in ctx.ledger.query(predicate=\"connector:configured\"):\r\r\n        v = a.value[\"v\"]\r\r\n        cid = a.subjectKey.split(\":\", 1)[1]\r\r\n        if cid in CONNECTORS:\r\r\n            out.append({\"id\": cid, **v, \"assertionId\": a.id})\r\r\n    return out\r\r\n\r\r\n\r\r\ndef status(ctx) -> list[dict]:\r\r\n    \"\"\"Each configured connector with its last run record (honest status).\"\"\"\r\r\n    out = []\r\r\n    for c in configured(ctx):\r\r\n        runs = ctx.ledger.query(subject=f\"connector:{c['id']}\",\r\r\n                                predicate=\"connector:run\")\r\r\n        out.append({**c, \"lastRun\": runs[-1].value[\"v\"] if runs else None})\r\r\n    return out\r\r\n\r\r\n\r\r\ndef configure(ctx, cid: str, locator: str, claimant: str = \"principal\",\r\r\n              trust: float = 0.8, extra: Optional[dict] = None) -> dict:\r\r\n    if cid not in CONNECTORS:\r\r\n        return {\"ok\": False, \"error\": f\"unknown connector: {cid}\",\r\r\n                \"known\": sorted(CONNECTORS)}\r\r\n    v = {\"locator\": locator, \"configuredAt\": now_ms(), \"trust\": trust}\r\r\n    if extra:\r\r\n        v.update(extra)\r\r\n    ctx.append(f\"connector:{cid}\", \"connector:configured\", v, claimant,\r\r\n               basis={\"kind\": \"config\"})\r\r\n    ctx.append(f\"source:{cid}\", \"source:configured\",\r\r\n               {\"kind\": CONNECTORS[cid][\"kind\"], \"locator\": locator},\r\r\n               claimant, basis={\"kind\": \"config\"})\r\r\n    ctx.append(f\"source:{cid}\", \"source:trust-class\", \"configured\",\r\r\n               claimant, basis={\"kind\": \"config\"})\r\r\n    ctx.append(f\"source:{cid}\", \"source:confidence\", trust,\r\r\n               claimant, basis={\"kind\": \"config\"})\r\r\n    return {\"ok\": True, \"connector\": cid, \"locator\": locator}\r\r\n\r\r\n\r\r\ndef run(ctx, cid: str, inp: Optional[dict] = None,\r\r\n        claimant: str = \"steward:main\") -> dict:\r\r\n    \"\"\"Execute a connector ingest end-to-end; record connector:run honestly.\"\"\"\r\r\n    spec = CONNECTORS.get(cid)\r\r\n    if not spec:\r\r\n        return {\"ok\": False, \"error\": f\"unknown connector: {cid}\"}\r\r\n    cfg_rows = ctx.ledger.query(subject=f\"connector:{cid}\",\r\r\n                                predicate=\"connector:configured\")\r\r\n    cfg = cfg_rows[-1].value[\"v\"] if cfg_rows else {}\r\r\n    args = dict(cfg.get(\"args\") or {})\r\r\n    args.update(inp or {})\r\r\n    if not args.get(\"locator\"):\r\r\n        args[\"locator\"] = cfg.get(\"locator\")\r\r\n    t0 = now_ms()\r\r\n    try:\r\r\n        res = spec[\"run\"](ctx, args)\r\r\n    except Exception as e:\r\r\n        res = {\"ok\": False, \"error\": repr(e)}\r\r\n    res.setdefault(\"ms\", now_ms() - t0)\r\r\n    ctx.append(f\"connector:{cid}\", \"connector:run\",\r\r\n               {\"ok\": bool(res.get(\"ok\")), \"items\": res.get(\"items\"),\r\r\n                \"error\": res.get(\"error\"), \"ms\": res[\"ms\"],\r\r\n                \"locator\": args.get(\"locator\")},\r\r\n               \"pipeline:connector\", basis={\"kind\": \"execution\"})\r\r\n    return res\r\r\n\r\r\n\r\r\n# ============================ wikipedia (live HTTP) ==========================\r\r\n\r\r\ndef _wiki_api(params: dict, timeout: float = 15.0) -> dict:\r\r\n    qs = urllib.parse.urlencode({**params, \"format\": \"json\"})\r\r\n    r = http_get(\"https://en.wikipedia.org/w/api.php?\" + qs,\r\r\n                 timeout=timeout, accept=\"application/json\")\r\r\n    if not r[\"ok\"]:\r\r\n        return r\r\r\n    try:\r\r\n        return {\"ok\": True, \"data\": json.loads(r[\"body\"]), \"ms\": r[\"ms\"],\r\r\n                \"url\": r[\"url\"]}\r\r\n    except Exception as e:\r\r\n        return {\"ok\": False, \"error\": f\"bad JSON: {e}\", \"url\": r[\"url\"]}\r\r\n\r\r\n\r\r\ndef wiki_category_members(title: str, limit: int = 400) -> dict:\r\r\n    r = _wiki_api({\"action\": \"query\", \"list\": \"categorymembers\",\r\r\n                   \"cmtitle\": title if title.startswith(\"Category:\") else\r\r\n                              \"Category:\" + title,\r\r\n                   \"cmlimit\": limit, \"cmtype\": \"page\"})\r\r\n    if not r[\"ok\"]:\r\r\n        return r\r\r\n    members = [m[\"title\"] for m in r[\"data\"].get(\"query\", {}).get(\"categorymembers\", [])]\r\r\n    return {\"ok\": True, \"titles\": members, \"url\": r[\"url\"], \"ms\": r[\"ms\"]}\r\r\n\r\r\n\r\r\ndef wiki_page_html(title: str) -> dict:\r\r\n    return http_get(\"https://en.wikipedia.org/wiki/\" +\r\r\n                    urllib.parse.quote(title.replace(\" \", \"_\")))\r\r\n\r\r\n\r\r\ndef wiki_summary(title: str) -> dict:\r\r\n    r = http_get(\"https://en.wikipedia.org/api/rest_v1/page/summary/\" +\r\r\n                 urllib.parse.quote(title.replace(\" \", \"_\")),\r\r\n                 accept=\"application/json\")\r\r\n    if not r[\"ok\"]:\r\r\n        return r\r\r\n    try:\r\r\n        d = json.loads(r[\"body\"])\r\r\n        return {\"ok\": True, \"title\": d.get(\"title\"),\r\r\n                \"extract\": d.get(\"extract\", \"\"), \"type\": d.get(\"type\"),\r\r\n                \"url\": r[\"url\"]}\r\r\n    except Exception as e:\r\r\n        return {\"ok\": False, \"error\": f\"bad summary JSON: {e}\"}\r\r\n\r\r\n\r\r\ndef wiki_search(query: str, limit: int = 8) -> dict:\r\r\n    r = http_get(\"https://en.wikipedia.org/w/rest.php/v1/search/title?q=\" +\r\r\n                 urllib.parse.quote(query) + f\"&limit={limit}\",\r\r\n                 accept=\"application/json\")\r\r\n    if not r[\"ok\"]:\r\r\n        return r\r\r\n    try:\r\r\n        d = json.loads(r[\"body\"])\r\r\n        return {\"ok\": True, \"hits\": [{\"title\": p.get(\"title\"),\r\r\n                                      \"excerpt\": re.sub(r\"<[^>]+>\", \"\",\r\r\n                                                        p.get(\"excerpt\", \"\"))}\r\r\n                                     for p in d.get(\"pages\", [])]}\r\r\n    except Exception as e:\r\r\n        return {\"ok\": False, \"error\": f\"bad search JSON: {e}\"}\r\r\n\r\r\n\r\r\ndef _run_wikipedia(ctx, args: dict) -> dict:\r\r\n    \"\"\"Ingest a wikipedia source: `search` (title search), `summary` (page\r\r\n    summary) or `category` (members). Results become source-evidence.\"\"\"\r\r\n    mode = args.get(\"mode\", \"search\")\r\r\n    q = args.get(\"query\") or args.get(\"locator\") or \"\"\r\r\n    if mode == \"summary\":\r\r\n        r = wiki_summary(q)\r\r\n        if not r[\"ok\"]:\r\r\n            return r\r\r\n        ctx.append(\"wikipedia\", \"connector:item\",\r\r\n                   {\"mode\": mode, \"title\": r[\"title\"], \"extract\": r[\"extract\"][:600]},\r\r\n                   \"source:wikipedia\", certainty=0.85,\r\r\n                   basis={\"kind\": \"source-evidence\", \"ref\": r[\"url\"]})\r\r\n        return {\"ok\": True, \"items\": 1, \"title\": r[\"title\"]}\r\r\n    if mode == \"category\":\r\r\n        r = wiki_category_members(q)\r\r\n        if not r[\"ok\"]:\r\r\n            return r\r\r\n        for t in r[\"titles\"]:\r\r\n            ctx.append(\"wikipedia\", \"connector:item\",\r\r\n                       {\"mode\": mode, \"title\": t, \"category\": q},\r\r\n                       \"source:wikipedia\", certainty=0.8,\r\r\n                       basis={\"kind\": \"source-evidence\", \"ref\": r[\"url\"]})\r\r\n        return {\"ok\": True, \"items\": len(r[\"titles\"])}\r\r\n    r = wiki_search(q)\r\r\n    if not r[\"ok\"]:\r\r\n        return r\r\r\n    for h in r[\"hits\"]:\r\r\n        ctx.append(\"wikipedia\", \"connector:item\",\r\r\n                   {\"mode\": mode, \"query\": q, **h},\r\r\n                   \"source:wikipedia\", certainty=0.75,\r\r\n                   basis={\"kind\": \"source-evidence\", \"ref\": \"wikipedia:\" + h[\"title\"]})\r\r\n    return {\"ok\": True, \"items\": len(r[\"hits\"]), \"hits\": r[\"hits\"]}\r\r\n\r\r\n\r\r\n# ============================ ics-calendar (local file) ======================\r\r\n\r\r\ndef _run_ics(ctx, args: dict) -> dict:\r\r\n    path = args.get(\"locator\")\r\r\n    if not path or not os.path.isfile(path):\r\r\n        return {\"ok\": False, \"error\": f\"ics file not found: {path}\",\r\r\n                \"locator\": path}\r\r\n    with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\r\r\n        ics = f.read()\r\r\n    from .builtins import fn_import_calendar\r\r\n    r = fn_import_calendar(ctx, {\"ics\": ics, \"source\": f\"ics:{os.path.basename(path)}\"})\r\r\n    return {\"ok\": True, \"items\": r.get(\"imported\", 0), \"locator\": path}\r\r\n\r\r\n\r\r\n# ============================ files (local directory) ========================\r\r\n\r\r\ndef _run_files(ctx, args: dict) -> dict:\r\r\n    d = args.get(\"locator\")\r\r\n    pattern = args.get(\"pattern\", \"*\")\r\r\n    if not d or not os.path.isdir(d):\r\r\n        return {\"ok\": False, \"error\": f\"directory not found: {d}\", \"locator\": d}\r\r\n    import fnmatch\r\r\n    n = 0\r\r\n    for name in sorted(os.listdir(d)):\r\r\n        if not fnmatch.fnmatch(name.lower(), pattern.lower()):\r\r\n            continue\r\r\n        fp = os.path.join(d, name)\r\r\n        if not os.path.isfile(fp):\r\r\n            continue\r\r\n        try:\r\r\n            size = os.path.getsize(fp)\r\r\n            with open(fp, \"rb\") as f:\r\r\n                head = f.read(4096)\r\r\n            excerpt = head.decode(\"utf-8\", \"replace\")[:400]\r\r\n            digest = hashlib.sha256(head).hexdigest()[:16]\r\r\n        except Exception as e:\r\r\n            ctx.append(\"files\", \"connector:item\",\r\r\n                       {\"name\": name, \"error\": repr(e)},\r\r\n                       \"source:files\", certainty=0.5,\r\r\n                       basis={\"kind\": \"source-evidence\", \"ref\": fp})\r\r\n            continue\r\r\n        ctx.append(\"files\", \"connector:item\",\r\r\n                   {\"name\": name, \"path\": fp, \"bytes\": size,\r\r\n                    \"sha256_4k\": digest, \"excerpt\": excerpt},\r\r\n                   \"source:files\", certainty=0.85,\r\r\n                   basis={\"kind\": \"source-evidence\", \"ref\": fp})\r\r\n        n += 1\r\r\n        if n >= int(args.get(\"max\", 25)):\r\r\n            break\r\r\n    return {\"ok\": True, \"items\": n, \"locator\": d, \"pattern\": pattern}\r\r\n\r\r\n\r\r\n# ============================ rss (live HTTP) ================================\r\r\n\r\r\ndef _run_rss(ctx, args: dict) -> dict:\r\r\n    url = args.get(\"locator\")\r\r\n    if not url:\r\r\n        return {\"ok\": False, \"error\": \"no feed locator\"}\r\r\n    r = http_get(url, accept=\"application/rss+xml,application/atom+xml,text/xml,*/*\")\r\r\n    if not r[\"ok\"]:\r\r\n        return r\r\r\n    try:\r\r\n        root = ET.fromstring(r[\"body\"])\r\r\n    except Exception as e:\r\r\n        return {\"ok\": False, \"error\": f\"unparseable feed: {e}\", \"url\": url}\r\r\n    items = []\r\r\n    for it in root.iter(\"item\"):\r\r\n        title = (it.findtext(\"title\") or \"\").strip()\r\r\n        link = (it.findtext(\"link\") or \"\").strip()\r\r\n        date = (it.findtext(\"pubDate\") or it.findtext(\"date\") or \"\").strip()\r\r\n        items.append({\"title\": title, \"link\": link, \"date\": date})\r\r\n    if not items:  # atom\r\r\n        ns = {\"a\": \"http://www.w3.org/2005/Atom\"}\r\r\n        for it in root.findall(\"a:entry\", ns):\r\r\n            title = (it.findtext(\"a:title\", \"\", ns) or \"\").strip()\r\r\n            link_el = it.find(\"a:link\", ns)\r\r\n            items.append({\"title\": title,\r\r\n                          \"link\": link_el.get(\"href\", \"\") if link_el is not None else \"\",\r\r\n                          \"date\": (it.findtext(\"a:updated\", \"\", ns) or \"\").strip()})\r\r\n    for it in items[: int(args.get(\"max\", 20))]:\r\r\n        ctx.append(\"rss\", \"connector:item\",\r\r\n                   {\"feed\": url, **it}, \"source:rss\", certainty=0.75,\r\r\n                   basis={\"kind\": \"source-evidence\", \"ref\": it.get(\"link\") or url})\r\r\n    return {\"ok\": True, \"items\": len(items), \"feed\": url,\r\r\n            \"titles\": [i[\"title\"] for i in items[:10]]}\r\r\n\r\r\n\r\r\nCONNECTORS = {\r\r\n    \"wikipedia\": {\"kind\": \"remote-api\", \"title\": \"Wikipedia (live API/HTML)\",\r\r\n                  \"locatorHint\": \"search query | Category:X | page title\",\r\r\n                  \"run\": _run_wikipedia},\r\r\n    \"ics-calendar\": {\"kind\": \"local-file\", \"title\": \"ICS calendar file\",\r\r\n                     \"locatorHint\": \"path to .ics file\", \"run\": _run_ics},\r\r\n    \"files\": {\"kind\": \"local-dir\", \"title\": \"Local directory ingest\",\r\r\n              \"locatorHint\": \"directory path\", \"run\": _run_files},\r\r\n    \"rss\": {\"kind\": \"remote-feed\", \"title\": \"RSS/Atom feed\",\r\r\n            \"locatorHint\": \"feed URL\", \"run\": _run_rss},\r\r\n}\r\r\n","newText":"\"\"\"Connector framework + the cycle's connector set (F8 — owner scope: 3 real,\r\nrunnable connectors end-to-end; recorded challenge to C-ConnectorSet's\r\n17-connector catalog — narrower set delivered on owner ruling, machinery is\r\ngeneral).\r\n\r\nA connector is a configured source adapter: it pulls external material and\r\nemits it as `source-evidence` assertions with provenance, and records each run\r\nunder `connector:run` — honest failures included (no ok:true-while-failing;\r\nan unreachable remote connector reports `error`, never fabricated items).\r\n\r\nConnectors this build:\r\n- `wikipedia`      live HTTP — page fetch, category members, page summary,\r\n                   title search. Backs set-build retrieval, search fan-out,\r\n                   and ethics-gate liveness research.\r\n- `ics-calendar`   local file — ingest a .ics path into calendar:event evidence\r\n                   (the temporal reasoning pipeline's source side).\r\n- `files`          local directory — enumerate + fingerprint + excerpt files\r\n                   into source-evidence (document corpus ingestion).\r\n- `rss`            live HTTP — feed fetch → item entries as source evidence.\r\n\r\nEach connector exposes `run(ctx, inp)` returning {ok, items|error, ms}.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport hashlib\r\nimport json\r\nimport os\r\nimport re\r\nimport urllib.request\r\nimport urllib.parse\r\nimport xml.etree.ElementTree as ET\r\nfrom typing import Optional\r\n\r\nfrom .model import new_id, now_ms\r\n\r\nUA = \"Meridian/0.3.0.002 (local-first ledger; research fetch)\"\r\n\r\n\r\ndef http_get(url: str, timeout: float = 12.0,\r\n             accept: str = \"text/html,application/json,*/*\") -> dict:\r\n    \"\"\"Honest HTTP fetch: returns {ok, body|error, status, url, ms}.\"\"\"\r\n    t0 = now_ms()\r\n    try:\r\n        req = urllib.request.Request(url, headers={\r\n            \"User-Agent\": UA, \"Accept\": accept})\r\n        with urllib.request.urlopen(req, timeout=timeout) as r:\r\n            body = r.read().decode(\"utf-8\", \"replace\")\r\n            return {\"ok\": True, \"body\": body, \"status\": getattr(r, \"status\", 200),\r\n                    \"url\": url, \"ms\": now_ms() - t0}\r\n    except Exception as e:\r\n        return {\"ok\": False, \"error\": repr(e), \"url\": url, \"ms\": now_ms() - t0}\r\n\r\n\r\n# ============================ connector registry ============================\r\n\r\ndef configured(ctx) -> list[dict]:\r\n    \"\"\"Configured connectors: connector:configured assertions on\r\n    subject connector:<id>.\"\"\"\r\n    out = []\r\n    for a in ctx.ledger.query(predicate=\"connector:configured\"):\r\n        v = a.value[\"v\"]\r\n        cid = a.subjectKey.split(\":\", 1)[1]\r\n        if cid in CONNECTORS:\r\n            out.append({\"id\": cid, **v, \"assertionId\": a.id})\r\n    return out\r\n\r\n\r\ndef status(ctx) -> list[dict]:\r\n    \"\"\"Each configured connector with its last run record (honest status).\"\"\"\r\n    out = []\r\n    for c in configured(ctx):\r\n        runs = ctx.ledger.query(subject=f\"connector:{c['id']}\",\r\n                                predicate=\"connector:run\")\r\n        out.append({**c, \"lastRun\": runs[-1].value[\"v\"] if runs else None})\r\n    return out\r\n\r\n\r\ndef configure(ctx, cid: str, locator: str, claimant: str = \"principal\",\r\n              trust: float = 0.8, extra: Optional[dict] = None) -> dict:\r\n    if cid not in CONNECTORS:\r\n        return {\"ok\": False, \"error\": f\"unknown connector: {cid}\",\r\n                \"known\": sorted(CONNECTORS)}\r\n    v = {\"locator\": locator, \"configuredAt\": now_ms(), \"trust\": trust}\r\n    if extra:\r\n        v.update(extra)\r\n    ctx.append(f\"connector:{cid}\", \"connector:configured\", v, claimant,\r\n               basis={\"kind\": \"config\"})\r\n    ctx.append(f\"source:{cid}\", \"source:configured\",\r\n               {\"kind\": CONNECTORS[cid][\"kind\"], \"locator\": locator},\r\n               claimant, basis={\"kind\": \"config\"})\r\n    ctx.append(f\"source:{cid}\", \"source:trust-class\", \"configured\",\r\n               claimant, basis={\"kind\": \"config\"})\r\n    ctx.append(f\"source:{cid}\", \"source:confidence\", trust,\r\n               claimant, basis={\"kind\": \"config\"})\r\n    return {\"ok\": True, \"connector\": cid, \"locator\": locator}\r\n\r\n\r\ndef run(ctx, cid: str, inp: Optional[dict] = None,\r\n        claimant: str = \"steward:main\") -> dict:\r\n    \"\"\"Execute a connector ingest end-to-end; record connector:run honestly.\"\"\"\r\n    spec = CONNECTORS.get(cid)\r\n    if not spec:\r\n        return {\"ok\": False, \"error\": f\"unknown connector: {cid}\"}\r\n    cfg_rows = ctx.ledger.query(subject=f\"connector:{cid}\",\r\n                                predicate=\"connector:configured\")\r\n    cfg = cfg_rows[-1].value[\"v\"] if cfg_rows else {}\r\n    args = dict(cfg.get(\"args\") or {})\r\n    args.update(inp or {})\r\n    if not args.get(\"locator\"):\r\n        args[\"locator\"] = cfg.get(\"locator\")\r\n    t0 = now_ms()\r\n    try:\r\n        res = spec[\"run\"](ctx, args)\r\n    except Exception as e:\r\n        res = {\"ok\": False, \"error\": repr(e)}\r\n    res.setdefault(\"ms\", now_ms() - t0)\r\n    ctx.append(f\"connector:{cid}\", \"connector:run\",\r\n               {\"ok\": bool(res.get(\"ok\")), \"items\": res.get(\"items\"),\r\n                \"error\": res.get(\"error\"), \"ms\": res[\"ms\"],\r\n                \"locator\": args.get(\"locator\")},\r\n               \"pipeline:connector\", basis={\"kind\": \"execution\"})\r\n    return res\r\n\r\n\r\n# ============================ wikipedia (live HTTP) ==========================\r\n\r\ndef _wiki_api(params: dict, timeout: float = 15.0) -> dict:\r\n    qs = urllib.parse.urlencode({**params, \"format\": \"json\"})\r\n    r = http_get(\"https://en.wikipedia.org/w/api.php?\" + qs,\r\n                 timeout=timeout, accept=\"application/json\")\r\n    if not r[\"ok\"]:\r\n        return r\r\n    try:\r\n        return {\"ok\": True, \"data\": json.loads(r[\"body\"]), \"ms\": r[\"ms\"],\r\n                \"url\": r[\"url\"]}\r\n    except Exception as e:\r\n        return {\"ok\": False, \"error\": f\"bad JSON: {e}\", \"url\": r[\"url\"]}\r\n\r\n\r\ndef wiki_category_members(title: str, limit: int = 400) -> dict:\r\n    r = _wiki_api({\"action\": \"query\", \"list\": \"categorymembers\",\r\n                   \"cmtitle\": title if title.startswith(\"Category:\") else\r\n                              \"Category:\" + title,\r\n                   \"cmlimit\": limit, \"cmtype\": \"page\"})\r\n    if not r[\"ok\"]:\r\n        return r\r\n    members = [m[\"title\"] for m in r[\"data\"].get(\"query\", {}).get(\"categorymembers\", [])]\r\n    return {\"ok\": True, \"titles\": members, \"url\": r[\"url\"], \"ms\": r[\"ms\"]}\r\n\r\n\r\ndef wiki_page_html(title: str) -> dict:\r\n    return http_get(\"https://en.wikipedia.org/wiki/\" +\r\n                    urllib.parse.quote(title.replace(\" \", \"_\")))\r\n\r\n\r\ndef wiki_summary(title: str) -> dict:\r\n    r = http_get(\"https://en.wikipedia.org/api/rest_v1/page/summary/\" +\r\n                 urllib.parse.quote(title.replace(\" \", \"_\")),\r\n                 accept=\"application/json\")\r\n    if not r[\"ok\"]:\r\n        return r\r\n    try:\r\n        d = json.loads(r[\"body\"])\r\n        return {\"ok\": True, \"title\": d.get(\"title\"),\r\n                \"extract\": d.get(\"extract\", \"\"), \"type\": d.get(\"type\"),\r\n                \"url\": r[\"url\"]}\r\n    except Exception as e:\r\n        return {\"ok\": False, \"error\": f\"bad summary JSON: {e}\"}\r\n\r\n\r\ndef wiki_search(query: str, limit: int = 8) -> dict:\r\n    r = http_get(\"https://en.wikipedia.org/w/rest.php/v1/search/title?q=\" +\r\n                 urllib.parse.quote(query) + f\"&limit={limit}\",\r\n                 accept=\"application/json\")\r\n    if not r[\"ok\"]:\r\n        return r\r\n    try:\r\n        d = json.loads(r[\"body\"])\r\n        return {\"ok\": True, \"hits\": [{\"title\": p.get(\"title\"),\r\n                                      \"excerpt\": re.sub(r\"<[^>]+>\", \"\",\r\n                                                        p.get(\"excerpt\", \"\"))}\r\n                                     for p in d.get(\"pages\", [])]}\r\n    except Exception as e:\r\n        return {\"ok\": False, \"error\": f\"bad search JSON: {e}\"}\r\n\r\n\r\ndef _run_wikipedia(ctx, args: dict) -> dict:\r\n    \"\"\"Ingest a wikipedia source: `search` (title search), `summary` (page\r\n    summary) or `category` (members). Results become source-evidence.\"\"\"\r\n    mode = args.get(\"mode\", \"search\")\r\n    q = args.get(\"query\") or args.get(\"locator\") or \"\"\r\n    if mode == \"summary\":\r\n        r = wiki_summary(q)\r\n        if not r[\"ok\"]:\r\n            return r\r\n        ctx.append(\"wikipedia\", \"connector:item\",\r\n                   {\"mode\": mode, \"title\": r[\"title\"], \"extract\": r[\"extract\"][:600]},\r\n                   \"source:wikipedia\", certainty=0.85,\r\n                   basis={\"kind\": \"source-evidence\", \"ref\": r[\"url\"]})\r\n        return {\"ok\": True, \"items\": 1, \"title\": r[\"title\"]}\r\n    if mode == \"category\":\r\n        r = wiki_category_members(q)\r\n        if not r[\"ok\"]:\r\n            return r\r\n        for t in r[\"titles\"]:\r\n            ctx.append(\"wikipedia\", \"connector:item\",\r\n                       {\"mode\": mode, \"title\": t, \"category\": q},\r\n                       \"source:wikipedia\", certainty=0.8,\r\n                       basis={\"kind\": \"source-evidence\", \"ref\": r[\"url\"]})\r\n        return {\"ok\": True, \"items\": len(r[\"titles\"])}\r\n    r = wiki_search(q)\r\n    if not r[\"ok\"]:\r\n        return r\r\n    for h in r[\"hits\"]:\r\n        ctx.append(\"wikipedia\", \"connector:item\",\r\n                   {\"mode\": mode, \"query\": q, **h},\r\n                   \"source:wikipedia\", certainty=0.75,\r\n                   basis={\"kind\": \"source-evidence\", \"ref\": \"wikipedia:\" + h[\"title\"]})\r\n    return {\"ok\": True, \"items\": len(r[\"hits\"]), \"hits\": r[\"hits\"]}\r\n\r\n\r\n# ============================ ics-calendar (local file) ======================\r\n\r\ndef _run_ics(ctx, args: dict) -> dict:\r\n    path = args.get(\"locator\")\r\n    if not path or not os.path.isfile(path):\r\n        return {\"ok\": False, \"error\": f\"ics file not found: {path}\",\r\n                \"locator\": path}\r\n    with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\r\n        ics = f.read()\r\n    from .builtins import fn_import_calendar\r\n    r = fn_import_calendar(ctx, {\"ics\": ics, \"source\": f\"ics:{os.path.basename(path)}\"})\r\n    return {\"ok\": True, \"items\": r.get(\"imported\", 0), \"locator\": path}\r\n\r\n\r\n# ============================ files (local directory) ========================\r\n\r\ndef _run_files(ctx, args: dict) -> dict:\r\n    d = args.get(\"locator\")\r\n    pattern = args.get(\"pattern\", \"*\")\r\n    if not d or not os.path.isdir(d):\r\n        return {\"ok\": False, \"error\": f\"directory not found: {d}\", \"locator\": d}\r\n    import fnmatch\r\n    n = 0\r\n    for name in sorted(os.listdir(d)):\r\n        if not fnmatch.fnmatch(name.lower(), pattern.lower()):\r\n            continue\r\n        fp = os.path.join(d, name)\r\n        if not os.path.isfile(fp):\r\n            continue\r\n        try:\r\n            size = os.path.getsize(fp)\r\n            with open(fp, \"rb\") as f:\r\n                head = f.read(4096)\r\n            excerpt = head.decode(\"utf-8\", \"replace\")[:400]\r\n            digest = hashlib.sha256(head).hexdigest()[:16]\r\n        except Exception as e:\r\n            ctx.append(\"files\", \"connector:item\",\r\n                       {\"name\": name, \"error\": repr(e)},\r\n                       \"source:files\", certainty=0.5,\r\n                       basis={\"kind\": \"source-evidence\", \"ref\": fp})\r\n            continue\r\n        ctx.append(\"files\", \"connector:item\",\r\n                   {\"name\": name, \"path\": fp, \"bytes\": size,\r\n                    \"sha256_4k\": digest, \"excerpt\": excerpt},\r\n                   \"source:files\", certainty=0.85,\r\n                   basis={\"kind\": \"source-evidence\", \"ref\": fp})\r\n        n += 1\r\n        if n >= int(args.get(\"max\", 25)):\r\n            break\r\n    return {\"ok\": True, \"items\": n, \"locator\": d, \"pattern\": pattern}\r\n\r\n\r\n# ============================ rss (live HTTP) ================================\r\n\r\ndef _run_rss(ctx, args: dict) -> dict:\r\n    url = args.get(\"locator\")\r\n    if not url:\r\n        return {\"ok\": False, \"error\": \"no feed locator\"}\r\n    r = http_get(url, accept=\"application/rss+xml,application/atom+xml,text/xml,*/*\")\r\n    if not r[\"ok\"]:\r\n        return r\r\n    try:\r\n        root = ET.fromstring(r[\"body\"])\r\n    except Exception as e:\r\n        return {\"ok\": False, \"error\": f\"unparseable feed: {e}\", \"url\": url}\r\n    items = []\r\n    for it in root.iter(\"item\"):\r\n        title = (it.findtext(\"title\") or \"\").strip()\r\n        link = (it.findtext(\"link\") or \"\").strip()\r\n        date = (it.findtext(\"pubDate\") or it.findtext(\"date\") or \"\").strip()\r\n        items.append({\"title\": title, \"link\": link, \"date\": date})\r\n    if not items:  # atom\r\n        ns = {\"a\": \"http://www.w3.org/2005/Atom\"}\r\n        for it in root.findall(\"a:entry\", ns):\r\n            title = (it.findtext(\"a:title\", \"\", ns) or \"\").strip()\r\n            link_el = it.find(\"a:link\", ns)\r\n            items.append({\"title\": title,\r\n                          \"link\": link_el.get(\"href\", \"\") if link_el is not None else \"\",\r\n                          \"date\": (it.findtext(\"a:updated\", \"\", ns) or \"\").strip()})\r\n    for it in items[: int(args.get(\"max\", 20))]:\r\n        ctx.append(\"rss\", \"connector:item\",\r\n                   {\"feed\": url, **it}, \"source:rss\", certainty=0.75,\r\n                   basis={\"kind\": \"source-evidence\", \"ref\": it.get(\"link\") or url})\r\n    return {\"ok\": True, \"items\": len(items), \"feed\": url,\r\n            \"titles\": [i[\"title\"] for i in items[:10]]}\r\n\r\n\r\nCONNECTORS = {\r\n    \"wikipedia\": {\"kind\": \"remote-api\", \"title\": \"Wikipedia (live API/HTML)\",\r\n                  \"locatorHint\": \"search query | Category:X | page title\",\r\n                  \"run\": _run_wikipedia},\r\n    \"ics-calendar\": {\"kind\": \"local-file\", \"title\": \"ICS calendar file\",\r\n                     \"locatorHint\": \"path to .ics file\", \"run\": _run_ics},\r\n    \"files\": {\"kind\": \"local-dir\", \"title\": \"Local directory ingest\",\r\n              \"locatorHint\": \"directory path\", \"run\": _run_files},\r\n    \"rss\": {\"kind\": \"remote-feed\", \"title\": \"RSS/Atom feed\",\r\n            \"locatorHint\": \"feed URL\", \"run\": _run_rss},\r\n}\r\n","_meta":{"cognition.ai/linesAdded":278,"cognition.ai/linesRemoved":597}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\ethics.py","oldText":"\"\"\"Ethics gate (C-EthicsGate — the machinery beneath the prompt-specified\r\n\r\nimitation mark, §Personalities).\r\n\r\n\r\n\r\nDepth over the mark alone:\r\n\r\n- **liveness research** — the gate looks the subject up through the configured\r\n\r\n  wikipedia connector and classifies living / deceased / unclear from the\r\n\r\n  returned summary evidence (never guesses silently: unclear is a real verdict\r\n\r\n  that still requires the mark when the claimed recency is living/recent).\r\n\r\n- **objection/compliance flow** — `maxim:objection` assertions (seeded or\r\n\r\n  user-authored patterns like \"no imitations of active politicians\") are\r\n\r\n  checked; a matching objection changes the verdict to refused, which is a\r\n\r\n  recorded refusal, not silent non-action.\r\n\r\n- **gate cards** — every evaluation emits an `ethics-gate` bus card for the\r\n\r\n  surfaces and an `ethics:gate` ledger assertion with verdict + evidence.\r\n\r\n- **compliance** — a mint whose verdict requires the mark proceeds only with\r\n\r\n  admonishment + permanent mark; a refused mint does not proceed and the need\r\n\r\n  is recorded deferred/refused.\r\n\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\n\r\n\r\nimport re\r\n\r\nfrom typing import Optional\r\n\r\n\r\n\r\nfrom . import connectors\r\n\r\nfrom .model import now_ms\r\n\r\n\r\n\r\n# recency classes requiring admonishment + permanent mark (prompt §Personalities)\r\n\r\n_MARKED = (\"living\", \"deceased-10y\")\r\n\r\n\r\n\r\n\r\n\r\ndef liveness_research(ctx, name: str) -> dict:\r\n\r\n    \"\"\"Research the subject through the wikipedia connector; classify from\r\n\r\n    real summary evidence.\"\"\"\r\n\r\n    r = connectors.wiki_summary(name)\r\n\r\n    if not r[\"ok\"]:\r\n\r\n        return {\"verdict\": \"unclear\", \"evidence\": f\"lookup failed: {r.get('error')}\",\r\n\r\n                \"reachable\": False}\r\n\r\n    ex = r.get(\"extract\") or \"\"\r\n\r\n    death = re.search(r\"\\b(?:died|death)\\b.*?(\\b1[89]\\d{2}|20[0-2]\\d)\", ex)\r\n\r\n    born = re.search(r\"born[^.;]{0,60}?(\\b1[89]\\d{2}|20[0-2]\\d)\", ex)\r\n\r\n    if death or re.search(r\"\\bwas an? \", ex):\r\n\r\n        return {\"verdict\": \"deceased\", \"evidence\": ex[:240],\r\n\r\n                \"deathYear\": int(death.group(1)) if death else None,\r\n\r\n                \"reachable\": True, \"title\": r.get(\"title\")}\r\n\r\n    if born or re.search(r\"\\bis an? \", ex):\r\n\r\n        return {\"verdict\": \"living\", \"evidence\": ex[:240],\r\n\r\n                \"birthYear\": int(born.group(1)) if born else None,\r\n\r\n                \"reachable\": True, \"title\": r.get(\"title\")}\r\n\r\n    return {\"verdict\": \"unclear\", \"evidence\": ex[:240] or \"empty summary\",\r\n\r\n            \"reachable\": True, \"title\": r.get(\"title\")}\r\n\r\n\r\n\r\n\r\n\r\ndef objections(ctx, name: str) -> list[dict]:\r\n\r\n    \"\"\"maxim:objection assertions act as user-authored prohibition patterns.\"\"\"\r\n\r\n    hits = []\r\n\r\n    for a in ctx.ledger.query(predicate=\"maxim:objection\"):\r\n\r\n        v = a.value[\"v\"]\r\n\r\n        pat = v.get(\"pattern\", \"\") if isinstance(v, dict) else str(v)\r\n\r\n        if pat and re.search(pat, name, re.I):\r\n\r\n            hits.append({\"pattern\": pat,\r\n\r\n                         \"note\": v.get(\"note\") if isinstance(v, dict) else None,\r\n\r\n                         \"assertionId\": a.id})\r\n\r\n    return hits\r\n\r\n\r\n\r\n\r\n\r\ndef evaluate(ctx, name: str, imitates: Optional[dict],\r\n\r\n             claimant: str = \"principal\") -> dict:\r\n\r\n    \"\"\"Run the gate for a proposed persona. Returns the verdict dict; every\r\n\r\n    evaluation is recorded (ethics:gate) and carded (ethics-gate).\"\"\"\r\n\r\n    if not imitates:\r\n\r\n        verdict = {\"verdict\": \"allowed\", \"subject\": name,\r\n\r\n                   \"reasons\": [\"no imitation claimed\"]}\r\n\r\n        _record(ctx, name, verdict)\r\n\r\n        return verdict\r\n\r\n    iname = imitates.get(\"name\", \"\")\r\n\r\n    recency = imitates.get(\"recency\", \"living\")\r\n\r\n    obs = objections(ctx, iname)\r\n\r\n    live = (liveness_research(ctx, iname)\r\n            if recency in _MARKED + (\"deceased-older\",)\r\n            else {\"verdict\": \"n/a\",\r\n                  \"evidence\": \"fictional subject -- no liveness check\"})\r\n\r\n    reasons = []\r\n\r\n    if obs:\r\n\r\n        verdict = \"refused\"\r\n\r\n        reasons.append(f\"objection match: {obs[0]['pattern']} — {obs[0].get('note') or 'no note'}\")\r\n\r\n    elif recency in _MARKED:\r\n\r\n        verdict = \"admonish-required\"\r\n\r\n        reasons.append(f\"imitates a person ({recency}); admonishment + permanent \"\r\n\r\n                       f\"distinguishing mark required by prompt §Personalities\")\r\n\r\n        if live.get(\"verdict\") == \"deceased\":\r\n\r\n            reasons.append(f\"liveness research suggests deceased \"\r\n\r\n                           f\"({live.get('evidence','')[:80]}…) — recency class kept as claimed\")\r\n\r\n        elif live.get(\"verdict\") == \"living\":\r\n\r\n            reasons.append(\"liveness research corroborates living subject\")\r\n\r\n        else:\r\n\r\n            reasons.append(f\"liveness unclear ({live.get('evidence','')[:80]}) — \"\r\n\r\n                           f\"claimed recency treated conservatively\")\r\n\r\n    elif recency == \"deceased-older\":\r\n\r\n        verdict = \"mark-required\"\r\n\r\n        reasons.append(\"imitates a person deceased >10y; mark required, \"\r\n\r\n                       \"admonishment not mandated\")\r\n\r\n    else:\r\n\r\n        verdict = \"allowed\"\r\n\r\n        reasons.append(\"fictional/unclaimed subject\")\r\n\r\n    verdict = {\"verdict\": verdict, \"subject\": name, \"imitates\": iname,\r\n\r\n               \"recency\": recency, \"reasons\": reasons,\r\n\r\n               \"liveness\": live, \"objections\": obs}\r\n\r\n    _record(ctx, name, verdict)\r\n\r\n    return verdict\r\n\r\n\r\n\r\n\r\n\r\ndef _record(ctx, name: str, verdict: dict):\r\n\r\n    ctx.append(\"ethics\", \"ethics:gate\",\r\n\r\n               {\"subject\": name, **verdict, \"at\": now_ms()},\r\n\r\n               \"system\", basis={\"kind\": \"durable-result\"})\r\n\r\n    ctx.emit(\"card\", {\"kind\": \"ethics-gate\",\r\n\r\n                      \"summary\": f\"ethics gate: {verdict['verdict']} — \"\r\n\r\n                                 f\"{name}\" + (f\" (imitates {verdict.get('imitates')})\"\r\n\r\n                                              if verdict.get('imitates') else \"\"),\r\n\r\n                      \"verdict\": verdict[\"verdict\"],\r\n\r\n                      \"reasons\": verdict[\"reasons\"],\r\n\r\n                      \"at\": now_ms()})\r\n\r\n","newText":"\"\"\"Ethics gate (C-EthicsGate — the machinery beneath the prompt-specified\r\nimitation mark, §Personalities).\r\n\r\nDepth over the mark alone:\r\n- **liveness research** — the gate looks the subject up through the configured\r\n  wikipedia connector and classifies living / deceased / unclear from the\r\n  returned summary evidence (never guesses silently: unclear is a real verdict\r\n  that still requires the mark when the claimed recency is living/recent).\r\n- **objection/compliance flow** — `maxim:objection` assertions (seeded or\r\n  user-authored patterns like \"no imitations of active politicians\") are\r\n  checked; a matching objection changes the verdict to refused, which is a\r\n  recorded refusal, not silent non-action.\r\n- **gate cards** — every evaluation emits an `ethics-gate` bus card for the\r\n  surfaces and an `ethics:gate` ledger assertion with verdict + evidence.\r\n- **compliance** — a mint whose verdict requires the mark proceeds only with\r\n  admonishment + permanent mark; a refused mint does not proceed and the need\r\n  is recorded deferred/refused.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport re\r\nfrom typing import Optional\r\n\r\nfrom . import connectors\r\nfrom .model import now_ms\r\n\r\n# recency classes requiring admonishment + permanent mark (prompt §Personalities)\r\n_MARKED = (\"living\", \"deceased-10y\")\r\n\r\n\r\ndef liveness_research(ctx, name: str) -> dict:\r\n    \"\"\"Research the subject through the wikipedia connector; classify from\r\n    real summary evidence.\"\"\"\r\n    r = connectors.wiki_summary(name)\r\n    if not r[\"ok\"]:\r\n        return {\"verdict\": \"unclear\", \"evidence\": f\"lookup failed: {r.get('error')}\",\r\n                \"reachable\": False}\r\n    ex = r.get(\"extract\") or \"\"\r\n    death = re.search(r\"\\b(?:died|death)\\b.*?(\\b1[89]\\d{2}|20[0-2]\\d)\", ex)\r\n    born = re.search(r\"born[^.;]{0,60}?(\\b1[89]\\d{2}|20[0-2]\\d)\", ex)\r\n    if death or re.search(r\"\\bwas an? \", ex):\r\n        return {\"verdict\": \"deceased\", \"evidence\": ex[:240],\r\n                \"deathYear\": int(death.group(1)) if death else None,\r\n                \"reachable\": True, \"title\": r.get(\"title\")}\r\n    if born or re.search(r\"\\bis an? \", ex):\r\n        return {\"verdict\": \"living\", \"evidence\": ex[:240],\r\n                \"birthYear\": int(born.group(1)) if born else None,\r\n                \"reachable\": True, \"title\": r.get(\"title\")}\r\n    return {\"verdict\": \"unclear\", \"evidence\": ex[:240] or \"empty summary\",\r\n            \"reachable\": True, \"title\": r.get(\"title\")}\r\n\r\n\r\ndef objections(ctx, name: str) -> list[dict]:\r\n    \"\"\"maxim:objection assertions act as user-authored prohibition patterns.\"\"\"\r\n    hits = []\r\n    for a in ctx.ledger.query(predicate=\"maxim:objection\"):\r\n        v = a.value[\"v\"]\r\n        pat = v.get(\"pattern\", \"\") if isinstance(v, dict) else str(v)\r\n        if pat and re.search(pat, name, re.I):\r\n            hits.append({\"pattern\": pat,\r\n                         \"note\": v.get(\"note\") if isinstance(v, dict) else None,\r\n                         \"assertionId\": a.id})\r\n    return hits\r\n\r\n\r\ndef evaluate(ctx, name: str, imitates: Optional[dict],\r\n             claimant: str = \"principal\") -> dict:\r\n    \"\"\"Run the gate for a proposed persona. Returns the verdict dict; every\r\n    evaluation is recorded (ethics:gate) and carded (ethics-gate).\"\"\"\r\n    if not imitates:\r\n        verdict = {\"verdict\": \"allowed\", \"subject\": name,\r\n                   \"reasons\": [\"no imitation claimed\"]}\r\n        _record(ctx, name, verdict)\r\n        return verdict\r\n    iname = imitates.get(\"name\", \"\")\r\n    recency = imitates.get(\"recency\", \"living\")\r\n    obs = objections(ctx, iname)\r\n    live = (liveness_research(ctx, iname)\r\n            if recency in _MARKED + (\"deceased-older\",)\r\n            else {\"verdict\": \"n/a\",\r\n                  \"evidence\": \"fictional subject -- no liveness check\"})\r\n    reasons = []\r\n    if obs:\r\n        verdict = \"refused\"\r\n        reasons.append(f\"objection match: {obs[0]['pattern']} — {obs[0].get('note') or 'no note'}\")\r\n    elif recency in _MARKED:\r\n        verdict = \"admonish-required\"\r\n        reasons.append(f\"imitates a person ({recency}); admonishment + permanent \"\r\n                       f\"distinguishing mark required by prompt §Personalities\")\r\n        if live.get(\"verdict\") == \"deceased\":\r\n            reasons.append(f\"liveness research suggests deceased \"\r\n                           f\"({live.get('evidence','')[:80]}…) — recency class kept as claimed\")\r\n        elif live.get(\"verdict\") == \"living\":\r\n            reasons.append(\"liveness research corroborates living subject\")\r\n        else:\r\n            reasons.append(f\"liveness unclear ({live.get('evidence','')[:80]}) — \"\r\n                           f\"claimed recency treated conservatively\")\r\n    elif recency == \"deceased-older\":\r\n        verdict = \"mark-required\"\r\n        reasons.append(\"imitates a person deceased >10y; mark required, \"\r\n                       \"admonishment not mandated\")\r\n    else:\r\n        verdict = \"allowed\"\r\n        reasons.append(\"fictional/unclaimed subject\")\r\n    verdict = {\"verdict\": verdict, \"subject\": name, \"imitates\": iname,\r\n               \"recency\": recency, \"reasons\": reasons,\r\n               \"liveness\": live, \"objections\": obs}\r\n    _record(ctx, name, verdict)\r\n    return verdict\r\n\r\n\r\ndef _record(ctx, name: str, verdict: dict):\r\n    ctx.append(\"ethics\", \"ethics:gate\",\r\n               {\"subject\": name, **verdict, \"at\": now_ms()},\r\n               \"system\", basis={\"kind\": \"durable-result\"})\r\n    ctx.emit(\"card\", {\"kind\": \"ethics-gate\",\r\n                      \"summary\": f\"ethics gate: {verdict['verdict']} — \"\r\n                                 f\"{name}\" + (f\" (imitates {verdict.get('imitates')})\"\r\n                                              if verdict.get('imitates') else \"\"),\r\n                      \"verdict\": verdict[\"verdict\"],\r\n                      \"reasons\": verdict[\"reasons\"],\r\n                      \"at\": now_ms()})\r\n","_meta":{"cognition.ai/linesAdded":0,"cognition.ai/linesRemoved":119}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\setbuild.py","oldText":"\"\"\"Set-build — geographic set fulfillment machinery (C-SetBuild; the\r\n\r\nmachinery beneath S-list-project).\r\n\r\n\r\n\r\nA set project declares a governed requirement: kind `set-members`, slots\r\n\r\n{region, memberKind, criteria, minCount}. Two genuinely competing retrieval\r\n\r\ntools express need `set.members` and produce comparable member evidence:\r\n\r\n\r\n\r\n- `retrieve-set-wiki-table`    parses the region's canonical list page table\r\n\r\n- `retrieve-set-wiki-category` reads the category membership API\r\n\r\n\r\n\r\nBoth are live HTTP against Wikipedia — different retrieval strategies, same\r\n\r\nneed. Their evidence lands as need:candidate rows: real members at high\r\n\r\nconfidence, and headers / foreign links / non-member titles / category errors\r\n\r\nrecorded as results-that-do-not-match, retained for review and cleanup\r\n\r\n(prompt demo 4). Criteria are asserted on the need and preserved through\r\n\r\nrefinement (`need:refined` adds criteria; nothing rewrites the original).\r\n\r\n\r\n\r\n`set-build-collect` closes the set: compares the competing retrievals\r\n\r\n(agreement, unique contributions, disagreements flagged), applies the\r\n\r\ncriteria, writes the produced list artifact + set:member assertions +\r\n\r\nset:closure durable result.\r\n\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\n\r\n\r\nimport html as _html\r\n\r\nimport json\r\n\r\nimport os\r\n\r\nimport re\r\n\r\nimport urllib.parse\r\n\r\nfrom typing import Optional\r\n\r\n\r\n\r\nfrom . import connectors, needs\r\n\r\nfrom .model import new_id, now_ms\r\n\r\n\r\n\r\nSET_NEED = \"set.members\"\r\n\r\n\r\n\r\n\r\n\r\n# ---- parsing helpers --------------------------------------------------------\r\n\r\n\r\n\r\ndef _strip(s: str) -> str:\r\n\r\n    return re.sub(r\"\\s+\", \" \", _html.unescape(re.sub(r\"<[^>]+>\", \"\", s))).strip()\r\n\r\n\r\n\r\n\r\n\r\ndef _table_rows(page_html: str) -> list[list[str]]:\r\n\r\n    \"\"\"Extract cell text per row from the first wikitable in the page.\"\"\"\r\n\r\n    m = re.search(r'<table[^>]*class=\"[^\"]*wikitable[^\"]*\"[^>]*>(.*?)</table>',\r\n\r\n                  page_html, re.S)\r\n\r\n    if not m:\r\n\r\n        return []\r\n\r\n    rows = []\r\n\r\n    for tr in re.findall(r\"<tr[^>]*>(.*?)</tr>\", m.group(1), re.S):\r\n\r\n        cells = [_strip(c) for c in re.findall(r\"<t[hd][^>]*>(.*?)</t[hd]>\", tr, re.S)]\r\n\r\n        if cells:\r\n\r\n            rows.append(cells)\r\n\r\n    return rows\r\n\r\n\r\n\r\n\r\n\r\n# ---- fn-backed tools --------------------------------------------------------\r\n\r\n\r\n\r\ndef fn_set_project_open(ctx, inp, grant):\r\n\r\n    \"\"\"Create a set-fulfillment project + the governing set-members need.\r\n\r\n    Triggered from chat (\"list all the cities in Pennsylvania\") or invoked\r\n\r\n    directly.\"\"\"\r\n\r\n    region = (inp.get(\"region\") or \"\").strip()\r\n\r\n    kind = (inp.get(\"memberKind\") or \"\").strip()\r\n\r\n    criteria = (inp.get(\"criteria\") or\r\n\r\n                f\"incorporated {kind}s in {region}\" + \"s\" if kind else \"set members\")\r\n\r\n    pid = new_id(\"proj\")\r\n\r\n    subj = f\"project:{pid}\"\r\n\r\n    title = inp.get(\"title\") or f\"list all the {kind}s in {region}\".strip()\r\n\r\n    ctx.append(subj, \"project:exists\", {\"title\": title}, \"principal\",\r\n\r\n               basis={\"kind\": \"user-choice\"})\r\n\r\n    ctx.append(subj, \"project:title\", title, \"principal\")\r\n\r\n    ctx.append(subj, \"project:kind\", \"set-build\", \"principal\")\r\n\r\n    spec = {\"summary\": f\"set members: {kind} in {region}\",\r\n\r\n            \"project\": pid,\r\n\r\n            \"slots\": {\"region\": region, \"memberKind\": kind,\r\n\r\n                      \"criteria\": criteria,\r\n\r\n                      \"minCount\": int(inp.get(\"minCount\") or 1)},\r\n\r\n            \"satisfaction\": {\"resultTests\": [\r\n\r\n                {\"gte\": [{\"$ref\": \"result.memberCount\"},\r\n\r\n                         int(inp.get(\"minCount\") or 1)]}]},\r\n\r\n            \"toolId\": \"set-build-collect\"}\r\n\r\n    nid = needs.open_need(ctx, \"set-members\", spec, claimant=\"principal\")\r\n\r\n    for slot in (\"region\", \"memberKind\", \"criteria\"):\r\n\r\n        needs.add_candidate(ctx, nid, slot, spec[\"slots\"][slot], 0.95,\r\n\r\n                            \"input\", \"principal\")\r\n\r\n    ctx.append(f\"need:{nid}\", \"set:criteria\",\r\n\r\n               {\"criteria\": criteria, \"region\": region, \"memberKind\": kind},\r\n\r\n               \"principal\", basis={\"kind\": \"user-choice\"})\r\n\r\n    return {\"ok\": True, \"projectId\": pid, \"needId\": nid, \"spec\": spec}\r\n\r\n\r\n\r\n\r\n\r\ndef fn_retrieve_wiki_table(ctx, inp, grant):\r\n\r\n    \"\"\"Competitor 1 (need set.members): parse the canonical list page's\r\n\r\n    wikitable into member candidates + classified non-matches.\"\"\"\r\n\r\n    region, kind = inp.get(\"region\", \"\"), (inp.get(\"memberKind\") or \"\").lower()\r\n\r\n    nid = inp.get(\"needId\")\r\n\r\n    page = inp.get(\"page\") or f\"List of {kind}s in {region}\"\r\n\r\n    r = connectors.wiki_page_html(page)\r\n\r\n    ctx.append(f\"need:{nid}\" if nid else \"set\",\r\n\r\n               \"connector:item\" if not nid else \"need:candidate\",\r\n\r\n               {\"slot\": \"retrieval\", \"value\": page, \"source\": \"wikipedia-table\",\r\n\r\n                \"fetched\": r[\"ok\"], \"ms\": r[\"ms\"], \"error\": r.get(\"error\"),\r\n\r\n                \"confidence\": 0.9 if r[\"ok\"] else 0.1},\r\n\r\n               \"pipeline:setbuild\", certainty=0.9 if r[\"ok\"] else 0.1,\r\n\r\n               basis={\"kind\": \"source-evidence\", \"ref\": r[\"url\"]})\r\n\r\n    if not r[\"ok\"]:\r\n\r\n        return {\"ok\": False, \"error\": r[\"error\"], \"page\": page}\r\n\r\n    rows = _table_rows(r[\"body\"])\r\n\r\n    if not rows:\r\n\r\n        return {\"ok\": False, \"error\": f\"no wikitable on {page}\", \"page\": page}\r\n\r\n    header, members, nonmatch = rows[0], [], []\r\n\r\n    kind_toks = set(re.findall(r\"[a-z]+\", kind)) or {\"city\"}\r\n\r\n    region_toks = set(re.findall(r\"[a-z]+\", region.lower()))\r\n\r\n    for cells in rows[1:]:\r\n\r\n        name = re.sub(r\"\\[[^\\]]*\\]\", \"\", cells[0]).strip()\r\n\r\n        typecol = re.sub(r\"\\[[^\\]]*\\]\", \"\", cells[1]).strip().lower() if len(cells) > 1 else \"\"\r\n\r\n        cls = {\"row\": cells}\r\n\r\n        if not name or name.lower() in (\"name\", \"total\"):\r\n\r\n            cls.update(cls_=\"header\", why=\"table header/total row\")\r\n\r\n            nonmatch.append({\"class\": \"header\", \"value\": name or str(cells)})\r\n\r\n            _record_nonmatch(ctx, nid, \"header\", name or str(cells),\r\n\r\n                             \"table header/total row\")\r\n\r\n        elif \"list of\" in name.lower() or name.startswith(\"Category:\"):\r\n\r\n            nonmatch.append({\"class\": \"foreign-link\", \"value\": name})\r\n\r\n            _record_nonmatch(ctx, nid, \"foreign-link\", name, \"link to another list\")\r\n\r\n        elif typecol and kind_toks and not (kind_toks & set(typecol.split())):\r\n\r\n            nonmatch.append({\"class\": \"category-error\", \"value\": name,\r\n\r\n                             \"why\": f\"row type '{cells[1]}' is not a {kind}\"})\r\n\r\n            _record_nonmatch(ctx, nid, \"category-error\", name,\r\n\r\n                             f\"row type '{cells[1]}' is not a {kind}\")\r\n\r\n        else:\r\n\r\n            member = {\"name\": name,\r\n\r\n                      \"detail\": {\"type\": cells[1] if len(cells) > 1 else \"\",\r\n\r\n                                 \"county\": cells[2] if len(cells) > 2 else \"\",\r\n\r\n                                 \"class\": cells[3] if len(cells) > 3 else \"\",\r\n\r\n                                 \"population\": cells[4] if len(cells) > 4 else \"\"}}\r\n\r\n            members.append(member)\r\n\r\n            if nid:\r\n\r\n                needs.add_candidate(ctx, nid, \"member\", member[\"name\"], 0.9,\r\n\r\n                                    \"wikipedia-table\", \"pipeline:setbuild\")\r\n\r\n    ctx.append(\"set\", \"set:member-source\",\r\n\r\n               {\"source\": \"wikipedia-table\", \"page\": page,\r\n\r\n                \"members\": len(members), \"nonMatches\": len(nonmatch)},\r\n\r\n               \"pipeline:setbuild\", basis={\"kind\": \"source-evidence\",\r\n\r\n                                           \"ref\": r[\"url\"]})\r\n\r\n    return {\"ok\": True, \"source\": \"wikipedia-table\", \"page\": page,\r\n\r\n            \"members\": members, \"count\": len(members),\r\n\r\n            \"nonMatches\": nonmatch, \"headerRow\": header}\r\n\r\n\r\n\r\n\r\n\r\ndef fn_retrieve_wiki_category(ctx, inp, grant):\r\n\r\n    \"\"\"Competitor 2 (need set.members): category-membership API — a different\r\n\r\n    retrieval strategy producing comparable evidence.\"\"\"\r\n\r\n    region, kind = inp.get(\"region\", \"\"), (inp.get(\"memberKind\") or \"\").lower()\r\n\r\n    nid = inp.get(\"needId\")\r\n\r\n    cat = inp.get(\"category\") or f\"Category:{kind.title()}s in {region}\"\r\n\r\n    r = connectors.wiki_category_members(cat)\r\n\r\n    if not r[\"ok\"]:\r\n\r\n        return {\"ok\": False, \"error\": r[\"error\"], \"category\": cat}\r\n\r\n    members, nonmatch = [], []\r\n\r\n    for t in r[\"titles\"]:\r\n\r\n        name = re.sub(r\",?\\s*\" + re.escape(region) + r\"$\", \"\", t).strip()\r\n\r\n        if re.match(r\"^(List of|Category:|Template:|Portal:|WP:|Wikipedia:)\", t):\r\n\r\n            nonmatch.append({\"class\": \"foreign-link\", \"value\": t})\r\n\r\n            _record_nonmatch(ctx, nid, \"foreign-link\", t, \"non-member page title\")\r\n\r\n        else:\r\n\r\n            members.append({\"name\": name, \"detail\": {\"title\": t, \"category\": cat}})\r\n\r\n            if nid:\r\n\r\n                needs.add_candidate(ctx, nid, \"member\", name, 0.8,\r\n\r\n                                    \"wikipedia-category\", \"pipeline:setbuild\")\r\n\r\n    ctx.append(\"set\", \"set:member-source\",\r\n\r\n               {\"source\": \"wikipedia-category\", \"category\": cat,\r\n\r\n                \"members\": len(members), \"nonMatches\": len(nonmatch)},\r\n\r\n               \"pipeline:setbuild\", basis={\"kind\": \"source-evidence\",\r\n\r\n                                           \"ref\": r[\"url\"]})\r\n\r\n    return {\"ok\": True, \"source\": \"wikipedia-category\", \"category\": cat,\r\n\r\n            \"members\": members, \"count\": len(members), \"nonMatches\": nonmatch}\r\n\r\n\r\n\r\n\r\n\r\ndef _record_nonmatch(ctx, nid, cls, value, why):\r\n\r\n    ctx.append(f\"need:{nid}\" if nid else \"set\", \"need:candidate\" if nid else \"set:member\",\r\n\r\n               {\"slot\": cls, \"value\": value, \"confidence\": 0.2,\r\n\r\n                \"source\": \"set-retrieval\", \"class\": cls, \"reason\": why},\r\n\r\n               \"pipeline:setbuild\", certainty=0.2,\r\n\r\n               basis={\"kind\": \"source-evidence\"})\r\n\r\n\r\n\r\n\r\n\r\ndef fn_set_build_collect(ctx, inp, grant):\r\n\r\n    \"\"\"Close the set: run the competing retrievals, compare, apply criteria,\r\n\r\n    emit the produced-list artifact + set:member rows + set:closure.\"\"\"\r\n\r\n    nid = inp.get(\"needId\")\r\n\r\n    if not nid:\r\n\r\n        return {\"ok\": False, \"error\": \"needId required\"}\r\n\r\n    st = needs.need_state(ctx, nid)\r\n\r\n    spec = st[\"spec\"]\r\n\r\n    region, kind = spec[\"slots\"].get(\"region\"), spec[\"slots\"].get(\"memberKind\")\r\n\r\n    criteria = spec[\"slots\"].get(\"criteria\") or \"\"\r\n\r\n    from . import compare\r\n\r\n    comp = compare.run_competition(\r\n\r\n        ctx, SET_NEED, {\"region\": region, \"memberKind\": kind, \"needId\": nid},\r\n\r\n        claimant=\"pipeline:setbuild\", need_id=nid)\r\n\r\n    # union of adequate retrievals, flagged disagreements\r\n\r\n    # union of adequate retrievals, flagged disagreements — member sets\r\n    # come from the competition run just performed (real tool results)\r\n    members_by_tool = comp.get(\"membersByTool\") or {}\r\n\r\n    all_names = sorted({n for s in members_by_tool.values() for n in s})\r\n\r\n    agreed = [n for n in all_names\r\n\r\n              if all(n in s for s in members_by_tool.values())]\r\n\r\n    solo = {t: [n for n in s if n not in agreed]\r\n\r\n            for t, s in members_by_tool.items()}\r\n\r\n    members = []\r\n\r\n    crit_toks = set(re.findall(r\"[a-z]+\", criteria.lower())) - {\r\n\r\n        \"all\", \"the\", \"of\", \"in\", \"a\", \"an\", \"and\", \"or\", \"real\",\r\n\r\n        \"incorporated\", \"municipalities\"}\r\n\r\n    for n in all_names:\r\n\r\n        detail = next((s[n] for s in members_by_tool.values() if n in s), {})\r\n\r\n        tok = set(re.findall(r\"[a-z]+\", n.lower()))\r\n\r\n        if crit_toks and not (crit_toks & tok):\r\n\r\n            # criteria filter is against memberKind terms; member names never\r\n\r\n            # contain them — keep members, the filter applies to row content\r\n\r\n            pass\r\n\r\n        members.append({\"name\": n, \"detail\": detail.get(\"detail\", {}),\r\n\r\n                        \"sources\": [t for t, s in members_by_tool.items() if n in s],\r\n\r\n                        \"agreed\": n in agreed})\r\n\r\n    artifact = None\r\n\r\n    adir = os.path.join(ctx.artifacts, \"sets\")\r\n\r\n    os.makedirs(adir, exist_ok=True)\r\n\r\n    artifact = os.path.join(adir, f\"set-{new_id('set')}.json\")\r\n\r\n    payload = {\"region\": region, \"memberKind\": kind, \"criteria\": criteria,\r\n\r\n             \"produced\": [m[\"name\"] for m in members],\r\n\r\n             \"memberCount\": len(members),\r\n\r\n             \"agreement\": {\"both\": len(agreed),\r\n\r\n                           \"perTool\": {t: len(s) for t, s in members_by_tool.items()},\r\n\r\n                           \"solo\": solo},\r\n\r\n             \"competition\": comp[\"competition\"][\"id\"],\r\n\r\n             \"producedAt\": now_ms()}\r\n\r\n    with open(artifact, \"w\", encoding=\"utf-8\") as f:\r\n\r\n        json.dump(payload, f, indent=2, ensure_ascii=False)\r\n\r\n    for m in members:\r\n\r\n        ctx.append(f\"need:{nid}\", \"set:member\", m, \"pipeline:setbuild\",\r\n\r\n                   certainty=0.9 if m[\"agreed\"] else 0.7,\r\n\r\n                   basis={\"kind\": \"durable-result\"})\r\n\r\n    ctx.append(f\"need:{nid}\", \"set:closure\",\r\n\r\n               {\"criteria\": criteria, \"memberCount\": len(members),\r\n\r\n                \"artifact\": artifact,\r\n\r\n                \"agreement\": payload[\"agreement\"]},\r\n\r\n               \"pipeline:setbuild\", basis={\"kind\": \"durable-result\"})\r\n\r\n    result = {\"ok\": True, \"memberCount\": len(members), \"members\": members,\r\n\r\n              \"produced\": payload[\"produced\"], \"artifact\": artifact,\r\n\r\n              \"agreement\": payload[\"agreement\"],\r\n\r\n              \"competition\": comp[\"competition\"]}\r\n\r\n    needs.close_need(ctx, nid, \"fulfilled\",\r\n\r\n                     {\"toolId\": \"set-build-collect\", \"result\": {\r\n\r\n                         \"memberCount\": len(members), \"artifact\": artifact}},\r\n\r\n                     \"system\")\r\n\r\n    return result\r\n\r\n","newText":"\"\"\"Set-build — geographic set fulfillment machinery (C-SetBuild; the\r\nmachinery beneath S-list-project).\r\n\r\nA set project declares a governed requirement: kind `set-members`, slots\r\n{region, memberKind, criteria, minCount}. Two genuinely competing retrieval\r\ntools express need `set.members` and produce comparable member evidence:\r\n\r\n- `retrieve-set-wiki-table`    parses the region's canonical list page table\r\n- `retrieve-set-wiki-category` reads the category membership API\r\n\r\nBoth are live HTTP against Wikipedia — different retrieval strategies, same\r\nneed. Their evidence lands as need:candidate rows: real members at high\r\nconfidence, and headers / foreign links / non-member titles / category errors\r\nrecorded as results-that-do-not-match, retained for review and cleanup\r\n(prompt demo 4). Criteria are asserted on the need and preserved through\r\nrefinement (`need:refined` adds criteria; nothing rewrites the original).\r\n\r\n`set-build-collect` closes the set: compares the competing retrievals\r\n(agreement, unique contributions, disagreements flagged), applies the\r\ncriteria, writes the produced list artifact + set:member assertions +\r\nset:closure durable result.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport html as _html\r\nimport json\r\nimport os\r\nimport re\r\nimport urllib.parse\r\nfrom typing import Optional\r\n\r\nfrom . import connectors, needs\r\nfrom .model import new_id, now_ms\r\n\r\nSET_NEED = \"set.members\"\r\n\r\n\r\n# ---- parsing helpers --------------------------------------------------------\r\n\r\ndef _strip(s: str) -> str:\r\n    return re.sub(r\"\\s+\", \" \", _html.unescape(re.sub(r\"<[^>]+>\", \"\", s))).strip()\r\n\r\n\r\ndef _table_rows(page_html: str) -> list[list[str]]:\r\n    \"\"\"Extract cell text per row from the first wikitable in the page.\"\"\"\r\n    m = re.search(r'<table[^>]*class=\"[^\"]*wikitable[^\"]*\"[^>]*>(.*?)</table>',\r\n                  page_html, re.S)\r\n    if not m:\r\n        return []\r\n    rows = []\r\n    for tr in re.findall(r\"<tr[^>]*>(.*?)</tr>\", m.group(1), re.S):\r\n        cells = [_strip(c) for c in re.findall(r\"<t[hd][^>]*>(.*?)</t[hd]>\", tr, re.S)]\r\n        if cells:\r\n            rows.append(cells)\r\n    return rows\r\n\r\n\r\n# ---- fn-backed tools --------------------------------------------------------\r\n\r\ndef fn_set_project_open(ctx, inp, grant):\r\n    \"\"\"Create a set-fulfillment project + the governing set-members need.\r\n    Triggered from chat (\"list all the cities in Pennsylvania\") or invoked\r\n    directly.\"\"\"\r\n    region = (inp.get(\"region\") or \"\").strip()\r\n    kind = (inp.get(\"memberKind\") or \"\").strip()\r\n    criteria = (inp.get(\"criteria\") or\r\n                f\"incorporated {kind}s in {region}\" + \"s\" if kind else \"set members\")\r\n    pid = new_id(\"proj\")\r\n    subj = f\"project:{pid}\"\r\n    title = inp.get(\"title\") or f\"list all the {kind}s in {region}\".strip()\r\n    ctx.append(subj, \"project:exists\", {\"title\": title}, \"principal\",\r\n               basis={\"kind\": \"user-choice\"})\r\n    ctx.append(subj, \"project:title\", title, \"principal\")\r\n    ctx.append(subj, \"project:kind\", \"set-build\", \"principal\")\r\n    spec = {\"summary\": f\"set members: {kind} in {region}\",\r\n            \"project\": pid,\r\n            \"slots\": {\"region\": region, \"memberKind\": kind,\r\n                      \"criteria\": criteria,\r\n                      \"minCount\": int(inp.get(\"minCount\") or 1)},\r\n            \"satisfaction\": {\"resultTests\": [\r\n                {\"gte\": [{\"$ref\": \"result.memberCount\"},\r\n                         int(inp.get(\"minCount\") or 1)]}]},\r\n            \"toolId\": \"set-build-collect\"}\r\n    nid = needs.open_need(ctx, \"set-members\", spec, claimant=\"principal\")\r\n    for slot in (\"region\", \"memberKind\", \"criteria\"):\r\n        needs.add_candidate(ctx, nid, slot, spec[\"slots\"][slot], 0.95,\r\n                            \"input\", \"principal\")\r\n    ctx.append(f\"need:{nid}\", \"set:criteria\",\r\n               {\"criteria\": criteria, \"region\": region, \"memberKind\": kind},\r\n               \"principal\", basis={\"kind\": \"user-choice\"})\r\n    return {\"ok\": True, \"projectId\": pid, \"needId\": nid, \"spec\": spec}\r\n\r\n\r\ndef fn_retrieve_wiki_table(ctx, inp, grant):\r\n    \"\"\"Competitor 1 (need set.members): parse the canonical list page's\r\n    wikitable into member candidates + classified non-matches.\"\"\"\r\n    region, kind = inp.get(\"region\", \"\"), (inp.get(\"memberKind\") or \"\").lower()\r\n    nid = inp.get(\"needId\")\r\n    page = inp.get(\"page\") or f\"List of {kind}s in {region}\"\r\n    r = connectors.wiki_page_html(page)\r\n    ctx.append(f\"need:{nid}\" if nid else \"set\",\r\n               \"connector:item\" if not nid else \"need:candidate\",\r\n               {\"slot\": \"retrieval\", \"value\": page, \"source\": \"wikipedia-table\",\r\n                \"fetched\": r[\"ok\"], \"ms\": r[\"ms\"], \"error\": r.get(\"error\"),\r\n                \"confidence\": 0.9 if r[\"ok\"] else 0.1},\r\n               \"pipeline:setbuild\", certainty=0.9 if r[\"ok\"] else 0.1,\r\n               basis={\"kind\": \"source-evidence\", \"ref\": r[\"url\"]})\r\n    if not r[\"ok\"]:\r\n        return {\"ok\": False, \"error\": r[\"error\"], \"page\": page}\r\n    rows = _table_rows(r[\"body\"])\r\n    if not rows:\r\n        return {\"ok\": False, \"error\": f\"no wikitable on {page}\", \"page\": page}\r\n    header, members, nonmatch = rows[0], [], []\r\n    kind_toks = set(re.findall(r\"[a-z]+\", kind)) or {\"city\"}\r\n    region_toks = set(re.findall(r\"[a-z]+\", region.lower()))\r\n    for cells in rows[1:]:\r\n        name = re.sub(r\"\\[[^\\]]*\\]\", \"\", cells[0]).strip()\r\n        typecol = re.sub(r\"\\[[^\\]]*\\]\", \"\", cells[1]).strip().lower() if len(cells) > 1 else \"\"\r\n        cls = {\"row\": cells}\r\n        if not name or name.lower() in (\"name\", \"total\"):\r\n            cls.update(cls_=\"header\", why=\"table header/total row\")\r\n            nonmatch.append({\"class\": \"header\", \"value\": name or str(cells)})\r\n            _record_nonmatch(ctx, nid, \"header\", name or str(cells),\r\n                             \"table header/total row\")\r\n        elif \"list of\" in name.lower() or name.startswith(\"Category:\"):\r\n            nonmatch.append({\"class\": \"foreign-link\", \"value\": name})\r\n            _record_nonmatch(ctx, nid, \"foreign-link\", name, \"link to another list\")\r\n        elif typecol and kind_toks and not (kind_toks & set(typecol.split())):\r\n            nonmatch.append({\"class\": \"category-error\", \"value\": name,\r\n                             \"why\": f\"row type '{cells[1]}' is not a {kind}\"})\r\n            _record_nonmatch(ctx, nid, \"category-error\", name,\r\n                             f\"row type '{cells[1]}' is not a {kind}\")\r\n        else:\r\n            member = {\"name\": name,\r\n                      \"detail\": {\"type\": cells[1] if len(cells) > 1 else \"\",\r\n                                 \"county\": cells[2] if len(cells) > 2 else \"\",\r\n                                 \"class\": cells[3] if len(cells) > 3 else \"\",\r\n                                 \"population\": cells[4] if len(cells) > 4 else \"\"}}\r\n            members.append(member)\r\n            if nid:\r\n                needs.add_candidate(ctx, nid, \"member\", member[\"name\"], 0.9,\r\n                                    \"wikipedia-table\", \"pipeline:setbuild\")\r\n    ctx.append(\"set\", \"set:member-source\",\r\n               {\"source\": \"wikipedia-table\", \"page\": page,\r\n                \"members\": len(members), \"nonMatches\": len(nonmatch)},\r\n               \"pipeline:setbuild\", basis={\"kind\": \"source-evidence\",\r\n                                           \"ref\": r[\"url\"]})\r\n    return {\"ok\": True, \"source\": \"wikipedia-table\", \"page\": page,\r\n            \"members\": members, \"count\": len(members),\r\n            \"nonMatches\": nonmatch, \"headerRow\": header}\r\n\r\n\r\ndef fn_retrieve_wiki_category(ctx, inp, grant):\r\n    \"\"\"Competitor 2 (need set.members): category-membership API — a different\r\n    retrieval strategy producing comparable evidence.\"\"\"\r\n    region, kind = inp.get(\"region\", \"\"), (inp.get(\"memberKind\") or \"\").lower()\r\n    nid = inp.get(\"needId\")\r\n    cat = inp.get(\"category\") or f\"Category:{kind.title()}s in {region}\"\r\n    r = connectors.wiki_category_members(cat)\r\n    if not r[\"ok\"]:\r\n        return {\"ok\": False, \"error\": r[\"error\"], \"category\": cat}\r\n    members, nonmatch = [], []\r\n    for t in r[\"titles\"]:\r\n        name = re.sub(r\",?\\s*\" + re.escape(region) + r\"$\", \"\", t).strip()\r\n        if re.match(r\"^(List of|Category:|Template:|Portal:|WP:|Wikipedia:)\", t):\r\n            nonmatch.append({\"class\": \"foreign-link\", \"value\": t})\r\n            _record_nonmatch(ctx, nid, \"foreign-link\", t, \"non-member page title\")\r\n        else:\r\n            members.append({\"name\": name, \"detail\": {\"title\": t, \"category\": cat}})\r\n            if nid:\r\n                needs.add_candidate(ctx, nid, \"member\", name, 0.8,\r\n                                    \"wikipedia-category\", \"pipeline:setbuild\")\r\n    ctx.append(\"set\", \"set:member-source\",\r\n               {\"source\": \"wikipedia-category\", \"category\": cat,\r\n                \"members\": len(members), \"nonMatches\": len(nonmatch)},\r\n               \"pipeline:setbuild\", basis={\"kind\": \"source-evidence\",\r\n                                           \"ref\": r[\"url\"]})\r\n    return {\"ok\": True, \"source\": \"wikipedia-category\", \"category\": cat,\r\n            \"members\": members, \"count\": len(members), \"nonMatches\": nonmatch}\r\n\r\n\r\ndef _record_nonmatch(ctx, nid, cls, value, why):\r\n    ctx.append(f\"need:{nid}\" if nid else \"set\", \"need:candidate\" if nid else \"set:member\",\r\n               {\"slot\": cls, \"value\": value, \"confidence\": 0.2,\r\n                \"source\": \"set-retrieval\", \"class\": cls, \"reason\": why},\r\n               \"pipeline:setbuild\", certainty=0.2,\r\n               basis={\"kind\": \"source-evidence\"})\r\n\r\n\r\ndef fn_set_build_collect(ctx, inp, grant):\r\n    \"\"\"Close the set: run the competing retrievals, compare, apply criteria,\r\n    emit the produced-list artifact + set:member rows + set:closure.\"\"\"\r\n    nid = inp.get(\"needId\")\r\n    if not nid:\r\n        return {\"ok\": False, \"error\": \"needId required\"}\r\n    st = needs.need_state(ctx, nid)\r\n    spec = st[\"spec\"]\r\n    region, kind = spec[\"slots\"].get(\"region\"), spec[\"slots\"].get(\"memberKind\")\r\n    criteria = spec[\"slots\"].get(\"criteria\") or \"\"\r\n    from . import compare\r\n    comp = compare.run_competition(\r\n        ctx, SET_NEED, {\"region\": region, \"memberKind\": kind, \"needId\": nid},\r\n        claimant=\"pipeline:setbuild\", need_id=nid)\r\n    # union of adequate retrievals, flagged disagreements\r\n    # union of adequate retrievals, flagged disagreements — member sets\r\n    # come from the competition run just performed (real tool results)\r\n    members_by_tool = comp.get(\"membersByTool\") or {}\r\n    all_names = sorted({n for s in members_by_tool.values() for n in s})\r\n    agreed = [n for n in all_names\r\n              if all(n in s for s in members_by_tool.values())]\r\n    solo = {t: [n for n in s if n not in agreed]\r\n            for t, s in members_by_tool.items()}\r\n    members = []\r\n    crit_toks = set(re.findall(r\"[a-z]+\", criteria.lower())) - {\r\n        \"all\", \"the\", \"of\", \"in\", \"a\", \"an\", \"and\", \"or\", \"real\",\r\n        \"incorporated\", \"municipalities\"}\r\n    for n in all_names:\r\n        detail = next((s[n] for s in members_by_tool.values() if n in s), {})\r\n        tok = set(re.findall(r\"[a-z]+\", n.lower()))\r\n        if crit_toks and not (crit_toks & tok):\r\n            # criteria filter is against memberKind terms; member names never\r\n            # contain them — keep members, the filter applies to row content\r\n            pass\r\n        members.append({\"name\": n, \"detail\": detail.get(\"detail\", {}),\r\n                        \"sources\": [t for t, s in members_by_tool.items() if n in s],\r\n                        \"agreed\": n in agreed})\r\n    artifact = None\r\n    adir = os.path.join(ctx.artifacts, \"sets\")\r\n    os.makedirs(adir, exist_ok=True)\r\n    artifact = os.path.join(adir, f\"set-{new_id('set')}.json\")\r\n    payload = {\"region\": region, \"memberKind\": kind, \"criteria\": criteria,\r\n             \"produced\": [m[\"name\"] for m in members],\r\n             \"memberCount\": len(members),\r\n             \"agreement\": {\"both\": len(agreed),\r\n                           \"perTool\": {t: len(s) for t, s in members_by_tool.items()},\r\n                           \"solo\": solo},\r\n             \"competition\": comp[\"competition\"][\"id\"],\r\n             \"producedAt\": now_ms()}\r\n    with open(artifact, \"w\", encoding=\"utf-8\") as f:\r\n        json.dump(payload, f, indent=2, ensure_ascii=False)\r\n    for m in members:\r\n        ctx.append(f\"need:{nid}\", \"set:member\", m, \"pipeline:setbuild\",\r\n                   certainty=0.9 if m[\"agreed\"] else 0.7,\r\n                   basis={\"kind\": \"durable-result\"})\r\n    ctx.append(f\"need:{nid}\", \"set:closure\",\r\n               {\"criteria\": criteria, \"memberCount\": len(members),\r\n                \"artifact\": artifact,\r\n                \"agreement\": payload[\"agreement\"]},\r\n               \"pipeline:setbuild\", basis={\"kind\": \"durable-result\"})\r\n    result = {\"ok\": True, \"memberCount\": len(members), \"members\": members,\r\n              \"produced\": payload[\"produced\"], \"artifact\": artifact,\r\n              \"agreement\": payload[\"agreement\"],\r\n              \"competition\": comp[\"competition\"]}\r\n    needs.close_need(ctx, nid, \"fulfilled\",\r\n                     {\"toolId\": \"set-build-collect\", \"result\": {\r\n                         \"memberCount\": len(members), \"artifact\": artifact}},\r\n                     \"system\")\r\n    return result\r\n","_meta":{"cognition.ai/linesAdded":0,"cognition.ai/linesRemoved":256}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\speechfloor.py","oldText":"\"\"\"Speech floor — serialized playback admission (C-SpeechFloor), the manner\r\n\r\nbeneath C-PerceivableRespondents (contributions individually perceivable) and\r\n\r\nC-SequentialRespondents (respondents present in sequence).\r\n\r\n\r\n\r\nThe host admits exactly one speech render at a time through a FIFO queue.\r\n\r\nEvery admission and every completed playback is recorded as a ledger\r\n\r\nassertion — the floor is evidence, not just a lock. Persona voice preferences\r\n\r\n(portable, C-EngineMapping) ride on each admission and are mapped to engine\r\n\r\nsettings inside the renderer.\r\n\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\n\r\n\r\nimport queue\r\n\r\nimport threading\r\n\r\nfrom typing import Optional\r\n\r\n\r\n\r\nfrom .model import new_id, now_ms\r\n\r\n\r\n\r\n\r\n\r\nclass SpeechFloor(threading.Thread):\r\n\r\n    \"\"\"FIFO playback queue. One render at a time — never overlapping speech.\"\"\"\r\n\r\n\r\n\r\n    def __init__(self, ctx):\r\n\r\n        super().__init__(daemon=True, name=\"speech-floor\")\r\n\r\n        self.ctx = ctx\r\n\r\n        self.q: \"queue.Queue[dict]\" = queue.Queue()\r\n\r\n        self._stop = threading.Event()\r\n\r\n        self.played: list[dict] = []\r\n\r\n\r\n\r\n    # ---- admission ----\r\n\r\n\r\n\r\n    def enqueue(self, text: str, persona: Optional[dict] = None,\r\n\r\n                cause: str = \"response\", voice: Optional[dict] = None) -> dict:\r\n\r\n        \"\"\"Admit a playback request. Returns the admission record; the actual\r\n\r\n        render happens in order on the floor thread.\"\"\"\r\n\r\n        adm = {\"id\": new_id(\"sp\"), \"at\": now_ms(), \"text\": text,\r\n\r\n               \"personaId\": (persona or {}).get(\"id\"),\r\n\r\n               \"personaName\": (persona or {}).get(\"name\", \"Meridian\"),\r\n\r\n               \"cause\": cause, \"voice\": voice or (persona or {}).get(\"voice\") or {},\r\n\r\n               \"position\": self.q.qsize() + 1}\r\n\r\n        self.ctx.append(\"speech\", \"speech:floor-admission\", adm,\r\n\r\n                        \"system\", basis={\"kind\": \"execution\"})\r\n\r\n        self.q.put(adm)\r\n\r\n        return adm\r\n\r\n\r\n\r\n    def depth(self) -> int:\r\n\r\n        return self.q.qsize()\r\n\r\n\r\n\r\n    # ---- floor worker ----\r\n\r\n\r\n\r\n    def run(self):\r\n\r\n        while not self._stop.is_set():\r\n\r\n            try:\r\n\r\n                adm = self.q.get(timeout=0.5)\r\n\r\n            except queue.Empty:\r\n\r\n                continue\r\n\r\n            t0 = now_ms()\r\n\r\n            r = self.ctx.invoke(\"speak-voice\",\r\n\r\n                                {\"text\": adm[\"text\"], \"personaId\": adm[\"personaId\"],\r\n\r\n                                 \"voice\": adm[\"voice\"]})\r\n\r\n            rec = {\"admission\": adm[\"id\"], \"personaId\": adm[\"personaId\"],\r\n\r\n                   \"personaName\": adm[\"personaName\"],\r\n\r\n                   \"voice\": adm[\"voice\"], \"ok\": bool(r.get(\"ok\")),\r\n\r\n                   \"renderedBy\": (r.get(\"result\") or {}).get(\"renderedBy\"),\r\n\r\n                   \"ms\": now_ms() - t0,\r\n\r\n                   \"error\": r.get(\"error\") or\r\n\r\n                            (r.get(\"result\") or {}).get(\"error\")}\r\n\r\n            self.played.append(rec)\r\n\r\n            self.ctx.append(\"speech\", \"speech:floor-played\", rec,\r\n\r\n                            \"engine:tts\", basis={\"kind\": \"execution\"})\r\n\r\n            self.ctx.emit(\"card\", {\"kind\": \"speech\", \"summary\":\r\n\r\n                                   f\"{adm['personaName']} spoke \"\r\n\r\n                                   f\"({rec['renderedBy'] or 'unrendered'})\",\r\n\r\n                                   \"floor\": rec, \"at\": now_ms()})\r\n\r\n            self.q.task_done()\r\n\r\n\r\n\r\n    def drain(self, timeout: float = 30.0) -> bool:\r\n\r\n        \"\"\"Wait until the queue is empty (test/demo seam).\"\"\"\r\n\r\n        import time\r\n\r\n        t0 = time.time()\r\n\r\n        while not self.q.empty() and time.time() - t0 < timeout:\r\n\r\n            time.sleep(0.05)\r\n\r\n        t1 = time.time()\r\n\r\n        while self.played and time.time() - t1 < 10:\r\n\r\n            # give last render a beat to record\r\n\r\n            return True\r\n\r\n        return self.q.empty()\r\n\r\n\r\n\r\n    def stop(self):\r\n\r\n        self._stop.set()\r\n\r\n","newText":"\"\"\"Speech floor — serialized playback admission (C-SpeechFloor), the manner\r\nbeneath C-PerceivableRespondents (contributions individually perceivable) and\r\nC-SequentialRespondents (respondents present in sequence).\r\n\r\nThe host admits exactly one speech render at a time through a FIFO queue.\r\nEvery admission and every completed playback is recorded as a ledger\r\nassertion — the floor is evidence, not just a lock. Persona voice preferences\r\n(portable, C-EngineMapping) ride on each admission and are mapped to engine\r\nsettings inside the renderer.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport queue\r\nimport threading\r\nfrom typing import Optional\r\n\r\nfrom .model import new_id, now_ms\r\n\r\n\r\nclass SpeechFloor(threading.Thread):\r\n    \"\"\"FIFO playback queue. One render at a time — never overlapping speech.\"\"\"\r\n\r\n    def __init__(self, ctx):\r\n        super().__init__(daemon=True, name=\"speech-floor\")\r\n        self.ctx = ctx\r\n        self.q: \"queue.Queue[dict]\" = queue.Queue()\r\n        self._stop = threading.Event()\r\n        self.played: list[dict] = []\r\n\r\n    # ---- admission ----\r\n\r\n    def enqueue(self, text: str, persona: Optional[dict] = None,\r\n                cause: str = \"response\", voice: Optional[dict] = None) -> dict:\r\n        \"\"\"Admit a playback request. Returns the admission record; the actual\r\n        render happens in order on the floor thread.\"\"\"\r\n        adm = {\"id\": new_id(\"sp\"), \"at\": now_ms(), \"text\": text,\r\n               \"personaId\": (persona or {}).get(\"id\"),\r\n               \"personaName\": (persona or {}).get(\"name\", \"Meridian\"),\r\n               \"cause\": cause, \"voice\": voice or (persona or {}).get(\"voice\") or {},\r\n               \"position\": self.q.qsize() + 1}\r\n        self.ctx.append(\"speech\", \"speech:floor-admission\", adm,\r\n                        \"system\", basis={\"kind\": \"execution\"})\r\n        self.q.put(adm)\r\n        return adm\r\n\r\n    def depth(self) -> int:\r\n        return self.q.qsize()\r\n\r\n    # ---- floor worker ----\r\n\r\n    def run(self):\r\n        while not self._stop.is_set():\r\n            try:\r\n                adm = self.q.get(timeout=0.5)\r\n            except queue.Empty:\r\n                continue\r\n            t0 = now_ms()\r\n            r = self.ctx.invoke(\"speak-voice\",\r\n                                {\"text\": adm[\"text\"], \"personaId\": adm[\"personaId\"],\r\n                                 \"voice\": adm[\"voice\"]})\r\n            rec = {\"admission\": adm[\"id\"], \"personaId\": adm[\"personaId\"],\r\n                   \"personaName\": adm[\"personaName\"],\r\n                   \"voice\": adm[\"voice\"], \"ok\": bool(r.get(\"ok\")),\r\n                   \"renderedBy\": (r.get(\"result\") or {}).get(\"renderedBy\"),\r\n                   \"ms\": now_ms() - t0,\r\n                   \"error\": r.get(\"error\") or\r\n                            (r.get(\"result\") or {}).get(\"error\")}\r\n            self.played.append(rec)\r\n            self.ctx.append(\"speech\", \"speech:floor-played\", rec,\r\n                            \"engine:tts\", basis={\"kind\": \"execution\"})\r\n            self.ctx.emit(\"card\", {\"kind\": \"speech\", \"summary\":\r\n                                   f\"{adm['personaName']} spoke \"\r\n                                   f\"({rec['renderedBy'] or 'unrendered'})\",\r\n                                   \"floor\": rec, \"at\": now_ms()})\r\n            self.q.task_done()\r\n\r\n    def drain(self, timeout: float = 30.0) -> bool:\r\n        \"\"\"Wait until the queue is empty (test/demo seam).\"\"\"\r\n        import time\r\n        t0 = time.time()\r\n        while not self.q.empty() and time.time() - t0 < timeout:\r\n            time.sleep(0.05)\r\n        t1 = time.time()\r\n        while self.played and time.time() - t1 < 10:\r\n            # give last render a beat to record\r\n            return True\r\n        return self.q.empty()\r\n\r\n    def stop(self):\r\n        self._stop.set()\r\n","_meta":{"cognition.ai/linesAdded":0,"cognition.ai/linesRemoved":90}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.002\\app\\temporal.py","oldText":"\"\"\"Calendar temporal reasoning (prompt §Projects and temporal context — F2).\r\r\n\r\r\nCalendar entries remain source evidence; this module computes the temporal\r\r\nview the prompt requires to *inform* project work, persona responses, and\r\r\nbackground attention:\r\r\n\r\r\n- upcoming / current / recent interpretation of calendar:event evidence\r\r\n- project linkage: open projects matched to events by criteria tokens, and\r\r\n  project deadlines (project:due) compared against the horizon\r\r\n- steward attention: temporal findings become offers presented through a\r\r\n  personality (the background-attention channel)\r\r\n- persona composition: respondents whose lens touches time/calendar are given\r\r\n  the live temporal context so their replies can cite it\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport re\r\r\nfrom typing import Optional\r\r\n\r\r\nfrom .model import now_ms\r\r\n\r\r\nDAY = 86400000\r\r\n\r\r\n\r\r\ndef events(ctx) -> list[dict]:\r\r\n    out = []\r\r\n    for a in ctx.ledger.query(predicate=\"calendar:event\"):\r\r\n        v = dict(a.value[\"v\"])\r\r\n        v[\"assertionId\"] = a.id\r\r\n        out.append(v)\r\r\n    out.sort(key=lambda e: e.get(\"startMs\", 0))\r\r\n    return out\r\r\n\r\r\n\r\r\ndef temporal_context(ctx, now: Optional[int] = None,\r\r\n                     horizon_ms: int = 7 * DAY) -> dict:\r\r\n    \"\"\"Interpret calendar evidence into upcoming/current/recent classes.\"\"\"\r\r\n    now = now or now_ms()\r\r\n    upcoming, current, recent = [], [], []\r\r\n    for e in events(ctx):\r\r\n        s, en = e.get(\"startMs\", 0), e.get(\"endMs\", 0) or e.get(\"startMs\", 0)\r\r\n        if s <= now <= (en or s + 3600000):\r\r\n            current.append(e)\r\r\n        elif now < s <= now + horizon_ms:\r\r\n            upcoming.append(e)\r\r\n        elif en and now - en <= horizon_ms:\r\r\n            recent.append(e)\r\r\n    return {\"now\": now, \"horizonMs\": horizon_ms,\r\r\n            \"current\": current, \"upcoming\": upcoming, \"recent\": recent,\r\r\n            \"count\": {\"current\": len(current), \"upcoming\": len(upcoming),\r\r\n                      \"recent\": len(recent)}}\r\r\n\r\r\n\r\r\ndef _tokens(text: str) -> set:\r\r\n    return set(re.findall(r\"[a-z0-9']+\", (text or \"\").lower()))\r\r\n\r\r\n\r\r\ndef linkable(ctx, project: dict, window_ms: int = 30 * DAY) -> list[dict]:\r\r\n    \"\"\"Events related to a project's title/goals by token overlap, within a\r\r\n    bounded window around now.\"\"\"\r\r\n    now = now_ms()\r\r\n    ptoks = _tokens((project.get(\"title\") or \"\") + \" \" +\r\r\n                    \" \".join(g.get(\"text\", g) if isinstance(g, dict) else str(g)\r\r\n                             for g in (project.get(\"goals\") or [])))\r\r\n    ptoks -= {\"a\", \"the\", \"to\", \"of\", \"in\", \"for\", \"and\", \"project\"}\r\r\n    hits = []\r\r\n    for e in events(ctx):\r\r\n        if not ptoks:\r\r\n            break\r\r\n        s = e.get(\"startMs\", 0)\r\r\n        if abs(s - now) > window_ms:\r\r\n            continue\r\r\n        etoks = _tokens(e.get(\"title\", \"\"))\r\r\n        if ptoks & etoks:\r\r\n            hits.append({**e, \"matched\": sorted(ptoks & etoks)})\r\r\n    return hits\r\r\n\r\r\n\r\r\ndef note_for_persona(ctx, persona: dict, user_text: str) -> Optional[str]:\r\r\n    \"\"\"A persona-level temporal note when the persona's lens touches time or\r\r\n    the user asks about schedule/upcoming events.\"\"\"\r\r\n    text_toks = _tokens(user_text)\r\r\n    lens_toks = set()\r\r\n    for k in (persona.get(\"interests\") or []) + (persona.get(\"traits\") or []):\r\r\n        lens_toks |= _tokens(k)\r\r\n    resp = (persona.get(\"lens\") or {}).get(\"responsibilities\") or []\r\r\n    for r in resp:\r\r\n        lens_toks |= _tokens(r)\r\r\n    temporal_lens = bool(lens_toks & {\"calendar\", \"time\", \"schedule\", \"temporal\",\r\r\n                                      \"attention\", \"deadline\", \"reminder\",\r\r\n                                      \"notifications\", \"stewardship\"})\r\r\n    temporal_ask = bool(text_toks & {\"when\", \"calendar\", \"schedule\", \"upcoming\",\r\r\n                                     \"today\", \"tomorrow\", \"deadline\", \"week\",\r\r\n                                     \"soon\", \"date\", \"remind\"})\r\r\n    if not (temporal_lens or temporal_ask):\r\r\n        return None\r\r\n    ctxv = temporal_context(ctx, horizon_ms=3 * DAY)\r\r\n    if not (ctxv[\"current\"] or ctxv[\"upcoming\"]):\r\r\n        return None\r\r\n    bits = [f\"{e['title']} ({_fmt(e.get('startMs'))})\" for e in\r\r\n            (ctxv[\"current\"] + ctxv[\"upcoming\"])[:3]]\r\r\n    note = \"Temporal context from the ledger calendar: \" + \"; \".join(bits)\r\r\n    ctx.append(f\"persona:{persona['id']}\", \"persona:temporal-note\",\r\r\n               {\"note\": note, \"events\": [e[\"assertionId\"] for e in\r\r\n                                         (ctxv[\"current\"] + ctxv[\"upcoming\"])[:3]]},\r\r\n               \"system\", basis={\"kind\": \"interpretation\"})\r\r\n    return note\r\r\n\r\r\n\r\r\ndef _fmt(ms: int) -> str:\r\r\n    import datetime as dt\r\r\n    if not ms:\r\r\n        return \"?\"\r\r\n    return dt.datetime.fromtimestamp(ms / 1000).strftime(\"%Y-%m-%d %H:%M\")\r\r\n\r\r\n\r\r\ndef steward_attention(ctx) -> dict:\r\r\n    \"\"\"Background-attention duty: interpret the calendar into findings and\r\r\n    present the relevant ones through a distinct personality (prompt §Background\r\r\n    activity and attention; demo 6 channel).\"\"\"\r\r\n    ctxv = temporal_context(ctx, horizon_ms=72 * 3600 * 1000)\r\r\n    findings = []\r\r\n    # (a) upcoming/current events the user should hear about\r\r\n    for e in (ctxv[\"current\"] + ctxv[\"upcoming\"])[:5]:\r\r\n        findings.append({\"kind\": \"calendar\", \"event\": e})\r\r\n    # (b) projects with deadlines inside the horizon, or linked events coming due\r\r\n    for pa in ctx.ledger.query(predicate=\"project:exists\"):\r\r\n        pid = pa.subjectKey.split(\":\", 1)[1]\r\r\n        subj = pa.subjectKey\r\r\n        due_rows = ctx.ledger.query(subject=subj, predicate=\"project:due\")\r\r\n        due = due_rows[-1].value[\"v\"] if due_rows else None\r\r\n        if due and now_ms() <= due <= now_ms() + 72 * 3600 * 1000:\r\r\n            findings.append({\"kind\": \"project-due\", \"projectId\": pid,\r\r\n                             \"title\": pa.value[\"v\"].get(\"title\"), \"dueMs\": due})\r\r\n        proj = {\"title\": pa.value[\"v\"].get(\"title\"), \"goals\":\r\r\n                [r.value[\"v\"] for r in ctx.ledger.query(subject=subj,\r\r\n                                                      predicate=\"project:goal\")]}\r\r\n        for hit in linkable(ctx, proj, window_ms=14 * DAY):\r\r\n            already = [r for r in ctx.ledger.query(subject=subj,\r\r\n                                                   predicate=\"calendar:linked\")\r\r\n                       if r.value[\"v\"] == hit[\"assertionId\"]]\r\r\n            if not already:\r\r\n                ctx.append(subj, \"calendar:linked\", hit[\"assertionId\"],\r\r\n                           \"steward:main\", certainty=0.8,\r\r\n                           basis={\"kind\": \"interpretation\"},\r\r\n                           relates=[hit[\"assertionId\"]])\r\r\n                findings.append({\"kind\": \"project-event-link\",\r\r\n                                 \"projectId\": pid, \"title\": proj[\"title\"],\r\r\n                                 \"event\": hit})\r\r\n    ctx.append(\"temporal\", \"temporal:attention\",\r\r\n               {\"findings\": findings, \"contextCount\": ctxv[\"count\"]},\r\r\n               \"steward:main\", basis={\"kind\": \"execution\"})\r\r\n    return {\"findings\": findings, \"context\": ctxv[\"count\"]}\r\r\n\r\r\n\r\r\ndef present_attention(ctx, findings: list) -> Optional[dict]:\r\r\n    \"\"\"Offer the steward's temporal findings to a persona whose lens fits —\r\r\n    completed background work surfaced as a relevant result (demo 6).\"\"\"\r\r\n    if not findings:\r\r\n        return None\r\r\n    roster = ctx.personas.roster()\r\r\n    if not roster:\r\r\n        return None\r\r\n    # pick the persona whose interests/responsibilities overlap time/attention\r\r\n    best, best_n = None, -1\r\r\n    for p in roster:\r\r\n        toks = set()\r\r\n        for k in (p.get(\"interests\") or []) + (p.get(\"traits\") or []):\r\r\n            toks |= _tokens(k)\r\r\n        for r in (p.get(\"lens\") or {}).get(\"responsibilities\") or []:\r\r\n            toks |= _tokens(r)\r\r\n        n = len(toks & {\"calendar\", \"time\", \"attention\", \"stewardship\",\r\r\n                        \"temporal\", \"opportunities\", \"notifications\", \"schedule\"})\r\r\n        if n > best_n:\r\r\n            best, best_n = p, n\r\r\n    p = best or roster[0]\r\r\n    lines = []\r\r\n    for f in findings[:4]:\r\r\n        if f[\"kind\"] == \"calendar\":\r\r\n            lines.append(f\"event: {f['event'].get('title')} at {_fmt(f['event'].get('startMs'))}\")\r\r\n        elif f[\"kind\"] == \"project-due\":\r\r\n            lines.append(f\"project '{f['title']}' is due at {_fmt(f['dueMs'])}\")\r\r\n        else:\r\r\n            lines.append(f\"project '{f['title']}' relates to event \"\r\r\n                         f\"'{f['event'].get('title')}' at {_fmt(f['event'].get('startMs'))}\")\r\r\n    text = (\"Stewardship pass — temporal attention: \" + \"; \".join(lines) +\r\r\n            \". Evidence is in the ledger (calendar:event, project:due, calendar:linked).\")\r\r\n    card = ctx.invoke(\"persona.speak\",\r\r\n                      {\"personaId\": p[\"id\"], \"text\": text,\r\r\n                       \"cause\": \"stewardship-temporal\", \"engine\": \"temporal\"})\r\r\n    return {\"persona\": p[\"name\"], \"text\": text, \"card\": card.get(\"result\")}\r\r\n","newText":"\"\"\"Calendar temporal reasoning (prompt §Projects and temporal context — F2).\r\n\r\nCalendar entries remain source evidence; this module computes the temporal\r\nview the prompt requires to *inform* project work, persona responses, and\r\nbackground attention:\r\n\r\n- upcoming / current / recent interpretation of calendar:event evidence\r\n- project linkage: open projects matched to events by criteria tokens, and\r\n  project deadlines (project:due) compared against the horizon\r\n- steward attention: temporal findings become offers presented through a\r\n  personality (the background-attention channel)\r\n- persona composition: respondents whose lens touches time/calendar are given\r\n  the live temporal context so their replies can cite it\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport re\r\nfrom typing import Optional\r\n\r\nfrom .model import now_ms\r\n\r\nDAY = 86400000\r\n\r\n\r\ndef events(ctx) -> list[dict]:\r\n    out = []\r\n    for a in ctx.ledger.query(predicate=\"calendar:event\"):\r\n        v = dict(a.value[\"v\"])\r\n        v[\"assertionId\"] = a.id\r\n        out.append(v)\r\n    out.sort(key=lambda e: e.get(\"startMs\", 0))\r\n    return out\r\n\r\n\r\ndef temporal_context(ctx, now: Optional[int] = None,\r\n                     horizon_ms: int = 7 * DAY) -> dict:\r\n    \"\"\"Interpret