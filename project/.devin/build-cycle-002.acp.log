{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"oasis-diagnostic","update":{"sessionUpdate":"tool_call","toolCallId":"exec:0#f1eff046e9cf485b8b7687f366fae786","title":"Ran python","kind":"execute","content":[{"type":"content","content":{"type":"resource","resource":{"mimeType":"text/x-shellscript","text":"cd \"C:/builds/project/version 0.3.0.002\" && python -c \"\nimport threading, queue, time, sys\nclass F(threading.Thread):\n    def __init__(self):\n        super().__init__(daemon=True, name='f')\n        self.q = queue.Queue()\n        self._stop = threading.Event()\n        self.played = []\n    def run(self):\n        while not self._stop.is_set():\n            try:\n                a = self.q.get(timeout=0.5)\n            except queue.Empty:\n                continue\n            self.played.append(a)\n            self.q.task_done()\nf = F()\nf.start()\nf.q.put('x')\ntime.sleep(2)\nprint('alive:', f.is_alive(), 'played:', f.played)\nsys.stderr.flush()\" 2>&1","uri":"tool://preview"},"_meta":{"cognition.ai/preview_is_shell_command":true}}}],"rawInput":{"command":"cd \"C:/builds/project/version 0.3.0.002\" && python -c \"\nimport threading, queue, time, sys\nclass F(threading.Thread):\n    def __init__(self):\n        super().__init__(daemon=True, name='f')\n        self.q = queue.Queue()\n        self._stop = threading.Event()\n        self.played = []\n    def run(self):\n        while not self._stop.is_set():\n            try:\n                a = self.q.get(timeout=0.5)\n            except queue.Empty:\n                continue\n            self.played.append(a)\n            self.q.task_done()\nf = F()\nf.start()\nf.q.put('x')\ntime.sleep(2)\nprint('alive:', f.is_alive(), 'played:', f.played)\nsys.stderr.flush()\" 2>&1"},"_meta":{"cognition.ai/commandNames":["python"],"cognition.ai/inferenceToolName":"exec","cognition.ai/timestamp":"2026-11-21T06:09:44.797215700+00:00"}}}}
