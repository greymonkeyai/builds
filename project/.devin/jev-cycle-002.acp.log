{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"tree-fire","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#8c1b4ec4c16845f2ad78ca19806afd91","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Ethics gate (C-EthicsGate — the machinery beneath the prompt-specified\nimitation mark, §Personalities).\n\nDepth over the mark alone:\n- **liveness research** — the gate looks the subject up through the configured\n  wikipedia connector and classifies living / deceased / unclear from the\n  returned summary evidence (never guesses silently: unclear is a real verdict\n  that still requires the mark when the claimed recency is living/recent).\n- **objection/compliance flow** — `maxim:objection` assertions (seeded or\n  user-authored patterns like \"no imitations of active politicians\") are\n  checked; a matching objection changes the verdict to refused, which is a\n  recorded refusal, not silent non-action.\n- **gate cards** — every evaluation emits an `ethics-gate` bus card for the\n  surfaces and an `ethics:gate` ledger assertion with verdict + evidence.\n- **compliance** — a mint whose verdict requires the mark proceeds only with\n  admonishment + permanent mark; a refused mint does not proceed and the need\n  is recorded deferred/refused.\n\"\"\"\nfrom __future__ import annotations"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"tree-fire","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#8c1b4ec4c16845f2ad78ca19806afd91","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Ethics gate (C-EthicsGate — the machinery beneath the prompt-specified\nimitation mark, §Personalities).\n\nDepth over the mark alone:\n- **liveness research** — the gate looks the subject up through the configured\n  wikipedia connector and classifies living / deceased / unclear from the\n  returned summary evidence (never guesses silently: unclear is a real verdict\n  that still requires the mark when the claimed recency is living/recent).\n- **objection/compliance flow** — `maxim:objection` assertions (seeded or\n  user-authored patterns like \"no imitations of active politicians\") are\n  checked; a matching objection changes the verdict to refused, which is a\n  recorded refusal, not silent non-action.\n- **gate cards** — every evaluation emits an `ethics-gate` bus card for the\n  surfaces and an `ethics:gate` ledger assertion with verdict + evidence.\n- **compliance** — a mint whose verdict requires the mark proceeds only with\n  admonishment + permanent mark; a refused mint does not proceed and the need\n  is recorded deferred/refused.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom typing import Optional\n\nfrom . import connectors\nfrom .model import now_ms\n\n# recency classes requiring admonishment + permanent mark (prompt §Personalities)\n_MARKED = (\"living\", \"deceased-10y\")\n\n\ndef liveness_research(ctx, name: str) -> dict:\n    \"\"\"Research the subject through the wikipedia connector; classify from\n    real summary evidence.\"\"\"\n    r = connectors.wiki_summary(name)\n    if not r[\"ok\"]:\n        return {\"verdict\": \"unclear\", \"evidence\": f\"lookup failed: {r.get('error')}\",\n                \"reachable\": False}\n    ex = r.get(\"extract\") or \"\"\n    death = re.search(r\"\\b(?:died|death)\\b.*?(\\b1[89]\\d{2}|20[0-2]\\d)\", ex)\n    born = re.search(r\"born[^.;]{0,60}?(\\b1[89]\\d{2}|20[0-2]\\d)\", ex)\n    if death or re.search(r\"\\bwas an? \", ex):\n        return {\"verdict\": \"deceased\", \"evidence\": ex[:240],\n                \"deathYear\": int(death.group(1)) if death else None,\n                \"reachable\": True, \"title\": r.get(\"title\")}\n    if born or re.search(r\"\\bis an? \", ex):\n        return {\"verdict\": \"living\", \"evidence\": ex[:240],\n                \"birthYear\": int(born.group(1)) if born else None,\n                \"reachable\": True, \"title\": r.get(\"title\")}\n    return {\"verdict\": \"unclear\", \"evidence\": ex[:240] or \"empty summary\",\n            \"reachable\": True, \"title\": r.get(\"title\")}\n\n\ndef objections(ctx, name: str) -> list[dict]:\n    \"\"\"maxim:objection assertions act as user-authored prohibition patterns.\"\"\"\n    hits = []\n    for a in ctx.ledger.query(predicate=\"maxim:objection\"):\n        v = a.value[\"v\"]\n        pat = v.get(\"pattern\", \"\") if isinstance(v, dict) else str(v)\n        if pat and re.search(pat, name, re.I):\n            hits.append({\"pattern\": pat,\n===== speechfloor ====="}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"tree-fire","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#8c1b4ec4c16845f2ad78ca19806afd91","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Ethics gate (C-EthicsGate — the machinery beneath the prompt-specified\nimitation mark, §Personalities).\n\nDepth over the mark alone:\n- **liveness research** — the gate looks the subject up through the configured\n  wikipedia connector and classifies living / deceased / unclear from the\n  returned summary evidence (never guesses silently: unclear is a real verdict\n  that still requires the mark when the claimed recency is living/recent).\n- **objection/compliance flow** — `maxim:objection` assertions (seeded or\n  user-authored patterns like \"no imitations of active politicians\") are\n  checked; a matching objection changes the verdict to refused, which is a\n  recorded refusal, not silent non-action.\n- **gate cards** — every evaluation emits an `ethics-gate` bus card for the\n  surfaces and an `ethics:gate` ledger assertion with verdict + evidence.\n- **compliance** — a mint whose verdict requires the mark proceeds only with\n  admonishment + permanent mark; a refused mint does not proceed and the need\n  is recorded deferred/refused.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom typing import Optional\n\nfrom . import connectors\nfrom .model import now_ms\n\n# recency classes requiring admonishment + permanent mark (prompt §Personalities)\n_MARKED = (\"living\", \"deceased-10y\")\n\n\ndef liveness_research(ctx, name: str) -> dict:\n    \"\"\"Research the subject through the wikipedia connector; classify from\n    real summary evidence.\"\"\"\n    r = connectors.wiki_summary(name)\n    if not r[\"ok\"]:\n        return {\"verdict\": \"unclear\", \"evidence\": f\"lookup failed: {r.get('error')}\",\n                \"reachable\": False}\n    ex = r.get(\"extract\") or \"\"\n    death = re.search(r\"\\b(?:died|death)\\b.*?(\\b1[89]\\d{2}|20[0-2]\\d)\", ex)\n    born = re.search(r\"born[^.;]{0,60}?(\\b1[89]\\d{2}|20[0-2]\\d)\", ex)\n    if death or re.search(r\"\\bwas an? \", ex):\n        return {\"verdict\": \"deceased\", \"evidence\": ex[:240],\n                \"deathYear\": int(death.group(1)) if death else None,\n                \"reachable\": True, \"title\": r.get(\"title\")}\n    if born or re.search(r\"\\bis an? \", ex):\n        return {\"verdict\": \"living\", \"evidence\": ex[:240],\n                \"birthYear\": int(born.group(1)) if born else None,\n                \"reachable\": True, \"title\": r.get(\"title\")}\n    return {\"verdict\": \"unclear\", \"evidence\": ex[:240] or \"empty summary\",\n            \"reachable\": True, \"title\": r.get(\"title\")}\n\n\ndef objections(ctx, name: str) -> list[dict]:\n    \"\"\"maxim:objection assertions act as user-authored prohibition patterns.\"\"\"\n    hits = []\n    for a in ctx.ledger.query(predicate=\"maxim:objection\"):\n        v = a.value[\"v\"]\n        pat = v.get(\"pattern\", \"\") if isinstance(v, dict) else str(v)\n        if pat and re.search(pat, name, re.I):\n            hits.append({\"pattern\": pat,\n===== speechfloor =====\n\"\"\"Speech floor — serialized playback admission (C-SpeechFloor), the manner\nbeneath C-PerceivableRespondents (contributions individually perceivable) and\nC-SequentialRespondents (respondents present in sequence).\n\nThe host admits exactly one speech render at a time through a FIFO queue.\nEvery admission and every completed playback is recorded as a ledger\nassertion — the floor is evidence, not just a lock. Persona voice preferences\n(portable, C-EngineMapping) ride on each admission and are mapped to engine\nsettings inside the renderer.\n\"\"\"\nfrom __future__ import annotations\n\nimport queue\nimport threading\nfrom typing import Optional\n\nfrom .model import new_id, now_ms\n\n\nclass SpeechFloor(threading.Thread):\n    \"\"\"FIFO playback queue. One render at a time — never overlapping speech.\"\"\"\n\n    def __init__(self, ctx):\n        super().__init__(daemon=True, name=\"speech-floor\")\n        self.ctx = ctx\n        self.q: \"queue.Queue[dict]\" = queue.Queue()\n        self._stop = threading.Event()\n        self.played: list[dict] = []\n\n    # ---- admission ----\n\n    def enqueue(self, text: str, persona: Optional[dict] = None,\n                cause: str = \"response\", voice: Optional[dict] = None) -> dict:\n        \"\"\"Admit a playback request. Returns the admission record; the actual\n        render happens in order on the floor thread.\"\"\"\n        adm = {\"id\": new_id(\"sp\"), \"at\": now_ms(), \"text\": text,\n               \"personaId\": (persona or {}).get(\"id\"),\n               \"personaName\": (persona or {}).get(\"name\", \"Meridian\"),"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"tree-fire","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#8c1b4ec4c16845f2ad78ca19806afd91","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Ethics gate (C-EthicsGate — the machinery beneath the prompt-specified\nimitation mark, §Personalities).\n\nDepth over the mark alone:\n- **liveness research** — the gate looks the subject up through the configured\n  wikipedia connector and classifies living / deceased / unclear from the\n  returned summary evidence (never guesses silently: unclear is a real verdict\n  that still requires the mark when the claimed recency is living/recent).\n- **objection/compliance flow** — `maxim:objection` assertions (seeded or\n  user-authored patterns like \"no imitations of active politicians\") are\n  checked; a matching objection changes the verdict to refused, which is a\n  recorded refusal, not silent non-action.\n- **gate cards** — every evaluation emits an `ethics-gate` bus card for the\n  surfaces and an `ethics:gate` ledger assertion with verdict + evidence.\n- **compliance** — a mint whose verdict requires the mark proceeds only with\n  admonishment + permanent mark; a refused mint does not proceed and the need\n  is recorded deferred/refused.\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom typing import Optional\n\nfrom . import connectors\nfrom .model import now_ms\n\n# recency classes requiring admonishment + permanent mark (prompt §Personalities)\n_MARKED = (\"living\", \"deceased-10y\")\n\n\ndef liveness_research(ctx, name: str) -> dict:\n    \"\"\"Research the subject through the wikipedia connector; classify from\n    real summary evidence.\"\"\"\n    r = connectors.wiki_summary(name)\n    if not r[\"ok\"]:\n        return {\"verdict\": \"unclear\", \"evidence\": f\"lookup failed: {r.get('error')}\",\n                \"reachable\": False}\n    ex = r.get(\"extract\") or \"\"\n    death = re.search(r\"\\b(?:died|death)\\b.*?(\\b1[89]\\d{2}|20[0-2]\\d)\", ex)\n    born = re.search(r\"born[^.;]{0,60}?(\\b1[89]\\d{2}|20[0-2]\\d)\", ex)\n    if death or re.search(r\"\\bwas an? \", ex):\n        return {\"verdict\": \"deceased\", \"evidence\": ex[:240],\n                \"deathYear\": int(death.group(1)) if death else None,\n                \"reachable\": True, \"title\": r.get(\"title\")}\n    if born or re.search(r\"\\bis an? \", ex):\n        return {\"verdict\": \"living\", \"evidence\": ex[:240],\n                \"birthYear\": int(born.group(1)) if born else None,\n                \"reachable\": True, \"title\": r.get(\"title\")}\n    return {\"verdict\": \"unclear\", \"evidence\": ex[:240] or \"empty summary\",\n            \"reachable\": True, \"title\": r.get(\"title\")}\n\n\ndef objections(ctx, name: str) -> list[dict]:\n    \"\"\"maxim:objection assertions act as user-authored prohibition patterns.\"\"\"\n    hits = []\n    for a in ctx.ledger.query(predicate=\"maxim:objection\"):\n        v = a.value[\"v\"]\n        pat = v.get(\"pattern\", \"\") if isinstance(v, dict) else str(v)\n        if pat and re.search(pat, name, re.I):\n            hits.append({\"pattern\": pat,\n===== speechfloor =====\n\"\"\"Speech floor — serialized playback admission (C-SpeechFloor), the manner\nbeneath C-PerceivableRespondents (contributions individually perceivable) and\nC-SequentialRespondents (respondents present in sequence).\n\nThe host admits exactly one speech render at a time through a FIFO queue.\nEvery admission and every completed playback is recorded as a ledger\nassertion — the floor is evidence, not just a lock. Persona voice preferences\n(portable, C-EngineMapping) ride on each admission and are mapped to engine\nsettings inside the renderer.\n\"\"\"\nfrom __future__ import annotations\n\nimport queue\nimport threading\nfrom typing import Optional\n\nfrom .model import new_id, now_ms\n\n\nclass SpeechFloor(threading.Thread):\n    \"\"\"FIFO playback queue. One render at a time — never overlapping speech.\"\"\"\n\n    def __init__(self, ctx):\n        super().__init__(daemon=True, name=\"speech-floor\")\n        self.ctx = ctx\n        self.q: \"queue.Queue[dict]\" = queue.Queue()\n        self._stop = threading.Event()\n        self.played: list[dict] = []\n\n    # ---- admission ----\n\n    def enqueue(self, text: str, persona: Optional[dict] = None,\n                cause: str = \"response\", voice: Optional[dict] = None) -> dict:\n        \"\"\"Admit a playback request. Returns the admission record; the actual\n        render happens in order on the floor thread.\"\"\"\n        adm = {\"id\": new_id(\"sp\"), \"at\": now_ms(), \"text\": text,\n               \"personaId\": (persona or {}).get(\"id\"),\n               \"personaName\": (persona or {}).get(\"name\", \"Meridian\"),\n               \"cause\": cause, \"voice\": voice or (persona or {}).get(\"voice\") or {},\n               \"position\": self.q.qsize() + 1}"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
