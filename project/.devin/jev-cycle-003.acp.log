{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"harsh-church","update":{"sessionUpdate":"available_commands_update","availableCommands":[{"name":"status","description":"Check authentication status","_meta":{"cognition.ai/icon":"user-check","cognition.ai/category":"Account"}},{"name":"billing","description":"Choose whether a provider plan (e.g. ChatGPT) pays for its models","input":{"hint":"[on|off]"},"_meta":{"cognition.ai/icon":"credit-card","cognition.ai/category":"Account"}},{"name":"workspace","description":"List workspace directories","_meta":{"cognition.ai/icon":"folder-open","cognition.ai/category":"System"}},{"name":"ask","description":"Switch to Ask mode (read-only)","input":{"hint":"[question]"},"_meta":{"cognition.ai/icon":"message-circle","cognition.ai/category":"Session"}},{"name":"plan","description":"Switch to Plan mode, or plan with a prompt","input":{"hint":"[prompt]"},"_meta":{"cognition.ai/icon":"file-text","cognition.ai/category":"Session"}},{"name":"code","description":"Switch to Code mode, or run a prompt in it","input":{"hint":"[prompt]"},"_meta":{"cognition.ai/icon":"code","cognition.ai/category":"Session"}},{"name":"smart","description":"Switch to Smart mode, or run a prompt under it","input":{"hint":"[prompt]"},"_meta":{"cognition.ai/icon":"sparkles","cognition.ai/category":"Session"}},{"name":"bypass","description":"Switch to Bypass Permissions mode, or run a prompt under it","input":{"hint":"[prompt]"},"_meta":{"cognition.ai/icon":"shield-off","cognition.ai/category":"Session"}},{"name":"compact","description":"Force conversation compaction","_meta":{"cognition.ai/icon":"archive","cognition.ai/category":"Session"}},{"name":"context","description":"Show context window usage","_meta":{"cognition.ai/icon":"pie-chart","cognition.ai/category":"Session"}},{"name":"fast","description":"Switch to the fastest model available to you, or run a prompt with it","input":{"hint":"[prompt]"},"_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Session"}},{"name":"goal","description":"Set a goal the agent keeps working on until it is done","input":{"hint":"[<objective>|resume|clear]"},"_meta":{"cognition.ai/icon":"target","cognition.ai/category":"Session"}},{"name":"recap","description":"Recap the session so far with a short summary","_meta":{"cognition.ai/icon":"history","cognition.ai/category":"Session"}},{"name":"session-stats","description":"Show session statistics","_meta":{"cognition.ai/icon":"bar-chart-2","cognition.ai/category":"Session"}},{"name":"rename","description":"Rename this session","input":{"hint":"[new title]"},"_meta":{"cognition.ai/icon":"pencil","cognition.ai/category":"Session"}},{"name":"share","description":"Share this conversation with your team on Devin","_meta":{"cognition.ai/icon":"share-2","cognition.ai/category":"Session"}},{"name":"handoff","description":"Hand this session off to a cloud Devin session","input":{"hint":"[task]"},"_meta":{"cognition.ai/icon":"cloud-upload","cognition.ai/category":"Session"}},{"name":"mcp","description":"List configured MCP servers and their status","_meta":{"cognition.ai/icon":"plug","cognition.ai/category":"System"}},{"name":"bug","description":"Report a bug to the Devin CLI developers","input":{"hint":"<description>"},"_meta":{"cognition.ai/icon":"bug","cognition.ai/category":"System"}},{"name":"help","description":"Show available commands","_meta":{"cognition.ai/icon":"help-circle","cognition.ai/category":"Session"}},{"name":"agents:assertion-ledger-vocabulary","description":"Canonical vocabulary for the assertion ledger across Meta Sandbox, GreyAvatar, and Meta Analysis. The assertion ledger is the book of record. Avatars is deprecated (opt-in only). Use when the user or docs say assertion, assumption, assumption ledger, assertion ledger, certainty, truth confidence, computed view, claimant, author, surface, book of record, source, source-descriptor, sourceKind, configured source, gap, unmet need, open tool call, fulfilled tool call, planning barrel, or need:*.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"agents:author-profile","description":"Provides the author's (Kris's) personal historical biographical background, professional context, and preferred working style — including a standing preference for direct, adversarial, bias-countering review. Use when the author states durable biographical facts (heritage, career, formation, methodology). Do not use for ephemeral moods or current session state. For contacts, use cases, pitches, and maxims in Meta Analysis, use record-project-corpus instead.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"automate","description":"Use this skill to create Codex Automations.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"autopilot","description":"Keep a PR merge-ready by triaging comments, resolving clear conflicts, and fixing CI in a loop.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"agents:avatar-meta-sandbox-trio","description":"Defines the repo relationship among Meta Sandbox (theoretical model + delivered reconciliation), GreyAvatar (the current implementation / development path), Avatars (the deprecated read-only archive — consult only when explicitly asked), Meta Analysis (description, oversight, strategy), and AIRG (private ARG/campaign design). Use when working across these projects, deciding where code or docs belong, orienting in any of the workspaces, or when the user mentions the sandbox, avatar project, GreyAvatar, AIRG, or meta analysis project as a set. From Meta Sandbox, the sibling repos are read-only unless the user explicitly says otherwise. For assertion vs assumption vocabulary, use assertion-ledger-vocabulary.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"canvas","description":"A Codex Canvas is a live React app that the user can open beside the chat. You MUST use a canvas when the agent produces a standalone analytical artifact — quantitative analyses, billing investigations, security audits, architecture reviews, data-heavy content, timelines, charts, tables, interactive explorations, repeatable tools, or any response that benefits from visual layout. Especially prefer a canvas when presenting results from MCP tools (Datadog, Databricks, Linear, Sentry, Slack, etc.) where the data is the deliverable — render it in a rich canvas rather than dumping it into a markdown table or code block. If you catch yourself about to write a markdown table, stop and use a canvas instead. You MUST also read this skill whenever you create, edit, or debug any .canvas.tsx file.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"computer-use","description":"Use Orca's computer-use CLI to inspect and operate local desktop app windows through accessibility trees, screenshots, and safe UI actions. Use for desktop app interaction: list apps/windows, get app state, read visible UI, click controls, type, press keys, scroll, drag, set values, or perform accessibility actions. Also use for browser windows, webviews, Orca app UI, or other desktop UI. Triggers include \"computer use\", \"orca computer\", \"read Spotify\", \"read Slack\", \"control/click/read in a desktop app\", and \"get app state\".","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"create-hook","description":"Create Codex hooks. Use when you want to create a hook, write hooks.json, add hook scripts, or automate behavior around agent events.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"create-rule","description":"Create Codex rules for persistent AI guidance. Use when you want to create a rule, add coding standards, set up project conventions, configure file-specific patterns, create RULE.md files, or asks about .cursor/rules/ or AGENTS.md.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"create-skill","description":"Create Codex Agent Skills. Use when authoring a new skill or asking about SKILL.md structure.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"create-subagent","description":"Create custom subagents for specialized AI tasks. Use when you want to create a new type of subagent, set up task-specific agents, configure code reviewers, debuggers, or domain-specific assistants with custom prompts.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"agents:defining-use-cases","description":"Author a new use-case study the way this account defines them: everything is ultimately logistics, and the product is an operating system that anticipates the user's needs. Use when the user asks to make/define/add a \"use case\", spins up a new agent for a use case, or explores how a capability (a device, a connector, a workflow) would serve the user. Produces a non-normative, forward-looking doc that reuses existing mechanisms (tools, templates, gates, witnessed grants, workshops) rather than inventing subsystems, grounds itself in a real-world analogy, and wires itself into the project's vision and docs index.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"deploy-with-vercel","description":"Link this repository to a Vercel project and deploy it using the Vercel MCP tools.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"devin-cli-headless","description":"Run Devin CLI sessions headless on this Windows machine — where the binary lives, why `devin -p` / `auth status` report \"not logged in\" despite valid credentials, how to drive `auth login` without a TTY (pywinpty), and the working ACP spawn path (devin.exe acp + authenticate._meta.api_key) that bypasses the interactive auth gate for build/JEV sessions.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"find-skills","description":"Helps users discover and install agent skills when they ask questions like \"how do I do X\", \"find a skill for X\", \"is there a skill that can...\", or express interest in extending capabilities. This skill should be used when the user is looking for functionality that might exist as an installable skill.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"goal","description":"Set a goal that Codex will pursue to completion.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"loop","description":"Run a prompt or skill in this session on a recurring or variable interval (e.g. /loop 5m /foo).","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"migrate-to-skills","description":"Convert 'Applied intelligently' Codex rules (.cursor/rules/*.mdc) and slash commands (.cursor/commands/*.md) to Agent Skills format (.cursor/skills/). Use when you want to migrate rules or commands to skills, convert .mdc rules to SKILL.md format, or consolidate commands into the skills directory.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"new-repo","description":"Create a Codex-hosted repo for the current project and push it. Use when a project has no git remote yet and the user asks to create a repo on Codex, push the project to Codex, or set up a Codex-hosted remote; installs and signs in the origin CLI when needed.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"onboard","description":"Use /onboard for a focused Codex onboarding flow that learns basic preferences, picks a first goal, and routes the user to the right next action.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"orca-cli","description":"Use the public `orca` CLI to operate Orca-managed worktrees, folder contexts, terminals, repos, automations, artifacts, worktree comments, and the browser embedded inside the Orca app. Use when the user says \"$orca-cli\", \"use orca cli\", \"Orca worktree\", \"child worktree\", \"cardStatus\", \"spawn codex/claude in a worktree\", \"read/wait/send Orca terminal\", \"terminal send\", \"full handoff\", \"handover\", \"give this to another agent\", \"another worktree\", \"Orca browser\", \"orca artifacts\", \"share HTML/Markdown\", \"public artifact link\", or \"control the browser inside Orca\". Prefer this over raw `git worktree`, ad hoc PTYs, Playwright, or Computer Use when the task touches Orca-managed state. Use Computer Use for browser windows, webviews, or desktop UI outside Orca's embedded browser.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"orchestration","description":"Use Orca orchestration for structured multi-agent coordination: threaded messages, blocking ask/reply flows, task dispatch, worker_done/escalation waits, task DAGs, decision gates, coordinator loops, or decomposing work across agents. Use `orca-cli` instead for full ownership handoffs, including requests phrased as \"hand off\", \"handoff\", \"handover\", \"give this to another agent\", or \"another worktree\" when the user did not explicitly ask to supervise, monitor, wait for results, or coordinate a DAG. Use `orca-cli` for ordinary terminal control, lightweight terminal prompts, shell commands, Orca worktree management, reading or waiting on terminals, and automation of the browser embedded inside Orca. Use Computer Use for browser windows, webviews, Orca app UI, or desktop UI outside Orca's embedded browser.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"origin","description":"Install, sign in, update, or repair the origin CLI for repos hosted on Codex (origin.cursor.com). Use when the CLI is missing or outdated, git push/pull fails to authenticate against origin.cursor.com, or the user asks to set up, clone, or configure Codex-hosted repos.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"agents:powershell-shell-commands","description":"Run git and other shell commands correctly on Windows PowerShell 7+ (the default shell here). PS7 supports `&&` and `||` chaining. PowerShell still has no bash heredocs. Use when writing a multi-line git commit message, chaining commands, or when a command fails with \"Missing file specification after redirection operator\" / \"The '<' operator is reserved for future use\".","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"agents:record-agent-bad-behavior","description":"Record owner reports and observed evidence of degrading Codex / coding-agent bad behavior into Meta Analysis notes for platform-migration learning. Use when the user mentions bad behavior, another mistake, agent failure, untrustworthy agent conduct, rule noncompliance, reverting to bad habits, false Done/Fixed, AskQuestion spam, permission spam, premature structure, checkout dishonesty, quality degradation, or skills not being executed — in Meta Analysis or GreyAvatar (or when comparing Codex vs Grey harness). Not for product UX friction (use record-improvement-proposals) or biographical corpus.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"rename-chat","description":"Rename the current chat to match its focus. Use only when the user invokes /rename-chat. Optional text after the command steers the title.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"review","description":"Review code changes with the Bugbot or Security Review subagent.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"review-bugbot","description":"Review code changes with Bugbot subagent.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"review-security","description":"Review code changes with Security Review subagent.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"sdk","description":"Guide users building apps, scripts, CI pipelines, or automations on top of the Codex SDK - TypeScript (`@cursor/sdk`) or Python (`cursor-sdk` / `cursor_sdk`). Use when the user mentions integrating, installing, or writing code against the Codex SDK; says `Agent.create`, `Agent.prompt`, `Agent.resume`, `agent.send`, `run.stream`, `run.messages`, `CursorAgentError`, `@cursor/sdk`, `cursor-sdk`, or `cursor_sdk`; asks to run Codex agents programmatically from a script, CI/CD pipeline, GitHub Action, backend service, or other code outside the Codex IDE; wants to pick between local and cloud runtime, configure MCP servers for an SDK agent, or handle streaming, cancellation, or errors; or is wiring Codex into an automation, bot, or REST `/v1/agents` migration. Use eagerly rather than answering from memory; the SDK surface evolves and this skill is the source of truth for the external packages.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"share","description":"Save, back up, or share the current project on Codex — creates a repo (a saved, versioned copy that isn't public) even for users who have never used git, handling all setup automatically. Use when the user asks to save, back up, publish, or share their project on Codex, or how to not lose it.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"shell","description":"Runs the rest of a /shell request as a literal shell command. Use only when the user explicitly invokes /shell and wants the following text executed directly in the terminal.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"split-to-prs","description":"Split current work into small reviewable PRs. Use when the user asks to split a chat, set of changes, branch, or PR.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"statusline","description":"Configure a custom status line in the CLI. Use when the user mentions status line, statusline, statusLine, CLI status bar, prompt footer customization, or wants to add session context above the prompt.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"agents:thorough-criticism","description":"Performs a thorough, evidence-based critique of a programming project: synthesizes behavior, maps structure, finds redundancies/antipatterns, audits tests and naming, compares code to specs, researches commercial build-vs-buy options after the project goal is clear, researches technical alternatives for novel features, lists security issues, and outputs easy fixes vs embedded flaws. Use when the user asks for thorough criticism, deep code review, architecture critique, security audit of codebase, or test-suite critique.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"update-cli-config","description":"View and modify Codex CLI configuration settings in ~/.cursor/cli-config.json. Use when the user wants to change CLI settings, configure permissions, switch approval mode, enable vim mode, toggle display options, configure sandbox, or manage any CLI preferences.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"update-cursor-settings","description":"Modify Codex/VSCode user settings in settings.json. Use when you want to change editor settings, preferences, configuration, themes, font size, tab size, format on save, auto save, keybindings, or any settings.json values.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"cursor:assertion-ledger-vocabulary","description":"Canonical vocabulary for the assertion ledger across Meta Sandbox, GreyAvatar, and Meta Analysis. The assertion ledger is the book of record. Avatars is deprecated (opt-in only). Use when the user or docs say assertion, assumption, assumption ledger, assertion ledger, certainty, truth confidence, computed view, claimant, author, surface, book of record, source, source-descriptor, sourceKind, configured source, gap, unmet need, open tool call, fulfilled tool call, planning barrel, or need:*.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"cursor:author-profile","description":"Provides the author's (Kris's) personal historical biographical background, professional context, and preferred working style — including a standing preference for direct, adversarial, bias-countering review. Use when the author states durable biographical facts (heritage, career, formation, methodology). Do not use for ephemeral moods or current session state. For contacts, use cases, pitches, and maxims in Meta Analysis, use record-project-corpus instead.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"cursor:avatar-meta-sandbox-trio","description":"Defines the repo relationship among Meta Sandbox (theoretical model + delivered reconciliation), GreyAvatar (the current implementation / development path), Avatars (the deprecated read-only archive — consult only when explicitly asked), Meta Analysis (description, oversight, strategy), and AIRG (private ARG/campaign design). Use when working across these projects, deciding where code or docs belong, orienting in any of the workspaces, or when the user mentions the sandbox, avatar project, GreyAvatar, AIRG, or meta analysis project as a set. From Meta Sandbox, the sibling repos are read-only unless the user explicitly says otherwise. For assertion vs assumption vocabulary, use assertion-ledger-vocabulary.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"cursor:defining-use-cases","description":"Author a new use-case study the way this account defines them: everything is ultimately logistics, and the product is an operating system that anticipates the user's needs. Use when the user asks to make/define/add a \"use case\", spins up a new agent for a use case, or explores how a capability (a device, a connector, a workflow) would serve the user. Produces a non-normative, forward-looking doc that reuses existing mechanisms (tools, templates, gates, witnessed grants, workshops) rather than inventing subsystems, grounds itself in a real-world analogy, and wires itself into the project's vision and docs index.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"cursor:powershell-shell-commands","description":"Run git and other shell commands correctly on Windows PowerShell 7+ (the default shell here). PS7 supports `&&` and `||` chaining. PowerShell still has no bash heredocs. Use when writing a multi-line git commit message, chaining commands, or when a command fails with \"Missing file specification after redirection operator\" / \"The '<' operator is reserved for future use\".","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"cursor:record-agent-bad-behavior","description":"Record owner reports and observed evidence of degrading Cursor / coding-agent bad behavior into Meta Analysis notes for platform-migration learning. Use when the user mentions bad behavior, another mistake, agent failure, untrustworthy agent conduct, rule noncompliance, reverting to bad habits, false Done/Fixed, AskQuestion spam, permission spam, premature structure, checkout dishonesty, quality degradation, or skills not being executed — in Meta Analysis or GreyAvatar (or when comparing Cursor vs Grey harness). Not for product UX friction (use record-improvement-proposals) or biographical corpus.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"cursor:thorough-criticism","description":"Performs a thorough, evidence-based critique of a programming project: synthesizes behavior, maps structure, finds redundancies/antipatterns, audits tests and naming, compares code to specs, researches commercial build-vs-buy options after the project goal is clear, researches technical alternatives for novel features, lists security issues, and outputs easy fixes vs embedded flaws. Use when the user asks for thorough criticism, deep code review, architecture critique, security audit of codebase, or test-suite critique.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"harness","description":"Operate the development harness — directions, cycles, JEV judging, scenario suite, devlog. Use when the user asks to set up or run the harness in this folder, issues a direction, or mentions cycles, JEV, rubric, scenario suite, coordinator/build sessions, or the development log.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"declarative-repo-setup","description":"Generate and verify a working environment.yaml (Devin snapshot-setup blueprint) for a repo","input":{"hint":"<owner/repo>"},"_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"upload-secrets","description":"Securely upload local secrets (dotenv files, env vars, API keys) to the Devin Cloud secrets manager — values never enter the conversation","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}},{"name":"devin-playbooks:hi-i-m-devin","description":"Hi, I'm Devin. Overview.","_meta":{"cognition.ai/icon":"zap","cognition.ai/category":"Skills"}}]}}}
