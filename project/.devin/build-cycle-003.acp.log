{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call","toolCallId":"edit:0#d4ef901b474540f39e2ad2dac364133d","title":"Edited C:\\builds\\project\\version 0.3.0.003\\app\\speechfloor.py","kind":"edit","content":[{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.003\\app\\speechfloor.py","oldText":"\"\"\"Speech floor — serialized playback admission (C-SpeechFloor), the manner\nbeneath C-PerceivableRespondents (contributions individually perceivable) and\nC-SequentialRespondents (respondents present in sequence).\n\nThe host admits exactly one speech render at a time through a FIFO queue.\nEvery admission and every completed playback is recorded as a ledger\nassertion — the floor is evidence, not just a lock. Persona voice preferences\n(portable, C-EngineMapping) ride on each admission and are mapped to engine\nsettings inside the renderer.\n\"\"\"\nfrom __future__ import annotations\n\nimport queue\nimport threading\nfrom typing import Optional\n\nfrom .model import new_id, now_ms\n\n\nclass SpeechFloor(threading.Thread):\n    \"\"\"FIFO playback queue. One render at a time — never overlapping speech.\"\"\"\n\n    def __init__(self, ctx):\n        super().__init__(daemon=True, name=\"speech-floor\")\n        self.ctx = ctx\n        self.q: \"queue.Queue[dict]\" = queue.Queue()\n        self._stop = threading.Event()\n        self.played: list[dict] = []\n\n    # ---- admission ----\n\n    def enqueue(self, text: str, persona: Optional[dict] = None,\n                cause: str = \"response\", voice: Optional[dict] = None) -> dict:\n        \"\"\"Admit a playback request. Returns the admission record; the actual\n        render happens in order on the floor thread.\"\"\"\n        adm = {\"id\": new_id(\"sp\"), \"at\": now_ms(), \"text\": text,\n               \"personaId\": (persona or {}).get(\"id\"),\n               \"personaName\": (persona or {}).get(\"name\", \"Meridian\"),\n               \"cause\": cause, \"voice\": voice or (persona or {}).get(\"voice\") or {},\n               \"position\": self.q.qsize() + 1}\n        self.ctx.append(\"speech\", \"speech:floor-admission\", adm,\n                        \"system\", basis={\"kind\": \"execution\"})\n        if not self.is_alive():\n            self.start()\n        self.q.put(adm)\n        return adm\n\n    def depth(self) -> int:\n        return self.q.qsize()\n\n    # ---- floor worker ----\n\n    def run(self):\n        while not self._stop.is_set():\n            try:\n                adm = self.q.get(timeout=0.5)\n            except queue.Empty:\n                continue\n            t0 = now_ms()\n            r = self.ctx.invoke(\"speak-voice\",\n                                {\"text\": adm[\"text\"], \"personaId\": adm[\"personaId\"],\n                                 \"voice\": adm[\"voice\"]})\n            rec = {\"admission\": adm[\"id\"], \"personaId\": adm[\"personaId\"],\n                   \"personaName\": adm[\"personaName\"],\n                   \"voice\": adm[\"voice\"], \"ok\": bool(r.get(\"ok\")),\n                   \"renderedBy\": (r.get(\"result\") or {}).get(\"renderedBy\"),\n                   \"ms\": now_ms() - t0,\n                   \"error\": r.get(\"error\") or\n                            (r.get(\"result\") or {}).get(\"error\")}\n            self.played.append(rec)\n            self.ctx.append(\"speech\", \"speech:floor-played\", rec,\n                            \"engine:tts\", basis={\"kind\": \"execution\"})\n            self.ctx.emit(\"card\", {\"kind\": \"speech\", \"summary\":\n                                   f\"{adm['personaName']} spoke \"\n                                   f\"({rec['renderedBy'] or 'unrendered'})\",\n                                   \"floor\": rec, \"at\": now_ms()})\n            self.q.task_done()\n\n    def drain(self, timeout: float = 30.0) -> bool:\n        \"\"\"Wait until the queue is empty (test/demo seam).\"\"\"\n        import time\n        t0 = time.time()\n        while not self.q.empty() and time.time() - t0 < timeout:\n            time.sleep(0.05)\n        t1 = time.time()\n        while self.played and time.time() - t1 < 10:\n            # give last render a beat to record\n            return True\n        return self.q.empty()\n\n    def stop(self):\n        self._stop.set()\n","newText":"\"\"\"Speech floor — serialized playback admission (C-SpeechFloor), the manner\nbeneath C-PerceivableRespondents (contributions individually perceivable) and\nC-SequentialRespondents (respondents present in sequence).\n\nThe host admits exactly one speech render at a time through a FIFO queue.\nEvery admission and every completed playback is recorded as a ledger\nassertion — the floor is evidence, not just a lock. Persona voice preferences\n(portable, C-EngineMapping) ride on each admission and are mapped to engine\nsettings inside the renderer.\n\"\"\"\nfrom __future__ import annotations\n\nimport queue\nimport threading\nfrom typing import Optional\n\nfrom .model import new_id, now_ms\n\n\nclass SpeechFloor(threading.Thread):\n    \"\"\"FIFO playback queue. One render at a time — never overlapping speech.\"\"\"\n\n    def __init__(self, ctx):\n        super().__init__(daemon=True, name=\"speech-floor\")\n        self.ctx = ctx\n        self.q: \"queue.Queue[dict]\" = queue.Queue()\n        self._stop = threading.Event()\n        self.played: list[dict] = []\n\n    # ---- admission ----\n\n    def enqueue(self, text: str, persona: Optional[dict] = None,\n                cause: str = \"response\", voice: Optional[dict] = None) -> dict:\n        \"\"\"Admit a playback request. Returns the admission record; the actual\n        render happens in order on the floor thread.\"\"\"\n        adm = {\"id\": new_id(\"sp\"), \"at\": now_ms(), \"text\": text,\n               \"personaId\": (persona or {}).get(\"id\"),\n               \"personaName\": (persona or {}).get(\"name\", \"Meridian\"),\n               \"cause\": cause, \"voice\": voice or (persona or {}).get(\"voice\") or {},\n               \"position\": self.q.qsize() + 1}\n        self.ctx.append(\"speech\", \"speech:floor-admission\", adm,\n                        \"system\", basis={\"kind\": \"execution\"})\n        if not self.is_alive():\n            self.start()\n        self.q.put(adm)\n        return adm\n\n    def depth(self) -> int:\n        return self.q.qsize()\n\n    # ---- floor worker ----\n\n    def run(self):\n        while not self._stop.is_set():\n            try:\n                adm = self.q.get(timeout=0.5)\n            except queue.Empty:\n                continue\n            t0 = now_ms()\n            r = self.ctx.invoke(\"speak-voice\",\n                                {\"text\": adm[\"text\"], \"personaId\": adm[\"personaId\"],\n                                 \"voice\": adm[\"voice\"]})\n            res = r.get(\"result\") or {}\n            rec = {\"admission\": adm[\"id\"], \"personaId\": adm[\"personaId\"],\n                   \"personaName\": adm[\"personaName\"],\n                   \"voice\": adm[\"voice\"], \"ok\": bool(r.get(\"ok\")),\n                   \"renderedBy\": res.get(\"renderedBy\"),\n                   \"ms\": now_ms() - t0,\n                   \"playbackMs\": res.get(\"playbackMs\"),\n                   \"heldUntilPlaybackComplete\": True,\n                   \"error\": r.get(\"error\") or res.get(\"error\")}\n            self.played.append(rec)\n            self.ctx.append(\"speech\", \"speech:floor-played\", rec,\n                            \"engine:tts\", basis={\"kind\": \"execution\"})\n            self.ctx.emit(\"card\", {\"kind\": \"speech\", \"summary\":\n                                   f\"{adm['personaName']} spoke \"\n                                   f\"({rec['renderedBy'] or 'unrendered'})\",\n                                   \"floor\": rec, \"at\": now_ms()})\n            self.q.task_done()\n\n    def drain(self, timeout: float = 30.0) -> bool:\n        \"\"\"Wait until the queue is empty (test/demo seam).\"\"\"\n        import time\n        t0 = time.time()\n        while not self.q.empty() and time.time() - t0 < timeout:\n            time.sleep(0.05)\n        t1 = time.time()\n        while self.played and time.time() - t1 < 10:\n            # give last render a beat to record\n            return True\n        return self.q.empty()\n\n    def stop(self):\n        self._stop.set()\n","_meta":{"cognition.ai/linesAdded":5,"cognition.ai/linesRemoved":3}}],"rawInput":{"file_path":"C:\\builds\\project\\version 0.3.0.003\\app\\speechfloor.py","old_string":"            rec = {\"admission\": adm[\"id\"], \"personaId\": adm[\"personaId\"],\n                   \"personaName\": adm[\"personaName\"],\n                   \"voice\": adm[\"voice\"], \"ok\": bool(r.get(\"ok\")),\n                   \"renderedBy\": (r.get(\"result\") or {}).get(\"renderedBy\"),\n                   \"ms\": now_ms() - t0,\n                   \"error\": r.get(\"error\") or\n                            (r.get(\"result\") or {}).get(\"error\")}","new_string":"            res = r.get(\"result\") or {}\n            rec = {\"admission\": adm[\"id\"], \"personaId\": adm[\"personaId\"],\n                   \"personaName\": adm[\"personaName\"],\n                   \"voice\": adm[\"voice\"], \"ok\": bool(r.get(\"ok\")),\n                   \"renderedBy\": res.get(\"renderedBy\"),\n                   \"ms\": now_ms() - t0,\n                   \"playbackMs\": res.get(\"playbackMs\"),\n                   \"heldUntilPlaybackComplete\": True,\n                   \"error\": r.get(\"error\") or res.get(\"error\")}"},"_meta":{"cognition.ai/suppressApproval":true,"cognition.ai/inferenceToolName":"edit","cognition.ai/timestamp":"2026-11-22T08:11:38.559006+00:00"}}}}
