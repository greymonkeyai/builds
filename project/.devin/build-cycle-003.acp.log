{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#c8315e32e5aa47c7978a532781de8328","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Per-personality generated art (C-PersonalityArt) + presentation glass\n(C-PresentationGlass: asset pipeline, portrait frames, ambient motion).\n\nEvery personality's art is *unique to that personality*: the composition is\nseeded from the persona's identity (id), name, traits, and interests — never\nshared or placeholder media. The generated SVG carries:\n- a deterministic motif family derived from the persona's interests\n- a palette derived from the persona's name + id\n- ambient motion (real SVG animation — drifting elements, not a static image)\n- a portrait frame keyed to the persona's display mode / imitation status\n\nThe asset pipeline is honest: `persona:art` assertions record the seed,\nmotif, palette, and artifact path. When a persona's traits change, a re-render\nproduces a *new* asset supplanting (not silently overwriting) the old.\n\"\"\"\nfrom __future__ import annotations\n\nimport base64\nimport hashlib\nimport os\nimport re\nfrom typing import Optional\n\nMOTIFS = (\"orbits\", \"strata\", \"prism\", \"glyphs\", \"tide\", \"circuit\", \"garden\", \"halo\")\nFRAMES = (\"arc\", \"square\", \"notch\", \"double\")\n\n\ndef _seed(persona: dict) -> int:\n    h = hashlib.sha256(\n        (persona.get(\"id\", \"\") + \"|\" + persona.get(\"name\", \"\") + \"|\" +\n         \",\".join(persona.get(\"traits\") or []) + \"|\" +\n         \",\".join(persona.get(\"interests\") or [])).encode()).digest()"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#c8315e32e5aa47c7978a532781de8328","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Per-personality generated art (C-PersonalityArt) + presentation glass\n(C-PresentationGlass: asset pipeline, portrait frames, ambient motion).\n\nEvery personality's art is *unique to that personality*: the composition is\nseeded from the persona's identity (id), name, traits, and interests — never\nshared or placeholder media. The generated SVG carries:\n- a deterministic motif family derived from the persona's interests\n- a palette derived from the persona's name + id\n- ambient motion (real SVG animation — drifting elements, not a static image)\n- a portrait frame keyed to the persona's display mode / imitation status\n\nThe asset pipeline is honest: `persona:art` assertions record the seed,\nmotif, palette, and artifact path. When a persona's traits change, a re-render\nproduces a *new* asset supplanting (not silently overwriting) the old.\n\"\"\"\nfrom __future__ import annotations\n\nimport base64\nimport hashlib\nimport os\nimport re\nfrom typing import Optional\n\nMOTIFS = (\"orbits\", \"strata\", \"prism\", \"glyphs\", \"tide\", \"circuit\", \"garden\", \"halo\")\nFRAMES = (\"arc\", \"square\", \"notch\", \"double\")\n\n\ndef _seed(persona: dict) -> int:\n    h = hashlib.sha256(\n        (persona.get(\"id\", \"\") + \"|\" + persona.get(\"name\", \"\") + \"|\" +\n         \",\".join(persona.get(\"traits\") or []) + \"|\" +\n         \",\".join(persona.get(\"interests\") or [])).encode()).digest()\n    return int.from_bytes(h[:8], \"big\")\n\n\ndef _rng(seed: int):\n    state = [seed & 0xFFFFFFFFFFFFFFFF or 1]\n\n    def nxt() -> float:\n        state[0] = (state[0] * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF\n        return (state[0] >> 33) / 0x7FFFFFFF\n    return nxt\n\n\ndef _palette(persona: dict) -> list:\n    h = hashlib.md5((persona.get(\"id\", \"\") + persona.get(\"name\", \"\")).encode()).digest()\n    base = h[0] / 255 * 360\n    cols = []\n    for i in range(4):\n        hue = (base + i * (40 + h[1] % 90)) % 360\n\u001b[0m[... 253 lines omitted ...]\n    temporal_ask = bool(text_toks & {\"when\", \"calendar\", \"schedule\", \"upcoming\",\n                                     \"today\", \"tomorrow\", \"deadline\", \"week\",\n                                     \"soon\", \"date\", \"remind\"})\n    if not (temporal_lens or temporal_ask):\n        return None\n    ctxv = temporal_context(ctx, horizon_ms=3 * DAY)\n    if not (ctxv[\"current\"] or ctxv[\"upcoming\"]):\n        return None\n    bits = [f\"{e['title']} ({_fmt(e.get('startMs'))})\" for e in\n            (ctxv[\"current\"] + ctxv[\"upcoming\"])[:3]]\n    note = \"Temporal context from the ledger calendar: \" + \"; \".join(bits)\n    ctx.append(f\"persona:{persona['id']}\", \"persona:temporal-note\",\n               {\"note\": note, \"events\": [e[\"assertionId\"] for e in\n                                         (ctxv[\"current\"] + ctxv[\"upcoming\"])[:3]]},\n               \"system\", basis={\"kind\": \"interpretation\"})\n    return note\n\n\ndef _fmt(ms: int) -> str:\n    import datetime as dt\n    if not ms:\n        return \"?\"\n    return dt.datetime.fromtimestamp(ms / 1000).strftime(\"%Y-%m-%d %H:%M\")\n\n\ndef steward_attention(ctx) -> dict:\n    \"\"\"Background-attention duty: interpret the calendar into findings and\n    present the relevant ones through a distinct personality (prompt §Background\n    activity and attention; demo 6 channel).\"\"\"\n    ctxv = temporal_context(ctx, horizon_ms=72 * 3600 * 1000)\n    findings = []\n    # (a) upcoming/current events the user should hear about\n    for e in (ctxv[\"current\"] + ctxv[\"upcoming\"])[:5]:\n        findings.append({\"kind\": \"calendar\", \"event\": e})\n    # (b) projects with deadlines inside the horizon, or linked events coming due\n    for pa in ctx.ledger.query(predicate=\"project:exists\"):\n        pid = pa.subjectKey.split(\":\", 1)[1]\n        subj = pa.subjectKey\n        due_rows = ctx.ledger.query(subject=subj, predicate=\"project:due\")\n        due = due_rows[-1].value[\"v\"] if due_rows else None\n        if due and now_ms() <= due <= now_ms() + 72 * 3600 * 1000:\n            findings.append({\"kind\": \"project-due\", \"projectId\": pid,\n                             \"title\": pa.value[\"v\"].get(\"title\"), \"dueMs\": due})\n        proj = {\"title\": pa.value[\"v\"].get(\"title\"), \"goals\":\n                [r.value[\"v\"] for r in ctx.ledger.query(subject=subj,\n                                                      predicate=\"project:goal\")]}\n        for hit in linkable(ctx, proj, window_ms=14 * DAY):\n            already = [r for r in ctx.ledger.query(subject=subj,\n                                                   predicate=\"calendar:linked\")\n                       if r.value[\"v\"] == hit[\"assertionId\"]]\n            if not already:\n                ctx.append(subj, \"calendar:linked\", hit[\"assertionId\"],\n                           \"steward:main\", certainty=0.8,\n                           basis={\"kind\": \"interpretation\"},\n                           relates=[hit[\"assertionId\"]])\n                findings.append({\"kind\": \"project-event-link\",\n                                 \"projectId\": pid, \"title\": proj[\"title\"],\n                                 \"event\": hit})\n    ctx.append(\"temporal\", \"temporal:attention\",\n               {\"findings\": findings, \"contextCount\": ctxv[\"count\"]},\n               \"steward:main\", basis={\"kind\": \"execution\"})\n    return {\"findings\": findings, \"context\": ctxv[\"count\"]}\n\n\ndef present_attention(ctx, findings: list) -> Optional[dict]:\n    \"\"\"Offer the steward's temporal findings to a persona whose lens fits —\n    completed background work surfaced as a relevant result (demo 6).\"\"\"\n    if not findings:\n        return None\n    roster = ctx.personas.roster()\n    if not roster:\n        return None\n    # pick the persona whose interests/responsibilities overlap time/attention\n    best, best_n = None, -1\n    for p in roster:\n        toks = set()\n        for k in (p.get(\"interests\") or []) + (p.get(\"traits\") or []):\n            toks |= _tokens(k)\n        for r in (p.get(\"lens\") or {}).get(\"responsibilities\") or []:\n            toks |= _tokens(r)\n        n = len(toks & {\"calendar\", \"time\", \"attention\", \"stewardship\",\n                        \"temporal\", \"opportunities\", \"notifications\", \"schedule\"})\n        if n > best_n:\n            best, best_n = p, n\n    p = best or roster[0]\n    lines = []\n    for f in findings[:4]:\n        if f[\"kind\"] == \"calendar\":\n            lines.append(f\"event: {f['event'].get('title')} at {_fmt(f['event'].get('startMs'))}\")\n        elif f[\"kind\"] == \"project-due\":\n            lines.append(f\"project '{f['title']}' is due at {_fmt(f['dueMs'])}\")\n        else:\n            lines.append(f\"project '{f['title']}' relates to event \"\n                         f\"'{f['event'].get('title')}' at {_fmt(f['event'].get('startMs'))}\")\n    text = (\"Stewardship pass — temporal attention: \" + \"; \".join(lines) +\n            \". Evidence is in the ledger (calendar:event, project:due, calendar:linked).\")\n    card = ctx.invoke(\"persona.speak\",\n                      {\"personaId\": p[\"id\"], \"text\": text,\n                       \"cause\": \"stewardship-temporal\", \"engine\": \"temporal\"})\n    return {\"persona\": p[\"name\"], \"text\": text, \"card\": card.get(\"result\")}"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#c8315e32e5aa47c7978a532781de8328","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Per-personality generated art (C-PersonalityArt) + presentation glass\n(C-PresentationGlass: asset pipeline, portrait frames, ambient motion).\n\nEvery personality's art is *unique to that personality*: the composition is\nseeded from the persona's identity (id), name, traits, and interests — never\nshared or placeholder media. The generated SVG carries:\n- a deterministic motif family derived from the persona's interests\n- a palette derived from the persona's name + id\n- ambient motion (real SVG animation — drifting elements, not a static image)\n- a portrait frame keyed to the persona's display mode / imitation status\n\nThe asset pipeline is honest: `persona:art` assertions record the seed,\nmotif, palette, and artifact path. When a persona's traits change, a re-render\nproduces a *new* asset supplanting (not silently overwriting) the old.\n\"\"\"\nfrom __future__ import annotations\n\nimport base64\nimport hashlib\nimport os\nimport re\nfrom typing import Optional\n\nMOTIFS = (\"orbits\", \"strata\", \"prism\", \"glyphs\", \"tide\", \"circuit\", \"garden\", \"halo\")\nFRAMES = (\"arc\", \"square\", \"notch\", \"double\")\n\n\ndef _seed(persona: dict) -> int:\n    h = hashlib.sha256(\n        (persona.get(\"id\", \"\") + \"|\" + persona.get(\"name\", \"\") + \"|\" +\n         \",\".join(persona.get(\"traits\") or []) + \"|\" +\n         \",\".join(persona.get(\"interests\") or [])).encode()).digest()\n    return int.from_bytes(h[:8], \"big\")\n\n\ndef _rng(seed: int):\n    state = [seed & 0xFFFFFFFFFFFFFFFF or 1]\n\n    def nxt() -> float:\n        state[0] = (state[0] * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF\n        return (state[0] >> 33) / 0x7FFFFFFF\n    return nxt\n\n\ndef _palette(persona: dict) -> list:\n    h = hashlib.md5((persona.get(\"id\", \"\") + persona.get(\"name\", \"\")).encode()).digest()\n    base = h[0] / 255 * 360\n    cols = []\n    for i in range(4):\n        hue = (base + i * (40 + h[1] % 90)) % 360\n        sat = 45 + (h[2 + i] % 45)\n        lit = 30 + (h[6 + i] % 45)\n        cols.append(f\"hsl({int(hue)},{sat}%,{lit}%)\")\n    return cols\n\n\ndef _motif_for(persona: dict, rng) -> str:\n    key = \" \".join(persona.get(\"interests\") or []) + \" \" + \" \".join(persona.get(\"traits\") or [])\n    key = (key or persona.get(\"name\", \"\")).lower()\n    words = re.findall(r\"[a-z]+\", key)\n    vocab = {\"orbits\": (\"star\", \"sky\", \"orbit\", \"space\", \"plan\", \"cycle\", \"calendar\", \"time\"),\n             \"strata\": (\"ledger\", \"record\", \"history\", \"layer\", \"archive\", \"data\", \"provenance\"),\n             \"prism\": (\"light\", \"glass\", \"spectrum\", \"clarity\", \"analyze\", \"inspect\"),\n             \"glyphs\": (\"word\", \"text\", \"write\", \"language\", \"chat\", \"story\", \"essay\"),\n             \"tide\": (\"water\", \"flow\", \"travel\", \"music\", \"sound\", \"voice\", \"speech\"),\n             \"circuit\": (\"tool\", \"compute\", \"machine\", \"engine\", \"system\", \"build\"),\n             \"garden\": (\"grow\", \"plant\", \"nature\", \"care\", \"tend\", \"garden\", \"cultivate\"),\n             \"halo\": (\"watch\", \"attention\", \"alert\", \"forward\", \"herald\", \"notify\")}\n    best, best_n = MOTIFS[int(rng() * len(MOTIFS))], 0\n    for m, words_m in vocab.items():\n        n = sum(1 for w in words if any(w.startswith(v) or v in w for v in words_m))\n        if n > best_n:\n            best, best_n = m, n\n    return best\n\n\ndef render_art(ctx, persona: dict, out_dir: Optional[str] = None) -> dict:\n    \"\"\"Generate the persona's unique portrait. Returns svg, artifact path,\n    and the composition record asserted to the ledger.\"\"\"\n    seed = _seed(persona)\n    rng = _rng(seed)\n    motif = _motif_for(persona, rng)\n    cols = _palette(persona)\n    frame = FRAMES[int(rng() * len(FRAMES))]\n    W = H = 160\n    parts = [f'<rect width=\"{W}\" height=\"{H}\" rx=\"18\" fill=\"{cols[0]}\"/>']\n    # ambient motion: two drifting halo layers (real SVG animation)\n    dur1 = 6 + rng() * 5\n    dur2 = 8 + rng() * 6\n    parts.append(\n        f'<g opacity=\"0.35\"><ellipse cx=\"{W/2}\" cy=\"{H/2}\" rx=\"{55+rng()*15:.0f}\" '\n        f'ry=\"{40+rng()*15:.0f}\" fill=\"{cols[1]}\">'\n        f'<animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 80 80\" '\n        f'to=\"360 80 80\" dur=\"{dur1:.1f}s\" repeatCount=\"indefinite\"/></ellipse></g>')\n    parts.append(\n        f'<g opacity=\"0.25\"><ellipse cx=\"{W/2}\" cy=\"{H/2}\" rx=\"{30+rng()*12:.0f}\" '\n        f'ry=\"{24+rng()*10:.0f}\" fill=\"{cols[2]}\">'\n        f'<animateTransform attributeName=\"transform\" type=\"rotate\" from=\"360 80 80\" '\n        f'to=\"0 80 80\" dur=\"{dur2:.1f}s\" repeatCount=\"indefinite\"/></ellipse></g>')\n    # motif layer\n    shapes = _motif_shapes(motif, rng, cols, W, H)\n    parts.append(shapes)\n    # portrait frame (presentation glass): frame style varies per persona\n    if frame == \"arc\":\n        parts.append(f'<path d=\"M14 {H-14} A {W-14} {H-14} 0 0 1 {W-14} 14\" fill=\"none\" '\n                     f'stroke=\"{cols[3]}\" stroke-width=\"4\"/>')\n    elif frame == \"square\":\n        parts.append(f'<rect x=\"6\" y=\"6\" width=\"{W-12}\" height=\"{H-12}\" rx=\"10\" '\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"3\" '\n                     f'stroke-dasharray=\"{8+int(rng()*8)} {4+int(rng()*6)}\"/>')\n    elif frame == \"notch\":\n        parts.append(f'<rect x=\"6\" y=\"6\" width=\"{W-12}\" height=\"{H-12}\" rx=\"10\" '\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"2\"/>'\n                     f'<rect x=\"2\" y=\"{H/2-14}\" width=\"8\" height=\"28\" fill=\"{cols[3]}\"/>')\n    else:\n        parts.append(f'<rect x=\"5\" y=\"5\" width=\"{W-10}\" height=\"{H-10}\" rx=\"12\" '\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"2\"/>'\n                     f'<rect x=\"11\" y=\"11\" width=\"{W-22}\" height=\"{H-22}\" rx=\"9\" '\n                     f'fill=\"none\" stroke=\"{cols[3]}\" stroke-width=\"1\" opacity=\"0.6\"/>')\n    # permanent imitation mark (prompt §Personalities): corner diamond, always present\n    if persona.get(\"imitates\"):\n        parts.append('<polygon points=\"132,8 148,24 132,40 116,24\" fill=\"#ffbf00\" '\n                     'stroke=\"#000\" stroke-width=\"1.5\"/>'\n                     '<text x=\"132\" y=\"28\" font-size=\"9\" text-anchor=\"middle\" '\n                     'font-family=\"monospace\" fill=\"#000\">IM</text>')\n    # initial monogram\n    parts.append(f'<text x=\"{W/2}\" y=\"{H/2+16}\" font-size=\"46\" text-anchor=\"middle\" '\n                 f'font-family=\"Georgia, serif\" fill=\"#fff\" opacity=\"0.92\">'\n                 f'{persona.get(\"name\", \"?\")[0].upper()}</text>')\n    svg = (f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {W} {H}\">'\n           + \"\".join(parts) + \"</svg>\")\n    artifact = None\n    if out_dir:\n        os.makedirs(out_dir, exist_ok=True)\n        artifact = os.path.join(out_dir, f\"persona-{persona['id']}.svg\")\n        with open(artifact, \"w\", encoding=\"utf-8\") as f:\n            f.write(svg)\n    rec = {\"seed\": seed, \"motif\": motif, \"palette\": cols, \"frame\": frame,\n           \"artifact\": artifact, \"ambient\": True,\n           \"engine\": \"inproc-svg-glass\"}\n    if ctx is not None:\n        prev = ctx.ledger.query(subject=f\"persona:{persona['id']}\",\n                                predicate=\"persona:art\")\n        ctx.append(f\"persona:{persona['id']}\", \"persona:art\", rec,\n                   \"engine:portrait\", basis={\"kind\": \"execution\"},\n                   supersedes=prev[-1].id if prev else None)\n    rec[\"svg\"] = svg\n    rec[\"dataUrl\"] = \"data:image/svg+xml;base64,\" + base64.b64encode(svg.encode()).decode()\n    return rec\n\n\ndef _motif_shapes(motif: str, rng, cols: list, W: int, H: int) -> str:\n    c = cols[2]\n    c2 = cols[3]\n    out = []\n    cx, cy = W / 2, H / 2\n    if motif == \"orbits\":\n        for i in range(2 + int(rng() * 3)):\n            rx, ry = 22 + i * (8 + rng() * 6), 14 + i * (6 + rng() * 5)\n            rot = rng() * 360\n            out.append(f'<ellipse cx=\"{cx}\" cy=\"{cy}\" rx=\"{rx:.0f}\" ry=\"{ry:.0f}\" '\n                       f'fill=\"none\" stroke=\"{c}\" stroke-width=\"1.4\" opacity=\"0.8\" '\n                       f'transform=\"rotate({rot:.0f} {cx} {cy})\"/>')\n        out.append(f'<circle cx=\"{cx+18}\" cy=\"{cy-12}\" r=\"4\" fill=\"{c2}\"/>')\n    elif motif == \"strata\":\n        y = 30\n        while y < H - 20:\n            h = 5 + rng() * 10\n            out.append(f'<path d=\"M8 {y:.0f} Q {cx} {y-8+rng()*16:.0f} {W-8} {y:.0f} '\n                       f'L {W-8} {y+h:.0f} Q {cx} {y+h-8+rng()*16:.0f} 8 {y+h:.0f} Z\" '\n                       f'fill=\"{c}\" opacity=\"{0.25+rng()*0.3:.2f}\"/>')\n            y += h + 4 + rng() * 8\n    elif motif == \"prism\":\n        for i in range(3):\n            x = 30 + i * 30 + rng() * 10\n            out.append(f'<polygon points=\"{x:.0f},110 {x+22:.0f},110 {x+11:.0f},'\n                       f'{52+rng()*20:.0f}\" fill=\"{c}\" opacity=\"{0.3+i*0.18:.2f}\"/>')\n        out.append(f'<path d=\"M20 40 L 140 120\" stroke=\"{c2}\" stroke-width=\"1.5\" opacity=\"0.7\"/>')\n    elif motif == \"glyphs\":\n        chars = \"ᚠᚢᚦᚨᚱᚲᚷᚹᚺᚾᛁᛃᛇᛈᛉᛊᛏᛒᛖᛗᛚᛜᛞᛟ\"\n        for i in range(5):\n            x, y = 24 + i * 26, 60 + (i % 2) * 34\n            ch = chars[int(rng() * len(chars))]\n            out.append(f'<text x=\"{x}\" y=\"{y}\" font-size=\"{18+rng()*10:.0f}\" '\n                       f'fill=\"{c}\" opacity=\"0.85\">{ch}</text>')\n    elif motif == \"tide\":\n        for i in range(3 + int(rng() * 2)):\n            y = 45 + i * 18\n            out.append(f'<path d=\"M6 {y} q 20 {-8-rng()*8:.0f} 40 0 t 40 0 t 40 0 t 40 0\" '\n                       f'fill=\"none\" stroke=\"{c}\" stroke-width=\"2.4\" opacity=\"{0.5+rng()*0.3:.2f}\"/>')\n    elif motif == \"circuit\":\n        nodes = [(20 + rng() * 120, 25 + rng() * 110) for _ in range(5)]\n        for i in range(len(nodes) - 1):\n            x1, y1 = nodes[i]; x2, y2 = nodes[i + 1]\n            out.append(f'<path d=\"M{x1:.0f} {y1:.0f} L{x1:.0f} {y2:.0f} L{x2:.0f} {y2:.0f}\" '\n                       f'fill=\"none\" stroke=\"{c}\" stroke-width=\"1.6\" opacity=\"0.7\"/>')\n        for x, y in nodes:\n            out.append(f'<circle cx=\"{x:.0f}\" cy=\"{y:.0f}\" r=\"3.4\" fill=\"{c2}\"/>')\n    elif motif == \"garden\":\n        for i in range(3 + int(rng() * 2)):\n            x = 35 + i * 30 + rng() * 8\n            out.append(f'<path d=\"M{x:.0f} 125 v {-30-rng()*25:.0f}\" stroke=\"{c}\" '\n                       f'stroke-width=\"2.6\" fill=\"none\"/>'\n                       f'<ellipse cx=\"{x:.0f}\" cy=\"{88-rng()*20:.0f}\" rx=\"{6+rng()*5:.0f}\" '\n                       f'ry=\"{9+rng()*6:.0f}\" fill=\"{c2}\" opacity=\"0.8\"/>')\n    else:  # halo\n        for i in range(3):\n            r = 18 + i * (10 + rng() * 6)\n            out.append(f'<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r:.0f}\" fill=\"none\" '\n                       f'stroke=\"{c}\" stroke-width=\"{2.4-i*0.6:.1f}\" '\n                       f'opacity=\"{0.85-i*0.2:.2f}\" stroke-dasharray=\"{r*4:.0f} {r:.0f}\"/>')\n    return \"\".join(out)\n\"\"\"Calendar temporal reasoning (prompt §Projects and temporal context — F2).\n\nCalendar entries remain source evidence; this module computes the temporal\nview the prompt requires to *inform* project work, persona responses, and\nbackground attention:\n\n- upcoming / current / recent interpretation of calendar:event evidence\n- project linkage: open projects matched to events by criteria tokens, and\n  project deadlines (project:due) compared against the horizon\n- steward attention: temporal findings become offers presented through a\n  personality (the background-attention channel)\n- persona composition: respondents whose lens touches time/calendar are given\n  the live temporal context so their replies can cite it\n\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom typing import Optional\n\nfrom .model import now_ms\n\nDAY = 86400000\n\n\ndef events(ctx) -> list[dict]:\n    out = []\n    for a in ctx.ledger.query(predicate=\"calendar:event\"):\n        v = dict(a.value[\"v\"])\n        v[\"assertionId\"] = a.id\n        out.append(v)\n    out.sort(key=lambda e: e.get(\"startMs\", 0))\n    return out\n\n\ndef temporal_context(ctx, now: Optional[int] = None,\n                     horizon_ms: int = 7 * DAY) -> dict:\n    \"\"\"Interpret calendar evidence into upcoming/current/recent classes.\"\"\"\n    now = now or now_ms()\n    upcoming, current, recent = [], [], []\n    for e in events(ctx):\n        s, en = e.get(\"startMs\", 0), e.get(\"endMs\", 0) or e.get(\"startMs\", 0)\n        if s <= now <= (en or s + 3600000):\n            current.append(e)\n        elif now < s <= now + horizon_ms:\n            upcoming.append(e)\n        elif en and now - en <= horizon_ms:\n            recent.append(e)\n    return {\"now\": now, \"horizonMs\": horizon_ms,\n            \"current\": current, \"upcoming\": upcoming, \"recent\": recent,\n            \"count\": {\"current\": len(current), \"upcoming\": len(upcoming),\n                      \"recent\": len(recent)}}\n\n\ndef _tokens(text: str) -> set:\n    return set(re.findall(r\"[a-z0-9']+\", (text or \"\").lower()))\n\n\ndef linkable(ctx, project: dict, window_ms: int = 30 * DAY) -> list[dict]:\n    \"\"\"Events related to a project's title/goals by token overlap, within a\n    bounded window around now.\"\"\"\n    now = now_ms()\n    ptoks = _tokens((project.get(\"title\") or \"\") + \" \" +\n                    \" \".join(g.get(\"text\", g) if isinstance(g, dict) else str(g)\n                             for g in (project.get(\"goals\") or [])))\n    ptoks -= {\"a\", \"the\", \"to\", \"of\", \"in\", \"for\", \"and\", \"project\"}\n    hits = []\n    for e in events(ctx):\n        if not ptoks:\n            break\n        s = e.get(\"startMs\", 0)\n        if abs(s - now) > window_ms:\n            continue\n        etoks = _tokens(e.get(\"title\", \"\"))\n        if ptoks & etoks:\n            hits.append({**e, \"matched\": sorted(ptoks & etoks)})\n    return hits\n\n\ndef note_for_persona(ctx, persona: dict, user_text: str) -> Optional[str]:\n    \"\"\"A persona-level temporal note when the persona's lens touches time or\n    the user asks about schedule/upcoming events.\"\"\"\n    text_toks = _tokens(user_text)\n    lens_toks = set()\n    for k in (persona.get(\"interests\") or []) + (persona.get(\"traits\") or []):\n        lens_toks |= _tokens(k)\n    resp = (persona.get(\"lens\") or {}).get(\"responsibilities\") or []\n    for r in resp:\n        lens_toks |= _tokens(r)\n    temporal_lens = bool(lens_toks & {\"calendar\", \"time\", \"schedule\", \"temporal\",\n                                      \"attention\", \"deadline\", \"reminder\",\n                                      \"notifications\", \"stewardship\"})\n    temporal_ask = bool(text_toks & {\"when\", \"calendar\", \"schedule\", \"upcoming\",\n                                     \"today\", \"tomorrow\", \"deadline\", \"week\",\n                                     \"soon\", \"date\", \"remind\"})\n    if not (temporal_lens or temporal_ask):\n        return None\n    ctxv = temporal_context(ctx, horizon_ms=3 * DAY)\n    if not (ctxv[\"current\"] or ctxv[\"upcoming\"]):\n        return None\n    bits = [f\"{e['title']} ({_fmt(e.get('startMs'))})\" for e in\n            (ctxv[\"current\"] + ctxv[\"upcoming\"])[:3]]\n    note = \"Temporal context from the ledger calendar: \" + \"; \".join(bits)\n    ctx.append(f\"persona:{persona['id']}\", \"persona:temporal-note\",\n               {\"note\": note, \"events\": [e[\"assertionId\"] for e in\n                                         (ctxv[\"current\"] + ctxv[\"upcoming\"])[:3]]},\n               \"system\", basis={\"kind\": \"interpretation\"})\n    return note\n\n\ndef _fmt(ms: int) -> str:\n    import datetime as dt\n    if not ms:\n        return \"?\"\n    return dt.datetime.fromtimestamp(ms / 1000).strftime(\"%Y-%m-%d %H:%M\")\n\n\ndef steward_attention(ctx) -> dict:\n    \"\"\"Background-attention duty: interpret the calendar into findings and\n    present the relevant ones through a distinct personality (prompt §Background\n    activity and attention; demo 6 channel).\"\"\"\n    ctxv = temporal_context(ctx, horizon_ms=72 * 3600 * 1000)\n    findings = []\n    # (a) upcoming/current events the user should hear about\n    for e in (ctxv[\"current\"] + ctxv[\"upcoming\"])[:5]:\n        findings.append({\"kind\": \"calendar\", \"event\": e})\n    # (b) projects with deadlines inside the horizon, or linked events coming due\n    for pa in ctx.ledger.query(predicate=\"project:exists\"):\n        pid = pa.subjectKey.split(\":\", 1)[1]\n        subj = pa.subjectKey\n        due_rows = ctx.ledger.query(subject=subj, predicate=\"project:due\")\n        due = due_rows[-1].value[\"v\"] if due_rows else None\n        if due and now_ms() <= due <= now_ms() + 72 * 3600 * 1000:\n            findings.append({\"kind\": \"project-due\", \"projectId\": pid,\n                             \"title\": pa.value[\"v\"].get(\"title\"), \"dueMs\": due})\n        proj = {\"title\": pa.value[\"v\"].get(\"title\"), \"goals\":\n                [r.value[\"v\"] for r in ctx.ledger.query(subject=subj,\n                                                      predicate=\"project:goal\")]}\n        for hit in linkable(ctx, proj, window_ms=14 * DAY):\n            already = [r for r in ctx.ledger.query(subject=subj,\n                                                   predicate=\"calendar:linked\")\n                       if r.value[\"v\"] == hit[\"assertionId\"]]\n            if not already:\n                ctx.append(subj, \"calendar:linked\", hit[\"assertionId\"],\n                           \"steward:main\", certainty=0.8,\n                           basis={\"kind\": \"interpretation\"},\n                           relates=[hit[\"assertionId\"]])\n                findings.append({\"kind\": \"project-event-link\",\n                                 \"projectId\": pid, \"title\": proj[\"title\"],\n                                 \"event\": hit})\n    ctx.append(\"temporal\", \"temporal:attention\",\n               {\"findings\": findings, \"contextCount\": ctxv[\"count\"]},\n               \"steward:main\", basis={\"kind\": \"execution\"})\n    return {\"findings\": findings, \"context\": ctxv[\"count\"]}\n\n\ndef present_attention(ctx, findings: list) -> Optional[dict]:\n    \"\"\"Offer the steward's temporal findings to a persona whose lens fits —\n    completed background work surfaced as a relevant result (demo 6).\"\"\"\n    if not findings:\n        return None\n    roster = ctx.personas.roster()\n    if not roster:\n        return None\n    # pick the persona whose interests/responsibilities overlap time/attention\n    best, best_n = None, -1\n    for p in roster:\n        toks = set()\n        for k in (p.get(\"interests\") or []) + (p.get(\"traits\") or []):\n            toks |= _tokens(k)\n        for r in (p.get(\"lens\") or {}).get(\"responsibilities\") or []:\n            toks |= _tokens(r)\n        n = len(toks & {\"calendar\", \"time\", \"attention\", \"stewardship\",\n                        \"temporal\", \"opportunities\", \"notifications\", \"schedule\"})\n        if n > best_n:\n            best, best_n = p, n\n    p = best or roster[0]\n    lines = []\n    for f in findings[:4]:\n        if f[\"kind\"] == \"calendar\":\n            lines.append(f\"event: {f['event'].get('title')} at {_fmt(f['event'].get('startMs'))}\")\n        elif f[\"kind\"] == \"project-due\":\n            lines.append(f\"project '{f['title']}' is due at {_fmt(f['dueMs'])}\")\n        else:\n            lines.append(f\"project '{f['title']}' relates to event \"\n                         f\"'{f['event'].get('title')}' at {_fmt(f['event'].get('startMs'))}\")\n    text = (\"Stewardship pass — temporal attention: \" + \"; \".join(lines) +\n            \". Evidence is in the ledger (calendar:event, project:due, calendar:linked).\")\n    card = ctx.invoke(\"persona.speak\",\n                      {\"personaId\": p[\"id\"], \"text\": text,\n                       \"cause\": \"stewardship-temporal\", \"engine\": \"temporal\"})\n    return {\"persona\": p[\"name\"], \"text\": text, \"card\": card.get(\"result\")}"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","terminal_exit":{"terminal_id":"2f8cc7","exit_code":0,"signal":null}}}}}
