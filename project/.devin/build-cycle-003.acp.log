{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#a31c4fce103b452a86c2af59f2cf4cca","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Launch verification probe. Boots a second Meridian instance on port 9761\nwith an isolated runtime dir, polls the API, proves the steward runs while the\nserver answers, and writes evidence/launch/probe-<ts>.json.\n\nUsage: python scripts/probe.py\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nimport urllib.request\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n\n\ndef get(url, timeout=3.0):\n    with urllib.request.urlopen(url, timeout=timeout) as r:\n        return json.loads(r.read().decode())\n\n\ndef main():\n    runtime = os.path.join(ROOT, \"runtime\", \"probe\")\n    os.makedirs(runtime, exist_ok=True)\n    proc = subprocess.Popen(\n        [sys.executable, \"-m\", \"app\", \"--port\", \"9761\",\n         \"--runtime\", runtime],\n        cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n        text=True)\n    out = {\"launched\": False, \"checks\": {}, \"ok\": False}\n    try:\n        # wait for serve\n        base = \"http://127.0.0.1:9761\"\n        for _ in range(60):\n            try:\n                get(base + \"/api/honesty\", timeout=3.0)\n                out[\"launched\"] = True\n                break\n            except Exception:\n                time.sleep(0.5)\n        if not out[\"launched\"]:\n            print(\"FAIL: server did not come up\")\n            return out\n        st = get(base + \"/api/state\")\n        out[\"checks\"][\"state.roster\"] = len(st.get(\"roster\", []))\n        out[\"checks\"][\"state.tools\"] = len(st.get(\"tools\", []))\n        out[\"checks\"][\"honesty.ledger.durable\"] = st[\"honesty\"][\"ledger\"][\"durable\"]\n        out[\"checks\"][\"engine.llm.mode\"] = st[\"honesty\"][\"engines\"][\"llm\"][\"mode\"]"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
