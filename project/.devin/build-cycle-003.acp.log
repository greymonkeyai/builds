{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:1#7808ae9fb0824659b8d1d179392c4c6d","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Unfulfilled requirements (needs) — operational ledger assertions.\n\nA need is created with missing, partial, or competing candidates; creation\ndoes not imply execution. A need remains Open until its declared satisfaction\nconditions are met, or it is Cancelled or Superseded. Refinement is expressed\nthrough related assertions, never by rewriting the requirement.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Optional\n\nfrom .model import new_id, now_ms\n\n\ndef need_subject(nid: str) -> str:"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:1#7808ae9fb0824659b8d1d179392c4c6d","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Unfulfilled requirements (needs) — operational ledger assertions.\n\nA need is created with missing, partial, or competing candidates; creation\ndoes not imply execution. A need remains Open until its declared satisfaction\nconditions are met, or it is Cancelled or Superseded. Refinement is expressed\nthrough related assertions, never by rewriting the requirement.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Optional\n\nfrom .model import new_id, now_ms\n\n\ndef need_subject(nid: str) -> str:\n    return f\"need:{nid}\"\n\n\ndef open_need(ctx, kind: str, spec: dict, claimant: str = \"system\",\n              relates: Optional[list] = None, certainty: float = 1.0) -> str:\n    \"\"\"Create an unfulfilled requirement. spec: {summary, template?, slots?,\n    satisfaction, toolId?, project?, deferred?}.\"\"\"\n    nid = new_id(\"need\")\n    ctx.append(need_subject(nid), \"need:open\",\n               {\"kind\": kind, \"status\": \"open\", \"spec\": spec, \"openedAt\": now_ms()},\n               claimant, certainty=certainty,\n               basis={\"kind\": \"interpretation\"}, relates=relates or [])\n    return nid\n\n\ndef add_candidate(ctx, nid: str, slot: str, value, confidence: float,\n                  source: str, claimant: str = \"system\") -> str:\n    a = ctx.append(need_subject(nid), \"need:candidate\",\n                   {\"slot\": slot, \"value\": value, \"confidence\": confidence,\n                    \"source\": source},\n                   claimant, certainty=confidence,\n                   basis={\"kind\": \"source-evidence\", \"ref\": source})\n    return a.id\n\n\ndef refine_need(ctx, nid: str, note: str, claimant: str = \"principal\",\n                extra: Optional[dict] = None) -> str:\n    \"\"\"Refine an existing requirement's criteria via a related assertion.\"\"\"\n    v = {\"note\": note}\n    if extra:\n        v.update(extra)\n    return ctx.append(need_subject(nid), \"need:refined\", v, claimant,\n                      basis={\"kind\": \"user-choice\"}).id\n\n\n\u001b[0m[... 179 lines omitted ...]\n                   source_conf: float = 1.0) -> dict:\n        feats = self.tool_features(tool, text, slots_ready, source_conf)\n        w = self.weights(\"tool\")\n        score = sum(feats[f] * w[f] for f in self.TOOL_FEATURES)\n        return {\"toolId\": tool[\"id\"], \"score\": round(score, 4),\n                \"features\": feats, \"weights\": w}\n\n    def rank_tools(self, text: str, kind_filter: Optional[str] = None,\n                   trace: bool = True) -> list[dict]:\n        cands = []\n        for t in self.ctx.registry.tools():\n            if kind_filter and t.get(\"lane\") != kind_filter:\n                continue\n            cands.append(self.score_tool(t, text))\n        cands.sort(key=lambda c: c[\"score\"], reverse=True)\n        if trace:\n            self.ctx.append(\"decision:tool\", \"decision:score\",\n                            {\"input\": text[:200],\n                             \"ranking\": [{\"toolId\": c[\"toolId\"], \"score\": c[\"score\"]}\n                                         for c in cands[:8]],\n                             \"top\": cands[0] if cands else None},\n                            \"model:decision\", certainty=0.9,\n                            basis={\"kind\": \"interpretation\"})\n        return cands\n\n    # ---- persona (respondent) scoring ----\n\n    def rank_personas(self, personas: list[dict], text: str,\n                      topic_links: Optional[dict] = None,\n                      trace: bool = True) -> list[dict]:\n        toks = _tokens(text)\n        w = self.weights(\"persona\")\n        out = []\n        for p in personas:\n            lens = set()\n            for k in (p.get(\"interests\") or []) + (p.get(\"traits\") or []):\n                lens |= _tokens(k)\n            f_lens = _jaccard(toks, lens)\n            f_topic = float((topic_links or {}).get(p[\"id\"], 0.0))\n            f_conf = float(p.get(\"confidence\", 0.8))\n            f_prio = float(p.get(\"rosterPriority\", 0.5))\n            feats = {\"lens_overlap\": round(f_lens, 4), \"topic_link\": f_topic,\n                     \"confidence\": f_conf, \"priority\": f_prio}\n            score = sum(feats[f] * w[f] for f in self.PERSONA_FEATURES)\n            out.append({\"personaId\": p[\"id\"], \"score\": round(score, 4),\n                        \"features\": feats})\n        out.sort(key=lambda c: c[\"score\"], reverse=True)\n        if trace:\n            self.ctx.append(\"decision:persona\", \"decision:respondent\",\n                            {\"input\": text[:200], \"ranking\": out}, \"model:decision\",\n                            certainty=0.9, basis={\"kind\": \"interpretation\"})\n        return out\n\n    # ---- outcome feedback / trust churn ----\n\n    def success_rate(self, tool_id: str) -> float:\n        rows = self.ctx.ledger.query(subject=f\"tool:{tool_id}\",\n                                     predicate=\"tool:telemetry\", limit=20)\n        if not rows:\n            return 0.5\n        ok = sum(1 for r in rows if r.value[\"v\"].get(\"status\") == \"ok\")\n        return ok / len(rows)\n\n    def _last_success(self, tool_id: str) -> int:\n        rows = [r for r in self.ctx.ledger.query(\n            subject=f\"tool:{tool_id}\", predicate=\"tool:telemetry\", limit=40)\n            if r.value[\"v\"].get(\"status\") == \"ok\"]\n        return rows[-1].at if rows else 0\n\n    def rank_multiplier(self, tool_id: str) -> float:\n        rows = self.ctx.ledger.query(subject=f\"tool:{tool_id}\",\n                                     predicate=\"tool:rank-adjustment\")\n        if not rows:\n            return 1.0\n        return max(self.RANK_FLOOR, min(self.RANK_CEIL,\n                                        float(rows[-1].value[\"v\"][\"multiplier\"])))\n\n    def record_outcome(self, tool_id: str, need_id: Optional[str],\n                       ok: bool, adequate: bool):\n        \"\"\"Churn: inadequate/failed results lower rank among alternatives; the\n        tool stays eligible (multiplier bounded, never removed).\"\"\"\n        cur = self.rank_multiplier(tool_id)\n        if ok and adequate:\n            new = min(self.RANK_CEIL, cur * 1.05)\n            if new > cur:\n                self.ctx.append(f\"tool:{tool_id}\", \"tool:rank-adjustment\",\n                                {\"multiplier\": round(new, 4), \"reason\": \"success-recovery\",\n                                 \"needId\": need_id}, \"model:decision\",\n                                basis={\"kind\": \"execution\"})\n        else:\n            new = max(self.RANK_FLOOR, cur * 0.9)\n            self.ctx.append(f\"tool:{tool_id}\", \"tool:rank-adjustment\",\n                            {\"multiplier\": round(new, 4),\n                             \"reason\": \"insufficient-result\" if ok else \"failure\",\n                             \"needId\": need_id}, \"model:decision\",\n                            basis={\"kind\": \"execution\"})\n            self.ctx.append(\"decision:churn\", \"decision:churn\",\n                            {\"toolId\": tool_id, \"needId\": need_id,\n                             \"from\": cur, \"to\": round(new, 4)},\n                            \"model:decision\", basis={\"kind\": \"execution\"})"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:1#7808ae9fb0824659b8d1d179392c4c6d","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Unfulfilled requirements (needs) — operational ledger assertions.\n\nA need is created with missing, partial, or competing candidates; creation\ndoes not imply execution. A need remains Open until its declared satisfaction\nconditions are met, or it is Cancelled or Superseded. Refinement is expressed\nthrough related assertions, never by rewriting the requirement.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Optional\n\nfrom .model import new_id, now_ms\n\n\ndef need_subject(nid: str) -> str:\n    return f\"need:{nid}\"\n\n\ndef open_need(ctx, kind: str, spec: dict, claimant: str = \"system\",\n              relates: Optional[list] = None, certainty: float = 1.0) -> str:\n    \"\"\"Create an unfulfilled requirement. spec: {summary, template?, slots?,\n    satisfaction, toolId?, project?, deferred?}.\"\"\"\n    nid = new_id(\"need\")\n    ctx.append(need_subject(nid), \"need:open\",\n               {\"kind\": kind, \"status\": \"open\", \"spec\": spec, \"openedAt\": now_ms()},\n               claimant, certainty=certainty,\n               basis={\"kind\": \"interpretation\"}, relates=relates or [])\n    return nid\n\n\ndef add_candidate(ctx, nid: str, slot: str, value, confidence: float,\n                  source: str, claimant: str = \"system\") -> str:\n    a = ctx.append(need_subject(nid), \"need:candidate\",\n                   {\"slot\": slot, \"value\": value, \"confidence\": confidence,\n                    \"source\": source},\n                   claimant, certainty=confidence,\n                   basis={\"kind\": \"source-evidence\", \"ref\": source})\n    return a.id\n\n\ndef refine_need(ctx, nid: str, note: str, claimant: str = \"principal\",\n                extra: Optional[dict] = None) -> str:\n    \"\"\"Refine an existing requirement's criteria via a related assertion.\"\"\"\n    v = {\"note\": note}\n    if extra:\n        v.update(extra)\n    return ctx.append(need_subject(nid), \"need:refined\", v, claimant,\n                      basis={\"kind\": \"user-choice\"}).id\n\n\ndef defer_need(ctx, nid: str, reason: str, missing: list,\n               claimant: str = \"system\") -> str:\n    return ctx.append(need_subject(nid), \"need:deferred\",\n                      {\"reason\": reason, \"missing\": missing}, claimant,\n                      basis={\"kind\": \"execution\"}).id\n\n\ndef close_need(ctx, nid: str, outcome: str, detail: dict,\n               claimant: str = \"system\") -> Optional[str]:\n    \"\"\"Close a need: outcome in fulfilled|cancelled|superseded. Supersedes the\n    open row; the need leaves the floor.\"\"\"\n    open_row = _open_row(ctx, nid)\n    pred = {\"fulfilled\": \"need:fulfilled\", \"cancelled\": \"need:cancelled\",\n            \"superseded\": \"need:superseded\"}.get(outcome)\n    if not pred:\n        raise ValueError(f\"bad outcome: {outcome}\")\n    a = ctx.append(need_subject(nid), pred,\n                   {\"status\": outcome, \"detail\": detail, \"closedAt\": now_ms()},\n                   claimant, basis={\"kind\": \"durable-result\"},\n                   supersedes=open_row.id if open_row else None)\n    return a.id\n\n\ndef _open_row(ctx, nid: str):\n    rows = ctx.ledger.query(subject=need_subject(nid), predicate=\"need:open\")\n    return rows[-1] if rows else None\n\n\ndef is_open(ctx, nid: str) -> bool:\n    return _open_row(ctx, nid) is not None\n\n\ndef open_needs(ctx, kind: Optional[str] = None) -> list[dict]:\n    \"\"\"All live open needs on the floor.\"\"\"\n    out = []\n    for a in ctx.ledger.query(predicate=\"need:open\"):\n        nid = a.subjectKey.split(\":\", 1)[1]\n        spec = a.value[\"v\"].get(\"spec\", {})\n        k = a.value[\"v\"].get(\"kind\")\n        if kind and k != kind:\n            continue\n        out.append({\"id\": nid, \"kind\": k, \"spec\": spec,\n                    \"openedAt\": a.value[\"v\"].get(\"openedAt\"),\n                    \"claimant\": a.claimant, \"assertionId\": a.id})\n    return out\n\n\ndef candidates(ctx, nid: str) -> dict[str, list[dict]]:\n    \"\"\"Slot -> candidate list (inspectable: value, source, confidence).\"\"\"\n    out: dict[str, list[dict]] = {}\n    for a in ctx.ledger.query(subject=need_subject(nid), predicate=\"need:candidate\"):\n        v = a.value[\"v\"]\n        eff = ctx.ledger.effective_confidence(a)\n        out.setdefault(v[\"slot\"], []).append(\n            {\"value\": v[\"value\"], \"confidence\": v[\"confidence\"], \"source\": v[\"source\"],\n             \"effectiveConfidence\": round(eff, 4), \"assertionId\": a.id, \"at\": a.at})\n    for lst in out.values():\n        lst.sort(key=lambda c: (c[\"effectiveConfidence\"], c[\"at\"]), reverse=True)\n    return out\n\n\ndef need_state(ctx, nid: str) -> dict:\n    subj = need_subject(nid)\n    status = \"open\"\n    detail = {}\n    for pred, st in ((\"need:fulfilled\", \"fulfilled\"),\n                     (\"need:cancelled\", \"cancelled\"),\n                     (\"need:superseded\", \"superseded\")):\n        rows = ctx.ledger.query(subject=subj, predicate=pred)\n        if rows:\n            status, detail = st, rows[-1].value[\"v\"].get(\"detail\", {})\n    open_row = _open_row(ctx, nid)\n    spec = open_row.value[\"v\"].get(\"spec\", {}) if open_row else {}\n    deferrals = [r.value[\"v\"] for r in\n                 ctx.ledger.query(subject=subj, predicate=\"need:deferred\")]\n    refinements = [r.value[\"v\"] for r in\n                   ctx.ledger.query(subject=subj, predicate=\"need:refined\")]\n    return {\"id\": nid, \"status\": status, \"spec\": spec, \"detail\": detail,\n            \"candidates\": candidates(ctx, nid),\n            \"deferred\": deferrals[-1] if deferrals else None,\n            \"refinements\": refinements}\n\"\"\"Bounded decision model for routing and evaluation (shortcoming A9).\n\nGreyAvatar routed intent with regex-only deterministic matching. Meridian adds\na bounded parametric model: a fixed feature vector per candidate, scored by a\nweighted sum whose weights live in the ledger as configurable assertions.\nBounded means: fixed feature count, O(#candidates x #features) per decision,\nno unbounded inference, deterministic given the ledger, and fully inspectable\nthrough routing:decision-trace rows.\n\nTool-trust churn (A5 / D-ToolTrustChurn): an insufficient, failed, stale,\nconflicting, or malformed result lowers a tool's rank multiplier among\nalternatives — bounded in [0.1, 1.0] — without crossing confidence thresholds\nor making the tool ineligible. Successes recover the multiplier gradually.\n\"\"\"\nfrom __future__ import annotations\n\nimport math\nimport re\nimport time\nfrom typing import Optional\n\nTOKEN = re.compile(r\"[a-z0-9']+\")\n\n\ndef _tokens(text: str) -> set[str]:\n    return set(TOKEN.findall((text or \"\").lower()))\n\n\ndef _jaccard(a: set, b: set) -> float:\n    if not a or not b:\n        return 0.0\n    return len(a & b) / len(a | b)\n\n\nclass DecisionModel:\n    TOOL_FEATURES = [\"keyword\", \"pattern\", \"slot_fill\", \"success_rate\",\n                     \"rank_mult\", \"recency\", \"source_conf\"]\n    DEFAULT_TOOL_WEIGHTS = {\"keyword\": 0.28, \"pattern\": 0.30, \"slot_fill\": 0.12,\n                            \"success_rate\": 0.10, \"rank_mult\": 0.14,\n                            \"recency\": 0.03, \"source_conf\": 0.03}\n    PERSONA_FEATURES = [\"lens_overlap\", \"topic_link\", \"confidence\", \"priority\"]\n    DEFAULT_PERSONA_WEIGHTS = {\"lens_overlap\": 0.40, \"topic_link\": 0.25,\n                               \"confidence\": 0.20, \"priority\": 0.15}\n    RANK_FLOOR, RANK_CEIL = 0.1, 1.0\n\n    def __init__(self, ctx):\n        self.ctx = ctx\n\n    # ---- weights (configurable, ledger-resident) ----\n\n    def weights(self, kind: str = \"tool\") -> dict:\n        rows = self.ctx.ledger.query(subject=f\"decision:{kind}\",\n                                     predicate=\"decision:weights\")\n        if rows:\n            w = dict(rows[-1].value[\"v\"])\n            base = self.DEFAULT_TOOL_WEIGHTS if kind == \"tool\" else self.DEFAULT_PERSONA_WEIGHTS\n            base.update({k: float(v) for k, v in w.items() if k in base})\n            return base\n        return dict(self.DEFAULT_TOOL_WEIGHTS if kind == \"tool\"\n                    else self.DEFAULT_PERSONA_WEIGHTS)\n\n    def set_weights(self, kind: str, w: dict, claimant: str = \"principal\"):\n        self.ctx.append(f\"decision:{kind}\", \"decision:weights\", w, claimant,\n                        basis={\"kind\": \"config\"})\n\n    # ---- tool scoring ----\n\n    def tool_features(self, tool: dict, text: str, slots_ready: float,\n                      source_conf: float) -> dict:\n        toks = _tokens(text)\n        kw = set()\n        for k in (tool.get(\"triggers\", {}).get(\"keywords\") or []):\n            kw |= _tokens(k)\n        f_keyword = _jaccard(toks, kw) if kw else 0.0\n        if kw and kw <= toks:\n            f_keyword = max(f_keyword, 0.9)  # full keyword cover\n        f_pattern = 0.0\n        for p in (tool.get(\"triggers\", {}).get(\"patterns\") or []):\n            if re.search(p, text or \"\", re.I):\n                f_pattern = 1.0\n                break\n        # durable intent overrides authored by the user count as pattern signal\n        for a in self.ctx.ledger.query(predicate=\"routing:intent-override\"):\n            v = a.value[\"v\"]\n            if v.get(\"toolId\") == tool[\"id\"] and re.search(\n                    v.get(\"pattern\", r\"$^\"), text or \"\", re.I):\n                f_pattern = max(f_pattern, float(v.get(\"confidence\", 0.95)))\n        f_slot = max(0.0, min(1.0, slots_ready))\n        f_success = self.success_rate(tool[\"id\"])\n        f_rank = self.rank_multiplier(tool[\"id\"])\n        last = self._last_success(tool[\"id\"])\n        f_recency = math.exp(-(time.time() * 1000 - last) / 8.64e7) if last else 0.0\n        return {\"keyword\": round(f_keyword, 4), \"pattern\": f_pattern,\n                \"slot_fill\": round(f_slot, 4), \"success_rate\": round(f_success, 4),\n                \"rank_mult\": round(f_rank, 4), \"recency\": round(f_recency, 4),\n                \"source_conf\": round(source_conf, 4)}\n\n    def score_tool(self, tool: dict, text: str, slots_ready: float = 1.0,\n                   source_conf: float = 1.0) -> dict:\n        feats = self.tool_features(tool, text, slots_ready, source_conf)\n        w = self.weights(\"tool\")\n        score = sum(feats[f] * w[f] for f in self.TOOL_FEATURES)\n        return {\"toolId\": tool[\"id\"], \"score\": round(score, 4),\n                \"features\": feats, \"weights\": w}\n\n    def rank_tools(self, text: str, kind_filter: Optional[str] = None,\n                   trace: bool = True) -> list[dict]:\n        cands = []\n        for t in self.ctx.registry.tools():\n            if kind_filter and t.get(\"lane\") != kind_filter:\n                continue\n            cands.append(self.score_tool(t, text))\n        cands.sort(key=lambda c: c[\"score\"], reverse=True)\n        if trace:\n            self.ctx.append(\"decision:tool\", \"decision:score\",\n                            {\"input\": text[:200],\n                             \"ranking\": [{\"toolId\": c[\"toolId\"], \"score\": c[\"score\"]}\n                                         for c in cands[:8]],\n                             \"top\": cands[0] if cands else None},\n                            \"model:decision\", certainty=0.9,\n                            basis={\"kind\": \"interpretation\"})\n        return cands\n\n    # ---- persona (respondent) scoring ----\n\n    def rank_personas(self, personas: list[dict], text: str,\n                      topic_links: Optional[dict] = None,\n                      trace: bool = True) -> list[dict]:\n        toks = _tokens(text)\n        w = self.weights(\"persona\")\n        out = []\n        for p in personas:\n            lens = set()\n            for k in (p.get(\"interests\") or []) + (p.get(\"traits\") or []):\n                lens |= _tokens(k)\n            f_lens = _jaccard(toks, lens)\n            f_topic = float((topic_links or {}).get(p[\"id\"], 0.0))\n            f_conf = float(p.get(\"confidence\", 0.8))\n            f_prio = float(p.get(\"rosterPriority\", 0.5))\n            feats = {\"lens_overlap\": round(f_lens, 4), \"topic_link\": f_topic,\n                     \"confidence\": f_conf, \"priority\": f_prio}\n            score = sum(feats[f] * w[f] for f in self.PERSONA_FEATURES)\n            out.append({\"personaId\": p[\"id\"], \"score\": round(score, 4),\n                        \"features\": feats})\n        out.sort(key=lambda c: c[\"score\"], reverse=True)\n        if trace:\n            self.ctx.append(\"decision:persona\", \"decision:respondent\",\n                            {\"input\": text[:200], \"ranking\": out}, \"model:decision\",\n                            certainty=0.9, basis={\"kind\": \"interpretation\"})\n        return out\n\n    # ---- outcome feedback / trust churn ----\n\n    def success_rate(self, tool_id: str) -> float:\n        rows = self.ctx.ledger.query(subject=f\"tool:{tool_id}\",\n                                     predicate=\"tool:telemetry\", limit=20)\n        if not rows:\n            return 0.5\n        ok = sum(1 for r in rows if r.value[\"v\"].get(\"status\") == \"ok\")\n        return ok / len(rows)\n\n    def _last_success(self, tool_id: str) -> int:\n        rows = [r for r in self.ctx.ledger.query(\n            subject=f\"tool:{tool_id}\", predicate=\"tool:telemetry\", limit=40)\n            if r.value[\"v\"].get(\"status\") == \"ok\"]\n        return rows[-1].at if rows else 0\n\n    def rank_multiplier(self, tool_id: str) -> float:\n        rows = self.ctx.ledger.query(subject=f\"tool:{tool_id}\",\n                                     predicate=\"tool:rank-adjustment\")\n        if not rows:\n            return 1.0\n        return max(self.RANK_FLOOR, min(self.RANK_CEIL,\n                                        float(rows[-1].value[\"v\"][\"multiplier\"])))\n\n    def record_outcome(self, tool_id: str, need_id: Optional[str],\n                       ok: bool, adequate: bool):\n        \"\"\"Churn: inadequate/failed results lower rank among alternatives; the\n        tool stays eligible (multiplier bounded, never removed).\"\"\"\n        cur = self.rank_multiplier(tool_id)\n        if ok and adequate:\n            new = min(self.RANK_CEIL, cur * 1.05)\n            if new > cur:\n                self.ctx.append(f\"tool:{tool_id}\", \"tool:rank-adjustment\",\n                                {\"multiplier\": round(new, 4), \"reason\": \"success-recovery\",\n                                 \"needId\": need_id}, \"model:decision\",\n                                basis={\"kind\": \"execution\"})\n        else:\n            new = max(self.RANK_FLOOR, cur * 0.9)\n            self.ctx.append(f\"tool:{tool_id}\", \"tool:rank-adjustment\",\n                            {\"multiplier\": round(new, 4),\n                             \"reason\": \"insufficient-result\" if ok else \"failure\",\n                             \"needId\": need_id}, \"model:decision\",\n                            basis={\"kind\": \"execution\"})\n            self.ctx.append(\"decision:churn\", \"decision:churn\",\n                            {\"toolId\": tool_id, \"needId\": need_id,\n                             \"from\": cur, \"to\": round(new, 4)},\n                            \"model:decision\", basis={\"kind\": \"execution\"})"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","terminal_exit":{"terminal_id":"13c8ea","exit_code":0,"signal":null}}}}}
