{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#a54b36e3966742909c37b7645672efb9","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Install-time seed packs. Packs are JSON data loaded once per installation\n(marker row prevents re-seeding). Seed assertions carry claimant seed:*.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\n\n\ndef load_packs(ctx, packs_dir: str) -> dict:\n    loaded = []\n    if not os.path.isdir(packs_dir):\n        return {\"loaded\": []}\n    for fn in sorted(os.listdir(packs_dir)):\n        if not fn.endswith(\".json\"):\n            continue\n        pack_id = fn[:-5]"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#a54b36e3966742909c37b7645672efb9","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Install-time seed packs. Packs are JSON data loaded once per installation\n(marker row prevents re-seeding). Seed assertions carry claimant seed:*.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\n\n\ndef load_packs(ctx, packs_dir: str) -> dict:\n    loaded = []\n    if not os.path.isdir(packs_dir):\n        return {\"loaded\": []}\n    for fn in sorted(os.listdir(packs_dir)):\n        if not fn.endswith(\".json\"):\n            continue\n        pack_id = fn[:-5]\n        # seeds are idempotent per installation via a marker subject\n        existing = [a for a in ctx.ledger.all()\n                    if a.subjectKey == f\"pack:{pack_id}\"]\n        if existing:\n            continue\n        with open(os.path.join(packs_dir, fn), encoding=\"utf-8\") as f:\n            pack = json.load(f)\n        cl = f\"seed:{pack_id}\"\n        for p in pack.get(\"personas\") or []:\n            ctx.personas.mint(p.get(\"name\", \"unnamed\"), p.get(\"traits\") or [],\n                              p.get(\"interests\") or [], p.get(\"lens\") or {},\n                              p.get(\"voice\"), p.get(\"imitates\"), cl)\n        for a in pack.get(\"assertions\") or []:\n            ctx.append(a[\"subject\"], a[\"predicate\"], a.get(\"value\"), cl,\n                       certainty=a.get(\"certainty\", 0.9),\n                       basis={\"kind\": \"seed\", \"ref\": pack_id})\n        for t in pack.get(\"tools\") or []:\n            spec = dict(t); spec.setdefault(\"kind\", \"tool\"); spec[\"seed\"] = True\n            ctx.registry.register(spec)\n            ctx.append(f\"tool:{spec['id']}\", \"tool:exists\",\n                       {\"id\": spec[\"id\"], \"seed\": True}, cl)\n            ctx.append(f\"tool:{spec['id']}\", \"tool:definition\", spec, cl)\n        ctx.append(f\"pack:{pack_id}\", \"seed:loaded\",\n                   {\"id\": pack_id, \"personas\": len(pack.get(\"personas\") or []),\n                    \"assertions\": len(pack.get(\"assertions\") or []),\n                    \"tools\": len(pack.get(\"tools\") or [])}, cl,\n                   basis={\"kind\": \"seed\", \"ref\": pack_id})\n        loaded.append(pack_id)\n    return {\"loaded\": loaded}\n\"\"\"Meridian core model: assertions, typed values, predicates, claimants.\n\nThe assertion ledger is the book of record. Assertions are append-only;\ncorrections and supersessions are new rows. Every assertion records source,\n\u001b[0m[... 85 lines omitted ...]\n    \"seed\",               # install-time corpus\n    \"config\",             # configuration assertion\n    \"refusal\",            # a recorded refusal/deferral\n)\n\n\n# --- Assertion ---------------------------------------------------------------\n\n@dataclass\nclass Assertion:\n    subjectKey: str\n    predicate: str            # \"namespace:name\"\n    value: dict               # TypedValue\n    claimant: str\n    certainty: float          # 0..1 truth confidence\n    context: float = 1.0      # contextual applicability confidence (ranks applicability)\n    basis: dict = field(default_factory=lambda: {\"kind\": \"generated\"})\n    at: int = field(default_factory=now_ms)\n    supersedes: Optional[str] = None\n    relates: list = field(default_factory=list)   # ids of related assertions\n    tags: list = field(default_factory=list)\n    id: str = field(default_factory=lambda: new_id())\n    meta: dict = field(default_factory=dict)      # non-truth operational metadata\n\n    def to_row(self) -> dict:\n        d = asdict(self)\n        return d\n\n    @staticmethod\n    def from_row(d: dict) -> \"Assertion\":\n        return Assertion(\n            id=d[\"id\"], subjectKey=d[\"subjectKey\"], predicate=d[\"predicate\"],\n            value=d[\"value\"], claimant=d[\"claimant\"], certainty=d[\"certainty\"],\n            context=d.get(\"context\", 1.0), basis=d.get(\"basis\", {\"kind\": \"generated\"}),\n            at=d[\"at\"], supersedes=d.get(\"supersedes\"),\n            relates=d.get(\"relates\", []), tags=d.get(\"tags\", []),\n            meta=d.get(\"meta\", {}),\n        )\n\n\ndef make_assertion(subject: str, predicate: str, value, claimant: str,\n                   certainty: float = 1.0, context: float = 1.0,\n                   basis: Optional[dict] = None, supersedes: Optional[str] = None,\n                   relates: Optional[list] = None, tags: Optional[list] = None,\n                   meta: Optional[dict] = None) -> Assertion:\n    if not valid_claimant(claimant):\n        raise ValueError(f\"invalid claimant: {claimant}\")\n    tv = infer_typed(value)\n    certainty = max(0.0, min(1.0, float(certainty)))\n    context = max(0.0, min(1.0, float(context)))\n    return Assertion(\n        subjectKey=subject, predicate=predicate, value=tv, claimant=claimant,\n        certainty=certainty, context=context,\n        basis=basis or {\"kind\": \"generated\"}, supersedes=supersedes,\n        relates=list(relates or []), tags=list(tags or []), meta=dict(meta or {}),\n    )\n\"\"\"Background stewardship loop (A3).\n\nStewardship is a configurable, assignable tool (steward-tick) run by this\ndaemon at a configurable interval. It never blocks the interactive request\npath: it runs on its own thread, holds no locks while idle, and treats user\nsilence as nothing — consequential actions still require witnessed grants.\nEach pass records its duration; interactive responsiveness is provable from\nthe API probe (the server answers while ticks run).\n\"\"\"\nfrom __future__ import annotations\n\nimport threading\nimport time\n\n\nclass Steward(threading.Thread):\n    def __init__(self, ctx):\n        super().__init__(daemon=True, name=\"steward\")\n        self.ctx = ctx\n        self._stop = threading.Event()\n        self.last_tick = None\n\n    def interval(self) -> float:\n        rows = self.ctx.ledger.query(subject=\"steward:main\",\n                                     predicate=\"routing:stewardship-assignment\")\n        if rows and rows[-1].value[\"v\"].get(\"intervalSec\"):\n            return float(rows[-1].value[\"v\"][\"intervalSec\"])\n        return 15.0\n\n    def run(self):\n        while not self._stop.is_set():\n            iv = self.interval()\n            if self._stop.wait(iv):\n                break\n            try:\n                self.last_tick = self.ctx.invoke(\"steward-tick\",\n                                                 {\"reason\": \"interval\"})\n            except Exception as e:\n                self.ctx.append(\"idle\", \"idle:steward-run\",\n                                {\"error\": repr(e)}, \"steward:main\",\n                                basis={\"kind\": \"execution\"})\n\n    def stop(self):\n        self._stop.set()"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#a54b36e3966742909c37b7645672efb9","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Install-time seed packs. Packs are JSON data loaded once per installation\n(marker row prevents re-seeding). Seed assertions carry claimant seed:*.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\n\n\ndef load_packs(ctx, packs_dir: str) -> dict:\n    loaded = []\n    if not os.path.isdir(packs_dir):\n        return {\"loaded\": []}\n    for fn in sorted(os.listdir(packs_dir)):\n        if not fn.endswith(\".json\"):\n            continue\n        pack_id = fn[:-5]\n        # seeds are idempotent per installation via a marker subject\n        existing = [a for a in ctx.ledger.all()\n                    if a.subjectKey == f\"pack:{pack_id}\"]\n        if existing:\n            continue\n        with open(os.path.join(packs_dir, fn), encoding=\"utf-8\") as f:\n            pack = json.load(f)\n        cl = f\"seed:{pack_id}\"\n        for p in pack.get(\"personas\") or []:\n            ctx.personas.mint(p.get(\"name\", \"unnamed\"), p.get(\"traits\") or [],\n                              p.get(\"interests\") or [], p.get(\"lens\") or {},\n                              p.get(\"voice\"), p.get(\"imitates\"), cl)\n        for a in pack.get(\"assertions\") or []:\n            ctx.append(a[\"subject\"], a[\"predicate\"], a.get(\"value\"), cl,\n                       certainty=a.get(\"certainty\", 0.9),\n                       basis={\"kind\": \"seed\", \"ref\": pack_id})\n        for t in pack.get(\"tools\") or []:\n            spec = dict(t); spec.setdefault(\"kind\", \"tool\"); spec[\"seed\"] = True\n            ctx.registry.register(spec)\n            ctx.append(f\"tool:{spec['id']}\", \"tool:exists\",\n                       {\"id\": spec[\"id\"], \"seed\": True}, cl)\n            ctx.append(f\"tool:{spec['id']}\", \"tool:definition\", spec, cl)\n        ctx.append(f\"pack:{pack_id}\", \"seed:loaded\",\n                   {\"id\": pack_id, \"personas\": len(pack.get(\"personas\") or []),\n                    \"assertions\": len(pack.get(\"assertions\") or []),\n                    \"tools\": len(pack.get(\"tools\") or [])}, cl,\n                   basis={\"kind\": \"seed\", \"ref\": pack_id})\n        loaded.append(pack_id)\n    return {\"loaded\": loaded}\n\"\"\"Meridian core model: assertions, typed values, predicates, claimants.\n\nThe assertion ledger is the book of record. Assertions are append-only;\ncorrections and supersessions are new rows. Every assertion records source,\ntyped value, certainty, provenance, time, and relationships.\n\"\"\"\nfrom __future__ import annotations\n\nimport time\nimport uuid\nfrom dataclasses import dataclass, field, asdict\nfrom typing import Any, Optional\n\n\ndef now_ms() -> int:\n    return int(time.time() * 1000)\n\n\ndef new_id(prefix: str = \"a\") -> str:\n    return f\"{prefix}-{uuid.uuid4().hex[:12]}\"\n\n\n# --- Typed values -----------------------------------------------------------\n\nTYPED_KINDS = (\"string\", \"number\", \"boolean\", \"enum\", \"ref\", \"list\", \"map\")\n\n\ndef typed(kind: str, v: Any, options: Optional[list] = None) -> dict:\n    if kind not in TYPED_KINDS:\n        raise ValueError(f\"unknown typed value kind: {kind}\")\n    tv = {\"type\": kind, \"v\": v}\n    if options is not None:\n        tv[\"options\"] = options\n    return tv\n\n\ndef infer_typed(v: Any) -> dict:\n    \"\"\"Best-effort TypedValue for a plain python value.\"\"\"\n    if isinstance(v, dict) and v.get(\"type\") in TYPED_KINDS and \"v\" in v:\n        return v\n    if isinstance(v, bool):\n        return typed(\"boolean\", v)\n    if isinstance(v, (int, float)):\n        return typed(\"number\", v)\n    if isinstance(v, (list, tuple)):\n        return typed(\"list\", list(v))\n    if isinstance(v, dict):\n        return typed(\"map\", v)\n    if v is None:\n        return typed(\"string\", \"\")\n    return typed(\"string\", str(v))\n\n\n# --- Claimants (closed vocabulary) ------------------------------------------\n\nCLAIMANT_PREFIXES = (\n    \"principal\",       # the user, via a surface\n    \"persona:\",        # a persistent personality\n    \"steward:\",        # a background steward tool acting autonomously\n    \"model:\",          # an inference/decision model output\n    \"source:\",         # a configured external source\n    \"surface:\",        # a device/interface surface\n    \"pipeline:\",       # an ingest pipeline (perception, calendar, ...)\n    \"engine:\",         # an engine seam (llm, tts, stt, portrait)\n    \"seed:\",           # install-time corpus\n    \"tool:\",           # a tool execution result\n    \"exchange:\",       # an imported exchange/storefront package\n    \"system\",          # the host itself\n)\n\n\ndef valid_claimant(c: str) -> bool:\n    return any(c == p or (p.endswith(\":\") and c.startswith(p)) for p in CLAIMANT_PREFIXES)\n\n\n# --- Basis kinds ------------------------------------------------------------\n# Preserves the distinction between captured input, interpretation, source\n# evidence, generated response, execution evidence, user choice, durable\n# result, and import.\n\nBASIS_KINDS = (\n    \"captured-input\",     # raw user input as received\n    \"interpretation\",     # an interpretation of captured input\n    \"source-evidence\",    # data from a configured source\n    \"generated\",          # a generated response/draft\n    \"execution\",          # evidence of a tool execution attempt\n    \"user-choice\",        # an explicit witnessed user decision\n    \"durable-result\",     # a settled result of completed work\n    \"import\",             # imported exchange material (below threshold)\n    \"seed\",               # install-time corpus\n    \"config\",             # configuration assertion\n    \"refusal\",            # a recorded refusal/deferral\n)\n\n\n# --- Assertion ---------------------------------------------------------------\n\n@dataclass\nclass Assertion:\n    subjectKey: str\n    predicate: str            # \"namespace:name\"\n    value: dict               # TypedValue\n    claimant: str\n    certainty: float          # 0..1 truth confidence\n    context: float = 1.0      # contextual applicability confidence (ranks applicability)\n    basis: dict = field(default_factory=lambda: {\"kind\": \"generated\"})\n    at: int = field(default_factory=now_ms)\n    supersedes: Optional[str] = None\n    relates: list = field(default_factory=list)   # ids of related assertions\n    tags: list = field(default_factory=list)\n    id: str = field(default_factory=lambda: new_id())\n    meta: dict = field(default_factory=dict)      # non-truth operational metadata\n\n    def to_row(self) -> dict:\n        d = asdict(self)\n        return d\n\n    @staticmethod\n    def from_row(d: dict) -> \"Assertion\":\n        return Assertion(\n            id=d[\"id\"], subjectKey=d[\"subjectKey\"], predicate=d[\"predicate\"],\n            value=d[\"value\"], claimant=d[\"claimant\"], certainty=d[\"certainty\"],\n            context=d.get(\"context\", 1.0), basis=d.get(\"basis\", {\"kind\": \"generated\"}),\n            at=d[\"at\"], supersedes=d.get(\"supersedes\"),\n            relates=d.get(\"relates\", []), tags=d.get(\"tags\", []),\n            meta=d.get(\"meta\", {}),\n        )\n\n\ndef make_assertion(subject: str, predicate: str, value, claimant: str,\n                   certainty: float = 1.0, context: float = 1.0,\n                   basis: Optional[dict] = None, supersedes: Optional[str] = None,\n                   relates: Optional[list] = None, tags: Optional[list] = None,\n                   meta: Optional[dict] = None) -> Assertion:\n    if not valid_claimant(claimant):\n        raise ValueError(f\"invalid claimant: {claimant}\")\n    tv = infer_typed(value)\n    certainty = max(0.0, min(1.0, float(certainty)))\n    context = max(0.0, min(1.0, float(context)))\n    return Assertion(\n        subjectKey=subject, predicate=predicate, value=tv, claimant=claimant,\n        certainty=certainty, context=context,\n        basis=basis or {\"kind\": \"generated\"}, supersedes=supersedes,\n        relates=list(relates or []), tags=list(tags or []), meta=dict(meta or {}),\n    )\n\"\"\"Background stewardship loop (A3).\n\nStewardship is a configurable, assignable tool (steward-tick) run by this\ndaemon at a configurable interval. It never blocks the interactive request\npath: it runs on its own thread, holds no locks while idle, and treats user\nsilence as nothing — consequential actions still require witnessed grants.\nEach pass records its duration; interactive responsiveness is provable from\nthe API probe (the server answers while ticks run).\n\"\"\"\nfrom __future__ import annotations\n\nimport threading\nimport time\n\n\nclass Steward(threading.Thread):\n    def __init__(self, ctx):\n        super().__init__(daemon=True, name=\"steward\")\n        self.ctx = ctx\n        self._stop = threading.Event()\n        self.last_tick = None\n\n    def interval(self) -> float:\n        rows = self.ctx.ledger.query(subject=\"steward:main\",\n                                     predicate=\"routing:stewardship-assignment\")\n        if rows and rows[-1].value[\"v\"].get(\"intervalSec\"):\n            return float(rows[-1].value[\"v\"][\"intervalSec\"])\n        return 15.0\n\n    def run(self):\n        while not self._stop.is_set():\n            iv = self.interval()\n            if self._stop.wait(iv):\n                break\n            try:\n                self.last_tick = self.ctx.invoke(\"steward-tick\",\n                                                 {\"reason\": \"interval\"})\n            except Exception as e:\n                self.ctx.append(\"idle\", \"idle:steward-run\",\n                                {\"error\": repr(e)}, \"steward:main\",\n                                basis={\"kind\": \"execution\"})\n\n    def stop(self):\n        self._stop.set()"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","terminal_exit":{"terminal_id":"f70959","exit_code":0,"signal":null}}}}}
