{"jsonrpc":"2.0","id":"96fe33cb-e551-4705-9fee-de65fbd33096","method":"fs/write_text_file","params":{"sessionId":"similar-snowdrop","path":"C:\\builds\\project\\version 0.3.0.003\\app\\api.py","content":"\"\"\"HTTP API + static UI server (stdlib only).\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport queue\nimport socket\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nfrom . import builtins as B\nfrom . import needs as N\nfrom . import tools as T\nfrom .host import VERSION\n\n\nclass MeridianServer(ThreadingHTTPServer):\n    \"\"\"Exclusive-bind HTTP server: SO_EXCLUSIVEADDRUSE on Windows so a second\n    instance can never silently share the port (G4), plus SSE client tracking\n    for close-terminates lifecycle.\"\"\"\n    daemon_threads = True\n\n    def server_bind(self):\n        if os.name == \"nt\":\n            try:\n                self.socket.setsockopt(socket.SOL_SOCKET,\n                                       socket.SO_EXCLUSIVEADDRUSE, 1)\n            except OSError:\n                pass\n        super().server_bind()\n\n\ndef _json_of(handler) -> dict:\n    n = int(handler.headers.get(\"Content-Length\") or 0)\n    if not n:\n        return {}\n    return json.loads(handler.rfile.read(n).decode())\n\n\ndef make_handler(ctx, ui_dir):\n    class H(BaseHTTPRequestHandler):\n        protocol_version = \"HTTP/1.1\"\n\n        def log_message(self, *a):\n            pass\n\n        # ---------- helpers ----------\n        def _send(self, code, body, ctype=\"application/json\"):\n            data = body if isinstance(body, (bytes,)) else json.dumps(\n                body, ensure_ascii=False).encode()\n            self.send_response(code)\n            self.send_header(\"Content-Type\",\n                             ctype if isinstance(body, bytes) else\n                             \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(data)))\n            self.end_headers()\n            self.wfile.write(data)\n\n        def _err(self, msg, code=400):\n            self._send(code, {\"ok\": False, \"error\": msg})\n\n        # ---------- routes ----------\n        def do_GET(self):\n            u = urllib.parse.urlparse(self.path)\n            path, q = u.path, urllib.parse.parse_qs(u.query)\n            if path in (\"/\", \"/index.html\"):\n                return self._static(\"index.html\")\n            if path.startswith(\"/ui/\"):\n                return self._static(path[4:])\n            if path == \"/api/version\":\n                return self._send(200, {\"app\": \"meridian\", \"version\": VERSION,\n                                        \"gate\": (ctx.gate or {}).get(\"passed\"),\n                                        \"gatePassedAt\": (ctx.gate or {}).get(\"passedAt\")})\n            if path == \"/api/gate\":\n                return self._send(200, ctx.gate or {\"passed\": None})\n            if path == \"/api/events\":\n                return self._sse()\n            if path == \"/api/state\":\n                return self._send(200, state(ctx))\n            if path == \"/api/context\":\n                return self._send(200, {\"context\": B.current_context(ctx),\n                                        \"focus\": B.current_focus(ctx),\n                                        \"topic\": B.current_topic(ctx)})\n            if path == \"/api/emails\":\n                rows = ctx.ledger.query(predicate=\"email:message\",\n                                        limit=int(q.get(\"limit\", [50])[0]))\n                return self._send(200, {\"emails\": [\n                    {\"id\": r.id, **r.value[\"v\"], \"at\": r.at}\n                    for r in rows]})\n            if path == \"/api/tools\":\n                return self._send(200, {\"tools\": ctx.registry.manifest()})\n            if path == \"/api/needs\":\n                return self._send(200, {\"open\": N.open_needs(ctx)})\n            if path == \"/api/cards\":\n                return self._send(200, {\"events\": ctx.bus.recent[-200:]})\n            if path == \"/api/library\":\n                rows = ctx.ledger.query(\n                    predicate=q.get(\"predicate\", [None])[0],\n                    subject=q.get(\"subject\", [None])[0],\n                    limit=int(q.get(\"limit\", [200])[0]))\n                if q.get(\"q\"):\n                    rows = ctx.ledger.search(q[\"q\"][0], 200)\n                return self._send(200, {\"rows\": [r.to_row() for r in rows],\n                                        \"stats\": ctx.ledger.stats()})\n            if path == \"/api/view\":\n                return self._send(200, ctx.ledger.render_view(q[\"subject\"][0]))\n            if path == \"/api/candidates\":\n                return self._send(200, {\"candidates\": ctx.ledger.candidates_for(\n                    q[\"subject\"][0], q[\"predicate\"][0])})\n            if path == \"/api/projects\":\n                return self._send(200, {\"projects\": projects(ctx)})\n            if path == \"/api/calendar\":\n                return self._send(200, {\"events\": [\n                    r.value[\"v\"] | {\"assertionId\": r.id, \"at\": r.at}\n                    for r in ctx.ledger.query(predicate=\"calendar:event\")]})\n            if path == \"/api/grants\":\n                return self._send(200, {\"grants\": [\n                    {\"id\": a.subjectKey.split(\":\", 1)[1], **a.value[\"v\"],\n                     \"at\": a.at}\n                    for a in ctx.ledger.query(predicate=\"grant:issued\")]})\n            if path == \"/api/log\":\n                kind = q.get(\"kind\", [None])[0]\n                preds = {\"traces\": \"routing:turn-trace\", \"decisions\": \"decision:score\",\n                         \"steward\": \"idle:steward-run\", \"telemetry\": \"tool:telemetry\",\n                         \"churn\": \"decision:churn\"}.get(kind)\n                rows = ctx.ledger.query(predicate=preds, limit=int(q.get(\"limit\", [100])[0])) \\\n                    if preds else []\n                return self._send(200, {\"rows\": [r.to_row() for r in rows]})\n            if path == \"/api/honesty\":\n                return self._send(200, ctx.honesty())\n            if path == \"/api/connectors\":\n                r = ctx.invoke(\"connector-status\", {})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/archive\":\n                r = ctx.invoke(\"archive-view\", {})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/temporal\":\n                r = ctx.invoke(\"temporal-context\",\n                               {\"horizonDays\": int(q.get(\"days\", [7])[0])})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/speech-floor\":\n                return self._send(200, {\"depth\": ctx.floor.depth(),\n                                        \"played\": ctx.floor.played[-50:]})\n            if path == \"/api/comparisons\":\n                rows = ctx.ledger.query(predicate=\"comparison:run\",\n                                        limit=int(q.get(\"limit\", [20])[0]))\n                return self._send(200, {\"comparisons\": [r.value[\"v\"] for r in rows]})\n            return self._err(\"not found\", 404)\n\n        def do_POST(self):\n            u = urllib.parse.urlparse(self.path)\n            path = u.path\n            body = _json_of(self)\n            if path == \"/api/chat\":\n                r = ctx.invoke(\"run-chat-turn\",\n                               {\"text\": body.get(\"text\", \"\"),\n                                \"all\": bool(body.get(\"all\")),\n                                \"personaId\": body.get(\"personaId\")})\n                return self._send(200, r)\n            if path == \"/api/chat/reset\":\n                r = ctx.invoke(\"chat-reset\", {})\n                return self._send(200, r)\n            if path == \"/api/context/select\":\n                r = ctx.invoke(\"select-context\", body)\n                return self._send(200, r)\n            if path == \"/api/invoke\":\n                # entry-path callTool: stage the need, then fulfill when gate-ready\n                r = ctx.invoke(\"request-tool\",\n                               {\"toolId\": body[\"toolId\"],\n                                \"slots\": body.get(\"slots\") or {},\n                                \"summary\": body.get(\"summary\")})\n                nid = (r.get(\"result\") or {}).get(\"needId\") if r.get(\"ok\") else None\n                if not nid:\n                    return self._send(200, {\"ok\": False, \"error\": r.get(\"error\")})\n                fr = T.fulfill_need(ctx, nid)\n                gate = None\n                if fr.get(\"deferred\"):\n                    gate = fr.get(\"missing\")\n                return self._send(200, {\"ok\": fr.get(\"ok\"), \"needId\": nid,\n                                        \"deferred\": fr.get(\"deferred\"),\n                                        \"missing\": gate,\n                                        \"result\": fr.get(\"result\"),\n                                        \"error\": fr.get(\"error\")})\n            if path == \"/api/grants\":\n                gid = T.issue_grant(ctx, body[\"scope\"], body.get(\"lock\"))\n                return self._send(200, {\"ok\": True, \"grantId\": gid})\n            if path == \"/api/personas\":\n                r = ctx.invoke(\"persona.mint\", body)\n                return self._send(200, r)\n            if path == \"/api/personas/update\":\n                r = ctx.invoke(\"persona-update\", body)\n                return self._send(200, r)\n            if path == \"/api/personas/art\":\n                r = ctx.invoke(\"generate-portrait\",\n                               {\"personaId\": body.get(\"personaId\")})\n                return self._send(200, r)\n            if path == \"/api/calendar/import\":\n                r = ctx.invoke(\"import-calendar\", body)\n                return self._send(200, r)\n            if path == \"/api/exchange/import\":\n                r = ctx.invoke(\"import-exchange\", body)\n                return self._send(200, r)\n            if path == \"/api/exchange/export\":\n                r = ctx.invoke(\"export-exchange\", body)\n                return self._send(200, r)\n            if path == \"/api/stt\":\n                r = ctx.invoke(\"transcribe-speech\", body)\n                return self._send(200, r)\n            if path == \"/api/tts\":\n                r = ctx.invoke(\"speak-voice\", body)\n                return self._send(200, r)\n            if path == \"/api/steward/wake\":\n                r = ctx.invoke(\"steward-tick\", {\"reason\": \"manual\"})\n                return self._send(200, r)\n            if path == \"/api/connectors/configure\":\n                r = ctx.invoke(\"connector-configure\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/connectors/run\":\n                r = ctx.invoke(\"connector-run\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/compare\":\n                r = ctx.invoke(\"compare-run\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/archive/seal\":\n                r = ctx.invoke(\"archive-view\", {\"seal\": True,\n                                              \"reason\": body.get(\"reason\")})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/personas/voice\":\n                r = ctx.invoke(\"persona-voice-set\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/config\":\n                ctx.append(\"user-settings\", body[\"predicate\"], body[\"value\"],\n                           \"principal\", basis={\"kind\": \"config\"})\n                return self._send(200, {\"ok\": True})\n            if path == \"/api/cleanup\":\n                r = ctx.invoke(\"cleanup-run\", {})\n                return self._send(200, r)\n            if path.startswith(\"/api/needs/\") and path.endswith(\"/focus\"):\n                nid = path.split(\"/\")[3]\n                r = ctx.invoke(\"focus-need\", {\"needId\": nid,\n                                              \"clear\": body.get(\"clear\")})\n                return self._send(200, r)\n            if path.startswith(\"/api/needs/\") and path.endswith(\"/cancel\"):\n                nid = path.split(\"/\")[3]\n                N.close_need(ctx, nid, \"cancelled\", {\"by\": \"api\"}, \"principal\")\n                return self._send(200, {\"ok\": True})\n            if path.startswith(\"/api/needs/\") and path.endswith(\"/candidate\"):\n                nid = path.split(\"/\")[3]\n                aid = N.add_candidate(ctx, nid, body[\"slot\"], body[\"value\"],\n                                      float(body.get(\"confidence\", 0.8)),\n                                      body.get(\"source\", \"user\"), \"principal\")\n                return self._send(200, {\"ok\": True, \"assertionId\": aid})\n            if path.startswith(\"/api/tools/\") and path.endswith(\"/invoke\"):\n                cid = path.split(\"/\")[3]\n                r = ctx.invoke(cid, body.get(\"input\") or {},\n                               grant=body.get(\"grant\"))\n                return self._send(200, r)\n            if path.startswith(\"/api/tools/\") and path.endswith(\"/inspect\"):\n                r = ctx.invoke(\"inspect-tool\", {\"toolId\": path.split(\"/\")[3]})\n                return self._send(200, r)\n            if path == \"/api/library/assert\":\n                a = ctx.append(body[\"subject\"], body[\"predicate\"], body[\"value\"],\n                               \"principal\",\n                               certainty=float(body.get(\"certainty\", 0.9)),\n                               basis={\"kind\": \"user-choice\"},\n                               supersedes=body.get(\"supersedes\"))\n                return self._send(200, {\"ok\": True, \"id\": a.id})\n            return self._err(\"not found\", 404)\n\n        # ---------- SSE: window-presence channel ----------\n        def _sse(self):\n            \"\"\"Server-sent events: bus replay to the UI. The connection's\n            presence is the window-alive signal for close-terminates.\"\"\"\n            srv = self.server\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"Connection\", \"keep-alive\")\n            self.end_headers()\n            q: \"queue.Queue[dict]\" = queue.Queue(maxsize=600)\n            srv.sse_clients.add(q)\n            srv.sse_total += 1\n            try:\n                self.wfile.write(b\": meridian events\\n\\n\")\n                self.wfile.flush()\n                while not srv.shutting_down:\n                    try:\n                        ev = q.get(timeout=5.0)\n                        self.wfile.write((\"data: \" + json.dumps(\n                            ev, ensure_ascii=False) + \"\\n\\n\").encode())\n                    except queue.Empty:\n                        self.wfile.write(b\": ping\\n\\n\")\n                    self.wfile.flush()\n            except Exception:\n                pass\n            finally:\n                srv.sse_clients.discard(q)\n\n        def _static(self, rel):\n            fp = os.path.join(ui_dir, rel.replace(\"/\", os.sep))\n            if not os.path.isfile(fp):\n                return self._err(\"not found\", 404)\n            ctype = {\"html\": \"text/html; charset=utf-8\",\n                     \"js\": \"text/javascript; charset=utf-8\",\n                     \"css\": \"text/css; charset=utf-8\",\n                     \"svg\": \"image/svg+xml\"}.get(fp.rsplit(\".\", 1)[-1], \"text/plain\")\n            with open(fp, \"rb\") as f:\n                self._send(200, f.read(), ctype)\n\n    return H\n\n\ndef projects(ctx) -> list[dict]:\n    out = []\n    for a in ctx.ledger.query(predicate=\"project:exists\"):\n        pid = a.subjectKey.split(\":\", 1)[1]\n        subj = a.subjectKey\n        goals = [r.value[\"v\"] for r in ctx.ledger.query(subject=subj, predicate=\"project:goal\")]\n        linked = [n for n in N.open_needs(ctx) if n[\"spec\"].get(\"project\") == pid]\n        closed = [r for r in ctx.ledger.all()\n                  if r.subjectKey.startswith(\"need:\")\n                  and r.predicate == \"need:fulfilled\"\n                  and (r.value[\"v\"].get(\"detail\") or {}).get(\"project\") == pid]\n        out.append({\"id\": pid, \"title\": a.value[\"v\"].get(\"title\"),\n                    \"goals\": goals, \"openNeeds\": linked,\n                    \"fulfilled\": len(closed)})\n    return out\n\n\ndef state(ctx) -> dict:\n    g = ctx.gate or {}\n    conn = {}\n    try:\n        from . import connectors as C\n        conn = {\"configured\": C.configured(ctx),\n                \"available\": sorted(C.CONNECTORS)}\n    except Exception:\n        conn = {\"configured\": [], \"available\": []}\n    return {\n        \"version\": VERSION,\n        \"honesty\": ctx.honesty(),\n        \"gate\": {\"passed\": g.get(\"passed\"), \"passedAt\": g.get(\"passedAt\"),\n                 \"msToGate\": g.get(\"msToGate\"),\n                 \"inputReady\": g.get(\"inputReady\"),\n                 \"ledgerReady\": g.get(\"ledgerReady\")},\n        \"roster\": ctx.personas.roster(),\n        \"chat\": B.chat_history(ctx, 60),\n        \"topic\": B.current_topic(ctx),\n        \"context\": B.current_context(ctx),\n        \"focus\": B.current_focus(ctx),\n        \"cards\": ctx.bus.recent[-60:],\n        \"needs\": N.open_needs(ctx),\n        \"projects\": projects(ctx),\n        \"tools\": ctx.registry.manifest(),\n        \"admonitions\": ctx.admonitions,\n        \"frame\": ctx.personas.frame(),\n        \"responseDepth\": ctx.response_depth(),\n        \"theme\": ctx.config(\"ui:shell-theme\", \"light\"),\n        \"connectors\": conn,\n        \"speechFloor\": {\"depth\": ctx.floor.depth(),\n                        \"played\": len(ctx.floor.played)},\n        \"emails\": len(ctx.ledger.query(predicate=\"email:message\")),\n    }\n\n\ndef serve(ctx, port: int, ui_dir: str):\n    srv = MeridianServer((\"127.0.0.1\", port), make_handler(ctx, ui_dir))\n    srv.sse_clients = set()\n    srv.sse_total = 0\n    srv.shutting_down = False\n    ctx.bus.subscribe(lambda ev: [\n        _put(q, ev) for q in list(srv.sse_clients)])\n    return srv\n\n\ndef _put(q, ev):\n    try:\n        q.put_nowait(ev)\n    except Exception:\n        pass\n","_meta":{"cognition.ai/toolCallId":"edit:0#743470bdfa934c32af898e014901d199","cognition.ai/suppressApproval":true}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"edit:0#743470bdfa934c32af898e014901d199","status":"in_progress","content":[{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.003\\app\\api.py","oldText":"\"\"\"HTTP API + static UI server (stdlib only).\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport queue\nimport socket\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nfrom . import builtins as B\nfrom . import needs as N\nfrom . import tools as T\nfrom .host import VERSION\n\n\nclass MeridianServer(ThreadingHTTPServer):\n    \"\"\"Exclusive-bind HTTP server: SO_EXCLUSIVEADDRUSE on Windows so a second\n    instance can never silently share the port (G4), plus SSE client tracking\n    for close-terminates lifecycle.\"\"\"\n    daemon_threads = True\n\n    def server_bind(self):\n        if os.name == \"nt\":\n            try:\n                self.socket.setsockopt(socket.SOL_SOCKET,\n                                       socket.SO_EXCLUSIVEADDRUSE, 1)\n            except OSError:\n                pass\n        super().server_bind()\n\n\ndef _json_of(handler) -> dict:\n    n = int(handler.headers.get(\"Content-Length\") or 0)\n    if not n:\n        return {}\n    return json.loads(handler.rfile.read(n).decode())\n\n\ndef make_handler(ctx, ui_dir):\n    class H(BaseHTTPRequestHandler):\n        protocol_version = \"HTTP/1.1\"\n\n        def log_message(self, *a):\n            pass\n\n        # ---------- helpers ----------\n        def _send(self, code, body, ctype=\"application/json\"):\n            data = body if isinstance(body, (bytes,)) else json.dumps(\n                body, ensure_ascii=False).encode()\n            self.send_response(code)\n            self.send_header(\"Content-Type\",\n                             ctype if isinstance(body, bytes) else\n                             \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(data)))\n            self.end_headers()\n            self.wfile.write(data)\n\n        def _err(self, msg, code=400):\n            self._send(code, {\"ok\": False, \"error\": msg})\n\n        # ---------- routes ----------\n        def do_GET(self):\n            u = urllib.parse.urlparse(self.path)\n            path, q = u.path, urllib.parse.parse_qs(u.query)\n            if path in (\"/\", \"/index.html\"):\n                return self._static(\"index.html\")\n            if path.startswith(\"/ui/\"):\n                return self._static(path[4:])\n            if path == \"/api/version\":\n                return self._send(200, {\"app\": \"meridian\", \"version\": VERSION,\n                                        \"gate\": (ctx.gate or {}).get(\"passed\"),\n                                        \"gatePassedAt\": (ctx.gate or {}).get(\"passedAt\")})\n            if path == \"/api/gate\":\n                return self._send(200, ctx.gate or {\"passed\": None})\n            if path == \"/api/events\":\n                return self._sse()\n            if path == \"/api/state\":\n                return self._send(200, state(ctx))\n            if path == \"/api/context\":\n                return self._send(200, {\"context\": B.current_context(ctx),\n                                        \"focus\": B.current_focus(ctx),\n                                        \"topic\": B.current_topic(ctx)})\n            if path == \"/api/emails\":\n                rows = ctx.ledger.query(predicate=\"email:message\",\n                                        limit=int(q.get(\"limit\", [50])[0]))\n                return self._send(200, {\"emails\": [\n                    {\"id\": r.id, **r.value[\"v\"], \"at\": r.at}\n                    for r in rows]})\n            if path == \"/api/tools\":\n                return self._send(200, {\"tools\": ctx.registry.manifest()})\n            if path == \"/api/needs\":\n                return self._send(200, {\"open\": N.open_needs(ctx)})\n            if path == \"/api/cards\":\n                return self._send(200, {\"events\": ctx.bus.recent[-200:]})\n            if path == \"/api/library\":\n                rows = ctx.ledger.query(\n                    predicate=q.get(\"predicate\", [None])[0],\n                    subject=q.get(\"subject\", [None])[0],\n                    limit=int(q.get(\"limit\", [200])[0]))\n                if q.get(\"q\"):\n                    rows = ctx.ledger.search(q[\"q\"][0], 200)\n                return self._send(200, {\"rows\": [r.to_row() for r in rows],\n                                        \"stats\": ctx.ledger.stats()})\n            if path == \"/api/view\":\n                return self._send(200, ctx.ledger.render_view(q[\"subject\"][0]))\n            if path == \"/api/candidates\":\n                return self._send(200, {\"candidates\": ctx.ledger.candidates_for(\n                    q[\"subject\"][0], q[\"predicate\"][0])})\n            if path == \"/api/projects\":\n                return self._send(200, {\"projects\": projects(ctx)})\n            if path == \"/api/calendar\":\n                return self._send(200, {\"events\": [\n                    r.value[\"v\"] | {\"assertionId\": r.id, \"at\": r.at}\n                    for r in ctx.ledger.query(predicate=\"calendar:event\")]})\n            if path == \"/api/grants\":\n                return self._send(200, {\"grants\": [\n                    {\"id\": a.subjectKey.split(\":\", 1)[1], **a.value[\"v\"],\n                     \"at\": a.at}\n                    for a in ctx.ledger.query(predicate=\"grant:issued\")]})\n            if path == \"/api/log\":\n                kind = q.get(\"kind\", [None])[0]\n                preds = {\"traces\": \"routing:turn-trace\", \"decisions\": \"decision:score\",\n                         \"steward\": \"idle:steward-run\", \"telemetry\": \"tool:telemetry\",\n                         \"churn\": \"decision:churn\"}.get(kind)\n                rows = ctx.ledger.query(predicate=preds, limit=int(q.get(\"limit\", [100])[0])) \\\n                    if preds else []\n                return self._send(200, {\"rows\": [r.to_row() for r in rows]})\n            if path == \"/api/honesty\":\n                return self._send(200, ctx.honesty())\n            if path == \"/api/connectors\":\n                r = ctx.invoke(\"connector-status\", {})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/archive\":\n                r = ctx.invoke(\"archive-view\", {})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/temporal\":\n                r = ctx.invoke(\"temporal-context\",\n                               {\"horizonDays\": int(q.get(\"days\", [7])[0])})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/speech-floor\":\n                return self._send(200, {\"depth\": ctx.floor.depth(),\n                                        \"played\": ctx.floor.played[-50:]})\n            if path == \"/api/comparisons\":\n                rows = ctx.ledger.query(predicate=\"comparison:run\",\n                                        limit=int(q.get(\"limit\", [20])[0]))\n                return self._send(200, {\"comparisons\": [r.value[\"v\"] for r in rows]})\n            return self._err(\"not found\", 404)\n\n        def do_POST(self):\n            u = urllib.parse.urlparse(self.path)\n            path = u.path\n            body = _json_of(self)\n            if path == \"/api/chat\":\n                r = ctx.invoke(\"run-chat-turn\",\n                               {\"text\": body.get(\"text\", \"\"),\n                                \"all\": bool(body.get(\"all\")),\n                                \"personaId\": body.get(\"personaId\")})\n                return self._send(200, r)\n            if path == \"/api/chat/reset\":\n                r = ctx.invoke(\"chat-reset\", {})\n                return self._send(200, r)\n            if path == \"/api/context/select\":\n                r = ctx.invoke(\"select-context\", body)\n                return self._send(200, r)\n            if path == \"/api/invoke\":\n                # entry-path callTool: stage the need, then fulfill when gate-ready\n                r = ctx.invoke(\"request-tool\",\n                               {\"toolId\": body[\"toolId\"],\n                                \"slots\": body.get(\"slots\") or {},\n                                \"summary\": body.get(\"summary\")})\n                nid = (r.get(\"result\") or {}).get(\"needId\") if r.get(\"ok\") else None\n                if not nid:\n                    return self._send(200, {\"ok\": False, \"error\": r.get(\"error\")})\n                fr = T.fulfill_need(ctx, nid)\n                gate = None\n                if fr.get(\"deferred\"):\n                    gate = fr.get(\"missing\")\n                return self._send(200, {\"ok\": fr.get(\"ok\"), \"needId\": nid,\n                                        \"deferred\": fr.get(\"deferred\"),\n                                        \"missing\": gate,\n                                        \"result\": fr.get(\"result\"),\n                                        \"error\": fr.get(\"error\")})\n            if path == \"/api/grants\":\n                gid = T.issue_grant(ctx, body[\"scope\"], body.get(\"lock\"))\n                return self._send(200, {\"ok\": True, \"grantId\": gid})\n            if path == \"/api/personas\":\n                r = ctx.invoke(\"persona.mint\", body)\n                return self._send(200, r)\n            if path == \"/api/personas/update\":\n                r = ctx.invoke(\"persona-update\", body)\n                return self._send(200, r)\n            if path == \"/api/personas/art\":\n                r = ctx.invoke(\"generate-portrait\",\n                               {\"personaId\": body.get(\"personaId\")})\n                return self._send(200, r)\n            if path == \"/api/calendar/import\":\n                r = ctx.invoke(\"import-calendar\", body)\n                return self._send(200, r)\n            if path == \"/api/exchange/import\":\n                r = ctx.invoke(\"import-exchange\", body)\n                return self._send(200, r)\n            if path == \"/api/exchange/export\":\n                r = ctx.invoke(\"export-exchange\", body)\n                return self._send(200, r)\n            if path == \"/api/stt\":\n                r = ctx.invoke(\"transcribe-speech\", body)\n                return self._send(200, r)\n            if path == \"/api/tts\":\n                r = ctx.invoke(\"speak-voice\", body)\n                return self._send(200, r)\n            if path == \"/api/steward/wake\":\n                r = ctx.invoke(\"steward-tick\", {\"reason\": \"manual\"})\n                return self._send(200, r)\n            if path == \"/api/connectors/configure\":\n                r = ctx.invoke(\"connector-configure\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/connectors/run\":\n                r = ctx.invoke(\"connector-run\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/compare\":\n                r = ctx.invoke(\"compare-run\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/archive/seal\":\n                r = ctx.invoke(\"archive-view\", {\"seal\": True,\n                                              \"reason\": body.get(\"reason\")})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/personas/voice\":\n                r = ctx.invoke(\"persona-voice-set\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/config\":\n                ctx.append(\"user-settings\", body[\"predicate\"], body[\"value\"],\n                           \"principal\", basis={\"kind\": \"config\"})\n                return self._send(200, {\"ok\": True})\n            if path == \"/api/cleanup\":\n                r = ctx.invoke(\"cleanup-run\", {})\n                return self._send(200, r)\n            if path.startswith(\"/api/needs/\") and path.endswith(\"/focus\"):\n                nid = path.split(\"/\")[3]\n                r = ctx.invoke(\"focus-need\", {\"needId\": nid,\n                                              \"clear\": body.get(\"clear\")})\n                return self._send(200, r)\n            if path.startswith(\"/api/needs/\") and path.endswith(\"/cancel\"):\n                nid = path.split(\"/\")[3]\n                N.close_need(ctx, nid, \"cancelled\", {\"by\": \"api\"}, \"principal\")\n                return self._send(200, {\"ok\": True})\n            if path.startswith(\"/api/needs/\") and path.endswith(\"/candidate\"):\n                nid = path.split(\"/\")[3]\n                aid = N.add_candidate(ctx, nid, body[\"slot\"], body[\"value\"],\n                                      float(body.get(\"confidence\", 0.8)),\n                                      body.get(\"source\", \"user\"), \"principal\")\n                return self._send(200, {\"ok\": True, \"assertionId\": aid})\n            if path.startswith(\"/api/tools/\") and path.endswith(\"/invoke\"):\n                cid = path.split(\"/\")[3]\n                r = ctx.invoke(cid, body.get(\"input\") or {},\n                               grant=body.get(\"grant\"))\n                return self._send(200, r)\n            if path.startswith(\"/api/tools/\") and path.endswith(\"/inspect\"):\n                r = ctx.invoke(\"inspect-tool\", {\"toolId\": path.split(\"/\")[3]})\n                return self._send(200, r)\n            if path == \"/api/library/assert\":\n                a = ctx.append(body[\"subject\"], body[\"predicate\"], body[\"value\"],\n                               \"principal\",\n                               certainty=float(body.get(\"certainty\", 0.9)),\n                               basis={\"kind\": \"user-choice\"},\n                               supersedes=body.get(\"supersedes\"))\n                return self._send(200, {\"ok\": True, \"id\": a.id})\n            return self._err(\"not found\", 404)\n\n        # ---------- SSE: window-presence channel ----------\n        def _sse(self):\n            \"\"\"Server-sent events: bus replay to the UI. The connection's\n            presence is the window-alive signal for close-terminates.\"\"\"\n            srv = self.server\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"Connection\", \"keep-alive\")\n            self.end_headers()\n            q: \"queue.Queue[dict]\" = queue.Queue(maxsize=600)\n            srv.sse_clients.add(q)\n            srv.sse_total += 1\n            try:\n                self.wfile.write(b\": meridian events\\n\\n\")\n                self.wfile.flush()\n                while not srv.shutting_down:\n                    try:\n                        ev = q.get(timeout=5.0)\n                        self.wfile.write((\"data: \" + json.dumps(\n                            ev, ensure_ascii=False) + \"\\n\\n\").encode())\n                    except queue.Empty:\n                        self.wfile.write(b\": ping\\n\\n\")\n                    self.wfile.flush()\n            except Exception:\n                pass\n            finally:\n                srv.sse_clients.discard(q)\n\n        def _static(self, rel):\n            fp = os.path.join(ui_dir, rel.replace(\"/\", os.sep))\n            if not os.path.isfile(fp):\n                return self._err(\"not found\", 404)\n            ctype = {\"html\": \"text/html; charset=utf-8\",\n                     \"js\": \"text/javascript; charset=utf-8\",\n                     \"css\": \"text/css; charset=utf-8\",\n                     \"svg\": \"image/svg+xml\"}.get(fp.rsplit(\".\", 1)[-1], \"text/plain\")\n            with open(fp, \"rb\") as f:\n                self._send(200, f.read(), ctype)\n\n    return H\n\n\ndef projects(ctx) -> list[dict]:\n    out = []\n    for a in ctx.ledger.query(predicate=\"project:exists\"):\n        pid = a.subjectKey.split(\":\", 1)[1]\n        subj = a.subjectKey\n        goals = [r.value[\"v\"] for r in ctx.ledger.query(subject=subj, predicate=\"project:goal\")]\n        linked = [n for n in N.open_needs(ctx) if n[\"spec\"].get(\"project\") == pid]\n        closed = [r for r in ctx.ledger.all()\n                  if r.subjectKey.startswith(\"need:\")\n                  and r.predicate == \"need:fulfilled\"\n                  and (r.value[\"v\"].get(\"detail\") or {}).get(\"project\") == pid]\n        out.append({\"id\": pid, \"title\": a.value[\"v\"].get(\"title\"),\n                    \"goals\": goals, \"openNeeds\": linked,\n                    \"fulfilled\": len(closed)})\n    return out\n\n\ndef state(ctx) -> dict:\n    g = ctx.gate or {}\n    conn = {}\n    try:\n        from . import connectors as C\n        conn = {\"configured\": C.configured(ctx),\n                \"available\": sorted(C.CONNECTORS)}\n    except Exception:\n        conn = {\"configured\": [], \"available\": []}\n    return {\n        \"version\": VERSION,\n        \"honesty\": ctx.honesty(),\n        \"gate\": {\"passed\": g.get(\"passed\"), \"passedAt\": g.get(\"passedAt\"),\n                 \"msToGate\": g.get(\"msToGate\"),\n                 \"inputReady\": g.get(\"inputReady\"),\n                 \"ledgerReady\": g.get(\"ledgerReady\")},\n        \"roster\": ctx.personas.roster(),\n        \"chat\": B.chat_history(ctx, 60),\n        \"topic\": B.current_topic(ctx),\n        \"context\": B.current_context(ctx),\n        \"focus\": B.current_focus(ctx),\n        \"cards\": ctx.bus.recent[-60:],\n        \"needs\": N.open_needs(ctx),\n        \"projects\": projects(ctx),\n        \"tools\": ctx.registry.manifest(),\n        \"admonitions\": ctx.admonitions,\n        \"frame\": ctx.personas.frame(),\n        \"responseDepth\": ctx.response_depth(),\n        \"theme\": ctx.config(\"ui:shell-theme\", \"light\"),\n        \"connectors\": conn,\n        \"speechFloor\": {\"depth\": ctx.floor.depth(),\n                        \"played\": len(ctx.floor.played)},\n        \"emails\": len(ctx.ledger.query(predicate=\"email:message\", limit=1)),\n    }\n\n\ndef serve(ctx, port: int, ui_dir: str):\n    srv = MeridianServer((\"127.0.0.1\", port), make_handler(ctx, ui_dir))\n    srv.sse_clients = set()\n    srv.sse_total = 0\n    srv.shutting_down = False\n    ctx.bus.subscribe(lambda ev: [\n        _put(q, ev) for q in list(srv.sse_clients)])\n    return srv\n\n\ndef _put(q, ev):\n    try:\n        q.put_nowait(ev)\n    except Exception:\n        pass\n","newText":"\"\"\"HTTP API + static UI server (stdlib only).\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport queue\nimport socket\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nfrom . import builtins as B\nfrom . import needs as N\nfrom . import tools as T\nfrom .host import VERSION\n\n\nclass MeridianServer(ThreadingHTTPServer):\n    \"\"\"Exclusive-bind HTTP server: SO_EXCLUSIVEADDRUSE on Windows so a second\n    instance can never silently share the port (G4), plus SSE client tracking\n    for close-terminates lifecycle.\"\"\"\n    daemon_threads = True\n\n    def server_bind(self):\n        if os.name == \"nt\":\n            try:\n                self.socket.setsockopt(socket.SOL_SOCKET,\n                                       socket.SO_EXCLUSIVEADDRUSE, 1)\n            except OSError:\n                pass\n        super().server_bind()\n\n\ndef _json_of(handler) -> dict:\n    n = int(handler.headers.get(\"Content-Length\") or 0)\n    if not n:\n        return {}\n    return json.loads(handler.rfile.read(n).decode())\n\n\ndef make_handler(ctx, ui_dir):\n    class H(BaseHTTPRequestHandler):\n        protocol_version = \"HTTP/1.1\"\n\n        def log_message(self, *a):\n            pass\n\n        # ---------- helpers ----------\n        def _send(self, code, body, ctype=\"application/json\"):\n            data = body if isinstance(body, (bytes,)) else json.dumps(\n                body, ensure_ascii=False).encode()\n            self.send_response(code)\n            self.send_header(\"Content-Type\",\n                             ctype if isinstance(body, bytes) else\n                             \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(data)))\n            self.end_headers()\n            self.wfile.write(data)\n\n        def _err(self, msg, code=400):\n            self._send(code, {\"ok\": False, \"error\": msg})\n\n        # ---------- routes ----------\n        def do_GET(self):\n            u = urllib.parse.urlparse(self.path)\n            path, q = u.path, urllib.parse.parse_qs(u.query)\n            if path in (\"/\", \"/index.html\"):\n                return self._static(\"index.html\")\n            if path.startswith(\"/ui/\"):\n                return self._static(path[4:])\n            if path == \"/api/version\":\n                return self._send(200, {\"app\": \"meridian\", \"version\": VERSION,\n                                        \"gate\": (ctx.gate or {}).get(\"passed\"),\n                                        \"gatePassedAt\": (ctx.gate or {}).get(\"passedAt\")})\n            if path == \"/api/gate\":\n                return self._send(200, ctx.gate or {\"passed\": None})\n            if path == \"/api/events\":\n                return self._sse()\n            if path == \"/api/state\":\n                return self._send(200, state(ctx))\n            if path == \"/api/context\":\n                return self._send(200, {\"context\": B.current_context(ctx),\n                                        \"focus\": B.current_focus(ctx),\n                                        \"topic\": B.current_topic(ctx)})\n            if path == \"/api/emails\":\n                rows = ctx.ledger.query(predicate=\"email:message\",\n                                        limit=int(q.get(\"limit\", [50])[0]))\n                return self._send(200, {\"emails\": [\n                    {\"id\": r.id, **r.value[\"v\"], \"at\": r.at}\n                    for r in rows]})\n            if path == \"/api/tools\":\n                return self._send(200, {\"tools\": ctx.registry.manifest()})\n            if path == \"/api/needs\":\n                return self._send(200, {\"open\": N.open_needs(ctx)})\n            if path == \"/api/cards\":\n                return self._send(200, {\"events\": ctx.bus.recent[-200:]})\n            if path == \"/api/library\":\n                rows = ctx.ledger.query(\n                    predicate=q.get(\"predicate\", [None])[0],\n                    subject=q.get(\"subject\", [None])[0],\n                    limit=int(q.get(\"limit\", [200])[0]))\n                if q.get(\"q\"):\n                    rows = ctx.ledger.search(q[\"q\"][0], 200)\n                return self._send(200, {\"rows\": [r.to_row() for r in rows],\n                                        \"stats\": ctx.ledger.stats()})\n            if path == \"/api/view\":\n                return self._send(200, ctx.ledger.render_view(q[\"subject\"][0]))\n            if path == \"/api/candidates\":\n                return self._send(200, {\"candidates\": ctx.ledger.candidates_for(\n                    q[\"subject\"][0], q[\"predicate\"][0])})\n            if path == \"/api/projects\":\n                return self._send(200, {\"projects\": projects(ctx)})\n            if path == \"/api/calendar\":\n                return self._send(200, {\"events\": [\n                    r.value[\"v\"] | {\"assertionId\": r.id, \"at\": r.at}\n                    for r in ctx.ledger.query(predicate=\"calendar:event\")]})\n            if path == \"/api/grants\":\n                return self._send(200, {\"grants\": [\n                    {\"id\": a.subjectKey.split(\":\", 1)[1], **a.value[\"v\"],\n                     \"at\": a.at}\n                    for a in ctx.ledger.query(predicate=\"grant:issued\")]})\n            if path == \"/api/log\":\n                kind = q.get(\"kind\", [None])[0]\n                preds = {\"traces\": \"routing:turn-trace\", \"decisions\": \"decision:score\",\n                         \"steward\": \"idle:steward-run\", \"telemetry\": \"tool:telemetry\",\n                         \"churn\": \"decision:churn\"}.get(kind)\n                rows = ctx.ledger.query(predicate=preds, limit=int(q.get(\"limit\", [100])[0])) \\\n                    if preds else []\n                return self._send(200, {\"rows\": [r.to_row() for r in rows]})\n            if path == \"/api/honesty\":\n                return self._send(200, ctx.honesty())\n            if path == \"/api/connectors\":\n                r = ctx.invoke(\"connector-status\", {})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/archive\":\n                r = ctx.invoke(\"archive-view\", {})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/temporal\":\n                r = ctx.invoke(\"temporal-context\",\n                               {\"horizonDays\": int(q.get(\"days\", [7])[0])})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/speech-floor\":\n                return self._send(200, {\"depth\": ctx.floor.depth(),\n                                        \"played\": ctx.floor.played[-50:]})\n            if path == \"/api/comparisons\":\n                rows = ctx.ledger.query(predicate=\"comparison:run\",\n                                        limit=int(q.get(\"limit\", [20])[0]))\n                return self._send(200, {\"comparisons\": [r.value[\"v\"] for r in rows]})\n            return self._err(\"not found\", 404)\n\n        def do_POST(self):\n            u = urllib.parse.urlparse(self.path)\n            path = u.path\n            body = _json_of(self)\n            if path == \"/api/chat\":\n                r = ctx.invoke(\"run-chat-turn\",\n                               {\"text\": body.get(\"text\", \"\"),\n                                \"all\": bool(body.get(\"all\")),\n                                \"personaId\": body.get(\"personaId\")})\n                return self._send(200, r)\n            if path == \"/api/chat/reset\":\n                r = ctx.invoke(\"chat-reset\", {})\n                return self._send(200, r)\n            if path == \"/api/context/select\":\n                r = ctx.invoke(\"select-context\", body)\n                return self._send(200, r)\n            if path == \"/api/invoke\":\n                # entry-path callTool: stage the need, then fulfill when gate-ready\n                r = ctx.invoke(\"request-tool\",\n                               {\"toolId\": body[\"toolId\"],\n                                \"slots\": body.get(\"slots\") or {},\n                                \"summary\": body.get(\"summary\")})\n                nid = (r.get(\"result\") or {}).get(\"needId\") if r.get(\"ok\") else None\n                if not nid:\n                    return self._send(200, {\"ok\": False, \"error\": r.get(\"error\")})\n                fr = T.fulfill_need(ctx, nid)\n                gate = None\n                if fr.get(\"deferred\"):\n                    gate = fr.get(\"missing\")\n                return self._send(200, {\"ok\": fr.get(\"ok\"), \"needId\": nid,\n                                        \"deferred\": fr.get(\"deferred\"),\n                                        \"missing\": gate,\n                                        \"result\": fr.get(\"result\"),\n                                        \"error\": fr.get(\"error\")})\n            if path == \"/api/grants\":\n                gid = T.issue_grant(ctx, body[\"scope\"], body.get(\"lock\"))\n                return self._send(200, {\"ok\": True, \"grantId\": gid})\n            if path == \"/api/personas\":\n                r = ctx.invoke(\"persona.mint\", body)\n                return self._send(200, r)\n            if path == \"/api/personas/update\":\n                r = ctx.invoke(\"persona-update\", body)\n                return self._send(200, r)\n            if path == \"/api/personas/art\":\n                r = ctx.invoke(\"generate-portrait\",\n                               {\"personaId\": body.get(\"personaId\")})\n                return self._send(200, r)\n            if path == \"/api/calendar/import\":\n                r = ctx.invoke(\"import-calendar\", body)\n                return self._send(200, r)\n            if path == \"/api/exchange/import\":\n                r = ctx.invoke(\"import-exchange\", body)\n                return self._send(200, r)\n            if path == \"/api/exchange/export\":\n                r = ctx.invoke(\"export-exchange\", body)\n                return self._send(200, r)\n            if path == \"/api/stt\":\n                r = ctx.invoke(\"transcribe-speech\", body)\n                return self._send(200, r)\n            if path == \"/api/tts\":\n                r = ctx.invoke(\"speak-voice\", body)\n                return self._send(200, r)\n            if path == \"/api/steward/wake\":\n                r = ctx.invoke(\"steward-tick\", {\"reason\": \"manual\"})\n                return self._send(200, r)\n            if path == \"/api/connectors/configure\":\n                r = ctx.invoke(\"connector-configure\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/connectors/run\":\n                r = ctx.invoke(\"connector-run\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/compare\":\n                r = ctx.invoke(\"compare-run\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/archive/seal\":\n                r = ctx.invoke(\"archive-view\", {\"seal\": True,\n                                              \"reason\": body.get(\"reason\")})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/personas/voice\":\n                r = ctx.invoke(\"persona-voice-set\", body)\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/config\":\n                ctx.append(\"user-settings\", body[\"predicate\"], body[\"value\"],\n                           \"principal\", basis={\"kind\": \"config\"})\n                return self._send(200, {\"ok\": True})\n            if path == \"/api/cleanup\":\n                r = ctx.invoke(\"cleanup-run\", {})\n                return self._send(200, r)\n            if path.startswith(\"/api/needs/\") and path.endswith(\"/focus\"):\n                nid = path.split(\"/\")[3]\n                r = ctx.invoke(\"focus-need\", {\"needId\": nid,\n                                              \"clear\": body.get(\"clear\")})\n                return self._send(200, r)\n            if path.startswith(\"/api/needs/\") and path.endswith(\"/cancel\"):\n                nid = path.split(\"/\")[3]\n                N.close_need(ctx, nid, \"cancelled\", {\"by\": \"api\"}, \"principal\")\n                return self._send(200, {\"ok\": True})\n            if path.startswith(\"/api/needs/\") and path.endswith(\"/candidate\"):\n                nid = path.split(\"/\")[3]\n                aid = N.add_candidate(ctx, nid, body[\"slot\"], body[\"value\"],\n                                      float(body.get(\"confidence\", 0.8)),\n                                      body.get(\"source\", \"user\"), \"principal\")\n                return self._send(200, {\"ok\": True, \"assertionId\": aid})\n            if path.startswith(\"/api/tools/\") and path.endswith(\"/invoke\"):\n                cid = path.split(\"/\")[3]\n                r = ctx.invoke(cid, body.get(\"input\") or {},\n                               grant=body.get(\"grant\"))\n                return self._send(200, r)\n            if path.startswith(\"/api/tools/\") and path.endswith(\"/inspect\"):\n                r = ctx.invoke(\"inspect-tool\", {\"toolId\": path.split(\"/\")[3]})\n                return self._send(200, r)\n            if path == \"/api/library/assert\":\n                a = ctx.append(body[\"subject\"], body[\"predicate\"], body[\"value\"],\n                               \"principal\",\n                               certainty=float(body.get(\"certainty\", 0.9)),\n                               basis={\"kind\": \"user-choice\"},\n                               supersedes=body.get(\"supersedes\"))\n                return self._send(200, {\"ok\": True, \"id\": a.id})\n            return self._err(\"not found\", 404)\n\n        # ---------- SSE: window-presence channel ----------\n        def _sse(self):\n            \"\"\"Server-sent events: bus replay to the UI. The connection's\n            presence is the window-alive signal for close-terminates.\"\"\"\n            srv = self.server\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"text/event-stream\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"Connection\", \"keep-alive\")\n            self.end_headers()\n            q: \"queue.Queue[dict]\" = queue.Queue(maxsize=600)\n            srv.sse_clients.add(q)\n            srv.sse_total += 1\n            try:\n                self.wfile.write(b\": meridian events\\n\\n\")\n                self.wfile.flush()\n                while not srv.shutting_down:\n                    try:\n                        ev = q.get(timeout=5.0)\n                        self.wfile.write((\"data: \" + json.dumps(\n                            ev, ensure_ascii=False) + \"\\n\\n\").encode())\n                    except queue.Empty:\n                        self.wfile.write(b\": ping\\n\\n\")\n                    self.wfile.flush()\n            except Exception:\n                pass\n            finally:\n                srv.sse_clients.discard(q)\n\n        def _static(self, rel):\n            fp = os.path.join(ui_dir, rel.replace(\"/\", os.sep))\n            if not os.path.isfile(fp):\n                return self._err(\"not found\", 404)\n            ctype = {\"html\": \"text/html; charset=utf-8\",\n                     \"js\": \"text/javascript; charset=utf-8\",\n                     \"css\": \"text/css; charset=utf-8\",\n                     \"svg\": \"image/svg+xml\"}.get(fp.rsplit(\".\", 1)[-1], \"text/plain\")\n            with open(fp, \"rb\") as f:\n                self._send(200, f.read(), ctype)\n\n    return H\n\n\ndef projects(ctx) -> list[dict]:\n    out = []\n    for a in ctx.ledger.query(predicate=\"project:exists\"):\n        pid = a.subjectKey.split(\":\", 1)[1]\n        subj = a.subjectKey\n        goals = [r.value[\"v\"] for r in ctx.ledger.query(subject=subj, predicate=\"project:goal\")]\n        linked = [n for n in N.open_needs(ctx) if n[\"spec\"].get(\"project\") == pid]\n        closed = [r for r in ctx.ledger.all()\n                  if r.subjectKey.startswith(\"need:\")\n                  and r.predicate == \"need:fulfilled\"\n                  and (r.value[\"v\"].get(\"detail\") or {}).get(\"project\") == pid]\n        out.append({\"id\": pid, \"title\": a.value[\"v\"].get(\"title\"),\n                    \"goals\": goals, \"openNeeds\": linked,\n                    \"fulfilled\": len(closed)})\n    return out\n\n\ndef state(ctx) -> dict:\n    g = ctx.gate or {}\n    conn = {}\n    try:\n        from . import connectors as C\n        conn = {\"configured\": C.configured(ctx),\n                \"available\": sorted(C.CONNECTORS)}\n    except Exception:\n        conn = {\"configured\": [], \"available\": []}\n    return {\n        \"version\": VERSION,\n        \"honesty\": ctx.honesty(),\n        \"gate\": {\"passed\": g.get(\"passed\"), \"passedAt\": g.get(\"passedAt\"),\n                 \"msToGate\": g.get(\"msToGate\"),\n                 \"inputReady\": g.get(\"inputReady\"),\n                 \"ledgerReady\": g.get(\"ledgerReady\")},\n        \"roster\": ctx.personas.roster(),\n        \"chat\": B.chat_history(ctx, 60),\n        \"topic\": B.current_topic(ctx),\n        \"context\": B.current_context(ctx),\n        \"focus\": B.current_focus(ctx),\n        \"cards\": ctx.bus.recent[-60:],\n        \"needs\": N.open_needs(ctx),\n        \"projects\": projects(ctx),\n        \"tools\": ctx.registry.manifest(),\n        \"admonitions\": ctx.admonitions,\n        \"frame\": ctx.personas.frame(),\n        \"responseDepth\": ctx.response_depth(),\n        \"theme\": ctx.config(\"ui:shell-theme\", \"light\"),\n        \"connectors\": conn,\n        \"speechFloor\": {\"depth\": ctx.floor.depth(),\n                        \"played\": len(ctx.floor.played)},\n        \"emails\": len(ctx.ledger.query(predicate=\"email:message\")),\n    }\n\n\ndef serve(ctx, port: int, ui_dir: str):\n    srv = MeridianServer((\"127.0.0.1\", port), make_handler(ctx, ui_dir))\n    srv.sse_clients = set()\n    srv.sse_total = 0\n    srv.shutting_down = False\n    ctx.bus.subscribe(lambda ev: [\n        _put(q, ev) for q in list(srv.sse_clients)])\n    return srv\n\n\ndef _put(q, ev):\n    try:\n        q.put_nowait(ev)\n    except Exception:\n        pass\n","_meta":{"cognition.ai/linesAdded":1,"cognition.ai/linesRemoved":1}}],"_meta":{"cognition.ai/inferenceToolName":"edit"}}}}
