{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#c3193d417aac4f37975dccaebb07bb1b","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Launch verification probe. Boots a second Meridian instance on port 9761\nwith an isolated runtime dir, polls the API, proves the steward runs while the\nserver answers, and writes evidence/launch/probe-<ts>.json.\n\nUsage: python scripts/probe.py\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nimport urllib.request\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n\n\ndef get(url, timeout=3.0):\n    with urllib.request.urlopen(url, timeout=timeout) as r:\n        return json.loads(r.read().decode())\n\n\ndef main():\n    runtime = os.path.join(ROOT, \"runtime\", \"probe\")\n    os.makedirs(runtime, exist_ok=True)\n    proc = subprocess.Popen(\n        [sys.executable, \"-m\", \"app\", \"--port\", \"9761\",\n         \"--runtime\", runtime],\n        cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n        text=True)\n    out = {\"launched\": False, \"checks\": {}, \"ok\": False}\n    try:\n        # wait for serve\n        base = \"http://127.0.0.1:9761\"\n        for _ in range(60):\n            try:\n                get(base + \"/api/honesty\", timeout=3.0)\n                out[\"launched\"] = True\n                break\n            except Exception:\n                time.sleep(0.5)\n        if not out[\"launched\"]:\n            print(\"FAIL: server did not come up\")\n            return out\n        st = get(base + \"/api/state\")\n        out[\"checks\"][\"state.roster\"] = len(st.get(\"roster\", []))\n        out[\"checks\"][\"state.tools\"] = len(st.get(\"tools\", []))\n        out[\"checks\"][\"honesty.ledger.durable\"] = st[\"honesty\"][\"ledger\"][\"durable\"]\n        out[\"checks\"][\"engine.llm.mode\"] = st[\"honesty\"][\"engines\"][\"llm\"][\"mode\"]\n\u001b[0m[... 276 lines omitted ...]\n    for t in tests:\n        if not dsl.eval_cond(t, scope, ctx):\n            return False\n    return True\n\n\ndef _telemetry(ctx, cid: str, status: str, ms: int,\n               need_id: Optional[str], error: Optional[str] = None):\n    ctx.append(f\"tool:{cid}\", \"tool:telemetry\",\n               {\"status\": status, \"ms\": ms, \"needId\": need_id, \"error\": error},\n               \"tool:registry\", basis={\"kind\": \"execution\"})\n\"\"\"Governed predicate registry. Namespaces are a closed set; names within a\nnamespace are extensible but must be registered here before assertions are\nauthored with them.\n\"\"\"\n\nPREDICATES = {\n    \"product\":    {\"goal\", \"implementation\", \"feedback-policy\"},\n    \"project\":    {\"exists\", \"title\", \"kind\", \"goal\", \"status\", \"focus\", \"member-need\",\n                   \"progress\", \"created-via\"},\n    \"user\":       {\"name\", \"engagement\", \"mood\", \"mood-cleared\", \"editor-proficiency\",\n                   \"ephemeral-cleared\", \"tool-request\", \"persona-frame\"},\n    \"persona\":    {\"exists\", \"name\", \"trait\", \"confidence\", \"voice\", \"voice-remote\",\n                   \"interest\", \"label-color\", \"roster-priority\", \"portrait\", \"role\",\n                   \"style\", \"usagecredential\", \"tool-permission\", \"imitates\",\n                   \"imitation-mark\", \"admonished\", \"lens\", \"responsibility\",\n                   \"display-mode\", \"art\", \"temporal-note\", \"characterization\",\n                   \"mint-refused\"},\n    \"device\":     {\"input-capture\", \"speech-transcript\", \"voice-render\", \"ambient-pickup\"},\n    \"feedback\":   {\"sent\"},\n    \"maxim\":      {\"worldview-anchor\", \"objection\"},\n    \"gap\":        {\"research\"},\n    \"tool\":       {\"exists\", \"definition\", \"telemetry\", \"rank-adjustment\", \"success-rate\",\n                   \"refusal\", \"invocation\"},\n    \"chat\":       {\"user-message\", \"assistant-response\", \"response-depth\", \"topic\",\n                   \"cleared\", \"idle-turn-variant\", \"all-chat\"},\n    \"library\":    {\"acquisition-draft\", \"acquisition-sent\", \"recipient\", \"suggest\"},\n    \"home\":       {\"routine-suggest\", \"actuation-draft\", \"actuation-done\", \"device\"},\n    \"creator\":    {\"milestone-suggest\", \"publish-draft\", \"published\", \"target\"},\n    \"study\":      {\"plan-suggest\", \"export-draft\", \"export-sent\", \"recipient\"},\n    \"travel\":     {\"prep-suggest\", \"itinerary-draft\", \"itinerary-sent\", \"recipient\"},\n    \"routing\":    {\"turn-trace\", \"trace-step\", \"trace-invoke\", \"intent-override\",\n                   \"stewardship-assignment\", \"decision-trace\", \"surface\", \"binding\",\n                   \"respondent-rank\"},\n    \"prompt\":     {\"prep\"},\n    \"source\":     {\"trust-class\", \"confidence\", \"configured\", \"provenance\", \"use\",\n                   \"liveness\", \"model-available\", \"access-policy\", \"adequacy\"},\n    \"need\":       {\"tool-request\", \"response\", \"portrait\", \"countdown\", \"book-find\",\n                   \"open\", \"fulfilled\", \"cancelled\", \"superseded\", \"candidate\",\n                   \"deferred\", \"refined\", \"list-item\", \"generic\", \"set-members\",\n                   \"characterization\", \"nonmatch\"},\n    \"search\":     {\"run\", \"adequacy\", \"source-adequacy\"},\n    \"idle\":       {\"drain-fragment\", \"steward-run\"},\n    \"image\":      {\"asset\", \"candidate\", \"review\", \"subject\"},\n    \"sound\":      {\"soundscape-plan\", \"soundscape-active\", \"cue\"},\n    \"ui\":         {\"panel-request\", \"shell-theme\", \"card\"},\n    \"avqr\":       {\"registration\"},\n    \"exchange\":   {\"bundle-draft\", \"bundle-sent\", \"recipient\", \"imported\", \"package\"},\n    \"storefront\": {\"exists\", \"definition\", \"status\", \"confidence\"},\n    \"codebook\":   {\"entry\", \"manifest\", \"source\"},\n    \"set\":        {\"member\", \"closure\", \"criteria\", \"member-source\"},\n    \"task\":       {\"plan\", \"step\"},\n    \"calendar\":   {\"event\", \"imported\", \"linked\"},\n    \"speech\":     {\"floor-admission\", \"floor-played\", \"voice-set\"},\n    \"comparison\": {\"run\", \"row\"},\n    \"connector\":  {\"configured\", \"run\", \"item\"},\n    \"temporal\":   {\"attention\", \"context\"},\n    \"archive\":    {\"segment\"},\n    \"ethics\":     {\"gate\"},\n    \"grant\":      {\"issued\", \"consumed\", \"revoked\"},\n    \"cleanup\":    {\"run\", \"compacted\", \"consolidated\", \"rule\"},\n    \"studio\":     {\"document\", \"export\"},\n    \"contact\":    {\"exists\", \"id\", \"name\", \"relationship\", \"status\", \"ask\"},\n    \"engine\":     {\"mode\", \"probe\"},\n    \"launch\":     {\"report\", \"honesty\"},\n    \"decision\":   {\"weights\", \"score\", \"churn\", \"respondent\"},\n    \"seed\":       {\"loaded\"},\n}\n\n# Namespaces whose assertions hold *operational* state subject to governed\n# cleanup compaction rules (spent rows may be consolidated).\nOPERATIONAL_NS = {\"need\", \"idle\", \"routing\"}\n\nACTION_THRESHOLD = 0.7      # minimum effective confidence for action/acceptance\nIMPORT_CEILING = 0.4        # imported assertions capped below ACTION_THRESHOLD\n\n\ndef known(predicate: str) -> bool:\n    if \":\" not in predicate:\n        return False\n    ns, name = predicate.split(\":\", 1)\n    return ns in PREDICATES and name in PREDICATES[ns]\n\n\ndef register(predicate: str) -> None:\n    \"\"\"Runtime registration for user-authored predicates (namespaces stay closed).\"\"\"\n    ns, name = predicate.split(\":\", 1)\n    if ns not in PREDICATES:\n        raise ValueError(f\"closed namespace set: '{ns}' is not a governed namespace\")\n    PREDICATES[ns].add(name)"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#c3193d417aac4f37975dccaebb07bb1b","status":"in_progress","content":[{"type":"content","content":{"type":"text","text":"\"\"\"Launch verification probe. Boots a second Meridian instance on port 9761\nwith an isolated runtime dir, polls the API, proves the steward runs while the\nserver answers, and writes evidence/launch/probe-<ts>.json.\n\nUsage: python scripts/probe.py\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nimport urllib.request\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n\n\ndef get(url, timeout=3.0):\n    with urllib.request.urlopen(url, timeout=timeout) as r:\n        return json.loads(r.read().decode())\n\n\ndef main():\n    runtime = os.path.join(ROOT, \"runtime\", \"probe\")\n    os.makedirs(runtime, exist_ok=True)\n    proc = subprocess.Popen(\n        [sys.executable, \"-m\", \"app\", \"--port\", \"9761\",\n         \"--runtime\", runtime],\n        cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n        text=True)\n    out = {\"launched\": False, \"checks\": {}, \"ok\": False}\n    try:\n        # wait for serve\n        base = \"http://127.0.0.1:9761\"\n        for _ in range(60):\n            try:\n                get(base + \"/api/honesty\", timeout=3.0)\n                out[\"launched\"] = True\n                break\n            except Exception:\n                time.sleep(0.5)\n        if not out[\"launched\"]:\n            print(\"FAIL: server did not come up\")\n            return out\n        st = get(base + \"/api/state\")\n        out[\"checks\"][\"state.roster\"] = len(st.get(\"roster\", []))\n        out[\"checks\"][\"state.tools\"] = len(st.get(\"tools\", []))\n        out[\"checks\"][\"honesty.ledger.durable\"] = st[\"honesty\"][\"ledger\"][\"durable\"]\n        out[\"checks\"][\"engine.llm.mode\"] = st[\"honesty\"][\"engines\"][\"llm\"][\"mode\"]\n        # chat round trip\n        t0 = time.time()\n        r = get(base + \"/api/state\")  # warm\n        chat = None\n        try:\n            req = urllib.request.Request(\n                base + \"/api/chat\", data=json.dumps(\n                    {\"text\": \"probe ping\"}).encode(),\n                headers={\"Content-Type\": \"application/json\"})\n            with urllib.request.urlopen(req, timeout=90) as resp:\n                chat = json.loads(resp.read().decode())\n        except Exception as e:\n            chat = {\"ok\": False, \"error\": repr(e)}\n        out[\"checks\"][\"chat.ms\"] = int((time.time() - t0) * 1000)\n        out[\"checks\"][\"chat.ok\"] = bool(chat and chat.get(\"ok\"))\n        out[\"checks\"][\"chat.intents\"] = (chat or {}).get(\"result\", {}).get(\"intents\")\n        # steward ran while serving?\n        runs = get(base + \"/api/log?kind=steward&limit=5\").get(\"rows\", [])\n        out[\"checks\"][\"steward.runs\"] = len(runs)\n        # durability: ledger file exists and non-empty\n        lp = os.path.join(runtime, \"ledger.jsonl\")\n        out[\"checks\"][\"ledger.file.bytes\"] = os.path.getsize(lp) if os.path.exists(lp) else 0\n        out[\"checks\"][\"launch.assertion\"] = bool(get(\n            base + \"/api/library?predicate=launch:report&limit=1\").get(\"rows\"))\n        out[\"ok\"] = (out[\"launched\"] and out[\"checks\"][\"chat.ok\"]\n                     and out[\"checks\"][\"state.tools\"] > 10\n                     and out[\"checks\"][\"ledger.file.bytes\"] > 0)\n        return out\n    finally:\n        proc.terminate()\n        try:\n            proc.wait(timeout=5)\n        except Exception:\n            proc.kill()\n        ts = time.strftime(\"%Y%m%d-%H%M%S\")\n        ep = os.path.join(ROOT, \"evidence\", \"launch\", f\"probe-{ts}.json\")\n        with open(ep, \"w\") as f:\n            json.dump(out, f, indent=2)\n        print(json.dumps(out, indent=2))\n        print(\"probe evidence:\", ep)\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"Invokable component registry: tools, system commands, primitives.\n\n- Tool: user-editable data (template + steps) run by the closed-op executor.\n- System command: object.verb host effect (mint, send, compact, grant...).\n- Primitive: irreducible host verb on a closed allow-list.\n\nGrants are consumable, scoped, witnessed, target-locked. A tool whose template\ndeclares a grant cannot execute without a matching witnessed grant; a request\nthat lacks one resolves to a recorded refusal/deferral, not silent non-action.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom typing import Any, Optional\n\nfrom . import dsl, needs\nfrom .model import new_id, now_ms\n\n\nclass Registry:\n    def __init__(self):\n        self.components: dict[str, dict] = {}\n\n    def register(self, spec: dict) -> dict:\n        cid = spec[\"id\"]\n        spec.setdefault(\"kind\", \"tool\")\n        spec.setdefault(\"template\", {\"slots\": []})\n        spec.setdefault(\"steps\", [])\n        spec.setdefault(\"triggers\", {\"keywords\": [], \"patterns\": []})\n        spec.setdefault(\"need\", None)\n        spec.setdefault(\"editable\", spec[\"kind\"] == \"tool\")\n        self.components[cid] = spec\n        return spec\n\n    def get(self, cid: str) -> Optional[dict]:\n        return self.components.get(cid)\n\n    def tools(self) -> list[dict]:\n        return [s for s in self.components.values() if s[\"kind\"] == \"tool\"]\n\n    def commands(self) -> list[dict]:\n        return [s for s in self.components.values() if s[\"kind\"] == \"system-command\"]\n\n    def primitives(self) -> list[dict]:\n        return [s for s in self.components.values() if s[\"kind\"] == \"primitive\"]\n\n    def manifest(self) -> list[dict]:\n        return [{\n            \"id\": s[\"id\"], \"kind\": s[\"kind\"], \"title\": s.get(\"title\", s[\"id\"]),\n            \"need\": s.get(\"need\"), \"editable\": s.get(\"editable\", False),\n            \"slots\": s.get(\"template\", {}).get(\"slots\", []),\n            \"grant\": s.get(\"template\", {}).get(\"grant\"),\n            \"triggers\": s.get(\"triggers\", {}),\n            \"hasSteps\": bool(s.get(\"steps\")),\n            \"hasFn\": bool(s.get(\"fn\")),\n        } for s in sorted(self.components.values(), key=lambda x: x[\"id\"])]\n\n\n# ---- grants -----------------------------------------------------------------\n\ndef grant_subject(gid: str) -> str:\n    return f\"grant:{gid}\"\n\n\ndef issue_grant(ctx, scope: str, lock: Optional[str] = None,\n                witness: str = \"principal\") -> str:\n    \"\"\"Witnessed grant: an explicit user choice, recorded. Consumable.\"\"\"\n    gid = new_id(\"g\")\n    ctx.append(grant_subject(gid), \"grant:issued\",\n               {\"scope\": scope, \"lock\": lock, \"consumed\": False},\n               witness, basis={\"kind\": \"user-choice\"})\n    return gid\n\n\ndef live_grant(ctx, scope: str, lock: Optional[str] = None) -> Optional[dict]:\n    \"\"\"Find an unconsumed witnessed grant matching scope and lock.\"\"\"\n    for a in ctx.ledger.query(predicate=\"grant:issued\"):\n        v = a.value[\"v\"]\n        if v.get(\"consumed\"):\n            continue\n        if v.get(\"scope\") != scope:\n            continue\n        if v.get(\"lock\") and lock and v[\"lock\"] != lock:\n            continue\n        return {\"id\": a.subjectKey.split(\":\", 1)[1], \"scope\": v[\"scope\"],\n                \"lock\": v.get(\"lock\"), \"assertionId\": a.id}\n    return None\n\n\ndef consume_grant(ctx, gid: str) -> None:\n    subj = grant_subject(gid)\n    rows = ctx.ledger.query(subject=subj, predicate=\"grant:issued\")\n    if not rows:\n        return\n    row = rows[-1]\n    v = dict(row.value[\"v\"]); v[\"consumed\"] = True\n    ctx.append(subj, \"grant:issued\", v, \"system\", supersedes=row.id,\n               basis={\"kind\": \"execution\"})\n    ctx.append(subj, \"grant:consumed\", {\"by\": \"need.fulfill\", \"at\": now_ms()},\n               \"system\", basis={\"kind\": \"execution\"})\n\n\n# ---- template gate ----------------------------------------------------------\n\ndef evaluate_gate(ctx, spec: dict, supplied: dict, nid: Optional[str] = None) -> dict:\n    \"\"\"Entry-path-neutral readiness check. Returns {ready, missing, onOrder,\n    grant}. Required slots need a candidate at/above minCertainty (from\n    supplied input or need:candidate rows).\"\"\"\n    tmpl = spec.get(\"template\") or {}\n    missing, filled = [], {}\n    cands = needs.candidates(ctx, nid) if nid else {}\n    for slot in tmpl.get(\"slots\", []):\n        name = slot[\"name\"]\n        min_c = slot.get(\"minCertainty\", 0.7)\n        val = supplied.get(name)\n        conf = None\n        if val not in (None, \"\"):\n            conf = float(supplied.get(f\"{name}__confidence\", 1.0))\n            if conf >= min_c:\n                filled[name] = {\"value\": val, \"confidence\": conf, \"source\": \"input\"}\n                continue\n        nc = (cands.get(name) or [])\n        if nc and nc[0][\"effectiveConfidence\"] >= min_c:\n            filled[name] = nc[0]\n            continue\n        if slot.get(\"required\", True):\n            missing.append({\"slot\": name, \"minCertainty\": min_c,\n                            \"best\": nc[0][\"effectiveConfidence\"] if nc else None})\n    grant_req = tmpl.get(\"grant\")\n    grant_state = None\n    if grant_req:\n        g = live_grant(ctx, grant_req[\"scope\"], supplied.get(\"lock\") or grant_req.get(\"lock\"))\n        grant_state = {\"required\": True, \"scope\": grant_req[\"scope\"],\n                       \"lock\": grant_req.get(\"lock\"),\n                       \"witnessed\": bool(g), \"grantId\": g[\"id\"] if g else None}\n        if not g:\n            missing.append({\"slot\": \"__grant__\", \"minCertainty\": 1.0,\n                            \"scope\": grant_req[\"scope\"]})\n    return {\"ready\": not missing, \"missing\": missing, \"filled\": filled,\n            \"grant\": grant_state}\n\n\n# ---- invoke / fulfill -------------------------------------------------------\n\ndef invoke(ctx, cid: str, input: Optional[dict] = None,\n           grant: Optional[dict] = None, need_id: Optional[str] = None) -> dict:\n    \"\"\"Invoke a component by id. Honors the gate for templated tools when a\n    need context is given; direct invokes assume operator authority and run.\"\"\"\n    spec = ctx.registry.get(cid)\n    if not spec:\n        return {\"ok\": False, \"error\": f\"unknown component: {cid}\"}\n    input = dict(input or {})\n    scope = dsl.Scope({\"input\": input, \"grant\": grant, \"need\": need_id})\n    t0 = now_ms()\n    try:\n        if spec.get(\"fn\") is not None:\n            out = spec[\"fn\"](ctx, input, grant)\n        else:\n            out = dsl.run_steps(spec.get(\"steps\", []), scope, ctx)\n        dur = now_ms() - t0\n        _telemetry(ctx, cid, \"ok\", dur, need_id)\n        return {\"ok\": True, \"result\": out, \"ms\": dur}\n    except dsl.ToolError as e:\n        _telemetry(ctx, cid, \"failed\", now_ms() - t0, need_id, str(e))\n        return {\"ok\": False, \"error\": str(e), \"data\": e.data}\n    except Exception as e:  # honest failure, recorded\n        _telemetry(ctx, cid, \"error\", now_ms() - t0, need_id, repr(e))\n        return {\"ok\": False, \"error\": repr(e)}\n\n\ndef fulfill_need(ctx, nid: str) -> dict:\n    \"\"\"need.fulfill path: unpack gate, invoke, close or defer the need.\n    Records execution evidence either way. Failed/insufficient results leave\n    the need Open and lower the tool's rank among alternatives (trust churn)\n    without making it ineligible.\"\"\"\n    st = needs.need_state(ctx, nid)\n    if st[\"status\"] != \"open\":\n        return {\"ok\": False, \"error\": f\"need {nid} is {st['status']}\"}\n    spec = st[\"spec\"]\n    cid = spec.get(\"toolId\")\n    if not cid:\n        return {\"ok\": False, \"error\": \"need has no toolId\"}\n    tool = ctx.registry.get(cid)\n    if not tool:\n        needs.defer_need(ctx, nid, \"tool not registered\", [cid], \"system\")\n        return {\"ok\": False, \"error\": f\"tool not registered: {cid}\"}\n    gate = evaluate_gate(ctx, tool, spec.get(\"slots\", {}), nid)\n    if not gate[\"ready\"]:\n        needs.defer_need(ctx, nid, \"requirements on order\",\n                         gate[\"missing\"], \"steward:its\")\n        if gate[\"grant\"] and not gate[\"grant\"][\"witnessed\"]:\n            ctx.append(need := f\"need:{nid}\", \"need:deferred\",\n                       {\"reason\": \"grant-required\",\n                        \"scope\": gate[\"grant\"][\"scope\"]}, \"steward:its\",\n                       basis={\"kind\": \"refusal\"})\n        return {\"ok\": False, \"deferred\": True, \"missing\": gate[\"missing\"]}\n    input_vals = {k: v[\"value\"] for k, v in gate[\"filled\"].items()}\n    input_vals.update({k: v for k, v in spec.get(\"slots\", {}).items()\n                       if not k.endswith(\"__confidence\") and k not in input_vals})\n    grant = None\n    if gate[\"grant\"] and gate[\"grant\"][\"witnessed\"]:\n        grant = {\"id\": gate[\"grant\"][\"grantId\"], \"scope\": gate[\"grant\"][\"scope\"]}\n    ctx.append(f\"need:{nid}\", \"need:fulfilled\",   # in-flight marker superseded at close\n               {\"status\": \"dispatching\", \"toolId\": cid}, \"steward:its\",\n               basis={\"kind\": \"execution\"})\n    res = invoke(ctx, cid, input_vals, grant=grant, need_id=nid)\n    if grant:\n        consume_grant(ctx, grant[\"id\"])\n    adequate = res.get(\"ok\") and _adequate(ctx, spec, res)\n    ctx.decision.record_outcome(cid, nid, bool(res.get(\"ok\")), adequate)\n    if adequate:\n        needs.close_need(ctx, nid, \"fulfilled\",\n                         {\"toolId\": cid, \"result\": res.get(\"result\"),\n                          \"ms\": res.get(\"ms\")}, \"system\")\n        return {\"ok\": True, \"result\": res.get(\"result\")}\n    needs.defer_need(ctx, nid,\n                     \"insufficient result — need remains open for later work\",\n                     spec.get(\"satisfaction\", {}), \"system\")\n    return {\"ok\": False, \"insufficient\": True, \"error\": res.get(\"error\")}\n\n\ndef _adequate(ctx, spec: dict, res: dict) -> bool:\n    \"\"\"Satisfaction conditions: a tool result is adequate only if it matches\n    the need's declared conditions (result.ok plus optional value tests).\"\"\"\n    sat = spec.get(\"satisfaction\") or {}\n    if not res.get(\"ok\"):\n        return False\n    r = res.get(\"result\")\n    if isinstance(r, dict) and r.get(\"ok\") is False:\n        return False\n    tests = sat.get(\"resultTests\") or []\n    scope = dsl.Scope({\"result\": r or {}})\n    for t in tests:\n        if not dsl.eval_cond(t, scope, ctx):\n            return False\n    return True\n\n\ndef _telemetry(ctx, cid: str, status: str, ms: int,\n               need_id: Optional[str], error: Optional[str] = None):\n    ctx.append(f\"tool:{cid}\", \"tool:telemetry\",\n               {\"status\": status, \"ms\": ms, \"needId\": need_id, \"error\": error},\n               \"tool:registry\", basis={\"kind\": \"execution\"})\n\"\"\"Governed predicate registry. Namespaces are a closed set; names within a\nnamespace are extensible but must be registered here before assertions are\nauthored with them.\n\"\"\"\n\nPREDICATES = {\n    \"product\":    {\"goal\", \"implementation\", \"feedback-policy\"},\n    \"project\":    {\"exists\", \"title\", \"kind\", \"goal\", \"status\", \"focus\", \"member-need\",\n                   \"progress\", \"created-via\"},\n    \"user\":       {\"name\", \"engagement\", \"mood\", \"mood-cleared\", \"editor-proficiency\",\n                   \"ephemeral-cleared\", \"tool-request\", \"persona-frame\"},\n    \"persona\":    {\"exists\", \"name\", \"trait\", \"confidence\", \"voice\", \"voice-remote\",\n                   \"interest\", \"label-color\", \"roster-priority\", \"portrait\", \"role\",\n                   \"style\", \"usagecredential\", \"tool-permission\", \"imitates\",\n                   \"imitation-mark\", \"admonished\", \"lens\", \"responsibility\",\n                   \"display-mode\", \"art\", \"temporal-note\", \"characterization\",\n                   \"mint-refused\"},\n    \"device\":     {\"input-capture\", \"speech-transcript\", \"voice-render\", \"ambient-pickup\"},\n    \"feedback\":   {\"sent\"},\n    \"maxim\":      {\"worldview-anchor\", \"objection\"},\n    \"gap\":        {\"research\"},\n    \"tool\":       {\"exists\", \"definition\", \"telemetry\", \"rank-adjustment\", \"success-rate\",\n                   \"refusal\", \"invocation\"},\n    \"chat\":       {\"user-message\", \"assistant-response\", \"response-depth\", \"topic\",\n                   \"cleared\", \"idle-turn-variant\", \"all-chat\"},\n    \"library\":    {\"acquisition-draft\", \"acquisition-sent\", \"recipient\", \"suggest\"},\n    \"home\":       {\"routine-suggest\", \"actuation-draft\", \"actuation-done\", \"device\"},\n    \"creator\":    {\"milestone-suggest\", \"publish-draft\", \"published\", \"target\"},\n    \"study\":      {\"plan-suggest\", \"export-draft\", \"export-sent\", \"recipient\"},\n    \"travel\":     {\"prep-suggest\", \"itinerary-draft\", \"itinerary-sent\", \"recipient\"},\n    \"routing\":    {\"turn-trace\", \"trace-step\", \"trace-invoke\", \"intent-override\",\n                   \"stewardship-assignment\", \"decision-trace\", \"surface\", \"binding\",\n                   \"respondent-rank\"},\n    \"prompt\":     {\"prep\"},\n    \"source\":     {\"trust-class\", \"confidence\", \"configured\", \"provenance\", \"use\",\n                   \"liveness\", \"model-available\", \"access-policy\", \"adequacy\"},\n    \"need\":       {\"tool-request\", \"response\", \"portrait\", \"countdown\", \"book-find\",\n                   \"open\", \"fulfilled\", \"cancelled\", \"superseded\", \"candidate\",\n                   \"deferred\", \"refined\", \"list-item\", \"generic\", \"set-members\",\n                   \"characterization\", \"nonmatch\"},\n    \"search\":     {\"run\", \"adequacy\", \"source-adequacy\"},\n    \"idle\":       {\"drain-fragment\", \"steward-run\"},\n    \"image\":      {\"asset\", \"candidate\", \"review\", \"subject\"},\n    \"sound\":      {\"soundscape-plan\", \"soundscape-active\", \"cue\"},\n    \"ui\":         {\"panel-request\", \"shell-theme\", \"card\"},\n    \"avqr\":       {\"registration\"},\n    \"exchange\":   {\"bundle-draft\", \"bundle-sent\", \"recipient\", \"imported\", \"package\"},\n    \"storefront\": {\"exists\", \"definition\", \"status\", \"confidence\"},\n    \"codebook\":   {\"entry\", \"manifest\", \"source\"},\n    \"set\":        {\"member\", \"closure\", \"criteria\", \"member-source\"},\n    \"task\":       {\"plan\", \"step\"},\n    \"calendar\":   {\"event\", \"imported\", \"linked\"},\n    \"speech\":     {\"floor-admission\", \"floor-played\", \"voice-set\"},\n    \"comparison\": {\"run\", \"row\"},\n    \"connector\":  {\"configured\", \"run\", \"item\"},\n    \"temporal\":   {\"attention\", \"context\"},\n    \"archive\":    {\"segment\"},\n    \"ethics\":     {\"gate\"},\n    \"grant\":      {\"issued\", \"consumed\", \"revoked\"},\n    \"cleanup\":    {\"run\", \"compacted\", \"consolidated\", \"rule\"},\n    \"studio\":     {\"document\", \"export\"},\n    \"contact\":    {\"exists\", \"id\", \"name\", \"relationship\", \"status\", \"ask\"},\n    \"engine\":     {\"mode\", \"probe\"},\n    \"launch\":     {\"report\", \"honesty\"},\n    \"decision\":   {\"weights\", \"score\", \"churn\", \"respondent\"},\n    \"seed\":       {\"loaded\"},\n}\n\n# Namespaces whose assertions hold *operational* state subject to governed\n# cleanup compaction rules (spent rows may be consolidated).\nOPERATIONAL_NS = {\"need\", \"idle\", \"routing\"}\n\nACTION_THRESHOLD = 0.7      # minimum effective confidence for action/acceptance\nIMPORT_CEILING = 0.4        # imported assertions capped below ACTION_THRESHOLD\n\n\ndef known(predicate: str) -> bool:\n    if \":\" not in predicate:\n        return False\n    ns, name = predicate.split(\":\", 1)\n    return ns in PREDICATES and name in PREDICATES[ns]\n\n\ndef register(predicate: str) -> None:\n    \"\"\"Runtime registration for user-authored predicates (namespaces stay closed).\"\"\"\n    ns, name = predicate.split(\":\", 1)\n    if ns not in PREDICATES:\n        raise ValueError(f\"closed namespace set: '{ns}' is not a governed namespace\")\n    PREDICATES[ns].add(name)"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","terminal_exit":{"terminal_id":"378422","exit_code":0,"signal":null}}}}}
