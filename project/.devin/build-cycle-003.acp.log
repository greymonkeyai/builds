a or {}).get(\"id\"),\n               \"personaName\": (persona or {}).get(\"name\", \"Meridian\"),\n               \"cause\": cause, \"voice\": voice or (persona or {}).get(\"voice\") or {},\n               \"position\": self.q.qsize() + 1}\n        self.ctx.append(\"speech\", \"speech:floor-admission\", adm,\n                        \"system\", basis={\"kind\": \"execution\"})\n        if not self.is_alive():\n            self.start()\n        self.q.put(adm)\n        return adm\n\n    def depth(self) -> int:\n        return self.q.qsize()\n\n    # ---- floor worker ----\n\n    def run(self):\n        while not self._stop.is_set():\n            try:\n                adm = self.q.get(timeout=0.5)\n            except queue.Empty:\n                continue\n            t0 = now_ms()\n            r = self.ctx.invoke(\"speak-voice\",\n                                {\"text\": adm[\"text\"], \"personaId\": adm[\"personaId\"],\n                                 \"voice\": adm[\"voice\"]})\n            res = r.get(\"result\") or {}\n            # speak-voice -> renderer invoke -> renderer result: playbackMs\n            # lives at the innermost level of the invoke chain.\n            inner = (res.get(\"result\") or {})\n            if \"result\" in inner and isinstance(inner[\"result\"], dict):\n                inner = inner[\"result\"]\n            rec = {\"admission\": adm[\"id\"], \"at\": now_ms(),\n                   \"personaId\": adm[\"personaId\"],\n                   \"personaName\": adm[\"personaName\"],\n                   \"voice\": adm[\"voice\"], \"ok\": bool(r.get(\"ok\")),\n                   \"renderedBy\": res.get(\"renderedBy\"),\n                   \"ms\": now_ms() - t0,\n                   \"playbackMs\": inner.get(\"playbackMs\"),\n                   \"heldUntilPlaybackComplete\": True,\n                   \"error\": r.get(\"error\") or res.get(\"error\")}\n            self.played.append(rec)\n            self.ctx.append(\"speech\", \"speech:floor-played\", rec,\n                            \"engine:tts\", basis={\"kind\": \"execution\"})\n            self.ctx.emit(\"card\", {\"kind\": \"speech\", \"summary\":\n                                   f\"{adm['personaName']} spoke \"\n                                   f\"({rec['renderedBy'] or 'unrendered'})\",\n                                   \"floor\": rec, \"at\": now_ms()})\n            self.q.task_done()\n\n    def drain(self, timeout: float = 30.0) -> bool:\n        \"\"\"Wait until the queue is empty (test/demo seam).\"\"\"\n        import time\n        t0 = time.time()\n        while not self.q.empty() and time.time() - t0 < timeout:\n            time.sleep(0.05)\n        t1 = time.time()\n        while self.played and time.time() - t1 < 10:\n            # give last render a beat to record\n            return True\n        return self.q.empty()\n\n    def stop(self):\n        self._stop.set()\n","_meta":{"cognition.ai/linesAdded":5,"cognition.ai/linesRemoved":1}}],"_meta":{"cognition.ai/inferenceToolName":"edit"}}}}
