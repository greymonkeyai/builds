{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"similar-snowdrop","update":{"sessionUpdate":"tool_call","toolCallId":"edit:1#925761fb62b5487c87789bc054046ace","title":"Edited C:\\builds\\project\\version 0.3.0.003\\app\\api.py","kind":"edit","content":[{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.003\\app\\api.py","oldText":"\"\"\"HTTP API + static UI server (stdlib only).\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport queue\nimport socket\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nfrom . import builtins as B\nfrom . import needs as N\nfrom . import tools as T\nfrom .host import VERSION\n\n\nclass MeridianServer(ThreadingHTTPServer):\n    \"\"\"Exclusive-bind HTTP server: SO_EXCLUSIVEADDRUSE on Windows so a second\n    instance can never silently share the port (G4), plus SSE client tracking\n    for close-terminates lifecycle.\"\"\"\n    daemon_threads = True\n\n    def server_bind(self):\n        if os.name == \"nt\":\n            try:\n                self.socket.setsockopt(socket.SOL_SOCKET,\n                                       socket.SO_EXCLUSIVEADDRUSE, 1)\n            except OSError:\n                pass\n        super().server_bind()\n\n\ndef _json_of(handler) -> dict:\n    n = int(handler.headers.get(\"Content-Length\") or 0)\n    if not n:\n        return {}\n    return json.loads(handler.rfile.read(n).decode())\n\n\ndef make_handler(ctx, ui_dir):\n    class H(BaseHTTPRequestHandler):\n        protocol_version = \"HTTP/1.1\"\n\n        def log_message(self, *a):\n            pass\n\n        # ---------- helpers ----------\n        def _send(self, code, body, ctype=\"application/json\"):\n            data = body if isinstance(body, (bytes,)) else json.dumps(\n                body, ensure_ascii=False).encode()\n            self.send_response(code)\n            self.send_header(\"Content-Type\",\n                             ctype if isinstance(body, bytes) else\n                             \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(data)))\n            self.end_headers()\n            self.wfile.write(data)\n\n        def _err(self, msg, code=400):\n            self._send(code, {\"ok\": False, \"error\": msg})\n\n        # ---------- routes ----------\n        def do_GET(self):\n            u = urllib.parse.urlparse(self.path)\n            path, q = u.path, urllib.parse.parse_qs(u.query)\n            if path in (\"/\", \"/index.html\"):\n                return self._static(\"index.html\")\n            if path.startswith(\"/ui/\"):\n                return self._static(path[4:])\n            if path == \"/api/version\":\n                return self._send(200, {\"app\": \"meridian\", \"version\": VERSION,\n                                        \"gate\": (ctx.gate or {}).get(\"passed\"),\n                                        \"gatePassedAt\": (ctx.gate or {}).get(\"passedAt\")})\n            if path == \"/api/gate\":\n                return self._send(200, ctx.gate or {\"passed\": None})\n            if path == \"/api/events\":\n                return self._sse()\n            if path == \"/api/state\":\n                return self._send(200, state(ctx))\n            if path == \"/api/context\":\n                return self._send(200, {\"context\": B.current_context(ctx),\n                                        \"focus\": B.current_focus(ctx),\n                                        \"topic\": B.current_topic(ctx)})\n            if path == \"/api/emails\":\n                rows = ctx.ledger.query(predicate=\"email:message\",\n                                        limit=int(q.get(\"limit\", [50])[0]))\n                return self._send(200, {\"emails\": [\n                    {\"id\": r.id, **r.value[\"v\"], \"at\": r.at}\n                    for r in rows]})\n            if path == \"/api/tools\":\n                return self._send(200, {\"tools\": ctx.registry.manifest()})\n            if path == \"/api/needs\":\n                return self._send(200, {\"open\": N.open_needs(ctx)})\n            if path == \"/api/cards\":\n                return self._send(200, {\"events\": ctx.bus.recent[-200:]})\n            if path == \"/api/library\":\n                rows = ctx.ledger.query(\n                    predicate=q.get(\"predicate\", [None])[0],\n                    subject=q.get(\"subject\", [None])[0],\n                    limit=int(q.get(\"limit\", [200])[0]))\n                if q.get(\"q\"):\n                    rows = ctx.ledger.search(q[\"q\"][0], 200)\n                return self._send(200, {\"rows\": [r.to_row() for r in rows],\n                                        \"stats\": ctx.ledger.stats()})\n            if path == \"/api/view\":\n                return self._send(200, ctx.ledger.render_view(q[\"subject\"][0]))\n            if path == \"/api/candidates\":\n                return self._send(200, {\"candidates\": ctx.ledger.candidates_for(\n                    q[\"subject\"][0], q[\"predicate\"][0])})\n            if path == \"/api/projects\":\n                return self._send(200, {\"projects\": projects(ctx)})\n            if path == \"/api/calendar\":\n                return self._send(200, {\"events\": [\n                    r.value[\"v\"] | {\"assertionId\": r.id, \"at\": r.at}\n                    for r in ctx.ledger.query(predicate=\"calendar:event\")]})\n            if path == \"/api/grants\":\n                return self._send(200, {\"grants\": [\n                    {\"id\": a.subjectKey.split(\":\", 1)[1], **a.value[\"v\"],\n                     \"at\": a.at}\n                    for a in ctx.ledger.query(predicate=\"grant:issued\")]})\n            if path == \"/api/log\":\n                kind = q.get(\"kind\", [None])[0]\n                preds = {\"traces\": \"routing:turn-trace\", \"decisions\": \"decision:score\",\n                         \"steward\": \"idle:steward-run\", \"telemetry\": \"tool:telemetry\",\n                         \"churn\": \"decision:churn\"}.get(kind)\n                rows = ctx.ledger.query(predicate=preds, limit=int(q.get(\"limit\", [100])[0])) \\\n                    if preds else []\n                return self._send(200, {\"rows\": [r.to_row() for r in rows]})\n            if path == \"/api/honesty\":\n                return self._send(200, ctx.honesty())\n            if path == \"/api/connectors\":\n                r = ctx.invoke(\"connector-status\", {})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/archive\":\n                r = ctx.invoke(\"archive-view\", {})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/temporal\":\n                r = ctx.invoke(\"temporal-context\",\n                               {\"horizonDays\": int(q.get(\"days\", [7])[0])})\n                return self._send(200, r.get(\"result\") or r)\n            if path == \"/api/speech-floor\":\n                return self._send(200, {\"depth\": ctx.floor.depth(),\n                                        \"played\": ctx.floor.played[-50:]})\n            if path == \"/api/comparisons\":\n                rows = ctx.ledger.query(predicate=\"comparison:run\",\n                                        limit=int(q.get(\"limit\", [20])[0]))\n                return self._send(200, {\"comparisons\": [r.value[\"v\"] for r in rows]})\n            return self._err(\"not found\", 404)\n\n        def do_POST(self):\n            u = urllib.parse.urlparse(self.path)\n            path = u.path\n            body = _json_of(self)\n            if path == \"/api/chat\":\n                r = ctx.invoke(\"run-chat-turn\",\n                               {\"text\": body.get(\"text\", \"\"),\n                                \"all\": bool(body.get(\"all\"))})\n                return self._send(200, r)\n            if path == \"/api/invoke\":\n                # entry-path callTool: