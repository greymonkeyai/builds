    if path == \"/api/cleanup\":\n238:            if path.startswith(\"/api/needs/\") and path.endswith(\"/focus\"):\n243:            if path.startswith(\"/api/needs/\") and path.endswith(\"/cancel\"):\n247:            if path.startswith(\"/api/needs/\") and path.endswith(\"/candidate\"):\n253:            if path.startswith(\"/api/tools/\") and path.endswith(\"/invoke\"):\n258:            if path.startswith(\"/api/tools/\") and path.endswith(\"/inspect\"):\n261:            if path == \"/api/library/assert\":\n271:        def _sse(self):\n299:        def _static(self, rel):"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
