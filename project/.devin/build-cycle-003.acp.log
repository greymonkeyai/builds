h()\n            except Exception:\n                pass\n            finally:\n                srv.sse_clients.discard(q)\n\n        def _static(self, rel):\n            fp = os.path.join(ui_dir, rel.replace(\"/\", os.sep))\n            if not os.path.isfile(fp):"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
