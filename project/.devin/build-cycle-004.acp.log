 \"bun\", \"crest\", \"long\", \"bald\", \"part\")\nEYES = (\"round\", \"almond\", \"narrow\", \"bright\")\nMOUTHS = (\"smile\", \"flat\", \"smirk\", \"open\")\nCOLLARS = (\"crew\", \"v\", \"collar\", \"scarf\")\ndef _seed(pid: str, name: str) -> int:\n    return int(hashlib.sha256(f\"{pid}:{name}\".encode()).hexdigest()[:12], 16)\ndef params_for(pid: str, name: str) -> dict:\n    s = _seed(pid, name)\n    pick = lambda arr, shift=0: arr[(s >> (shift * 4)) % len(arr)]\n    return {\n        \"seed\": hex(s), \"palette\": pick(PALETTES, 0), \"motif\": pick(MOTIFS, 1),\n        \"hair\": pick(HAIRS, 2), \"eyes\": pick(EYES, 3),\n        \"mouth\": pick(MOUTHS, 4), \"collar\": pick(COLLARS, 5),\n        \"glasses\": bool((s >> 24) & 1), \"earring\": bool((s >> 25) & 1),\n        \"tilt\": ((s >> 26) % 9) - 4, \"brow\": (s >> 30) % 3,\n        \"blush\": bool((s >> 31) & 1),\n    }\ndef _motif_svg(motif: str, p: dict) -> str:\n    pal = p[\"palette\"]\n    a = pal[\"accent\"]\n    if motif == \"peaks\":\n        return (f'<path d=\"M0 210 L60 120 L120 200 L180 100 L260 210 Z\" '\n                f'fill=\"{a}\" opacity=\"0.25\"/>')\n    if motif == \"waves\":\n        return (f'<path d=\"M0 200 Q60 170 130 200 T260 200 L260 260 L0 260 Z\" '\n                f'fill=\"{a}\" opacity=\"0.25\"/>')\n    if motif == \"orbit\":\n        return (f'<circle cx=\"130\" cy=\"80\" r=\"46\" fill=\"none\" stroke=\"{a}\" '\n                f'stroke-width=\"6\" opacity=\"0.3\"/>'\n                f'<circle cx=\"130\" cy=\"80\" r=\"10\" fill=\"{a}\" opacity=\"0.5\"/>')\napp/builtins.py:398:    \"\"\"Extend a minimal persona: portrait, voice, characterization — each\napp/builtins.py:405:    art_res = ctx.invoke(\"generate-portrait\", {\"personaId\": pid},\napp/builtins.py:406:                         summary=\"onboard:portrait\", via=\"onboard\")\napp/builtins.py:407:    out[\"portrait\"] = art_res.get(\"result\")\napp/builtins.py:418:                    (out[\"portrait\"], out[\"voice\"], out[\"characterization\"]))\napp/builtins.py:420:def h_generate_portrait(ctx, slots, nid):\napp/builtins.py:426:    r = art.generate(ctx, pid, p[\"name\"], mark=p.get(\"mark\"))\napp/builtins.py:433:                   claimant=\"engine:portrait\", certainty=1.0,\napp/builtins.py:846:    R.tool(\"generate-portrait\", \"Generate + bind persona portrait\",\napp/builtins.py:847:           need=\"persona.portrait\",\napp/builtins.py:849:           handler=h_generate_portrait)\napp/personas.py:5:the ledger view. Mint assigns identity at once, then portrait / voice /"}}],"_meta":{"cognition.ai/inferenceToolName":"exec","cognition.ai/terminalPreview":true}}}}
