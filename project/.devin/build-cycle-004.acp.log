{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"flax-utensil","update":{"sessionUpdate":"tool_call","toolCallId":"write:1#dac57856c49d432aa44aa48d55d887fb","title":"Wrote C:\\builds\\project\\version 0.3.0.004\\app\\speechfloor.py","kind":"edit","content":[{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\speechfloor.py","newText":"\"\"\"Speech floor (C-SpeechFloor) — serialized playback admission.\n\nOne render at a time through a host queue. Admission holds until playback\nactually completes: the local renderer blocks on the audio device, and the\nplayed row carries a MEASURED playbackMs. Where no real playback happened no\nplaybackMs is claimed (J2 discipline — populated fields or no claim).\n\"\"\"\nfrom __future__ import annotations\n\nimport queue\nimport threading\nimport time\n\n\nclass SpeechFloor:\n    def __init__(self, ctx):\n        self.ctx = ctx\n        self.q = queue.Queue()\n        self.played = []          # [{persona, text, playbackMs, at}]\n        self.holds = []           # admission log\n        self.worker = threading.Thread(target=self._loop, daemon=True)\n        self.worker.start()\n\n    @property\n    def depth(self):\n        return self.q.qsize()\n\n    def admit(self, persona: str, text: str, voice=None, rate=0,\n              render=True) -> dict:\n        item = {\"persona\": persona, \"text\": text, \"voice\": voice,\n                \"rate\": rate, \"render\": render, \"at\": time.time(),\n                \"done\": threading.Event(), \"result\": None}\n        self.q.put(item)\n        self.ctx.ledger.say(\"speech:floor\", \"speech:admitted\",\n                            {\"persona\": persona, \"chars\": len(text),\n                             \"depth\": self.depth},\n                            claimant=\"persona:\" + persona, certainty=1.0,\n                            basis={\"kind\": \"execution\"})\n        return item\n\n    def wait(self, item, timeout=180):\n        item[\"done\"].wait(timeout)\n        return item[\"result\"]\n\n    def drain(self, timeout=240):\n        t0 = time.time()\n        while self.depth and time.time() - t0 < timeout:\n            time.sleep(0.4)\n\n    def _loop(self):\n        while True:\n            item = self.q.get()\n            if item is None:\n                return\n            res = {\"ok\": True, \"persona\": item[\"persona\"]}\n            if item[\"render\"]:\n                r = self.ctx.engines.tts.render_local(\n                    item[\"text\"], voice=item[\"voice\"], rate=item[\"rate\"])\n                res.update(r)\n            else:\n                res.update({\"engine\": \"none\", \"playbackMs\": None,\n                            \"heldUntilPlaybackComplete\": False})\n            entry = {\"persona\": item[\"persona\"],\n                     \"text\": item[\"text\"][:160],\n                     \"engine\": res.get(\"engine\"),\n                     \"at\": item[\"at\"]}\n            if res.get(\"playbackMs\") is not None:\n                entry[\"playbackMs\"] = res[\"playbackMs\"]\n                entry[\"heldUntilPlaybackComplete\"] = True\n            self.played.append(entry)\n            self.holds.append(entry)\n            self.ctx.ledger.say(\"speech:floor\", \"speech:played\", entry,\n                                claimant=\"system\", certainty=1.0,\n                                basis={\"kind\": \"execution\"})\n            item[\"result\"] = res\n            item[\"done\"].set()\n            self.q.task_done()\n","_meta":{"cognition.ai/linesAdded":77,"cognition.ai/linesRemoved":0}}],"rawInput":{"file_path":"C:\\builds\\project\\version 0.3.0.004\\app\\speechfloor.py","content":"\"\"\"Speech floor (C-SpeechFloor) — serialized playback admission.\n\nOne render at a time through a host queue. Admission holds until playback\nactually completes: the local renderer blocks on the audio device, and the\nplayed row carries a MEASURED playbackMs. Where no real playback happened no\nplaybackMs is claimed (J2 discipline — populated fields or no claim).\n\"\"\"\nfrom __future__ import annotations\n\nimport queue\nimport threading\nimport time\n\n\nclass SpeechFloor:\n    def __init__(self, ctx):\n        self.ctx = ctx\n        self.q = queue.Queue()\n        self.played = []          # [{persona, text, playbackMs, at}]\n        self.holds = []           # admission log\n        self.worker = threading.Thread(target=self._loop, daemon=True)\n        self.worker.start()\n\n    @property\n    def depth(self):\n        return self.q.qsize()\n\n    def admit(self, persona: str, text: str, voice=None, rate=0,\n              render=True) -> dict:\n        item = {\"persona\": persona, \"text\": text, \"voice\": voice,\n                \"rate\": rate, \"render\": render, \"at\": time.time(),\n                \"done\": threading.Event(), \"result\": None}\n        self.q.put(item)\n        self.ctx.ledger.say(\"speech:floor\", \"speech:admitted\",\n                            {\"persona\": persona, \"chars\": len(text),\n                             \"depth\": self.depth},\n                            claimant=\"persona:\" + persona, certainty=1.0,\n                            basis={\"kind\": \"execution\"})\n        return item\n\n    def wait(self, item, timeout=180):\n        item[\"done\"].wait(timeout)\n        return item[\"result\"]\n\n    def drain(self, timeout=240):\n        t0 = time.time()\n        while self.depth and time.time() - t0 < timeout:\n            time.sleep(0.4)\n\n    def _loop(self):\n        while True:\n            item = self.q.get()\n            if item is None:\n                return\n            res = {\"ok\": True, \"persona\": item[\"persona\"]}\n            if item[\"render\"]:\n                r = self.ctx.engines.tts.render_local(\n                    item[\"text\"], voice=item[\"voice\"], rate=item[\"rate\"])\n                res.update(r)\n            else:\n                res.update({\"engine\": \"none\", \"playbackMs\": None,\n                            \"heldUntilPlaybackComplete\": False})\n            entry = {\"persona\": item[\"persona\"],\n                     \"text\": item[\"text\"][:160],\n                     \"engine\": res.get(\"engine\"),\n                     \"at\": item[\"at\"]}\n            if res.get(\"playbackMs\") is not None:\n                entry[\"playbackMs\"] = res[\"playbackMs\"]\n                entry[\"heldUntilPlaybackComplete\"] = True\n            self.played.append(entry)\n            self.holds.append(entry)\n            self.ctx.ledger.say(\"speech:floor\", \"speech:played\", entry,\n                                claimant=\"system\", certainty=1.0,\n                                basis={\"kind\": \"execution\"})\n            item[\"result\"] = res\n            item[\"done\"].set()\n            self.q.task_done()\n"},"_meta":{"cognition.ai/suppressApproval":true,"cognition.ai/inferenceToolName":"write","cognition.ai/timestamp":"2026-11-23T08:54:54.800590600+00:00"}}}}
