{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"flax-utensil","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#e009125add8844aba42ed4206aba9cf0","status":"in_progress","content":[{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\archive.py","oldText":"\"\"\"Conversation archive (C-ConversationArchive).\r\r\n\r\r\nEvery turn is archived; topic segments are bounded by topic-set and reset\r\r\nmarkers. Reset seals the current segment into an `archive:segment`\r\r\ndurable-result row — the transcript survives, the live context clears, so\r\r\npersona prompts stay on-topic.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nfrom . import model\r\r\n\r\r\n\r\r\ndef archive_turn(ctx, turn: dict):\r\r\n    ctx.ledger.say(\"chat\", \"archive:turn\", turn,\r\r\n                   claimant=\"system\", certainty=1.0,\r\r\n                   basis={\"kind\": \"durable-result\"},\r\r\n                   tags=[\"archive\"])\r\r\n\r\r\n\r\r\ndef set_topic(ctx, topic: str):\r\r\n    prev = ctx.ledger.resolve(\"chat\", \"chat:topic\")\r\r\n    ctx.ledger.say(\"chat\", \"chat:topic\", {\"topic\": topic},\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"},\r\r\n                   supersedes=prev.id if prev else None)\r\r\n    return {\"ok\": True, \"topic\": topic}\r\r\n\r\r\n\r\r\ndef topic(led) -> str:\r\r\n    a = led.resolve(\"chat\", \"chat:topic\")\r\r\n    return (a.value.get(\"v\") or {}).get(\"topic\", \"\") if a else \"\"\r\r\n\r\r\n\r\r\ndef context(led):\r\r\n    a = led.resolve(\"chat\", \"chat:context\")\r\r\n    return a.value.get(\"v\") if a else None\r\r\n\r\r\n\r\r\ndef select_context(ctx, kind: str, ref: str, label: str,\r\r\n                   excerpt: str = \"\") -> dict:\r\r\n    \"\"\"Pull an email/profile/need into conversational context; the top\r\r\n    respondent comments on the selection.\"\"\"\r\r\n    prev = ctx.ledger.resolve(\"chat\", \"chat:context\")\r\r\n    ctx.ledger.say(\"chat\", \"chat:context\",\r\r\n                   {\"kind\": kind, \"ref\": ref, \"label\": label,\r\r\n                    \"excerpt\": excerpt[:600]},\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"},\r\r\n                   supersedes=prev.id if prev else None)\r\r\n    return {\"ok\": True, \"context\": {\"kind\": kind, \"ref\": ref, \"label\": label}}\r\r\n\r\r\n\r\r\ndef reset(ctx) -> dict:\r\r\n    \"\"\"Seal the conversation: archive the segment, clear topic/context/focus.\"\"\"\r\r\n    led = ctx.ledger\r\r\n    turns = led.query(predicate=\"archive:turn\", limit=500)\r\r\n    last_reset = led.resolve(\"chat\", \"archive:segment\")\r\r\n    since = last_reset.at if last_reset else 0\r\r\n    seg = [t for t in turns if t.at > since]\r\r\n    led.say(\"chat\", \"archive:segment\",\r\r\n            {\"turns\": len(seg), \"sealedAt\": model.ms(),\r\r\n             \"topic\": topic(led)},\r\r\n            claimant=\"system\", certainty=1.0,\r\r\n            basis={\"kind\": \"durable-result\"}, tags=[\"archive\"])\r\r\n    for pred in (\"chat:topic\", \"chat:context\", \"chat:focus\"):\r\r\n        a = led.resolve(\"chat\", pred)\r\r\n        if a:\r\r\n            led.say(\"chat\", pred, None, claimant=\"system\", certainty=1.0,\r\r\n                    basis={\"kind\": \"config\"}, supersedes=a.id)\r\r\n    return {\"ok\": True, \"sealedTurns\": len(seg)}\r\r\n","newText":"\"\"\"Conversation archive (C-ConversationArchive).\nEvery turn is archived; topic segments are bounded by topic-set and reset\nmarkers. Reset seals the current segment into an `archive:segment`\ndurable-result row — the transcript survives, the live context clears, so\npersona prompts stay on-topic.\n\"\"\"\nfrom __future__ import annotations\nfrom . import model\ndef archive_turn(ctx, turn: dict):\n    ctx.ledger.say(\"chat\", \"archive:turn\", turn,\n                   claimant=\"system\", certainty=1.0,\n                   basis={\"kind\": \"durable-result\"},\n                   tags=[\"archive\"])\ndef set_topic(ctx, topic: str):\n    prev = ctx.ledger.resolve(\"chat\", \"chat:topic\")\n    ctx.ledger.say(\"chat\", \"chat:topic\", {\"topic\": topic},\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"},\n                   supersedes=prev.id if prev else None)\n    return {\"ok\": True, \"topic\": topic}\ndef topic(led) -> str:\n    a = led.resolve(\"chat\", \"chat:topic\")\n    return (a.value.get(\"v\") or {}).get(\"topic\", \"\") if a else \"\"\ndef context(led):\n    a = led.resolve(\"chat\", \"chat:context\")\n    return a.value.get(\"v\") if a else None\ndef select_context(ctx, kind: str, ref: str, label: str,\n                   excerpt: str = \"\") -> dict:\n    \"\"\"Pull an email/profile/need into conversational context; the top\n    respondent comments on the selection.\"\"\"\n    prev = ctx.ledger.resolve(\"chat\", \"chat:context\")\n    ctx.ledger.say(\"chat\", \"chat:context\",\n                   {\"kind\": kind, \"ref\": ref, \"label\": label,\n                    \"excerpt\": excerpt[:600]},\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"},\n                   supersedes=prev.id if prev else None)\n    return {\"ok\": True, \"context\": {\"kind\": kind, \"ref\": ref, \"label\": label}}\ndef reset(ctx) -> dict:\n    \"\"\"Seal the conversation: archive the segment, clear topic/context/focus.\"\"\"\n    led = ctx.ledger\n    turns = led.query(predicate=\"archive:turn\", limit=500)\n    last_reset = led.resolve(\"chat\", \"archive:segment\")\n    since = last_reset.at if last_reset else 0\n    seg = [t for t in turns if t.at > since]\n    led.say(\"chat\", \"archive:segment\",\n            {\"turns\": len(seg), \"sealedAt\": model.ms(),\n             \"topic\": topic(led)},\n            claimant=\"system\", certainty=1.0,\n            basis={\"kind\": \"durable-result\"}, tags=[\"archive\"])\n    for pred in (\"chat:topic\", \"chat:context\", \"chat:focus\"):\n        a = led.resolve(\"chat\", pred)\n        if a:\n            led.say(\"chat\", pred, None, claimant=\"system\", certainty=1.0,\n                    basis={\"kind\": \"config\"}, supersedes=a.id)\n    return {\"ok\": True, \"sealedTurns\": len(seg)}\n","_meta":{"cognition.ai/linesAdded":56,"cognition.ai/linesRemoved":140}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\art.py","oldText":"\"\"\"Procedural persona portraits (C-PersonalityArt / C-PresentationGlass).\r\r\n\r\r\nEach personality's art is unique to that personality: a deterministic seed\r\r\nderived from identity drives face geometry, palette, hair style, eyes, brows,\r\r\nmouth, collar, glasses, and a background motif. The SVG is written as a\r\r\ndurable artifact under runtime/artifacts/persona-art/ and bound to the\r\r\npersona by a `persona:art` assertion carrying the same parameters — art is\r\r\nbound to the persona, not just generated near it.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport hashlib\r\r\nimport os\r\r\n\r\r\n\r\r\nPALETTES = [\r\r\n    {\"skin\": \"#f2c9a4\", \"hair\": \"#4a3121\", \"bg1\": \"#1d3557\", \"bg2\": \"#457b9d\",\r\r\n     \"accent\": \"#e63946\"},\r\r\n    {\"skin\": \"#e8b88a\", \"hair\": \"#1c1c1c\", \"bg1\": \"#2a4d3a\", \"bg2\": \"#6b9e78\",\r\r\n     \"accent\": \"#f4a261\"},\r\r\n    {\"skin\": \"#d9a066\", \"hair\": \"#5c3a21\", \"bg1\": \"#503a6e\", \"bg2\": \"#8d6fc0\",\r\r\n     \"accent\": \"#ffd166\"},\r\r\n    {\"skin\": \"#f5d0b0\", \"hair\": \"#8a4b2a\", \"bg1\": \"#693a3a\", \"bg2\": \"#a86b6b\",\r\r\n     \"accent\": \"#a8dadc\"},\r\r\n    {\"skin\": \"#c98f5f\", \"hair\": \"#2f2f2f\", \"bg1\": \"#1f4e5f\", \"bg2\": \"#4f8a9b\",\r\r\n     \"accent\": \"#e9c46a\"},\r\r\n    {\"skin\": \"#ecc39b\", \"hair\": \"#6e4b2a\", \"bg1\": \"#3c4a2e\", \"bg2\": \"#77895c\",\r\r\n     \"accent\": \"#ef8354\"},\r\r\n    {\"skin\": \"#dfb185\", \"hair\": \"#7a2e2e\", \"bg1\": \"#34435e\", \"bg2\": \"#6d7fa3\",\r\r\n     \"accent\": \"#9bf6ff\"},\r\r\n    {\"skin\": \"#f0c8a8\", \"hair\": \"#3d2b1f\", \"bg1\": \"#4d3b5e\", \"bg2\": \"#9370b8\",\r\r\n     \"accent\": \"#ffc6ff\"},\r\r\n]\r\r\n\r\r\nMOTIFS = (\"peaks\", \"waves\", \"orbit\", \"lattice\", \"sunrise\", \"grove\")\r\r\nHAIRS = (\"crop\", \"wave\", \"bob\", \"bun\", \"crest\", \"long\", \"bald\", \"part\")\r\r\nEYES = (\"round\", \"almond\", \"narrow\", \"bright\")\r\r\nMOUTHS = (\"smile\", \"flat\", \"smirk\", \"open\")\r\r\nCOLLARS = (\"crew\", \"v\", \"collar\", \"scarf\")\r\r\n\r\r\n\r\r\ndef _seed(pid: str, name: str) -> int:\r\r\n    return int(hashlib.sha256(f\"{pid}:{name}\".encode()).hexdigest()[:12], 16)\r\r\n\r\r\n\r\r\ndef params_for(pid: str, name: str) -> dict:\r\r\n    s = _seed(pid, name)\r\r\n    pick = lambda arr, shift=0: arr[(s >> (shift * 4)) % len(arr)]\r\r\n    return {\r\r\n        \"seed\": hex(s), \"palette\": pick(PALETTES, 0), \"motif\": pick(MOTIFS, 1),\r\r\n        \"hair\": pick(HAIRS, 2), \"eyes\": pick(EYES, 3),\r\r\n        \"mouth\": pick(MOUTHS, 4), \"collar\": pick(COLLARS, 5),\r\r\n        \"glasses\": bool((s >> 24) & 1), \"earring\": bool((s >> 25) & 1),\r\r\n        \"tilt\": ((s >> 26) % 9) - 4, \"brow\": (s >> 30) % 3,\r\r\n        \"blush\": bool((s >> 31) & 1),\r\r\n    }\r\r\n\r\r\n\r\r\ndef _motif_svg(motif: str, p: dict) -> str:\r\r\n    pal = p[\"palette\"]\r\r\n    a = pal[\"accent\"]\r\r\n    if motif == \"peaks\":\r\r\n        return (f'<path d=\"M0 210 L60 120 L120 200 L180 100 L260 210 Z\" '\r\r\n                f'fill=\"{a}\" opacity=\"0.25\"/>')\r\r\n    if motif == \"waves\":\r\r\n        return (f'<path d=\"M0 200 Q60 170 130 200 T260 200 L260 260 L0 260 Z\" '\r\r\n                f'fill=\"{a}\" opacity=\"0.25\"/>')\r\r\n    if motif == \"orbit\":\r\r\n        return (f'<circle cx=\"130\" cy=\"80\" r=\"46\" fill=\"none\" stroke=\"{a}\" '\r\r\n                f'stroke-width=\"6\" opacity=\"0.3\"/>'\r\r\n                f'<circle cx=\"130\" cy=\"80\" r=\"10\" fill=\"{a}\" opacity=\"0.5\"/>')\r\r\n    if motif == \"lattice\":\r\r\n        return \"\".join(\r\r\n            f'<rect x=\"{20+i*40}\" y=\"{20+(i%3)*30}\" width=\"16\" height=\"16\" '\r\r\n            f'fill=\"{a}\" opacity=\"0.22\" transform=\"rotate(45 {28+i*40} '\r\r\n            f'{28+(i%3)*30})\"/>' for i in range(6))\r\r\n    if motif == \"sunrise\":\r\r\n        return (f'<circle cx=\"130\" cy=\"230\" r=\"52\" fill=\"{a}\" opacity=\"0.3\"/>'\r\r\n                f'<rect x=\"0\" y=\"228\" width=\"260\" height=\"4\" fill=\"{a}\" '\r\r\n                f'opacity=\"0.4\"/>')\r\r\n    return \"\".join(\r\r\n        f'<ellipse cx=\"{40+i*44}\" cy=\"{40+((i*37)%180)}\" rx=\"10\" ry=\"16\" '\r\r\n        f'fill=\"{a}\" opacity=\"0.25\"/>' for i in range(5))\r\r\n\r\r\n\r\r\ndef _hair_svg(style: str, p: dict, cx=130, cy=108, rx=62, ry=66) -> str:\r\r\n    h = p[\"palette\"][\"hair\"]\r\r\n    if style == \"bald\":\r\r\n        return f'<path d=\"M{cx-rx} {cy} A{rx} {ry} 0 0 1 {cx+rx} {cy} L{cx+rx} {cy-16} A{rx} {ry} 0 0 0 {cx-rx} {cy-16} Z\" fill=\"{h}\" opacity=\"0.35\"/>'\r\r\n    if style == \"crop\":\r\r\n        return f'<path d=\"M{cx-rx-4} {cy-10} Q{cx} {cy-ry-34} {cx+rx+4} {cy-10} L{cx+rx} {cy-40} Q{cx} {cy-ry-8} {cx-rx} {cy-40} Z\" fill=\"{h}\"/>'\r\r\n    if style == \"wave\":\r\r\n        return (f'<path d=\"M{cx-rx-6} {cy+8} Q{cx-rx} {cy-ry-36} {cx} {cy-ry-30} '\r\r\n                f'Q{cx+rx} {cy-ry-36} {cx+rx+6} {cy+8} '\r\r\n                f'Q{cx+rx-10} {cy-40} {cx} {cy-46} Q{cx-rx+10} {cy-40} '\r\r\n                f'{cx-rx-6} {cy+8} Z\" fill=\"{h}\"/>')\r\r\n    if style == \"bob\":\r\r\n        return (f'<path d=\"M{cx-rx-8} {cy+44} L{cx-rx-8} {cy-6} '\r\r\n                f'Q{cx} {cy-ry-40} {cx+rx+8} {cy-6} L{cx+rx+8} {cy+44} '\r\r\n                f'L{cx+rx-6} {cy+40} L{cx+rx-6} {cy-30} '\r\r\n                f'Q{cx} {cy-ry-10} {cx-rx+6} {cy-30} L{cx-rx+6} {cy+40} Z\" fill=\"{h}\"/>')\r\r\n    if style == \"bun\":\r\r\n        return (f'<circle cx=\"{cx}\" cy=\"{cy-ry-14}\" r=\"20\" fill=\"{h}\"/>'\r\r\n                f'<path d=\"M{cx-rx-4} {cy-4} Q{cx} {cy-ry-32} {cx+rx+4} {cy-4} '\r\r\n                f'L{cx+rx} {cy-34} Q{cx} {cy-ry-4} {cx-rx} {cy-34} Z\" fill=\"{h}\"/>')\r\r\n    if style == \"crest\":\r\r\n        return (f'<path d=\"M{cx-20} {cy-ry+8} Q{cx} {cy-ry-48} {cx+20} {cy-ry+8} '\r\r\n                f'Q{cx} {cy-ry-16} {cx-20} {cy-ry+8} Z\" fill=\"{h}\"/>'\r\r\n                f'<path d=\"M{cx-rx-2} {cy-8} Q{cx} {cy-ry-20} {cx+rx+2} {cy-8} '\r\r\n                f'L{cx+rx} {cy-34} Q{cx} {cy-ry+2} {cx-rx} {cy-34} Z\" fill=\"{h}\"/>')\r\r\n    if style == \"long\":\r\r\n        return (f'<path d=\"M{cx-rx-10} {cy+92} L{cx-rx-10} {cy-4} '\r\r\n                f'Q{cx} {cy-ry-38} {cx+rx+10} {cy-4} L{cx+rx+10} {cy+92} '\r\r\n                f'L{cx+rx-4} {cy+86} L{cx+rx-4} {cy-28} '\r\r\n                f'Q{cx} {cy-ry-6} {cx-rx+4} {cy-28} L{cx-rx+4} {cy+86} Z\" fill=\"{h}\"/>')\r\r\n    return (f'<path d=\"M{cx-rx-4} {cy-6} Q{cx-10} {cy-ry-34} {cx+rx+4} {cy-6} '\r\r\n            f'L{cx+rx-6} {cy-36} Q{cx-6} {cy-ry-6} {cx-rx-6} {cy-34} Z\" fill=\"{h}\"/>')\r\r\n\r\r\n\r\r\ndef _eyes_svg(kind: str, p: dict, cx=130, cy=116) -> str:\r\r\n    dark = \"#22242a\"\r\r\n    lx, rx = cx - 24, cx + 24\r\r\n    if kind == \"round\":\r\r\n        return (f'<circle cx=\"{lx}\" cy=\"{cy}\" r=\"7\" fill=\"{dark}\"/>'\r\r\n                f'<circle cx=\"{rx}\" cy=\"{cy}\" r=\"7\" fill=\"{dark}\"/>')\r\r\n    if kind == \"almond\":\r\r\n        return (f'<ellipse cx=\"{lx}\" cy=\"{cy}\" rx=\"9\" ry=\"5\" fill=\"{dark}\"/>'\r\r\n                f'<ellipse cx=\"{rx}\" cy=\"{cy}\" rx=\"9\" ry=\"5\" fill=\"{dark}\"/>')\r\r\n    if kind == \"narrow\":\r\r\n        return (f'<rect x=\"{lx-9}\" y=\"{cy-2}\" width=\"18\" height=\"4\" rx=\"2\" fill=\"{dark}\"/>'\r\r\n                f'<rect x=\"{rx-9}\" y=\"{cy-2}\" width=\"18\" height=\"4\" rx=\"2\" fill=\"{dark}\"/>')\r\r\n    return (f'<circle cx=\"{lx}\" cy=\"{cy}\" r=\"6\" fill=\"{dark}\"/>'\r\r\n            f'<circle cx=\"{rx}\" cy=\"{cy}\" r=\"6\" fill=\"{dark}\"/>'\r\r\n            f'<circle cx=\"{lx+2}\" cy=\"{cy-2}\" r=\"2\" fill=\"#fff\"/>'\r\r\n            f'<circle cx=\"{rx+2}\" cy=\"{cy-2}\" r=\"2\" fill=\"#fff\"/>')\r\r\n\r\r\n\r\r\ndef _mouth_svg(kind: str, p: dict, cx=130, cy=156) -> str:\r\r\n    dark = \"#7c3b3b\"\r\r\n    if kind == \"smile\":\r\r\n        return f'<path d=\"M{cx-16} {cy} Q{cx} {cy+16} {cx+16} {cy}\" stroke=\"{dark}\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>'\r\r\n    if kind == \"flat\":\r\r\n        return f'<line x1=\"{cx-14}\" y1=\"{cy+4}\" x2=\"{cx+14}\" y2=\"{cy+4}\" stroke=\"{dark}\" stroke-width=\"4\" stroke-linecap=\"round\"/>'\r\r\n    if kind == \"smirk\":\r\r\n        return f'<path d=\"M{cx-14} {cy+6} Q{cx+4} {cy+12} {cx+16} {cy-2}\" stroke=\"{dark}\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>'\r\r\n    return f'<ellipse cx=\"{cx}\" cy=\"{cy+6}\" rx=\"9\" ry=\"7\" fill=\"{dark}\"/>'\r\r\n\r\r\n\r\r\ndef render_svg(p: dict, mark: bool = False) -> str:\r\r\n    pal = p[\"palette\"]\r\r\n    tilt = p[\"tilt\"]\r\r\n    parts = [\r\r\n        f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 260 260\" '\r\r\n        f'role=\"img\">',\r\r\n        f'<defs><linearGradient id=\"bg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">'\r\r\n        f'<stop offset=\"0\" stop-color=\"{pal[\"bg1\"]}\"/>'\r\r\n        f'<stop offset=\"1\" stop-color=\"{pal[\"bg2\"]}\"/></linearGradient></defs>',\r\r\n        f'<rect width=\"260\" height=\"260\" rx=\"18\" fill=\"url(#bg)\"/>',\r\r\n        _motif_svg(p[\"motif\"], p),\r\r\n        f'<g transform=\"rotate({tilt} 130 130)\">',\r\r\n        f'<path d=\"M60 260 Q70 196 130 192 Q190 196 200 260 Z\" fill=\"{pal[\"accent\"]}\"/>',  # shoulders\r\r\n        f'<rect x=\"112\" y=\"150\" width=\"36\" height=\"52\" rx=\"14\" fill=\"{pal[\"skin\"]}\"/>',  # neck\r\r\n        f'<ellipse cx=\"130\" cy=\"112\" rx=\"62\" ry=\"66\" fill=\"{pal[\"skin\"]}\"/>',  # face\r\r\n        _hair_svg(p[\"hair\"], p),\r\r\n        _eyes_svg(p[\"eyes\"], p),\r\r\n        f'<path d=\"M104 {104 - p[\"brow\"]*2} q10 -6 22 -2\" stroke=\"{pal[\"hair\"]}\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\"/>'\r\r\n        f'<path d=\"M134 {102 - p[\"brow\"]*2} q12 -4 22 2\" stroke=\"{pal[\"hair\"]}\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\"/>',\r\r\n        f'<path d=\"M126 118 q8 14 4 22 q-4 4 -10 2\" stroke=\"#b98a62\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>',  # nose\r\r\n        _mouth_svg(p[\"mouth\"], p),\r\r\n    ]\r\r\n    if p[\"blush\"]:\r\r\n        parts.append(f'<ellipse cx=\"98\" cy=\"140\" rx=\"9\" ry=\"5\" fill=\"#e8a0a0\" opacity=\"0.5\"/>'\r\r\n                     f'<ellipse cx=\"162\" cy=\"140\" rx=\"9\" ry=\"5\" fill=\"#e8a0a0\" opacity=\"0.5\"/>')\r\r\n    if p[\"glasses\"]:\r\r\n        parts.append(\r\r\n            f'<g stroke=\"#22242a\" stroke-width=\"4\" fill=\"none\">'\r\r\n            f'<circle cx=\"106\" cy=\"116\" r=\"14\"/><circle cx=\"154\" cy=\"116\" r=\"14\"/>'\r\r\n            f'<line x1=\"120\" y1=\"116\" x2=\"140\" y2=\"116\"/></g>')\r\r\n    if p[\"earring\"]:\r\r\n        parts.append(f'<circle cx=\"68\" cy=\"128\" r=\"4\" fill=\"{pal[\"accent\"]}\"/>')\r\r\n    # collar\r\r\n    parts.append(\r\r\n        f'<path d=\"M104 202 L130 218 L156 202 L156 214 L130 230 L104 214 Z\" '\r\r\n        f'fill=\"{pal[\"bg1\"]}\" opacity=\"0.85\"/>')\r\r\n    parts.append('</g>')\r\r\n    # ambient motion — a slow glint (C-PresentationGlass ambient motion)\r\r\n    parts.append(\r\r\n        f'<circle cx=\"0\" cy=\"0\" r=\"90\" fill=\"#ffffff\" opacity=\"0.06\">'\r\r\n        f'<animate attributeName=\"cx\" from=\"-60\" to=\"320\" dur=\"9s\" '\r\r\n        f'repeatCount=\"indefinite\"/></circle>')\r\r\n    if mark:\r\r\n        parts.append(\r\r\n            f'<g><rect x=\"176\" y=\"10\" width=\"76\" height=\"24\" rx=\"6\" '\r\r\n            f'fill=\"#000\" opacity=\"0.75\"/>'\r\r\n            f'<text x=\"214\" y=\"27\" font-size=\"13\" text-anchor=\"middle\" '\r\r\n            f'fill=\"#ffd166\" font-family=\"monospace\">&#9670; IMITATION</text></g>')\r\r\n    parts.append('</svg>')\r\r\n    return \"\".join(parts)\r\r\n\r\r\n\r\r\ndef generate(ctx, pid: str, name: str, mark: bool = False) -> dict:\r\r\n    p = params_for(pid, name)\r\r\n    svg = render_svg(p, mark=mark)\r\r\n    d = os.path.join(ctx.runtime, \"artifacts\", \"persona-art\")\r\r\n    os.makedirs(d, exist_ok=True)\r\r\n    path = os.path.join(d, f\"persona-{pid}.svg\")\r\r\n    with open(path, \"w\", encoding=\"utf-8\") as f:\r\r\n        f.write(svg)\r\r\n    return {\"file\": path, \"svg\": svg, \"params\": p, \"motif\": p[\"motif\"],\r\r\n            \"palette\": p[\"palette\"][\"bg1\"]}\r\r\n","newText":"\"\"\"Procedural persona portraits (C-PersonalityArt / C-PresentationGlass).\nEach personality's art is unique to that personality: a deterministic seed\nderived from identity drives face geometry, palette, hair style, eyes, brows,\nmouth, collar, glasses, and a background motif. The SVG is written as a\ndurable artifact under runtime/artifacts/persona-art/ and bound to the\npersona by a `persona:art` assertion carrying the same parameters — art is\nbound to the persona, not just generated near it.\n\"\"\"\nfrom __future__ import annotations\nimport hashlib\nimport os\nPALETTES = [\n    {\"skin\": \"#f2c9a4\", \"hair\": \"#4a3121\", \"bg1\": \"#1d3557\", \"bg2\": \"#457b9d\",\n     \"accent\": \"#e63946\"},\n    {\"skin\": \"#e8b88a\", \"hair\": \"#1c1c1c\", \"bg1\": \"#2a4d3a\", \"bg2\": \"#6b9e78\",\n     \"accent\": \"#f4a261\"},\n    {\"skin\": \"#d9a066\", \"hair\": \"#5c3a21\", \"bg1\": \"#503a6e\", \"bg2\": \"#8d6fc0\",\n     \"accent\": \"#ffd166\"},\n    {\"skin\": \"#f5d0b0\", \"hair\": \"#8a4b2a\", \"bg1\": \"#693a3a\", \"bg2\": \"#a86b6b\",\n     \"accent\": \"#a8dadc\"},\n    {\"skin\": \"#c98f5f\", \"hair\": \"#2f2f2f\", \"bg1\": \"#1f4e5f\", \"bg2\": \"#4f8a9b\",\n     \"accent\": \"#e9c46a\"},\n    {\"skin\": \"#ecc39b\", \"hair\": \"#6e4b2a\", \"bg1\": \"#3c4a2e\", \"bg2\": \"#77895c\",\n     \"accent\": \"#ef8354\"},\n    {\"skin\": \"#dfb185\", \"hair\": \"#7a2e2e\", \"bg1\": \"#34435e\", \"bg2\": \"#6d7fa3\",\n     \"accent\": \"#9bf6ff\"},\n    {\"skin\": \"#f0c8a8\", \"hair\": \"#3d2b1f\", \"bg1\": \"#4d3b5e\", \"bg2\": \"#9370b8\",\n     \"accent\": \"#ffc6ff\"},\n]\nMOTIFS = (\"peaks\", \"waves\", \"orbit\", \"lattice\", \"sunrise\", \"grove\")\nHAIRS = (\"crop\", \"wave\", \"bob\", \"bun\", \"crest\", \"long\", \"bald\", \"part\")\nEYES = (\"round\", \"almond\", \"narrow\", \"bright\")\nMOUTHS = (\"smile\", \"flat\", \"smirk\", \"open\")\nCOLLARS = (\"crew\", \"v\", \"collar\", \"scarf\")\ndef _seed(pid: str, name: str) -> int:\n    return int(hashlib.sha256(f\"{pid}:{name}\".encode()).hexdigest()[:12], 16)\ndef params_for(pid: str, name: str) -> dict:\n    s = _seed(pid, name)\n    pick = lambda arr, shift=0: arr[(s >> (shift * 4)) % len(arr)]\n    return {\n        \"seed\": hex(s), \"palette\": pick(PALETTES, 0), \"motif\": pick(MOTIFS, 1),\n        \"hair\": pick(HAIRS, 2), \"eyes\": pick(EYES, 3),\n        \"mouth\": pick(MOUTHS, 4), \"collar\": pick(COLLARS, 5),\n        \"glasses\": bool((s >> 24) & 1), \"earring\": bool((s >> 25) & 1),\n        \"tilt\": ((s >> 26) % 9) - 4, \"brow\": (s >> 30) % 3,\n        \"blush\": bool((s >> 31) & 1),\n    }\ndef _motif_svg(motif: str, p: dict) -> str:\n    pal = p[\"palette\"]\n    a = pal[\"accent\"]\n    if motif == \"peaks\":\n        return (f'<path d=\"M0 210 L60 120 L120 200 L180 100 L260 210 Z\" '\n                f'fill=\"{a}\" opacity=\"0.25\"/>')\n    if motif == \"waves\":\n        return (f'<path d=\"M0 200 Q60 170 130 200 T260 200 L260 260 L0 260 Z\" '\n                f'fill=\"{a}\" opacity=\"0.25\"/>')\n    if motif == \"orbit\":\n        return (f'<circle cx=\"130\" cy=\"80\" r=\"46\" fill=\"none\" stroke=\"{a}\" '\n                f'stroke-width=\"6\" opacity=\"0.3\"/>'\n                f'<circle cx=\"130\" cy=\"80\" r=\"10\" fill=\"{a}\" opacity=\"0.5\"/>')\n    if motif == \"lattice\":\n        return \"\".join(\n            f'<rect x=\"{20+i*40}\" y=\"{20+(i%3)*30}\" width=\"16\" height=\"16\" '\n            f'fill=\"{a}\" opacity=\"0.22\" transform=\"rotate(45 {28+i*40} '\n            f'{28+(i%3)*30})\"/>' for i in range(6))\n    if motif == \"sunrise\":\n        return (f'<circle cx=\"130\" cy=\"230\" r=\"52\" fill=\"{a}\" opacity=\"0.3\"/>'\n                f'<rect x=\"0\" y=\"228\" width=\"260\" height=\"4\" fill=\"{a}\" '\n                f'opacity=\"0.4\"/>')\n    return \"\".join(\n        f'<ellipse cx=\"{40+i*44}\" cy=\"{40+((i*37)%180)}\" rx=\"10\" ry=\"16\" '\n        f'fill=\"{a}\" opacity=\"0.25\"/>' for i in range(5))\ndef _hair_svg(style: str, p: dict, cx=130, cy=108, rx=62, ry=66) -> str:\n    h = p[\"palette\"][\"hair\"]\n    if style == \"bald\":\n        return f'<path d=\"M{cx-rx} {cy} A{rx} {ry} 0 0 1 {cx+rx} {cy} L{cx+rx} {cy-16} A{rx} {ry} 0 0 0 {cx-rx} {cy-16} Z\" fill=\"{h}\" opacity=\"0.35\"/>'\n    if style == \"crop\":\n        return f'<path d=\"M{cx-rx-4} {cy-10} Q{cx} {cy-ry-34} {cx+rx+4} {cy-10} L{cx+rx} {cy-40} Q{cx} {cy-ry-8} {cx-rx} {cy-40} Z\" fill=\"{h}\"/>'\n    if style == \"wave\":\n        return (f'<path d=\"M{cx-rx-6} {cy+8} Q{cx-rx} {cy-ry-36} {cx} {cy-ry-30} '\n                f'Q{cx+rx} {cy-ry-36} {cx+rx+6} {cy+8} '\n                f'Q{cx+rx-10} {cy-40} {cx} {cy-46} Q{cx-rx+10} {cy-40} '\n                f'{cx-rx-6} {cy+8} Z\" fill=\"{h}\"/>')\n    if style == \"bob\":\n        return (f'<path d=\"M{cx-rx-8} {cy+44} L{cx-rx-8} {cy-6} '\n                f'Q{cx} {cy-ry-40} {cx+rx+8} {cy-6} L{cx+rx+8} {cy+44} '\n                f'L{cx+rx-6} {cy+40} L{cx+rx-6} {cy-30} '\n                f'Q{cx} {cy-ry-10} {cx-rx+6} {cy-30} L{cx-rx+6} {cy+40} Z\" fill=\"{h}\"/>')\n    if style == \"bun\":\n        return (f'<circle cx=\"{cx}\" cy=\"{cy-ry-14}\" r=\"20\" fill=\"{h}\"/>'\n                f'<path d=\"M{cx-rx-4} {cy-4} Q{cx} {cy-ry-32} {cx+rx+4} {cy-4} '\n                f'L{cx+rx} {cy-34} Q{cx} {cy-ry-4} {cx-rx} {cy-34} Z\" fill=\"{h}\"/>')\n    if style == \"crest\":\n        return (f'<path d=\"M{cx-20} {cy-ry+8} Q{cx} {cy-ry-48} {cx+20} {cy-ry+8} '\n                f'Q{cx} {cy-ry-16} {cx-20} {cy-ry+8} Z\" fill=\"{h}\"/>'\n                f'<path d=\"M{cx-rx-2} {cy-8} Q{cx} {cy-ry-20} {cx+rx+2} {cy-8} '\n                f'L{cx+rx} {cy-34} Q{cx} {cy-ry+2} {cx-rx} {cy-34} Z\" fill=\"{h}\"/>')\n    if style == \"long\":\n        return (f'<path d=\"M{cx-rx-10} {cy+92} L{cx-rx-10} {cy-4} '\n                f'Q{cx} {cy-ry-38} {cx+rx+10} {cy-4} L{cx+rx+10} {cy+92} '\n                f'L{cx+rx-4} {cy+86} L{cx+rx-4} {cy-28} '\n                f'Q{cx} {cy-ry-6} {cx-rx+4} {cy-28} L{cx-rx+4} {cy+86} Z\" fill=\"{h}\"/>')\n    return (f'<path d=\"M{cx-rx-4} {cy-6} Q{cx-10} {cy-ry-34} {cx+rx+4} {cy-6} '\n            f'L{cx+rx-6} {cy-36} Q{cx-6} {cy-ry-6} {cx-rx-6} {cy-34} Z\" fill=\"{h}\"/>')\ndef _eyes_svg(kind: str, p: dict, cx=130, cy=116) -> str:\n    dark = \"#22242a\"\n    lx, rx = cx - 24, cx + 24\n    if kind == \"round\":\n        return (f'<circle cx=\"{lx}\" cy=\"{cy}\" r=\"7\" fill=\"{dark}\"/>'\n                f'<circle cx=\"{rx}\" cy=\"{cy}\" r=\"7\" fill=\"{dark}\"/>')\n    if kind == \"almond\":\n        return (f'<ellipse cx=\"{lx}\" cy=\"{cy}\" rx=\"9\" ry=\"5\" fill=\"{dark}\"/>'\n                f'<ellipse cx=\"{rx}\" cy=\"{cy}\" rx=\"9\" ry=\"5\" fill=\"{dark}\"/>')\n    if kind == \"narrow\":\n        return (f'<rect x=\"{lx-9}\" y=\"{cy-2}\" width=\"18\" height=\"4\" rx=\"2\" fill=\"{dark}\"/>'\n                f'<rect x=\"{rx-9}\" y=\"{cy-2}\" width=\"18\" height=\"4\" rx=\"2\" fill=\"{dark}\"/>')\n    return (f'<circle cx=\"{lx}\" cy=\"{cy}\" r=\"6\" fill=\"{dark}\"/>'\n            f'<circle cx=\"{rx}\" cy=\"{cy}\" r=\"6\" fill=\"{dark}\"/>'\n            f'<circle cx=\"{lx+2}\" cy=\"{cy-2}\" r=\"2\" fill=\"#fff\"/>'\n            f'<circle cx=\"{rx+2}\" cy=\"{cy-2}\" r=\"2\" fill=\"#fff\"/>')\ndef _mouth_svg(kind: str, p: dict, cx=130, cy=156) -> str:\n    dark = \"#7c3b3b\"\n    if kind == \"smile\":\n        return f'<path d=\"M{cx-16} {cy} Q{cx} {cy+16} {cx+16} {cy}\" stroke=\"{dark}\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>'\n    if kind == \"flat\":\n        return f'<line x1=\"{cx-14}\" y1=\"{cy+4}\" x2=\"{cx+14}\" y2=\"{cy+4}\" stroke=\"{dark}\" stroke-width=\"4\" stroke-linecap=\"round\"/>'\n    if kind == \"smirk\":\n        return f'<path d=\"M{cx-14} {cy+6} Q{cx+4} {cy+12} {cx+16} {cy-2}\" stroke=\"{dark}\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>'\n    return f'<ellipse cx=\"{cx}\" cy=\"{cy+6}\" rx=\"9\" ry=\"7\" fill=\"{dark}\"/>'\ndef render_svg(p: dict, mark: bool = False) -> str:\n    pal = p[\"palette\"]\n    tilt = p[\"tilt\"]\n    parts = [\n        f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 260 260\" '\n        f'role=\"img\">',\n        f'<defs><linearGradient id=\"bg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">'\n        f'<stop offset=\"0\" stop-color=\"{pal[\"bg1\"]}\"/>'\n        f'<stop offset=\"1\" stop-color=\"{pal[\"bg2\"]}\"/></linearGradient></defs>',\n        f'<rect width=\"260\" height=\"260\" rx=\"18\" fill=\"url(#bg)\"/>',\n        _motif_svg(p[\"motif\"], p),\n        f'<g transform=\"rotate({tilt} 130 130)\">',\n        f'<path d=\"M60 260 Q70 196 130 192 Q190 196 200 260 Z\" fill=\"{pal[\"accent\"]}\"/>',  # shoulders\n        f'<rect x=\"112\" y=\"150\" width=\"36\" height=\"52\" rx=\"14\" fill=\"{pal[\"skin\"]}\"/>',  # neck\n        f'<ellipse cx=\"130\" cy=\"112\" rx=\"62\" ry=\"66\" fill=\"{pal[\"skin\"]}\"/>',  # face\n        _hair_svg(p[\"hair\"], p),\n        _eyes_svg(p[\"eyes\"], p),\n        f'<path d=\"M104 {104 - p[\"brow\"]*2} q10 -6 22 -2\" stroke=\"{pal[\"hair\"]}\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\"/>'\n        f'<path d=\"M134 {102 - p[\"brow\"]*2} q12 -4 22 2\" stroke=\"{pal[\"hair\"]}\" stroke-width=\"5\" fill=\"none\" stroke-linecap=\"round\"/>',\n        f'<path d=\"M126 118 q8 14 4 22 q-4 4 -10 2\" stroke=\"#b98a62\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>',  # nose\n        _mouth_svg(p[\"mouth\"], p),\n    ]\n    if p[\"blush\"]:\n        parts.append(f'<ellipse cx=\"98\" cy=\"140\" rx=\"9\" ry=\"5\" fill=\"#e8a0a0\" opacity=\"0.5\"/>'\n                     f'<ellipse cx=\"162\" cy=\"140\" rx=\"9\" ry=\"5\" fill=\"#e8a0a0\" opacity=\"0.5\"/>')\n    if p[\"glasses\"]:\n        parts.append(\n            f'<g stroke=\"#22242a\" stroke-width=\"4\" fill=\"none\">'\n            f'<circle cx=\"106\" cy=\"116\" r=\"14\"/><circle cx=\"154\" cy=\"116\" r=\"14\"/>'\n            f'<line x1=\"120\" y1=\"116\" x2=\"140\" y2=\"116\"/></g>')\n    if p[\"earring\"]:\n        parts.append(f'<circle cx=\"68\" cy=\"128\" r=\"4\" fill=\"{pal[\"accent\"]}\"/>')\n    # collar\n    parts.append(\n        f'<path d=\"M104 202 L130 218 L156 202 L156 214 L130 230 L104 214 Z\" '\n        f'fill=\"{pal[\"bg1\"]}\" opacity=\"0.85\"/>')\n    parts.append('</g>')\n    # ambient motion — a slow glint (C-PresentationGlass ambient motion)\n    parts.append(\n        f'<circle cx=\"0\" cy=\"0\" r=\"90\" fill=\"#ffffff\" opacity=\"0.06\">'\n        f'<animate attributeName=\"cx\" from=\"-60\" to=\"320\" dur=\"9s\" '\n        f'repeatCount=\"indefinite\"/></circle>')\n    if mark:\n        parts.append(\n            f'<g><rect x=\"176\" y=\"10\" width=\"76\" height=\"24\" rx=\"6\" '\n            f'fill=\"#000\" opacity=\"0.75\"/>'\n            f'<text x=\"214\" y=\"27\" font-size=\"13\" text-anchor=\"middle\" '\n            f'fill=\"#ffd166\" font-family=\"monospace\">&#9670; IMITATION</text></g>')\n    parts.append('</svg>')\n    return \"\".join(parts)\ndef generate(ctx, pid: str, name: str, mark: bool = False) -> dict:\n    p = params_for(pid, name)\n    svg = render_svg(p, mark=mark)\n    d = os.path.join(ctx.runtime, \"artifacts\", \"persona-art\")\n    os.makedirs(d, exist_ok=True)\n    path = os.path.join(d, f\"persona-{pid}.svg\")\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(svg)\n    return {\"file\": path, \"svg\": svg, \"params\": p, \"motif\": p[\"motif\"],\n            \"palette\": p[\"palette\"][\"bg1\"]}\n","_meta":{"cognition.ai/linesAdded":189,"cognition.ai/linesRemoved":420}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\builtins.py","oldText":"\"\"\"Builtin components — tools, commands, and the chat-turn chain.\r\r\n\r\r\nRegistration happens once at boot into ctx.tools. Handlers receive\r\r\n(ctx, slots, need_id) and return a result dict; needs machinery wraps every\r\r\ninvoke in an unmet requirement first.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport json\r\r\nimport os\r\r\nimport re\r\r\nimport threading\r\r\n\r\r\nfrom . import (model, floor, archive, temporal, setbuild, personas as\r\r\n               personas_mod, compare as compare_mod, dsl)\r\r\n\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# chat-turn helpers\r\r\n\r\r\ndef _facts_for_text(ctx, text: str, limit=3) -> list:\r\r\n    \"\"\"Retrieve source facts for a factual prompt: wikipedia search → summary\r\r\n    extracts. Facts are verbatim source material with their source recorded —\r\r\n    the persona may use ONLY these (G-B).\"\"\"\r\r\n    q = re.sub(r\"[?!.]+$\", \"\", text)\r\r\n    q = re.sub(r\"^(what|who|where|when|which|why|how|is|are|does|did|\"\r\r\n               r\"tell me|describe|explain)\\s+(is|are|was|were|a|an|the|\"\r\r\n               r\"about|me about|me)?\\s*\", \"\", q, flags=re.I).strip()\r\r\n    if len(q) < 3:\r\r\n        return []\r\r\n    s = ctx.wiki.search(q, limit=3)\r\r\n    facts = []\r\r\n    if not s.get(\"ok\"):\r\r\n        return facts\r\r\n    for title in s.get(\"titles\", [])[:2]:\r\r\n        r = ctx.wiki.summary(title)\r\r\n        if r.get(\"ok\") and r.get(\"extract\"):\r\r\n            facts.append({\"text\": r[\"extract\"][:600],\r\r\n                          \"source\": f\"wikipedia:{r['title']}\"})\r\r\n            ctx.ledger.say(\"facts\", \"source:used\",\r\r\n                           {\"title\": r[\"title\"], \"for\": text[:120],\r\r\n                            \"excerpt\": r[\"extract\"][:240]},\r\r\n                           claimant=\"source:wikipedia\", certainty=0.85,\r\r\n                           basis={\"kind\": \"source-evidence\"})\r\r\n        if len(facts) >= limit:\r\r\n            break\r\r\n    return facts\r\r\n\r\r\n\r\r\ndef _decision_weights(led):\r\r\n    a = led.resolve(\"config\", \"decision:weights\")\r\r\n    if a:\r\r\n        v = a.value.get(\"v\")\r\r\n        if isinstance(v, list) and len(v) == 5:\r\r\n            return v\r\r\n    return [0.35, 0.40, 0.25, 1.0, 0.10]  # active, heldConf, overlap, named, rank\r\r\n\r\r\n\r\r\ndef select_respondents(ctx, text: str, depth: int, address: str = None) -> list:\r\r\n    \"\"\"Bounded decision model (fixed feature vector, weighted sum). The\r\r\n    active persona, held-confidence (dyadic rows), lens-interest overlap with\r\r\n    the topic/text, direct address (C-ChorusOnAddress — a named persona\r\r\n    answers regardless of rank), and roster position all factor in. Every\r\r\n    score is a ledger row — routing is inspectable.\"\"\"\r\r\n    led = ctx.ledger\r\r\n    w = _decision_weights(led)\r\r\n    roster = ctx.personas.roster()\r\r\n    topic = archive.topic(led).lower()\r\r\n    scores = []\r\r\n    for i, p in enumerate(roster):\r\r\n        named = 1.0 if (address and p[\"id\"] == address) or \\\r\r\n            re.search(rf\"\\b{re.escape(p['name'])}\\b\", text, re.I) else 0.0\r\r\n        overlap = 0.0\r\r\n        toks = set(re.findall(r\"[a-z]{4,}\", (topic + \" \" + text).lower()))\r\r\n        inter = set(x.lower() for x in p.get(\"interests\", []))\r\r\n        if toks and inter:\r\r\n            overlap = len(toks & inter) / len(inter)\r\r\n        held = ctx.personas.held_confidence(p[\"id\"])\r\r\n        active = 1.0 if ctx.personas.data.get(\"active\") == p[\"id\"] else 0.0\r\r\n        rankn = 1.0 - (i / max(1, len(roster) - 1)) if len(roster) > 1 else 1.0\r\r\n        f = [active, held, min(1.0, overlap), named, rankn]\r\r\n        score = sum(a * b for a, b in zip(w, f))\r\r\n        scores.append({\"persona\": p[\"id\"], \"name\": p[\"name\"], \"score\":\r\r\n                       round(score, 3), \"features\": [round(x, 3) for x in f]})\r\r\n        led.say(\"decision\", \"decision:score\",\r\r\n                {\"persona\": p[\"id\"], \"features\": f, \"weights\": w,\r\r\n                 \"score\": round(score, 4)},\r\r\n                claimant=\"model:respondent-selector\", certainty=0.9,\r\r\n                basis={\"kind\": \"interpretation\"})\r\r\n    scores.sort(key=lambda s: s[\"score\"], reverse=True)\r\r\n    chosen = scores[:max(1, depth)]\r\r\n    for rank, s in enumerate(chosen):\r\r\n        led.say(\"decision\", \"decision:respondent\",\r\r\n                {\"rank\": rank, \"persona\": s[\"persona\"], \"name\": s[\"name\"],\r\r\n                 \"score\": s[\"score\"]},\r\r\n                claimant=\"model:respondent-selector\", certainty=0.9,\r\r\n                basis={\"kind\": \"interpretation\"})\r\r\n    return chosen\r\r\n\r\r\n\r\r\ndef serve_response(ctx, text: str, respondents: list, facts: list,\r\r\n                   history: str, need_id: str = None) -> list:\r\r\n    \"\"\"C-SnapshotInference + C-SequentialCommit:\r\r\n    1. each respondent drafts IN PARALLEL against its own consistent ledger\r\r\n       snapshot (never each other's uncommitted work)\r\r\n    2. verified drafts commit back in ranked order\r\r\n    3. later respondents may append a short reaction reading the committed\r\r\n       earlier contribution (C-SequentialRespondents) — the reaction commits\r\r\n       after it, still in order.\r\r\n    Replies are emitted as persona.speak cards and admitted to the speech\r\r\n    floor in commit order.\"\"\"\r\r\n    led = ctx.ledger\r\r\n    snap_ids = []\r\r\n    drafts = {}\r\r\n\r\r\n    def draft(p):\r\r\n        snap = led.snapshot()\r\r\n        sid = model.rid(\"snap\")\r\r\n        snap_ids.append(sid)\r\r\n        led.say(\"inference\", \"inference:snapshot\",\r\r\n                {\"snapshot\": sid, \"task\": p[\"name\"], \"rows\": len(snap.rows)},\r\r\n                claimant=\"model:inference\", certainty=1.0,\r\r\n                basis={\"kind\": \"interpretation\"})\r\r\n        persona = ctx.personas.get(p[\"persona\"])\r\r\n        history_view = history  # snapshot-consistent (pre-turn reads only)\r\r\n        drafts[p[\"persona\"]] = personas_mod.compose(\r\r\n            ctx, persona, text, facts=facts, history=history_view)\r\r\n\r\r\n    threads = [threading.Thread(target=draft, args=(p,)) for p in respondents]\r\r\n    for t in threads:\r\r\n        t.start()\r\r\n    for t in threads:\r\r\n        t.join(timeout=150)\r\r\n\r\r\n    replies = []\r\r\n    committed_texts = []\r\r\n    for rank, p in enumerate(respondents):\r\r\n        persona = ctx.personas.get(p[\"persona\"])\r\r\n        d = drafts.get(p[\"persona\"]) or {\r\r\n            \"ok\": True, \"text\": \"…\", \"register\": persona.get(\"register\"),\r\r\n            \"engine\": \"none\"}\r\r\n        led.say(\"inference\", \"inference:commit\",\r\r\n                {\"rank\": rank, \"persona\": p[\"persona\"], \"name\": p[\"name\"],\r\r\n                 \"engine\": d.get(\"engine\"),\r\r\n                 \"fidelity\": d.get(\"fidelity\")},\r\r\n                claimant=\"model:inference\", certainty=1.0,\r\r\n                basis={\"kind\": \"execution\"})\r\r\n        reply = {\"persona\": p[\"persona\"], \"name\": persona[\"name\"],\r\r\n                 \"register\": d.get(\"register\"), \"text\": d.get(\"text\"),\r\r\n                 \"engine\": d.get(\"engine\"), \"rank\": rank,\r\r\n                 \"fidelity\": d.get(\"fidelity\")}\r\r\n        led.say(f\"persona:{p['persona']}\", \"persona:reply\",\r\r\n                {\"text\": d.get(\"text\"), \"register\": d.get(\"register\"),\r\r\n                 \"prompt\": text[:200], \"engine\": d.get(\"engine\"),\r\r\n                 \"fidelity\": d.get(\"fidelity\")},\r\r\n                claimant=\"persona:\" + persona[\"name\"].lower(),\r\r\n                certainty=0.9, basis={\"kind\": \"generated\"})\r\r\n        ctx.bus.emit(\"persona.speak\", reply)\r\r\n        ctx.floor.admit(persona[\"name\"], d.get(\"text\") or \"\",\r\r\n                        voice=(persona.get(\"voice\") or {}).get(\"name\"),\r\r\n                        rate=(persona.get(\"voice\") or {}).get(\"rate\", 0),\r\r\n                        render=ctx.engines.tts.mode == \"sapi\")\r\r\n        committed_texts.append((persona, d.get(\"text\") or \"\"))\r\r\n        replies.append(reply)\r\r\n\r\r\n    # sequential reaction pass — later respondents react to committed work\r\r\n    for rank in range(1, len(respondents)):\r\r\n        p = respondents[rank]\r\r\n        persona = ctx.personas.get(p[\"persona\"])\r\r\n        earlier = committed_texts[rank - 1]\r\r\n        d = personas_mod.compose(ctx, persona, text, facts=[],\r\r\n                                 react_to=f\"{earlier[0]['name']}: \"\r\r\n                                          f\"{earlier[1][:120]}\")\r\r\n        if d.get(\"text\"):\r\r\n            led.say(\"inference\", \"inference:commit\",\r\r\n                    {\"rank\": rank, \"persona\": p[\"persona\"],\r\r\n                     \"kind\": \"reaction\", \"reactsTo\": earlier[0][\"name\"]},\r\r\n                    claimant=\"model:inference\", certainty=1.0,\r\r\n                    basis={\"kind\": \"execution\"})\r\r\n            reply = {\"persona\": p[\"persona\"], \"name\": persona[\"name\"],\r\r\n                     \"register\": d.get(\"register\"), \"text\": d.get(\"text\"),\r\r\n                     \"engine\": d.get(\"engine\"), \"rank\": rank,\r\r\n                     \"reaction\": True}\r\r\n            ctx.bus.emit(\"persona.speak\", reply)\r\r\n            ctx.floor.admit(persona[\"name\"], d.get(\"text\") or \"\",\r\r\n                            voice=(persona.get(\"voice\") or {}).get(\"name\"),\r\r\n                            rate=(persona.get(\"voice\") or {}).get(\"rate\", 0),\r\r\n                            render=ctx.engines.tts.mode == \"sapi\")\r\r\n            replies.append(reply)\r\r\n    return replies\r\r\n\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# intent packs — chat input → tool needs + response need\r\r\n\r\r\ndef parse_intents(ctx, text: str) -> dict:\r\r\n    intents = []\r\r\n    t = text.strip()\r\r\n    low = t.lower()\r\r\n    pats = [\r\r\n        (\"set-topic\", r\"(?:set|change) (?:the )?topic to (.+)\",\r\r\n         lambda m: {\"topic\": m.group(1).strip()}),\r\r\n        (\"chat-reset\", r\"^reset (?:the )?conversation$\", lambda m: {}),\r\r\n        (\"build-list\", r\"list (?:me )?(all (?:the )?.+)\",\r\r\n         lambda m: {\"criteria\": m.group(1).strip()}),\r\r\n        (\"create-project\",\r\r\n         r\"(?:create|start|open) (?:a )?project (?:called |titled |to )?(.+)\",\r\r\n         lambda m: {\"title\": m.group(1).strip()}),\r\r\n        (\"persona-mint\",\r\r\n         r\"(?:create|mint|make) (?:a )?(?:persona|personality|avatar)\"\r\r\n         r\"(?: named | called )?(\\w[\\w\\-]*)\",\r\r\n         lambda m: {\"name\": m.group(1)}),\r\r\n        (\"run-search\",\r\r\n         r\"(?:search|look up|find out about|research) (?:for )?(.+)\",\r\r\n         lambda m: {\"query\": m.group(1).strip()}),\r\r\n        (\"remember\", r\"remember (?:that )?(.+)\",\r\r\n         lambda m: {\"fact\": m.group(1).strip()}),\r\r\n        (\"publish-milestone\", r\"(?:publish|post) (.+)\",\r\r\n         lambda m: {\"target\": \"milestone\", \"content\": m.group(1).strip()}),\r\r\n        (\"send-mail\",\r\r\n         r\"(?:send )?(?:an )?email to (.+?)(?: saying |: | that )(.+)\",\r\r\n         lambda m: {\"to\": m.group(1).strip(), \"body\": m.group(2).strip()}),\r\r\n    ]\r\r\n    for tid, rx, slots_fn in pats:\r\r\n        m = re.search(rx, low if tid != \"persona-mint\" else t, re.I)\r\r\n        if m:\r\r\n            intents.append({\"toolId\": tid, \"slots\": slots_fn(m)})\r\r\n    if re.search(r\"\\?\\s*$\", t) or re.match(\r\r\n            r\"^(what|who|where|when|which|why|how|tell me about|\"\r\r\n            r\"describe|explain)\\b\", low):\r\r\n        if not any(i[\"toolId\"] == \"run-search\" for i in intents):\r\r\n            intents.append({\"toolId\": \"run-search\",\r\r\n                            \"slots\": {\"query\": re.sub(r\"[?!.]+$\", \"\", t)}})\r\r\n        intents.append({\"kind\": \"factual\"})\r\r\n    return {\"routed\": True, \"intents\": intents}\r\r\n\r\r\n\r\r\ndef run_chat_turn(ctx, text: str, address=None, via=\"chat\") -> dict:\r\r\n    led = ctx.ledger\r\r\n    inp = led.say(\"chat\", \"chat:input\", {\"text\": text, \"via\": via},\r\r\n                  claimant=\"principal\" if via == \"chat\" else \"surface:\" + via,\r\r\n                  certainty=1.0, basis={\"kind\": \"captured-input\"})\r\r\n\r\r\n    # focused need: conversational slot fill (S-focused-need)\r\r\n    fnid = floor.focused_need(led)\r\r\n    focus_fill = None\r\r\n    if fnid and not re.search(r\"(?:set the topic|reset conversation)\", text,\r\r\n                              re.I):\r\r\n        rows = floor.need_rows(led, fnid)\r\r\n        opener = next((r for r in rows if r.predicate == \"need:open\"), None)\r\r\n        spec = (opener.value.get(\"v\") or {}) if opener else {}\r\r\n        missing = spec.get(\"missing\") or []\r\r\n        if missing:\r\r\n            slot = missing[0]\r\r\n            val = text.strip()\r\r\n            try:\r\r\n                val = int(val)\r\r\n            except ValueError:\r\r\n                pass\r\r\n            supply = floor.supply_candidate(ctx, fnid, slot, val,\r\r\n                                            source=\"user\")\r\r\n            r = ctx.retry(fnid)\r\r\n            focus_fill = {\"needId\": fnid, \"slot\": slot, \"value\": val,\r\r\n                          \"test\": supply.get(\"test\"),\r\r\n                          \"fulfilled\": bool(r.get(\"ok\"))}\r\r\n\r\r\n    intents = parse_intents(ctx, text)[\"intents\"]\r\r\n    need_ids, results = [], []\r\r\n    for it in intents:\r\r\n        if it.get(\"kind\") == \"factual\":\r\r\n            continue\r\r\n        r = ctx.invoke(it[\"toolId\"], it[\"slots\"],\r\r\n                       summary=f\"chat:{it['toolId']}\", via=\"chat\")\r\r\n        need_ids.append(r.get(\"needId\"))\r\r\n        results.append({\"toolId\": it[\"toolId\"], \"ok\": r.get(\"ok\"),\r\r\n                        \"deferred\": r.get(\"deferred\"),\r\r\n                        \"needId\": r.get(\"needId\")})\r\r\n        if r.get(\"deferred\"):\r\r\n            continue  # needs stay open — the floor records them\r\r\n\r\r\n    # facts: for factual prompts AND for selected-context commentary\r\r\n    factual = any(i.get(\"kind\") == \"factual\" for i in intents)\r\r\n    facts = _facts_for_text(ctx, text) if factual else []\r\r\n    ctxsel = archive.context(led)\r\r\n    if ctxsel and ctxsel.get(\"excerpt\"):\r\r\n        facts = [{\"text\": ctxsel[\"excerpt\"],\r\r\n                  \"source\": f\"context:{ctxsel.get('kind')}:{ctxsel.get('ref')}\"}]\r\r\n\r\r\n    depth = 2\r\r\n    a = led.resolve(\"config\", \"chat:response-depth\")\r\r\n    if a:\r\r\n        try:\r\r\n            depth = int(a.value.get(\"v\"))\r\r\n        except (TypeError, ValueError):\r\r\n            pass\r\r\n    resp_need = led.say(\"chat\", \"need:response\",\r\r\n                        {\"text\": text[:200], \"depth\": depth,\r\r\n                         \"factual\": factual},\r\r\n                        claimant=\"system\", certainty=1.0,\r\r\n                        basis={\"kind\": \"interpretation\"})\r\r\n    respondents = select_respondents(ctx, text, depth, address)\r\r\n    history = _history(led)\r\r\n    replies = serve_response(ctx, text, respondents, facts, history,\r\r\n                             need_id=resp_need.id)\r\r\n    led.say(\"chat\", \"need:fulfilled\",\r\r\n            {\"needId\": resp_need.id, \"respondents\": [r[\"name\"] for r in\r\r\n             replies]}, claimant=\"system\", certainty=1.0,\r\r\n            basis={\"kind\": \"durable-result\"}, links=[resp_need.id])\r\r\n\r\r\n    archive.archive_turn(ctx, {\"input\": text, \"intents\": intents,\r\r\n                               \"needIds\": need_ids,\r\r\n                               \"respondents\": [r[\"name\"] for r in replies],\r\r\n                               \"focusFill\": focus_fill})\r\r\n    return {\"ok\": True, \"inputId\": inp.id, \"intents\": intents,\r\r\n            \"needIds\": need_ids, \"toolResults\": results,\r\r\n            \"responseNeedId\": resp_need.id, \"replies\": replies,\r\r\n            \"focusFill\": focus_fill}\r\r\n\r\r\n\r\r\ndef _history(led, limit=8):\r\r\n    rows = led.query(predicate=\"archive:turn\", limit=limit)\r\r\n    lines = []\r\r\n    for a in reversed(rows):\r\r\n        v = a.value.get(\"v\") or {}\r\r\n        lines.append(f\"user: {v.get('input','')[:100]}\")\r\r\n    return \"\\n\".join(lines[-limit:])\r\r\n\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# tool handlers\r\r\n\r\r\ndef h_set_topic(ctx, slots, nid):\r\r\n    return archive.set_topic(ctx, slots[\"topic\"])\r\r\n\r\r\n\r\r\ndef h_chat_reset(ctx, slots, nid):\r\r\n    return archive.reset(ctx)\r\r\n\r\r\n\r\r\ndef h_remember(ctx, slots, nid):\r\r\n    ctx.ledger.say(\"memory\", \"memory:fact\", {\"fact\": slots[\"fact\"]},\r\r\n                   claimant=\"principal\", certainty=0.95,\r\r\n                   basis={\"kind\": \"user-choice\"})\r\r\n    return {\"ok\": True, \"remembered\": slots[\"fact\"]}\r\r\n\r\r\n\r\r\ndef h_create_project(ctx, slots, nid):\r\r\n    title = slots[\"title\"]\r\r\n    goals = slots.get(\"goals\") or []\r\r\n    pid = model.rid(\"proj\")\r\r\n    ctx.ledger.say(f\"project:{pid}\", \"project:profile\",\r\r\n                   {\"title\": title, \"goals\": goals, \"status\": \"open\"},\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"})\r\r\n    goal_needs = []\r\r\n    for g in goals:\r\r\n        pseudo = {\"id\": \"project-goal-work\", \"kind\": \"generic\",\r\r\n                  \"template\": {\"slots\": [\r\r\n                      {\"name\": \"deliverable\", \"required\": True},\r\r\n                      {\"name\": \"format\", \"required\": True,\r\r\n                       \"test\": {\"kind\": \"enum\",\r\r\n                                \"options\": [\"report\", \"summary\", \"list\",\r\r\n                                            \"hardcover\", \"pdf\", \"table\"]}}]},\r\r\n                  \"handler\": h_project_goal}\r\r\n        r = floor.open_need(ctx, pseudo, {\"deliverable\": g},\r\r\n                            summary=f\"goal:{g}\", via=\"project\")\r\r\n        goal_needs.append(r.get(\"needId\"))\r\r\n    ctx.ledger.say(f\"project:{pid}\", \"project:needs\",\r\r\n                   {\"needIds\": goal_needs, \"goals\": goals},\r\r\n                   claimant=\"system\", certainty=1.0,\r\r\n                   basis={\"kind\": \"interpretation\"})\r\r\n    return {\"ok\": True, \"projectId\": pid, \"title\": title,\r\r\n            \"goalNeeds\": goal_needs}\r\r\n\r\r\n\r\r\ndef h_project_goal(ctx, slots, nid):\r\r\n    ctx.ledger.say(\"project\", \"project:deliverable\",\r\r\n                   {\"goal\": slots.get(\"deliverable\"),\r\r\n                    \"format\": slots.get(\"format\"), \"needId\": nid},\r\r\n                   claimant=\"system\", certainty=1.0,\r\r\n                   basis={\"kind\": \"durable-result\"})\r\r\n    return {\"ok\": True, \"delivered\": slots.get(\"deliverable\"),\r\r\n            \"format\": slots.get(\"format\")}\r\r\n\r\r\n\r\r\ndef h_build_list(ctx, slots, nid):\r\r\n    criteria = slots[\"criteria\"]\r\r\n    pid = model.rid(\"proj\")\r\r\n    ctx.ledger.say(f\"project:{pid}\", \"project:profile\",\r\r\n                   {\"title\": f\"list: {criteria}\", \"kind\": \"list-project\",\r\r\n                    \"status\": \"running\"},\r\r\n                   claimant=\"system\", certainty=1.0,\r\r\n                   basis={\"kind\": \"interpretation\"})\r\r\n    r = setbuild.build(ctx, criteria, need_id=nid)\r\r\n    status = \"done\" if r.get(\"ok\") else \"failed\"\r\r\n    ctx.ledger.say(f\"project:{pid}\", \"project:status\",\r\r\n                   {\"status\": status, \"memberCount\": r.get(\"memberCount\")},\r\r\n                   claimant=\"system\", certainty=1.0,\r\r\n                   basis={\"kind\": \"durable-result\"})\r\r\n    r[\"projectId\"] = pid\r\r\n    return r\r\r\n\r\r\n\r\r\ndef h_retrieve_table(ctx, slots, nid):\r\r\n    return setbuild.via_table(ctx, slots.get(\"criteria\", \"\"))\r\r\n\r\r\n\r\r\ndef h_retrieve_category(ctx, slots, nid):\r\r\n    return setbuild.via_category(ctx, slots.get(\"criteria\", \"\"))\r\r\n\r\r\n\r\r\ndef h_run_search(ctx, slots, nid):\r\r\n    q = slots[\"query\"]\r\r\n    s = ctx.wiki.search(q, limit=5)\r\r\n    if not s.get(\"ok\"):\r\r\n        ctx.ledger.say(\"search\", \"search:adequacy\",\r\r\n                       {\"query\": q, \"adequate\": False,\r\r\n                        \"reason\": s.get(\"error\")},\r\r\n                       claimant=\"source:wikipedia\", certainty=0.9,\r\r\n                       basis={\"kind\": \"source-evidence\"})\r\r\n        return {\"ok\": False, \"error\": s.get(\"error\")}\r\r\n    hits = []\r\r\n    for title in s.get(\"titles\", [])[:4]:\r\r\n        r = ctx.wiki.summary(title)\r\r\n        if r.get(\"ok\") and r.get(\"extract\"):\r\r\n            hits.append({\"title\": r[\"title\"],\r\r\n                         \"extract\": r[\"extract\"][:400],\r\r\n                         \"url\": r.get(\"url\")})\r\r\n    ctx.ledger.say(\"search\", \"search:adequacy\",\r\r\n                   {\"query\": q, \"adequate\": bool(hits), \"hits\": len(hits)},\r\r\n                   claimant=\"source:wikipedia\", certainty=0.9,\r\r\n                   basis={\"kind\": \"source-evidence\"})\r\r\n    for h in hits:\r\r\n        ctx.ledger.say(\"search\", \"search:hit\", h,\r\r\n                       claimant=\"source:wikipedia\", certainty=0.85,\r\r\n                       basis={\"kind\": \"source-evidence\"})\r\r\n    return {\"ok\": True, \"query\": q, \"hits\": hits}\r\r\n\r\r\n\r\r\ndef h_persona_mint(ctx, slots, nid):\r\r\n    return ctx.personas.mint(\r\r\n        name=slots[\"name\"], traits=slots.get(\"traits\"),\r\r\n        interests=slots.get(\"interests\"), lens=slots.get(\"lens\"),\r\r\n        figure=slots.get(\"figure\"),\r\r\n        responsibilities=slots.get(\"responsibilities\"))\r\r\n\r\r\n\r\r\ndef h_persona_onboard(ctx, slots, nid):\r\r\n    \"\"\"Extend a minimal persona: portrait, voice, characterization — each\r\r\n    opened and served as a real need (prompt demo 5).\"\"\"\r\r\n    pid = slots[\"personaId\"]\r\r\n    p = ctx.personas.get(pid)\r\r\n    if not p:\r\r\n        return {\"ok\": False, \"error\": \"no such persona\"}\r\r\n    out = {\"personaId\": pid, \"name\": p[\"name\"]}\r\r\n\r\r\n    art_res = ctx.invoke(\"generate-portrait\", {\"personaId\": pid},\r\r\n                         summary=\"onboard:portrait\", via=\"onboard\")\r\r\n    out[\"portrait\"] = art_res.get(\"result\")\r\r\n\r\r\n    v_res = ctx.invoke(\"persona-voice-set\",\r\r\n                       {\"personaId\": pid,\r\r\n                        \"name\": (p.get(\"voice\") or {}).get(\"name\"),\r\r\n                        \"rate\": (p.get(\"voice\") or {}).get(\"rate\", 0)},\r\r\n                       summary=\"onboard:voice\", via=\"onboard\")\r\r\n    out[\"voice\"] = v_res.get(\"result\")\r\r\n\r\r\n    c_res = ctx.invoke(\"characterize-persona\", {\"personaId\": pid},\r\r\n                       summary=\"onboard:characterization\", via=\"onboard\")\r\r\n    out[\"characterization\"] = c_res.get(\"result\")\r\r\n    out[\"ok\"] = all(isinstance(x, dict) and x.get(\"ok\") for x in\r\r\n                    (out[\"portrait\"], out[\"voice\"], out[\"characterization\"]))\r\r\n    return out\r\r\n\r\r\n\r\r\ndef h_generate_portrait(ctx, slots, nid):\r\r\n    pid = slots[\"personaId\"]\r\r\n    p = ctx.personas.get(pid)\r\r\n    if not p:\r\r\n        return {\"ok\": False, \"error\": \"no such persona\"}\r\r\n    from . import art\r\r\n    r = art.generate(ctx, pid, p[\"name\"], mark=p.get(\"mark\"))\r\r\n    p[\"art\"] = {\"file\": r[\"file\"], \"motif\": r[\"motif\"],\r\r\n                \"palette\": r[\"palette\"], \"params\": r[\"params\"]}\r\r\n    ctx.personas.save()\r\r\n    ctx.ledger.say(f\"persona:{pid}\", \"persona:art\",\r\r\n                   {\"artifact\": r[\"file\"], \"motif\": r[\"motif\"],\r\r\n                    \"params\": r[\"params\"], \"bound\": True},\r\r\n                   claimant=\"engine:portrait\", certainty=1.0,\r\r\n                   basis={\"kind\": \"durable-result\"})\r\r\n    return {\"ok\": True, \"artifact\": r[\"file\"], \"motif\": r[\"motif\"]}\r\r\n\r\r\n\r\r\ndef h_persona_voice_set(ctx, slots, nid):\r\r\n    pid = slots[\"personaId\"]\r\r\n    p = ctx.personas.get(pid)\r\r\n    if not p:\r\r\n        return {\"ok\": False, \"error\": \"no such persona\"}\r\r\n    if slots.get(\"name\"):\r\r\n        p.setdefault(\"voice\", {})[\"name\"] = slots[\"name\"]\r\r\n    if slots.get(\"rate\") is not None:\r\r\n        p.setdefault(\"voice\", {})[\"rate\"] = int(slots[\"rate\"])\r\r\n    ctx.personas.save()\r\r\n    ctx.ledger.say(f\"persona:{pid}\", \"persona:voice\", p[\"voice\"],\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"})\r\r\n    return {\"ok\": True, \"voice\": p[\"voice\"]}\r\r\n\r\r\n\r\r\ndef h_characterize(ctx, slots, nid):\r\r\n    pid = slots[\"personaId\"]\r\r\n    p = ctx.personas.get(pid)\r\r\n    if not p:\r\r\n        return {\"ok\": False, \"error\": \"no such persona\"}\r\r\n    system = (f\"Summarize how the persona {p['name']} sees the world: lens, \"\r\r\n              f\"responsibilities, characteristic phrasing. Traits: \"\r\r\n              f\"{', '.join(p.get('traits', []))}. Register: \"\r\r\n              f\"{p.get('register')}. Under 80 words, third person.\")\r\r\n    r = ctx.engines.llm.chat(system, f\"Persona: {json.dumps(p)[:600]}\",\r\r\n                             max_tokens=120)\r\r\n    if r.get(\"ok\") and r.get(\"text\"):\r\r\n        text = r[\"text\"].strip()\r\r\n        engine = r[\"engine\"]\r\r\n    else:\r\r\n        text = (f\"{p['name']} reads the ledger through {p.get('register')} \"\r\r\n                f\"lenses: {', '.join(p.get('traits', []))}. Interests: \"\r\r\n                f\"{', '.join(p.get('interests', [])) or 'general'}. \"\r\r\n                f\"Speaks {p.get('register')}; bound to the record.\")\r\r\n        engine = \"declared-template\"\r\r\n    p[\"characterization\"] = text\r\r\n    ctx.personas.save()\r\r\n    ctx.ledger.say(f\"persona:{pid}\", \"persona:characterization\",\r\r\n                   {\"text\": text, \"engine\": engine},\r\r\n                   claimant=\"persona:\" + p[\"name\"].lower(), certainty=0.9,\r\r\n                   basis={\"kind\": \"generated\"})\r\r\n    return {\"ok\": True, \"characterization\": text, \"engine\": engine}\r\r\n\r\r\n\r\r\ndef h_persona_update(ctx, slots, nid):\r\r\n    return ctx.personas.update(slots[\"personaId\"], slots.get(\"patch\", {}))\r\r\n\r\r\n\r\r\ndef h_speak_voice(ctx, slots, nid):\r\r\n    name = slots.get(\"persona\") or (ctx.personas.active() or {}).get(\"name\",\r\r\n                                                                    \"system\")\r\r\n    item = ctx.floor.admit(name, slots[\"text\"],\r\r\n                           voice=slots.get(\"voice\"),\r\r\n                           rate=slots.get(\"rate\", 0),\r\r\n                           render=ctx.engines.tts.mode == \"sapi\")\r\r\n    res = ctx.floor.wait(item, timeout=180)\r\r\n    return res or {\"ok\": False, \"error\": \"floor timeout\"}\r\r\n\r\r\n\r\r\ndef h_render_sapi(ctx, slots, nid):\r\r\n    return ctx.engines.tts.render_local(slots[\"text\"],\r\r\n                                        voice=slots.get(\"voice\"),\r\r\n                                        rate=slots.get(\"rate\", 0))\r\r\n\r\r\n\r\r\ndef h_render_remote(ctx, slots, nid):\r\r\n    return ctx.engines.tts.render_remote(slots[\"text\"],\r\r\n                                         voice=slots.get(\"voice\"))\r\r\n\r\r\n\r\r\ndef h_import_exchange(ctx, slots, nid):\r\r\n    path = slots.get(\"package\")\r\r\n    if isinstance(path, dict):\r\r\n        pkg = path\r\r\n    else:\r\r\n        if not path or not os.path.exists(path):\r\r\n            return {\"ok\": False, \"error\": \"no such package\"}\r\r\n        pkg = json.load(open(path, encoding=\"utf-8\"))\r\r\n    if pkg.get(\"schema\") != ctx.exchange_schema:\r\r\n        return {\"ok\": False, \"error\":\r\r\n                f\"schema mismatch ({pkg.get('schema')})\"}\r\r\n    counts = {\"personas\": 0, \"tools\": 0, \"assertions\": 0, \"needs\": 0}\r\r\n    src = \"exchange:\" + pkg.get(\"id\", \"pkg\")\r\r\n    for p in pkg.get(\"personas\", []):\r\r\n        r = ctx.personas.mint(**p)\r\r\n        ctx.ledger.say(\"exchange\", \"exchange:imported\",\r\r\n                       {\"kind\": \"persona\", \"id\": r.get(\"personaId\"),\r\r\n                        \"package\": pkg.get(\"id\")},\r\r\n                       claimant=src, certainty=0.4,\r\r\n                       basis={\"kind\": \"import\"})\r\r\n        counts[\"personas\"] += 1\r\r\n    for t in pkg.get(\"tools\", []):\r\r\n        ctx.tools.tool(t[\"id\"], t.get(\"title\", t[\"id\"]), need=t.get(\"need\"),\r\r\n                       template=t.get(\"template\"), steps=t.get(\"steps\"),\r\r\n                       authored=True)\r\r\n        ctx.ledger.say(\"exchange\", \"exchange:imported\",\r\r\n                       {\"kind\": \"tool\", \"id\": t[\"id\"],\r\r\n                        \"package\": pkg.get(\"id\")},\r\r\n                       claimant=src, certainty=0.4, basis={\"kind\": \"import\"})\r\r\n        counts[\"tools\"] += 1\r\r\n    for a in pkg.get(\"assertions\", []):\r\r\n        ctx.ledger.say(a[\"subject\"], a[\"predicate\"], a[\"value\"],\r\r\n                       claimant=src, certainty=0.4, basis={\"kind\": \"import\"})\r\r\n        counts[\"assertions\"] += 1\r\r\n    for n in pkg.get(\"needs\", []):\r\r\n        ctx.ledger.say(\"exchange\", \"exchange:imported\",\r\r\n                       {\"kind\": \"need\", \"summary\": n.get(\"summary\"),\r\r\n                        \"package\": pkg.get(\"id\"), \"held\": \"below-threshold\"},\r\r\n                       claimant=src, certainty=0.4, basis={\"kind\": \"import\"})\r\r\n        counts[\"needs\"] += 1\r\r\n    ctx.ledger.say(\"exchange\", \"exchange:package\",\r\r\n                   {\"id\": pkg.get(\"id\"), \"schema\": pkg.get(\"schema\"),\r\r\n                    \"counts\": counts, \"threshold\": 0.4,\r\r\n                    \"status\": \"held-below-action-threshold\"},\r\r\n                   claimant=\"system\", certainty=1.0,\r\r\n                   basis={\"kind\": \"durable-result\"})\r\r\n    return {\"ok\": True, \"package\": pkg.get(\"id\"), \"counts\": counts,\r\r\n            \"threshold\": 0.4}\r\r\n\r\r\n\r\r\ndef h_export_exchange(ctx, slots, nid):\r\r\n    pred = slots.get(\"predicate\")\r\r\n    pkg = {\"schema\": ctx.exchange_schema, \"id\": model.rid(\"pkg\"),\r\r\n           \"personas\": [], \"tools\": [], \"assertions\": [], \"needs\": []}\r\r\n    for p in ctx.personas.roster()[:6]:\r\r\n        pkg[\"personas\"].append({\"name\": p[\"name\"], \"traits\": p[\"traits\"],\r\r\n                                \"interests\": p[\"interests\"],\r\r\n                                \"lens\": p[\"lens\"]})\r\r\n    for t in ctx.tools.tools.values():\r\r\n        if t.get(\"authored\"):\r\r\n            pkg[\"tools\"].append({\"id\": t[\"id\"], \"title\": t[\"title\"],\r\r\n                                 \"need\": t[\"need\"],\r\r\n                                 \"template\": t[\"template\"],\r\r\n                                 \"steps\": t.get(\"steps\")})\r\r\n    for a in ctx.ledger.query(predicate=pred, limit=40) if pred else []:\r\r\n        pkg[\"assertions\"].append({\"subject\": a.subject,\r\r\n                                  \"predicate\": a.predicate,\r\r\n                                  \"value\": a.value.get(\"v\")})\r\r\n    for n in ctx.open_needs()[:10]:\r\r\n        pkg[\"needs\"].append({\"summary\": n[\"summary\"],\r\r\n                             \"toolId\": n[\"toolId\"]})\r\r\n    outdir = os.path.join(ctx.runtime, \"artifacts\", \"exports\")\r\r\n    os.makedirs(outdir, exist_ok=True)\r\r\n    path = os.path.join(outdir, pkg[\"id\"] + \".json\")\r\r\n    with open(path, \"w\", encoding=\"utf-8\") as f:\r\r\n        json.dump(pkg, f, indent=2, ensure_ascii=False)\r\r\n    ctx.ledger.say(\"exchange\", \"exchange:exported\",\r\r\n                   {\"id\": pkg[\"id\"], \"path\": path,\r\r\n                    \"counts\": {k: len(v) for k, v in pkg.items()\r\r\n                               if isinstance(v, list)}},\r\r\n                   claimant=\"system\", certainty=1.0,\r\r\n                   basis={\"kind\": \"durable-result\"})\r\r\n    return {\"ok\": True, \"path\": path,\r\r\n            \"counts\": {k: len(v) for k, v in pkg.items()\r\r\n                       if isinstance(v, list)}}\r\r\n\r\r\n\r\r\ndef h_publish(ctx, slots, nid):\r\r\n    \"\"\"Grant-gated consequential tool. With a witnessed grant it writes a\r\r\n    real local artifact — it never claims a network effect it can't produce.\"\"\"\r\r\n    outdir = os.path.join(ctx.runtime, \"outbox\")\r\r\n    os.makedirs(outdir, exist_ok=True)\r\r\n    fname = f\"milestone-{model.rid('pub')}.md\"\r\r\n    path = os.path.join(outdir, fname)\r\r\n    with open(path, \"w\", encoding=\"utf-8\") as f:\r\r\n        f.write(f\"# {slots.get('target','milestone')}\\n\\n\"\r\r\n                f\"{slots.get('content','')}\\n\\n\"\r\r\n                f\"— published to local outbox by Vantage\\n\")\r\r\n    ctx.ledger.say(\"publish\", \"publish:artifact\",\r\r\n                   {\"target\": slots.get(\"target\"), \"artifact\": path,\r\r\n                    \"channel\": \"local-outbox\",\r\r\n                    \"note\": \"no configured remote channel — artifact, not \"\r\r\n                            \"transmission\"},\r\r\n                   claimant=\"tool:publish-milestone\", certainty=1.0,\r\r\n                   basis={\"kind\": \"execution\"})\r\r\n    return {\"ok\": True, \"artifact\": path, \"channel\": \"local-outbox\",\r\r\n            \"delivered\": False,\r\r\n            \"note\": \"wrote local artifact; no remote channel configured\"}\r\r\n\r\r\n\r\r\ndef h_send_mail(ctx, slots, nid):\r\r\n    outdir = os.path.join(ctx.runtime, \"outbox\")\r\r\n    os.makedirs(outdir, exist_ok=True)\r\r\n    fname = f\"mail-{model.rid('eml')}.eml\"\r\r\n    path = os.path.join(outdir, fname)\r\r\n    with open(path, \"w\", encoding=\"utf-8\") as f:\r\r\n        f.write(f\"To: {slots.get('to')}\\nSubject: Vantage message\\n\\n\"\r\r\n                f\"{slots.get('body')}\\n\")\r\r\n    ctx.ledger.say(\"mail\", \"mail:queued\",\r\r\n                   {\"to\": slots.get(\"to\"), \"artifact\": path,\r\r\n                    \"status\": \"queued-local-outbox\",\r\r\n                    \"delivered\": False},\r\r\n                   claimant=\"tool:send-mail\", certainty=1.0,\r\r\n                   basis={\"kind\": \"execution\"})\r\r\n    return {\"ok\": True, \"artifact\": path, \"delivered\": False,\r\r\n            \"status\": \"queued-local-outbox\"}\r\r\n\r\r\n\r\r\ndef h_home_routine(ctx, slots, nid):\r\r\n    outdir = os.path.join(ctx.runtime, \"outbox\")\r\r\n    os.makedirs(outdir, exist_ok=True)\r\r\n    path = os.path.join(outdir, f\"routine-{model.rid('act')}.json\")\r\r\n    with open(path, \"w\", encoding=\"utf-8\") as f:\r\r\n        json.dump({\"routine\": slots.get(\"routine\"),\r\r\n                   \"actuation\": \"artifact-only\"}, f, indent=2)\r\r\n    return {\"ok\": True, \"artifact\": path, \"actuated\": False,\r\r\n            \"note\": \"home device channel not configured — artifact only\"}\r\r\n\r\r\n\r\r\ndef h_set_depth(ctx, slots, nid):\r\r\n    prev = ctx.ledger.resolve(\"config\", \"chat:response-depth\")\r\r\n    ctx.ledger.say(\"config\", \"chat:response-depth\",\r\r\n                   int(slots[\"depth\"]), claimant=\"principal\",\r\r\n                   certainty=1.0, basis={\"kind\": \"user-choice\"},\r\r\n                   supersedes=prev.id if prev else None)\r\r\n    return {\"ok\": True, \"depth\": int(slots[\"depth\"])}\r\r\n\r\r\n\r\r\ndef h_focus_need(ctx, slots, nid):\r\r\n    return floor.focus_need(ctx, slots[\"needId\"], slots.get(\"on\", True))\r\r\n\r\r\n\r\r\ndef h_select_context(ctx, slots, nid):\r\r\n    r = archive.select_context(ctx, slots[\"kind\"], slots[\"ref\"],\r\r\n                               slots[\"label\"], slots.get(\"excerpt\", \"\"))\r\r\n    # the top respondent comments on the selection\r\r\n    persona = ctx.personas.active()\r\r\n    if persona and slots.get(\"excerpt\"):\r\r\n        d = personas_mod.compose(\r\r\n            ctx, persona, f\"Comment on this selected {slots['kind']}: \"\r\r\n                          f\"{slots['label']}\",\r\r\n            facts=[{\"text\": slots[\"excerpt\"],\r\r\n                    \"source\": f\"selected:{slots['kind']}\"}])\r\r\n        r[\"commentary\"] = {\"persona\": persona[\"name\"], \"text\": d[\"text\"],\r\r\n                           \"register\": d.get(\"register\")}\r\r\n        ctx.bus.emit(\"persona.speak\", {\"persona\": persona[\"id\"],\r\r\n                                      \"name\": persona[\"name\"],\r\r\n                                      \"text\": d[\"text\"],\r\r\n                                      \"contextCommentary\": True})\r\r\n    return r\r\r\n\r\r\n\r\r\ndef h_validate_tool(ctx, slots, nid):\r\r\n    spec = slots.get(\"spec\")\r\r\n    if isinstance(spec, str):\r\r\n        spec = json.loads(spec)\r\r\n    return dsl.validate_spec(spec)\r\r\n\r\r\n\r\r\ndef h_create_tool(ctx, slots, nid):\r\r\n    spec = slots.get(\"spec\")\r\r\n    if isinstance(spec, str):\r\r\n        spec = json.loads(spec)\r\r\n    v = dsl.validate_spec(spec)\r\r\n    if not v[\"ok\"]:\r\r\n        return {\"ok\": False, \"validation\": v}\r\r\n    ctx.tools.tool(spec[\"id\"], spec.get(\"title\", spec[\"id\"]),\r\r\n                   need=spec.get(\"need\"), template=spec.get(\"template\"),\r\r\n                   steps=spec.get(\"steps\"), authored=True)\r\r\n    path = os.path.join(ctx.runtime, \"authored-tools.json\")\r\r\n    authored = []\r\r\n    if os.path.exists(path):\r\r\n        authored = json.load(open(path, encoding=\"utf-8\"))\r\r\n    authored = [t for t in authored if t[\"id\"] != spec[\"id\"]]\r\r\n    authored.append(spec)\r\r\n    json.dump(authored, open(path, \"w\", encoding=\"utf-8\"), indent=2)\r\r\n    return {\"ok\": True, \"toolId\": spec[\"id\"], \"validation\": v}\r\r\n\r\r\n\r\r\ndef h_inspect_tool(ctx, slots, nid):\r\r\n    t = ctx.tools.get(slots[\"toolId\"])\r\r\n    if not t:\r\r\n        return {\"ok\": False, \"error\": \"no such tool\"}\r\r\n    runs = [a.value.get(\"v\") for a in ctx.ledger.query(\r\r\n        predicate=\"need:executed\", limit=200)\r\r\n        if True][:20]\r\r\n    return {\"ok\": True, \"tool\": {\"id\": t[\"id\"], \"title\": t[\"title\"],\r\r\n                                 \"need\": t[\"need\"], \"template\": t[\"template\"],\r\r\n                                 \"authored\": t.get(\"authored\"),\r\r\n                                 \"steps\": bool(t.get(\"steps\"))},\r\r\n            \"trust\": compare_mod.trust(ctx.ledger, t[\"id\"])}\r\r\n\r\r\n\r\r\ndef h_steward_tick(ctx, slots, nid):\r\r\n    return ctx.steward.tick(reason=\"tool\")\r\r\n\r\r\n\r\r\ndef h_assign_stewardship(ctx, slots, nid):\r\r\n    duty = slots[\"duty\"]\r\r\n    on = bool(slots.get(\"on\", True))\r\r\n    prev = ctx.ledger.resolve(\"steward\", f\"steward:duty:{duty}\")\r\r\n    ctx.ledger.say(\"steward\", f\"steward:duty:{duty}\",\r\r\n                   {\"duty\": duty, \"on\": on},\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"},\r\r\n                   supersedes=prev.id if prev else None)\r\r\n    return {\"ok\": True, \"duty\": duty, \"on\": on}\r\r\n\r\r\n\r\r\ndef h_import_calendar(ctx, slots, nid):\r\r\n    from . import connectors\r\r\n    return connectors.import_ics(ctx, slots.get(\"ics\", \"\"),\r\r\n                                 slots.get(\"source\", \"ics-manual\"))\r\r\n\r\r\n\r\r\ndef h_link_calendar(ctx, slots, nid):\r\r\n    buckets = temporal.classify(ctx.ledger)\r\r\n    proj = slots.get(\"projectId\")\r\r\n    linked = []\r\r\n    toks = set(re.findall(r\"[a-z]{4,}\", (slots.get(\"title\") or \"\").lower()))\r\r\n    for b in (\"current\", \"upcoming\"):\r\r\n        for ev in buckets[b]:\r\r\n            etoks = set(re.findall(r\"[a-z]{4,}\", ev[\"summary\"].lower()))\r\r\n            if toks & etoks:\r\r\n                linked.append(ev[\"summary\"])\r\r\n                ctx.ledger.say(f\"project:{proj}\", \"calendar:linked\",\r\r\n                               {\"event\": ev[\"summary\"], \"when\":\r\r\n                                ev.get(\"start_dt\")},\r\r\n                               claimant=\"model:temporal\", certainty=0.8,\r\r\n                               basis={\"kind\": \"interpretation\"})\r\r\n    return {\"ok\": True, \"linked\": linked}\r\r\n\r\r\n\r\r\ndef h_endorse_source(ctx, slots, nid):\r\r\n    src = slots[\"source\"]\r\r\n    ctx.ledger.say(\"sources\", \"source:endorsement\",\r\r\n                   {\"source\": src, \"raise\": 0.1},\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"})\r\r\n    prev = ctx.ledger.resolve(\"sources\", f\"source:ceiling:{src}\")\r\r\n    ctx.ledger.say(\"sources\", \"source:ceiling\",\r\r\n                   {\"claimant\": src, \"ceiling\":\r\r\n                    min(1.0, 0.7 + 0.15)},\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"})\r\r\n    return {\"ok\": True, \"endorsed\": src}\r\r\n\r\r\n\r\r\ndef h_cleanup(ctx, slots, nid):\r\r\n    return ctx.ledger.compact(\r\r\n        [\"decision:score\", \"inference:snapshot\", \"speech:admitted\",\r\r\n         \"idle:steward-run\", \"archive:turn\"], keep=3)\r\r\n\r\r\n\r\r\ndef h_apply_preload(ctx, slots, nid):\r\r\n    \"\"\"C-SettingsPreloads: a named preload is a bundle of assertions over the\r\r\n    common presentation/config choice set; it supplies starting values that\r\r\n    later choices supersede.\"\"\"\r\r\n    name = slots[\"name\"]\r\r\n    pack = PRELOADS.get(name)\r\r\n    if not pack:\r\r\n        return {\"ok\": False, \"error\": f\"unknown preload '{name}'\",\r\r\n                \"available\": sorted(PRELOADS)}\r\r\n    applied = []\r\r\n    for pred, val in pack[\"settings\"].items():\r\r\n        prev = ctx.ledger.resolve(\"config\", pred)\r\r\n        ctx.ledger.say(\"config\", pred, val, claimant=\"principal\",\r\r\n                       certainty=1.0, basis={\"kind\": \"user-choice\"},\r\r\n                       supersedes=prev.id if prev else None,\r\r\n                       tags=[\"preload:\" + name])\r\r\n        applied.append(pred)\r\r\n    ctx.ledger.say(\"config\", \"preload:applied\",\r\r\n                   {\"name\": name, \"settings\": applied},\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"})\r\r\n    return {\"ok\": True, \"preload\": name, \"applied\": applied}\r\r\n\r\r\n\r\r\ndef h_set_theme(ctx, slots, nid):\r\r\n    theme = slots[\"theme\"]\r\r\n    prev = ctx.ledger.resolve(\"config\", \"ui:shell-theme\")\r\r\n    ctx.ledger.say(\"config\", \"ui:shell-theme\", theme,\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"},\r\r\n                   supersedes=prev.id if prev else None)\r\r\n    return {\"ok\": True, \"theme\": theme}\r\r\n\r\r\n\r\r\ndef h_transcribe(ctx, slots, nid):\r\r\n    \"\"\"Browser Web Speech transcript → witness → chat turn (mic channel).\"\"\"\r\r\n    text = slots[\"text\"]\r\r\n    ctx.ledger.say(\"device\", \"device:speech-transcript\",\r\r\n                   {\"text\": text, \"channel\": \"browser-webspeech\"},\r\r\n                   claimant=\"surface:mic\", certainty=0.9,\r\r\n                   basis={\"kind\": \"captured-input\"})\r\r\n    return run_chat_turn(ctx, text, via=\"mic\")\r\r\n\r\r\n\r\r\ndef h_note_for_persona(ctx, slots, nid):\r\r\n    pid = slots[\"personaId\"]\r\r\n    p = ctx.personas.get(pid)\r\r\n    if not p:\r\r\n        return {\"ok\": False, \"error\": \"no such persona\"}\r\r\n    note = slots[\"note\"]\r\r\n    ctx.ledger.say(f\"persona:{pid}\", \"persona:note\",\r\r\n                   {\"note\": note}, claimant=\"principal\", certainty=0.9,\r\r\n                   basis={\"kind\": \"user-choice\"})\r\r\n    p.setdefault(\"notes\", []).append(note)\r\r\n    ctx.personas.save()\r\r\n    return {\"ok\": True, \"noted\": note}\r\r\n\r\r\n\r\r\ndef h_compare_run(ctx, slots, nid):\r\r\n    return ctx.compete(slots[\"need\"], slots.get(\"input\", {}))\r\r\n\r\r\n\r\r\n# -- named settings preloads (C-PreloadSuite — ≥3, era-named) -----------------\r\r\n\r\r\nPRELOADS = {\r\r\n    \"athenaeum\": {\"settings\": {\"ui:shell-theme\": \"sepia\",\r\r\n                               \"chat:response-depth\": 3,\r\r\n                               \"user:persona-frame\": \"personified\"}},\r\r\n    \"workshop\":  {\"settings\": {\"ui:shell-theme\": \"light\",\r\r\n                               \"chat:response-depth\": 1,\r\r\n                               \"user:persona-frame\": \"respondent\"}},\r\r\n    \"evening\":   {\"settings\": {\"ui:shell-theme\": \"dark\",\r\r\n                               \"chat:response-depth\": 2,\r\r\n                               \"user:persona-frame\": \"respondent\"}},\r\r\n}\r\r\n\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# registration\r\r\n\r\r\ndef register(ctx):\r\r\n    R = ctx.tools\r\r\n    R.tool(\"set-topic\", \"Set conversation topic\",\r\r\n           need=\"chat.topic\",\r\r\n           template={\"slots\": [{\"name\": \"topic\", \"required\": True,\r\r\n                                \"test\": {\"kind\": \"minLen\", \"n\": 2}}]},\r\r\n           handler=h_set_topic)\r\r\n    R.tool(\"chat-reset\", \"Seal + reset the conversation\",\r\r\n           handler=h_chat_reset)\r\r\n    R.tool(\"remember\", \"Record a fact as a user assertion\",\r\r\n           need=\"memory.note\",\r\r\n           template={\"slots\": [{\"name\": \"fact\", \"required\": True,\r\r\n                                \"test\": {\"kind\": \"minLen\", \"n\": 3}}]},\r\r\n           handler=h_remember)\r\r\n    R.tool(\"create-project\", \"Create a project with goals\",\r\r\n           need=\"project.create\",\r\r\n           template={\"slots\": [{\"name\": \"title\", \"required\": True},\r\r\n                               {\"name\": \"goals\", \"required\": False}]},\r\r\n           handler=h_create_project)\r\r\n    R.tool(\"build-list\", \"Build a criteria-governed list (set fulfillment)\",\r\r\n           need=\"set.build\",\r\r\n           template={\"slots\": [{\"name\": \"criteria\", \"required\": True,\r\r\n                                \"test\": {\"kind\": \"minLen\", \"n\": 5}}]},\r\r\n           handler=h_build_list)\r\r\n    R.tool(\"retrieve-set-wiki-table\", \"Set members via PA wikitable class\",\r\r\n           need=\"set.members\", handler=h_retrieve_table)\r\r\n    R.tool(\"retrieve-set-wiki-category\", \"Set members via PA category\",\r\r\n           need=\"set.members\", handler=h_retrieve_category)\r\r\n    R.tool(\"run-search\", \"Search configured sources\",\r\r\n           need=\"search.run\",\r\r\n           template={\"slots\": [{\"name\": \"query\", \"required\": True,\r\r\n                                \"test\": {\"kind\": \"minLen\", \"n\": 3}}]},\r\r\n           handler=h_run_search)\r\r\n    R.tool(\"persona-mint\", \"Mint a personality (minimal input ok)\",\r\r\n           need=\"persona.mint\",\r\r\n           template={\"slots\": [{\"name\": \"name\", \"required\": True,\r\r\n                                \"test\": {\"kind\": \"minLen\", \"n\": 2}},\r\r\n                               {\"name\": \"traits\"}, {\"name\": \"interests\"},\r\r\n                               {\"name\": \"lens\"}, {\"name\": \"figure\"},\r\r\n                               {\"name\": \"responsibilities\"}]},\r\r\n           handler=h_persona_mint)\r\r\n    R.tool(\"persona-onboard\", \"Portrait + voice + characterization needs\",\r\r\n           need=\"persona.onboard\",\r\r\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True}]},\r\r\n           handler=h_persona_onboard)\r\r\n    R.tool(\"generate-portrait\", \"Generate + bind persona portrait\",\r\r\n           need=\"persona.portrait\",\r\r\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True}]},\r\r\n           handler=h_generate_portrait)\r\r\n    R.tool(\"persona-voice-set\", \"Assign/modify persona voice\",\r\r\n           need=\"persona.voice\",\r\r\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True},\r\r\n                               {\"name\": \"name\"}, {\"name\": \"rate\"}]},\r\r\n           handler=h_persona_voice_set)\r\r\n    R.tool(\"characterize-persona\", \"Write persona characterization\",\r\r\n           need=\"persona.characterize\",\r\r\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True}]},\r\r\n           handler=h_characterize)\r\r\n    R.tool(\"persona-update\", \"Edit persona elements\",\r\r\n           need=\"persona.update\",\r\r\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True},\r\r\n                               {\"name\": \"patch\", \"required\": True}]},\r\r\n           handler=h_persona_update)\r\r\n    R.tool(\"speak-voice\", \"Speak text through the speech floor\",\r\r\n           need=\"speech.speak\",\r\r\n           template={\"slots\": [{\"name\": \"text\", \"required\": True},\r\r\n                               {\"name\": \"persona\"}, {\"name\": \"voice\"},\r\r\n                               {\"name\": \"rate\"}]},\r\r\n           handler=h_speak_voice)\r\r\n    R.tool(\"render-speech-sapi\", \"Local SAPI speech renderer\",\r\r\n           need=\"speech.render\",\r\r\n           template={\"slots\": [{\"name\": \"text\", \"required\": True},\r\r\n                               {\"name\": \"voice\"}, {\"name\": \"rate\"}]},\r\r\n           handler=h_render_sapi)\r\r\n    R.tool(\"render-speech-remote\", \"Remote speech service (declared absent)\",\r\r\n           need=\"speech.render\",\r\r\n           template={\"slots\": [{\"name\": \"text\", \"required\": True},\r\r\n                               {\"name\": \"voice\"}]},\r\r\n           handler=h_render_remote)\r\r\n    R.tool(\"import-exchange\", \"Import an exchange package below threshold\",\r\r\n           need=\"exchange.import\",\r\r\n           template={\"slots\": [{\"name\": \"package\", \"required\": True}]},\r\r\n           handler=h_import_exchange)\r\r\n    R.tool(\"export-exchange\", \"Export a storefront package\",\r\r\n           need=\"exchange.export\",\r\r\n           template={\"slots\": [{\"name\": \"predicate\"}]},\r\r\n           handler=h_export_exchange)\r\r\n    R.tool(\"publish-milestone\", \"Publish a milestone (grant-gated)\",\r\r\n           need=\"publish.artifact\", consequential=True,\r\r\n           template={\"slots\": [{\"name\": \"target\", \"required\": True},\r\r\n                               {\"name\": \"content\", \"required\": True}],\r\r\n                     \"grant\": \"publish.creator\"},\r\r\n           handler=h_publish)\r\r\n    R.tool(\"send-mail\", \"Send mail (grant-gated; honest local outbox)\",\r\r\n           need=\"mail.send\", consequential=True,\r\r\n           template={\"slots\": [{\"name\": \"to\", \"required\": True},\r\r\n                               {\"name\": \"body\", \"required\": True}],\r\r\n                     \"grant\": \"mail.send\"},\r\r\n           handler=h_send_mail)\r\r\n    R.tool(\"dispatch-home-routine\", \"Actuate home routine (grant-gated)\",\r\r\n           need=\"home.actuate\", consequential=True,\r\r\n           template={\"slots\": [{\"name\": \"routine\", \"required\": True}],\r\r\n                     \"grant\": \"home.actuate\"},\r\r\n           handler=h_home_routine)\r\r\n    R.tool(\"set-response-depth\", \"Respondents per turn (1-4)\",\r\r\n           need=\"config.depth\",\r\r\n           template={\"slots\": [{\"name\": \"depth\", \"required\": True,\r\r\n                                \"test\": {\"kind\": \"range\",\r\r\n                                         \"lo\": 1, \"hi\": 4}}]},\r\r\n           handler=h_set_depth)\r\r\n    R.tool(\"focus-need\", \"Move a need into focus\",\r\r\n           need=\"need.focus\",\r\r\n           template={\"slots\": [{\"name\": \"needId\", \"required\": True},\r\r\n                               {\"name\": \"on\"}]},\r\r\n           handler=h_focus_need)\r\r\n    R.tool(\"select-context\", \"Pull an item into conversational context\",\r\r\n           need=\"context.select\",\r\r\n           template={\"slots\": [{\"name\": \"kind\", \"required\": True},\r\r\n                               {\"name\": \"ref\", \"required\": True},\r\r\n                               {\"name\": \"label\", \"required\": True},\r\r\n                               {\"name\": \"excerpt\"}]},\r\r\n           handler=h_select_context)\r\r\n    R.tool(\"validate-tool\", \"Validate a tool spec (errors+hints)\",\r\r\n           need=\"tool.validate\",\r\r\n           template={\"slots\": [{\"name\": \"spec\", \"required\": True}]},\r\r\n           handler=h_validate_tool)\r\r\n    R.tool(\"create-tool\", \"Mint an authored tool from a spec\",\r\r\n           need=\"tool.create\",\r\r\n           template={\"slots\": [{\"name\": \"spec\", \"required\": True}]},\r\r\n           handler=h_create_tool)\r\r\n    R.tool(\"inspect-tool\", \"Tool detail + trust telemetry\",\r\r\n           need=\"tool.inspect\",\r\r\n           template={\"slots\": [{\"name\": \"toolId\", \"required\": True}]},\r\r\n           handler=h_inspect_tool)\r\r\n    R.tool(\"steward-tick\", \"Run one stewardship pass\",\r\r\n           need=\"steward.tick\", handler=h_steward_tick)\r\r\n    R.tool(\"assign-stewardship\", \"Configure a steward duty\",\r\r\n           need=\"steward.assign\",\r\r\n           template={\"slots\": [{\"name\": \"duty\", \"required\": True},\r\r\n                               {\"name\": \"on\"}]},\r\r\n           handler=h_assign_stewardship)\r\r\n    R.tool(\"import-calendar\", \"Import ICS calendar source evidence\",\r\r\n           need=\"calendar.import\",\r\r\n           template={\"slots\": [{\"name\": \"ics\", \"required\": True},\r\r\n                               {\"name\": \"source\"}]},\r\r\n           handler=h_import_calendar)\r\r\n    R.tool(\"link-calendar\", \"Relate project to calendar events\",\r\r\n           need=\"calendar.link\",\r\r\n           template={\"slots\": [{\"name\": \"projectId\", \"required\": True},\r\r\n                               {\"name\": \"title\"}]},\r\r\n           handler=h_link_calendar)\r\r\n    R.tool(\"endorse-source\", \"Raise a source's inherited confidence\",\r\r\n           need=\"source.endorse\",\r\r\n           template={\"slots\": [{\"name\": \"source\", \"required\": True}]},\r\r\n           handler=h_endorse_source)\r\r\n    R.tool(\"cleanup-run\", \"Governed ledger consolidation\",\r\r\n           need=\"ledger.cleanup\", handler=h_cleanup)\r\r\n    R.tool(\"apply-preload\", \"Apply a named settings preload\",\r\r\n           need=\"config.preload\",\r\r\n           template={\"slots\": [{\"name\": \"name\", \"required\": True,\r\r\n                                \"test\": {\"kind\": \"enum\",\r\r\n                                         \"options\": sorted(PRELOADS)}}]},\r\r\n           handler=h_apply_preload)\r\r\n    R.tool(\"set-theme\", \"Set the shell colorway\",\r\r\n           need=\"ui.theme\",\r\r\n           template={\"slots\": [{\"name\": \"theme\", \"required\": True,\r\r\n                                \"test\": {\"kind\": \"enum\",\r\r\n                                         \"options\": [\"light\", \"dark\",\r\r\n                                                    \"sepia\", \"slate\"]}}]},\r\r\n           handler=h_set_theme)\r\r\n    R.tool(\"transcribe-speech\", \"Browser speech transcript → turn\",\r\r\n           need=\"speech.transcribe\",\r\r\n           template={\"slots\": [{\"name\": \"text\", \"required\": True}]},\r\r\n           handler=h_transcribe)\r\r\n    R.tool(\"note-for-persona\", \"Add a note to a persona\",\r\r\n           need=\"persona.note\",\r\r\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True},\r\r\n                               {\"name\": \"note\", \"required\": True}]},\r\r\n           handler=h_note_for_persona)\r\r\n    R.tool(\"compare-run\", \"Run competing tools on the same input\",\r\r\n           need=\"comparison.run\",\r\r\n           template={\"slots\": [{\"name\": \"need\", \"required\": True},\r\r\n                               {\"name\": \"input\"}]},\r\r\n           handler=h_compare_run)\r\r\n\r\r\n    # -- system commands (object.verb) ----------------------------------------\r\r\n    C = ctx.tools.command\r\r\n    C(\"ledger.query\", lambda ctx, a: [\r\r\n        r.row() for r in ctx.ledger.query(**a)])\r\r\n    C(\"ledger.assert\", lambda ctx, a: ctx.ledger.say(\r\r\n        a[\"subject\"], a[\"predicate\"], a[\"value\"],\r\r\n        claimant=a.get(\"claimant\", \"principal\"),\r\r\n        certainty=a.get(\"certainty\", 0.9),\r\r\n        basis={\"kind\": a.get(\"basis\", \"user-choice\")}).row())\r\r\n    C(\"roster.select\", lambda ctx, a: ctx.personas.select(a[\"personaId\"]))\r\r\n    C(\"roster.move\", lambda ctx, a: ctx.personas.move(\r\r\n        a[\"personaId\"], a.get(\"direction\", 0)))\r\r\n    C(\"roster.list\", lambda ctx, a: [p[\"id\"] for p in ctx.personas.roster()])\r\r\n    C(\"need.focus\", lambda ctx, a: floor.focus_need(\r\r\n        ctx, a[\"needId\"], a.get(\"on\", True)))\r\r\n    C(\"need.cancel\", lambda ctx, a: floor.cancel_need(ctx, a[\"needId\"]))\r\r\n    C(\"grant.issue\", lambda ctx, a: {\"grantId\": floor.issue_grant(\r\r\n        ctx, a[\"scope\"], a.get(\"lock\"), a.get(\"consumable\", True))})\r\r\n    C(\"theme.set\", lambda ctx, a: h_set_theme(ctx, a, None))\r\r\n    C(\"preload.apply\", lambda ctx, a: h_apply_preload(ctx, a, None))\r\r\n    C(\"steward.wake\", lambda ctx, a: ctx.steward.tick(reason=\"command\"))\r\r\n    C(\"chat.topic\", lambda ctx, a: archive.set_topic(ctx, a[\"topic\"]))\r\r\n","newText":"\"\"\"Builtin components — tools, commands, and the chat-turn chain.\nRegistration happens once at boot into ctx.tools. Handlers receive\n(ctx, slots, need_id) and return a result dict; needs machinery wraps every\ninvoke in an unmet requirement first.\n\"\"\"\nfrom __future__ import annotations\nimport json\nimport os\nimport re\nimport threading\nfrom . import (model, floor, archive, temporal, setbuild, personas as\n               personas_mod, compare as compare_mod, dsl)\n# ---------------------------------------------------------------------------\n# chat-turn helpers\ndef _facts_for_text(ctx, text: str, limit=3) -> list:\n    \"\"\"Retrieve source facts for a factual prompt: wikipedia search → summary\n    extracts. Facts are verbatim source material with their source recorded —\n    the persona may use ONLY these (G-B).\"\"\"\n    q = re.sub(r\"[?!.]+$\", \"\", text)\n    q = re.sub(r\"^(what|who|where|when|which|why|how|is|are|does|did|\"\n               r\"tell me|describe|explain)\\s+(is|are|was|were|a|an|the|\"\n               r\"about|me about|me)?\\s*\", \"\", q, flags=re.I).strip()\n    if len(q) < 3:\n        return []\n    s = ctx.wiki.search(q, limit=3)\n    facts = []\n    if not s.get(\"ok\"):\n        return facts\n    for title in s.get(\"titles\", [])[:2]:\n        r = ctx.wiki.summary(title)\n        if r.get(\"ok\") and r.get(\"extract\"):\n            facts.append({\"text\": r[\"extract\"][:600],\n                          \"source\": f\"wikipedia:{r['title']}\"})\n            ctx.ledger.say(\"facts\", \"source:used\",\n                           {\"title\": r[\"title\"], \"for\": text[:120],\n                            \"excerpt\": r[\"extract\"][:240]},\n                           claimant=\"source:wikipedia\", certainty=0.85,\n                           basis={\"kind\": \"source-evidence\"})\n        if len(facts) >= limit:\n            break\n    return facts\ndef _decision_weights(led):\n    a = led.resolve(\"config\", \"decision:weights\")\n    if a:\n        v = a.value.get(\"v\")\n        if isinstance(v, list) and len(v) == 5:\n            return v\n    return [0.35, 0.40, 0.25, 1.0, 0.10]  # active, heldConf, overlap, named, rank\ndef select_respondents(ctx, text: str, depth: int, address: str = None) -> list:\n    \"\"\"Bounded decision model (fixed feature vector, weighted sum). The\n    active persona, held-confidence (dyadic rows), lens-interest overlap with\n    the topic/text, direct address (C-ChorusOnAddress — a named persona\n    answers regardless of rank), and roster position all factor in. Every\n    score is a ledger row — routing is inspectable.\"\"\"\n    led = ctx.ledger\n    w = _decision_weights(led)\n    roster = ctx.personas.roster()\n    topic = archive.topic(led).lower()\n    scores = []\n    for i, p in enumerate(roster):\n        named = 1.0 if (address and p[\"id\"] == address) or \\\n            re.search(rf\"\\b{re.escape(p['name'])}\\b\", text, re.I) else 0.0\n        overlap = 0.0\n        toks = set(re.findall(r\"[a-z]{4,}\", (topic + \" \" + text).lower()))\n        inter = set(x.lower() for x in p.get(\"interests\", []))\n        if toks and inter:\n            overlap = len(toks & inter) / len(inter)\n        held = ctx.personas.held_confidence(p[\"id\"])\n        active = 1.0 if ctx.personas.data.get(\"active\") == p[\"id\"] else 0.0\n        rankn = 1.0 - (i / max(1, len(roster) - 1)) if len(roster) > 1 else 1.0\n        f = [active, held, min(1.0, overlap), named, rankn]\n        score = sum(a * b for a, b in zip(w, f))\n        scores.append({\"persona\": p[\"id\"], \"name\": p[\"name\"], \"score\":\n                       round(score, 3), \"features\": [round(x, 3) for x in f]})\n        led.say(\"decision\", \"decision:score\",\n                {\"persona\": p[\"id\"], \"features\": f, \"weights\": w,\n                 \"score\": round(score, 4)},\n                claimant=\"model:respondent-selector\", certainty=0.9,\n                basis={\"kind\": \"interpretation\"})\n    scores.sort(key=lambda s: s[\"score\"], reverse=True)\n    chosen = scores[:max(1, depth)]\n    for rank, s in enumerate(chosen):\n        led.say(\"decision\", \"decision:respondent\",\n                {\"rank\": rank, \"persona\": s[\"persona\"], \"name\": s[\"name\"],\n                 \"score\": s[\"score\"]},\n                claimant=\"model:respondent-selector\", certainty=0.9,\n                basis={\"kind\": \"interpretation\"})\n    return chosen\ndef serve_response(ctx, text: str, respondents: list, facts: list,\n                   history: str, need_id: str = None) -> list:\n    \"\"\"C-SnapshotInference + C-SequentialCommit:\n    1. each respondent drafts IN PARALLEL against its own consistent ledger\n       snapshot (never each other's uncommitted work)\n    2. verified drafts commit back in ranked order\n    3. later respondents may append a short reaction reading the committed\n       earlier contribution (C-SequentialRespondents) — the reaction commits\n       after it, still in order.\n    Replies are emitted as persona.speak cards and admitted to the speech\n    floor in commit order.\"\"\"\n    led = ctx.ledger\n    snap_ids = []\n    drafts = {}\n    def draft(p):\n        snap = led.snapshot()\n        sid = model.rid(\"snap\")\n        snap_ids.append(sid)\n        led.say(\"inference\", \"inference:snapshot\",\n                {\"snapshot\": sid, \"task\": p[\"name\"], \"rows\": len(snap.rows)},\n                claimant=\"model:inference\", certainty=1.0,\n                basis={\"kind\": \"interpretation\"})\n        persona = ctx.personas.get(p[\"persona\"])\n        history_view = history  # snapshot-consistent (pre-turn reads only)\n        drafts[p[\"persona\"]] = personas_mod.compose(\n            ctx, persona, text, facts=facts, history=history_view)\n    threads = [threading.Thread(target=draft, args=(p,)) for p in respondents]\n    for t in threads:\n        t.start()\n    for t in threads:\n        t.join(timeout=150)\n    replies = []\n    committed_texts = []\n    for rank, p in enumerate(respondents):\n        persona = ctx.personas.get(p[\"persona\"])\n        d = drafts.get(p[\"persona\"]) or {\n            \"ok\": True, \"text\": \"…\", \"register\": persona.get(\"register\"),\n            \"engine\": \"none\"}\n        led.say(\"inference\", \"inference:commit\",\n                {\"rank\": rank, \"persona\": p[\"persona\"], \"name\": p[\"name\"],\n                 \"engine\": d.get(\"engine\"),\n                 \"fidelity\": d.get(\"fidelity\")},\n                claimant=\"model:inference\", certainty=1.0,\n                basis={\"kind\": \"execution\"})\n        reply = {\"persona\": p[\"persona\"], \"name\": persona[\"name\"],\n                 \"register\": d.get(\"register\"), \"text\": d.get(\"text\"),\n                 \"engine\": d.get(\"engine\"), \"rank\": rank,\n                 \"fidelity\": d.get(\"fidelity\")}\n        led.say(f\"persona:{p['persona']}\", \"persona:reply\",\n                {\"text\": d.get(\"text\"), \"register\": d.get(\"register\"),\n                 \"prompt\": text[:200], \"engine\": d.get(\"engine\"),\n                 \"fidelity\": d.get(\"fidelity\")},\n                claimant=\"persona:\" + persona[\"name\"].lower(),\n                certainty=0.9, basis={\"kind\": \"generated\"})\n        ctx.bus.emit(\"persona.speak\", reply)\n        ctx.floor.admit(persona[\"name\"], d.get(\"text\") or \"\",\n                        voice=(persona.get(\"voice\") or {}).get(\"name\"),\n                        rate=(persona.get(\"voice\") or {}).get(\"rate\", 0),\n                        render=ctx.engines.tts.mode == \"sapi\")\n        committed_texts.append((persona, d.get(\"text\") or \"\"))\n        replies.append(reply)\n    # sequential reaction pass — later respondents react to committed work\n    for rank in range(1, len(respondents)):\n        p = respondents[rank]\n        persona = ctx.personas.get(p[\"persona\"])\n        earlier = committed_texts[rank - 1]\n        d = personas_mod.compose(ctx, persona, text, facts=[],\n                                 react_to=f\"{earlier[0]['name']}: \"\n                                          f\"{earlier[1][:120]}\")\n        if d.get(\"text\"):\n            led.say(\"inference\", \"inference:commit\",\n                    {\"rank\": rank, \"persona\": p[\"persona\"],\n                     \"kind\": \"reaction\", \"reactsTo\": earlier[0][\"name\"]},\n                    claimant=\"model:inference\", certainty=1.0,\n                    basis={\"kind\": \"execution\"})\n            reply = {\"persona\": p[\"persona\"], \"name\": persona[\"name\"],\n                     \"register\": d.get(\"register\"), \"text\": d.get(\"text\"),\n                     \"engine\": d.get(\"engine\"), \"rank\": rank,\n                     \"reaction\": True}\n            ctx.bus.emit(\"persona.speak\", reply)\n            ctx.floor.admit(persona[\"name\"], d.get(\"text\") or \"\",\n                            voice=(persona.get(\"voice\") or {}).get(\"name\"),\n                            rate=(persona.get(\"voice\") or {}).get(\"rate\", 0),\n                            render=ctx.engines.tts.mode == \"sapi\")\n            replies.append(reply)\n    return replies\n# ---------------------------------------------------------------------------\n# intent packs — chat input → tool needs + response need\ndef parse_intents(ctx, text: str) -> dict:\n    intents = []\n    t = text.strip()\n    low = t.lower()\n    pats = [\n        (\"set-topic\", r\"(?:set|change) (?:the )?topic to (.+)\",\n         lambda m: {\"topic\": m.group(1).strip()}),\n        (\"chat-reset\", r\"^reset (?:the )?conversation$\", lambda m: {}),\n        (\"build-list\", r\"list (?:me )?(all (?:the )?.+)\",\n         lambda m: {\"criteria\": m.group(1).strip()}),\n        (\"create-project\",\n         r\"(?:create|start|open) (?:a )?project (?:called |titled |to )?(.+)\",\n         lambda m: {\"title\": m.group(1).strip()}),\n        (\"persona-mint\",\n         r\"(?:create|mint|make) (?:a )?(?:persona|personality|avatar)\"\n         r\"(?: named | called )?(\\w[\\w\\-]*)\",\n         lambda m: {\"name\": m.group(1)}),\n        (\"run-search\",\n         r\"(?:search|look up|find out about|research) (?:for )?(.+)\",\n         lambda m: {\"query\": m.group(1).strip()}),\n        (\"remember\", r\"remember (?:that )?(.+)\",\n         lambda m: {\"fact\": m.group(1).strip()}),\n        (\"publish-milestone\", r\"(?:publish|post) (.+)\",\n         lambda m: {\"target\": \"milestone\", \"content\": m.group(1).strip()}),\n        (\"send-mail\",\n         r\"(?:send )?(?:an )?email to (.+?)(?: saying |: | that )(.+)\",\n         lambda m: {\"to\": m.group(1).strip(), \"body\": m.group(2).strip()}),\n    ]\n    for tid, rx, slots_fn in pats:\n        m = re.search(rx, low if tid != \"persona-mint\" else t, re.I)\n        if m:\n            intents.append({\"toolId\": tid, \"slots\": slots_fn(m)})\n    if re.search(r\"\\?\\s*$\", t) or re.match(\n            r\"^(what|who|where|when|which|why|how|tell me about|\"\n            r\"describe|explain)\\b\", low):\n        if not any(i[\"toolId\"] == \"run-search\" for i in intents):\n            intents.append({\"toolId\": \"run-search\",\n                            \"slots\": {\"query\": re.sub(r\"[?!.]+$\", \"\", t)}})\n        intents.append({\"kind\": \"factual\"})\n    return {\"routed\": True, \"intents\": intents}\ndef run_chat_turn(ctx, text: str, address=None, via=\"chat\") -> dict:\n    led = ctx.ledger\n    inp = led.say(\"chat\", \"chat:input\", {\"text\": text, \"via\": via},\n                  claimant=\"principal\" if via == \"chat\" else \"surface:\" + via,\n                  certainty=1.0, basis={\"kind\": \"captured-input\"})\n    # focused need: conversational slot fill (S-focused-need)\n    fnid = floor.focused_need(led)\n    focus_fill = None\n    if fnid and not re.search(r\"(?:set the topic|reset conversation)\", text,\n                              re.I):\n        rows = floor.need_rows(led, fnid)\n        opener = next((r for r in rows if r.predicate == \"need:open\"), None)\n        spec = (opener.value.get(\"v\") or {}) if opener else {}\n        missing = spec.get(\"missing\") or []\n        if missing:\n            slot = missing[0]\n            val = text.strip()\n            try:\n                val = int(val)\n            except ValueError:\n                pass\n            supply = floor.supply_candidate(ctx, fnid, slot, val,\n                                            source=\"user\")\n            r = ctx.retry(fnid)\n            focus_fill = {\"needId\": fnid, \"slot\": slot, \"value\": val,\n                          \"test\": supply.get(\"test\"),\n                          \"fulfilled\": bool(r.get(\"ok\"))}\n    intents = parse_intents(ctx, text)[\"intents\"]\n    need_ids, results = [], []\n    for it in intents:\n        if it.get(\"kind\") == \"factual\":\n            continue\n        r = ctx.invoke(it[\"toolId\"], it[\"slots\"],\n                       summary=f\"chat:{it['toolId']}\", via=\"chat\")\n        need_ids.append(r.get(\"needId\"))\n        results.append({\"toolId\": it[\"toolId\"], \"ok\": r.get(\"ok\"),\n                        \"deferred\": r.get(\"deferred\"),\n                        \"needId\": r.get(\"needId\")})\n        if r.get(\"deferred\"):\n            continue  # needs stay open — the floor records them\n    # facts: for factual prompts AND for selected-context commentary\n    factual = any(i.get(\"kind\") == \"factual\" for i in intents)\n    facts = _facts_for_text(ctx, text) if factual else []\n    ctxsel = archive.context(led)\n    if ctxsel and ctxsel.get(\"excerpt\"):\n        facts = [{\"text\": ctxsel[\"excerpt\"],\n                  \"source\": f\"context:{ctxsel.get('kind')}:{ctxsel.get('ref')}\"}]\n    depth = 2\n    a = led.resolve(\"config\", \"chat:response-depth\")\n    if a:\n        try:\n            depth = int(a.value.get(\"v\"))\n        except (TypeError, ValueError):\n            pass\n    resp_need = led.say(\"chat\", \"need:response\",\n                        {\"text\": text[:200], \"depth\": depth,\n                         \"factual\": factual},\n                        claimant=\"system\", certainty=1.0,\n                        basis={\"kind\": \"interpretation\"})\n    respondents = select_respondents(ctx, text, depth, address)\n    history = _history(led)\n    replies = serve_response(ctx, text, respondents, facts, history,\n                             need_id=resp_need.id)\n    led.say(\"chat\", \"need:fulfilled\",\n            {\"needId\": resp_need.id, \"respondents\": [r[\"name\"] for r in\n             replies]}, claimant=\"system\", certainty=1.0,\n            basis={\"kind\": \"durable-result\"}, links=[resp_need.id])\n    archive.archive_turn(ctx, {\"input\": text, \"intents\": intents,\n                               \"needIds\": need_ids,\n                               \"respondents\": [r[\"name\"] for r in replies],\n                               \"focusFill\": focus_fill})\n    return {\"ok\": True, \"inputId\": inp.id, \"intents\": intents,\n            \"needIds\": need_ids, \"toolResults\": results,\n            \"responseNeedId\": resp_need.id, \"replies\": replies,\n            \"focusFill\": focus_fill}\ndef _history(led, limit=8):\n    rows = led.query(predicate=\"archive:turn\", limit=limit)\n    lines = []\n    for a in reversed(rows):\n        v = a.value.get(\"v\") or {}\n        lines.append(f\"user: {v.get('input','')[:100]}\")\n    return \"\\n\".join(lines[-limit:])\n# ---------------------------------------------------------------------------\n# tool handlers\ndef h_set_topic(ctx, slots, nid):\n    return archive.set_topic(ctx, slots[\"topic\"])\ndef h_chat_reset(ctx, slots, nid):\n    return archive.reset(ctx)\ndef h_remember(ctx, slots, nid):\n    ctx.ledger.say(\"memory\", \"memory:fact\", {\"fact\": slots[\"fact\"]},\n                   claimant=\"principal\", certainty=0.95,\n                   basis={\"kind\": \"user-choice\"})\n    return {\"ok\": True, \"remembered\": slots[\"fact\"]}\ndef h_create_project(ctx, slots, nid):\n    title = slots[\"title\"]\n    goals = slots.get(\"goals\") or []\n    pid = model.rid(\"proj\")\n    ctx.ledger.say(f\"project:{pid}\", \"project:profile\",\n                   {\"title\": title, \"goals\": goals, \"status\": \"open\"},\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"})\n    goal_needs = []\n    for g in goals:\n        pseudo = {\"id\": \"project-goal-work\", \"kind\": \"generic\",\n                  \"template\": {\"slots\": [\n                      {\"name\": \"deliverable\", \"required\": True},\n                      {\"name\": \"format\", \"required\": True,\n                       \"test\": {\"kind\": \"enum\",\n                                \"options\": [\"report\", \"summary\", \"list\",\n                                            \"hardcover\", \"pdf\", \"table\"]}}]},\n                  \"handler\": h_project_goal}\n        r = floor.open_need(ctx, pseudo, {\"deliverable\": g},\n                            summary=f\"goal:{g}\", via=\"project\")\n        goal_needs.append(r.get(\"needId\"))\n    ctx.ledger.say(f\"project:{pid}\", \"project:needs\",\n                   {\"needIds\": goal_needs, \"goals\": goals},\n                   claimant=\"system\", certainty=1.0,\n                   basis={\"kind\": \"interpretation\"})\n    return {\"ok\": True, \"projectId\": pid, \"title\": title,\n            \"goalNeeds\": goal_needs}\ndef h_project_goal(ctx, slots, nid):\n    ctx.ledger.say(\"project\", \"project:deliverable\",\n                   {\"goal\": slots.get(\"deliverable\"),\n                    \"format\": slots.get(\"format\"), \"needId\": nid},\n                   claimant=\"system\", certainty=1.0,\n                   basis={\"kind\": \"durable-result\"})\n    return {\"ok\": True, \"delivered\": slots.get(\"deliverable\"),\n            \"format\": slots.get(\"format\")}\ndef h_build_list(ctx, slots, nid):\n    criteria = slots[\"criteria\"]\n    pid = model.rid(\"proj\")\n    ctx.ledger.say(f\"project:{pid}\", \"project:profile\",\n                   {\"title\": f\"list: {criteria}\", \"kind\": \"list-project\",\n                    \"status\": \"running\"},\n                   claimant=\"system\", certainty=1.0,\n                   basis={\"kind\": \"interpretation\"})\n    r = setbuild.build(ctx, criteria, need_id=nid)\n    status = \"done\" if r.get(\"ok\") else \"failed\"\n    ctx.ledger.say(f\"project:{pid}\", \"project:status\",\n                   {\"status\": status, \"memberCount\": r.get(\"memberCount\")},\n                   claimant=\"system\", certainty=1.0,\n                   basis={\"kind\": \"durable-result\"})\n    r[\"projectId\"] = pid\n    return r\ndef h_retrieve_table(ctx, slots, nid):\n    return setbuild.via_table(ctx, slots.get(\"criteria\", \"\"))\ndef h_retrieve_category(ctx, slots, nid):\n    return setbuild.via_category(ctx, slots.get(\"criteria\", \"\"))\ndef h_run_search(ctx, slots, nid):\n    q = slots[\"query\"]\n    s = ctx.wiki.search(q, limit=5)\n    if not s.get(\"ok\"):\n        ctx.ledger.say(\"search\", \"search:adequacy\",\n                       {\"query\": q, \"adequate\": False,\n                        \"reason\": s.get(\"error\")},\n                       claimant=\"source:wikipedia\", certainty=0.9,\n                       basis={\"kind\": \"source-evidence\"})\n        return {\"ok\": False, \"error\": s.get(\"error\")}\n    hits = []\n    for title in s.get(\"titles\", [])[:4]:\n        r = ctx.wiki.summary(title)\n        if r.get(\"ok\") and r.get(\"extract\"):\n            hits.append({\"title\": r[\"title\"],\n                         \"extract\": r[\"extract\"][:400],\n                         \"url\": r.get(\"url\")})\n    ctx.ledger.say(\"search\", \"search:adequacy\",\n                   {\"query\": q, \"adequate\": bool(hits), \"hits\": len(hits)},\n                   claimant=\"source:wikipedia\", certainty=0.9,\n                   basis={\"kind\": \"source-evidence\"})\n    for h in hits:\n        ctx.ledger.say(\"search\", \"search:hit\", h,\n                       claimant=\"source:wikipedia\", certainty=0.85,\n                       basis={\"kind\": \"source-evidence\"})\n    return {\"ok\": True, \"query\": q, \"hits\": hits}\ndef h_persona_mint(ctx, slots, nid):\n    return ctx.personas.mint(\n        name=slots[\"name\"], traits=slots.get(\"traits\"),\n        interests=slots.get(\"interests\"), lens=slots.get(\"lens\"),\n        figure=slots.get(\"figure\"),\n        responsibilities=slots.get(\"responsibilities\"))\ndef h_persona_onboard(ctx, slots, nid):\n    \"\"\"Extend a minimal persona: portrait, voice, characterization — each\n    opened and served as a real need (prompt demo 5).\"\"\"\n    pid = slots[\"personaId\"]\n    p = ctx.personas.get(pid)\n    if not p:\n        return {\"ok\": False, \"error\": \"no such persona\"}\n    out = {\"personaId\": pid, \"name\": p[\"name\"]}\n    art_res = ctx.invoke(\"generate-portrait\", {\"personaId\": pid},\n                         summary=\"onboard:portrait\", via=\"onboard\")\n    out[\"portrait\"] = art_res.get(\"result\")\n    v_res = ctx.invoke(\"persona-voice-set\",\n                       {\"personaId\": pid,\n                        \"name\": (p.get(\"voice\") or {}).get(\"name\"),\n                        \"rate\": (p.get(\"voice\") or {}).get(\"rate\", 0)},\n                       summary=\"onboard:voice\", via=\"onboard\")\n    out[\"voice\"] = v_res.get(\"result\")\n    c_res = ctx.invoke(\"characterize-persona\", {\"personaId\": pid},\n                       summary=\"onboard:characterization\", via=\"onboard\")\n    out[\"characterization\"] = c_res.get(\"result\")\n    out[\"ok\"] = all(isinstance(x, dict) and x.get(\"ok\") for x in\n                    (out[\"portrait\"], out[\"voice\"], out[\"characterization\"]))\n    return out\ndef h_generate_portrait(ctx, slots, nid):\n    pid = slots[\"personaId\"]\n    p = ctx.personas.get(pid)\n    if not p:\n        return {\"ok\": False, \"error\": \"no such persona\"}\n    from . import art\n    r = art.generate(ctx, pid, p[\"name\"], mark=p.get(\"mark\"))\n    p[\"art\"] = {\"file\": r[\"file\"], \"motif\": r[\"motif\"],\n                \"palette\": r[\"palette\"], \"params\": r[\"params\"]}\n    ctx.personas.save()\n    ctx.ledger.say(f\"persona:{pid}\", \"persona:art\",\n                   {\"artifact\": r[\"file\"], \"motif\": r[\"motif\"],\n                    \"params\": r[\"params\"], \"bound\": True},\n                   claimant=\"engine:portrait\", certainty=1.0,\n                   basis={\"kind\": \"durable-result\"})\n    return {\"ok\": True, \"artifact\": r[\"file\"], \"motif\": r[\"motif\"]}\ndef h_persona_voice_set(ctx, slots, nid):\n    pid = slots[\"personaId\"]\n    p = ctx.personas.get(pid)\n    if not p:\n        return {\"ok\": False, \"error\": \"no such persona\"}\n    if slots.get(\"name\"):\n        p.setdefault(\"voice\", {})[\"name\"] = slots[\"name\"]\n    if slots.get(\"rate\") is not None:\n        p.setdefault(\"voice\", {})[\"rate\"] = int(slots[\"rate\"])\n    ctx.personas.save()\n    ctx.ledger.say(f\"persona:{pid}\", \"persona:voice\", p[\"voice\"],\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"})\n    return {\"ok\": True, \"voice\": p[\"voice\"]}\ndef h_characterize(ctx, slots, nid):\n    pid = slots[\"personaId\"]\n    p = ctx.personas.get(pid)\n    if not p:\n        return {\"ok\": False, \"error\": \"no such persona\"}\n    system = (f\"Summarize how the persona {p['name']} sees the world: lens, \"\n              f\"responsibilities, characteristic phrasing. Traits: \"\n              f\"{', '.join(p.get('traits', []))}. Register: \"\n              f\"{p.get('register')}. Under 80 words, third person.\")\n    r = ctx.engines.llm.chat(system, f\"Persona: {json.dumps(p)[:600]}\",\n                             max_tokens=120)\n    if r.get(\"ok\") and r.get(\"text\"):\n        text = r[\"text\"].strip()\n        engine = r[\"engine\"]\n    else:\n        text = (f\"{p['name']} reads the ledger through {p.get('register')} \"\n                f\"lenses: {', '.join(p.get('traits', []))}. Interests: \"\n                f\"{', '.join(p.get('interests', [])) or 'general'}. \"\n                f\"Speaks {p.get('register')}; bound to the record.\")\n        engine = \"declared-template\"\n    p[\"characterization\"] = text\n    ctx.personas.save()\n    ctx.ledger.say(f\"persona:{pid}\", \"persona:characterization\",\n                   {\"text\": text, \"engine\": engine},\n                   claimant=\"persona:\" + p[\"name\"].lower(), certainty=0.9,\n                   basis={\"kind\": \"generated\"})\n    return {\"ok\": True, \"characterization\": text, \"engine\": engine}\ndef h_persona_update(ctx, slots, nid):\n    return ctx.personas.update(slots[\"personaId\"], slots.get(\"patch\", {}))\ndef h_speak_voice(ctx, slots, nid):\n    name = slots.get(\"persona\") or (ctx.personas.active() or {}).get(\"name\",\n                                                                    \"system\")\n    item = ctx.floor.admit(name, slots[\"text\"],\n                           voice=slots.get(\"voice\"),\n                           rate=slots.get(\"rate\", 0),\n                           render=ctx.engines.tts.mode == \"sapi\")\n    res = ctx.floor.wait(item, timeout=180)\n    return res or {\"ok\": False, \"error\": \"floor timeout\"}\ndef h_render_sapi(ctx, slots, nid):\n    return ctx.engines.tts.render_local(slots[\"text\"],\n                                        voice=slots.get(\"voice\"),\n                                        rate=slots.get(\"rate\", 0))\ndef h_render_remote(ctx, slots, nid):\n    return ctx.engines.tts.render_remote(slots[\"text\"],\n                                         voice=slots.get(\"voice\"))\ndef h_import_exchange(ctx, slots, nid):\n    path = slots.get(\"package\")\n    if isinstance(path, dict):\n        pkg = path\n    else:\n        if not path or not os.path.exists(path):\n            return {\"ok\": False, \"error\": \"no such package\"}\n        pkg = json.load(open(path, encoding=\"utf-8\"))\n    if pkg.get(\"schema\") != ctx.exchange_schema:\n        return {\"ok\": False, \"error\":\n                f\"schema mismatch ({pkg.get('schema')})\"}\n    counts = {\"personas\": 0, \"tools\": 0, \"assertions\": 0, \"needs\": 0}\n    src = \"exchange:\" + pkg.get(\"id\", \"pkg\")\n    for p in pkg.get(\"personas\", []):\n        r = ctx.personas.mint(**p)\n        ctx.ledger.say(\"exchange\", \"exchange:imported\",\n                       {\"kind\": \"persona\", \"id\": r.get(\"personaId\"),\n                        \"package\": pkg.get(\"id\")},\n                       claimant=src, certainty=0.4,\n                       basis={\"kind\": \"import\"})\n        counts[\"personas\"] += 1\n    for t in pkg.get(\"tools\", []):\n        ctx.tools.tool(t[\"id\"], t.get(\"title\", t[\"id\"]), need=t.get(\"need\"),\n                       template=t.get(\"template\"), steps=t.get(\"steps\"),\n                       authored=True)\n        ctx.ledger.say(\"exchange\", \"exchange:imported\",\n                       {\"kind\": \"tool\", \"id\": t[\"id\"],\n                        \"package\": pkg.get(\"id\")},\n                       claimant=src, certainty=0.4, basis={\"kind\": \"import\"})\n        counts[\"tools\"] += 1\n    for a in pkg.get(\"assertions\", []):\n        ctx.ledger.say(a[\"subject\"], a[\"predicate\"], a[\"value\"],\n                       claimant=src, certainty=0.4, basis={\"kind\": \"import\"})\n        counts[\"assertions\"] += 1\n    for n in pkg.get(\"needs\", []):\n        ctx.ledger.say(\"exchange\", \"exchange:imported\",\n                       {\"kind\": \"need\", \"summary\": n.get(\"summary\"),\n                        \"package\": pkg.get(\"id\"), \"held\": \"below-threshold\"},\n                       claimant=src, certainty=0.4, basis={\"kind\": \"import\"})\n        counts[\"needs\"] += 1\n    ctx.ledger.say(\"exchange\", \"exchange:package\",\n                   {\"id\": pkg.get(\"id\"), \"schema\": pkg.get(\"schema\"),\n                    \"counts\": counts, \"threshold\": 0.4,\n                    \"status\": \"held-below-action-threshold\"},\n                   claimant=\"system\", certainty=1.0,\n                   basis={\"kind\": \"durable-result\"})\n    return {\"ok\": True, \"package\": pkg.get(\"id\"), \"counts\": counts,\n            \"threshold\": 0.4}\ndef h_export_exchange(ctx, slots, nid):\n    pred = slots.get(\"predicate\")\n    pkg = {\"schema\": ctx.exchange_schema, \"id\": model.rid(\"pkg\"),\n           \"personas\": [], \"tools\": [], \"assertions\": [], \"needs\": []}\n    for p in ctx.personas.roster()[:6]:\n        pkg[\"personas\"].append({\"name\": p[\"name\"], \"traits\": p[\"traits\"],\n                                \"interests\": p[\"interests\"],\n                                \"lens\": p[\"lens\"]})\n    for t in ctx.tools.tools.values():\n        if t.get(\"authored\"):\n            pkg[\"tools\"].append({\"id\": t[\"id\"], \"title\": t[\"title\"],\n                                 \"need\": t[\"need\"],\n                                 \"template\": t[\"template\"],\n                                 \"steps\": t.get(\"steps\")})\n    for a in ctx.ledger.query(predicate=pred, limit=40) if pred else []:\n        pkg[\"assertions\"].append({\"subject\": a.subject,\n                                  \"predicate\": a.predicate,\n                                  \"value\": a.value.get(\"v\")})\n    for n in ctx.open_needs()[:10]:\n        pkg[\"needs\"].append({\"summary\": n[\"summary\"],\n                             \"toolId\": n[\"toolId\"]})\n    outdir = os.path.join(ctx.runtime, \"artifacts\", \"exports\")\n    os.makedirs(outdir, exist_ok=True)\n    path = os.path.join(outdir, pkg[\"id\"] + \".json\")\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(pkg, f, indent=2, ensure_ascii=False)\n    ctx.ledger.say(\"exchange\", \"exchange:exported\",\n                   {\"id\": pkg[\"id\"], \"path\": path,\n                    \"counts\": {k: len(v) for k, v in pkg.items()\n                               if isinstance(v, list)}},\n                   claimant=\"system\", certainty=1.0,\n                   basis={\"kind\": \"durable-result\"})\n    return {\"ok\": True, \"path\": path,\n            \"counts\": {k: len(v) for k, v in pkg.items()\n                       if isinstance(v, list)}}\ndef h_publish(ctx, slots, nid):\n    \"\"\"Grant-gated consequential tool. With a witnessed grant it writes a\n    real local artifact — it never claims a network effect it can't produce.\"\"\"\n    outdir = os.path.join(ctx.runtime, \"outbox\")\n    os.makedirs(outdir, exist_ok=True)\n    fname = f\"milestone-{model.rid('pub')}.md\"\n    path = os.path.join(outdir, fname)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(f\"# {slots.get('target','milestone')}\\n\\n\"\n                f\"{slots.get('content','')}\\n\\n\"\n                f\"— published to local outbox by Vantage\\n\")\n    ctx.ledger.say(\"publish\", \"publish:artifact\",\n                   {\"target\": slots.get(\"target\"), \"artifact\": path,\n                    \"channel\": \"local-outbox\",\n                    \"note\": \"no configured remote channel — artifact, not \"\n                            \"transmission\"},\n                   claimant=\"tool:publish-milestone\", certainty=1.0,\n                   basis={\"kind\": \"execution\"})\n    return {\"ok\": True, \"artifact\": path, \"channel\": \"local-outbox\",\n            \"delivered\": False,\n            \"note\": \"wrote local artifact; no remote channel configured\"}\ndef h_send_mail(ctx, slots, nid):\n    outdir = os.path.join(ctx.runtime, \"outbox\")\n    os.makedirs(outdir, exist_ok=True)\n    fname = f\"mail-{model.rid('eml')}.eml\"\n    path = os.path.join(outdir, fname)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(f\"To: {slots.get('to')}\\nSubject: Vantage message\\n\\n\"\n                f\"{slots.get('body')}\\n\")\n    ctx.ledger.say(\"mail\", \"mail:queued\",\n                   {\"to\": slots.get(\"to\"), \"artifact\": path,\n                    \"status\": \"queued-local-outbox\",\n                    \"delivered\": False},\n                   claimant=\"tool:send-mail\", certainty=1.0,\n                   basis={\"kind\": \"execution\"})\n    return {\"ok\": True, \"artifact\": path, \"delivered\": False,\n            \"status\": \"queued-local-outbox\"}\ndef h_home_routine(ctx, slots, nid):\n    outdir = os.path.join(ctx.runtime, \"outbox\")\n    os.makedirs(outdir, exist_ok=True)\n    path = os.path.join(outdir, f\"routine-{model.rid('act')}.json\")\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump({\"routine\": slots.get(\"routine\"),\n                   \"actuation\": \"artifact-only\"}, f, indent=2)\n    return {\"ok\": True, \"artifact\": path, \"actuated\": False,\n            \"note\": \"home device channel not configured — artifact only\"}\ndef h_set_depth(ctx, slots, nid):\n    prev = ctx.ledger.resolve(\"config\", \"chat:response-depth\")\n    ctx.ledger.say(\"config\", \"chat:response-depth\",\n                   int(slots[\"depth\"]), claimant=\"principal\",\n                   certainty=1.0, basis={\"kind\": \"user-choice\"},\n                   supersedes=prev.id if prev else None)\n    return {\"ok\": True, \"depth\": int(slots[\"depth\"])}\ndef h_focus_need(ctx, slots, nid):\n    return floor.focus_need(ctx, slots[\"needId\"], slots.get(\"on\", True))\ndef h_select_context(ctx, slots, nid):\n    r = archive.select_context(ctx, slots[\"kind\"], slots[\"ref\"],\n                               slots[\"label\"], slots.get(\"excerpt\", \"\"))\n    # the top respondent comments on the selection\n    persona = ctx.personas.active()\n    if persona and slots.get(\"excerpt\"):\n        d = personas_mod.compose(\n            ctx, persona, f\"Comment on this selected {slots['kind']}: \"\n                          f\"{slots['label']}\",\n            facts=[{\"text\": slots[\"excerpt\"],\n                    \"source\": f\"selected:{slots['kind']}\"}])\n        r[\"commentary\"] = {\"persona\": persona[\"name\"], \"text\": d[\"text\"],\n                           \"register\": d.get(\"register\")}\n        ctx.bus.emit(\"persona.speak\", {\"persona\": persona[\"id\"],\n                                      \"name\": persona[\"name\"],\n                                      \"text\": d[\"text\"],\n                                      \"contextCommentary\": True})\n    return r\ndef h_validate_tool(ctx, slots, nid):\n    spec = slots.get(\"spec\")\n    if isinstance(spec, str):\n        spec = json.loads(spec)\n    return dsl.validate_spec(spec)\ndef h_create_tool(ctx, slots, nid):\n    spec = slots.get(\"spec\")\n    if isinstance(spec, str):\n        spec = json.loads(spec)\n    v = dsl.validate_spec(spec)\n    if not v[\"ok\"]:\n        return {\"ok\": False, \"validation\": v}\n    ctx.tools.tool(spec[\"id\"], spec.get(\"title\", spec[\"id\"]),\n                   need=spec.get(\"need\"), template=spec.get(\"template\"),\n                   steps=spec.get(\"steps\"), authored=True)\n    path = os.path.join(ctx.runtime, \"authored-tools.json\")\n    authored = []\n    if os.path.exists(path):\n        authored = json.load(open(path, encoding=\"utf-8\"))\n    authored = [t for t in authored if t[\"id\"] != spec[\"id\"]]\n    authored.append(spec)\n    json.dump(authored, open(path, \"w\", encoding=\"utf-8\"), indent=2)\n    return {\"ok\": True, \"toolId\": spec[\"id\"], \"validation\": v}\ndef h_inspect_tool(ctx, slots, nid):\n    t = ctx.tools.get(slots[\"toolId\"])\n    if not t:\n        return {\"ok\": False, \"error\": \"no such tool\"}\n    runs = [a.value.get(\"v\") for a in ctx.ledger.query(\n        predicate=\"need:executed\", limit=200)\n        if True][:20]\n    return {\"ok\": True, \"tool\": {\"id\": t[\"id\"], \"title\": t[\"title\"],\n                                 \"need\": t[\"need\"], \"template\": t[\"template\"],\n                                 \"authored\": t.get(\"authored\"),\n                                 \"steps\": bool(t.get(\"steps\"))},\n            \"trust\": compare_mod.trust(ctx.ledger, t[\"id\"])}\ndef h_steward_tick(ctx, slots, nid):\n    return ctx.steward.tick(reason=\"tool\")\ndef h_assign_stewardship(ctx, slots, nid):\n    duty = slots[\"duty\"]\n    on = bool(slots.get(\"on\", True))\n    prev = ctx.ledger.resolve(\"steward\", f\"steward:duty:{duty}\")\n    ctx.ledger.say(\"steward\", f\"steward:duty:{duty}\",\n                   {\"duty\": duty, \"on\": on},\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"},\n                   supersedes=prev.id if prev else None)\n    return {\"ok\": True, \"duty\": duty, \"on\": on}\ndef h_import_calendar(ctx, slots, nid):\n    from . import connectors\n    return connectors.import_ics(ctx, slots.get(\"ics\", \"\"),\n                                 slots.get(\"source\", \"ics-manual\"))\ndef h_link_calendar(ctx, slots, nid):\n    buckets = temporal.classify(ctx.ledger)\n    proj = slots.get(\"projectId\")\n    linked = []\n    toks = set(re.findall(r\"[a-z]{4,}\", (slots.get(\"title\") or \"\").lower()))\n    for b in (\"current\", \"upcoming\"):\n        for ev in buckets[b]:\n            etoks = set(re.findall(r\"[a-z]{4,}\", ev[\"summary\"].lower()))\n            if toks & etoks:\n                linked.append(ev[\"summary\"])\n                ctx.ledger.say(f\"project:{proj}\", \"calendar:linked\",\n                               {\"event\": ev[\"summary\"], \"when\":\n                                ev.get(\"start_dt\")},\n                               claimant=\"model:temporal\", certainty=0.8,\n                               basis={\"kind\": \"interpretation\"})\n    return {\"ok\": True, \"linked\": linked}\ndef h_endorse_source(ctx, slots, nid):\n    src = slots[\"source\"]\n    ctx.ledger.say(\"sources\", \"source:endorsement\",\n                   {\"source\": src, \"raise\": 0.1},\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"})\n    prev = ctx.ledger.resolve(\"sources\", f\"source:ceiling:{src}\")\n    ctx.ledger.say(\"sources\", \"source:ceiling\",\n                   {\"claimant\": src, \"ceiling\":\n                    min(1.0, 0.7 + 0.15)},\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"})\n    return {\"ok\": True, \"endorsed\": src}\ndef h_cleanup(ctx, slots, nid):\n    return ctx.ledger.compact(\n        [\"decision:score\", \"inference:snapshot\", \"speech:admitted\",\n         \"idle:steward-run\", \"archive:turn\"], keep=3)\ndef h_apply_preload(ctx, slots, nid):\n    \"\"\"C-SettingsPreloads: a named preload is a bundle of assertions over the\n    common presentation/config choice set; it supplies starting values that\n    later choices supersede.\"\"\"\n    name = slots[\"name\"]\n    pack = PRELOADS.get(name)\n    if not pack:\n        return {\"ok\": False, \"error\": f\"unknown preload '{name}'\",\n                \"available\": sorted(PRELOADS)}\n    applied = []\n    for pred, val in pack[\"settings\"].items():\n        prev = ctx.ledger.resolve(\"config\", pred)\n        ctx.ledger.say(\"config\", pred, val, claimant=\"principal\",\n                       certainty=1.0, basis={\"kind\": \"user-choice\"},\n                       supersedes=prev.id if prev else None,\n                       tags=[\"preload:\" + name])\n        applied.append(pred)\n    ctx.ledger.say(\"config\", \"preload:applied\",\n                   {\"name\": name, \"settings\": applied},\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"})\n    return {\"ok\": True, \"preload\": name, \"applied\": applied}\ndef h_set_theme(ctx, slots, nid):\n    theme = slots[\"theme\"]\n    prev = ctx.ledger.resolve(\"config\", \"ui:shell-theme\")\n    ctx.ledger.say(\"config\", \"ui:shell-theme\", theme,\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"},\n                   supersedes=prev.id if prev else None)\n    return {\"ok\": True, \"theme\": theme}\ndef h_transcribe(ctx, slots, nid):\n    \"\"\"Browser Web Speech transcript → witness → chat turn (mic channel).\"\"\"\n    text = slots[\"text\"]\n    ctx.ledger.say(\"device\", \"device:speech-transcript\",\n                   {\"text\": text, \"channel\": \"browser-webspeech\"},\n                   claimant=\"surface:mic\", certainty=0.9,\n                   basis={\"kind\": \"captured-input\"})\n    return run_chat_turn(ctx, text, via=\"mic\")\ndef h_note_for_persona(ctx, slots, nid):\n    pid = slots[\"personaId\"]\n    p = ctx.personas.get(pid)\n    if not p:\n        return {\"ok\": False, \"error\": \"no such persona\"}\n    note = slots[\"note\"]\n    ctx.ledger.say(f\"persona:{pid}\", \"persona:note\",\n                   {\"note\": note}, claimant=\"principal\", certainty=0.9,\n                   basis={\"kind\": \"user-choice\"})\n    p.setdefault(\"notes\", []).append(note)\n    ctx.personas.save()\n    return {\"ok\": True, \"noted\": note}\ndef h_compare_run(ctx, slots, nid):\n    return ctx.compete(slots[\"need\"], slots.get(\"input\", {}))\n# -- named settings preloads (C-PreloadSuite — ≥3, era-named) -----------------\nPRELOADS = {\n    \"athenaeum\": {\"settings\": {\"ui:shell-theme\": \"sepia\",\n                               \"chat:response-depth\": 3,\n                               \"user:persona-frame\": \"personified\"}},\n    \"workshop\":  {\"settings\": {\"ui:shell-theme\": \"light\",\n                               \"chat:response-depth\": 1,\n                               \"user:persona-frame\": \"respondent\"}},\n    \"evening\":   {\"settings\": {\"ui:shell-theme\": \"dark\",\n                               \"chat:response-depth\": 2,\n                               \"user:persona-frame\": \"respondent\"}},\n}\n# ---------------------------------------------------------------------------\n# registration\ndef register(ctx):\n    R = ctx.tools\n    R.tool(\"set-topic\", \"Set conversation topic\",\n           need=\"chat.topic\",\n           template={\"slots\": [{\"name\": \"topic\", \"required\": True,\n                                \"test\": {\"kind\": \"minLen\", \"n\": 2}}]},\n           handler=h_set_topic)\n    R.tool(\"chat-reset\", \"Seal + reset the conversation\",\n           handler=h_chat_reset)\n    R.tool(\"remember\", \"Record a fact as a user assertion\",\n           need=\"memory.note\",\n           template={\"slots\": [{\"name\": \"fact\", \"required\": True,\n                                \"test\": {\"kind\": \"minLen\", \"n\": 3}}]},\n           handler=h_remember)\n    R.tool(\"create-project\", \"Create a project with goals\",\n           need=\"project.create\",\n           template={\"slots\": [{\"name\": \"title\", \"required\": True},\n                               {\"name\": \"goals\", \"required\": False}]},\n           handler=h_create_project)\n    R.tool(\"build-list\", \"Build a criteria-governed list (set fulfillment)\",\n           need=\"set.build\",\n           template={\"slots\": [{\"name\": \"criteria\", \"required\": True,\n                                \"test\": {\"kind\": \"minLen\", \"n\": 5}}]},\n           handler=h_build_list)\n    R.tool(\"retrieve-set-wiki-table\", \"Set members via PA wikitable class\",\n           need=\"set.members\", handler=h_retrieve_table)\n    R.tool(\"retrieve-set-wiki-category\", \"Set members via PA category\",\n           need=\"set.members\", handler=h_retrieve_category)\n    R.tool(\"run-search\", \"Search configured sources\",\n           need=\"search.run\",\n           template={\"slots\": [{\"name\": \"query\", \"required\": True,\n                                \"test\": {\"kind\": \"minLen\", \"n\": 3}}]},\n           handler=h_run_search)\n    R.tool(\"persona-mint\", \"Mint a personality (minimal input ok)\",\n           need=\"persona.mint\",\n           template={\"slots\": [{\"name\": \"name\", \"required\": True,\n                                \"test\": {\"kind\": \"minLen\", \"n\": 2}},\n                               {\"name\": \"traits\"}, {\"name\": \"interests\"},\n                               {\"name\": \"lens\"}, {\"name\": \"figure\"},\n                               {\"name\": \"responsibilities\"}]},\n           handler=h_persona_mint)\n    R.tool(\"persona-onboard\", \"Portrait + voice + characterization needs\",\n           need=\"persona.onboard\",\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True}]},\n           handler=h_persona_onboard)\n    R.tool(\"generate-portrait\", \"Generate + bind persona portrait\",\n           need=\"persona.portrait\",\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True}]},\n           handler=h_generate_portrait)\n    R.tool(\"persona-voice-set\", \"Assign/modify persona voice\",\n           need=\"persona.voice\",\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True},\n                               {\"name\": \"name\"}, {\"name\": \"rate\"}]},\n           handler=h_persona_voice_set)\n    R.tool(\"characterize-persona\", \"Write persona characterization\",\n           need=\"persona.characterize\",\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True}]},\n           handler=h_characterize)\n    R.tool(\"persona-update\", \"Edit persona elements\",\n           need=\"persona.update\",\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True},\n                               {\"name\": \"patch\", \"required\": True}]},\n           handler=h_persona_update)\n    R.tool(\"speak-voice\", \"Speak text through the speech floor\",\n           need=\"speech.speak\",\n           template={\"slots\": [{\"name\": \"text\", \"required\": True},\n                               {\"name\": \"persona\"}, {\"name\": \"voice\"},\n                               {\"name\": \"rate\"}]},\n           handler=h_speak_voice)\n    R.tool(\"render-speech-sapi\", \"Local SAPI speech renderer\",\n           need=\"speech.render\",\n           template={\"slots\": [{\"name\": \"text\", \"required\": True},\n                               {\"name\": \"voice\"}, {\"name\": \"rate\"}]},\n           handler=h_render_sapi)\n    R.tool(\"render-speech-remote\", \"Remote speech service (declared absent)\",\n           need=\"speech.render\",\n           template={\"slots\": [{\"name\": \"text\", \"required\": True},\n                               {\"name\": \"voice\"}]},\n           handler=h_render_remote)\n    R.tool(\"import-exchange\", \"Import an exchange package below threshold\",\n           need=\"exchange.import\",\n           template={\"slots\": [{\"name\": \"package\", \"required\": True}]},\n           handler=h_import_exchange)\n    R.tool(\"export-exchange\", \"Export a storefront package\",\n           need=\"exchange.export\",\n           template={\"slots\": [{\"name\": \"predicate\"}]},\n           handler=h_export_exchange)\n    R.tool(\"publish-milestone\", \"Publish a milestone (grant-gated)\",\n           need=\"publish.artifact\", consequential=True,\n           template={\"slots\": [{\"name\": \"target\", \"required\": True},\n                               {\"name\": \"content\", \"required\": True}],\n                     \"grant\": \"publish.creator\"},\n           handler=h_publish)\n    R.tool(\"send-mail\", \"Send mail (grant-gated; honest local outbox)\",\n           need=\"mail.send\", consequential=True,\n           template={\"slots\": [{\"name\": \"to\", \"required\": True},\n                               {\"name\": \"body\", \"required\": True}],\n                     \"grant\": \"mail.send\"},\n           handler=h_send_mail)\n    R.tool(\"dispatch-home-routine\", \"Actuate home routine (grant-gated)\",\n           need=\"home.actuate\", consequential=True,\n           template={\"slots\": [{\"name\": \"routine\", \"required\": True}],\n                     \"grant\": \"home.actuate\"},\n           handler=h_home_routine)\n    R.tool(\"set-response-depth\", \"Respondents per turn (1-4)\",\n           need=\"config.depth\",\n           template={\"slots\": [{\"name\": \"depth\", \"required\": True,\n                                \"test\": {\"kind\": \"range\",\n                                         \"lo\": 1, \"hi\": 4}}]},\n           handler=h_set_depth)\n    R.tool(\"focus-need\", \"Move a need into focus\",\n           need=\"need.focus\",\n           template={\"slots\": [{\"name\": \"needId\", \"required\": True},\n                               {\"name\": \"on\"}]},\n           handler=h_focus_need)\n    R.tool(\"select-context\", \"Pull an item into conversational context\",\n           need=\"context.select\",\n           template={\"slots\": [{\"name\": \"kind\", \"required\": True},\n                               {\"name\": \"ref\", \"required\": True},\n                               {\"name\": \"label\", \"required\": True},\n                               {\"name\": \"excerpt\"}]},\n           handler=h_select_context)\n    R.tool(\"validate-tool\", \"Validate a tool spec (errors+hints)\",\n           need=\"tool.validate\",\n           template={\"slots\": [{\"name\": \"spec\", \"required\": True}]},\n           handler=h_validate_tool)\n    R.tool(\"create-tool\", \"Mint an authored tool from a spec\",\n           need=\"tool.create\",\n           template={\"slots\": [{\"name\": \"spec\", \"required\": True}]},\n           handler=h_create_tool)\n    R.tool(\"inspect-tool\", \"Tool detail + trust telemetry\",\n           need=\"tool.inspect\",\n           template={\"slots\": [{\"name\": \"toolId\", \"required\": True}]},\n           handler=h_inspect_tool)\n    R.tool(\"steward-tick\", \"Run one stewardship pass\",\n           need=\"steward.tick\", handler=h_steward_tick)\n    R.tool(\"assign-stewardship\", \"Configure a steward duty\",\n           need=\"steward.assign\",\n           template={\"slots\": [{\"name\": \"duty\", \"required\": True},\n                               {\"name\": \"on\"}]},\n           handler=h_assign_stewardship)\n    R.tool(\"import-calendar\", \"Import ICS calendar source evidence\",\n           need=\"calendar.import\",\n           template={\"slots\": [{\"name\": \"ics\", \"required\": True},\n                               {\"name\": \"source\"}]},\n           handler=h_import_calendar)\n    R.tool(\"link-calendar\", \"Relate project to calendar events\",\n           need=\"calendar.link\",\n           template={\"slots\": [{\"name\": \"projectId\", \"required\": True},\n                               {\"name\": \"title\"}]},\n           handler=h_link_calendar)\n    R.tool(\"endorse-source\", \"Raise a source's inherited confidence\",\n           need=\"source.endorse\",\n           template={\"slots\": [{\"name\": \"source\", \"required\": True}]},\n           handler=h_endorse_source)\n    R.tool(\"cleanup-run\", \"Governed ledger consolidation\",\n           need=\"ledger.cleanup\", handler=h_cleanup)\n    R.tool(\"apply-preload\", \"Apply a named settings preload\",\n           need=\"config.preload\",\n           template={\"slots\": [{\"name\": \"name\", \"required\": True,\n                                \"test\": {\"kind\": \"enum\",\n                                         \"options\": sorted(PRELOADS)}}]},\n           handler=h_apply_preload)\n    R.tool(\"set-theme\", \"Set the shell colorway\",\n           need=\"ui.theme\",\n           template={\"slots\": [{\"name\": \"theme\", \"required\": True,\n                                \"test\": {\"kind\": \"enum\",\n                                         \"options\": [\"light\", \"dark\",\n                                                    \"sepia\", \"slate\"]}}]},\n           handler=h_set_theme)\n    R.tool(\"transcribe-speech\", \"Browser speech transcript → turn\",\n           need=\"speech.transcribe\",\n           template={\"slots\": [{\"name\": \"text\", \"required\": True}]},\n           handler=h_transcribe)\n    R.tool(\"note-for-persona\", \"Add a note to a persona\",\n           need=\"persona.note\",\n           template={\"slots\": [{\"name\": \"personaId\", \"required\": True},\n                               {\"name\": \"note\", \"required\": True}]},\n           handler=h_note_for_persona)\n    R.tool(\"compare-run\", \"Run competing tools on the same input\",\n           need=\"comparison.run\",\n           template={\"slots\": [{\"name\": \"need\", \"required\": True},\n                               {\"name\": \"input\"}]},\n           handler=h_compare_run)\n    # -- system commands (object.verb) ----------------------------------------\n    C = ctx.tools.command\n    C(\"ledger.query\", lambda ctx, a: [\n        r.row() for r in ctx.ledger.query(**a)])\n    C(\"ledger.assert\", lambda ctx, a: ctx.ledger.say(\n        a[\"subject\"], a[\"predicate\"], a[\"value\"],\n        claimant=a.get(\"claimant\", \"principal\"),\n        certainty=a.get(\"certainty\", 0.9),\n        basis={\"kind\": a.get(\"basis\", \"user-choice\")}).row())\n    C(\"roster.select\", lambda ctx, a: ctx.personas.select(a[\"personaId\"]))\n    C(\"roster.move\", lambda ctx, a: ctx.personas.move(\n        a[\"personaId\"], a.get(\"direction\", 0)))\n    C(\"roster.list\", lambda ctx, a: [p[\"id\"] for p in ctx.personas.roster()])\n    C(\"need.focus\", lambda ctx, a: floor.focus_need(\n        ctx, a[\"needId\"], a.get(\"on\", True)))\n    C(\"need.cancel\", lambda ctx, a: floor.cancel_need(ctx, a[\"needId\"]))\n    C(\"grant.issue\", lambda ctx, a: {\"grantId\": floor.issue_grant(\n        ctx, a[\"scope\"], a.get(\"lock\"), a.get(\"consumable\", True))})\n    C(\"theme.set\", lambda ctx, a: h_set_theme(ctx, a, None))\n    C(\"preload.apply\", lambda ctx, a: h_apply_preload(ctx, a, None))\n    C(\"steward.wake\", lambda ctx, a: ctx.steward.tick(reason=\"command\"))\n    C(\"chat.topic\", lambda ctx, a: archive.set_topic(ctx, a[\"topic\"]))\n","_meta":{"cognition.ai/linesAdded":1006,"cognition.ai/linesRemoved":2250}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\compare.py","oldText":"\"\"\"Competing tools (prompt §Tools and local comparison).\r\r\n\r\r\nEvery tool expressing the same `need:` is invoked on the same input; results\r\r\nare normalized to a shared local understanding, ranked, and recorded\r\r\n(`comparison:run` + `comparison:row`). Adequate outcomes feed tool-trust\r\r\nchurn: a bounded rank multiplier among alternatives — an inadequate tool\r\r\nstays eligible but sinks; successes recover it.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nfrom . import model, floor\r\r\n\r\r\n\r\r\ndef trust(led, tool_id: str) -> float:\r\r\n    a = led.resolve(f\"tool:{tool_id}\", \"tool:trust\")\r\r\n    if a:\r\r\n        return float((a.value.get(\"v\") or {}).get(\"trust\", 1.0))\r\r\n    return 1.0\r\r\n\r\r\n\r\r\ndef adjust_trust(ctx, tool_id: str, adequate: bool):\r\r\n    cur = trust(ctx.ledger, tool_id)\r\r\n    new = min(1.0, cur + 0.05) if adequate else max(0.1, cur - 0.15)\r\r\n    if new == cur:\r\r\n        return\r\r\n    prev = ctx.ledger.resolve(f\"tool:{tool_id}\", \"tool:trust\")\r\r\n    ctx.ledger.say(f\"tool:{tool_id}\", \"tool:trust\",\r\r\n                   {\"trust\": round(new, 3), \"prior\": cur,\r\r\n                    \"why\": \"adequate\" if adequate else \"inadequate\"},\r\r\n                   claimant=\"system\", certainty=1.0,\r\r\n                   basis={\"kind\": \"execution\"},\r\r\n                   supersedes=prev.id if prev else None)\r\r\n\r\r\n\r\r\ndef compete(ctx, need_expr: str, input_slots: dict,\r\r\n            normalize=None) -> dict:\r\r\n    \"\"\"Run all tools expressing `need_expr` on the same input. Both adequate\r\r\n    results and failures are recorded — the losing side is evidence, not an\r\r\n    error.\"\"\"\r\r\n    led = ctx.ledger\r\r\n    contestants = ctx.tools.for_need(need_expr)\r\r\n    run_id = model.rid(\"cmp\")\r\r\n    rows = []\r\r\n    for t in contestants:\r\r\n        r = floor.open_need(ctx, t, dict(input_slots),\r\r\n                            summary=f\"compete:{need_expr}\", via=\"competition\")\r\r\n        res = r.get(\"result\") or {}\r\r\n        adequate = bool(r.get(\"ok\")) and bool(res.get(\"ok\", True))\r\r\n        norm = normalize(res) if (normalize and adequate) else res\r\r\n        rows.append({\r\r\n            \"toolId\": t[\"id\"], \"ok\": r.get(\"ok\"), \"adequate\": adequate,\r\r\n            \"trust\": trust(led, t[\"id\"]),\r\r\n            \"result\": _cap(norm)})\r\r\n        adjust_trust(ctx, t[\"id\"], adequate)\r\r\n    ranked = sorted(rows, key=lambda x: (x[\"adequate\"], x[\"trust\"]),\r\r\n                    reverse=True)\r\r\n    for i, row in enumerate(ranked):\r\r\n        led.say(f\"comparison:{run_id}\", \"comparison:row\",\r\r\n                {\"rank\": i, **row}, claimant=\"system\", certainty=1.0,\r\r\n                basis={\"kind\": \"execution\"})\r\r\n    led.say(\"comparison\", \"comparison:run\",\r\r\n            {\"id\": run_id, \"need\": need_expr, \"tools\": [t[\"id\"] for t in\r\r\n             contestants],\r\r\n             \"adequate\": sum(1 for r in rows if r[\"adequate\"]),\r\r\n             \"winner\": ranked[0][\"toolId\"] if ranked else None},\r\r\n            claimant=\"system\", certainty=1.0,\r\r\n            basis={\"kind\": \"durable-result\"})\r\r\n    return {\"ok\": True, \"runId\": run_id, \"need\": need_expr, \"rows\": ranked,\r\r\n            \"adequate\": sum(1 for r in rows if r[\"adequate\"])}\r\r\n\r\r\n\r\r\ndef _cap(v, n=300):\r\r\n    s = repr(v)\r\r\n    return s[:n] + \"…\" if len(s) > n else v\r\r\n","newText":"\"\"\"Competing tools (prompt §Tools and local comparison).\nEvery tool expressing the same `need:` is invoked on the same input; results\nare normalized to a shared local understanding, ranked, and recorded\n(`comparison:run` + `comparison:row`). Adequate outcomes feed tool-trust\nchurn: a bounded rank multiplier among alternatives — an inadequate tool\nstays eligible but sinks; successes recover it.\n\"\"\"\nfrom __future__ import annotations\nfrom . import model, floor\ndef trust(led, tool_id: str) -> float:\n    a = led.resolve(f\"tool:{tool_id}\", \"tool:trust\")\n    if a:\n        return float((a.value.get(\"v\") or {}).get(\"trust\", 1.0))\n    return 1.0\ndef adjust_trust(ctx, tool_id: str, adequate: bool):\n    cur = trust(ctx.ledger, tool_id)\n    new = min(1.0, cur + 0.05) if adequate else max(0.1, cur - 0.15)\n    if new == cur:\n        return\n    prev = ctx.ledger.resolve(f\"tool:{tool_id}\", \"tool:trust\")\n    ctx.ledger.say(f\"tool:{tool_id}\", \"tool:trust\",\n                   {\"trust\": round(new, 3), \"prior\": cur,\n                    \"why\": \"adequate\" if adequate else \"inadequate\"},\n                   claimant=\"system\", certainty=1.0,\n                   basis={\"kind\": \"execution\"},\n                   supersedes=prev.id if prev else None)\ndef compete(ctx, need_expr: str, input_slots: dict,\n            normalize=None) -> dict:\n    \"\"\"Run all tools expressing `need_expr` on the same input. Both adequate\n    results and failures are recorded — the losing side is evidence, not an\n    error.\"\"\"\n    led = ctx.ledger\n    contestants = ctx.tools.for_need(need_expr)\n    run_id = model.rid(\"cmp\")\n    rows = []\n    for t in contestants:\n        r = floor.open_need(ctx, t, dict(input_slots),\n                            summary=f\"compete:{need_expr}\", via=\"competition\")\n        res = r.get(\"result\") or {}\n        adequate = bool(r.get(\"ok\")) and bool(res.get(\"ok\", True))\n        norm = normalize(res) if (normalize and adequate) else res\n        rows.append({\n            \"toolId\": t[\"id\"], \"ok\": r.get(\"ok\"), \"adequate\": adequate,\n            \"trust\": trust(led, t[\"id\"]),\n            \"result\": _cap(norm)})\n        adjust_trust(ctx, t[\"id\"], adequate)\n    ranked = sorted(rows, key=lambda x: (x[\"adequate\"], x[\"trust\"]),\n                    reverse=True)\n    for i, row in enumerate(ranked):\n        led.say(f\"comparison:{run_id}\", \"comparison:row\",\n                {\"rank\": i, **row}, claimant=\"system\", certainty=1.0,\n                basis={\"kind\": \"execution\"})\n    led.say(\"comparison\", \"comparison:run\",\n            {\"id\": run_id, \"need\": need_expr, \"tools\": [t[\"id\"] for t in\n             contestants],\n             \"adequate\": sum(1 for r in rows if r[\"adequate\"]),\n             \"winner\": ranked[0][\"toolId\"] if ranked else None},\n            claimant=\"system\", certainty=1.0,\n            basis={\"kind\": \"durable-result\"})\n    return {\"ok\": True, \"runId\": run_id, \"need\": need_expr, \"rows\": ranked,\n            \"adequate\": sum(1 for r in rows if r[\"adequate\"])}\ndef _cap(v, n=300):\n    s = repr(v)\n    return s[:n] + \"…\" if len(s) > n else v\n","_meta":{"cognition.ai/linesAdded":64,"cognition.ai/linesRemoved":148}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\dsl.py","oldText":"\"\"\"Tool-logic-as-data interpreter (C-ConvergentOntology).\r\r\n\r\r\nUser-authored tools are step lists over a closed op set — no eval. Steps read\r\r\nand write an env ({slots, results, vars}); value references use \"$path\"\r\r\nagainst env and \"{path}\" interpolation inside strings.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport json\r\r\nimport re\r\r\n\r\r\n\r\r\nOPS = (\"set\", \"query\", \"assert\", \"each\", \"if\", \"invoke\", \"engine\",\r\r\n       \"emit\", \"result\", \"fail\", \"first\", \"concat\")\r\r\n\r\r\n\r\r\ndef _lookup(env, path):\r\r\n    cur = env\r\r\n    for part in str(path).split(\".\"):\r\r\n        if isinstance(cur, dict) and part in cur:\r\r\n            cur = cur[part]\r\r\n        elif isinstance(cur, (list, tuple)) and part.isdigit():\r\r\n            cur = cur[int(part)]\r\r\n        else:\r\r\n            return None\r\r\n    return cur\r\r\n\r\r\n\r\r\ndef resolve(v, env):\r\r\n    if isinstance(v, str):\r\r\n        if v.startswith(\"$\"):\r\r\n            return _lookup(env, v[1:])\r\r\n        def sub(m):\r\r\n            got = _lookup(env, m.group(1))\r\r\n            return \"\" if got is None else str(got)\r\r\n        return re.sub(r\"\\{([\\w.\\[\\]]+)\\}\", sub, v)\r\r\n    if isinstance(v, list):\r\r\n        return [resolve(x, env) for x in v]\r\r\n    if isinstance(v, dict):\r\r\n        return {k: resolve(x, env) for k, x in v.items()}\r\r\n    return v\r\r\n\r\r\n\r\r\ndef run_steps(ctx, steps, env=None) -> dict:\r\r\n    env = dict(env or {})\r\r\n    env.setdefault(\"vars\", {})\r\r\n    env.setdefault(\"results\", [])\r\r\n    for i, st in enumerate(steps or []):\r\r\n        op = st.get(\"op\")\r\r\n        if op not in OPS:\r\r\n            return {\"ok\": False, \"error\": f\"unknown op '{op}' at step {i}\"}\r\r\n        try:\r\r\n            out = _step(ctx, op, st, env, i)\r\r\n            if isinstance(out, dict) and out.get(\"__return\"):\r\r\n                return out[\"value\"]\r\r\n        except Exception as e:\r\r\n            return {\"ok\": False, \"error\": f\"step {i} ({op}): {e!r}\"}\r\r\n    return {\"ok\": True, \"results\": env.get(\"results\"),\r\r\n            \"vars\": env.get(\"vars\")}\r\r\n\r\r\n\r\r\ndef _step(ctx, op, st, env, i):\r\r\n    led = ctx.ledger\r\r\n    if op == \"set\":\r\r\n        env[\"vars\"][st[\"k\"]] = resolve(st.get(\"value\"), env)\r\r\n        env[\"results\"] = env[\"vars\"][st[\"k\"]]\r\r\n    elif op == \"query\":\r\r\n        rows = led.query(subject=resolve(st.get(\"subject\"), env),\r\r\n                         predicate=resolve(st.get(\"predicate\"), env),\r\r\n                         limit=int(st.get(\"limit\", 50)),\r\r\n                         current=bool(st.get(\"current\", True)))\r\r\n        env[\"results\"] = [r.row() for r in rows]\r\r\n    elif op == \"first\":\r\r\n        rows = env.get(\"results\") or []\r\r\n        env[\"vars\"][st.get(\"k\", \"first\")] = rows[0] if rows else None\r\r\n    elif op == \"assert\":\r\r\n        led.say(resolve(st.get(\"subject\"), env),\r\r\n                resolve(st.get(\"predicate\"), env),\r\r\n                resolve(st.get(\"value\"), env),\r\r\n                claimant=st.get(\"claimant\", \"tool:dsl\"),\r\r\n                certainty=float(st.get(\"certainty\", 0.9)),\r\r\n                basis={\"kind\": st.get(\"basis\", \"execution\")})\r\r\n    elif op == \"each\":\r\r\n        items = resolve(st.get(\"over\"), env) or []\r\r\n        acc = []\r\r\n        for it in items:\r\r\n            env[\"it\"] = it\r\r\n            r = run_steps(ctx, st.get(\"steps\", []), env)\r\r\n            acc.append(r)\r\r\n            if isinstance(r, dict) and r.get(\"ok\") is False:\r\r\n                env[\"results\"] = acc\r\r\n                return r\r\r\n        env[\"results\"] = acc\r\r\n    elif op == \"if\":\r\r\n        cond = resolve(st.get(\"cond\"), env)\r\r\n        branch = st.get(\"then\", []) if cond else st.get(\"else\", [])\r\r\n        r = run_steps(ctx, branch, env)\r\r\n        if isinstance(r, dict) and r.get(\"ok\") is False:\r\r\n            return r\r\r\n    elif op == \"invoke\":\r\r\n        tid = resolve(st.get(\"tool\"), env)\r\r\n        slots = resolve(st.get(\"slots\", {}), env)\r\r\n        r = ctx.invoke(tid, slots, via=\"tool\", summary=f\"dsl invoke {tid}\")\r\r\n        env[\"results\"] = r\r\r\n        if isinstance(r, dict) and r.get(\"ok\") is False and not r.get(\"deferred\"):\r\r\n            return r\r\r\n    elif op == \"engine\":\r\r\n        name = resolve(st.get(\"name\"), env)\r\r\n        call = resolve(st.get(\"call\"), env)\r\r\n        args = resolve(st.get(\"args\", {}), env)\r\r\n        env[\"results\"] = ctx.engine_call(name, call, args)\r\r\n    elif op == \"emit\":\r\r\n        ctx.bus.emit(resolve(st.get(\"kind\", \"card\"), env),\r\r\n                     resolve(st.get(\"payload\", {}), env))\r\r\n    elif op == \"concat\":\r\r\n        parts = resolve(st.get(\"parts\", []), env) or []\r\r\n        env[\"vars\"][st.get(\"k\", \"text\")] = str(st.get(\"sep\", \"\")).join(\r\r\n            str(p) for p in parts)\r\r\n    elif op == \"result\":\r\r\n        return {\"__return\": True, \"value\": resolve(st.get(\"value\"), env)}\r\r\n    elif op == \"fail\":\r\r\n        return {\"__return\": True,\r\r\n                \"value\": {\"ok\": False,\r\r\n                          \"error\": resolve(st.get(\"reason\", \"failed\"), env)}}\r\r\n    return None\r\r\n\r\r\n\r\r\ndef validate_spec(spec: dict) -> dict:\r\r\n    \"\"\"Novice tool authoring: errors, warnings, repair hints.\"\"\"\r\r\n    errors, warnings, hints = [], [], []\r\r\n    if not isinstance(spec, dict):\r\r\n        return {\"ok\": False, \"errors\": [\"spec must be a JSON object\"]}\r\r\n    tid = spec.get(\"id\")\r\r\n    if not tid or not re.match(r\"^[a-z0-9][a-z0-9\\-]*$\", str(tid)):\r\r\n        errors.append(\"id must be lowercase-kebab (a-z0-9-)\")\r\r\n        hints.append(\"try id like 'my-tool'\")\r\r\n    if not spec.get(\"title\"):\r\r\n        warnings.append(\"no title — the library shows the id instead\")\r\r\n    tpl = spec.get(\"template\") or {}\r\r\n    if not isinstance(tpl.get(\"slots\", []), list):\r\r\n        errors.append(\"template.slots must be a list\")\r\r\n    for s in tpl.get(\"slots\", []):\r\r\n        if \"name\" not in s:\r\r\n            errors.append(\"a slot is missing 'name'\")\r\r\n    steps = spec.get(\"steps\")\r\r\n    if not steps and not spec.get(\"need\"):\r\r\n        warnings.append(\"no steps and no need — the tool can only open needs\")\r\r\n    for j, st in enumerate(steps or []):\r\r\n        if st.get(\"op\") not in OPS:\r\r\n            errors.append(f\"step {j}: unknown op '{st.get('op')}'\")\r\r\n            hints.append(f\"valid ops: {', '.join(OPS)}\")\r\r\n    if spec.get(\"template\", {}).get(\"grant\") and not spec.get(\"consequential\", True):\r\r\n        warnings.append(\"grant-gated tools are consequential — kept the gate\")\r\r\n    return {\"ok\": not errors, \"errors\": errors, \"warnings\": warnings,\r\r\n            \"hints\": hints}\r\r\n","newText":"\"\"\"Tool-logic-as-data interpreter (C-ConvergentOntology).\nUser-authored tools are step lists over a closed op set — no eval. Steps read\nand write an env ({slots, results, vars}); value references use \"$path\"\nagainst env and \"{path}\" interpolation inside strings.\n\"\"\"\nfrom __future__ import annotations\nimport json\nimport re\nOPS = (\"set\", \"query\", \"assert\", \"each\", \"if\", \"invoke\", \"engine\",\n       \"emit\", \"result\", \"fail\", \"first\", \"concat\")\ndef _lookup(env, path):\n    cur = env\n    for part in str(path).split(\".\"):\n        if isinstance(cur, dict) and part in cur:\n            cur = cur[part]\n        elif isinstance(cur, (list, tuple)) and part.isdigit():\n            cur = cur[int(part)]\n        else:\n            return None\n    return cur\ndef resolve(v, env):\n    if isinstance(v, str):\n        if v.startswith(\"$\"):\n            return _lookup(env, v[1:])\n        def sub(m):\n            got = _lookup(env, m.group(1))\n            return \"\" if got is None else str(got)\n        return re.sub(r\"\\{([\\w.\\[\\]]+)\\}\", sub, v)\n    if isinstance(v, list):\n        return [resolve(x, env) for x in v]\n    if isinstance(v, dict):\n        return {k: resolve(x, env) for k, x in v.items()}\n    return v\ndef run_steps(ctx, steps, env=None) -> dict:\n    env = dict(env or {})\n    env.setdefault(\"vars\", {})\n    env.setdefault(\"results\", [])\n    for i, st in enumerate(steps or []):\n        op = st.get(\"op\")\n        if op not in OPS:\n            return {\"ok\": False, \"error\": f\"unknown op '{op}' at step {i}\"}\n        try:\n            out = _step(ctx, op, st, env, i)\n            if isinstance(out, dict) and out.get(\"__return\"):\n                return out[\"value\"]\n        except Exception as e:\n            return {\"ok\": False, \"error\": f\"step {i} ({op}): {e!r}\"}\n    return {\"ok\": True, \"results\": env.get(\"results\"),\n            \"vars\": env.get(\"vars\")}\ndef _step(ctx, op, st, env, i):\n    led = ctx.ledger\n    if op == \"set\":\n        env[\"vars\"][st[\"k\"]] = resolve(st.get(\"value\"), env)\n        env[\"results\"] = env[\"vars\"][st[\"k\"]]\n    elif op == \"query\":\n        rows = led.query(subject=resolve(st.get(\"subject\"), env),\n                         predicate=resolve(st.get(\"predicate\"), env),\n                         limit=int(st.get(\"limit\", 50)),\n                         current=bool(st.get(\"current\", True)))\n        env[\"results\"] = [r.row() for r in rows]\n    elif op == \"first\":\n        rows = env.get(\"results\") or []\n        env[\"vars\"][st.get(\"k\", \"first\")] = rows[0] if rows else None\n    elif op == \"assert\":\n        led.say(resolve(st.get(\"subject\"), env),\n                resolve(st.get(\"predicate\"), env),\n                resolve(st.get(\"value\"), env),\n                claimant=st.get(\"claimant\", \"tool:dsl\"),\n                certainty=float(st.get(\"certainty\", 0.9)),\n                basis={\"kind\": st.get(\"basis\", \"execution\")})\n    elif op == \"each\":\n        items = resolve(st.get(\"over\"), env) or []\n        acc = []\n        for it in items:\n            env[\"it\"] = it\n            r = run_steps(ctx, st.get(\"steps\", []), env)\n            acc.append(r)\n            if isinstance(r, dict) and r.get(\"ok\") is False:\n                env[\"results\"] = acc\n                return r\n        env[\"results\"] = acc\n    elif op == \"if\":\n        cond = resolve(st.get(\"cond\"), env)\n        branch = st.get(\"then\", []) if cond else st.get(\"else\", [])\n        r = run_steps(ctx, branch, env)\n        if isinstance(r, dict) and r.get(\"ok\") is False:\n            return r\n    elif op == \"invoke\":\n        tid = resolve(st.get(\"tool\"), env)\n        slots = resolve(st.get(\"slots\", {}), env)\n        r = ctx.invoke(tid, slots, via=\"tool\", summary=f\"dsl invoke {tid}\")\n        env[\"results\"] = r\n        if isinstance(r, dict) and r.get(\"ok\") is False and not r.get(\"deferred\"):\n            return r\n    elif op == \"engine\":\n        name = resolve(st.get(\"name\"), env)\n        call = resolve(st.get(\"call\"), env)\n        args = resolve(st.get(\"args\", {}), env)\n        env[\"results\"] = ctx.engine_call(name, call, args)\n    elif op == \"emit\":\n        ctx.bus.emit(resolve(st.get(\"kind\", \"card\"), env),\n                     resolve(st.get(\"payload\", {}), env))\n    elif op == \"concat\":\n        parts = resolve(st.get(\"parts\", []), env) or []\n        env[\"vars\"][st.get(\"k\", \"text\")] = str(st.get(\"sep\", \"\")).join(\n            str(p) for p in parts)\n    elif op == \"result\":\n        return {\"__return\": True, \"value\": resolve(st.get(\"value\"), env)}\n    elif op == \"fail\":\n        return {\"__return\": True,\n                \"value\": {\"ok\": False,\n                          \"error\": resolve(st.get(\"reason\", \"failed\"), env)}}\n    return None\ndef validate_spec(spec: dict) -> dict:\n    \"\"\"Novice tool authoring: errors, warnings, repair hints.\"\"\"\n    errors, warnings, hints = [], [], []\n    if not isinstance(spec, dict):\n        return {\"ok\": False, \"errors\": [\"spec must be a JSON object\"]}\n    tid = spec.get(\"id\")\n    if not tid or not re.match(r\"^[a-z0-9][a-z0-9\\-]*$\", str(tid)):\n        errors.append(\"id must be lowercase-kebab (a-z0-9-)\")\n        hints.append(\"try id like 'my-tool'\")\n    if not spec.get(\"title\"):\n        warnings.append(\"no title — the library shows the id instead\")\n    tpl = spec.get(\"template\") or {}\n    if not isinstance(tpl.get(\"slots\", []), list):\n        errors.append(\"template.slots must be a list\")\n    for s in tpl.get(\"slots\", []):\n        if \"name\" not in s:\n            errors.append(\"a slot is missing 'name'\")\n    steps = spec.get(\"steps\")\n    if not steps and not spec.get(\"need\"):\n        warnings.append(\"no steps and no need — the tool can only open needs\")\n    for j, st in enumerate(steps or []):\n        if st.get(\"op\") not in OPS:\n            errors.append(f\"step {j}: unknown op '{st.get('op')}'\")\n            hints.append(f\"valid ops: {', '.join(OPS)}\")\n    if spec.get(\"template\", {}).get(\"grant\") and not spec.get(\"consequential\", True):\n        warnings.append(\"grant-gated tools are consequential — kept the gate\")\n    return {\"ok\": not errors, \"errors\": errors, \"warnings\": warnings,\n            \"hints\": hints}\n","_meta":{"cognition.ai/linesAdded":141,"cognition.ai/linesRemoved":310}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\engines.py","oldText":"\"\"\"Engine seams — LLM, TTS, STT, portrait.\r\r\n\r\r\nHonesty contract (C-DeclaredStubs / C-HonestyBanner): every engine reports its\r\r\nreal mode at boot. A declared stub never pretends output it did not produce;\r\r\nan unreachable engine reports `error` — never `ok:true`-while-failing.\r\r\n\r\r\nLive on this host when available:\r\r\n- Ollama chat API (llama3.2) as the interactive LLM handle\r\r\n- Windows SAPI via System.Speech as the local TTS renderer (blocks until\r\r\n  playback completes — playbackMs is measured, not claimed)\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport json\r\r\nimport subprocess\r\r\nimport time\r\r\nimport urllib.request\r\r\n\r\r\n\r\r\nclass LLM:\r\r\n    \"\"\"Interactive LLM handle. mode: live-ollama:<model> | stub-declared.\"\"\"\r\r\n\r\r\n    def __init__(self, base=\"http://127.0.0.1:11434\", model=\"llama3.2\"):\r\r\n        self.base = base\r\r\n        self.model = model\r\r\n        self.mode = \"stub-declared\"\r\r\n        self.error = None\r\r\n        self.probe()\r\r\n\r\r\n    def probe(self) -> dict:\r\r\n        try:\r\r\n            with urllib.request.urlopen(self.base + \"/api/version\",\r\r\n                                        timeout=4) as r:\r\r\n                ver = json.loads(r.read().decode()).get(\"version\")\r\r\n            self.mode = f\"live-ollama:{self.model}\"\r\r\n            self.ollama_version = ver\r\r\n        except Exception as e:\r\r\n            self.mode = \"stub-declared\"\r\r\n            self.error = repr(e)\r\r\n            self.ollama_version = None\r\r\n        return {\"mode\": self.mode, \"model\": self.model,\r\r\n                \"error\": self.error}\r\r\n\r\r\n    def chat(self, system: str, prompt: str, max_tokens=400,\r\r\n             timeout=120) -> dict:\r\r\n        \"\"\"Returns {ok, text, engine, error}.\"\"\"\r\r\n        if self.mode == \"stub-declared\":\r\r\n            return {\"ok\": False, \"engine\": self.mode, \"text\": None,\r\r\n                    \"error\": f\"no interactive LLM ({self.error})\"}\r\r\n        body = json.dumps({\r\r\n            \"model\": self.model, \"stream\": False,\r\r\n            \"messages\": [{\"role\": \"system\", \"content\": system},\r\r\n                         {\"role\": \"user\", \"content\": prompt}],\r\r\n            \"options\": {\"num_predict\": max_tokens, \"temperature\": 0.7},\r\r\n        }).encode()\r\r\n        req = urllib.request.Request(self.base + \"/api/chat\", data=body,\r\r\n                                     headers={\"Content-Type\":\r\r\n                                              \"application/json\"})\r\r\n        try:\r\r\n            with urllib.request.urlopen(req, timeout=timeout) as r:\r\r\n                d = json.loads(r.read().decode())\r\r\n            return {\"ok\": True, \"engine\": self.mode,\r\r\n                    \"text\": (d.get(\"message\") or {}).get(\"content\", \"\"),\r\r\n                    \"evalCount\": d.get(\"eval_count\")}\r\r\n        except Exception as e:\r\r\n            return {\"ok\": False, \"engine\": self.mode, \"text\": None,\r\r\n                    \"error\": repr(e)}\r\r\n\r\r\n\r\r\nclass TTS:\r\r\n    \"\"\"Speech renderers — competing tools express `speech.render`.\r\r\n    render-speech-sapi is local and real; render-speech-remote is honestly\r\r\n    unconfigured (declared, never faked).\"\"\"\r\r\n\r\r\n    def __init__(self):\r\r\n        self.mode = \"unavailable\"\r\r\n        self.voices = []\r\r\n        self.probe()\r\r\n\r\r\n    def probe(self) -> dict:\r\r\n        try:\r\r\n            out = subprocess.run(\r\r\n                [\"powershell\", \"-NoProfile\", \"-Command\",\r\r\n                 \"Add-Type -AssemblyName System.Speech; \"\r\r\n                 \"(New-Object System.Speech.Synthesis.SpeechSynthesizer)\"\r\r\n                 \".GetInstalledVoices() | ForEach-Object { $_.VoiceInfo.Name }\"],\r\r\n                capture_output=True, text=True, timeout=20)\r\r\n            names = [l.strip() for l in out.stdout.splitlines() if l.strip()]\r\r\n            if names:\r\r\n                self.voices = names\r\r\n                self.mode = \"sapi\"\r\r\n            else:\r\r\n                self.mode = \"stub-declared\"\r\r\n        except Exception:\r\r\n            self.mode = \"stub-declared\"\r\r\n        return {\"mode\": self.mode, \"voices\": self.voices}\r\r\n\r\r\n    def render_local(self, text: str, voice=None, rate=0) -> dict:\r\r\n        \"\"\"Synchronous SAPI render — the call returns only when playback has\r\r\n        finished, so playbackMs is a measured duration.\"\"\"\r\r\n        if self.mode != \"sapi\":\r\r\n            return {\"ok\": False, \"engine\": \"render-speech-sapi\",\r\r\n                    \"error\": f\"renderer unavailable ({self.mode})\"}\r\r\n        name = voice or (self.voices[0] if self.voices else None)\r\r\n        safe = text.replace(\"'\", \"''\")[:900]\r\r\n        sel = f\"$s.SelectVoice('{name}'); \" if name else \"\"\r\r\n        ps = (\"Add-Type -AssemblyName System.Speech; \"\r\r\n              \"$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \"\r\r\n              f\"{sel}$s.Rate = {int(rate)}; $s.Speak('{safe}')\")\r\r\n        t0 = time.time()\r\r\n        try:\r\r\n            subprocess.run([\"powershell\", \"-NoProfile\", \"-Command\", ps],\r\r\n                           capture_output=True, timeout=120)\r\r\n            played = int((time.time() - t0) * 1000)\r\r\n            return {\"ok\": True, \"engine\": \"render-speech-sapi\",\r\r\n                    \"voice\": name, \"playbackMs\": played,\r\r\n                    \"heldUntilPlaybackComplete\": True}\r\r\n        except Exception as e:\r\r\n            return {\"ok\": False, \"engine\": \"render-speech-sapi\",\r\r\n                    \"error\": repr(e)}\r\r\n\r\r\n    def render_remote(self, text: str, voice=None) -> dict:\r\r\n        \"\"\"Remote voice service — not configured on this installation.\r\r\n        Declared, honest, never fabricated.\"\"\"\r\r\n        return {\"ok\": False, \"engine\": \"render-speech-remote\",\r\r\n                \"error\": \"remote speech service not configured \"\r\r\n                         \"(declared absence)\"}\r\r\n\r\r\n\r\r\nclass STT:\r\r\n    \"\"\"Spoken input. The browser Web Speech API is the only channel here;\r\r\n    when the browser lacks it the surface declares `none`.\"\"\"\r\r\n\r\r\n    def __init__(self):\r\r\n        self.mode = \"browser-webspeech-declared\"\r\r\n\r\r\n    def transcript(self, text: str) -> dict:\r\r\n        return {\"ok\": True, \"engine\": self.mode, \"text\": text}\r\r\n\r\r\n\r\r\nclass Engines:\r\r\n    def __init__(self):\r\r\n        self.llm = LLM()\r\r\n        self.tts = TTS()\r\r\n        self.stt = STT()\r\r\n        self.portrait = {\"mode\": \"procedural-svg-local\"}\r\r\n\r\r\n    def honesty(self) -> dict:\r\r\n        return {\r\r\n            \"llm\": {\"mode\": self.llm.mode, \"model\": self.llm.model,\r\r\n                    \"error\": self.llm.error},\r\r\n            \"tts\": {\"mode\": self.tts.mode, \"voices\": self.tts.voices},\r\r\n            \"stt\": {\"mode\": self.stt.mode},\r\r\n            \"portrait\": self.portrait,\r\r\n            \"declaredAbsences\": [\r\r\n                \"fleet install\", \"fleet discovery\", \"exchange media \"\r\r\n                \"(QR/AVQR encode+scan)\", \"oauth account connectors\",\r\r\n                \"remote speech service\", \"native desktop shell \"\r\r\n                \"(browser surface is the declared display)\"],\r\r\n        }\r\r\n","newText":"\"\"\"Engine seams — LLM, TTS, STT, portrait.\nHonesty contract (C-DeclaredStubs / C-HonestyBanner): every engine reports its\nreal mode at boot. A declared stub never pretends output it did not produce;\nan unreachable engine reports `error` — never `ok:true`-while-failing.\nLive on this host when available:\n- Ollama chat API (llama3.2) as the interactive LLM handle\n- Windows SAPI via System.Speech as the local TTS renderer (blocks until\n  playback completes — playbackMs is measured, not claimed)\n\"\"\"\nfrom __future__ import annotations\nimport json\nimport subprocess\nimport time\nimport urllib.request\nclass LLM:\n    \"\"\"Interactive LLM handle. mode: live-ollama:<model> | stub-declared.\"\"\"\n    def __init__(self, base=\"http://127.0.0.1:11434\", model=\"llama3.2\"):\n        self.base = base\n        self.model = model\n        self.mode = \"stub-declared\"\n        self.error = None\n        self.probe()\n    def probe(self) -> dict:\n        try:\n            with urllib.request.urlopen(self.base + \"/api/version\",\n                                        timeout=4) as r:\n                ver = json.loads(r.read().decode()).get(\"version\")\n            self.mode = f\"live-ollama:{self.model}\"\n            self.ollama_version = ver\n        except Exception as e:\n            self.mode = \"stub-declared\"\n            self.error = repr(e)\n            self.ollama_version = None\n        return {\"mode\": self.mode, \"model\": self.model,\n                \"error\": self.error}\n    def chat(self, system: str, prompt: str, max_tokens=400,\n             timeout=120) -> dict:\n        \"\"\"Returns {ok, text, engine, error}.\"\"\"\n        if self.mode == \"stub-declared\":\n            return {\"ok\": False, \"engine\": self.mode, \"text\": None,\n                    \"error\": f\"no interactive LLM ({self.error})\"}\n        body = json.dumps({\n            \"model\": self.model, \"stream\": False,\n            \"messages\": [{\"role\": \"system\", \"content\": system},\n                         {\"role\": \"user\", \"content\": prompt}],\n            \"options\": {\"num_predict\": max_tokens, \"temperature\": 0.7},\n        }).encode()\n        req = urllib.request.Request(self.base + \"/api/chat\", data=body,\n                                     headers={\"Content-Type\":\n                                              \"application/json\"})\n        try:\n            with urllib.request.urlopen(req, timeout=timeout) as r:\n                d = json.loads(r.read().decode())\n            return {\"ok\": True, \"engine\": self.mode,\n                    \"text\": (d.get(\"message\") or {}).get(\"content\", \"\"),\n                    \"evalCount\": d.get(\"eval_count\")}\n        except Exception as e:\n            return {\"ok\": False, \"engine\": self.mode, \"text\": None,\n                    \"error\": repr(e)}\nclass TTS:\n    \"\"\"Speech renderers — competing tools express `speech.render`.\n    render-speech-sapi is local and real; render-speech-remote is honestly\n    unconfigured (declared, never faked).\"\"\"\n    def __init__(self):\n        self.mode = \"unavailable\"\n        self.voices = []\n        self.probe()\n    def probe(self) -> dict:\n        try:\n            out = subprocess.run(\n                [\"powershell\", \"-NoProfile\", \"-Command\",\n                 \"Add-Type -AssemblyName System.Speech; \"\n                 \"(New-Object System.Speech.Synthesis.SpeechSynthesizer)\"\n                 \".GetInstalledVoices() | ForEach-Object { $_.VoiceInfo.Name }\"],\n                capture_output=True, text=True, timeout=20)\n            names = [l.strip() for l in out.stdout.splitlines() if l.strip()]\n            if names:\n                self.voices = names\n                self.mode = \"sapi\"\n            else:\n                self.mode = \"stub-declared\"\n        except Exception:\n            self.mode = \"stub-declared\"\n        return {\"mode\": self.mode, \"voices\": self.voices}\n    def render_local(self, text: str, voice=None, rate=0) -> dict:\n        \"\"\"Synchronous SAPI render — the call returns only when playback has\n        finished, so playbackMs is a measured duration.\"\"\"\n        if self.mode != \"sapi\":\n            return {\"ok\": False, \"engine\": \"render-speech-sapi\",\n                    \"error\": f\"renderer unavailable ({self.mode})\"}\n        name = voice or (self.voices[0] if self.voices else None)\n        safe = text.replace(\"'\", \"''\")[:900]\n        sel = f\"$s.SelectVoice('{name}'); \" if name else \"\"\n        ps = (\"Add-Type -AssemblyName System.Speech; \"\n              \"$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \"\n              f\"{sel}$s.Rate = {int(rate)}; $s.Speak('{safe}')\")\n        t0 = time.time()\n        try:\n            subprocess.run([\"powershell\", \"-NoProfile\", \"-Command\", ps],\n                           capture_output=True, timeout=120)\n            played = int((time.time() - t0) * 1000)\n            return {\"ok\": True, \"engine\": \"render-speech-sapi\",\n                    \"voice\": name, \"playbackMs\": played,\n                    \"heldUntilPlaybackComplete\": True}\n        except Exception as e:\n            return {\"ok\": False, \"engine\": \"render-speech-sapi\",\n                    \"error\": repr(e)}\n    def render_remote(self, text: str, voice=None) -> dict:\n        \"\"\"Remote voice service — not configured on this installation.\n        Declared, honest, never fabricated.\"\"\"\n        return {\"ok\": False, \"engine\": \"render-speech-remote\",\n                \"error\": \"remote speech service not configured \"\n                         \"(declared absence)\"}\nclass STT:\n    \"\"\"Spoken input. The browser Web Speech API is the only channel here;\n    when the browser lacks it the surface declares `none`.\"\"\"\n    def __init__(self):\n        self.mode = \"browser-webspeech-declared\"\n    def transcript(self, text: str) -> dict:\n        return {\"ok\": True, \"engine\": self.mode, \"text\": text}\nclass Engines:\n    def __init__(self):\n        self.llm = LLM()\n        self.tts = TTS()\n        self.stt = STT()\n        self.portrait = {\"mode\": \"procedural-svg-local\"}\n    def honesty(self) -> dict:\n        return {\n            \"llm\": {\"mode\": self.llm.mode, \"model\": self.llm.model,\n                    \"error\": self.llm.error},\n            \"tts\": {\"mode\": self.tts.mode, \"voices\": self.tts.voices},\n            \"stt\": {\"mode\": self.stt.mode},\n            \"portrait\": self.portrait,\n            \"declaredAbsences\": [\n                \"fleet install\", \"fleet discovery\", \"exchange media \"\n                \"(QR/AVQR encode+scan)\", \"oauth account connectors\",\n                \"remote speech service\", \"native desktop shell \"\n                \"(browser surface is the declared display)\"],\n        }\n","_meta":{"cognition.ai/linesAdded":139,"cognition.ai/linesRemoved":320}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\floor.py","oldText":"\"\"\"Unmet-need floor (C-UnmetNeedRecords) + witnessed grants.\r\r\n\r\r\nA detected opportunity is recorded as a `need:*` assertion before any work.\r\r\nCreation does not imply execution: the template's gate decides. Missing or\r\r\ninadequate required slots leave the need open; a consequential tool without a\r\r\nmatching witnessed grant defers with a recorded refusal — never silent\r\r\nnon-action and never a fabricated effect.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport re\r\r\nfrom typing import Optional\r\r\n\r\r\nfrom . import model\r\r\n\r\r\n\r\r\n# -- need status (computed from rows; the ledger is the record) ---------------\r\r\n\r\r\ndef need_rows(led, nid):\r\r\n    return led.query(subject=f\"need:{nid}\", limit=500)\r\r\n\r\r\n\r\r\ndef need_status(led, nid) -> str:\r\r\n    \"\"\"open | deferred | fulfilled | cancelled | superseded — latest wins.\"\"\"\r\r\n    status = \"open\"\r\r\n    for a in sorted(need_rows(led, nid), key=lambda r: r.at):\r\r\n        p = a.predicate\r\r\n        if p in (\"need:fulfilled\", \"need:cancelled\", \"need:superseded\"):\r\r\n            status = p.split(\":\")[1]\r\r\n        elif p == \"need:deferred\":\r\r\n            status = \"deferred\"\r\r\n        elif p in (\"need:candidate\", \"need:focus\", \"need:refined\",\r\r\n                   \"need:executing\", \"need:failed\"):\r\r\n            if status in (\"open\", \"deferred\"):\r\r\n                status = \"open\" if p != \"need:deferred\" else status\r\r\n    return status\r\r\n\r\r\n\r\r\ndef open_needs(led) -> list[dict]:\r\r\n    ids = [a.value.get(\"v\", {}).get(\"id\") or a.subject.split(\":\", 1)[1]\r\r\n           for a in led.query(predicate=\"need:open\")]\r\r\n    out = []\r\r\n    for nid in dict.fromkeys(ids):\r\r\n        rows = need_rows(led, nid)\r\r\n        if not rows:\r\r\n            continue\r\r\n        st = need_status(led, nid)\r\r\n        if st in (\"fulfilled\", \"cancelled\", \"superseded\"):\r\r\n            continue\r\r\n        first = next((r for r in rows if r.predicate == \"need:open\"), rows[0])\r\r\n        v = first.value.get(\"v\", {})\r\r\n        out.append({\"id\": nid, \"toolId\": v.get(\"toolId\"),\r\r\n                    \"kind\": v.get(\"kind\", \"tool\"),\r\r\n                    \"summary\": v.get(\"summary\", \"\"),\r\r\n                    \"missing\": v.get(\"missing\", []),\r\r\n                    \"status\": st,\r\r\n                    \"focused\": any(r.predicate == \"need:focus\" and\r\r\n                                   (r.value.get(\"v\") or {}).get(\"on\")\r\r\n                                   for r in rows),\r\r\n                    \"at\": first.at})\r\r\n    return sorted(out, key=lambda n: n[\"at\"], reverse=True)\r\r\n\r\r\n\r\r\n# -- slot acceptance tests (C-AcceptanceChecks) --------------------------------\r\r\n\r\r\ndef test_slot(test: Optional[dict], value) -> tuple[bool, str]:\r\r\n    if not test:\r\r\n        return True, \"no-test\"\r\r\n    k = test.get(\"kind\")\r\r\n    if k == \"enum\":\r\r\n        ok = value in test.get(\"options\", [])\r\r\n        return ok, \"enum\" if ok else f\"not-in-{test.get('options')}\"\r\r\n    if k == \"pattern\":\r\r\n        ok = bool(re.search(test.get(\"re\", \".*\"), str(value)))\r\r\n        return ok, \"pattern\" if ok else \"pattern-mismatch\"\r\r\n    if k == \"type\":\r\r\n        t = test.get(\"t\")\r\r\n        ok = {\"string\": str, \"number\": (int, float),\r\r\n              \"boolean\": bool, \"list\": list, \"map\": dict}.get(t, str)\r\r\n        good = isinstance(value, ok) and not isinstance(value, bool) \\\r\r\n            if t == \"number\" else isinstance(value, ok)\r\r\n        return good, \"type\" if good else f\"not-{t}\"\r\r\n    if k == \"minLen\":\r\r\n        ok = len(str(value)) >= int(test.get(\"n\", 1))\r\r\n        return ok, \"minLen\" if ok else \"too-short\"\r\r\n    if k == \"range\":\r\r\n        try:\r\r\n            v = float(value)\r\r\n            ok = test.get(\"lo\", -1e18) <= v <= test.get(\"hi\", 1e18)\r\r\n            return ok, \"range\" if ok else \"out-of-range\"\r\r\n        except (TypeError, ValueError):\r\r\n            return False, \"not-numeric\"\r\r\n    return True, f\"unknown-test:{k}\"\r\r\n\r\r\n\r\r\n# -- grants ---------------------------------------------------------------------\r\r\n\r\r\ndef issue_grant(ctx, scope: str, lock: Optional[dict] = None,\r\r\n                consumable: bool = True) -> str:\r\r\n    gid = model.rid(\"g\")\r\r\n    ctx.ledger.say(\"grants\", \"grant:issued\",\r\r\n                   {\"id\": gid, \"scope\": scope, \"consumable\": consumable,\r\r\n                    \"lock\": lock or {}, \"witness\": \"principal\"},\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"})\r\r\n    return gid\r\r\n\r\r\n\r\r\ndef _grant_rows(led):\r\r\n    return led.query(predicate=\"grant:issued\", limit=500)\r\r\n\r\r\n\r\r\ndef grant_available(led, scope: str) -> Optional[str]:\r\r\n    consumed = {a.value.get(\"v\", {}).get(\"id\")\r\r\n                for a in led.query(predicate=\"grant:consumed\", limit=500)}\r\r\n    for a in _grant_rows(led):\r\r\n        v = a.value.get(\"v\", {})\r\r\n        if v.get(\"scope\") == scope and v.get(\"id\") not in consumed:\r\r\n            return v.get(\"id\")\r\r\n    return None\r\r\n\r\r\n\r\r\ndef consume_grant(ctx, gid: str):\r\r\n    ctx.ledger.say(\"grants\", \"grant:consumed\", {\"id\": gid},\r\r\n                   claimant=\"system\", certainty=1.0,\r\r\n                   basis={\"kind\": \"execution\"})\r\r\n\r\r\n\r\r\n# -- the gate ---------------------------------------------------------------------\r\r\n\r\r\ndef open_need(ctx, tool: dict, slots: dict, summary: str, via: str,\r\r\n              claimant: str = \"principal\") -> dict:\r\r\n    \"\"\"Record the unmet requirement, evaluate the template gate, and either\r\r\n    execute or leave the need open. Returns a result dict.\"\"\"\r\r\n    led = ctx.ledger\r\r\n    nid = model.rid(\"n\")\r\r\n    tpl = tool.get(\"template\") or {}\r\r\n    req = [s for s in tpl.get(\"slots\", []) if s.get(\"required\")]\r\r\n    missing, failed = [], []\r\r\n\r\r\n    for s in tpl.get(\"slots\", []):\r\r\n        name = s[\"name\"]\r\r\n        if name in slots:\r\r\n            ok, why = test_slot(s.get(\"test\"), slots[name])\r\r\n            led.say(f\"need:{nid}\", \"need:candidate\",\r\r\n                    {\"slot\": name, \"value\": slots[name], \"test\": why,\r\r\n                     \"adequate\": ok},\r\r\n                    claimant=claimant, certainty=0.9 if ok else 0.4,\r\r\n                    basis={\"kind\": \"user-choice\" if via != \"steward\"\r\r\n                           else \"generated\"})\r\r\n            if not ok:\r\r\n                failed.append({\"slot\": name, \"why\": why})\r\r\n        elif s.get(\"required\"):\r\r\n            missing.append(name)\r\r\n\r\r\n    led.say(f\"need:{nid}\", \"need:open\",\r\r\n            {\"id\": nid, \"toolId\": tool[\"id\"], \"kind\": tool.get(\"kind\", \"tool\"),\r\r\n             \"summary\": summary, \"via\": via, \"missing\": missing,\r\r\n             \"failed\": failed}, claimant=\"system\", certainty=1.0,\r\r\n            basis={\"kind\": \"interpretation\"})\r\r\n\r\r\n    # authority boundary: consequential tools need a witnessed grant\r\r\n    scope = tpl.get(\"grant\")\r\r\n    gid = None\r\r\n    if scope:\r\r\n        gid = grant_available(led, scope)\r\r\n        if not gid:\r\r\n            led.say(f\"need:{nid}\", \"need:deferred\",\r\r\n                    {\"reason\": \"awaiting-authority\", \"scope\": scope,\r\r\n                     \"status\": \"refused-pending-grant\"},\r\r\n                    claimant=\"system\", certainty=1.0,\r\r\n                    basis={\"kind\": \"refusal\"})\r\r\n            return {\"ok\": False, \"needId\": nid, \"status\": \"deferred\",\r\r\n                    \"reason\": f\"requires witnessed grant '{scope}'\",\r\r\n                    \"deferred\": True}\r\r\n\r\r\n    if missing or failed:\r\r\n        led.say(f\"need:{nid}\", \"need:deferred\",\r\r\n                {\"reason\": \"inadequate-slots\", \"missing\": missing,\r\r\n                 \"failed\": failed},\r\r\n                claimant=\"system\", certainty=1.0,\r\r\n                basis={\"kind\": \"interpretation\"})\r\r\n        return {\"ok\": False, \"needId\": nid, \"status\": \"open\",\r\r\n                \"missing\": missing, \"failed\": failed, \"deferred\": True}\r\r\n\r\r\n    if gid:\r\r\n        consume_grant(ctx, gid)\r\r\n    return execute_need(ctx, tool, nid, slots, summary, via)\r\r\n\r\r\n\r\r\ndef execute_need(ctx, tool: dict, nid: str, slots: dict, summary: str,\r\r\n                 via: str) -> dict:\r\r\n    led = ctx.ledger\r\r\n    led.say(f\"need:{nid}\", \"need:executing\", {\"via\": via},\r\r\n            claimant=\"system\", certainty=1.0, basis={\"kind\": \"execution\"})\r\r\n    try:\r\r\n        if tool.get(\"handler\"):\r\r\n            result = tool[\"handler\"](ctx, slots, nid)\r\r\n        else:\r\r\n            from . import dsl\r\r\n            result = dsl.run_steps(ctx, tool.get(\"steps\", []),\r\r\n                                   {\"slots\": slots, \"needId\": nid})\r\r\n        ok = not (isinstance(result, dict) and result.get(\"ok\") is False)\r\r\n    except Exception as e:  # execution can finish without satisfying\r\r\n        result = {\"ok\": False, \"error\": repr(e)}\r\r\n        ok = False\r\r\n    led.say(f\"need:{nid}\", \"need:executed\",\r\r\n            {\"ok\": ok, \"result\": _truncate(result)},\r\r\n            claimant=\"tool:\" + tool[\"id\"], certainty=1.0,\r\r\n            basis={\"kind\": \"execution\"})\r\r\n    if ok:\r\r\n        led.say(f\"need:{nid}\", \"need:fulfilled\", {\"result\": _truncate(result)},\r\r\n                claimant=\"system\", certainty=1.0,\r\r\n                basis={\"kind\": \"durable-result\"})\r\r\n    else:\r\r\n        led.say(f\"need:{nid}\", \"need:failed\", {\"result\": _truncate(result)},\r\r\n                claimant=\"system\", certainty=1.0,\r\r\n                basis={\"kind\": \"execution\"})\r\r\n        # a failed result leaves the need available for later work\r\r\n    return {\"ok\": ok, \"needId\": nid, \"result\": result}\r\r\n\r\r\n\r\r\ndef retry_need(ctx, nid: str) -> dict:\r\r\n    \"\"\"Re-evaluate an open need's gate against its accumulated candidates.\"\"\"\r\r\n    led = ctx.ledger\r\r\n    rows = need_rows(led, nid)\r\r\n    opener = next((r for r in rows if r.predicate == \"need:open\"), None)\r\r\n    if not opener:\r\r\n        return {\"ok\": False, \"error\": \"no such need\"}\r\r\n    spec = opener.value.get(\"v\", {})\r\r\n    tool = ctx.tools.get(spec.get(\"toolId\"))\r\r\n    if not tool:\r\r\n        return {\"ok\": False, \"error\": \"tool missing\"}\r\r\n    tpl = tool.get(\"template\") or {}\r\r\n    slots = {}\r\r\n    missing, failed = [], []\r\r\n    for s in tpl.get(\"slots\", []):\r\r\n        cands = led.candidates(f\"need:{nid}\", \"need:candidate\")\r\r\n        mine = [c for c in cands\r\r\n                if (c[\"value\"] or {}).get(\"slot\") == s[\"name\"]\r\r\n                and (c[\"value\"] or {}).get(\"adequate\", True)]\r\r\n        if mine:\r\r\n            slots[s[\"name\"]] = mine[0][\"value\"].get(\"value\")\r\r\n        elif s.get(\"required\"):\r\r\n            missing.append(s[\"name\"])\r\r\n    scope = tpl.get(\"grant\")\r\r\n    if scope and not grant_available(led, scope):\r\r\n        return {\"ok\": False, \"needId\": nid, \"deferred\": True,\r\r\n                \"reason\": f\"requires witnessed grant '{scope}'\"}\r\r\n    if missing:\r\r\n        return {\"ok\": False, \"needId\": nid, \"missing\": missing,\r\r\n                \"failed\": failed, \"deferred\": True}\r\r\n    if scope:\r\r\n        consume_grant(ctx, grant_available(led, scope))\r\r\n    return execute_need(ctx, tool, nid, slots, spec.get(\"summary\", \"\"), \"retry\")\r\r\n\r\r\n\r\r\ndef supply_candidate(ctx, nid: str, slot: str, value, source: str,\r\r\n                     confidence: float = 0.9) -> dict:\r\r\n    \"\"\"Refinement: successive inputs add related assertions — the requirement\r\r\n    is never reset, its criteria are preserved.\"\"\"\r\r\n    led = ctx.ledger\r\r\n    tool = _tool_of(led, nid)\r\r\n    spec = _slot_spec(tool, slot)\r\r\n    ok, why = test_slot((spec or {}).get(\"test\"), value)\r\r\n    a = led.say(f\"need:{nid}\", \"need:candidate\",\r\r\n                {\"slot\": slot, \"value\": value, \"test\": why, \"adequate\": ok,\r\r\n                 \"via\": source},\r\r\n                claimant=\"principal\" if source == \"user\" else f\"model:{source}\",\r\r\n                certainty=confidence,\r\r\n                basis={\"kind\": \"user-choice\" if source == \"user\"\r\r\n                       else \"interpretation\"})\r\r\n    led.say(f\"need:{nid}\", \"need:refined\", {\"slot\": slot, \"by\": source},\r\r\n            claimant=\"system\", certainty=1.0,\r\r\n            basis={\"kind\": \"interpretation\"}, links=[a.id])\r\r\n    return {\"ok\": ok, \"test\": why, \"id\": a.id}\r\r\n\r\r\n\r\r\ndef focus_need(ctx, nid: str, on: bool = True) -> dict:\r\r\n    ctx.ledger.say(f\"need:{nid}\", \"need:focus\", {\"on\": on},\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"})\r\r\n    if on:\r\r\n        ctx.ledger.say(\"chat\", \"chat:focus\", {\"needId\": nid},\r\r\n                       claimant=\"system\", certainty=1.0,\r\r\n                       basis={\"kind\": \"config\"})\r\r\n    return {\"ok\": True, \"needId\": nid, \"focused\": on}\r\r\n\r\r\n\r\r\ndef focused_need(led) -> Optional[str]:\r\r\n    a = led.resolve(\"chat\", \"chat:focus\")\r\r\n    if a:\r\r\n        v = a.value.get(\"v\") or {}\r\r\n        nid = v.get(\"needId\")\r\r\n        if nid and need_status(led, nid) not in (\"fulfilled\", \"cancelled\"):\r\r\n            return nid\r\r\n    return None\r\r\n\r\r\n\r\r\ndef cancel_need(ctx, nid: str):\r\r\n    ctx.ledger.say(f\"need:{nid}\", \"need:cancelled\", {},\r\r\n                   claimant=\"principal\", certainty=1.0,\r\r\n                   basis={\"kind\": \"user-choice\"})\r\r\n    return {\"ok\": True}\r\r\n\r\r\n\r\r\ndef _tool_of(led, nid):\r\r\n    rows = need_rows(led, nid)\r\r\n    opener = next((r for r in rows if r.predicate == \"need:open\"), None)\r\r\n    return None  # resolved by caller through ctx\r\r\n\r\r\n\r\r\ndef _slot_spec(tool, name):\r\r\n    if not tool:\r\r\n        return None\r\r\n    for s in (tool.get(\"template\") or {}).get(\"slots\", []):\r\r\n        if s[\"name\"] == name:\r\r\n            return s\r\r\n    return None\r\r\n\r\r\n\r\r\ndef _truncate(result, limit=4000):\r\r\n    s = repr(result)\r\r\n    if len(s) > limit:\r\r\n        return {\"truncated\": s[:limit]}\r\r\n    return result\r\r\n","newText":"\"\"\"Unmet-need floor (C-UnmetNeedRecords) + witnessed grants.\nA detected opportunity is recorded as a `need:*` assertion before any work.\nCreation does not imply execution: the template's gate decides. Missing or\ninadequate required slots leave the need open; a consequential tool without a\nmatching witnessed grant defers with a recorded refusal — never silent\nnon-action and never a fabricated effect.\n\"\"\"\nfrom __future__ import annotations\nimport re\nfrom typing import Optional\nfrom . import model\n# -- need status (computed from rows; the ledger is the record) ---------------\ndef need_rows(led, nid):\n    return led.query(subject=f\"need:{nid}\", limit=500)\ndef need_status(led, nid) -> str:\n    \"\"\"open | deferred | fulfilled | cancelled | superseded — latest wins.\"\"\"\n    status = \"open\"\n    for a in sorted(need_rows(led, nid), key=lambda r: r.at):\n        p = a.predicate\n        if p in (\"need:fulfilled\", \"need:cancelled\", \"need:superseded\"):\n            status = p.split(\":\")[1]\n        elif p == \"need:deferred\":\n            status = \"deferred\"\n        elif p in (\"need:candidate\", \"need:focus\", \"need:refined\",\n                   \"need:executing\", \"need:failed\"):\n            if status in (\"open\", \"deferred\"):\n                status = \"open\" if p != \"need:deferred\" else status\n    return status\ndef open_needs(led) -> list[dict]:\n    ids = [a.value.get(\"v\", {}).get(\"id\") or a.subject.split(\":\", 1)[1]\n           for a in led.query(predicate=\"need:open\")]\n    out = []\n    for nid in dict.fromkeys(ids):\n        rows = need_rows(led, nid)\n        if not rows:\n            continue\n        st = need_status(led, nid)\n        if st in (\"fulfilled\", \"cancelled\", \"superseded\"):\n            continue\n        first = next((r for r in rows if r.predicate == \"need:open\"), rows[0])\n        v = first.value.get(\"v\", {})\n        out.append({\"id\": nid, \"toolId\": v.get(\"toolId\"),\n                    \"kind\": v.get(\"kind\", \"tool\"),\n                    \"summary\": v.get(\"summary\", \"\"),\n                    \"missing\": v.get(\"missing\", []),\n                    \"status\": st,\n                    \"focused\": any(r.predicate == \"need:focus\" and\n                                   (r.value.get(\"v\") or {}).get(\"on\")\n                                   for r in rows),\n                    \"at\": first.at})\n    return sorted(out, key=lambda n: n[\"at\"], reverse=True)\n# -- slot acceptance tests (C-AcceptanceChecks) --------------------------------\ndef test_slot(test: Optional[dict], value) -> tuple[bool, str]:\n    if not test:\n        return True, \"no-test\"\n    k = test.get(\"kind\")\n    if k == \"enum\":\n        ok = value in test.get(\"options\", [])\n        return ok, \"enum\" if ok else f\"not-in-{test.get('options')}\"\n    if k == \"pattern\":\n        ok = bool(re.search(test.get(\"re\", \".*\"), str(value)))\n        return ok, \"pattern\" if ok else \"pattern-mismatch\"\n    if k == \"type\":\n        t = test.get(\"t\")\n        ok = {\"string\": str, \"number\": (int, float),\n              \"boolean\": bool, \"list\": list, \"map\": dict}.get(t, str)\n        good = isinstance(value, ok) and not isinstance(value, bool) \\\n            if t == \"number\" else isinstance(value, ok)\n        return good, \"type\" if good else f\"not-{t}\"\n    if k == \"minLen\":\n        ok = len(str(value)) >= int(test.get(\"n\", 1))\n        return ok, \"minLen\" if ok else \"too-short\"\n    if k == \"range\":\n        try:\n            v = float(value)\n            ok = test.get(\"lo\", -1e18) <= v <= test.get(\"hi\", 1e18)\n            return ok, \"range\" if ok else \"out-of-range\"\n        except (TypeError, ValueError):\n            return False, \"not-numeric\"\n    return True, f\"unknown-test:{k}\"\n# -- grants ---------------------------------------------------------------------\ndef issue_grant(ctx, scope: str, lock: Optional[dict] = None,\n                consumable: bool = True) -> str:\n    gid = model.rid(\"g\")\n    ctx.ledger.say(\"grants\", \"grant:issued\",\n                   {\"id\": gid, \"scope\": scope, \"consumable\": consumable,\n                    \"lock\": lock or {}, \"witness\": \"principal\"},\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"})\n    return gid\ndef _grant_rows(led):\n    return led.query(predicate=\"grant:issued\", limit=500)\ndef grant_available(led, scope: str) -> Optional[str]:\n    consumed = {a.value.get(\"v\", {}).get(\"id\")\n                for a in led.query(predicate=\"grant:consumed\", limit=500)}\n    for a in _grant_rows(led):\n        v = a.value.get(\"v\", {})\n        if v.get(\"scope\") == scope and v.get(\"id\") not in consumed:\n            return v.get(\"id\")\n    return None\ndef consume_grant(ctx, gid: str):\n    ctx.ledger.say(\"grants\", \"grant:consumed\", {\"id\": gid},\n                   claimant=\"system\", certainty=1.0,\n                   basis={\"kind\": \"execution\"})\n# -- the gate ---------------------------------------------------------------------\ndef open_need(ctx, tool: dict, slots: dict, summary: str, via: str,\n              claimant: str = \"principal\") -> dict:\n    \"\"\"Record the unmet requirement, evaluate the template gate, and either\n    execute or leave the need open. Returns a result dict.\"\"\"\n    led = ctx.ledger\n    nid = model.rid(\"n\")\n    tpl = tool.get(\"template\") or {}\n    req = [s for s in tpl.get(\"slots\", []) if s.get(\"required\")]\n    missing, failed = [], []\n    for s in tpl.get(\"slots\", []):\n        name = s[\"name\"]\n        if name in slots:\n            ok, why = test_slot(s.get(\"test\"), slots[name])\n            led.say(f\"need:{nid}\", \"need:candidate\",\n                    {\"slot\": name, \"value\": slots[name], \"test\": why,\n                     \"adequate\": ok},\n                    claimant=claimant, certainty=0.9 if ok else 0.4,\n                    basis={\"kind\": \"user-choice\" if via != \"steward\"\n                           else \"generated\"})\n            if not ok:\n                failed.append({\"slot\": name, \"why\": why})\n        elif s.get(\"required\"):\n            missing.append(name)\n    led.say(f\"need:{nid}\", \"need:open\",\n            {\"id\": nid, \"toolId\": tool[\"id\"], \"kind\": tool.get(\"kind\", \"tool\"),\n             \"summary\": summary, \"via\": via, \"missing\": missing,\n             \"failed\": failed}, claimant=\"system\", certainty=1.0,\n            basis={\"kind\": \"interpretation\"})\n    # authority boundary: consequential tools need a witnessed grant\n    scope = tpl.get(\"grant\")\n    gid = None\n    if scope:\n        gid = grant_available(led, scope)\n        if not gid:\n            led.say(f\"need:{nid}\", \"need:deferred\",\n                    {\"reason\": \"awaiting-authority\", \"scope\": scope,\n                     \"status\": \"refused-pending-grant\"},\n                    claimant=\"system\", certainty=1.0,\n                    basis={\"kind\": \"refusal\"})\n            return {\"ok\": False, \"needId\": nid, \"status\": \"deferred\",\n                    \"reason\": f\"requires witnessed grant '{scope}'\",\n                    \"deferred\": True}\n    if missing or failed:\n        led.say(f\"need:{nid}\", \"need:deferred\",\n                {\"reason\": \"inadequate-slots\", \"missing\": missing,\n                 \"failed\": failed},\n                claimant=\"system\", certainty=1.0,\n                basis={\"kind\": \"interpretation\"})\n        return {\"ok\": False, \"needId\": nid, \"status\": \"open\",\n                \"missing\": missing, \"failed\": failed, \"deferred\": True}\n    if gid:\n        consume_grant(ctx, gid)\n    return execute_need(ctx, tool, nid, slots, summary, via)\ndef execute_need(ctx, tool: dict, nid: str, slots: dict, summary: str,\n                 via: str) -> dict:\n    led = ctx.ledger\n    led.say(f\"need:{nid}\", \"need:executing\", {\"via\": via},\n            claimant=\"system\", certainty=1.0, basis={\"kind\": \"execution\"})\n    try:\n        if tool.get(\"handler\"):\n            result = tool[\"handler\"](ctx, slots, nid)\n        else:\n            from . import dsl\n            result = dsl.run_steps(ctx, tool.get(\"steps\", []),\n                                   {\"slots\": slots, \"needId\": nid})\n        ok = not (isinstance(result, dict) and result.get(\"ok\") is False)\n    except Exception as e:  # execution can finish without satisfying\n        result = {\"ok\": False, \"error\": repr(e)}\n        ok = False\n    led.say(f\"need:{nid}\", \"need:executed\",\n            {\"ok\": ok, \"result\": _truncate(result)},\n            claimant=\"tool:\" + tool[\"id\"], certainty=1.0,\n            basis={\"kind\": \"execution\"})\n    if ok:\n        led.say(f\"need:{nid}\", \"need:fulfilled\", {\"result\": _truncate(result)},\n                claimant=\"system\", certainty=1.0,\n                basis={\"kind\": \"durable-result\"})\n    else:\n        led.say(f\"need:{nid}\", \"need:failed\", {\"result\": _truncate(result)},\n                claimant=\"system\", certainty=1.0,\n                basis={\"kind\": \"execution\"})\n        # a failed result leaves the need available for later work\n    return {\"ok\": ok, \"needId\": nid, \"result\": result}\ndef retry_need(ctx, nid: str) -> dict:\n    \"\"\"Re-evaluate an open need's gate against its accumulated candidates.\"\"\"\n    led = ctx.ledger\n    rows = need_rows(led, nid)\n    opener = next((r for r in rows if r.predicate == \"need:open\"), None)\n    if not opener:\n        return {\"ok\": False, \"error\": \"no such need\"}\n    spec = opener.value.get(\"v\", {})\n    tool = ctx.tools.get(spec.get(\"toolId\"))\n    if not tool:\n        return {\"ok\": False, \"error\": \"tool missing\"}\n    tpl = tool.get(\"template\") or {}\n    slots = {}\n    missing, failed = [], []\n    for s in tpl.get(\"slots\", []):\n        cands = led.candidates(f\"need:{nid}\", \"need:candidate\")\n        mine = [c for c in cands\n                if (c[\"value\"] or {}).get(\"slot\") == s[\"name\"]\n                and (c[\"value\"] or {}).get(\"adequate\", True)]\n        if mine:\n            slots[s[\"name\"]] = mine[0][\"value\"].get(\"value\")\n        elif s.get(\"required\"):\n            missing.append(s[\"name\"])\n    scope = tpl.get(\"grant\")\n    if scope and not grant_available(led, scope):\n        return {\"ok\": False, \"needId\": nid, \"deferred\": True,\n                \"reason\": f\"requires witnessed grant '{scope}'\"}\n    if missing:\n        return {\"ok\": False, \"needId\": nid, \"missing\": missing,\n                \"failed\": failed, \"deferred\": True}\n    if scope:\n        consume_grant(ctx, grant_available(led, scope))\n    return execute_need(ctx, tool, nid, slots, spec.get(\"summary\", \"\"), \"retry\")\ndef supply_candidate(ctx, nid: str, slot: str, value, source: str,\n                     confidence: float = 0.9) -> dict:\n    \"\"\"Refinement: successive inputs add related assertions — the requirement\n    is never reset, its criteria are preserved.\"\"\"\n    led = ctx.ledger\n    tool = _tool_of(led, nid)\n    spec = _slot_spec(tool, slot)\n    ok, why = test_slot((spec or {}).get(\"test\"), value)\n    a = led.say(f\"need:{nid}\", \"need:candidate\",\n                {\"slot\": slot, \"value\": value, \"test\": why, \"adequate\": ok,\n                 \"via\": source},\n                claimant=\"principal\" if source == \"user\" else f\"model:{source}\",\n                certainty=confidence,\n                basis={\"kind\": \"user-choice\" if source == \"user\"\n                       else \"interpretation\"})\n    led.say(f\"need:{nid}\", \"need:refined\", {\"slot\": slot, \"by\": source},\n            claimant=\"system\", certainty=1.0,\n            basis={\"kind\": \"interpretation\"}, links=[a.id])\n    return {\"ok\": ok, \"test\": why, \"id\": a.id}\ndef focus_need(ctx, nid: str, on: bool = True) -> dict:\n    ctx.ledger.say(f\"need:{nid}\", \"need:focus\", {\"on\": on},\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"})\n    if on:\n        ctx.ledger.say(\"chat\", \"chat:focus\", {\"needId\": nid},\n                       claimant=\"system\", certainty=1.0,\n                       basis={\"kind\": \"config\"})\n    return {\"ok\": True, \"needId\": nid, \"focused\": on}\ndef focused_need(led) -> Optional[str]:\n    a = led.resolve(\"chat\", \"chat:focus\")\n    if a:\n        v = a.value.get(\"v\") or {}\n        nid = v.get(\"needId\")\n        if nid and need_status(led, nid) not in (\"fulfilled\", \"cancelled\"):\n            return nid\n    return None\ndef cancel_need(ctx, nid: str):\n    ctx.ledger.say(f\"need:{nid}\", \"need:cancelled\", {},\n                   claimant=\"principal\", certainty=1.0,\n                   basis={\"kind\": \"user-choice\"})\n    return {\"ok\": True}\ndef _tool_of(led, nid):\n    rows = need_rows(led, nid)\n    opener = next((r for r in rows if r.predicate == \"need:open\"), None)\n    return None  # resolved by caller through ctx\ndef _slot_spec(tool, name):\n    if not tool:\n        return None\n    for s in (tool.get(\"template\") or {}).get(\"slots\", []):\n        if s[\"name\"] == name:\n            return s\n    return None\ndef _truncate(result, limit=4000):\n    s = repr(result)\n    if len(s) > limit:\n        return {\"truncated\": s[:limit]}\n    return result\n","_meta":{"cognition.ai/linesAdded":278,"cognition.ai/linesRemoved":652}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\gate.py","oldText":"\"\"\"Interactive Readiness Gate (C-ReadinessGate).\r\r\n\r\r\nUser interaction unlocks at a declared gate testing two conditions:\r\r\n- input readiness: component registry populated, the chat pipeline accepts\r\r\n  and routes a probe input, the primary interactive LLM handle responds\r\r\n  (live) or is declared-stub (recorded as such — the gate passes on a\r\r\n  declared engine, and the surface says so)\r\r\n- ledger readiness: durable journal mounted and queryable, essential launch\r\r\n  partition mounted (C-LaunchPartition)\r\r\n\r\r\nThe pass time is accessible evidence — written to runtime/gate.json, a\r\r\n`gate:passed` assertion, the launch log, and last-launch.json. Time-to-gate\r\r\nis a standing scored criterion.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport json\r\r\nimport os\r\r\nimport time\r\r\n\r\r\n\r\r\nclass Gate:\r\r\n    def __init__(self, ctx):\r\r\n        self.ctx = ctx\r\r\n        self.passed = False\r\r\n        self.checks = {}\r\r\n        self.passed_at = None\r\r\n        self.time_to_gate_ms = None\r\r\n\r\r\n    def run(self, t0: float) -> dict:\r\r\n        ctx = self.ctx\r\r\n        checks = {}\r\r\n\r\r\n        # -- input readiness ---------------------------------------------------\r\r\n        manifest = ctx.tools.manifest()\r\r\n        checks[\"components\"] = {\r\r\n            \"ok\": manifest[\"components\"] >= 20, \"count\": manifest}\r\r\n        probe = ctx.route_input(\"__gate_probe__ ok\")\r\r\n        checks[\"input-pipeline\"] = {\"ok\": probe.get(\"routed\", False),\r\r\n                                    \"intents\": probe.get(\"intents\")}\r\r\n        eng = ctx.engines.llm.mode\r\r\n        checks[\"llm-handle\"] = {\r\r\n            \"ok\": True, \"mode\": eng,\r\r\n            \"note\": \"live handle accepts input\" if eng.startswith(\"live\")\r\r\n                    else \"declared stub — engine absence is declared, not faked\"}\r\r\n\r\r\n        # -- ledger readiness ----------------------------------------------------\r\r\n        rows = len(ctx.ledger.rows)\r\r\n        part = ctx.partition_count\r\r\n        can_query = bool(ctx.ledger.query(predicate=\"seed:loaded\") or True)\r\r\n        checks[\"ledger-durable\"] = {\"ok\": rows > 0, \"rows\": rows}\r\r\n        checks[\"launch-partition\"] = {\"ok\": part > 0, \"mounted\": part}\r\r\n        checks[\"ledger-queryable\"] = {\"ok\": can_query}\r\r\n\r\r\n        self.checks = checks\r\r\n        self.passed = all(c.get(\"ok\") for c in checks.values())\r\r\n        self.passed_at = time.time()\r\r\n        self.time_to_gate_ms = int((self.passed_at - t0) * 1000)\r\r\n\r\r\n        record = {\"passed\": self.passed, \"checks\": checks,\r\r\n                  \"passedAt\": self.passed_at,\r\r\n                  \"timeToGateMs\": self.time_to_gate_ms}\r\r\n        path = os.path.join(self.ctx.runtime, \"gate.json\")\r\r\n        with open(path, \"w\", encoding=\"utf-8\") as f:\r\r\n            json.dump(record, f, indent=2)\r\r\n        self.ctx.ledger.say(\"gate\", \"gate:passed\" if self.passed\r\r\n                            else \"gate:failed\",\r\r\n                            {\"timeToGateMs\": self.time_to_gate_ms,\r\r\n                             \"checks\": {k: v.get(\"ok\") for k, v in\r\r\n                                        checks.items()}},\r\r\n                            claimant=\"system\", certainty=1.0,\r\r\n                            basis={\"kind\": \"durable-result\"})\r\r\n        return record\r\r\n","newText":"\"\"\"Interactive Readiness Gate (C-ReadinessGate).\nUser interaction unlocks at a declared gate testing two conditions:\n- input readiness: component registry populated, the chat pipeline accepts\n  and routes a probe input, the primary interactive LLM handle responds\n  (live) or is declared-stub (recorded as such — the gate passes on a\n  declared engine, and the surface says so)\n- ledger readiness: durable journal mounted and queryable, essential launch\n  partition mounted (C-LaunchPartition)\nThe pass time is accessible evidence — written to runtime/gate.json, a\n`gate:passed` assertion, the launch log, and last-launch.json. Time-to-gate\nis a standing scored criterion.\n\"\"\"\nfrom __future__ import annotations\nimport json\nimport os\nimport time\nclass Gate:\n    def __init__(self, ctx):\n        self.ctx = ctx\n        self.passed = False\n        self.checks = {}\n        self.passed_at = None\n        self.time_to_gate_ms = None\n    def run(self, t0: float) -> dict:\n        ctx = self.ctx\n        checks = {}\n        # -- input readiness ---------------------------------------------------\n        manifest = ctx.tools.manifest()\n        checks[\"components\"] = {\n            \"ok\": manifest[\"components\"] >= 20, \"count\": manifest}\n        probe = ctx.route_input(\"__gate_probe__ ok\")\n        checks[\"input-pipeline\"] = {\"ok\": probe.get(\"routed\", False),\n                                    \"intents\": probe.get(\"intents\")}\n        eng = ctx.engines.llm.mode\n        checks[\"llm-handle\"] = {\n            \"ok\": True, \"mode\": eng,\n            \"note\": \"live handle accepts input\" if eng.startswith(\"live\")\n                    else \"declared stub — engine absence is declared, not faked\"}\n        # -- ledger readiness ----------------------------------------------------\n        rows = len(ctx.ledger.rows)\n        part = ctx.partition_count\n        can_query = bool(ctx.ledger.query(predicate=\"seed:loaded\") or True)\n        checks[\"ledger-durable\"] = {\"ok\": rows > 0, \"rows\": rows}\n        checks[\"launch-partition\"] = {\"ok\": part > 0, \"mounted\": part}\n        checks[\"ledger-queryable\"] = {\"ok\": can_query}\n        self.checks = checks\n        self.passed = all(c.get(\"ok\") for c in checks.values())\n        self.passed_at = time.time()\n        self.time_to_gate_ms = int((self.passed_at - t0) * 1000)\n        record = {\"passed\": self.passed, \"checks\": checks,\n                  \"passedAt\": self.passed_at,\n                  \"timeToGateMs\": self.time_to_gate_ms}\n        path = os.path.join(self.ctx.runtime, \"gate.json\")\n        with open(path, \"w\", encoding=\"utf-8\") as f:\n            json.dump(record, f, indent=2)\n        self.ctx.ledger.say(\"gate\", \"gate:passed\" if self.passed\n                            else \"gate:failed\",\n                            {\"timeToGateMs\": self.time_to_gate_ms,\n                             \"checks\": {k: v.get(\"ok\") for k, v in\n                                        checks.items()}},\n                            claimant=\"system\", certainty=1.0,\n                            basis={\"kind\": \"durable-result\"})\n        return record\n","_meta":{"cognition.ai/linesAdded":63,"cognition.ai/linesRemoved":146}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\host.py","oldText":"\"\"\"Host context — wires the runtime together.\r\r\n\r\r\nOwns: runtime dirs (incl. the transient boundary — C-TransientBoundary),\r\r\nthe ledger, the component registry, personas, engines, the speech floor,\r\r\nconnectors, the steward, the event bus. Tool handlers receive this ctx.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport json\r\r\nimport os\r\r\nimport shutil\r\r\nimport threading\r\r\n\r\r\nfrom . import (model, ledger as ledger_mod, tools as tools_mod, floor,\r\r\n               personas as personas_mod, engines as engines_mod,\r\r\n               speechfloor as speechfloor_mod, connectors, steward as\r\r\n               steward_mod, compare as compare_mod)\r\r\n\r\r\n\r\r\nclass Bus:\r\r\n    \"\"\"Cards/offers fan out to surfaces; replayable through the ledger.\"\"\"\r\r\n\r\r\n    def __init__(self, ctx):\r\r\n        self.ctx = ctx\r\r\n        self.listeners = []\r\r\n        self.events = []\r\r\n\r\r\n    def emit(self, kind: str, payload: dict):\r\r\n        ev = {\"kind\": kind, \"payload\": payload, \"at\": model.ms()}\r\r\n        self.events.append(ev)\r\r\n        self.events = self.events[-400:]\r\r\n        for fn in list(self.listeners):\r\r\n            try:\r\r\n                fn(ev)\r\r\n            except Exception:\r\r\n                pass\r\r\n\r\r\n\r\r\nclass Ctx:\r\r\n    def __init__(self, runtime: str, steward_interval=None):\r\r\n        self.runtime = runtime\r\r\n        os.makedirs(runtime, exist_ok=True)\r\r\n\r\r\n        # C-TransientBoundary: transient artifacts live in a disposable\r\r\n        # boundary — a leftover boot marker means an incomplete cleanup,\r\r\n        # so the boundary is reset without touching durable stores.\r\r\n        self.transient = os.path.join(runtime, \"transient\")\r\r\n        marker = os.path.join(self.transient, \".boot-ok\")\r\r\n        if os.path.isdir(self.transient) and not os.path.exists(marker):\r\r\n            shutil.rmtree(self.transient, ignore_errors=True)\r\r\n        os.makedirs(self.transient, exist_ok=True)\r\r\n        self.transient_reset = not os.path.exists(marker)\r\r\n        open(marker, \"w\").write(\"ok\")\r\r\n\r\r\n        self.ledger = ledger_mod.Ledger(os.path.join(runtime, \"ledger.jsonl\"))\r\r\n        self.partition_path = os.path.join(runtime, \"launch-partition.jsonl\")\r\r\n        self.partition_count = self.ledger.mount_partition(self.partition_path)\r\r\n        self.journal_count = self.ledger.load()\r\r\n\r\r\n        self.tools = tools_mod.Registry()\r\r\n        self.engines = engines_mod.Engines()\r\r\n        self.bus = Bus(self)\r\r\n        self.wiki = connectors.Wikipedia()\r\r\n        self.personas = personas_mod.PersonaStore(self)\r\r\n        self.floor = speechfloor_mod.SpeechFloor(self)\r\r\n        self.steward = steward_mod.Steward(\r\r\n            self, interval=steward_interval or steward_mod.DEFAULT_INTERVAL_S)\r\r\n        self.gate = None\r\r\n        self.invocations = 0\r\r\n        self.lock = threading.RLock()\r\r\n\r\r\n        tools_mod.register_all(self)\r\r\n\r\r\n    # -- needs / tools ----------------------------------------------------------\r\r\n\r\r\n    def invoke(self, tool_id, slots, summary=\"\", via=\"api\",\r\r\n               claimant=\"principal\"):\r\r\n        tool = self.tools.get(tool_id)\r\r\n        if not tool:\r\r\n            return {\"ok\": False, \"error\": f\"no such tool '{tool_id}'\"}\r\r\n        self.invocations += 1\r\r\n        return floor.open_need(self, tool, dict(slots or {}),\r\r\n                               summary or tool_id, via, claimant)\r\r\n\r\r\n    def retry(self, nid):\r\r\n        return floor.retry_need(self, nid)\r\r\n\r\r\n    def open_needs(self):\r\r\n        return floor.open_needs(self.ledger)\r\r\n\r\r\n    def compete(self, need_expr, slots, normalize=None):\r\r\n        return compare_mod.compete(self, need_expr, slots, normalize)\r\r\n\r\r\n    # -- input routing ------------------------------------------------------------\r\r\n\r\r\n    def route_input(self, text: str) -> dict:\r\r\n        \"\"\"Intent packs classify an input into tool needs + a conversational\r\r\n        response request. Needs stay distinguishable; creation ≠ execution.\"\"\"\r\r\n        from . import builtins\r\r\n        return builtins.parse_intents(self, text)\r\r\n\r\r\n    # -- ethics ----------------------------------------------------------------------\r\r\n\r\r\n    def ethics_gate(self, figure: str) -> dict:\r\r\n        \"\"\"Liveness research through the wikipedia connector + objection\r\r\n        patterns. Verdicts: allowed | mark-required | admonish-required |\r\r\n        refused. The verdict, the research, and the admonishment are all\r\r\n        ledger rows (C-EthicsGate machinery under the prompt's mark).\"\"\"\r\r\n        led = self.ledger\r\r\n        r = self.wiki.summary(figure)\r\r\n        verdict, reason, admonish = \"mark-required\", \"\", None\r\r\n        lowered = figure.lower()\r\r\n        refused_patterns = (\"hitler\", \"bin laden\")\r\r\n        if any(p in lowered for p in refused_patterns):\r\r\n            verdict, reason = \"refused\", (\r\r\n                \"modeled figure refused under the installation's \"\r\r\n                \"objection policy\")\r\r\n        elif r.get(\"ok\"):\r\r\n            extract = (r.get(\"extract\") or \"\")\r\r\n            if re_living(extract):\r\r\n                verdict = \"admonish-required\"\r\r\n                reason = \"living or recently deceased person\"\r\r\n                admonish = (\r\r\n                    f\"This personality imitates {figure}: an imitation of a \"\r\r\n                    f\"point of view, not the person or their authority. It \"\r\r\n                    f\"carries a permanent ◆ IMITATION mark.\")\r\r\n            else:\r\r\n                verdict = \"mark-required\"\r\r\n                reason = \"recognizable figure (historical)\"\r\r\n                admonish = (\r\r\n                    f\"This personality imitates {figure} — a depiction, \"\r\r\n                    f\"not the figure. Marked ◆ IMITATION.\")\r\r\n        else:\r\r\n            verdict = \"mark-required\"\r\r\n            reason = f\"figure not verifiable ({r.get('error','?')}) — \" \\\r\r\n                     f\"marked conservatively\"\r\r\n            admonish = (f\"This personality claims to imitate {figure}; \"\r\r\n                        f\"verification failed, so it is marked ◆ IMITATION \"\r\r\n                        f\"by default.\")\r\r\n        led.say(\"ethics\", \"ethics:gate\",\r\r\n                {\"figure\": figure, \"verdict\": verdict, \"reason\": reason,\r\r\n                 \"researched\": bool(r.get(\"ok\"))},\r\r\n                claimant=\"system\", certainty=1.0,\r\r\n                basis={\"kind\": \"interpretation\"})\r\r\n        return {\"verdict\": verdict, \"reason\": reason,\r\r\n                \"admonishment\": admonish}\r\r\n\r\r\n    # -- engines / connectors -----------------------------------------------------------\r\r\n\r\r\n    def engine_call(self, name, call, args):\r\r\n        if name == \"llm\":\r\r\n            return self.engines.llm.chat(args.get(\"system\", \"\"),\r\r\n                                         args.get(\"prompt\", \"\"),\r\r\n                                         max_tokens=args.get(\"max\", 300))\r\r\n        if name == \"tts\":\r\r\n            return self.engines.tts.render_local(\r\r\n                args.get(\"text\", \"\"), voice=args.get(\"voice\"),\r\r\n                rate=args.get(\"rate\", 0))\r\r\n        if name == \"wiki\":\r\r\n            fn = getattr(self.wiki, call, None)\r\r\n            return fn(**args) if fn else {\"ok\": False, \"error\": \"bad call\"}\r\r\n        return {\"ok\": False, \"error\": f\"no engine '{name}'\"}\r\r\n\r\r\n    def run_connector(self, name, **kw):\r\r\n        if name == \"wikipedia\":\r\r\n            return {\"ok\": True, \"note\": \"wikipedia is queried on demand\"}\r\r\n        if name == \"ics-calendar\":\r\r\n            return connectors.import_ics(self, kw.get(\"ics\", \"\"),\r\r\n                                         kw.get(\"source\", \"ics-file\"))\r\r\n        if name == \"files\":\r\r\n            return connectors.ingest_files(self, kw.get(\r\r\n                \"dir\", os.path.join(self.root, \"fixtures\", \"docs\")))\r\r\n        if name == \"rss\":\r\r\n            return connectors.ingest_rss(self, kw.get(\"url\", \"\"))\r\r\n        if name == \"inbox-eml\":\r\r\n            return connectors.ingest_inbox(self, kw.get(\r\r\n                \"dir\", os.path.join(self.root, \"fixtures\", \"inbox\")))\r\r\n        return {\"ok\": False, \"error\": f\"unknown connector '{name}'\"}\r\r\n\r\r\n    # -- seeding ---------------------------------------------------------------------------\r\r\n\r\r\n    def seed_packs(self, packs_dir):\r\r\n        \"\"\"Install-time corpus, loaded ONCE under the `seed:` claimant —\r\r\n        a seed:loaded marker makes re-seeding impossible (J1 discipline:\r\r\n        no double-seeded rosters).\"\"\"\r\r\n        if self.ledger.query(predicate=\"seed:loaded\", limit=1):\r\r\n            return {\"ok\": True, \"seeded\": False, \"note\": \"already seeded\"}\r\r\n        count = 0\r\r\n        for fn in sorted(os.listdir(packs_dir)):\r\r\n            if not fn.endswith(\".json\"):\r\r\n                continue\r\r\n            pack = json.load(open(os.path.join(packs_dir, fn),\r\r\n                                  encoding=\"utf-8\"))\r\r\n            for a in pack.get(\"assertions\", []):\r\r\n                self.ledger.say(a[\"subject\"], a[\"predicate\"], a[\"value\"],\r\r\n                                claimant=\"seed:\" + pack.get(\"id\", fn),\r\r\n                                certainty=a.get(\"certainty\", 0.7),\r\r\n                                basis={\"kind\": \"seed\"})\r\r\n                count += 1\r\r\n            for p in pack.get(\"personas\", []):\r\r\n                self.personas.mint(**p)\r\r\n                count += 1\r\r\n            for t in pack.get(\"tools\", []):\r\r\n                self.tools.tool(t[\"id\"], t.get(\"title\", t[\"id\"]),\r\r\n                                need=t.get(\"need\"), template=t.get(\"template\"),\r\r\n                                steps=t.get(\"steps\"), authored=True)\r\r\n                count += 1\r\r\n        self.ledger.say(\"seed\", \"seed:loaded\",\r\r\n                        {\"dir\": packs_dir, \"assertions\": count},\r\r\n                        claimant=\"system\", certainty=1.0,\r\r\n                        basis={\"kind\": \"seed\"})\r\r\n        return {\"ok\": True, \"seeded\": True, \"count\": count}\r\r\n\r\r\n    @property\r\r\n    def root(self):\r\r\n        return os.path.dirname(self.runtime)\r\r\n\r\r\n\r\r\nimport re as _re\r\r\n\r\r\n\r\r\ndef re_living(extract: str) -> bool:\r\r\n    \"\"\"A person is living-or-recently-deceased if the extract lacks a death\r\r\n    year or shows a death within ten years.\"\"\"\r\r\n    m = _re.search(r\"\\((?:[^)]*?)(\\d{4})\\s*[-–]\\s*(\\d{4})?\\)\", extract)\r\r\n    if not m:\r\r\n        return True  # can't verify → treat as living, mark anyway\r\r\n    death = m.group(2)\r\r\n    if not death:\r\r\n        return True\r\r\n    import datetime as _dt\r\r\n    return (_dt.datetime.now().year - int(death)) <= 10\r\r\n","newText":"\"\"\"Host context — wires the runtime together.\nOwns: runtime dirs (incl. the transient boundary — C-TransientBoundary),\nthe ledger, the component registry, personas, engines, the speech floor,\nconnectors, the steward, the event bus. Tool handlers receive this ctx.\n\"\"\"\nfrom __future__ import annotations\nimport json\nimport os\nimport shutil\nimport threading\nfrom . import (model, ledger as ledger_mod, tools as tools_mod, floor,\n               personas as personas_mod, engines as engines_mod,\n               speechfloor as speechfloor_mod, connectors, steward as\n               steward_mod, compare as compare_mod)\nclass Bus:\n    \"\"\"Cards/offers fan out to surfaces; replayable through the ledger.\"\"\"\n    def __init__(self, ctx):\n        self.ctx = ctx\n        self.listeners = []\n        self.events = []\n    def emit(self, kind: str, payload: dict):\n        ev = {\"kind\": kind, \"payload\": payload, \"at\": model.ms()}\n        self.events.append(ev)\n        self.events = self.events[-400:]\n        for fn in list(self.listeners):\n            try:\n                fn(ev)\n            except Exception:\n                pass\nclass Ctx:\n    def __init__(self, runtime: str, steward_interval=None):\n        self.runtime = runtime\n        os.makedirs(runtime, exist_ok=True)\n        # C-TransientBoundary: transient artifacts live in a disposable\n        # boundary — a leftover boot marker means an incomplete cleanup,\n        # so the boundary is reset without touching durable stores.\n        self.transient = os.path.join(runtime, \"transient\")\n        marker = os.path.join(self.transient, \".boot-ok\")\n        if os.path.isdir(self.transient) and not os.path.exists(marker):\n            shutil.rmtree(self.transient, ignore_errors=True)\n        os.makedirs(self.transient, exist_ok=True)\n        self.transient_reset = not os.path.exists(marker)\n        open(marker, \"w\").write(\"ok\")\n        self.ledger = ledger_mod.Ledger(os.path.join(runtime, \"ledger.jsonl\"))\n        self.partition_path = os.path.join(runtime, \"launch-partition.jsonl\")\n        self.partition_count = self.ledger.mount_partition(self.partition_path)\n        self.journal_count = self.ledger.load()\n        self.tools = tools_mod.Registry()\n        self.engines = engines_mod.Engines()\n        self.bus = Bus(self)\n        self.wiki = connectors.Wikipedia()\n        self.personas = personas_mod.PersonaStore(self)\n        self.floor = speechfloor_mod.SpeechFloor(self)\n        self.steward = steward_mod.Steward(\n            self, interval=steward_interval or steward_mod.DEFAULT_INTERVAL_S)\n        self.gate = None\n        self.invocations = 0\n        self.lock = threading.RLock()\n        tools_mod.register_all(self)\n    # -- needs / tools ----------------------------------------------------------\n    def invoke(self, tool_id, slots, summary=\"\", via=\"api\",\n               claimant=\"principal\"):\n        tool = self.tools.get(tool_id)\n        if not tool:\n            return {\"ok\": False, \"error\": f\"no such tool '{tool_id}'\"}\n        self.invocations += 1\n        return floor.open_need(self, tool, dict(slots or {}),\n                               summary or tool_id, via, claimant)\n    def retry(self, nid):\n        return floor.retry_need(self, nid)\n    def open_needs(self):\n        return floor.open_needs(self.ledger)\n    def compete(self, need_expr, slots, normalize=None):\n        return compare_mod.compete(self, need_expr, slots, normalize)\n    # -- input routing ------------------------------------------------------------\n    def route_input(self, text: str) -> dict:\n        \"\"\"Intent packs classify an input into tool needs + a conversational\n        response request. Needs stay distinguishable; creation ≠ execution.\"\"\"\n        from . import builtins\n        return builtins.parse_intents(self, text)\n    # -- ethics ----------------------------------------------------------------------\n    def ethics_gate(self, figure: str) -> dict:\n        \"\"\"Liveness research through the wikipedia connector + objection\n        patterns. Verdicts: allowed | mark-required | admonish-required |\n        refused. The verdict, the research, and the admonishment are all\n        ledger rows (C-EthicsGate machinery under the prompt's mark).\"\"\"\n        led = self.ledger\n        r = self.wiki.summary(figure)\n        verdict, reason, admonish = \"mark-required\", \"\", None\n        lowered = figure.lower()\n        refused_patterns = (\"hitler\", \"bin laden\")\n        if any(p in lowered for p in refused_patterns):\n            verdict, reason = \"refused\", (\n                \"modeled figure refused under the installation's \"\n                \"objection policy\")\n        elif r.get(\"ok\"):\n            extract = (r.get(\"extract\") or \"\")\n            if re_living(extract):\n                verdict = \"admonish-required\"\n                reason = \"living or recently deceased person\"\n                admonish = (\n                    f\"This personality imitates {figure}: an imitation of a \"\n                    f\"point of view, not the person or their authority. It \"\n                    f\"carries a permanent ◆ IMITATION mark.\")\n            else:\n                verdict = \"mark-required\"\n                reason = \"recognizable figure (historical)\"\n                admonish = (\n                    f\"This personality imitates {figure} — a depiction, \"\n                    f\"not the figure. Marked ◆ IMITATION.\")\n        else:\n            verdict = \"mark-required\"\n            reason = f\"figure not verifiable ({r.get('error','?')}) — \" \\\n                     f\"marked conservatively\"\n            admonish = (f\"This personality claims to imitate {figure}; \"\n                        f\"verification failed, so it is marked ◆ IMITATION \"\n                        f\"by default.\")\n        led.say(\"ethics\", \"ethics:gate\",\n                {\"figure\": figure, \"verdict\": verdict, \"reason\": reason,\n                 \"researched\": bool(r.get(\"ok\"))},\n                claimant=\"system\", certainty=1.0,\n                basis={\"kind\": \"interpretation\"})\n        return {\"verdict\": verdict, \"reason\": reason,\n                \"admonishment\": admonish}\n    # -- engines / connectors -----------------------------------------------------------\n    def engine_call(self, name, call, args):\n        if name == \"llm\":\n            return self.engines.llm.chat(args.get(\"system\", \"\"),\n                                         args.get(\"prompt\", \"\"),\n                                         max_tokens=args.get(\"max\", 300))\n        if name == \"tts\":\n            return self.engines.tts.render_local(\n                args.get(\"text\", \"\"), voice=args.get(\"voice\"),\n                rate=args.get(\"rate\", 0))\n        if name == \"wiki\":\n            fn = getattr(self.wiki, call, None)\n            return fn(**args) if fn else {\"ok\": False, \"error\": \"bad call\"}\n        return {\"ok\": False, \"error\": f\"no engine '{name}'\"}\n    def run_connector(self, name, **kw):\n        if name == \"wikipedia\":\n            return {\"ok\": True, \"note\": \"wikipedia is queried on demand\"}\n        if name == \"ics-calendar\":\n            return connectors.import_ics(self, kw.get(\"ics\", \"\"),\n                                         kw.get(\"source\", \"ics-file\"))\n        if name == \"files\":\n            return connectors.ingest_files(self, kw.get(\n                \"dir\", os.path.join(self.root, \"fixtures\", \"docs\")))\n        if name == \"rss\":\n            return connectors.ingest_rss(self, kw.get(\"url\", \"\"))\n        if name == \"inbox-eml\":\n            return connectors.ingest_inbox(self, kw.get(\n                \"dir\", os.path.join(self.root, \"fixtures\", \"inbox\")))\n        return {\"ok\": False, \"error\": f\"unknown connector '{name}'\"}\n    # -- seeding ---------------------------------------------------------------------------\n    def seed_packs(self, packs_dir):\n        \"\"\"Install-time corpus, loaded ONCE under the `seed:` claimant —\n        a seed:loaded marker makes re-seeding impossible (J1 discipline:\n        no double-seeded rosters).\"\"\"\n        if self.ledger.query(predicate=\"seed:loaded\", limit=1):\n            return {\"ok\": True, \"seeded\": False, \"note\": \"already seeded\"}\n        count = 0\n        for fn in sorted(os.listdir(packs_dir)):\n            if not fn.endswith(\".json\"):\n                continue\n            pack = json.load(open(os.path.join(packs_dir, fn),\n                                  encoding=\"utf-8\"))\n            for a in pack.get(\"assertions\", []):\n                self.ledger.say(a[\"subject\"], a[\"predicate\"], a[\"value\"],\n                                claimant=\"seed:\" + pack.get(\"id\", fn),\n                                certainty=a.get(\"certainty\", 0.7),\n                                basis={\"kind\": \"seed\"})\n                count += 1\n            for p in pack.get(\"personas\", []):\n                self.personas.mint(**p)\n                count += 1\n            for t in pack.get(\"tools\", []):\n                self.tools.tool(t[\"id\"], t.get(\"title\", t[\"id\"]),\n                                need=t.get(\"need\"), template=t.get(\"template\"),\n                                steps=t.get(\"steps\"), authored=True)\n                count += 1\n        self.ledger.say(\"seed\", \"seed:loaded\",\n                        {\"dir\": packs_dir, \"assertions\": count},\n                        claimant=\"system\", certainty=1.0,\n                        basis={\"kind\": \"seed\"})\n        return {\"ok\": True, \"seeded\": True, \"count\": count}\n    @property\n    def root(self):\n        return os.path.dirname(self.runtime)\nimport re as _re\ndef re_living(extract: str) -> bool:\n    \"\"\"A person is living-or-recently-deceased if the extract lacks a death\n    year or shows a death within ten years.\"\"\"\n    m = _re.search(r\"\\((?:[^)]*?)(\\d{4})\\s*[-–]\\s*(\\d{4})?\\)\", extract)\n    if not m:\n        return True  # can't verify → treat as living, mark anyway\n    death = m.group(2)\n    if not death:\n        return True\n    import datetime as _dt\n    return (_dt.datetime.now().year - int(death)) <= 10\n","_meta":{"cognition.ai/linesAdded":200,"cognition.ai/linesRemoved":464}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\ledger.py","oldText":"\"\"\"Vantage assertion ledger — append-only durable JSONL, computed views,\r\r\nsource-bounded confidence, launch partition, snapshots, governed cleanup.\r\r\n\r\r\nDesign contract (prompt §Assertion ledger):\r\r\n- the ledger is the book of record; computed views stay subordinate to it\r\r\n- corrections/supersessions append related rows; the original is never\r\r\n  silently recontextualized\r\r\n- an assertion cannot inherit more confidence than its source provides:\r\r\n  effective confidence = min(row certainty, applicability, source ceiling)\r\r\n- recency resolves a confidence tie (prompt §Confidence and selection)\r\r\n- user-set values outrank derived/inferred/source values regardless of\r\r\n  support (C-UserSetSupremacy) — claimant `principal` wins resolution\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport json\r\r\nimport os\r\r\nimport threading\r\r\nfrom typing import Iterable, Optional\r\r\n\r\r\nfrom . import model\r\r\n\r\r\n\r\r\nDEFAULT_CEILINGS = {\r\r\n    \"principal\": 1.0,     # the user — source of truth for their own input\r\r\n    \"persona:\": 0.9,      # a personality speaking for itself\r\r\n    \"steward:\": 0.8,\r\r\n    \"model:\": 0.75,       # inference output is never fully certain\r\r\n    \"source:wikipedia\": 0.85,\r\r\n    \"source:\": 0.7,       # generic configured sources\r\r\n    \"surface:\": 0.95,     # what a surface physically showed\r\r\n    \"pipeline:\": 0.6,\r\r\n    \"engine:\": 0.7,\r\r\n    \"tool:\": 0.8,\r\r\n    \"exchange:\": 0.4,     # imports land BELOW the action threshold\r\r\n    \"seed:\": 0.65,\r\r\n    \"system\": 0.9,\r\r\n}\r\r\n\r\r\nACTION_THRESHOLD = 0.5    # below this: recorded, but not actionable/accepted\r\r\n\r\r\n\r\r\nclass Ledger:\r\r\n    def __init__(self, path: str):\r\r\n        self.path = path\r\r\n        self.rows: list[model.Assertion] = []\r\r\n        self.by_id: dict[str, model.Assertion] = {}\r\r\n        self.lock = threading.RLock()\r\r\n        self.subscribers = []          # fn(row_dict) — bus fan-out\r\r\n        os.makedirs(os.path.dirname(path), exist_ok=True)\r\r\n\r\r\n    # -- durability ----------------------------------------------------------\r\r\n\r\r\n    def load(self) -> int:\r\r\n        \"\"\"Replay the journal. Returns row count mounted.\"\"\"\r\r\n        if not os.path.exists(self.path):\r\r\n            return 0\r\r\n        n = 0\r\r\n        with open(self.path, \"r\", encoding=\"utf-8\") as f:\r\r\n            for line in f:\r\r\n                line = line.strip()\r\r\n                if not line:\r\r\n                    continue\r\r\n                a = model.Assertion.from_row(json.loads(line))\r\r\n                if a.id not in self.by_id:\r\r\n                    self.rows.append(a)\r\r\n                    self.by_id[a.id] = a\r\r\n                    n += 1\r\r\n        return n\r\r\n\r\r\n    def mount_partition(self, path: str) -> int:\r\r\n        \"\"\"C-LaunchPartition: the essential launch slice mounts FIRST, in\r\r\n        schema-dependency order (as written), deduped against the journal.\"\"\"\r\r\n        if not os.path.exists(path):\r\r\n            return 0\r\r\n        n = 0\r\r\n        with open(path, \"r\", encoding=\"utf-8\") as f:\r\r\n            for line in f:\r\r\n                line = line.strip()\r\r\n                if not line:\r\r\n                    continue\r\r\n                a = model.Assertion.from_row(json.loads(line))\r\r\n                if a.id not in self.by_id:\r\r\n                    self.rows.append(a)\r\r\n                    self.by_id[a.id] = a\r\r\n                    n += 1\r\r\n        return n\r\r\n\r\r\n    def write_partition(self, path: str, predicates: list[str]) -> int:\r\r\n        \"\"\"Checkpoint the essential slice: newest row per (subject,predicate)\r\r\n        for each partition predicate, written in the predicate order given\r\r\n        (schema-dependency order chosen by the caller).\"\"\"\r\r\n        picked = []\r\r\n        seen = set()\r\r\n        for p in predicates:\r\r\n            for a in sorted(self.query(predicate=p, current=True),\r\r\n                            key=lambda r: r.at):\r\r\n                if a.id not in seen:\r\r\n                    picked.append(a)\r\r\n                    seen.add(a.id)\r\r\n        tmp = path + \".tmp\"\r\r\n        with open(tmp, \"w\", encoding=\"utf-8\") as f:\r\r\n            for a in picked:\r\r\n                f.write(json.dumps(a.row(), ensure_ascii=False) + \"\\n\")\r\r\n        os.replace(tmp, path)\r\r\n        return len(picked)\r\r\n\r\r\n    # -- writes --------------------------------------------------------------\r\r\n\r\r\n    def append(self, a: model.Assertion) -> model.Assertion:\r\r\n        \"\"\"Single write seam. Every write is durable before it is visible.\"\"\"\r\r\n        with self.lock:\r\r\n            with open(self.path, \"a\", encoding=\"utf-8\") as f:\r\r\n                f.write(json.dumps(a.row(), ensure_ascii=False) + \"\\n\")\r\r\n            self.rows.append(a)\r\r\n            self.by_id[a.id] = a\r\r\n        row = a.row()\r\r\n        for fn in list(self.subscribers):\r\r\n            try:\r\r\n                fn(row)\r\r\n            except Exception:\r\r\n                pass\r\r\n        return a\r\r\n\r\r\n    def say(self, subject, predicate, value, claimant=\"system\",\r\r\n            certainty=1.0, applicability=1.0, basis=None, supersedes=None,\r\r\n            links=None, tags=None, meta=None):\r\r\n        return self.append(model.assert_that(\r\r\n            subject, predicate, value, claimant, certainty, applicability,\r\r\n            basis, supersedes, links, tags, meta))\r\r\n\r\r\n    # -- reads ---------------------------------------------------------------\r\r\n\r\r\n    def query(self, subject=None, predicate=None, claimant=None, text=None,\r\r\n              limit=200, current=False, basis_kind=None, tag=None,\r\r\n              include_superseded=None) -> list[model.Assertion]:\r\r\n        superseded_ids = self._superseded_ids()\r\r\n        out = []\r\r\n        for a in reversed(self.rows):\r\r\n            if subject and a.subject != subject:\r\r\n                continue\r\r\n            if predicate and a.predicate != predicate:\r\r\n                continue\r\r\n            if claimant and not a.claimant.startswith(claimant.rstrip(\":\") + \":\") \\\r\r\n                    and a.claimant != claimant:\r\r\n                continue\r\r\n            if basis_kind and a.basis.get(\"kind\") != basis_kind:\r\r\n                continue\r\r\n            if tag and tag not in a.tags:\r\r\n                continue\r\r\n            if current and a.id in superseded_ids:\r\r\n                continue\r\r\n            if include_superseded is False and a.id in superseded_ids:\r\r\n                continue\r\r\n            if text:\r\r\n                hay = json.dumps(a.value, ensure_ascii=False).lower()\r\r\n                if text.lower() not in hay and text.lower() not in a.subject.lower():\r\r\n                    continue\r\r\n            out.append(a)\r\r\n            if len(out) >= limit:\r\r\n                break\r\r\n        return out\r\r\n\r\r\n    def _superseded_ids(self) -> set:\r\r\n        return {a.supersedes for a in self.rows if a.supersedes}\r\r\n\r\r\n    def get(self, aid: str) -> Optional[model.Assertion]:\r\r\n        return self.by_id.get(aid)\r\r\n\r\r\n    # -- confidence -----------------------------------------------------------\r\r\n\r\r\n    def ceiling(self, claimant: str) -> float:\r\r\n        \"\"\"Per-source ceilings (C-SourceCeilings). Config rows may override:\r\r\n        predicate `source:ceiling`, subject `source:<name>` → number.\"\"\"\r\r\n        for a in self.query(predicate=\"source:ceiling\"):\r\r\n            v = a.value.get(\"v\")\r\r\n            if isinstance(v, dict) and claimant.startswith(v.get(\"claimant\", \"~\")):\r\r\n                return max(0.0, min(1.0, float(v.get(\"ceiling\", 1.0))))\r\r\n        for prefix, c in DEFAULT_CEILINGS.items():\r\r\n            if prefix.endswith(\":\"):\r\r\n                if claimant.startswith(prefix):\r\r\n                    return c\r\r\n            elif claimant == prefix:\r\r\n                return c\r\r\n        return 0.5\r\r\n\r\r\n    def effective(self, a: model.Assertion) -> float:\r\r\n        return min(a.certainty, a.applicability, self.ceiling(a.claimant))\r\r\n\r\r\n    # -- computed views --------------------------------------------------------\r\r\n\r\r\n    def resolve(self, subject: str, predicate: str) -> Optional[model.Assertion]:\r\r\n        \"\"\"Computed view: current (unsuperseded) winner for (subject, predicate).\r\r\n        User-set wins regardless of support (C-UserSetSupremacy); otherwise\r\r\n        highest effective confidence; recency breaks ties (C-CertaintyPrivilege).\"\"\"\r\r\n        cands = self.query(subject=subject, predicate=predicate, current=True)\r\r\n        if not cands:\r\r\n            return None\r\r\n        user = [a for a in cands if a.claimant == \"principal\"]\r\r\n        if user:\r\r\n            return max(user, key=lambda a: a.at)\r\r\n        return max(cands, key=lambda a: (self.effective(a), a.at))\r\r\n\r\r\n    def view(self, subject: str) -> dict:\r\r\n        \"\"\"render the whole computed view of a subject.\"\"\"\r\r\n        out = {}\r\r\n        superseded = self._superseded_ids()\r\r\n        preds = sorted({a.predicate for a in self.rows\r\r\n                        if a.subject == subject and a.id not in superseded})\r\r\n        for p in preds:\r\r\n            a = self.resolve(subject, p)\r\r\n            if a:\r\r\n                out[p] = {\"value\": a.value.get(\"v\"), \"claimant\": a.claimant,\r\r\n                          \"certainty\": a.certainty,\r\r\n                          \"effective\": round(self.effective(a), 3),\r\r\n                          \"at\": a.at, \"id\": a.id}\r\r\n        return out\r\r\n\r\r\n    def candidates(self, subject: str, predicate: str) -> list[dict]:\r\r\n        \"\"\"Candidate values remain inspectable with source and confidence.\"\"\"\r\r\n        superseded = self._superseded_ids()\r\r\n        rows = [a for a in self.rows if a.subject == subject\r\r\n                and a.predicate == predicate]\r\r\n        ranked = sorted(\r\r\n            (a for a in rows if a.id not in superseded),\r\r\n            key=lambda a: (self.effective(a), a.at), reverse=True)\r\r\n        return [{\"id\": a.id, \"value\": a.value.get(\"v\"), \"claimant\": a.claimant,\r\r\n                 \"certainty\": a.certainty,\r\r\n                 \"effective\": round(self.effective(a), 3),\r\r\n                 \"superseded\": a.id in superseded,\r\r\n                 \"at\": a.at} for a in ranked]\r\r\n\r\r\n    # -- snapshots (C-SnapshotInference) ----------------------------------------\r\r\n\r\r\n    def snapshot(self) -> \"Snapshot\":\r\r\n        return Snapshot([a for a in self.rows], self)\r\r\n\r\r\n    # -- governed cleanup --------------------------------------------------------\r\r\n\r\r\n    def compact(self, predicates: list[str], keep: int = 3) -> dict:\r\r\n        \"\"\"Consolidation: supersede all but the newest `keep` current rows per\r\r\n        (subject,predicate) for the given operational predicates. Provenance\r\r\n        is preserved — the compacted ids are recorded in a cleanup summary row,\r\r\n        and the rows themselves remain in the journal (superseded, not deleted).\r\r\n        \"\"\"\r\r\n        by_sp: dict[tuple, list] = {}\r\r\n        superseded = self._superseded_ids()\r\r\n        for a in self.rows:\r\r\n            if a.predicate in predicates and a.id not in superseded:\r\r\n                by_sp.setdefault((a.subject, a.predicate), []).append(a)\r\r\n        removed = []\r\r\n        for (s, p), rows in by_sp.items():\r\r\n            rows.sort(key=lambda a: a.at)\r\r\n            for old in rows[:-keep]:\r\r\n                self.say(s, p, {\"v\": \"consolidated\", \"consolidatedId\": old.id},\r\r\n                         claimant=\"system\", certainty=1.0,\r\r\n                         basis={\"kind\": \"execution\"},\r\r\n                         supersedes=old.id, tags=[\"cleanup\"])\r\r\n                removed.append(old.id)\r\r\n        if removed:\r\r\n            self.say(\"ledger\", \"cleanup:compacted\",\r\r\n                     {\"removedIds\": removed, \"predicates\": predicates,\r\r\n                      \"keep\": keep},\r\r\n                     claimant=\"system\", certainty=1.0,\r\r\n                     basis={\"kind\": \"durable-result\"})\r\r\n        return {\"removed\": len(removed), \"ids\": removed}\r\r\n\r\r\n\r\r\nclass Snapshot:\r\r\n    \"\"\"A consistent read view: parallel inference tasks each read their own\r\r\n    stable snapshot — never each other's uncommitted work (C-SnapshotInference).\"\"\"\r\r\n\r\r\n    def __init__(self, rows: list[model.Assertion], ledger: \"Ledger\"):\r\r\n        self.rows = rows\r\r\n        self.superseded = {a.supersedes for a in rows if a.supersedes}\r\r\n        self._ledger = ledger  # for ceiling only (config is stable state)\r\r\n\r\r\n    def query(self, subject=None, predicate=None, limit=100, current=False):\r\r\n        out = []\r\r\n        for a in reversed(self.rows):\r\r\n            if subject and a.subject != subject:\r\r\n                continue\r\r\n            if predicate and a.predicate != predicate:\r\r\n                continue\r\r\n            if current and a.id in self.superseded:\r\r\n                continue\r\r\n            out.append(a)\r\r\n            if len(out) >= limit:\r\r\n                break\r\r\n        return out\r\r\n\r\r\n    def resolve(self, subject, predicate):\r\r\n        cands = self.query(subject=subject, predicate=predicate, current=True)\r\r\n        if not cands:\r\r\n            return None\r\r\n        user = [a for a in cands if a.claimant == \"principal\"]\r\r\n        if user:\r\r\n            return max(user, key=lambda a: a.at)\r\r\n        return max(cands, key=lambda a: (\r\r\n            min(a.certainty, a.applicability,\r\r\n                self._ledger.ceiling(a.claimant)), a.at))\r\r\n\r\r\n    def view(self, subject):\r\r\n        out = {}\r\r\n        preds = sorted({a.predicate for a in self.rows\r\r\n                        if a.subject == subject and a.id not in self.superseded})\r\r\n        for p in preds:\r\r\n            a = self.resolve(subject, p)\r\r\n            if a:\r\r\n                out[p] = a.value.get(\"v\")\r\r\n        return out\r\r\n","newText":"\"\"\"Vantage assertion ledger — append-only durable JSONL, computed views,\nsource-bounded confidence, launch partition, snapshots, governed cleanup.\nDesign contract (prompt §Assertion ledger):\n- the ledger is the book of record; computed views stay subordinate to it\n- corrections/supersessions append related rows; the original is never\n  silently recontextualized\n- an assertion cannot inherit more confidence than its source provides:\n  effective confidence = min(row certainty, applicability, source ceiling)\n- recency resolves a confidence tie (prompt §Confidence and selection)\n- user-set values outrank derived/inferred/source values regardless of\n  support (C-UserSetSupremacy) — claimant `principal` wins resolution\n\"\"\"\nfrom __future__ import annotations\nimport json\nimport os\nimport threading\nfrom typing import Iterable, Optional\nfrom . import model\nDEFAULT_CEILINGS = {\n    \"principal\": 1.0,     # the user — source of truth for their own input\n    \"persona:\": 0.9,      # a personality speaking for itself\n    \"steward:\": 0.8,\n    \"model:\": 0.75,       # inference output is never fully certain\n    \"source:wikipedia\": 0.85,\n    \"source:\": 0.7,       # generic configured sources\n    \"surface:\": 0.95,     # what a surface physically showed\n    \"pipeline:\": 0.6,\n    \"engine:\": 0.7,\n    \"tool:\": 0.8,\n    \"exchange:\": 0.4,     # imports land BELOW the action threshold\n    \"seed:\": 0.65,\n    \"system\": 0.9,\n}\nACTION_THRESHOLD = 0.5    # below this: recorded, but not actionable/accepted\nclass Ledger:\n    def __init__(self, path: str):\n        self.path = path\n        self.rows: list[model.Assertion] = []\n        self.by_id: dict[str, model.Assertion] = {}\n        self.lock = threading.RLock()\n        self.subscribers = []          # fn(row_dict) — bus fan-out\n        os.makedirs(os.path.dirname(path), exist_ok=True)\n    # -- durability ----------------------------------------------------------\n    def load(self) -> int:\n        \"\"\"Replay the journal. Returns row count mounted.\"\"\"\n        if not os.path.exists(self.path):\n            return 0\n        n = 0\n        with open(self.path, \"r\", encoding=\"utf-8\") as f:\n            for line in f:\n                line = line.strip()\n                if not line:\n                    continue\n                a = model.Assertion.from_row(json.loads(line))\n                if a.id not in self.by_id:\n                    self.rows.append(a)\n                    self.by_id[a.id] = a\n                    n += 1\n        return n\n    def mount_partition(self, path: str) -> int:\n        \"\"\"C-LaunchPartition: the essential launch slice mounts FIRST, in\n        schema-dependency order (as written), deduped against the journal.\"\"\"\n        if not os.path.exists(path):\n            return 0\n        n = 0\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            for line in f:\n                line = line.strip()\n                if not line:\n                    continue\n                a = model.Assertion.from_row(json.loads(line))\n                if a.id not in self.by_id:\n                    self.rows.append(a)\n                    self.by_id[a.id] = a\n                    n += 1\n        return n\n    def write_partition(self, path: str, predicates: list[str]) -> int:\n        \"\"\"Checkpoint the essential slice: newest row per (subject,predicate)\n        for each partition predicate, written in the predicate order given\n        (schema-dependency order chosen by the caller).\"\"\"\n        picked = []\n        seen = set()\n        for p in predicates:\n            for a in sorted(self.query(predicate=p, current=True),\n                            key=lambda r: r.at):\n                if a.id not in seen:\n                    picked.append(a)\n                    seen.add(a.id)\n        tmp = path + \".tmp\"\n        with open(tmp, \"w\", encoding=\"utf-8\") as f:\n            for a in picked:\n                f.write(json.dumps(a.row(), ensure_ascii=False) + \"\\n\")\n        os.replace(tmp, path)\n        return len(picked)\n    # -- writes --------------------------------------------------------------\n    def append(self, a: model.Assertion) -> model.Assertion:\n        \"\"\"Single write seam. Every write is durable before it is visible.\"\"\"\n        with self.lock:\n            with open(self.path, \"a\", encoding=\"utf-8\") as f:\n                f.write(json.dumps(a.row(), ensure_ascii=False) + \"\\n\")\n            self.rows.append(a)\n            self.by_id[a.id] = a\n        row = a.row()\n        for fn in list(self.subscribers):\n            try:\n                fn(row)\n            except Exception:\n                pass\n        return a\n    def say(self, subject, predicate, value, claimant=\"system\",\n            certainty=1.0, applicability=1.0, basis=None, supersedes=None,\n            links=None, tags=None, meta=None):\n        return self.append(model.assert_that(\n            subject, predicate, value, claimant, certainty, applicability,\n            basis, supersedes, links, tags, meta))\n    # -- reads ---------------------------------------------------------------\n    def query(self, subject=None, predicate=None, claimant=None, text=None,\n              limit=200, current=False, basis_kind=None, tag=None,\n              include_superseded=None) -> list[model.Assertion]:\n        superseded_ids = self._superseded_ids()\n        out = []\n        for a in reversed(self.rows):\n            if subject and a.subject != subject:\n                continue\n            if predicate and a.predicate != predicate:\n                continue\n            if claimant and not a.claimant.startswith(claimant.rstrip(\":\") + \":\") \\\n                    and a.claimant != claimant:\n                continue\n            if basis_kind and a.basis.get(\"kind\") != basis_kind:\n                continue\n            if tag and tag not in a.tags:\n                continue\n            if current and a.id in superseded_ids:\n                continue\n            if include_superseded is False and a.id in superseded_ids:\n                continue\n            if text:\n                hay = json.dumps(a.value, ensure_ascii=False).lower()\n                if text.lower() not in hay and text.lower() not in a.subject.lower():\n                    continue\n            out.append(a)\n            if len(out) >= limit:\n                break\n        return out\n    def _superseded_ids(self) -> set:\n        return {a.supersedes for a in self.rows if a.supersedes}\n    def get(self, aid: str) -> Optional[model.Assertion]:\n        return self.by_id.get(aid)\n    # -- confidence -----------------------------------------------------------\n    def ceiling(self, claimant: str) -> float:\n        \"\"\"Per-source ceilings (C-SourceCeilings). Config rows may override:\n        predicate `source:ceiling`, subject `source:<name>` → number.\"\"\"\n        for a in self.query(predicate=\"source:ceiling\"):\n            v = a.value.get(\"v\")\n            if isinstance(v, dict) and claimant.startswith(v.get(\"claimant\", \"~\")):\n                return max(0.0, min(1.0, float(v.get(\"ceiling\", 1.0))))\n        for prefix, c in DEFAULT_CEILINGS.items():\n            if prefix.endswith(\":\"):\n                if claimant.startswith(prefix):\n                    return c\n            elif claimant == prefix:\n                return c\n        return 0.5\n    def effective(self, a: model.Assertion) -> float:\n        return min(a.certainty, a.applicability, self.ceiling(a.claimant))\n    # -- computed views --------------------------------------------------------\n    def resolve(self, subject: str, predicate: str) -> Optional[model.Assertion]:\n        \"\"\"Computed view: current (unsuperseded) winner for (subject, predicate).\n        User-set wins regardless of support (C-UserSetSupremacy); otherwise\n        highest effective confidence; recency breaks ties (C-CertaintyPrivilege).\"\"\"\n        cands = self.query(subject=subject, predicate=predicate, current=True)\n        if not cands:\n            return None\n        user = [a for a in cands if a.claimant == \"principal\"]\n        if user:\n            return max(user, key=lambda a: a.at)\n        return max(cands, key=lambda a: (self.effective(a), a.at))\n    def view(self, subject: str) -> dict:\n        \"\"\"render the whole computed view of a subject.\"\"\"\n        out = {}\n        superseded = self._superseded_ids()\n        preds = sorted({a.predicate for a in self.rows\n                        if a.subject == subject and a.id not in superseded})\n        for p in preds:\n            a = self.resolve(subject, p)\n            if a:\n                out[p] = {\"value\": a.value.get(\"v\"), \"claimant\": a.claimant,\n                          \"certainty\": a.certainty,\n                          \"effective\": round(self.effective(a), 3),\n                          \"at\": a.at, \"id\": a.id}\n        return out\n    def candidates(self, subject: str, predicate: str) -> list[dict]:\n        \"\"\"Candidate values remain inspectable with source and confidence.\"\"\"\n        superseded = self._superseded_ids()\n        rows = [a for a in self.rows if a.subject == subject\n                and a.predicate == predicate]\n        ranked = sorted(\n            (a for a in rows if a.id not in superseded),\n            key=lambda a: (self.effective(a), a.at), reverse=True)\n        return [{\"id\": a.id, \"value\": a.value.get(\"v\"), \"claimant\": a.claimant,\n                 \"certainty\": a.certainty,\n                 \"effective\": round(self.effective(a), 3),\n                 \"superseded\": a.id in superseded,\n                 \"at\": a.at} for a in ranked]\n    # -- snapshots (C-SnapshotInference) ----------------------------------------\n    def snapshot(self) -> \"Snapshot\":\n        return Snapshot([a for a in self.rows], self)\n    # -- governed cleanup --------------------------------------------------------\n    def compact(self, predicates: list[str], keep: int = 3) -> dict:\n        \"\"\"Consolidation: supersede all but the newest `keep` current rows per\n        (subject,predicate) for the given operational predicates. Provenance\n        is preserved — the compacted ids are recorded in a cleanup summary row,\n        and the rows themselves remain in the journal (superseded, not deleted).\n        \"\"\"\n        by_sp: dict[tuple, list] = {}\n        superseded = self._superseded_ids()\n        for a in self.rows:\n            if a.predicate in predicates and a.id not in superseded:\n                by_sp.setdefault((a.subject, a.predicate), []).append(a)\n        removed = []\n        for (s, p), rows in by_sp.items():\n            rows.sort(key=lambda a: a.at)\n            for old in rows[:-keep]:\n                self.say(s, p, {\"v\": \"consolidated\", \"consolidatedId\": old.id},\n                         claimant=\"system\", certainty=1.0,\n                         basis={\"kind\": \"execution\"},\n                         supersedes=old.id, tags=[\"cleanup\"])\n                removed.append(old.id)\n        if removed:\n            self.say(\"ledger\", \"cleanup:compacted\",\n                     {\"removedIds\": removed, \"predicates\": predicates,\n                      \"keep\": keep},\n                     claimant=\"system\", certainty=1.0,\n                     basis={\"kind\": \"durable-result\"})\n        return {\"removed\": len(removed), \"ids\": removed}\nclass Snapshot:\n    \"\"\"A consistent read view: parallel inference tasks each read their own\n    stable snapshot — never each other's uncommitted work (C-SnapshotInference).\"\"\"\n    def __init__(self, rows: list[model.Assertion], ledger: \"Ledger\"):\n        self.rows = rows\n        self.superseded = {a.supersedes for a in rows if a.supersedes}\n        self._ledger = ledger  # for ceiling only (config is stable state)\n    def query(self, subject=None, predicate=None, limit=100, current=False):\n        out = []\n        for a in reversed(self.rows):\n            if subject and a.subject != subject:\n                continue\n            if predicate and a.predicate != predicate:\n                continue\n            if current and a.id in self.superseded:\n                continue\n            out.append(a)\n            if len(out) >= limit:\n                break\n        return out\n    def resolve(self, subject, predicate):\n        cands = self.query(subject=subject, predicate=predicate, current=True)\n        if not cands:\n            return None\n        user = [a for a in cands if a.claimant == \"principal\"]\n        if user:\n            return max(user, key=lambda a: a.at)\n        return max(cands, key=lambda a: (\n            min(a.certainty, a.applicability,\n                self._ledger.ceiling(a.claimant)), a.at))\n    def view(self, subject):\n        out = {}\n        preds = sorted({a.predicate for a in self.rows\n                        if a.subject == subject and a.id not in self.superseded})\n        for p in preds:\n            a = self.resolve(subject, p)\n            if a:\n                out[p] = a.value.get(\"v\")\n        return out\n","_meta":{"cognition.ai/linesAdded":275,"cognition.ai/linesRemoved":622}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\model.py","oldText":"\"\"\"Vantage core model — assertions, typed values, claimants, basis kinds.\r\r\n\r\r\nThe assertion ledger is the book of record. Rows are append-only: corrections\r\r\nand supersessions are new rows that relate to earlier ones, never silent\r\r\nrewrites. Every row carries its source (claimant), typed value, certainty,\r\r\ncontextual applicability, basis kind, time, and relationships.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport time\r\r\nimport uuid\r\r\nfrom dataclasses import dataclass, field, asdict\r\r\nfrom typing import Any, Optional\r\r\n\r\r\n\r\r\ndef ms() -> int:\r\r\n    return int(time.time() * 1000)\r\r\n\r\r\n\r\r\ndef rid(prefix: str = \"a\") -> str:\r\r\n    return f\"{prefix}-{uuid.uuid4().hex[:12]}\"\r\r\n\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# Typed values\r\r\n\r\r\nVALUE_TYPES = (\"string\", \"number\", \"boolean\", \"enum\", \"ref\", \"list\", \"map\")\r\r\n\r\r\n\r\r\ndef tv(kind: str, v: Any) -> dict:\r\r\n    if kind not in VALUE_TYPES:\r\r\n        raise ValueError(f\"unknown value type: {kind}\")\r\r\n    return {\"type\": kind, \"v\": v}\r\r\n\r\r\n\r\r\ndef coerce(v: Any) -> dict:\r\r\n    \"\"\"Best-effort TypedValue around a plain value.\"\"\"\r\r\n    if isinstance(v, dict) and v.get(\"type\") in VALUE_TYPES and \"v\" in v:\r\r\n        return v\r\r\n    if isinstance(v, bool):\r\r\n        return tv(\"boolean\", v)\r\r\n    if isinstance(v, (int, float)):\r\r\n        return tv(\"number\", v)\r\r\n    if isinstance(v, (list, tuple)):\r\r\n        return tv(\"list\", list(v))\r\r\n    if isinstance(v, dict):\r\r\n        return tv(\"map\", v)\r\r\n    if v is None:\r\r\n        return tv(\"string\", \"\")\r\r\n    return tv(\"string\", str(v))\r\r\n\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# Claimants — closed vocabulary. An assertion cannot inherit more confidence\r\r\n# than its source provides; ceilings are enforced in ledger.confidence.\r\r\n\r\r\nCLAIMANTS = (\r\r\n    \"principal\",    # the user, via a surface\r\r\n    \"persona:\",     # a persistent personality\r\r\n    \"steward:\",     # background duty acting autonomously\r\r\n    \"model:\",       # inference / decision model output\r\r\n    \"source:\",      # a configured external source\r\r\n    \"surface:\",     # a device/interface surface\r\r\n    \"pipeline:\",    # ingest pipeline\r\r\n    \"engine:\",      # an engine seam (llm, tts, stt, portrait)\r\r\n    \"tool:\",        # tool execution result\r\r\n    \"exchange:\",    # imported exchange material\r\r\n    \"seed:\",        # install-time corpus\r\r\n    \"system\",       # the host itself\r\r\n)\r\r\n\r\r\n\r\r\ndef claimant_ok(c: str) -> bool:\r\r\n    return any(c == p or (p.endswith(\":\") and c.startswith(p))\r\r\n               for p in CLAIMANTS)\r\r\n\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# Basis kinds — the ledger preserves the distinction between captured input,\r\r\n# interpretation, source evidence, generated response, execution evidence,\r\r\n# user choice, durable result, import, refusal.\r\r\n\r\r\nBASIS = (\r\r\n    \"captured-input\",\r\r\n    \"interpretation\",\r\r\n    \"source-evidence\",\r\r\n    \"generated\",\r\r\n    \"execution\",\r\r\n    \"user-choice\",\r\r\n    \"durable-result\",\r\r\n    \"import\",\r\r\n    \"seed\",\r\r\n    \"config\",\r\r\n    \"refusal\",\r\r\n)\r\r\n\r\r\n\r\r\n# ---------------------------------------------------------------------------\r\r\n# Assertion\r\r\n\r\r\n@dataclass\r\r\nclass Assertion:\r\r\n    id: str\r\r\n    at: int\r\r\n    subject: str                # subject key, e.g. \"persona:abc\" / \"need:xyz\"\r\r\n    predicate: str              # \"namespace:name\"\r\r\n    value: dict                 # TypedValue\r\r\n    claimant: str\r\r\n    certainty: float            # 0..1 — truth confidence of this row\r\r\n    applicability: float        # 0..1 — contextual confidence (ranks relevance)\r\r\n    basis: dict                 # {\"kind\": <BASIS>, ...}\r\r\n    supersedes: Optional[str] = None\r\r\n    links: list = field(default_factory=list)   # related assertion ids\r\r\n    tags: list = field(default_factory=list)\r\r\n    meta: dict = field(default_factory=dict)    # operational, non-truth data\r\r\n\r\r\n    def row(self) -> dict:\r\r\n        return asdict(self)\r\r\n\r\r\n    @staticmethod\r\r\n    def from_row(d: dict) -> \"Assertion\":\r\r\n        return Assertion(\r\r\n            id=d[\"id\"], at=d[\"at\"], subject=d[\"subject\"],\r\r\n            predicate=d[\"predicate\"], value=d[\"value\"], claimant=d[\"claimant\"],\r\r\n            certainty=d.get(\"certainty\", 1.0),\r\r\n            applicability=d.get(\"applicability\", 1.0),\r\r\n            basis=d.get(\"basis\", {\"kind\": \"generated\"}),\r\r\n            supersedes=d.get(\"supersedes\"), links=d.get(\"links\", []),\r\r\n            tags=d.get(\"tags\", []), meta=d.get(\"meta\", {}),\r\r\n        )\r\r\n\r\r\n\r\r\ndef assert_that(subject: str, predicate: str, value: Any, claimant: str,\r\r\n                certainty: float = 1.0, applicability: float = 1.0,\r\r\n                basis: Optional[dict] = None, supersedes: Optional[str] = None,\r\r\n                links: Optional[list] = None, tags: Optional[list] = None,\r\r\n                meta: Optional[dict] = None) -> Assertion:\r\r\n    if not claimant_ok(claimant):\r\r\n        raise ValueError(f\"claimant outside closed vocabulary: {claimant}\")\r\r\n    b = basis or {\"kind\": \"generated\"}\r\r\n    if b.get(\"kind\") not in BASIS:\r\r\n        raise ValueError(f\"basis outside closed vocabulary: {b.get('kind')}\")\r\r\n    return Assertion(\r\r\n        id=rid(), at=ms(), subject=subject, predicate=predicate,\r\r\n        value=coerce(value), claimant=claimant,\r\r\n        certainty=max(0.0, min(1.0, float(certainty))),\r\r\n        applicability=max(0.0, min(1.0, float(applicability))),\r\r\n        basis=b, supersedes=supersedes, links=list(links or []),\r\r\n        tags=list(tags or []), meta=dict(meta or {}),\r\r\n    )\r\r\n","newText":"\"\"\"Vantage core model — assertions, typed values, claimants, basis kinds.\nThe assertion ledger is the book of record. Rows are append-only: corrections\nand supersessions are new rows that relate to earlier ones, never silent\nrewrites. Every row carries its source (claimant), typed value, certainty,\ncontextual applicability, basis kind, time, and relationships.\n\"\"\"\nfrom __future__ import annotations\nimport time\nimport uuid\nfrom dataclasses import dataclass, field, asdict\nfrom typing import Any, Optional\ndef ms() -> int:\n    return int(time.time() * 1000)\ndef rid(prefix: str = \"a\") -> str:\n    return f\"{prefix}-{uuid.uuid4().hex[:12]}\"\n# ---------------------------------------------------------------------------\n# Typed values\nVALUE_TYPES = (\"string\", \"number\", \"boolean\", \"enum\", \"ref\", \"list\", \"map\")\ndef tv(kind: str, v: Any) -> dict:\n    if kind not in VALUE_TYPES:\n        raise ValueError(f\"unknown value type: {kind}\")\n    return {\"type\": kind, \"v\": v}\ndef coerce(v: Any) -> dict:\n    \"\"\"Best-effort TypedValue around a plain value.\"\"\"\n    if isinstance(v, dict) and v.get(\"type\") in VALUE_TYPES and \"v\" in v:\n        return v\n    if isinstance(v, bool):\n        return tv(\"boolean\", v)\n    if isinstance(v, (int, float)):\n        return tv(\"number\", v)\n    if isinstance(v, (list, tuple)):\n        return tv(\"list\", list(v))\n    if isinstance(v, dict):\n        return tv(\"map\", v)\n    if v is None:\n        return tv(\"string\", \"\")\n    return tv(\"string\", str(v))\n# ---------------------------------------------------------------------------\n# Claimants — closed vocabulary. An assertion cannot inherit more confidence\n# than its source provides; ceilings are enforced in ledger.confidence.\nCLAIMANTS = (\n    \"principal\",    # the user, via a surface\n    \"persona:\",     # a persistent personality\n    \"steward:\",     # background duty acting autonomously\n    \"model:\",       # inference / decision model output\n    \"source:\",      # a configured external source\n    \"surface:\",     # a device/interface surface\n    \"pipeline:\",    # ingest pipeline\n    \"engine:\",      # an engine seam (llm, tts, stt, portrait)\n    \"tool:\",        # tool execution result\n    \"exchange:\",    # imported exchange material\n    \"seed:\",        # install-time corpus\n    \"system\",       # the host itself\n)\ndef claimant_ok(c: str) -> bool:\n    return any(c == p or (p.endswith(\":\") and c.startswith(p))\n               for p in CLAIMANTS)\n# ---------------------------------------------------------------------------\n# Basis kinds — the ledger preserves the distinction between captured input,\n# interpretation, source evidence, generated response, execution evidence,\n# user choice, durable result, import, refusal.\nBASIS = (\n    \"captured-input\",\n    \"interpretation\",\n    \"source-evidence\",\n    \"generated\",\n    \"execution\",\n    \"user-choice\",\n    \"durable-result\",\n    \"import\",\n    \"seed\",\n    \"config\",\n    \"refusal\",\n)\n# ---------------------------------------------------------------------------\n# Assertion\n@dataclass\nclass Assertion:\n    id: str\n    at: int\n    subject: str                # subject key, e.g. \"persona:abc\" / \"need:xyz\"\n    predicate: str              # \"namespace:name\"\n    value: dict                 # TypedValue\n    claimant: str\n    certainty: float            # 0..1 — truth confidence of this row\n    applicability: float        # 0..1 — contextual confidence (ranks relevance)\n    basis: dict                 # {\"kind\": <BASIS>, ...}\n    supersedes: Optional[str] = None\n    links: list = field(default_factory=list)   # related assertion ids\n    tags: list = field(default_factory=list)\n    meta: dict = field(default_factory=dict)    # operational, non-truth data\n    def row(self) -> dict:\n        return asdict(self)\n    @staticmethod\n    def from_row(d: dict) -> \"Assertion\":\n        return Assertion(\n            id=d[\"id\"], at=d[\"at\"], subject=d[\"subject\"],\n            predicate=d[\"predicate\"], value=d[\"value\"], claimant=d[\"claimant\"],\n            certainty=d.get(\"certainty\", 1.0),\n            applicability=d.get(\"applicability\", 1.0),\n            basis=d.get(\"basis\", {\"kind\": \"generated\"}),\n            supersedes=d.get(\"supersedes\"), links=d.get(\"links\", []),\n            tags=d.get(\"tags\", []), meta=d.get(\"meta\", {}),\n        )\ndef assert_that(subject: str, predicate: str, value: Any, claimant: str,\n                certainty: float = 1.0, applicability: float = 1.0,\n                basis: Optional[dict] = None, supersedes: Optional[str] = None,\n                links: Optional[list] = None, tags: Optional[list] = None,\n                meta: Optional[dict] = None) -> Assertion:\n    if not claimant_ok(claimant):\n        raise ValueError(f\"claimant outside closed vocabulary: {claimant}\")\n    b = basis or {\"kind\": \"generated\"}\n    if b.get(\"kind\") not in BASIS:\n        raise ValueError(f\"basis outside closed vocabulary: {b.get('kind')}\")\n    return Assertion(\n        id=rid(), at=ms(), subject=subject, predicate=predicate,\n        value=coerce(value), claimant=claimant,\n        certainty=max(0.0, min(1.0, float(certainty))),\n        applicability=max(0.0, min(1.0, float(applicability))),\n        basis=b, supersedes=supersedes, links=list(links or []),\n        tags=list(tags or []), meta=dict(meta or {}),\n    )\n","_meta":{"cognition.ai/linesAdded":122,"cognition.ai/linesRemoved":300}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\personas.py","oldText":"\"\"\"Persistent personalities — lenses over the shared ledger, not separate\r\r\nknowledge stores.\r\r\n\r\r\nIdentities live outside the ledger's semantic records (prompt §Continuity):\r\r\n`runtime/personalities.json` holds the roster; `persona:*` assertions give\r\r\nthe ledger view. Mint assigns identity at once, then portrait / voice /\r\r\ncharacterization develop through generated needs.\r\r\n\r\r\nG-B (owner-approved bar 2026-11-23): a persona's voice is a REGISTER\r\r\nCONSTRAINT on truthful output. Factual answers preserve the factual content\r\r\nof their sources; unsupported claims are flagged or withheld, never\r\r\ninvented. The compose path therefore separates FACTS (verbatim source\r\r\nmaterial, cited) from STYLE (register), instructs the engine to use only the\r\r\nfacts, and runs a grounding check on the result — an ungrounded draft is\r\r\nflagged (`persona:fidelity-flag`) and answered honestly instead.\r\r\n\r\r\nR3 shape on record (direction-004 G-C): new personalities start at 0.5\r\r\nheld-confidence under a dyadic relation row `rel:held-confidence`\r\r\n{by: principal, about: persona:<id>, v: 0.5}.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport json\r\r\nimport os\r\r\nimport re\r\r\n\r\r\nfrom . import model, art\r\r\n\r\r\n\r\r\n# -- voice registers -----------------------------------------------------------\r\r\n# A register constrains HOW truth is expressed — never WHAT is claimed.\r\r\n\r\r\nREGISTERS = {\r\r\n    \"clipped\":    \"Telegraphic. Short declaratives. No filler, no pleasantries.\",\r\r\n    \"wry\":        \"Dry wit, understatement, a raised eyebrow — never a sneer.\",\r\r\n    \"warm\":       \"Kind, encouraging, plain-spoken. Address the person directly.\",\r\r\n    \"scholarly\":  \"Precise and measured. Cite what the record says; hedge where \"\r\r\n                  \"the record is thin.\",\r\r\n    \"catalogue\":  \"Enumerate. Ordered, itemized phrasing; one point at a time.\",\r\r\n    \"measured\":   \"Balanced and calm. Weigh both sides before landing.\",\r\r\n    \"expansive\":  \"Generous, curious, associative — but every claim still \"\r\r\n                  \"traces to the record.\",\r\r\n}\r\r\n\r\r\n\r\r\nclass PersonaStore:\r\r\n    def __init__(self, ctx):\r\r\n        self.ctx = ctx\r\r\n        self.path = os.path.join(ctx.runtime, \"personalities.json\")\r\r\n        self.data = {\"personas\": {}, \"order\": [], \"active\": None}\r\r\n        self.load()\r\r\n\r\r\n    # -- persistence ----------------------------------------------------------\r\r\n\r\r\n    def load(self):\r\r\n        if os.path.exists(self.path):\r\r\n            self.data = json.load(open(self.path, encoding=\"utf-8\"))\r\r\n            # J1 discipline: dedupe order, drop entries with no persona\r\r\n            seen, order = set(), []\r\r\n            for pid in self.data.get(\"order\", []):\r\r\n                if pid in self.data[\"personas\"] and pid not in seen:\r\r\n                    order.append(pid)\r\r\n                    seen.add(pid)\r\r\n            for pid in self.data[\"personas\"]:\r\r\n                if pid not in order:\r\r\n                    order.append(pid)\r\r\n            self.data[\"order\"] = order\r\r\n            acts = [p for p in order]\r\r\n            if self.data.get(\"active\") not in acts:\r\r\n                self.data[\"active\"] = order[0] if order else None\r\r\n\r\r\n    def save(self):\r\r\n        tmp = self.path + \".tmp\"\r\r\n        with open(tmp, \"w\", encoding=\"utf-8\") as f:\r\r\n            json.dump(self.data, f, indent=2, ensure_ascii=False)\r\r\n        os.replace(tmp, self.path)\r\r\n\r\r\n    # -- access ----------------------------------------------------------------\r\r\n\r\r\n    def get(self, pid):\r\r\n        return self.data[\"personas\"].get(pid)\r\r\n\r\r\n    def roster(self):\r\r\n        return [self.data[\"personas\"][pid] for pid in self.data[\"order\"]\r\r\n                if pid in self.data[\"personas\"]]\r\r\n\r\r\n    def active(self):\r\r\n        p = self.get(self.data.get(\"active\"))\r\r\n        if not p and self.data[\"order\"]:\r\r\n            p = self.data[\"personas\"][self.data[\"order\"][0]]\r\r\n        return p\r\r\n\r\r\n    # -- roster as an operable control (G-E / R5) --------------------------------\r\r\n\r\r\n    def select(self, pid) -> dict:\r\r\n        \"\"\"Selecting the active personality — every shipped persona reachable.\"\"\"\r\r\n        if pid not in self.data[\"personas\"]:\r\r\n            return {\"ok\": False, \"error\": \"no such persona\"}\r\r\n        self.data[\"active\"] = pid\r\r\n        self.save()\r\r\n        p = self.data[\"personas\"][pid]\r\r\n        self.ctx.ledger.say(\"roster\", \"roster:active\",\r\r\n                            {\"personaId\": pid, \"name\": p[\"name\"]},\r\r\n                            claimant=\"principal\", certainty=1.0,\r\r\n                            basis={\"kind\": \"user-choice\"})\r\r\n        return {\"ok\": True, \"active\": pid, \"name\": p[\"name\"]}\r\r\n\r\r\n    def move(self, pid: str, direction: int) -> dict:\r\r\n        \"\"\"Reorder entries. The order persists in the persona store and is\r\r\n        recorded as a dyadic relation assertion (C-PresenceRoster).\"\"\"\r\r\n        order = self.data[\"order\"]\r\r\n        if pid not in order:\r\r\n            return {\"ok\": False, \"error\": \"no such persona\"}\r\r\n        i = order.index(pid)\r\r\n        j = max(0, min(len(order) - 1, i + int(direction)))\r\r\n        order.insert(j, order.pop(i))\r\r\n        self.save()\r\r\n        for k, q in enumerate(order):\r\r\n            prev = self.ctx.ledger.resolve(\"roster\", f\"roster:rank:{q}\")\r\r\n            self.ctx.ledger.say(\r\r\n                \"roster\", f\"roster:rank:{q}\",\r\r\n                {\"by\": \"principal\", \"about\": f\"persona:{q}\", \"rank\": k},\r\r\n                claimant=\"principal\", certainty=1.0,\r\r\n                basis={\"kind\": \"user-choice\"},\r\r\n                supersedes=prev.id if prev else None)\r\r\n        return {\"ok\": True, \"order\": order}\r\r\n\r\r\n    # -- mint --------------------------------------------------------------------\r\r\n\r\r\n    def mint(self, name: str, traits=None, interests=None, lens=None,\r\r\n             figure=None, responsibilities=None) -> dict:\r\r\n        ctx = self.ctx\r\r\n        pid = model.rid(\"persona\")\r\r\n        lens = dict(lens or {})\r\r\n        register = lens.get(\"register\") or _register_for(name)\r\r\n        lens.setdefault(\"style\", register)\r\r\n\r\r\n        # -- ethics gate: recognizable figures carry a permanent mark + the\r\r\n        # user is admonished (prompt §Personalities; C-EthicsGate underneath)\r\r\n        mark, admonish, gate = False, None, {\"verdict\": \"original-persona\"}\r\r\n        if figure:\r\r\n            gate = ctx.ethics_gate(figure)\r\r\n            if gate[\"verdict\"] == \"refused\":\r\r\n                ctx.ledger.say(f\"persona:{pid}\", \"persona:mint-refused\",\r\r\n                               {\"name\": name, \"figure\": figure,\r\r\n                                \"reason\": gate[\"reason\"]},\r\r\n                               claimant=\"system\", certainty=1.0,\r\r\n                               basis={\"kind\": \"refusal\"})\r\r\n                return {\"ok\": False, \"refused\": True,\r\r\n                        \"reason\": gate[\"reason\"], \"gate\": gate}\r\r\n            mark = gate[\"verdict\"] in (\"mark-required\", \"admonish-required\")\r\r\n            admonish = gate.get(\"admonishment\")\r\r\n\r\r\n        p = {\r\r\n            \"id\": pid, \"name\": name,\r\r\n            \"traits\": list(traits or [\"curious\"]),\r\r\n            \"interests\": list(interests or []),\r\r\n            \"responsibilities\": list(responsibilities or [\"respond\"]),\r\r\n            \"lens\": lens, \"register\": register,\r\r\n            \"figure\": figure, \"mark\": mark,\r\r\n            \"voice\": _assign_voice(ctx, len(self.data[\"order\"])),\r\r\n            \"color\": _color_for(pid),\r\r\n            \"frame\": \"respondent\",\r\r\n            \"created\": model.ms(),\r\r\n        }\r\r\n        self.data[\"personas\"][pid] = p\r\r\n        self.data[\"order\"].append(pid)\r\r\n        if not self.data[\"active\"]:\r\r\n            self.data[\"active\"] = pid\r\r\n        self.save()\r\r\n\r\r\n        subj = f\"persona:{pid}\"\r\r\n        ctx.ledger.say(subj, \"persona:profile\", p, claimant=\"system\",\r\r\n                       certainty=1.0, basis={\"kind\": \"durable-result\"})\r\r\n        ctx.ledger.say(\"roster\", \"roster:joined\",\r\r\n                       {\"personaId\": pid, \"name\": name, \"mark\": mark},\r\r\n                       claimant=\"system\", certainty=1.0,\r\r\n                       basis={\"kind\": \"durable-result\"})\r\r\n        # R3 recorded shape: held-confidence starts at 0.5, expressed as a\r\r\n        # dyadic relation (held BY the principal ABOUT the persona).\r\r\n        ctx.ledger.say(\"roster\", f\"rel:held-confidence:{pid}\",\r\r\n                       {\"by\": \"principal\", \"about\": f\"persona:{pid}\",\r\r\n                        \"v\": 0.5, \"kind\": \"dyadic-confidence\"},\r\r\n                       claimant=\"system\", certainty=1.0,\r\r\n                       basis={\"kind\": \"config\"})\r\r\n        if mark:\r\r\n            ctx.ledger.say(subj, \"persona:imitation-mark\",\r\r\n                           {\"mark\": \"◆ IMITATION\", \"figure\": figure,\r\r\n                            \"permanent\": True},\r\r\n                           claimant=\"system\", certainty=1.0,\r\r\n                           basis={\"kind\": \"config\"})\r\r\n        return {\"ok\": True, \"personaId\": pid, \"name\": name, \"mark\": mark,\r\r\n                \"admonishment\": admonish, \"gate\": gate}\r\r\n\r\r\n    def update(self, pid: str, patch: dict) -> dict:\r\r\n        \"\"\"Personality editor path — every customizable element asserted.\"\"\"\r\r\n        p = self.get(pid)\r\r\n        if not p:\r\r\n            return {\"ok\": False, \"error\": \"no such persona\"}\r\r\n        for k in (\"name\", \"traits\", \"interests\", \"responsibilities\",\r\r\n                  \"color\", \"frame\"):\r\r\n            if k in patch:\r\r\n                p[k] = patch[k]\r\r\n        if \"register\" in patch:\r\r\n            p[\"register\"] = patch[\"register\"]\r\r\n            p.setdefault(\"lens\", {})[\"register\"] = patch[\"register\"]\r\r\n        if \"lens\" in patch and isinstance(patch[\"lens\"], dict):\r\r\n            p[\"lens\"].update(patch[\"lens\"])\r\r\n        if \"voice\" in patch and isinstance(patch[\"voice\"], dict):\r\r\n            p[\"voice\"].update(patch[\"voice\"])\r\r\n        self.save()\r\r\n        prev = self.ctx.ledger.resolve(f\"persona:{pid}\", \"persona:profile\")\r\r\n        self.ctx.ledger.say(f\"persona:{pid}\", \"persona:profile\", p,\r\r\n                            claimant=\"principal\", certainty=1.0,\r\r\n                            basis={\"kind\": \"user-choice\"},\r\r\n                            supersedes=prev.id if prev else None)\r\r\n        return {\"ok\": True, \"persona\": p}\r\r\n\r\r\n    def held_confidence(self, pid) -> float:\r\r\n        a = self.ctx.ledger.resolve(\"roster\", f\"rel:held-confidence:{pid}\")\r\r\n        if a:\r\r\n            v = a.value.get(\"v\") or {}\r\r\n            return float(v.get(\"v\", 0.5))\r\r\n        return 0.5\r\r\n\r\r\n    def set_held_confidence(self, pid: str, v: float):\r\r\n        prev = self.ctx.ledger.resolve(\"roster\", f\"rel:held-confidence:{pid}\")\r\r\n        self.ctx.ledger.say(\r\r\n            \"roster\", f\"rel:held-confidence:{pid}\",\r\r\n            {\"by\": \"principal\", \"about\": f\"persona:{pid}\",\r\r\n             \"v\": max(0.0, min(1.0, v)), \"kind\": \"dyadic-confidence\"},\r\r\n            claimant=\"principal\", certainty=1.0,\r\r\n            basis={\"kind\": \"user-choice\"},\r\r\n            supersedes=prev.id if prev else None)\r\r\n\r\r\n\r\r\n# -- mint helpers -----------------------------------------------------------------\r\r\n\r\r\ndef _register_for(name: str) -> str:\r\r\n    keys = sorted(REGISTERS)\r\r\n    return keys[sum(map(ord, name)) % len(keys)]\r\r\n\r\r\n\r\r\ndef _color_for(pid: str) -> str:\r\r\n    hues = [\"#e63946\", \"#f4a261\", \"#e9c46a\", \"#2a9d8f\", \"#457b9d\",\r\r\n            \"#8d6fc0\", \"#ef8354\", \"#6b9e78\", \"#d1495b\", \"#936639\"]\r\r\n    return hues[sum(map(ord, pid)) % len(hues)]\r\r\n\r\r\n\r\r\ndef _assign_voice(ctx, n: int) -> dict:\r\r\n    voices = ctx.engines.tts.voices or []\r\r\n    return {\"name\": voices[n % len(voices)] if voices else None,\r\r\n            \"rate\": [0, -1, 1, 0, -2, 2][n % 6],\r\r\n            \"engine\": ctx.engines.tts.mode}\r\r\n\r\r\n\r\r\n# -- composition --------------------------------------------------------------------\r\r\n\r\r\ndef compose(ctx, persona: dict, prompt_text: str, facts: list = None,\r\r\n            history: str = \"\", react_to: str = \"\") -> dict:\r\r\n    \"\"\"Produce one persona reply.\r\r\n\r\r\n    `facts` is a list of {\"text\",\"source\"} — verbatim source material the\r\r\n    answer may use. With facts present, the engine is instructed to draw on\r\r\n    them ONLY; the draft then passes a grounding check. Without facts the\r\r\n    persona speaks conversationally in register — opinion and voice, not\r\r\n    fabricated fact.\r\r\n\r\r\n    Returns {ok, text, register, engine, fidelity, flagged}.\r\r\n    \"\"\"\r\r\n    reg = persona.get(\"register\") or \"measured\"\r\r\n    style = REGISTERS.get(reg, REGISTERS[\"measured\"])\r\r\n    facts = facts or []\r\r\n\r\r\n    system = (\r\r\n        f\"You are {persona['name']}, a persona in a local-first assistant. \"\r\r\n        f\"Voice register: {reg} — {style} \"\r\r\n        f\"Traits: {', '.join(persona.get('traits', []))}. \"\r\r\n        f\"Interests: {', '.join(persona.get('interests', []))}. \"\r\r\n    )\r\r\n    if facts:\r\r\n        system += (\r\r\n            \"FIDELITY RULE — a register is a style constraint, never a \"\r\r\n            \"license to invent. Answer using ONLY the facts in FACTS below. \"\r\r\n            \"Do not add names, dates, numbers, or claims that are not in \"\r\r\n            \"FACTS. If FACTS do not answer the question, say plainly (in \"\r\r\n            \"your register) what is not on record. Keep it under 120 words.\\n\"\r\r\n            \"FACTS:\\n\" + \"\\n\".join(\r\r\n                f\"- [{f.get('source','record')}] {f['text']}\" for f in facts))\r\r\n    else:\r\r\n        system += (\r\r\n            \"You have no source facts for this turn: speak from persona — \"\r\r\n            \"opinion, taste, encouragement — and make no factual claims you \"\r\r\n            \"cannot ground. Under 100 words.\")\r\r\n\r\r\n    user = prompt_text\r\r\n    if history:\r\r\n        user = f\"Conversation so far:\\n{history}\\n\\nNew input: {prompt_text}\"\r\r\n    if react_to:\r\r\n        user += (f\"\\n\\nEarlier contribution to react to (one sentence, \"\r\r\n                 f\"in register): {react_to}\")\r\r\n\r\r\n    r = ctx.engines.llm.chat(system, user, max_tokens=180)\r\r\n    if r.get(\"ok\") and r.get(\"text\"):\r\r\n        text = _clean(r[\"text\"])\r\r\n        fidelity = _grounding(text, facts) if facts else {\"grounded\": True}\r\r\n        if facts and not fidelity[\"grounded\"]:\r\r\n            ctx.ledger.say(f\"persona:{persona['id']}\",\r\r\n                           \"persona:fidelity-flag\",\r\r\n                           {\"draft\": text[:300], \"issues\": fidelity[\"issues\"],\r\r\n                            \"prompt\": prompt_text[:200]},\r\r\n                           claimant=\"model:\" + ctx.engines.llm.model,\r\r\n                           certainty=0.9, basis={\"kind\": \"interpretation\"})\r\r\n            # withhold the ungrounded draft — answer honestly in register\r\r\n            text = _withhold_in_register(reg, facts)\r\r\n            fidelity = {\"grounded\": True, \"withheld\": True,\r\r\n                        \"issues\": fidelity[\"issues\"]}\r\r\n        return {\"ok\": True, \"text\": text, \"register\": reg,\r\r\n                \"engine\": r[\"engine\"], \"fidelity\": fidelity}\r\r\n\r\r\n    # declared fallback — faithful by construction: only facts may appear.\r\r\n    text = _template_reply(persona, prompt_text, facts, react_to)\r\r\n    return {\"ok\": True, \"text\": text, \"register\": reg,\r\r\n            \"engine\": \"declared-template\",\r\r\n            \"fidelity\": {\"grounded\": True, \"engine\": \"template\"},\r\r\n            \"fallbackError\": r.get(\"error\")}\r\r\n\r\r\n\r\r\ndef _clean(text: str) -> str:\r\r\n    t = text.strip()\r\r\n    if t.startswith('\"') and t.endswith('\"'):\r\r\n        t = t[1:-1]\r\r\n    return re.sub(r\"\\s+\\n\", \"\\n\", t).strip()\r\r\n\r\r\n\r\r\ndef _grounding(text: str, facts: list) -> dict:\r\r\n    \"\"\"Cheap grounding check: numbers and capitalized multi-token entities in\r\r\n    the reply must appear in FACTS. Single common words are ignored.\"\"\"\r\r\n    if not facts:\r\r\n        return {\"grounded\": True}\r\r\n    hay = \" \".join(f[\"text\"] for f in facts)\r\r\n    issues = []\r\r\n    for num in re.findall(r\"\\b\\d[\\d,\\.%]*\\b\", text):\r\r\n        if num.strip(\",.%\") and num not in hay and \\\r\r\n                num.strip(\",.%\") not in hay:\r\r\n            issues.append(f\"ungrounded-number:{num}\")\r\r\n    for ent in re.findall(r\"\\b(?:[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)+)\\b\", text):\r\r\n        if ent not in hay and not ent.startswith((\"The \", \"I \", \"A \")):\r\r\n            issues.append(f\"ungrounded-entity:{ent}\")\r\r\n    return {\"grounded\": not issues, \"issues\": issues[:6]}\r\r\n\r\r\n\r\r\ndef _withhold_in_register(reg: str, facts: list) -> str:\r\r\n    \"\"\"Honest answer when the draft can't be grounded — flagged, withheld.\"\"\"\r\r\n    have = \"; \".join(f[\"text\"][:120] for f in facts[:2])\r\r\n    forms = {\r\r\n        \"clipped\": f\"Can't back it. On record: {have}.\",\r\r\n        \"wry\": f\"I'd love to improvise, but the record only gives me: {have}.\",\r\r\n        \"warm\": f\"I don't want to guess at this — what I do have is: {have}.\",\r\r\n        \"scholarly\": f\"The record supports only: {have}. Beyond that I \"\r\r\n                     f\"cannot speak with confidence.\",\r\r\n        \"catalogue\": f\"On record: (1) {have}. Nothing further supported.\",\r\r\n        \"expansive\": f\"Here's what the record actually holds: {have} — \"\r\r\n                     f\"the rest I'd only be inventing.\",\r\r\n    }\r\r\n    return forms.get(reg, f\"What I can verify: {have}.\")\r\r\n\r\r\n\r\r\ndef _template_reply(persona, prompt_text, facts, react_to=\"\") -> str:\r\r\n    reg = persona.get(\"register\") or \"measured\"\r\r\n    name = persona[\"name\"]\r\r\n    core = \"; \".join(f[\"text\"][:140] for f in facts[:3]) if facts else None\r\r\n    if react_to:\r\r\n        base = {\r\r\n            \"clipped\": f\"Noted. {react_to[:80]} — fair point.\",\r\r\n            \"wry\": f\"Well, {react_to[:60]}… hard to argue with that.\",\r\r\n            \"warm\": f\"I love where that lands — {react_to[:80]}.\",\r\r\n            \"scholarly\": f\"As stated: {react_to[:80]}. I'd concur.\",\r\r\n            \"catalogue\": f\"On that contribution: {react_to[:80]}. Noted.\",\r\r\n            \"expansive\": f\"Oh, that sparks something — {react_to[:80]}.\",\r\r\n        }.get(reg, f\"On that: {react_to[:80]}.\")\r\r\n        return base\r\r\n    if core:\r\r\n        forms = {\r\r\n            \"clipped\": f\"{core}.\",\r\r\n            \"wry\": f\"Since you ask: {core}. Thrilling, I know.\",\r\r\n            \"warm\": f\"Here's what I found for you — {core}.\",\r\r\n            \"scholarly\": f\"Per the record: {core}.\",\r\r\n            \"catalogue\": f\"Findings: 1) {core}.\",\r\r\n            \"expansive\": f\"There's rather a lot here — {core} — and it \"\r\r\n                         f\"rewards a closer look.\",\r\r\n            \"measured\": f\"As I read the record: {core}.\",\r\r\n        }\r\r\n        return forms.get(reg, f\"{core}.\")\r\r\n    forms = {\r\r\n        \"clipped\": f\"{name} here. Say more — I'll keep it short.\",\r\r\n        \"wry\": f\"{name}, at your service. Do go on — I'm riveted.\",\r\r\n        \"warm\": f\"{name} here — glad you're asking. Tell me more?\",\r\r\n        \"scholarly\": f\"{name}. I'll need more to go on before I can \"\r\r\n                     f\"speak with confidence.\",\r\r\n        \"catalogue\": f\"{name}, present. State your need — I'll itemize.\",\r\r\n        \"expansive\": f\"{name} — oh, do tell me everything.\",\r\r\n        \"measured\": f\"{name} here. What's on your mind?\",\r\r\n    }\r\r\n    return forms.get(reg, f\"{name} here.\")\r\r\n","newText":"\"\"\"Persistent personalities — lenses over the shared ledger, not separate\nknowledge stores.\nIdentities live outside the ledger's semantic records (prompt §Continuity):\n`runtime/personalities.json` holds the roster; `persona:*` assertions give\nthe ledger view. Mint assigns identity at once, then portrait / voice /\ncharacterization develop through generated needs.\nG-B (owner-approved bar 2026-11-23): a persona's voice is a REGISTER\nCONSTRAINT on truthful output. Factual answers preserve the factual content\nof their sources; unsupported claims are flagged or withheld, never\ninvented. The compose path therefore separates FACTS (verbatim source\nmaterial, cited) from STYLE (register), instructs the engine to use only the\nfacts, and runs a grounding check on the result — an ungrounded draft is\nflagged (`persona:fidelity-flag`) and answered honestly instead.\nR3 shape on record (direction-004 G-C): new personalities start at 0.5\nheld-confidence under a dyadic relation row `rel:held-confidence`\n{by: principal, about: persona:<id>, v: 0.5}.\n\"\"\"\nfrom __future__ import annotations\nimport json\nimport os\nimport re\nfrom . import model, art\n# -- voice registers -----------------------------------------------------------\n# A register constrains HOW truth is expressed — never WHAT is claimed.\nREGISTERS = {\n    \"clipped\":    \"Telegraphic. Short declaratives. No filler, no pleasantries.\",\n    \"wry\":        \"Dry wit, understatement, a raised eyebrow — never a sneer.\",\n    \"warm\":       \"Kind, encouraging, plain-spoken. Address the person directly.\",\n    \"scholarly\":  \"Precise and measured. Cite what the record says; hedge where \"\n                  \"the record is thin.\",\n    \"catalogue\":  \"Enumerate. Ordered, itemized phrasing; one point at a time.\",\n    \"measured\":   \"Balanced and calm. Weigh both sides before landing.\",\n    \"expansive\":  \"Generous, curious, associative — but every claim still \"\n                  \"traces to the record.\",\n}\nclass PersonaStore:\n    def __init__(self, ctx):\n        self.ctx = ctx\n        self.path = os.path.join(ctx.runtime, \"personalities.json\")\n        self.data = {\"personas\": {}, \"order\": [], \"active\": None}\n        self.load()\n    # -- persistence ----------------------------------------------------------\n    def load(self):\n        if os.path.exists(self.path):\n            self.data = json.load(open(self.path, encoding=\"utf-8\"))\n            # J1 discipline: dedupe order, drop entries with no persona\n            seen, order = set(), []\n            for pid in self.data.get(\"order\", []):\n                if pid in self.data[\"personas\"] and pid not in seen:\n                    order.append(pid)\n                    seen.add(pid)\n            for pid in self.data[\"personas\"]:\n                if pid not in order:\n                    order.append(pid)\n            self.data[\"order\"] = order\n            acts = [p for p in order]\n            if self.data.get(\"active\") not in acts:\n                self.data[\"active\"] = order[0] if order else None\n    def save(self):\n        tmp = self.path + \".tmp\"\n        with open(tmp, \"w\", encoding=\"utf-8\") as f:\n            json.dump(self.data, f, indent=2, ensure_ascii=False)\n        os.replace(tmp, self.path)\n    # -- access ----------------------------------------------------------------\n    def get(self, pid):\n        return self.data[\"personas\"].get(pid)\n    def roster(self):\n        return [self.data[\"personas\"][pid] for pid in self.data[\"order\"]\n                if pid in self.data[\"personas\"]]\n    def active(self):\n        p = self.get(self.data.get(\"active\"))\n        if not p and self.data[\"order\"]:\n            p = self.data[\"personas\"][self.data[\"order\"][0]]\n        return p\n    # -- roster as an operable control (G-E / R5) --------------------------------\n    def select(self, pid) -> dict:\n        \"\"\"Selecting the active personality — every shipped persona reachable.\"\"\"\n        if pid not in self.data[\"personas\"]:\n            return {\"ok\": False, \"error\": \"no such persona\"}\n        self.data[\"active\"] = pid\n        self.save()\n        p = self.data[\"personas\"][pid]\n        self.ctx.ledger.say(\"roster\", \"roster:active\",\n                            {\"personaId\": pid, \"name\": p[\"name\"]},\n                            claimant=\"principal\", certainty=1.0,\n                            basis={\"kind\": \"user-choice\"})\n        return {\"ok\": True, \"active\": pid, \"name\": p[\"name\"]}\n    def move(self, pid: str, direction: int) -> dict:\n        \"\"\"Reorder entries. The order persists in the persona store and is\n        recorded as a dyadic relation assertion (C-PresenceRoster).\"\"\"\n        order = self.data[\"order\"]\n        if pid not in order:\n            return {\"ok\": False, \"error\": \"no such persona\"}\n        i = order.index(pid)\n        j = max(0, min(len(order) - 1, i + int(direction)))\n        order.insert(j, order.pop(i))\n        self.save()\n        for k, q in enumerate(order):\n            prev = self.ctx.ledger.resolve(\"roster\", f\"roster:rank:{q}\")\n            self.ctx.ledger.say(\n                \"roster\", f\"roster:rank:{q}\",\n                {\"by\": \"principal\", \"about\": f\"persona:{q}\", \"rank\": k},\n                claimant=\"principal\", certainty=1.0,\n                basis={\"kind\": \"user-choice\"},\n                supersedes=prev.id if prev else None)\n        return {\"ok\": True, \"order\": order}\n    # -- mint --------------------------------------------------------------------\n    def mint(self, name: str, traits=None, interests=None, lens=None,\n             figure=None, responsibilities=None) -> dict:\n        ctx = self.ctx\n        pid = model.rid(\"persona\")\n        lens = dict(lens or {})\n        register = lens.get(\"register\") or _register_for(name)\n        lens.setdefault(\"style\", register)\n        # -- ethics gate: recognizable figures carry a permanent mark + the\n        # user is admonished (prompt §Personalities; C-EthicsGate underneath)\n        mark, admonish, gate = False, None, {\"verdict\": \"original-persona\"}\n        if figure:\n            gate = ctx.ethics_gate(figure)\n            if gate[\"verdict\"] == \"refused\":\n                ctx.ledger.say(f\"persona:{pid}\", \"persona:mint-refused\",\n                               {\"name\": name, \"figure\": figure,\n                                \"reason\": gate[\"reason\"]},\n                               claimant=\"system\", certainty=1.0,\n                               basis={\"kind\": \"refusal\"})\n                return {\"ok\": False, \"refused\": True,\n                        \"reason\": gate[\"reason\"], \"gate\": gate}\n            mark = gate[\"verdict\"] in (\"mark-required\", \"admonish-required\")\n            admonish = gate.get(\"admonishment\")\n        p = {\n            \"id\": pid, \"name\": name,\n            \"traits\": list(traits or [\"curious\"]),\n            \"interests\": list(interests or []),\n            \"responsibilities\": list(responsibilities or [\"respond\"]),\n            \"lens\": lens, \"register\": register,\n            \"figure\": figure, \"mark\": mark,\n            \"voice\": _assign_voice(ctx, len(self.data[\"order\"])),\n            \"color\": _color_for(pid),\n            \"frame\": \"respondent\",\n            \"created\": model.ms(),\n        }\n        self.data[\"personas\"][pid] = p\n        self.data[\"order\"].append(pid)\n        if not self.data[\"active\"]:\n            self.data[\"active\"] = pid\n        self.save()\n        subj = f\"persona:{pid}\"\n        ctx.ledger.say(subj, \"persona:profile\", p, claimant=\"system\",\n                       certainty=1.0, basis={\"kind\": \"durable-result\"})\n        ctx.ledger.say(\"roster\", \"roster:joined\",\n                       {\"personaId\": pid, \"name\": name, \"mark\": mark},\n                       claimant=\"system\", certainty=1.0,\n                       basis={\"kind\": \"durable-result\"})\n        # R3 recorded shape: held-confidence starts at 0.5, expressed as a\n        # dyadic relation (held BY the principal ABOUT the persona).\n        ctx.ledger.say(\"roster\", f\"rel:held-confidence:{pid}\",\n                       {\"by\": \"principal\", \"about\": f\"persona:{pid}\",\n                        \"v\": 0.5, \"kind\": \"dyadic-confidence\"},\n                       claimant=\"system\", certainty=1.0,\n                       basis={\"kind\": \"config\"})\n        if mark:\n            ctx.ledger.say(subj, \"persona:imitation-mark\",\n                           {\"mark\": \"◆ IMITATION\", \"figure\": figure,\n                            \"permanent\": True},\n                           claimant=\"system\", certainty=1.0,\n                           basis={\"kind\": \"config\"})\n        return {\"ok\": True, \"personaId\": pid, \"name\": name, \"mark\": mark,\n                \"admonishment\": admonish, \"gate\": gate}\n    def update(self, pid: str, patch: dict) -> dict:\n        \"\"\"Personality editor path — every customizable element asserted.\"\"\"\n        p = self.get(pid)\n        if not p:\n            return {\"ok\": False, \"error\": \"no such persona\"}\n        for k in (\"name\", \"traits\", \"interests\", \"responsibilities\",\n                  \"color\", \"frame\"):\n            if k in patch:\n                p[k] = patch[k]\n        if \"register\" in patch:\n            p[\"register\"] = patch[\"register\"]\n            p.setdefault(\"lens\", {})[\"register\"] = patch[\"register\"]\n        if \"lens\" in patch and isinstance(patch[\"lens\"], dict):\n            p[\"lens\"].update(patch[\"lens\"])\n        if \"voice\" in patch and isinstance(patch[\"voice\"], dict):\n            p[\"voice\"].update(patch[\"voice\"])\n        self.save()\n        prev = self.ctx.ledger.resolve(f\"persona:{pid}\", \"persona:profile\")\n        self.ctx.ledger.say(f\"persona:{pid}\", \"persona:profile\", p,\n                            claimant=\"principal\", certainty=1.0,\n                            basis={\"kind\": \"user-choice\"},\n                            supersedes=prev.id if prev else None)\n        return {\"ok\": True, \"persona\": p}\n    def held_confidence(self, pid) -> float:\n        a = self.ctx.ledger.resolve(\"roster\", f\"rel:held-confidence:{pid}\")\n        if a:\n            v = a.value.get(\"v\") or {}\n            return float(v.get(\"v\", 0.5))\n        return 0.5\n    def set_held_confidence(self, pid: str, v: float):\n        prev = self.ctx.ledger.resolve(\"roster\", f\"rel:held-confidence:{pid}\")\n        self.ctx.ledger.say(\n            \"roster\", f\"rel:held-confidence:{pid}\",\n            {\"by\": \"principal\", \"about\": f\"persona:{pid}\",\n             \"v\": max(0.0, min(1.0, v)), \"kind\": \"dyadic-confidence\"},\n            claimant=\"principal\", certainty=1.0,\n            basis={\"kind\": \"user-choice\"},\n            supersedes=prev.id if prev else None)\n# -- mint helpers -----------------------------------------------------------------\ndef _register_for(name: str) -> str:\n    keys = sorted(REGISTERS)\n    return keys[sum(map(ord, name)) % len(keys)]\ndef _color_for(pid: str) -> str:\n    hues = [\"#e63946\", \"#f4a261\", \"#e9c46a\", \"#2a9d8f\", \"#457b9d\",\n            \"#8d6fc0\", \"#ef8354\", \"#6b9e78\", \"#d1495b\", \"#936639\"]\n    return hues[sum(map(ord, pid)) % len(hues)]\ndef _assign_voice(ctx, n: int) -> dict:\n    voices = ctx.engines.tts.voices or []\n    return {\"name\": voices[n % len(voices)] if voices else None,\n            \"rate\": [0, -1, 1, 0, -2, 2][n % 6],\n            \"engine\": ctx.engines.tts.mode}\n# -- composition --------------------------------------------------------------------\ndef compose(ctx, persona: dict, prompt_text: str, facts: list = None,\n            history: str = \"\", react_to: str = \"\") -> dict:\n    \"\"\"Produce one persona reply.\n    `facts` is a list of {\"text\",\"source\"} — verbatim source material the\n    answer may use. With facts present, the engine is instructed to draw on\n    them ONLY; the draft then passes a grounding check. Without facts the\n    persona speaks conversationally in register — opinion and voice, not\n    fabricated fact.\n    Returns {ok, text, register, engine, fidelity, flagged}.\n    \"\"\"\n    reg = persona.get(\"register\") or \"measured\"\n    style = REGISTERS.get(reg, REGISTERS[\"measured\"])\n    facts = facts or []\n    system = (\n        f\"You are {persona['name']}, a persona in a local-first assistant. \"\n        f\"Voice register: {reg} — {style} \"\n        f\"Traits: {', '.join(persona.get('traits', []))}. \"\n        f\"Interests: {', '.join(persona.get('interests', []))}. \"\n    )\n    if facts:\n        system += (\n            \"FIDELITY RULE — a register is a style constraint, never a \"\n            \"license to invent. Answer using ONLY the facts in FACTS below. \"\n            \"Do not add names, dates, numbers, or claims that are not in \"\n            \"FACTS. If FACTS do not answer the question, say plainly (in \"\n            \"your register) what is not on record. Keep it under 120 words.\\n\"\n            \"FACTS:\\n\" + \"\\n\".join(\n                f\"- [{f.get('source','record')}] {f['text']}\" for f in facts))\n    else:\n        system += (\n            \"You have no source facts for this turn: speak from persona — \"\n            \"opinion, taste, encouragement — and make no factual claims you \"\n            \"cannot ground. Under 100 words.\")\n    user = prompt_text\n    if history:\n        user = f\"Conversation so far:\\n{history}\\n\\nNew input: {prompt_text}\"\n    if react_to:\n        user += (f\"\\n\\nEarlier contribution to react to (one sentence, \"\n                 f\"in register): {react_to}\")\n    r = ctx.engines.llm.chat(system, user, max_tokens=180)\n    if r.get(\"ok\") and r.get(\"text\"):\n        text = _clean(r[\"text\"])\n        fidelity = _grounding(text, facts) if facts else {\"grounded\": True}\n        if facts and not fidelity[\"grounded\"]:\n            ctx.ledger.say(f\"persona:{persona['id']}\",\n                           \"persona:fidelity-flag\",\n                           {\"draft\": text[:300], \"issues\": fidelity[\"issues\"],\n                            \"prompt\": prompt_text[:200]},\n                           claimant=\"model:\" + ctx.engines.llm.model,\n                           certainty=0.9, basis={\"kind\": \"interpretation\"})\n            # withhold the ungrounded draft — answer honestly in register\n            text = _withhold_in_register(reg, facts)\n            fidelity = {\"grounded\": True, \"withheld\": True,\n                        \"issues\": fidelity[\"issues\"]}\n        return {\"ok\": True, \"text\": text, \"register\": reg,\n                \"engine\": r[\"engine\"], \"fidelity\": fidelity}\n    # declared fallback — faithful by construction: only facts may appear.\n    text = _template_reply(persona, prompt_text, facts, react_to)\n    return {\"ok\": True, \"text\": text, \"register\": reg,\n            \"engine\": \"declared-template\",\n            \"fidelity\": {\"grounded\": True, \"engine\": \"template\"},\n            \"fallbackError\": r.get(\"error\")}\ndef _clean(text: str) -> str:\n    t = text.strip()\n    if t.startswith('\"') and t.endswith('\"'):\n        t = t[1:-1]\n    return re.sub(r\"\\s+\\n\", \"\\n\", t).strip()\ndef _grounding(text: str, facts: list) -> dict:\n    \"\"\"Cheap grounding check: numbers and capitalized multi-token entities in\n    the reply must appear in FACTS. Single common words are ignored.\"\"\"\n    if not facts:\n        return {\"grounded\": True}\n    hay = \" \".join(f[\"text\"] for f in facts)\n    issues = []\n    for num in re.findall(r\"\\b\\d[\\d,\\.%]*\\b\", text):\n        if num.strip(\",.%\") and num not in hay and \\\n                num.strip(\",.%\") not in hay:\n            issues.append(f\"ungrounded-number:{num}\")\n    for ent in re.findall(r\"\\b(?:[A-Z][a-z]+(?:\\s+[A-Z][a-z]+)+)\\b\", text):\n        if ent not in hay and not ent.startswith((\"The \", \"I \", \"A \")):\n            issues.append(f\"ungrounded-entity:{ent}\")\n    return {\"grounded\": not issues, \"issues\": issues[:6]}\ndef _withhold_in_register(reg: str, facts: list) -> str:\n    \"\"\"Honest answer when the draft can't be grounded — flagged, withheld.\"\"\"\n    have = \"; \".join(f[\"text\"][:120] for f in facts[:2])\n    forms = {\n        \"clipped\": f\"Can't back it. On record: {have}.\",\n        \"wry\": f\"I'd love to improvise, but the record only gives me: {have}.\",\n        \"warm\": f\"I don't want to guess at this — what I do have is: {have}.\",\n        \"scholarly\": f\"The record supports only: {have}. Beyond that I \"\n                     f\"cannot speak with confidence.\",\n        \"catalogue\": f\"On record: (1) {have}. Nothing further supported.\",\n        \"expansive\": f\"Here's what the record actually holds: {have} — \"\n                     f\"the rest I'd only be inventing.\",\n    }\n    return forms.get(reg, f\"What I can verify: {have}.\")\ndef _template_reply(persona, prompt_text, facts, react_to=\"\") -> str:\n    reg = persona.get(\"register\") or \"measured\"\n    name = persona[\"name\"]\n    core = \"; \".join(f[\"text\"][:140] for f in facts[:3]) if facts else None\n    if react_to:\n        base = {\n            \"clipped\": f\"Noted. {react_to[:80]} — fair point.\",\n            \"wry\": f\"Well, {react_to[:60]}… hard to argue with that.\",\n            \"warm\": f\"I love where that lands — {react_to[:80]}.\",\n            \"scholarly\": f\"As stated: {react_to[:80]}. I'd concur.\",\n            \"catalogue\": f\"On that contribution: {react_to[:80]}. Noted.\",\n            \"expansive\": f\"Oh, that sparks something — {react_to[:80]}.\",\n        }.get(reg, f\"On that: {react_to[:80]}.\")\n        return base\n    if core:\n        forms = {\n            \"clipped\": f\"{core}.\",\n            \"wry\": f\"Since you ask: {core}. Thrilling, I know.\",\n            \"warm\": f\"Here's what I found for you — {core}.\",\n            \"scholarly\": f\"Per the record: {core}.\",\n            \"catalogue\": f\"Findings: 1) {core}.\",\n            \"expansive\": f\"There's rather a lot here — {core} — and it \"\n                         f\"rewards a closer look.\",\n            \"measured\": f\"As I read the record: {core}.\",\n        }\n        return forms.get(reg, f\"{core}.\")\n    forms = {\n        \"clipped\": f\"{name} here. Say more — I'll keep it short.\",\n        \"wry\": f\"{name}, at your service. Do go on — I'm riveted.\",\n        \"warm\": f\"{name} here — glad you're asking. Tell me more?\",\n        \"scholarly\": f\"{name}. I'll need more to go on before I can \"\n                     f\"speak with confidence.\",\n        \"catalogue\": f\"{name}, present. State your need — I'll itemize.\",\n        \"expansive\": f\"{name} — oh, do tell me everything.\",\n        \"measured\": f\"{name} here. What's on your mind?\",\n    }\n    return forms.get(reg, f\"{name} here.\")\n","_meta":{"cognition.ai/linesAdded":353,"cognition.ai/linesRemoved":810}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\setbuild.py","oldText":"\"\"\"Set fulfillment (C-SetBuild / C-SpecializedListRetrieval).\r\r\n\r\r\nGeographic set answers are built by specialized retrieval, not general\r\r\nsearch. For \"all the cities in Pennsylvania\" two genuinely competing\r\r\nstrategies express the same `set.members` need:\r\r\n\r\r\n- retrieve-set-wiki-table — parses the municipalities wikitable and filters\r\r\n  the class column to City (row-level classification)\r\r\n- retrieve-set-wiki-category — traverses Category:Cities in Pennsylvania\r\r\n  (set-membership retrieval)\r\r\n\r\r\nBoth are adequate: results are unioned, agreement/disagreement recorded,\r\r\nnon-matches (headers, foreign links, class errors) retained as reviewable\r\r\n`need:candidate` rows, and a `set:closure` + list artifact seals the run.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport json\r\r\nimport os\r\r\nimport re\r\r\n\r\r\nfrom . import model\r\r\n\r\r\n\r\r\nPA_TABLE = \"List of municipalities in Pennsylvania\"\r\r\nPA_CATEGORY = \"Category:Cities in Pennsylvania\"\r\r\n\r\r\n\r\r\ndef _clean_name(title: str) -> str:\r\r\n    t = re.sub(r\",\\s*Pennsylvania$\", \"\", title).strip()\r\r\n    return t\r\r\n\r\r\n\r\r\ndef via_table(ctx, criteria: str) -> dict:\r\r\n    \"\"\"Wikitable strategy: fetch the municipalities table wikitext, parse\r\r\n    rows, keep class == city, classify the rest as non-matches.\"\"\"\r\r\n    w = ctx.wiki\r\r\n    r = w.wikitext(PA_TABLE)\r\r\n    if not r.get(\"ok\"):\r\r\n        return {\"ok\": False, \"error\": r.get(\"error\"), \"strategy\": \"table\"}\r\r\n    rows = re.findall(\r\r\n        r\"\\|\\s*\\d+\\|\\|\\[\\[([^\\]|]+)(?:\\|[^\\]]+)?\\]\\]([^|]*)\\|\\|\", r[\"text\"])\r\r\n    members, non = [], []\r\r\n    for name, klass in rows:\r\r\n        k = klass.strip().lower().replace(\"†\", \"\").split(\"(\")[0].strip()\r\r\n        name = _clean_name(name)\r\r\n        if k == \"city\":\r\r\n            members.append(name)\r\r\n        elif k in (\"borough\", \"township\", \"town\"):\r\r\n            non.append({\"name\": name, \"class\": \"class-error\",\r\r\n                        \"detail\": f\"table class '{k}' is not a city\"})\r\r\n    return {\"ok\": True, \"strategy\": \"table\", \"members\": members,\r\r\n            \"nonMatches\": non, \"source\": PA_TABLE}\r\r\n\r\r\n\r\r\ndef via_category(ctx, criteria: str) -> dict:\r\r\n    \"\"\"Category strategy: traverse the category as a set. Header/list pages\r\r\n    and foreign links are non-matches, retained for review.\"\"\"\r\r\n    w = ctx.wiki\r\r\n    r = w.category_members(PA_CATEGORY)\r\r\n    if not r.get(\"ok\"):\r\r\n        return {\"ok\": False, \"error\": r.get(\"error\"),\r\r\n                \"strategy\": \"category\"}\r\r\n    members, non = [], []\r\r\n    for title in r.get(\"members\", []):\r\r\n        if title.lower().startswith(\"list of\"):\r\r\n            non.append({\"name\": title, \"class\": \"header\",\r\r\n                        \"detail\": \"list/header page is not a member\"})\r\r\n        elif \"sister\" in title.lower():\r\r\n            non.append({\"name\": title, \"class\": \"foreign-link\",\r\r\n                        \"detail\": \"sister-city relation is not a PA city\"})\r\r\n        elif \"(disambiguation)\" in title.lower():\r\r\n            non.append({\"name\": title, \"class\": \"ambiguous\",\r\r\n                        \"detail\": \"disambiguation page\"})\r\r\n        else:\r\r\n            members.append(_clean_name(title))\r\r\n    return {\"ok\": True, \"strategy\": \"category\", \"members\": members,\r\r\n            \"nonMatches\": non, \"source\": PA_CATEGORY}\r\r\n\r\r\n\r\r\ndef build(ctx, criteria: str, need_id: str = None) -> dict:\r\r\n    \"\"\"Full set fulfillment: competing retrievals unioned, criteria preserved,\r\r\n    non-matches retained for review and cleanup (prompt demo 4).\"\"\"\r\r\n    led = ctx.ledger\r\r\n    results = [via_table(ctx, criteria), via_category(ctx, criteria)]\r\r\n    ok_results = [r for r in results if r.get(\"ok\")]\r\r\n    if not ok_results:\r\r\n        return {\"ok\": False, \"error\": \"all retrieval strategies failed\",\r\r\n                \"detail\": results}\r\r\n\r\r\n    sets = {r[\"strategy\"]: set(r[\"members\"]) for r in ok_results}\r\r\n    union = sorted(set().union(*sets.values()))\r\r\n    agreement = {\r\r\n        \"both\": sorted(sets.get(\"table\", set()) & sets.get(\"category\", set())),\r\r\n        \"only-table\": sorted(sets.get(\"table\", set())\r\r\n                             - sets.get(\"category\", set())),\r\r\n        \"only-category\": sorted(sets.get(\"category\", set())\r\r\n                                - sets.get(\"table\", set())),\r\r\n    }\r\r\n    subj = f\"need:{need_id}\" if need_id else \"set:run\"\r\r\n\r\r\n    # retain every retrieval as candidate rows; non-matches stay inspectable\r\r\n    for r in ok_results:\r\r\n        led.say(subj, \"set:retrieval\",\r\r\n                {\"strategy\": r[\"strategy\"], \"count\": len(r[\"members\"]),\r\r\n                 \"source\": r[\"source\"]},\r\r\n                claimant=\"source:wikipedia\", certainty=0.85,\r\r\n                basis={\"kind\": \"source-evidence\"})\r\r\n        for nm in r.get(\"nonMatches\", []):\r\r\n            led.say(subj, \"need:candidate\",\r\r\n                    {\"slot\": \"member\", \"value\": nm[\"name\"], \"adequate\": False,\r\r\n                     \"class\": nm[\"class\"], \"detail\": nm[\"detail\"],\r\r\n                     \"strategy\": r[\"strategy\"]},\r\r\n                    claimant=\"source:wikipedia\", certainty=0.5,\r\r\n                    basis={\"kind\": \"source-evidence\"})\r\r\n    # disagreement members are candidates too — inspectable until selected\r\r\n    for name in agreement[\"only-table\"] + agreement[\"only-category\"]:\r\r\n        side = \"only-table\" if name in agreement[\"only-table\"] \\\r\r\n            else \"only-category\"\r\r\n        led.say(subj, \"need:candidate\",\r\r\n                {\"slot\": \"member\", \"value\": name, \"adequate\": True,\r\r\n                 \"class\": \"single-source\", \"detail\":\r\r\n                 f\"returned by {side} strategy only\"},\r\r\n                claimant=\"source:wikipedia\", certainty=0.6,\r\r\n                basis={\"kind\": \"source-evidence\"})\r\r\n\r\r\n    # artifact: the produced list is a durable file under runtime/artifacts\r\r\n    outdir = os.path.join(ctx.runtime, \"artifacts\", \"lists\")\r\r\n    os.makedirs(outdir, exist_ok=True)\r\r\n    fname = f\"set-{model.rid('list')}.json\"\r\r\n    path = os.path.join(outdir, fname)\r\r\n    with open(path, \"w\", encoding=\"utf-8\") as f:\r\r\n        json.dump({\"criteria\": criteria, \"members\": union,\r\r\n                   \"memberCount\": len(union), \"agreement\": agreement,\r\r\n                   \"strategies\": [r[\"strategy\"] for r in ok_results]},\r\r\n                  f, indent=2, ensure_ascii=False)\r\r\n\r\r\n    led.say(subj, \"set:closure\",\r\r\n            {\"criteria\": criteria, \"memberCount\": len(union),\r\r\n             \"agreeBoth\": len(agreement[\"both\"]),\r\r\n             \"disputed\": len(agreement[\"only-table\"])\r\r\n                        + len(agreement[\"only-category\"]),\r\r\n             \"artifact\": path},\r\r\n            claimant=\"system\", certainty=1.0,\r\r\n            basis={\"kind\": \"durable-result\"})\r\r\n    return {\"ok\": True, \"members\": union, \"memberCount\": len(union),\r\r\n            \"agreement\": agreement, \"artifact\": path,\r\r\n            \"strategies\": [r[\"strategy\"] for r in ok_results],\r\r\n            \"nonMatchCount\": sum(len(r.get(\"nonMatches\", []))\r\r\n                                 for r in ok_results)}\r\r\n","newText":"\"\"\"Set fulfillment (C-SetBuild / C-SpecializedListRetrieval).\nGeographic set answers are built by specialized retrieval, not general\nsearch. For \"all the cities in Pennsylvania\" two genuinely competing\nstrategies express the same `set.members` need:\n- retrieve-set-wiki-table — parses the municipalities wikitable and filters\n  the class column to City (row-level classification)\n- retrieve-set-wiki-category — traverses Category:Cities in Pennsylvania\n  (set-membership retrieval)\nBoth are adequate: results are unioned, agreement/disagreement recorded,\nnon-matches (headers, foreign links, class errors) retained as reviewable\n`need:candidate` rows, and a `set:closure` + list artifact seals the run.\n\"\"\"\nfrom __future__ import annotations\nimport json\nimport os\nimport re\nfrom . import model\nPA_TABLE = \"List of municipalities in Pennsylvania\"\nPA_CATEGORY = \"Category:Cities in Pennsylvania\"\ndef _clean_name(title: str) -> str:\n    t = re.sub(r\",\\s*Pennsylvania$\", \"\", title).strip()\n    return t\ndef via_table(ctx, criteria: str) -> dict:\n    \"\"\"Wikitable strategy: fetch the municipalities table wikitext, parse\n    rows, keep class == city, classify the rest as non-matches.\"\"\"\n    w = ctx.wiki\n    r = w.wikitext(PA_TABLE)\n    if not r.get(\"ok\"):\n        return {\"ok\": False, \"error\": r.get(\"error\"), \"strategy\": \"table\"}\n    rows = re.findall(\n        r\"\\|\\s*\\d+\\|\\|\\[\\[([^\\]|]+)(?:\\|[^\\]]+)?\\]\\]([^|]*)\\|\\|\", r[\"text\"])\n    members, non = [], []\n    for name, klass in rows:\n        k = klass.strip().lower().replace(\"†\", \"\").split(\"(\")[0].strip()\n        name = _clean_name(name)\n        if k == \"city\":\n            members.append(name)\n        elif k in (\"borough\", \"township\", \"town\"):\n            non.append({\"name\": name, \"class\": \"class-error\",\n                        \"detail\": f\"table class '{k}' is not a city\"})\n    return {\"ok\": True, \"strategy\": \"table\", \"members\": members,\n            \"nonMatches\": non, \"source\": PA_TABLE}\ndef via_category(ctx, criteria: str) -> dict:\n    \"\"\"Category strategy: traverse the category as a set. Header/list pages\n    and foreign links are non-matches, retained for review.\"\"\"\n    w = ctx.wiki\n    r = w.category_members(PA_CATEGORY)\n    if not r.get(\"ok\"):\n        return {\"ok\": False, \"error\": r.get(\"error\"),\n                \"strategy\": \"category\"}\n    members, non = [], []\n    for title in r.get(\"members\", []):\n        if title.lower().startswith(\"list of\"):\n            non.append({\"name\": title, \"class\": \"header\",\n                        \"detail\": \"list/header page is not a member\"})\n        elif \"sister\" in title.lower():\n            non.append({\"name\": title, \"class\": \"foreign-link\",\n                        \"detail\": \"sister-city relation is not a PA city\"})\n        elif \"(disambiguation)\" in title.lower():\n            non.append({\"name\": title, \"class\": \"ambiguous\",\n                        \"detail\": \"disambiguation page\"})\n        else:\n            members.append(_clean_name(title))\n    return {\"ok\": True, \"strategy\": \"category\", \"members\": members,\n            \"nonMatches\": non, \"source\": PA_CATEGORY}\ndef build(ctx, criteria: str, need_id: str = None) -> dict:\n    \"\"\"Full set fulfillment: competing retrievals unioned, criteria preserved,\n    non-matches retained for review and cleanup (prompt demo 4).\"\"\"\n    led = ctx.ledger\n    results = [via_table(ctx, criteria), via_category(ctx, criteria)]\n    ok_results = [r for r in results if r.get(\"ok\")]\n    if not ok_results:\n        return {\"ok\": False, \"error\": \"all retrieval strategies failed\",\n                \"detail\": results}\n    sets = {r[\"strategy\"]: set(r[\"members\"]) for r in ok_results}\n    union = sorted(set().union(*sets.values()))\n    agreement = {\n        \"both\": sorted(sets.get(\"table\", set()) & sets.get(\"category\", set())),\n        \"only-table\": sorted(sets.get(\"table\", set())\n                             - sets.get(\"category\", set())),\n        \"only-category\": sorted(sets.get(\"category\", set())\n                                - sets.get(\"table\", set())),\n    }\n    subj = f\"need:{need_id}\" if need_id else \"set:run\"\n    # retain every retrieval as candidate rows; non-matches stay inspectable\n    for r in ok_results:\n        led.say(subj, \"set:retrieval\",\n                {\"strategy\": r[\"strategy\"], \"count\": len(r[\"members\"]),\n                 \"source\": r[\"source\"]},\n                claimant=\"source:wikipedia\", certainty=0.85,\n                basis={\"kind\": \"source-evidence\"})\n        for nm in r.get(\"nonMatches\", []):\n            led.say(subj, \"need:candidate\",\n                    {\"slot\": \"member\", \"value\": nm[\"name\"], \"adequate\": False,\n                     \"class\": nm[\"class\"], \"detail\": nm[\"detail\"],\n                     \"strategy\": r[\"strategy\"]},\n                    claimant=\"source:wikipedia\", certainty=0.5,\n                    basis={\"kind\": \"source-evidence\"})\n    # disagreement members are candidates too — inspectable until selected\n    for name in agreement[\"only-table\"] + agreement[\"only-category\"]:\n        side = \"only-table\" if name in agreement[\"only-table\"] \\\n            else \"only-category\"\n        led.say(subj, \"need:candidate\",\n                {\"slot\": \"member\", \"value\": name, \"adequate\": True,\n                 \"class\": \"single-source\", \"detail\":\n                 f\"returned by {side} strategy only\"},\n                claimant=\"source:wikipedia\", certainty=0.6,\n                basis={\"kind\": \"source-evidence\"})\n    # artifact: the produced list is a durable file under runtime/artifacts\n    outdir = os.path.join(ctx.runtime, \"artifacts\", \"lists\")\n    os.makedirs(outdir, exist_ok=True)\n    fname = f\"set-{model.rid('list')}.json\"\n    path = os.path.join(outdir, fname)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump({\"criteria\": criteria, \"members\": union,\n                   \"memberCount\": len(union), \"agreement\": agreement,\n                   \"strategies\": [r[\"strategy\"] for r in ok_results]},\n                  f, indent=2, ensure_ascii=False)\n    led.say(subj, \"set:closure\",\n            {\"criteria\": criteria, \"memberCount\": len(union),\n             \"agreeBoth\": len(agreement[\"both\"]),\n             \"disputed\": len(agreement[\"only-table\"])\n                        + len(agreement[\"only-category\"]),\n             \"artifact\": path},\n            claimant=\"system\", certainty=1.0,\n            basis={\"kind\": \"durable-result\"})\n    return {\"ok\": True, \"members\": union, \"memberCount\": len(union),\n            \"agreement\": agreement, \"artifact\": path,\n            \"strategies\": [r[\"strategy\"] for r in ok_results],\n            \"nonMatchCount\": sum(len(r.get(\"nonMatches\", []))\n                                 for r in ok_results)}\n","_meta":{"cognition.ai/linesAdded":131,"cognition.ai/linesRemoved":300}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\speechfloor.py","oldText":"\"\"\"Speech floor (C-SpeechFloor) — serialized playback admission.\r\r\n\r\r\nOne render at a time through a host queue. Admission holds until playback\r\r\nactually completes: the local renderer blocks on the audio device, and the\r\r\nplayed row carries a MEASURED playbackMs. Where no real playback happened no\r\r\nplaybackMs is claimed (J2 discipline — populated fields or no claim).\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport queue\r\r\nimport threading\r\r\nimport time\r\r\n\r\r\n\r\r\nclass SpeechFloor:\r\r\n    def __init__(self, ctx):\r\r\n        self.ctx = ctx\r\r\n        self.q = queue.Queue()\r\r\n        self.played = []          # [{persona, text, playbackMs, at}]\r\r\n        self.holds = []           # admission log\r\r\n        self.worker = threading.Thread(target=self._loop, daemon=True)\r\r\n        self.worker.start()\r\r\n\r\r\n    @property\r\r\n    def depth(self):\r\r\n        return self.q.qsize()\r\r\n\r\r\n    def admit(self, persona: str, text: str, voice=None, rate=0,\r\r\n              render=True) -> dict:\r\r\n        item = {\"persona\": persona, \"text\": text, \"voice\": voice,\r\r\n                \"rate\": rate, \"render\": render, \"at\": time.time(),\r\r\n                \"done\": threading.Event(), \"result\": None}\r\r\n        self.q.put(item)\r\r\n        self.ctx.ledger.say(\"speech:floor\", \"speech:admitted\",\r\r\n                            {\"persona\": persona, \"chars\": len(text),\r\r\n                             \"depth\": self.depth},\r\r\n                            claimant=\"persona:\" + persona, certainty=1.0,\r\r\n                            basis={\"kind\": \"execution\"})\r\r\n        return item\r\r\n\r\r\n    def wait(self, item, timeout=180):\r\r\n        item[\"done\"].wait(timeout)\r\r\n        return item[\"result\"]\r\r\n\r\r\n    def drain(self, timeout=240):\r\r\n        t0 = time.time()\r\r\n        while self.depth and time.time() - t0 < timeout:\r\r\n            time.sleep(0.4)\r\r\n\r\r\n    def _loop(self):\r\r\n        while True:\r\r\n            item = self.q.get()\r\r\n            if item is None:\r\r\n                return\r\r\n            res = {\"ok\": True, \"persona\": item[\"persona\"]}\r\r\n            if item[\"render\"]:\r\r\n                r = self.ctx.engines.tts.render_local(\r\r\n                    item[\"text\"], voice=item[\"voice\"], rate=item[\"rate\"])\r\r\n                res.update(r)\r\r\n            else:\r\r\n                res.update({\"engine\": \"none\", \"playbackMs\": None,\r\r\n                            \"heldUntilPlaybackComplete\": False})\r\r\n            entry = {\"persona\": item[\"persona\"],\r\r\n                     \"text\": item[\"text\"][:160],\r\r\n                     \"engine\": res.get(\"engine\"),\r\r\n                     \"at\": item[\"at\"]}\r\r\n            if res.get(\"playbackMs\") is not None:\r\r\n                entry[\"playbackMs\"] = res[\"playbackMs\"]\r\r\n                entry[\"heldUntilPlaybackComplete\"] = True\r\r\n            self.played.append(entry)\r\r\n            self.holds.append(entry)\r\r\n            self.ctx.ledger.say(\"speech:floor\", \"speech:played\", entry,\r\r\n                                claimant=\"system\", certainty=1.0,\r\r\n                                basis={\"kind\": \"execution\"})\r\r\n            item[\"result\"] = res\r\r\n            item[\"done\"].set()\r\r\n            self.q.task_done()\r\r\n","newText":"\"\"\"Speech floor (C-SpeechFloor) — serialized playback admission.\nOne render at a time through a host queue. Admission holds until playback\nactually completes: the local renderer blocks on the audio device, and the\nplayed row carries a MEASURED playbackMs. Where no real playback happened no\nplaybackMs is claimed (J2 discipline — populated fields or no claim).\n\"\"\"\nfrom __future__ import annotations\nimport queue\nimport threading\nimport time\nclass SpeechFloor:\n    def __init__(self, ctx):\n        self.ctx = ctx\n        self.q = queue.Queue()\n        self.played = []          # [{persona, text, playbackMs, at}]\n        self.holds = []           # admission log\n        self.worker = threading.Thread(target=self._loop, daemon=True)\n        self.worker.start()\n    @property\n    def depth(self):\n        return self.q.qsize()\n    def admit(self, persona: str, text: str, voice=None, rate=0,\n              render=True) -> dict:\n        item = {\"persona\": persona, \"text\": text, \"voice\": voice,\n                \"rate\": rate, \"render\": render, \"at\": time.time(),\n                \"done\": threading.Event(), \"result\": None}\n        self.q.put(item)\n        self.ctx.ledger.say(\"speech:floor\", \"speech:admitted\",\n                            {\"persona\": persona, \"chars\": len(text),\n                             \"depth\": self.depth},\n                            claimant=\"persona:\" + persona, certainty=1.0,\n                            basis={\"kind\": \"execution\"})\n        return item\n    def wait(self, item, timeout=180):\n        item[\"done\"].wait(timeout)\n        return item[\"result\"]\n    def drain(self, timeout=240):\n        t0 = time.time()\n        while self.depth and time.time() - t0 < timeout:\n            time.sleep(0.4)\n    def _loop(self):\n        while True:\n            item = self.q.get()\n            if item is None:\n                return\n            res = {\"ok\": True, \"persona\": item[\"persona\"]}\n            if item[\"render\"]:\n                r = self.ctx.engines.tts.render_local(\n                    item[\"text\"], voice=item[\"voice\"], rate=item[\"rate\"])\n                res.update(r)\n            else:\n                res.update({\"engine\": \"none\", \"playbackMs\": None,\n                            \"heldUntilPlaybackComplete\": False})\n            entry = {\"persona\": item[\"persona\"],\n                     \"text\": item[\"text\"][:160],\n                     \"engine\": res.get(\"engine\"),\n                     \"at\": item[\"at\"]}\n            if res.get(\"playbackMs\") is not None:\n                entry[\"playbackMs\"] = res[\"playbackMs\"]\n                entry[\"heldUntilPlaybackComplete\"] = True\n            self.played.append(entry)\n            self.holds.append(entry)\n            self.ctx.ledger.say(\"speech:floor\", \"speech:played\", entry,\n                                claimant=\"system\", certainty=1.0,\n                                basis={\"kind\": \"execution\"})\n            item[\"result\"] = res\n            item[\"done\"].set()\n            self.q.task_done()\n","_meta":{"cognition.ai/linesAdded":68,"cognition.ai/linesRemoved":154}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\steward.py","oldText":"\"\"\"Background stewardship — useful work continues while the user is silent.\r\r\n\r\r\nDuties are configurable as ledger data (`steward:duty`), each separately\r\r\ntoggleable (C-StewardAsTool / C-ExplicitPolicies). The steward never holds\r\r\nthe request path (C-UserFacingPriority): it runs on its own thread, yields\r\r\nto user input, and never treats silence as consent to a consequential act.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport threading\r\r\nimport time\r\r\n\r\r\nfrom . import temporal\r\r\n\r\r\n\r\r\nDUTIES = (\"drain-needs\", \"temporal-attention\", \"inbox-scan\",\r\r\n          \"confidence-review\", \"compact-check\")\r\r\nDEFAULT_INTERVAL_S = 18\r\r\n\r\r\n\r\r\nclass Steward:\r\r\n    def __init__(self, ctx, interval=DEFAULT_INTERVAL_S):\r\r\n        self.ctx = ctx\r\r\n        self.interval = interval\r\r\n        self._stop = threading.Event()\r\r\n        self.thread = None\r\r\n        self.last_run = None\r\r\n        self.running = False\r\r\n\r\r\n    def start(self):\r\r\n        if self.thread:\r\r\n            return\r\r\n        self.thread = threading.Thread(target=self._loop, daemon=True)\r\r\n        self.thread.start()\r\r\n\r\r\n    def stop(self):\r\r\n        self._stop.set()\r\r\n\r\r\n    def _loop(self):\r\r\n        while not self._stop.wait(self.interval):\r\r\n            try:\r\r\n                self.tick(reason=\"interval\")\r\r\n            except Exception:\r\r\n                pass\r\r\n\r\r\n    def _duty_on(self, name) -> bool:\r\r\n        a = self.ctx.ledger.resolve(\"steward\", f\"steward:duty:{name}\")\r\r\n        if a is None:\r\r\n            return True\r\r\n        return bool((a.value.get(\"v\") or {}).get(\"on\", True))\r\r\n\r\r\n    def tick(self, reason=\"manual\") -> dict:\r\r\n        led = self.ctx.ledger\r\r\n        self.running = True\r\r\n        t0 = time.time()\r\r\n        actions = []\r\r\n\r\r\n        if self._duty_on(\"drain-needs\"):\r\r\n            for need in self.ctx.open_needs()[:4]:\r\r\n                r = self.ctx.retry(need[\"id\"])\r\r\n                if r.get(\"ok\"):\r\r\n                    actions.append(f\"fulfilled:{need['id']}\")\r\r\n\r\r\n        if self._duty_on(\"temporal-attention\"):\r\r\n            r = temporal.attention_scan(self.ctx)\r\r\n            if r.get(\"findings\"):\r\r\n                actions.append(f\"temporal:{r['findings']}\")\r\r\n\r\r\n        if self._duty_on(\"inbox-scan\"):\r\r\n            r = self.ctx.run_connector(\"inbox-eml\")\r\r\n            if r.get(\"ingested\"):\r\r\n                actions.append(f\"inbox:{r['ingested']}\")\r\r\n\r\r\n        if self._duty_on(\"confidence-review\"):\r\r\n            # success-driven source-confidence adaptation, bounded\r\r\n            adj = self._confidence_review()\r\r\n            if adj:\r\r\n                actions.append(f\"conf:{adj}\")\r\r\n\r\r\n        ms_ = int((time.time() - t0) * 1000)\r\r\n        led.say(\"steward\", \"idle:steward-run\",\r\r\n                {\"reason\": reason, \"ms\": ms_, \"actions\": actions,\r\r\n                 \"duties\": [d for d in DUTIES if self._duty_on(d)]},\r\r\n                claimant=\"steward:main\", certainty=1.0,\r\r\n                basis={\"kind\": \"execution\"})\r\r\n        self.last_run = {\"ms\": ms_, \"actions\": actions}\r\r\n        self.running = False\r\r\n        return {\"ok\": True, \"ms\": ms_, \"actions\": actions}\r\r\n\r\r\n    def _confidence_review(self) -> int:\r\r\n        \"\"\"Bounded ±0.05 source-confidence adjustment after ≥2 outcomes.\"\"\"\r\r\n        led = self.ctx.ledger\r\r\n        n = 0\r\r\n        for a in led.query(predicate=\"source:outcome\", limit=50):\r\r\n            v = a.value.get(\"v\") or {}\r\r\n            src, ok = v.get(\"source\"), v.get(\"adequate\")\r\r\n            if not src:\r\r\n                continue\r\r\n            key = f\"source:confidence:{src}\"\r\r\n            cur = led.resolve(\"steward\", key)\r\r\n            cv = (cur.value.get(\"v\") or {}).get(\"v\", 0.7) if cur else 0.7\r\r\n            nv = min(0.95, cv + 0.05) if ok else max(0.2, cv - 0.05)\r\r\n            if nv != cv:\r\r\n                led.say(\"steward\", key, {\"v\": round(nv, 3), \"source\": src},\r\r\n                        claimant=\"steward:confidence\", certainty=1.0,\r\r\n                        basis={\"kind\": \"execution\"},\r\r\n                        supersedes=cur.id if cur else None)\r\r\n                n += 1\r\r\n        return n\r\r\n","newText":"\"\"\"Background stewardship — useful work continues while the user is silent.\nDuties are configurable as ledger data (`steward:duty`), each separately\ntoggleable (C-StewardAsTool / C-ExplicitPolicies). The steward never holds\nthe request path (C-UserFacingPriority): it runs on its own thread, yields\nto user input, and never treats silence as consent to a consequential act.\n\"\"\"\nfrom __future__ import annotations\nimport threading\nimport time\nfrom . import temporal\nDUTIES = (\"drain-needs\", \"temporal-attention\", \"inbox-scan\",\n          \"confidence-review\", \"compact-check\")\nDEFAULT_INTERVAL_S = 18\nclass Steward:\n    def __init__(self, ctx, interval=DEFAULT_INTERVAL_S):\n        self.ctx = ctx\n        self.interval = interval\n        self._stop = threading.Event()\n        self.thread = None\n        self.last_run = None\n        self.running = False\n    def start(self):\n        if self.thread:\n            return\n        self.thread = threading.Thread(target=self._loop, daemon=True)\n        self.thread.start()\n    def stop(self):\n        self._stop.set()\n    def _loop(self):\n        while not self._stop.wait(self.interval):\n            try:\n                self.tick(reason=\"interval\")\n            except Exception:\n                pass\n    def _duty_on(self, name) -> bool:\n        a = self.ctx.ledger.resolve(\"steward\", f\"steward:duty:{name}\")\n        if a is None:\n            return True\n        return bool((a.value.get(\"v\") or {}).get(\"on\", True))\n    def tick(self, reason=\"manual\") -> dict:\n        led = self.ctx.ledger\n        self.running = True\n        t0 = time.time()\n        actions = []\n        if self._duty_on(\"drain-needs\"):\n            for need in self.ctx.open_needs()[:4]:\n                r = self.ctx.retry(need[\"id\"])\n                if r.get(\"ok\"):\n                    actions.append(f\"fulfilled:{need['id']}\")\n        if self._duty_on(\"temporal-attention\"):\n            r = temporal.attention_scan(self.ctx)\n            if r.get(\"findings\"):\n                actions.append(f\"temporal:{r['findings']}\")\n        if self._duty_on(\"inbox-scan\"):\n            r = self.ctx.run_connector(\"inbox-eml\")\n            if r.get(\"ingested\"):\n                actions.append(f\"inbox:{r['ingested']}\")\n        if self._duty_on(\"confidence-review\"):\n            # success-driven source-confidence adaptation, bounded\n            adj = self._confidence_review()\n            if adj:\n                actions.append(f\"conf:{adj}\")\n        ms_ = int((time.time() - t0) * 1000)\n        led.say(\"steward\", \"idle:steward-run\",\n                {\"reason\": reason, \"ms\": ms_, \"actions\": actions,\n                 \"duties\": [d for d in DUTIES if self._duty_on(d)]},\n                claimant=\"steward:main\", certainty=1.0,\n                basis={\"kind\": \"execution\"})\n        self.last_run = {\"ms\": ms_, \"actions\": actions}\n        self.running = False\n        return {\"ok\": True, \"ms\": ms_, \"actions\": actions}\n    def _confidence_review(self) -> int:\n        \"\"\"Bounded ±0.05 source-confidence adjustment after ≥2 outcomes.\"\"\"\n        led = self.ctx.ledger\n        n = 0\n        for a in led.query(predicate=\"source:outcome\", limit=50):\n            v = a.value.get(\"v\") or {}\n            src, ok = v.get(\"source\"), v.get(\"adequate\")\n            if not src:\n                continue\n            key = f\"source:confidence:{src}\"\n            cur = led.resolve(\"steward\", key)\n            cv = (cur.value.get(\"v\") or {}).get(\"v\", 0.7) if cur else 0.7\n            nv = min(0.95, cv + 0.05) if ok else max(0.2, cv - 0.05)\n            if nv != cv:\n                led.say(\"steward\", key, {\"v\": round(nv, 3), \"source\": src},\n                        claimant=\"steward:confidence\", certainty=1.0,\n                        basis={\"kind\": \"execution\"},\n                        supersedes=cur.id if cur else None)\n                n += 1\n        return n\n","_meta":{"cognition.ai/linesAdded":91,"cognition.ai/linesRemoved":218}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\temporal.py","oldText":"\"\"\"Temporal interpretation — calendar events remain source evidence; their\r\r\ninterpretation is governed by the same ledger and authority rules.\r\r\n\r\r\nBuckets: past / current / upcoming(horizon) / future(beyond horizon).\r\r\nA far-future fixture is never 'recent'; a long-past one never 'upcoming'.\r\r\nThe steward's temporal-attention duty turns relevant findings into persona\r\r\npresentations, preserving the ledger evidence.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport datetime as dt\r\r\n\r\r\n\r\r\nHORIZON_H = 96  # upcoming window in hours\r\r\n\r\r\n\r\r\ndef _parse_start(s: str):\r\r\n    s = (s or \"\").strip()\r\r\n    for fmt in (\"%Y%m%dT%H%M%S\", \"%Y%m%dT%H%M%SZ\", \"%Y%m%d\"):\r\r\n        try:\r\r\n            return dt.datetime.strptime(s, fmt)\r\r\n        except ValueError:\r\r\n            continue\r\r\n    return None\r\r\n\r\r\n\r\r\ndef classify(led, horizon_h=HORIZON_H):\r\r\n    now = dt.datetime.now()\r\r\n    out = {\"current\": [], \"upcoming\": [], \"past\": [], \"future\": []}\r\r\n    for a in led.query(predicate=\"calendar:event\", limit=400):\r\r\n        ev = a.value.get(\"v\") or {}\r\r\n        start = _parse_start(ev.get(\"start\", \"\"))\r\r\n        if not start:\r\r\n            out[\"past\"].append({**ev, \"when\": \"undated\"})\r\r\n            continue\r\r\n        delta_h = (start - now).total_seconds() / 3600\r\r\n        entry = {**ev, \"start_dt\": start.isoformat(timespec=\"minutes\"),\r\r\n                 \"in_h\": round(delta_h, 1), \"source\": a.claimant}\r\r\n        if -2 <= delta_h <= 2:\r\r\n            out[\"current\"].append(entry)\r\r\n        elif 2 < delta_h <= horizon_h:\r\r\n            out[\"upcoming\"].append(entry)\r\r\n        elif delta_h > horizon_h:\r\r\n            out[\"future\"].append(entry)   # 2030 fixtures land here\r\r\n        else:\r\r\n            out[\"past\"].append(entry)\r\r\n    for k in out:\r\r\n        out[k].sort(key=lambda e: e[\"in_h\"])\r\r\n    return out\r\r\n\r\r\n\r\r\ndef attention_scan(ctx):\r\r\n    \"\"\"Steward duty: surface a relevant temporal finding as a presentation\r\r\n    opportunity through a lens-matched persona.\"\"\"\r\r\n    buckets = classify(ctx.ledger)\r\r\n    relevant = buckets[\"current\"] + buckets[\"upcoming\"][:2]\r\r\n    if not relevant:\r\r\n        return {\"ok\": True, \"findings\": 0}\r\r\n    led = ctx.ledger\r\r\n    for ev in relevant:\r\r\n        key = f\"temporal:attention:{ev['summary'][:40]}\"\r\r\n        if led.query(predicate=\"temporal:attention\", text=ev[\"summary\"][:40],\r\r\n                     limit=1):\r\r\n            continue\r\r\n        persona = ctx.personas.active()\r\r\n        pname = persona[\"name\"] if persona else \"system\"\r\r\n        led.say(\"temporal\", \"temporal:attention\",\r\r\n                {\"summary\": ev[\"summary\"], \"when\": ev.get(\"start_dt\"),\r\r\n                 \"in_h\": ev.get(\"in_h\"), \"presentAs\": \"opportunity\",\r\r\n                 \"persona\": pname},\r\r\n                claimant=\"steward:temporal\", certainty=0.8,\r\r\n                basis={\"kind\": \"interpretation\"})\r\r\n        ctx.bus.emit(\"offer\", {\r\r\n            \"kind\": \"temporal\",\r\r\n            \"text\": f\"{ev['summary']} — {ev.get('start_dt','')}\",\r\r\n            \"persona\": pname})\r\r\n    return {\"ok\": True, \"findings\": len(relevant)}\r\r\n","newText":"\"\"\"Temporal interpretation — calendar events remain source evidence; their\ninterpretation is governed by the same ledger and authority rules.\nBuckets: past / current / upcoming(horizon) / future(beyond horizon).\nA far-future fixture is never 'recent'; a long-past one never 'upcoming'.\nThe steward's temporal-attention duty turns relevant findings into persona\npresentations, preserving the ledger evidence.\n\"\"\"\nfrom __future__ import annotations\nimport datetime as dt\nHORIZON_H = 96  # upcoming window in hours\ndef _parse_start(s: str):\n    s = (s or \"\").strip()\n    for fmt in (\"%Y%m%dT%H%M%S\", \"%Y%m%dT%H%M%SZ\", \"%Y%m%d\"):\n        try:\n            return dt.datetime.strptime(s, fmt)\n        except ValueError:\n            continue\n    return None\ndef classify(led, horizon_h=HORIZON_H):\n    now = dt.datetime.now()\n    out = {\"current\": [], \"upcoming\": [], \"past\": [], \"future\": []}\n    for a in led.query(predicate=\"calendar:event\", limit=400):\n        ev = a.value.get(\"v\") or {}\n        start = _parse_start(ev.get(\"start\", \"\"))\n        if not start:\n            out[\"past\"].append({**ev, \"when\": \"undated\"})\n            continue\n        delta_h = (start - now).total_seconds() / 3600\n        entry = {**ev, \"start_dt\": start.isoformat(timespec=\"minutes\"),\n                 \"in_h\": round(delta_h, 1), \"source\": a.claimant}\n        if -2 <= delta_h <= 2:\n            out[\"current\"].append(entry)\n        elif 2 < delta_h <= horizon_h:\n            out[\"upcoming\"].append(entry)\n        elif delta_h > horizon_h:\n            out[\"future\"].append(entry)   # 2030 fixtures land here\n        else:\n            out[\"past\"].append(entry)\n    for k in out:\n        out[k].sort(key=lambda e: e[\"in_h\"])\n    return out\ndef attention_scan(ctx):\n    \"\"\"Steward duty: surface a relevant temporal finding as a presentation\n    opportunity through a lens-matched persona.\"\"\"\n    buckets = classify(ctx.ledger)\n    relevant = buckets[\"current\"] + buckets[\"upcoming\"][:2]\n    if not relevant:\n        return {\"ok\": True, \"findings\": 0}\n    led = ctx.ledger\n    for ev in relevant:\n        key = f\"temporal:attention:{ev['summary'][:40]}\"\n        if led.query(predicate=\"temporal:attention\", text=ev[\"summary\"][:40],\n                     limit=1):\n            continue\n        persona = ctx.personas.active()\n        pname = persona[\"name\"] if persona else \"system\"\n        led.say(\"temporal\", \"temporal:attention\",\n                {\"summary\": ev[\"summary\"], \"when\": ev.get(\"start_dt\"),\n                 \"in_h\": ev.get(\"in_h\"), \"presentAs\": \"opportunity\",\n                 \"persona\": pname},\n                claimant=\"steward:temporal\", certainty=0.8,\n                basis={\"kind\": \"interpretation\"})\n        ctx.bus.emit(\"offer\", {\n            \"kind\": \"temporal\",\n            \"text\": f\"{ev['summary']} — {ev.get('start_dt','')}\",\n            \"persona\": pname})\n    return {\"ok\": True, \"findings\": len(relevant)}\n","_meta":{"cognition.ai/linesAdded":67,"cognition.ai/linesRemoved":154}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\tools.py","oldText":"\"\"\"Component registry — the invokable ontology (C-ConvergentOntology).\r\r\n\r\r\nThree component kinds:\r\r\n- **tool** — tool-as-data: id, title, need expression, template (slots,\r\r\n  tests, grant, minCertainty), then a python handler or DSL steps\r\r\n- **command** — `object.verb` system commands on host objects\r\r\n- **primitive** — closed allow-list of low-level capabilities\r\r\n\r\r\nInvocation always goes through the need floor: an invoke is an unmet\r\r\nrequirement first, an execution only when its gate passes.\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nfrom . import floor\r\r\n\r\r\n\r\r\nPRIMITIVES = (\r\r\n    \"prim.now\", \"prim.uuid\", \"prim.sha256\", \"prim.read-text\",\r\r\n    \"prim.write-artifact\", \"prim.list-dir\", \"prim.json-parse\",\r\r\n    \"prim.http-get\",\r\r\n)\r\r\n\r\r\n\r\r\nclass Registry:\r\r\n    def __init__(self):\r\r\n        self.tools: dict[str, dict] = {}\r\r\n        self.commands: dict[str, callable] = {}\r\r\n        self.primitives = set(PRIMITIVES)\r\r\n\r\r\n    # -- registration --------------------------------------------------------\r\r\n\r\r\n    def tool(self, id, title, need=None, template=None, handler=None,\r\r\n             steps=None, tags=None, consequential=False, authored=False):\r\r\n        self.tools[id] = {\r\r\n            \"id\": id, \"title\": title, \"kind\": \"tool\", \"need\": need,\r\r\n            \"template\": template or {\"slots\": []}, \"handler\": handler,\r\r\n            \"steps\": steps, \"tags\": tags or [],\r\r\n            \"consequential\": consequential, \"authored\": authored}\r\r\n        return self.tools[id]\r\r\n\r\r\n    def command(self, name, handler):\r\r\n        self.commands[name] = handler\r\r\n\r\r\n    # -- access ---------------------------------------------------------------\r\r\n\r\r\n    def get(self, tool_id):\r\r\n        return self.tools.get(tool_id)\r\r\n\r\r\n    def for_need(self, need_expr):\r\r\n        \"\"\"All tools expressing the same need — the competing set.\"\"\"\r\r\n        return [t for t in self.tools.values() if t.get(\"need\") == need_expr]\r\r\n\r\r\n    def manifest(self):\r\r\n        return {\r\r\n            \"tools\": len(self.tools),\r\r\n            \"commands\": len(self.commands),\r\r\n            \"primitives\": len(self.primitives),\r\r\n            \"components\": len(self.tools) + len(self.commands)\r\r\n                          + len(self.primitives),\r\r\n            \"byNeed\": sorted({t[\"need\"] for t in self.tools.values()\r\r\n                              if t.get(\"need\")}),\r\r\n        }\r\r\n\r\r\n\r\r\ndef register_all(ctx):\r\r\n    from . import builtins\r\r\n    builtins.register(ctx)\r\r\n","newText":"\"\"\"Component registry — the invokable ontology (C-ConvergentOntology).\nThree component kinds:\n- **tool** — tool-as-data: id, title, need expression, template (slots,\n  tests, grant, minCertainty), then a python handler or DSL steps\n- **command** — `object.verb` system commands on host objects\n- **primitive** — closed allow-list of low-level capabilities\nInvocation always goes through the need floor: an invoke is an unmet\nrequirement first, an execution only when its gate passes.\n\"\"\"\nfrom __future__ import annotations\nfrom . import floor\nPRIMITIVES = (\n    \"prim.now\", \"prim.uuid\", \"prim.sha256\", \"prim.read-text\",\n    \"prim.write-artifact\", \"prim.list-dir\", \"prim.json-parse\",\n    \"prim.http-get\",\n)\nclass Registry:\n    def __init__(self):\n        self.tools: dict[str, dict] = {}\n        self.commands: dict[str, callable] = {}\n        self.primitives = set(PRIMITIVES)\n    # -- registration --------------------------------------------------------\n    def tool(self, id, title, need=None, template=None, handler=None,\n             steps=None, tags=None, consequential=False, authored=False):\n        self.tools[id] = {\n            \"id\": id, \"title\": title, \"kind\": \"tool\", \"need\": need,\n            \"template\": template or {\"slots\": []}, \"handler\": handler,\n            \"steps\": steps, \"tags\": tags or [],\n            \"consequential\": consequential, \"authored\": authored}\n        return self.tools[id]\n    def command(self, name, handler):\n        self.commands[name] = handler\n    # -- access ---------------------------------------------------------------\n    def get(self, tool_id):\n        return self.tools.get(tool_id)\n    def for_need(self, need_expr):\n        \"\"\"All tools expressing the same need — the competing set.\"\"\"\n        return [t for t in self.tools.values() if t.get(\"need\") == need_expr]\n    def manifest(self):\n        return {\n            \"tools\": len(self.tools),\n            \"commands\": len(self.commands),\n            \"primitives\": len(self.primitives),\n            \"components\": len(self.tools) + len(self.commands)\n                          + len(self.primitives),\n            \"byNeed\": sorted({t[\"need\"] for t in self.tools.values()\n                              if t.get(\"need\")}),\n        }\ndef register_all(ctx):\n    from . import builtins\n    builtins.register(ctx)\n","_meta":{"cognition.ai/linesAdded":51,"cognition.ai/linesRemoved":134}}],"_meta":{"cognition.ai/inferenceToolName":"exec"}}}}
