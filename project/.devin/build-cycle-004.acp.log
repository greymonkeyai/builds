           width:auto; }\nmain { flex:1; display:flex; flex-direction:column; min-width:0; }\n#tabs { display:flex; gap:2px; padding:6px 10px 0; background:var(--panel);\n        border-bottom:1px solid var(--line); }\n#tabs button { border:none; background:transparent; color:var(--mut);\n               padding:8px 14px; cursor:pointer; font-size:13px; }\n#tabs button.on { color:var(--accent); border-bottom:2px solid var(--accent); }\nsection { flex:1; overflow-y:auto; padding:12px; }\n.hidden { display:none !important; }\n.cols { display:grid; grid-template-columns:1fr 1fr; gap:16px; }\n.cols > div { min-width:0; }\nh3 { font-size:13px; margin:14px 0 8px; }\n.small { font-size:11px; color:var(--mut); }\nbutton { background:var(--badge); color:var(--ink); border:1px solid var(--line);\n         border-radius:6px; padding:5px 10px; cursor:pointer; font-size:12px; }\nbutton:hover { border-color:var(--accent); }\ninput, select, textarea { background:var(--card); color:var(--ink);\n  border:1px solid var(--line); border-radius:6px; padding:6px 8px;\n  font-size:13px; font-family:inherit; }\n#stage { display:flex; gap:8px; padding:4px 0 8px; min-height:30px;\n         align-items:center; }\n.stage-chip { display:flex; align-items:center; gap:5px; font-size:11px;\n              background:var(--badge); padding:3px 8px; border-radius:12px; }\n.stage-chip img { width:18px; height:18px; border-radius:4px; }\n#chathead { display:flex; align-items:center; gap:8px; padding:4px 0;\n            font-size:13px; font-weight:600; }\n#chathead button { margin-left:auto; font-size:11px; }\n#topicbadge, #ctxbadge, #focusbadge { background:var(--badge); font-size:10px;\n  font-weight:400; padding:2px 8px; border-radius:10px; color:var(--mut); }\n#feed { border:1px solid var(--line); border-radius:8px; background:var(--card);\n        min-height:200px; max-height:52vh; overflow-y:auto; padding:10px; }\n.msg { margin-bottom:10px; }\n.msg .who { font-size:10px; color:var(--mut); margin-bottom:2px; }\n.msg .txt { font-size:13px; line-height:1.45; white-space:pre-wrap; }\n.msg.user .txt { color:var(--accent); }\n.msg .art { width:20px; height:20px; border-radius:4px; vertical-align:-5px;\n            margin-right:6px; }\n.mark { color:#b8860b; font-size:10px; }\n#composer { display:flex; gap:6px; padding-top:8px; }\n#composer input { flex:1; }\n#statusbar { display:flex; gap:14px; padding:6px 12px; background:var(--panel);\n             border-top:1px solid var(--line); font-size:11px; color:var(--mut);\n             align-items:center; }\n.sb-right { margin-left:auto; display:flex; gap:8px; align-items:center; }\n.needrow, .projrow, .mailrow, .toolrow, .pkrow {\n  border:1px solid var(--line); border-radius:6px; padding:6px 8px;\n  margin-bottom:6px; background:var(--card); font-size:12px; }\n.needrow .meta { font-size:10px; color:var(--mut); }\n.needrow button { font-size:10px; padding:2px 6px; margin-left:4px; }\n.liblayout { display:grid; grid-template-columns:140px 1fr; gap:14px; }\n#libnav button { display:block; width:100%; text-align:left; margin-bottom:4px; }\n#libnav button.on { border-color:var(--accent); color:var(--accent); }\n#libmain { display:grid; grid-template-columns:1fr 1fr; gap:12px; }\n#liblist .hrow { border:1px solid var(--line); border-radius:6px; padding:6px;\n                 margin-bottom:6px; background:var(--card); cursor:pointer;\n                 font-size:12px; }\n#liblist .hrow:hover { border-color:var(--accent); }\n#liblist .hrow img { width:30px; height:30px; border-radius:4px;\n                     vertical-align:middle; margin-right:6px; }\n#libdetail { border-left:1px solid var(--line); padding-left:12px;\n             font-size:12px; white-space:pre-wrap; overflow:auto;\n             max-height:60vh; }\n#libdetail img { max-width:180px; display:block; margin:8px 0; }\n#ledgerpane { margin-top:16px; border-top:1px solid var(--line);\n              padding-top:10px; }\n#librows { max-height:40vh; overflow:auto; font-size:11px; }\n.lrow { border-bottom:1px solid var(--line); padding:3px 0; }\npre { background:var(--badge); padding:8px; border-radius:6px;\n      font-size:11px; overflow:auto; }\n#editor { position:fixed; inset:0; background:rgba(0,0,0,0.4);\n          display:flex; align-items:center; justify-content:center; }\n#editorCard { background:var(--panel); border-radius:10px; padding:18px;\n              width:520px; max-height:86vh; overflow-y:auto; }\n#edPortrait img { width:120px; height:120px; border-radius:8px; }\n.edgrid { display:grid; grid-template-columns:150px 1fr; gap:8px;\n          margin-top:12px; align-items:center; }\n.edgrid label { font-size:11px; color:var(--mut); text-align:right; }\n.edbtns { display:flex; gap:8px; margin-top:14px; }\n.grant { border:1px dashed var(--accent); padding:8px; border-radius:6px;\n         margin-bottom:6px; font-size:12px; }\n.slot { display:flex; gap:6px; margin-bottom:4px; align-items:center; }\n.slot label { font-size:11px; width:110px; color:var(--mut); }\n"},"_meta":{"cognition.ai/suppressApproval":true,"cognition.ai/inferenceToolName":"write","cognition.ai/timestamp":"2026-11-23T09:03:12.639054300+00:00"}}}}
