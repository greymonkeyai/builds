{"jsonrpc":"2.0","id":"0762526a-72ca-48e7-8b05-b707ef28db02","method":"fs/write_text_file","params":{"sessionId":"flax-utensil","path":"C:\\builds\\project\\version 0.3.0.004\\app\\speechfloor.py","content":"\"\"\"Speech floor (C-SpeechFloor) — serialized playback admission.\r\n\r\nOne render at a time through a host queue. Admission holds until playback\r\nactually completes: the local renderer blocks on the audio device, and the\r\nplayed row carries a MEASURED playbackMs. Where no real playback happened no\r\nplaybackMs is claimed (J2 discipline — populated fields or no claim).\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport queue\r\nimport threading\r\nimport time\r\n\r\n\r\nclass SpeechFloor:\r\n    def __init__(self, ctx):\r\n        self.ctx = ctx\r\n        self.q = queue.Queue()\r\n        self.played = []          # [{persona, text, playbackMs, at}]\r\n        self.holds = []           # admission log\r\n        self.worker = threading.Thread(target=self._loop, daemon=True)\r\n        self.worker.start()\r\n\r\n    @property\r\n    def depth(self):\r\n        return self.q.qsize()\r\n\r\n    def admit(self, persona: str, text: str, voice=None, rate=0,\r\n              render=True) -> dict:\r\n        item = {\"persona\": persona, \"text\": text, \"voice\": voice,\r\n                \"rate\": rate, \"render\": render, \"at\": time.time(),\r\n                \"done\": threading.Event(), \"result\": None}\r\n        self.q.put(item)\r\n        self.ctx.ledger.say(\"speech:floor\", \"speech:admitted\",\r\n                            {\"persona\": persona, \"chars\": len(text),\r\n                             \"depth\": self.depth},\r\n                            claimant=\"persona:\" + persona, certainty=1.0,\r\n                            basis={\"kind\": \"execution\"})\r\n        return item\r\n\r\n    def wait(self, item, timeout=180):\r\n        item[\"done\"].wait(timeout)\r\n        return item[\"result\"]\r\n\r\n    def drain(self, timeout=240):\r\n        t0 = time.time()\r\n        while self.depth and time.time() - t0 < timeout:\r\n            time.sleep(0.4)\r\n\r\n    def _loop(self):\r\n        while True:\r\n            item = self.q.get()\r\n            if item is None:\r\n                return\r\n            res = {\"ok\": True, \"persona\": item[\"persona\"]}\r\n            if item[\"render\"]:\r\n                r = self.ctx.engines.tts.render_local(\r\n                    item[\"text\"], voice=item[\"voice\"], rate=item[\"rate\"])\r\n                res.update(r)\r\n            else:\r\n                res.update({\"engine\": \"none\", \"playbackMs\": None,\r\n                            \"heldUntilPlaybackComplete\": False})\r\n            entry = {\"persona\": item[\"persona\"],\r\n                     \"text\": item[\"text\"][:160],\r\n                     \"engine\": res.get(\"engine\"),\r\n                     \"at\": item[\"at\"]}\r\n            if res.get(\"playbackMs\") is not None:\r\n                entry[\"playbackMs\"] = res[\"playbackMs\"]\r\n                entry[\"heldUntilPlaybackComplete\"] = True\r\n            self.played.append(entry)\r\n            self.holds.append(entry)\r\n            self.ctx.ledger.say(\"speech:floor\", \"speech:played\", entry,\r\n                                claimant=\"system\", certainty=1.0,\r\n                                basis={\"kind\": \"execution\"})\r\n            item[\"result\"] = res\r\n            item[\"done\"].set()\r\n            self.q.task_done()\r\n","_meta":{"cognition.ai/toolCallId":"write:1#dac57856c49d432aa44aa48d55d887fb","cognition.ai/suppressApproval":true}}}
{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"flax-utensil","update":{"sessionUpdate":"tool_call_update","toolCallId":"write:1#dac57856c49d432aa44aa48d55d887fb","status":"in_progress","content":[{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\speechfloor.py","newText":"\"\"\"Speech floor (C-SpeechFloor) — serialized playback admission.\n\nOne render at a time through a host queue. Admission holds until playback\nactually completes: the local renderer blocks on the audio device, and the\nplayed row carries a MEASURED playbackMs. Where no real playback happened no\nplaybackMs is claimed (J2 discipline — populated fields or no claim).\n\"\"\"\nfrom __future__ import annotations\n\nimport queue\nimport threading\nimport time\n\n\nclass SpeechFloor:\n    def __init__(self, ctx):\n        self.ctx = ctx\n        self.q = queue.Queue()\n        self.played = []          # [{persona, text, playbackMs, at}]\n        self.holds = []           # admission log\n        self.worker = threading.Thread(target=self._loop, daemon=True)\n        self.worker.start()\n\n    @property\n    def depth(self):\n        return self.q.qsize()\n\n    def admit(self, persona: str, text: str, voice=None, rate=0,\n              render=True) -> dict:\n        item = {\"persona\": persona, \"text\": text, \"voice\": voice,\n                \"rate\": rate, \"render\": render, \"at\": time.time(),\n                \"done\": threading.Event(), \"result\": None}\n        self.q.put(item)\n        self.ctx.ledger.say(\"speech:floor\", \"speech:admitted\",\n                            {\"persona\": persona, \"chars\": len(text),\n                             \"depth\": self.depth},\n                            claimant=\"persona:\" + persona, certainty=1.0,\n                            basis={\"kind\": \"execution\"})\n        return item\n\n    def wait(self, item, timeout=180):\n        item[\"done\"].wait(timeout)\n        return item[\"result\"]\n\n    def drain(self, timeout=240):\n        t0 = time.time()\n        while self.depth and time.time() - t0 < timeout:\n            time.sleep(0.4)\n\n    def _loop(self):\n        while True:\n            item = self.q.get()\n            if item is None:\n                return\n            res = {\"ok\": True, \"persona\": item[\"persona\"]}\n            if item[\"render\"]:\n                r = self.ctx.engines.tts.render_local(\n                    item[\"text\"], voice=item[\"voice\"], rate=item[\"rate\"])\n                res.update(r)\n            else:\n                res.update({\"engine\": \"none\", \"playbackMs\": None,\n                            \"heldUntilPlaybackComplete\": False})\n            entry = {\"persona\": item[\"persona\"],\n                     \"text\": item[\"text\"][:160],\n                     \"engine\": res.get(\"engine\"),\n                     \"at\": item[\"at\"]}\n            if res.get(\"playbackMs\") is not None:\n                entry[\"playbackMs\"] = res[\"playbackMs\"]\n                entry[\"heldUntilPlaybackComplete\"] = True\n            self.played.append(entry)\n            self.holds.append(entry)\n            self.ctx.ledger.say(\"speech:floor\", \"speech:played\", entry,\n                                claimant=\"system\", certainty=1.0,\n                                basis={\"kind\": \"execution\"})\n            item[\"result\"] = res\n            item[\"done\"].set()\n            self.q.task_done()\n","_meta":{"cognition.ai/linesAdded":77,"cognition.ai/linesRemoved":0}}],"_meta":{"cognition.ai/inferenceToolName":"write"}}}}
