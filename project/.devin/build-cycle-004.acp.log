{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"flax-utensil","update":{"sessionUpdate":"tool_call","toolCallId":"exec:0#6d7df881017441ae8c4b567bee8a02e4","title":"Ran python, echo","kind":"execute","content":[{"type":"content","content":{"type":"resource","resource":{"mimeType":"text/x-shellscript","text":"cd \"C:/builds/project/version 0.3.0.004\" && cat > scripts/launch-check.py <<'EOF'\n\"\"\"Launch-hygiene enactment — real processes, real ports.\n\nChecks:\n1. clean launch — boots, gate passes, last-launch.json ok:true\n2. launch hygiene — a second launch on the same port REFUSES\n   (LAUNCH REFUSED, exit!=0, ok:false) — never ok:true while a prior\n   instance owns the port\n3. close-terminate — with the watchdog on, closing the last window\n   terminates the program\n\nWrites evidence/launch/launch-check.json\n\"\"\"\nimport json, os, shutil, subprocess, sys, time, urllib.request\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nEVID = os.path.join(ROOT, \"evidence\", \"launch\")\nPORT = 9774\n\ndef honest(p=PORT, t=3):\n    try:\n        with urllib.request.urlopen(f\"http://127.0.0.1:{p}/api/honesty\",\n                                    timeout=t) as r:\n            return json.loads(r.read().decode())\n    except Exception:\n        return None\n\ndef wait_up(p=PORT, s=120):\n    t0 = time.time()\n    while time.time() - t0 < s:\n        d = honest(p)\n        if d:\n            return d\n        time.sleep(0.5)\n    return None\n\ndef main():\n    os.makedirs(EVID, exist_ok=True)\n    rt = os.path.join(ROOT, \"runtime\", \"launchcheck\")\n    shutil.rmtree(rt, ignore_errors=True)\n    os.makedirs(rt, exist_ok=True)\n    out = {\"checks\": []}\n\n    # 1. clean launch\n    p1 = subprocess.Popen([sys.executable, \"-m\", \"app\", \"--port\", str(PORT),\n                           \"--runtime\", rt, \"--no-watchdog\"],\n                          cwd=ROOT, stdout=subprocess.PIPE,\n                          stderr=subprocess.STDOUT, text=True)\n    try:\n        d = wait_up()\n        ll = {}\n        llp = os.path.join(rt, \"last-launch.json\")\n        if os.path.exists(llp):\n            ll = json.load(open(llp))\n        out[\"checks\"].append({\"name\": \"clean launch\",\n            \"pass\": bool(d) and ll.get(\"ok\") is True,\n            \"detail\": {\"honesty\": bool(d), \"lastLaunchOk\": ll.get(\"ok\"),\n                       \"gate\": ll.get(\"gate\", {}).get(\"passed\"),\n                       \"timeToGateMs\": ll.get(\"gate\", {}).get(\"timeToGateMs\")}})\n\n        # 2. second launch refuses (launch hygiene)\n        p2 = subprocess.Popen([sys.executable, \"-m\", \"app\", \"--port\",\n                               str(PORT), \"--runtime\",\n                               os.path.join(ROOT, \"runtime\", \"second\"),\n                               \"--no-watchdog\"],\n                              cwd=ROOT, stdout=subprocess.PIPE,\n                              stderr=subprocess.STDOUT, text=True)\n        try:\n            txt = p2.communicate(timeout=60)[0]\n            refused = \"LAUNCH REFUSED\" in (txt or \"\")\n            out[\"checks\"].append({\"name\": \"second launch refused\",\n                \"pass\": refused and p2.returncode != 0,\n                \"detail\": {\"exit\": p2.returncode,\n                           \"refusedLine\": refused,\n                           \"out\": (txt or \"\")[-400:]}})\n        finally:\n            if p2.poll() is None:\n                p2.terminate()\n    finally:\n        p1.terminate()\n        try: p1.wait(timeout=15)\n        except Exception: p1.kill()\n\n    # 3. close-terminate (watchdog instance)\n    rt3 = os.path.join(ROOT, \"runtime\", \"closeterm\")\n    shutil.rmtree(rt3, ignore_errors=True)\n    os.makedirs(rt3, exist_ok=True)\n    p3 = subprocess.Popen([sys.executable, \"-m\", \"app\", \"--port\",\n                           str(PORT+1), \"--runtime\", rt3],\n                          cwd=ROOT, stdout=subprocess.PIPE,\n                          stderr=subprocess.STDOUT, text=True)\n    try:\n        if not wait_up(PORT+1):\n            out[\"checks\"].append({\"name\": \"close-terminate\", \"pass\": False,\n                \"detail\": \"watchdog instance never came up\"})\n        else:\n            conn = urllib.request.urlopen(\n                f\"http://127.0.0.1:{PORT+1}/api/events\", timeout=10)\n            conn.read(16); conn.close()\n            t0 = time.time(); exited = False\n            while time.time() - t0 < 70:\n                if p3.poll() is not None:\n                    exited = True; break\n                time.sleep(1)\n            out[\"checks\"].append({\"name\": \"close-terminate\",\n                \"pass\": exited,\n                \"detail\": {\"exitCode\": p3.poll(),\n                           \"waitedS\": int(time.time()-t0)}})\n    finally:\n        if p3.poll() is None:\n            p3.terminate()\n\n    out[\"pass\"] = all(c[\"pass\"] for c in out[\"checks\"])\n    path = os.path.join(EVID, \"launch-check.json\")\n    json.dump(out, open(path, \"w\"), indent=2)\n    print(json.dumps(out, indent=2)[:1500])\n    print(\"launch-check:\", \"PASS\" if out[\"pass\"] else \"FAIL\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\ncat > scripts/probe.py <<'EOF'\n\"\"\"Second-instance probe — boots on an alternate port, verifies isolation\nand steward responsiveness, writes evidence/probe-<ts>.json\"\"\"\nimport json, os, shutil, subprocess, sys, time, urllib.request\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nPORT = 9771\ndef main():\n    rt = os.path.join(ROOT, \"runtime\", \"probe\")\n    shutil.rmtree(rt, ignore_errors=True); os.makedirs(rt, exist_ok=True)\n    p = subprocess.Popen([sys.executable, \"-m\", \"app\", \"--port\", str(PORT),\n                          \"--runtime\", rt, \"--no-watchdog\"], cwd=ROOT)\n    out = {\"port\": PORT}\n    try:\n        t0 = time.time(); up = None\n        while time.time()-t0 < 90:\n            try:\n                up = json.loads(urllib.request.urlopen(\n                    f\"http://127.0.0.1:{PORT}/api/state\", timeout=3).read())\n                break\n            except Exception: time.sleep(0.5)\n        out[\"launched\"] = bool(up)\n        if up:\n            t1 = time.time()\n            r = json.loads(urllib.request.urlopen(\n                f\"http://127.0.0.1:{PORT}/api/gate\", timeout=5).read())\n            out[\"gateMs\"] = r.get(\"timeToGateMs\")\n            out[\"apiMs\"] = int((time.time()-t1)*1000)\n            out[\"components\"] = up[\"manifest\"]\n            out[\"roster\"] = len(up[\"roster\"])\n            out[\"llm\"] = up[\"engines\"][\"llm\"][\"mode\"]\n            out[\"stewardLast\"] = up[\"steward\"][\"last\"]\n    finally:\n        p.terminate()\n        try: p.wait(timeout=15)\n        except Exception: p.kill()\n    os.makedirs(os.path.join(ROOT, \"evidence\"), exist_ok=True)\n    fn = os.path.join(ROOT, \"evidence\",\n                      \"probe-\"+time.strftime(\"%Y%m%d-%H%M%S\")+\".json\")\n    json.dump(out, open(fn, \"w\"), indent=2)\n    print(json.dumps(out, indent=2))\nif __name__ == \"__main__\":\n    main()\nEOF\npython -m compileall -q scripts && echo OK","uri":"tool://preview"},"_meta":{"cognition.ai/preview_is_shell_command":true}}}],"rawInput":{"command":"cd \"C:/builds/project/version 0.3.0.004\" && cat > scripts/launch-check.py <<'EOF'\n\"\"\"Launch-hygiene enactment — real processes, real ports.\n\nChecks:\n1. clean launch — boots, gate passes, last-launch.json ok:true\n2. launch hygiene — a second launch on the same port REFUSES\n   (LAUNCH REFUSED, exit!=0, ok:false) — never ok:true while a prior\n   instance owns the port\n3. close-terminate — with the watchdog on, closing the last window\n   terminates the program\n\nWrites evidence/launch/launch-check.json\n\"\"\"\nimport json, os, shutil, subprocess, sys, time, urllib.request\n\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nEVID = os.path.join(ROOT, \"evidence\", \"launch\")\nPORT = 9774\n\ndef honest(p=PORT, t=3):\n    try:\n        with urllib.request.urlopen(f\"http://127.0.0.1:{p}/api/honesty\",\n                                    timeout=t) as r:\n            return json.loads(r.read().decode())\n    except Exception:\n        return None\n\ndef wait_up(p=PORT, s=120):\n    t0 = time.time()\n    while time.time() - t0 < s:\n        d = honest(p)\n        if d:\n            return d\n        time.sleep(0.5)\n    return None\n\ndef main():\n    os.makedirs(EVID, exist_ok=True)\n    rt = os.path.join(ROOT, \"runtime\", \"launchcheck\")\n    shutil.rmtree(rt, ignore_errors=True)\n    os.makedirs(rt, exist_ok=True)\n    out = {\"checks\": []}\n\n    # 1. clean launch\n    p1 = subprocess.Popen([sys.executable, \"-m\", \"app\", \"--port\", str(PORT),\n                           \"--runtime\", rt, \"--no-watchdog\"],\n                          cwd=ROOT, stdout=subprocess.PIPE,\n                          stderr=subprocess.STDOUT, text=True)\n    try:\n        d = wait_up()\n        ll = {}\n        llp = os.path.join(rt, \"last-launch.json\")\n        if os.path.exists(llp):\n            ll = json.load(open(llp))\n        out[\"checks\"].append({\"name\": \"clean launch\",\n            \"pass\": bool(d) and ll.get(\"ok\") is True,\n            \"detail\": {\"honesty\": bool(d), \"lastLaunchOk\": ll.get(\"ok\"),\n                       \"gate\": ll.get(\"gate\", {}).get(\"passed\"),\n                       \"timeToGateMs\": ll.get(\"gate\", {}).get(\"timeToGateMs\")}})\n\n        # 2. second launch refuses (launch hygiene)\n        p2 = subprocess.Popen([sys.executable, \"-m\", \"app\", \"--port\",\n                               str(PORT), \"--runtime\",\n                               os.path.join(ROOT, \"runtime\", \"second\"),\n                               \"--no-watchdog\"],\n                              cwd=ROOT, stdout=subprocess.PIPE,\n                              stderr=subprocess.STDOUT, text=True)\n        try:\n            txt = p2.communicate(timeout=60)[0]\n            refused = \"LAUNCH REFUSED\" in (txt or \"\")\n            out[\"checks\"].append({\"name\": \"second launch refused\",\n                \"pass\": refused and p2.returncode != 0,\n                \"detail\": {\"exit\": p2.returncode,\n                           \"refusedLine\": refused,\n                           \"out\": (txt or \"\")[-400:]}})\n        finally:\n            if p2.poll() is None:\n                p2.terminate()\n    finally:\n        p1.terminate()\n        try: p1.wait(timeout=15)\n        except Exception: p1.kill()\n\n    # 3. close-terminate (watchdog instance)\n    rt3 = os.path.join(ROOT, \"runtime\", \"closeterm\")\n    shutil.rmtree(rt3, ignore_errors=True)\n    os.makedirs(rt3, exist_ok=True)\n    p3 = subprocess.Popen([sys.executable, \"-m\", \"app\", \"--port\",\n                           str(PORT+1), \"--runtime\", rt3],\n                          cwd=ROOT, stdout=subprocess.PIPE,\n                          stderr=subprocess.STDOUT, text=True)\n    try:\n        if not wait_up(PORT+1):\n            out[\"checks\"].append({\"name\": \"close-terminate\", \"pass\": False,\n                \"detail\": \"watchdog instance never came up\"})\n        else:\n            conn = urllib.request.urlopen(\n                f\"http://127.0.0.1:{PORT+1}/api/events\", timeout=10)\n            conn.read(16); conn.close()\n            t0 = time.time(); exited = False\n            while time.time() - t0 < 70:\n                if p3.poll() is not None:\n                    exited = True; break\n                time.sleep(1)\n            out[\"checks\"].append({\"name\": \"close-terminate\",\n                \"pass\": exited,\n                \"detail\": {\"exitCode\": p3.poll(),\n                           \"waitedS\": int(time.time()-t0)}})\n    finally:\n        if p3.poll() is None:\n            p3.terminate()\n\n    out[\"pass\"] = all(c[\"pass\"] for c in out[\"checks\"])\n    path = os.path.join(EVID, \"launch-check.json\")\n    json.dump(out, open(path, \"w\"), indent=2)\n    print(json.dumps(out, indent=2)[:1500])\n    print(\"launch-check:\", \"PASS\" if out[\"pass\"] else \"FAIL\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\ncat > scripts/probe.py <<'EOF'\n\"\"\"Second-instance probe — boots on an alternate port, verifies isolation\nand steward responsiveness, writes evidence/probe-<ts>.json\"\"\"\nimport json, os, shutil, subprocess, sys, time, urllib.request\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nPORT = 9771\ndef main():\n    rt = os.path.join(ROOT, \"runtime\", \"probe\")\n    shutil.rmtree(rt, ignore_errors=True); os.makedirs(rt, exist_ok=True)\n    p = subprocess.Popen([sys.executable, \"-m\", \"app\", \"--port\", str(PORT),\n                          \"--runtime\", rt, \"--no-watchdog\"], cwd=ROOT)\n    out = {\"port\": PORT}\n    try:\n        t0 = time.time(); up = None\n        while time.time()-t0 < 90:\n            try:\n                up = json.loads(urllib.request.urlopen(\n                    f\"http://127.0.0.1:{PORT}/api/state\", timeout=3).read())\n                break\n            except Exception: time.sleep(0.5)\n        out[\"launched\"] = bool(up)\n        if up:\n            t1 = time.time()\n            r = json.loads(urllib.request.urlopen(\n                f\"http://127.0.0.1:{PORT}/api/gate\", timeout=5).read())\n            out[\"gateMs\"] = r.get(\"timeToGateMs\")\n            out[\"apiMs\"] = int((time.time()-t1)*1000)\n            out[\"components\"] = up[\"manifest\"]\n            out[\"roster\"] = len(up[\"roster\"])\n            out[\"llm\"] = up[\"engines\"][\"llm\"][\"mode\"]\n            out[\"stewardLast\"] = up[\"steward\"][\"last\"]\n    finally:\n        p.terminate()\n        try: p.wait(timeout=15)\n        except Exception: p.kill()\n    os.makedirs(os.path.join(ROOT, \"evidence\"), exist_ok=True)\n    fn = os.path.join(ROOT, \"evidence\",\n                      \"probe-\"+time.strftime(\"%Y%m%d-%H%M%S\")+\".json\")\n    json.dump(out, open(fn, \"w\"), indent=2)\n    print(json.dumps(out, indent=2))\nif __name__ == \"__main__\":\n    main()\nEOF\npython -m compileall -q scripts && echo OK"},"_meta":{"cognition.ai/commandNames":["python","echo"],"cognition.ai/inferenceToolName":"exec","cognition.ai/timestamp":"2026-11-23T09:06:34.604981200+00:00"}}}}
