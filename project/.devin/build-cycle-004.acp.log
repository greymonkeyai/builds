{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"flax-utensil","update":{"sessionUpdate":"tool_call_update","toolCallId":"exec:0#1091ef4c44b2494797ec51e9c86c5c8c","status":"in_progress","content":[{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\__main__.py","oldText":"\"\"\"Vantage boot — two-part execution (C-TwoPartExecution) + launch hygiene.\r\r\n\r\r\nPart 1 (exactly the readiness gate's scope): runtime dirs + transient\r\r\nboundary, ledger + launch partition mount, seed packs, component registry,\r\r\nengine probes — then the Interactive Readiness Gate runs and records its\r\r\npass time.\r\r\n\r\r\nPart 2 (everything after the gate): HTTP surface, SSE window watchdog,\r\r\nbackground steward, browser open.\r\r\n\r\r\nLaunch hygiene (standing criterion):\r\r\n- the port is probed for a live Vantage instance BEFORE binding; a second\r\r\n  launch prints LAUNCH REFUSED, writes the failure to the launch log and\r\r\n  last-launch.json, and exits non-zero — never ok:true while a prior\r\r\n  instance owns the port\r\r\n- the HTTP socket binds exclusively (allow_reuse_address off; on Windows\r\r\n  that is SO_EXCLUSIVEADDRUSE) so no silent double-bind is possible\r\r\n- once a window has connected, closing the last one stops the program —\r\r\n  no orphaned process (S-close-terminate); --no-watchdog for headless runs\r\r\n\"\"\"\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport argparse\r\r\nimport json\r\r\nimport os\r\r\nimport socket\r\r\nimport sys\r\r\nimport threading\r\r\nimport time\r\r\nimport urllib.request\r\r\nimport webbrowser\r\r\n\r\r\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\r\n\r\r\nfrom app import host, api, gate as gate_mod  # noqa: E402\r\r\n\r\r\n\r\r\ndef log_line(logf, msg):\r\r\n    line = f\"[{time.strftime('%H:%M:%S')}] {msg}\"\r\r\n    print(line, flush=True)\r\r\n    logf.write(line + \"\\n\")\r\r\n    logf.flush()\r\r\n\r\r\n\r\r\ndef probe_instance(port: int) -> bool:\r\r\n    \"\"\"Is a live Vantage already serving on this port?\"\"\"\r\r\n    try:\r\r\n        with urllib.request.urlopen(\r\r\n                f\"http://127.0.0.1:{port}/api/honesty\", timeout=2) as r:\r\r\n            d = json.loads(r.read().decode())\r\r\n            return isinstance(d, dict) and \"llm\" in d\r\r\n    except Exception:\r\r\n        return False\r\r\n\r\r\n\r\r\ndef write_last_launch(runtime, rec):\r\r\n    with open(os.path.join(runtime, \"last-launch.json\"), \"w\",\r\r\n              encoding=\"utf-8\") as f:\r\r\n        json.dump(rec, f, indent=2)\r\r\n\r\r\n\r\r\ndef main():\r\r\n    ap = argparse.ArgumentParser(prog=\"vantage\")\r\r\n    ap.add_argument(\"--port\", type=int, default=9770)\r\r\n    ap.add_argument(\"--runtime\", default=None)\r\r\n    ap.add_argument(\"--no-serve\", action=\"store_true\")\r\r\n    ap.add_argument(\"--no-steward\", action=\"store_true\")\r\r\n    ap.add_argument(\"--no-watchdog\", action=\"store_true\")\r\r\n    ap.add_argument(\"--open\", action=\"store_true\")\r\r\n    args = ap.parse_args()\r\r\n\r\r\n    t0 = time.time()\r\r\n    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\r\r\n    runtime = args.runtime or os.path.join(root, \"runtime\")\r\r\n    os.makedirs(runtime, exist_ok=True)\r\r\n    os.makedirs(os.path.join(root, \"evidence\", \"launch\"), exist_ok=True)\r\r\n    stamp = time.strftime(\"%Y%m%d-%H%M%S\")\r\r\n    logpath = os.path.join(root, \"evidence\", \"launch\",\r\r\n                           f\"launch-{stamp}.log\")\r\r\n    logf = open(logpath, \"w\", encoding=\"utf-8\")\r\r\n    server_out = open(os.path.join(root, \"launch-server.out\"), \"w\",\r\r\n                      encoding=\"utf-8\")\r\r\n\r\r\n    class Tee:\r\r\n        def write(self, s):\r\r\n            sys.stdout.write(s)\r\r\n            server_out.write(s)\r\r\n            server_out.flush()\r\r\n        def flush(self):\r\r\n            sys.stdout.flush()\r\r\n    sys.stdout = Tee()\r\r\n\r\r\n    log_line(logf, f\"vantage 0.3.0.004 boot — port {args.port}, \"\r\r\n                   f\"runtime {runtime}\")\r\r\n\r\r\n    # -- launch hygiene: never claim success while a prior instance owns\r\r\n    #    the port -------------------------------------------------------\r\r\n    if not args.no_serve and probe_instance(args.port):\r\r\n        log_line(logf, \"LAUNCH REFUSED — a live Vantage instance already \"\r\r\n                       f\"owns port {args.port}\")\r\r\n        write_last_launch(runtime, {\r\r\n            \"ok\": False, \"reason\": \"port-owned\",\r\r\n            \"detail\": f\"prior instance owns :{args.port}\",\r\r\n            \"at\": time.time()})\r\r\n        logf.close()\r\r\n        sys.exit(3)\r\r\n\r\r\n    # ==================== PART 1 (gate scope) ==========================\r\r\n    ctx = host.Ctx(runtime)\r\r\n    log_line(logf, f\"transient boundary: {ctx.transient} \"\r\r\n                   f\"(reset={ctx.transient_reset})\")\r\r\n    log_line(logf, f\"launch partition mounted: {ctx.partition_count} rows; \"\r\r\n                   f\"journal replay: {ctx.journal_count} rows\")\r\r\n    seed = ctx.seed_packs(os.path.join(root, \"seed-packs\"))\r\r\n    log_line(logf, f\"seed packs: {seed}\")\r\r\n    manifest = ctx.tools.manifest()\r\r\n    log_line(logf, f\"components: {manifest}\")\r\r\n    eng = ctx.engines.honesty()\r\r\n    log_line(logf, f\"engines: llm={eng['llm']['mode']} \"\r\r\n                   f\"tts={eng['tts']['mode']}({len(eng['tts']['voices'])}v) \"\r\r\n                   f\"stt={eng['stt']['mode']}\")\r\r\n\r\r\n    ctx.gate = gate_mod.Gate(ctx)\r\r\n    grec = ctx.gate.run(t0)\r\r\n    log_line(logf, f\"readiness gate: {'PASS' if grec['passed'] else 'FAIL'} \"\r\r\n                   f\"in {grec['timeToGateMs']}ms — {grec['checks'].keys()}\")\r\r\n    if not grec[\"passed\"]:\r\r\n        write_last_launch(runtime, {\"ok\": False, \"reason\": \"gate-failed\",\r\r\n                                    \"gate\": grec, \"at\": time.time()})\r\r\n        logf.close()\r\r\n        sys.exit(4)\r\r\n\r\r\n    # ==================== PART 2 (after the gate) ======================\r\r\n    honesty = eng\r\r\n    banner = (f\"honesty: llm={honesty['llm']['mode']} | \"\r\r\n              f\"tts={honesty['tts']['mode']} | declared absences: \"\r\r\n              f\"{', '.join(honesty['declaredAbsences'][:3])}…\")\r\r\n    ctx.ledger.say(\"launch\", \"launch:honesty\",\r\r\n                   {\"banner\": banner, \"engines\": honesty[\"llm\"][\"mode\"]},\r\r\n                   claimant=\"system\", certainty=1.0,\r\r\n                   basis={\"kind\": \"config\"})\r\r\n    log_line(logf, banner)\r\r\n\r\r\n    if not args.no_steward:\r\r\n        ctx.steward.start()\r\r\n        log_line(logf, f\"steward running every {ctx.steward.interval}s\")\r\r\n\r\r\n    if args.no_serve:\r\r\n        write_last_launch(runtime, {\r\r\n            \"ok\": True, \"served\": False, \"gate\": grec,\r\r\n            \"rows\": len(ctx.ledger.rows), \"at\": time.time()})\r\r\n        log_line(logf, \"--no-serve: boot complete\")\r\r\n        logf.close()\r\r\n        return\r\r\n\r\r\n    try:\r\r\n        srv = api.VantageServer((\"127.0.0.1\", args.port), api.Handler, ctx,\r\r\n                                watchdog=not args.no_watchdog)\r\r\n    except OSError as e:\r\r\n        log_line(logf, f\"LAUNCH REFUSED — bind failed: {e}\")\r\r\n        write_last_launch(runtime, {\"ok\": False, \"reason\": \"bind-failed\",\r\r\n                                    \"error\": repr(e), \"at\": time.time()})\r\r\n        logf.close()\r\r\n        sys.exit(3)\r\r\n\r\r\n    ctx.bus.listeners.append(srv.fanout)\r\r\n    write_last_launch(runtime, {\r\r\n        \"ok\": True, \"port\": args.port, \"gate\": grec,\r\r\n        \"rows\": len(ctx.ledger.rows), \"pid\": os.getpid(),\r\r\n        \"url\": f\"http://127.0.0.1:{args.port}\", \"at\": time.time()})\r\r\n    log_line(logf, f\"serving http://127.0.0.1:{args.port} \"\r\r\n                   f\"(watchdog={'on' if not args.no_watchdog else 'off'})\")\r\r\n    log_line(logf, f\"launch log: {logpath}\")\r\r\n    if args.open:\r\r\n        threading.Timer(1.0, lambda: webbrowser.open(\r\r\n            f\"http://127.0.0.1:{args.port}\")).start()\r\r\n    try:\r\r\n        srv.serve_forever()\r\r\n    except KeyboardInterrupt:\r\r\n        pass\r\r\n    finally:\r\r\n        # checkpoint the launch partition at clean shutdown\r\r\n        preds = [\"persona:profile\", \"ui:shell-theme\", \"chat:response-depth\",\r\r\n                 \"roster:active\", \"seed:loaded\", \"chat:topic\"]\r\r\n        n = ctx.ledger.write_partition(ctx.partition_path, preds)\r\r\n        ctx.steward.stop()\r\r\n        log_line(logf, f\"shutdown — partition checkpointed ({n} rows)\")\r\r\n        logf.close()\r\r\n\r\r\n\r\r\nif __name__ == \"__main__\":\r\r\n    main()\r\r\n","newText":"\"\"\"Vantage boot — two-part execution (C-TwoPartExecution) + launch hygiene.\nPart 1 (exactly the readiness gate's scope): runtime dirs + transient\nboundary, ledger + launch partition mount, seed packs, component registry,\nengine probes — then the Interactive Readiness Gate runs and records its\npass time.\nPart 2 (everything after the gate): HTTP surface, SSE window watchdog,\nbackground steward, browser open.\nLaunch hygiene (standing criterion):\n- the port is probed for a live Vantage instance BEFORE binding; a second\n  launch prints LAUNCH REFUSED, writes the failure to the launch log and\n  last-launch.json, and exits non-zero — never ok:true while a prior\n  instance owns the port\n- the HTTP socket binds exclusively (allow_reuse_address off; on Windows\n  that is SO_EXCLUSIVEADDRUSE) so no silent double-bind is possible\n- once a window has connected, closing the last one stops the program —\n  no orphaned process (S-close-terminate); --no-watchdog for headless runs\n\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport json\nimport os\nimport socket\nimport sys\nimport threading\nimport time\nimport urllib.request\nimport webbrowser\nsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\nfrom app import host, api, gate as gate_mod  # noqa: E402\ndef log_line(logf, msg):\n    line = f\"[{time.strftime('%H:%M:%S')}] {msg}\"\n    print(line, flush=True)\n    logf.write(line + \"\\n\")\n    logf.flush()\ndef probe_instance(port: int) -> bool:\n    \"\"\"Is a live Vantage already serving on this port?\"\"\"\n    try:\n        with urllib.request.urlopen(\n                f\"http://127.0.0.1:{port}/api/honesty\", timeout=2) as r:\n            d = json.loads(r.read().decode())\n            return isinstance(d, dict) and \"llm\" in d\n    except Exception:\n        return False\ndef write_last_launch(runtime, rec):\n    with open(os.path.join(runtime, \"last-launch.json\"), \"w\",\n              encoding=\"utf-8\") as f:\n        json.dump(rec, f, indent=2)\ndef main():\n    ap = argparse.ArgumentParser(prog=\"vantage\")\n    ap.add_argument(\"--port\", type=int, default=9770)\n    ap.add_argument(\"--runtime\", default=None)\n    ap.add_argument(\"--no-serve\", action=\"store_true\")\n    ap.add_argument(\"--no-steward\", action=\"store_true\")\n    ap.add_argument(\"--no-watchdog\", action=\"store_true\")\n    ap.add_argument(\"--open\", action=\"store_true\")\n    args = ap.parse_args()\n    t0 = time.time()\n    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n    runtime = args.runtime or os.path.join(root, \"runtime\")\n    os.makedirs(runtime, exist_ok=True)\n    os.makedirs(os.path.join(root, \"evidence\", \"launch\"), exist_ok=True)\n    stamp = time.strftime(\"%Y%m%d-%H%M%S\")\n    logpath = os.path.join(root, \"evidence\", \"launch\",\n                           f\"launch-{stamp}.log\")\n    logf = open(logpath, \"w\", encoding=\"utf-8\")\n    server_out = open(os.path.join(root, \"launch-server.out\"), \"w\",\n                      encoding=\"utf-8\")\n    class Tee:\n        def write(self, s):\n            sys.stdout.write(s)\n            server_out.write(s)\n            server_out.flush()\n        def flush(self):\n            sys.stdout.flush()\n    sys.stdout = Tee()\n    log_line(logf, f\"vantage 0.3.0.004 boot — port {args.port}, \"\n                   f\"runtime {runtime}\")\n    # -- launch hygiene: never claim success while a prior instance owns\n    #    the port -------------------------------------------------------\n    if not args.no_serve and probe_instance(args.port):\n        log_line(logf, \"LAUNCH REFUSED — a live Vantage instance already \"\n                       f\"owns port {args.port}\")\n        write_last_launch(runtime, {\n            \"ok\": False, \"reason\": \"port-owned\",\n            \"detail\": f\"prior instance owns :{args.port}\",\n            \"at\": time.time()})\n        logf.close()\n        sys.exit(3)\n    # ==================== PART 1 (gate scope) ==========================\n    ctx = host.Ctx(runtime)\n    log_line(logf, f\"transient boundary: {ctx.transient} \"\n                   f\"(reset={ctx.transient_reset})\")\n    log_line(logf, f\"launch partition mounted: {ctx.partition_count} rows; \"\n                   f\"journal replay: {ctx.journal_count} rows\")\n    seed = ctx.seed_packs(os.path.join(root, \"seed-packs\"))\n    log_line(logf, f\"seed packs: {seed}\")\n    manifest = ctx.tools.manifest()\n    log_line(logf, f\"components: {manifest}\")\n    eng = ctx.engines.honesty()\n    log_line(logf, f\"engines: llm={eng['llm']['mode']} \"\n                   f\"tts={eng['tts']['mode']}({len(eng['tts']['voices'])}v) \"\n                   f\"stt={eng['stt']['mode']}\")\n    ctx.gate = gate_mod.Gate(ctx)\n    grec = ctx.gate.run(t0)\n    log_line(logf, f\"readiness gate: {'PASS' if grec['passed'] else 'FAIL'} \"\n                   f\"in {grec['timeToGateMs']}ms — {grec['checks'].keys()}\")\n    if not grec[\"passed\"]:\n        write_last_launch(runtime, {\"ok\": False, \"reason\": \"gate-failed\",\n                                    \"gate\": grec, \"at\": time.time()})\n        logf.close()\n        sys.exit(4)\n    # ==================== PART 2 (after the gate) ======================\n    honesty = eng\n    banner = (f\"honesty: llm={honesty['llm']['mode']} | \"\n              f\"tts={honesty['tts']['mode']} | declared absences: \"\n              f\"{', '.join(honesty['declaredAbsences'][:3])}…\")\n    ctx.ledger.say(\"launch\", \"launch:honesty\",\n                   {\"banner\": banner, \"engines\": honesty[\"llm\"][\"mode\"]},\n                   claimant=\"system\", certainty=1.0,\n                   basis={\"kind\": \"config\"})\n    log_line(logf, banner)\n    if not args.no_steward:\n        ctx.steward.start()\n        log_line(logf, f\"steward running every {ctx.steward.interval}s\")\n    if args.no_serve:\n        write_last_launch(runtime, {\n            \"ok\": True, \"served\": False, \"gate\": grec,\n            \"rows\": len(ctx.ledger.rows), \"at\": time.time()})\n        log_line(logf, \"--no-serve: boot complete\")\n        logf.close()\n        return\n    try:\n        srv = api.VantageServer((\"127.0.0.1\", args.port), api.Handler, ctx,\n                                watchdog=not args.no_watchdog)\n    except OSError as e:\n        log_line(logf, f\"LAUNCH REFUSED — bind failed: {e}\")\n        write_last_launch(runtime, {\"ok\": False, \"reason\": \"bind-failed\",\n                                    \"error\": repr(e), \"at\": time.time()})\n        logf.close()\n        sys.exit(3)\n    ctx.bus.listeners.append(srv.fanout)\n    write_last_launch(runtime, {\n        \"ok\": True, \"port\": args.port, \"gate\": grec,\n        \"rows\": len(ctx.ledger.rows), \"pid\": os.getpid(),\n        \"url\": f\"http://127.0.0.1:{args.port}\", \"at\": time.time()})\n    log_line(logf, f\"serving http://127.0.0.1:{args.port} \"\n                   f\"(watchdog={'on' if not args.no_watchdog else 'off'})\")\n    log_line(logf, f\"launch log: {logpath}\")\n    if args.open:\n        threading.Timer(1.0, lambda: webbrowser.open(\n            f\"http://127.0.0.1:{args.port}\")).start()\n    try:\n        srv.serve_forever()\n    except KeyboardInterrupt:\n        pass\n    finally:\n        # checkpoint the launch partition at clean shutdown\n        preds = [\"persona:profile\", \"ui:shell-theme\", \"chat:response-depth\",\n                 \"roster:active\", \"seed:loaded\", \"chat:topic\"]\n        n = ctx.ledger.write_partition(ctx.partition_path, preds)\n        ctx.steward.stop()\n        log_line(logf, f\"shutdown — partition checkpointed ({n} rows)\")\n        logf.close()\nif __name__ == \"__main__\":\n    main()\n","_meta":{"cognition.ai/linesAdded":165,"cognition.ai/linesRemoved":384}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\ui\\app.js","oldText":"/* Vantage UI — every control works through the control itself (G-A). */\r\r\n\"use strict\";\r\r\n\r\r\nconst $ = id => document.getElementById(id);\r\r\nlet STATE = null;\r\r\nlet holdTab = \"personas\";\r\r\n\r\r\nasync function api(path, body) {\r\r\n  if (body === undefined) {\r\r\n    const r = await fetch(path);\r\r\n    return r.json();\r\r\n  }\r\r\n  const r = await fetch(path, {method:\"POST\",\r\r\n    headers:{\"Content-Type\":\"application/json\"}, body:JSON.stringify(body)});\r\r\n  return r.json();\r\r\n}\r\r\n\r\r\nfunction esc(s){ return String(s??\"\").replace(/[&<>\"]/g,\r\r\n  c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c])); }\r\r\n\r\r\nfunction artUrl(p){ return p.art && p.art.file ?\r\r\n  \"/api/artifact?path=\"+encodeURIComponent(p.art.file) : null; }\r\r\n\r\r\n// ---- theme control: drive the selector, observe the restyle ----------\r\r\nasync function applyTheme(t, persist=true) {\r\r\n  document.documentElement.setAttribute(\"data-theme\", t);\r\r\n  if (persist) {\r\r\n    // the same path the tool gate uses — a real config assertion, not a\r\r\n    // visual-only tweak\r\r\n    await api(\"/api/invoke\", {toolId:\"set-theme\", slots:{theme:t},\r\r\n      summary:\"theme selector\"});\r\r\n  }\r\r\n}\r\r\n\r\r\n// ---- tabs -------------------------------------------------------------\r\r\ndocument.querySelectorAll(\"#tabs button\").forEach(b => {\r\r\n  b.onclick = () => {\r\r\n    document.querySelectorAll(\"#tabs button\").forEach(x=>x.classList.remove(\"on\"));\r\r\n    b.classList.add(\"on\");\r\r\n    document.querySelectorAll(\"main > section\").forEach(s=>s.classList.add(\"hidden\"));\r\r\n    $(\"tab-\"+b.dataset.tab).classList.remove(\"hidden\");\r\r\n    if (b.dataset.tab===\"library\") loadHoldings();\r\r\n    if (b.dataset.tab===\"settings\") renderSettings();\r\r\n    if (b.dataset.tab===\"workshops\") renderTools();\r\r\n    if (b.dataset.tab===\"command\") renderCommand();\r\r\n    if (b.dataset.tab===\"inbox\") renderInbox();\r\r\n  };\r\r\n});\r\r\n\r\r\n// ---- roster (operable: select + reorder, all personas reachable) ------\r\r\nfunction renderRoster() {\r\r\n  const r = $(\"roster\");\r\r\n  r.innerHTML = \"\";\r\r\n  (STATE.roster||[]).forEach((p, i) => {\r\r\n    const d = document.createElement(\"div\");\r\r\n    d.className = \"pcard\" + (p.id===STATE.active ? \" active\":\"\");\r\r\n    const img = artUrl(p);\r\r\n    d.innerHTML =\r\r\n      (img?`<img src=\"${img}\">`:`<img src=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' fill='${encodeURIComponent(p.color)}'/></svg>\">`)+\r\r\n      `<div style=\"flex:1\"><div class=\"nm\">${esc(p.name)}${p.mark?' <span class=\"mark\">◆</span>':''}</div>`+\r\r\n      `<div class=\"reg\">${esc(p.register)} · conf ${p.heldConfidence}</div></div>`+\r\r\n      `<div class=\"mv\"><button data-mv=\"-1\" title=\"up\">▲</button><button data-mv=\"1\" title=\"down\">▼</button></div>`;\r\r\n    d.onclick = async e => {\r\r\n      const mv = e.target.dataset.mv;\r\r\n      if (mv !== undefined) {\r\r\n        await api(\"/api/roster/move\", {personaId:p.id, direction:+mv});\r\r\n      } else {\r\r\n        await api(\"/api/roster/select\", {personaId:p.id});\r\r\n      }\r\r\n      refresh();\r\r\n    };\r\r\n    d.ondblclick = () => openEditor(p.id);\r\r\n    r.appendChild(d);\r\r\n  });\r\r\n}\r\r\n\r\r\n// ---- stage strip (C-PresenceStage: current-discussion participants) ---\r\r\nfunction renderStage() {\r\r\n  const s = $(\"stage\");\r\r\n  const recent = (STATE.chat||[]).slice(-6).map(c=>c.persona||c.name);\r\r\n  const parts = [...new Set(recent)];\r\r\n  s.innerHTML = parts.length\r\r\n    ? \"<span class='small'>stage:</span> \" + parts.map(nm=>{\r\r\n        const p = (STATE.roster||[]).find(x=>x.name===nm)||{};\r\r\n        const img = artUrl(p);\r\r\n        return `<span class=\"stage-chip\">${img?`<img src=\"${img}\">`:\"\"}${esc(nm)}</span>`;\r\r\n      }).join(\"\")\r\r\n    : \"<span class='small'>stage: —</span>\";\r\r\n}\r\r\n\r\r\n// ---- chat feed --------------------------------------------------------\r\r\nfunction renderFeed() {\r\r\n  const f = $(\"feed\");\r\r\n  f.innerHTML = \"\";\r\r\n  (STATE.chat||[]).forEach(c => {\r\r\n    const d = document.createElement(\"div\");\r\r\n    d.className = \"msg\";\r\r\n    const p = (STATE.roster||[]).find(x=>x.id===c.persona) || {};\r\r\n    const img = artUrl(p);\r\r\n    d.innerHTML = `<div class=\"who\">${img?`<img class=\"art\" src=\"${img}\">`:\"\"}${esc(c.name)}`+\r\r\n      ` <span class=\"small\">${esc(c.register||\"\")}${c.reaction?\" · reaction\":\"\"}`+\r\r\n      `${c.contextCommentary?\" · on your selection\":\"\"}</span></div>`+\r\r\n      `<div class=\"txt\">${esc(c.text)}</div>`;\r\r\n    f.appendChild(d);\r\r\n  });\r\r\n  f.scrollTop = f.scrollHeight;\r\r\n}\r\r\n\r\r\n// ---- composer ----------------------------------------------------------\r\r\nasync function send() {\r\r\n  const text = $(\"msg\").value.trim();\r\r\n  if (!text) return;\r\r\n  $(\"msg\").value = \"\";\r\r\n  const feed = $(\"feed\");\r\r\n  const u = document.createElement(\"div\");\r\r\n  u.className = \"msg user\";\r\r\n  u.innerHTML = `<div class=\"who\">you</div><div class=\"txt\">${esc(text)}</div>`;\r\r\n  feed.appendChild(u); feed.scrollTop = feed.scrollHeight;\r\r\n  await api(\"/api/chat\", {text, address:$(\"address\").value||null});\r\r\n  refresh();\r\r\n}\r\r\n\r\r\n// ---- badges -------------------------------------------------------------\r\r\nfunction renderBadges() {\r\r\n  $(\"topicbadge\").classList.toggle(\"hidden\", !STATE.topic);\r\r\n  if (STATE.topic) $(\"topicbadge\").textContent = \"topic: \"+STATE.topic;\r\r\n  $(\"ctxbadge\").classList.toggle(\"hidden\", !STATE.context);\r\r\n  if (STATE.context) $(\"ctxbadge\").textContent = \"ctx: \"+STATE.context.label;\r\r\n  $(\"focusbadge\").classList.toggle(\"hidden\", !STATE.focusNeed);\r\r\n  if (STATE.focusNeed) $(\"focusbadge\").textContent = \"focus: \"+STATE.focusNeed;\r\r\n}\r\r\n\r\r\n// ---- inbox ---------------------------------------------------------------\r\r\nasync function renderInbox() {\r\r\n  const list = $(\"inboxList\");\r\r\n  list.innerHTML = \"\";\r\r\n  (STATE.inbox||[]).forEach((m, i) => {\r\r\n    const d = document.createElement(\"div\");\r\r\n    d.className = \"mailrow\";\r\r\n    d.innerHTML = `<b>${esc(m.subject)}</b><div class=\"meta\">${esc(m.from)} · ${esc(m.date||\"\")}</div>`;\r\r\n    d.onclick = async () => {\r\r\n      $(\"selctx\").textContent = m.subject+\" — \"+(m.body||\"\").slice(0,300);\r\r\n      const r = await api(\"/api/context/select\",\r\r\n        {kind:\"email\", ref:m.file||m.subject, label:m.subject,\r\r\n         excerpt:(m.body||\"\")});\r\r\n      if (r.result && r.result.commentary) {\r\r\n        $(\"ctxCommentary\").innerHTML =\r\r\n          `<div class=\"msg\"><div class=\"who\">${esc(r.result.commentary.persona)} `+\r\r\n          `<span class=\"small\">${esc(r.result.commentary.register)}</span></div>`+\r\r\n          `<div class=\"txt\">${esc(r.result.commentary.text)}</div></div>`;\r\r\n      }\r\r\n      refresh();\r\r\n    };\r\r\n    list.appendChild(d);\r\r\n  });\r\r\n  if (!list.children.length)\r\r\n    list.innerHTML = \"<div class='small'>no mail — drop .eml files into fixtures/inbox and re-scan</div>\";\r\r\n}\r\r\n\r\r\n// ---- command ---------------------------------------------------------------\r\r\nasync function renderCommand() {\r\r\n  const np = $(\"needs\"); np.innerHTML = \"\";\r\r\n  (STATE.needs||[]).forEach(n => {\r\r\n    const d = document.createElement(\"div\");\r\r\n    d.className = \"needrow\";\r\r\n    d.innerHTML = `<b>${esc(n.summary||n.toolId)}</b>\r\r\n      <div class=\"meta\">${n.toolId} · ${n.status}${n.missing&&n.missing.length?\r\r\n        \" · missing: \"+n.missing.join(\", \"):\"\"}</div>\r\r\n      <button data-f=\"focus\">focus</button>\r\r\n      <button data-f=\"retry\">retry</button>\r\r\n      <button data-f=\"cancel\">cancel</button>`;\r\r\n    d.querySelectorAll(\"button\").forEach(b=>{\r\r\n      b.onclick = async () => {\r\r\n        if (b.dataset.f===\"focus\") await api(`/api/needs/${n.id}/focus`,{});\r\r\n        if (b.dataset.f===\"retry\") await api(`/api/needs/${n.id}/retry`,{});\r\r\n        if (b.dataset.f===\"cancel\") await api(`/api/needs/${n.id}/cancel`,{});\r\r\n        refresh();\r\r\n      };\r\r\n    });\r\r\n    np.appendChild(d);\r\r\n  });\r\r\n  if (!np.children.length) np.innerHTML = \"<div class='small'>queue empty</div>\";\r\r\n\r\r\n  const pj = $(\"projects\"); pj.innerHTML = \"\";\r\r\n  (STATE.projects||[]).forEach(p => {\r\r\n    const d = document.createElement(\"div\");\r\r\n    d.className = \"projrow\";\r\r\n    d.innerHTML = `<b>${esc(p.title)}</b><div class=\"meta\">${esc(p.status||\"\")} · ${(p.goals||[]).join(\"; \")}</div>`;\r\r\n    pj.appendChild(d);\r\r\n  });\r\r\n  if (!pj.children.length) pj.innerHTML = \"<div class='small'>no projects</div>\";\r\r\n\r\r\n  const cal = await api(\"/api/calendar\");\r\r\n  const cc = $(\"cal\");\r\r\n  cc.innerHTML = [\"current\",\"upcoming\"].map(b =>\r\r\n    `<div class=\"small\"><b>${b}:</b> ` +\r\r\n    (cal[b]||[]).map(e=>esc(e.summary)).join(\"; \") + \"</div>\").join(\"\");\r\r\n\r\r\n  // grant requests: deferred needs awaiting authority\r\r\n  const gr = $(\"grantReqs\"); gr.innerHTML = \"\";\r\r\n  (STATE.needs||[]).filter(n=>n.status===\"deferred\").forEach(n=>{\r\r\n    const d = document.createElement(\"div\");\r\r\n    d.className = \"grant\";\r\r\n    d.innerHTML = `<b>${esc(n.summary)}</b> awaits a witnessed grant `+\r\r\n      `<button data-scope=\"publish.creator\">grant publish.creator</button> `+\r\r\n      `<button data-scope=\"mail.send\">grant mail.send</button>`;\r\r\n    d.querySelectorAll(\"button\").forEach(b=>{\r\r\n      b.onclick = async ()=>{\r\r\n        await api(\"/api/grants\",{scope:b.dataset.scope});\r\r\n        await api(`/api/needs/${n.id}/retry`,{});\r\r\n        refresh();\r\r\n      };\r\r\n    });\r\r\n    gr.appendChild(d);\r\r\n  });\r\r\n  if (!gr.children.length) gr.innerHTML=\"<div class='small'>none pending</div>\";\r\r\n}\r\r\n\r\r\n// ---- library (holdings — G-D) ----------------------------------------------\r\r\nasync function loadHoldings() {\r\r\n  const h = await api(\"/api/holdings\");\r\r\n  const nav = document.querySelectorAll(\"#libnav button\");\r\r\n  nav.forEach(b=>{ b.onclick = ()=>{\r\r\n    nav.forEach(x=>x.classList.remove(\"on\")); b.classList.add(\"on\");\r\r\n    holdTab = b.dataset.hold;\r\r\n    $(\"ledgerpane\").classList.toggle(\"hidden\", holdTab!==\"ledger\");\r\r\n    renderHoldings(h);\r\r\n  };});\r\r\n  renderHoldings(h);\r\r\n}\r\r\n\r\r\nfunction renderHoldings(h) {\r\r\n  const list = $(\"liblist\"), det = $(\"libdetail\");\r\r\n  list.innerHTML = \"\"; det.textContent = \"select a holding to inspect it\";\r\r\n  const add = (html, detail) => {\r\r\n    const d = document.createElement(\"div\");\r\r\n    d.className = \"hrow\"; d.innerHTML = html;\r\r\n    d.onclick = () => {\r\r\n      det.innerHTML = \"\";\r\r\n      const pre = document.createElement(\"div\");\r\r\n      pre.innerHTML = detail;\r\r\n      det.appendChild(pre);\r\r\n    };\r\r\n    list.appendChild(d);\r\r\n  };\r\r\n  if (holdTab===\"personas\") h.personas.forEach(p=>{\r\r\n    const img = artUrl(p);\r\r\n    add(`${img?`<img src=\"${img}\">`:\"\"}<b>${esc(p.name)}</b>\r\r\n      <div class=\"meta\">${esc(p.register)} · held-conf ${p.heldConfidence}${p.mark?\" · ◆ IMITATION\":\"\"}</div>`,\r\r\n      `<b>${esc(p.name)}</b>${img?`<img src=\"${img}\">`:\"\"}\r\r\n      register: ${esc(p.register)}\\ntraits: ${(p.traits||[]).join(\", \")}\r\r\n      interests: ${(p.interests||[]).join(\", \")}\\nvoice: ${JSON.stringify(p.voice)}\r\r\n      held-confidence: ${p.heldConfidence}\\ncharacterization:\r\r\n      ${esc(p.characterization||\"(none yet)\")}`);\r\r\n  });\r\r\n  if (holdTab===\"tools\") h.tools.forEach(t=>{\r\r\n    add(`<b>${esc(t.title)}</b><div class=\"meta\">${t.id} · need:${t.need||\"—\"}${t.authored?\" · authored\":\"\"}</div>`,\r\r\n      `<b>${esc(t.id)}</b>\\n${esc(t.title)}\\nneed: ${t.need||\"—\"}\\nslots: `+\r\r\n      (t.slots||[]).map(s=>s.name+(s.required?\"*\":\"\")).join(\", \"));\r\r\n  });\r\r\n  if (holdTab===\"packages\") h.packages.forEach(p=>{\r\r\n    add(`<b>${esc(p.id||\"pkg\")}</b><div class=\"meta\">${esc(p.schema||\"export\")} · ${JSON.stringify(p.counts||{})}</div>`,\r\r\n      JSON.stringify(p,null,2));\r\r\n  });\r\r\n  if (holdTab===\"artifacts\") h.artifacts.forEach(a=>{\r\r\n    add(`<b>${esc(a.name)}</b><div class=\"meta\">${a.kind} · ${a.bytes}b</div>`,\r\r\n      a.name.endsWith(\".svg\")?`<img src=\"/api/artifact?path=${encodeURIComponent(a.path)}\">`+esc(a.path):esc(a.path));\r\r\n  });\r\r\n  if (holdTab===\"needs\") h.openNeeds.forEach(n=>{\r\r\n    add(`<b>${esc(n.summary)}</b><div class=\"meta\">${n.toolId} · ${n.status}</div>`,\r\r\n      JSON.stringify(n,null,2));\r\r\n  });\r\r\n  if (holdTab===\"ledger\") {\r\r\n    det.textContent = `rows: ${h.ledger.rows}\\n\\nnamespaces:\\n`+\r\r\n      Object.entries(h.ledger.predicates).map(([k,v])=>`  ${k}: ${v}`).join(\"\\n\");\r\r\n    loadLedgerRows();\r\r\n  }\r\r\n}\r\r\n\r\r\nasync function loadLedgerRows() {\r\r\n  const ns = $(\"libns\");\r\r\n  const preds = await api(\"/api/predicates\");\r\r\n  ns.innerHTML = \"<option value=''>(all predicates)</option>\" +\r\r\n    preds.predicates.map(p=>`<option>${p}</option>`).join(\"\");\r\r\n  $(\"libSearch\").onclick = async ()=>{\r\r\n    const r = await api(\"/api/library?limit=60\"+\r\r\n      (ns.value?\"&predicate=\"+ns.value:\"\")+\r\r\n      ($(\"libq\").value?\"&text=\"+encodeURIComponent($(\"libq\").value):\"\"));\r\r\n    $(\"librows\").innerHTML = r.rows.map(a=>\r\r\n      `<div class=\"lrow\"><b>${a.predicate}</b> ${esc(a.subject)} `+\r\r\n      `<span class=\"small\">${a.claimant} · c=${a.certainty}</span><br>`+\r\r\n      `<span class=\"small\">${esc(JSON.stringify(a.value&&a.value.v)).slice(0,140)}</span></div>`).join(\"\");\r\r\n  };\r\r\n  $(\"libSearch\").onclick();\r\r\n  $(\"edGo\").onclick = async ()=>{\r\r\n    const r = await api(\"/api/library/assert\",\r\r\n      {subject:$(\"edSubj\").value, predicate:$(\"edPred\").value,\r\r\n       value:$(\"edVal\").value, certainty:+$(\"edCert\").value,\r\r\n       supersedes:$(\"edSup\").value||null});\r\r\n    $(\"edMsg\").textContent = JSON.stringify(r);\r\r\n    $(\"libSearch\").onclick();\r\r\n  };\r\r\n}\r\r\n\r\r\n// ---- workshops ---------------------------------------------------------------\r\r\nasync function renderTools() {\r\r\n  const t = await api(\"/api/tools\");\r\r\n  const list = $(\"toollist\"); list.innerHTML = \"\";\r\r\n  t.tools.forEach(tool=>{\r\r\n    const d = document.createElement(\"div\");\r\r\n    d.className = \"toolrow\";\r\r\n    d.innerHTML = `<b>${esc(tool.title)}</b><div class=\"meta\">${tool.id} · need:${tool.need||\"—\"}</div>`;\r\r\n    d.onclick = ()=>openWorkshop(tool);\r\r\n    list.appendChild(d);\r\r\n  });\r\r\n}\r\r\n\r\r\nfunction openWorkshop(tool) {\r\r\n  const w = $(\"workshop\");\r\r\n  w.innerHTML = `<h4>${esc(tool.title)}</h4>`;\r\r\n  const slots = (tool.template&&tool.template.slots)||[];\r\r\n  slots.forEach(s=>{\r\r\n    const row = document.createElement(\"div\");\r\r\n    row.className = \"slot\";\r\r\n    row.innerHTML = `<label>${s.name}${s.required?\"*\":\"\"}</label>\r\r\n      <input data-slot=\"${s.name}\" placeholder=\"${s.required?\"required\":\"optional\"}\">`;\r\r\n    w.appendChild(row);\r\r\n  });\r\r\n  const btn = document.createElement(\"button\");\r\r\n  btn.textContent = \"invoke\";\r\r\n  btn.onclick = async ()=>{\r\r\n    const slotsIn = {};\r\r\n    w.querySelectorAll(\"input[data-slot]\").forEach(i=>{\r\r\n      if (i.value) { try{slotsIn[i.dataset.slot]=JSON.parse(i.value);}\r\r\n        catch{slotsIn[i.dataset.slot]=i.value;} }\r\r\n    });\r\r\n    const r = await api(\"/api/invoke\",{toolId:tool.id,slots:slotsIn,\r\r\n      summary:\"workshop invoke\"});\r\r\n    const pre = document.createElement(\"pre\");\r\r\n    pre.textContent = JSON.stringify(r,null,2);\r\r\n    w.appendChild(pre);\r\r\n    refresh();\r\r\n  };\r\r\n  w.appendChild(btn);\r\r\n}\r\r\n\r\r\n// ---- settings --------------------------------------------------------------\r\r\nasync function renderSettings() {\r\r\n  const s = $(\"settings\");\r\r\n  s.innerHTML = `<h3>Preloads (named assertion bundles)</h3>`;\r\r\n  (STATE.preloads||[]).forEach(name=>{\r\r\n    const b = document.createElement(\"button\");\r\r\n    b.textContent = \"apply \"+name; b.style.marginRight=\"6px\";\r\r\n    b.onclick = async ()=>{\r\r\n      await api(\"/api/invoke\",{toolId:\"apply-preload\",slots:{name},\r\r\n        summary:\"settings preload\"});\r\r\n      refresh();\r\r\n    };\r\r\n    s.appendChild(b);\r\r\n  });\r\r\n  const st = document.createElement(\"div\");\r\r\n  st.innerHTML = `<h3>Runtime</h3>\r\r\n    <div class=\"slot\"><label>response depth</label>\r\r\n      <input id=\"setDepth\" type=\"number\" min=\"1\" max=\"4\" value=\"${STATE.responseDepth||2}\">\r\r\n      <button id=\"depthGo\">set</button></div>\r\r\n    <div class=\"slot\"><label>persona frame</label>\r\r\n      <select id=\"setFrame\"><option>respondent</option><option>personified</option></select>\r\r\n      <button id=\"frameGo\">set</button></div>\r\r\n    <h3>Steward duties</h3><div id=\"duties\"></div>\r\r\n    <h3>Declarations</h3>\r\r\n    <div class=\"small\">${(STATE.engines.declaredAbsences||[]).map(esc).join(\" · \")}</div>`;\r\r\n  s.appendChild(st);\r\r\n  $(\"setFrame\").value = STATE.frame||\"respondent\";\r\r\n  $(\"depthGo\").onclick = async ()=>{\r\r\n    await api(\"/api/invoke\",{toolId:\"set-response-depth\",\r\r\n      slots:{depth:+$(\"setDepth\").value},summary:\"settings\"});\r\r\n    refresh();};\r\r\n  $(\"frameGo\").onclick = async ()=>{\r\r\n    await api(\"/api/config\",{predicate:\"user:persona-frame\",\r\r\n      value:$(\"setFrame\").value}); refresh();};\r\r\n  [\"drain-needs\",\"temporal-attention\",\"inbox-scan\",\r\r\n   \"confidence-review\",\"compact-check\"].forEach(d=>{\r\r\n    const row = document.createElement(\"div\");\r\r\n    row.className = \"slot\";\r\r\n    row.innerHTML = `<label>${d}</label>\r\r\n      <button data-on=\"1\">on</button><button data-on=\"0\">off</button>`;\r\r\n    row.querySelectorAll(\"button\").forEach(b=>{\r\r\n      b.onclick = async ()=>{\r\r\n        await api(\"/api/invoke\",{toolId:\"assign-stewardship\",\r\r\n          slots:{duty:d,on:b.dataset.on===\"1\"},summary:\"settings\"});\r\r\n      };});\r\r\n    $(\"duties\").appendChild(row);\r\r\n  });\r\r\n}\r\r\n\r\r\n// ---- editor -------------------------------------------------------------------\r\r\nfunction openEditor(pid) {\r\r\n  const p = (STATE.roster||[]).find(x=>x.id===pid);\r\r\n  if (!p) return;\r\r\n  $(\"editor\").classList.remove(\"hidden\");\r\r\n  $(\"edTitle\").textContent = \"personality editor — \"+p.name;\r\r\n  const img = artUrl(p);\r\r\n  $(\"edPortrait\").innerHTML = img?`<img src=\"${img}\">`:\"(no portrait yet)\";\r\r\n  $(\"peName\").value = p.name;\r\r\n  $(\"peTraits\").value = (p.traits||[]).join(\", \");\r\r\n  $(\"peInterests\").value = (p.interests||[]).join(\", \");\r\r\n  $(\"peRegister\").value = p.register||\"measured\";\r\r\n  $(\"peResp\").value = \"\"; // filled below if present\r\r\n  $(\"peVoice\").value = (p.voice&&p.voice.name)||\"\";\r\r\n  $(\"peRate\").value = (p.voice&&p.voice.rate)||0;\r\r\n  $(\"peColor\").value = p.color||\"#457b9d\";\r\r\n  $(\"peConf\").value = p.heldConfidence;\r\r\n  $(\"peMode\").value = p.frame||\"respondent\";\r\r\n  $(\"peSave\").onclick = async ()=>{\r\r\n    const patch = {name:$(\"peName\").value,\r\r\n      traits:$(\"peTraits\").value.split(\",\").map(x=>x.trim()).filter(Boolean),\r\r\n      interests:$(\"peInterests\").value.split(\",\").map(x=>x.trim()).filter(Boolean),\r\r\n      register:$(\"peRegister\").value,\r\r\n      voice:{name:$(\"peVoice\").value||null,rate:+$(\"peRate\").value},\r\r\n      color:$(\"peColor\").value, frame:$(\"peMode\").value};\r\r\n    const r = await api(`/api/personas/${pid}/update`,{patch});\r\r\n    $(\"peMsg\").textContent = JSON.stringify(r.result||r,null,2).slice(0,600);\r\r\n    refresh();\r\r\n  };\r\r\n  $(\"peReart\").onclick = async ()=>{\r\r\n    const r = await api(\"/api/invoke\",{toolId:\"generate-portrait\",\r\r\n      slots:{personaId:pid},summary:\"editor reart\"});\r\r\n    $(\"peMsg\").textContent = JSON.stringify(r.result||r);\r\r\n    refresh();\r\r\n  };\r\r\n  $(\"peSpeak\").onclick = async ()=>{\r\r\n    await api(\"/api/invoke\",{toolId:\"speak-voice\",\r\r\n      slots:{text:\"This is \"+p.name+\" speaking.\",persona:p.name},\r\r\n      summary:\"editor speak\"});\r\r\n  };\r\r\n  $(\"peClose\").onclick = ()=>$(\"editor\").classList.add(\"hidden\");\r\r\n}\r\r\n\r\r\n// ---- exchange ------------------------------------------------------------------\r\r\n$(\"expBtn\").onclick = async ()=>{\r\r\n  const r = await api(\"/api/exchange/export\",{});\r\r\n  $(\"expMsg\").textContent = JSON.stringify(r.result||r);\r\r\n};\r\r\n$(\"impBtn\").onclick = async ()=>{\r\r\n  let pkg;\r\r\n  try { pkg = JSON.parse($(\"impPkg\").value); }\r\r\n  catch(e){ $(\"impMsg\").textContent = \"bad JSON: \"+e; return; }\r\r\n  const r = await api(\"/api/exchange/import\",{package:pkg});\r\r\n  $(\"impMsg\").textContent = JSON.stringify(r.result||r,null,2);\r\r\n};\r\r\n\r\r\n// ---- log ------------------------------------------------------------------------\r\r\n$(\"loggo\").onclick = async ()=>{\r\r\n  const r = await api(\"/api/log?kind=\"+$(\"logkind\").value);\r\r\n  $(\"log\").textContent = r.rows.map(a=>\r\r\n    `${a.predicate} [${a.claimant}] ${JSON.stringify(a.value).slice(0,220)}`)\r\r\n    .join(\"\\n\");\r\r\n};\r\r\n\r\r\n// ---- misc controls -----------------------------------------------------------------\r\r\n$(\"send\").onclick = send;\r\r\n$(\"msg\").addEventListener(\"keydown\", e=>{ if(e.key===\"Enter\") send(); });\r\r\n$(\"resetBtn\").onclick = async ()=>{ await api(\"/api/chat/reset\",{}); refresh(); };\r\r\n$(\"newProj\").onclick = async ()=>{\r\r\n  const title = prompt(\"project title:\"); if(!title) return;\r\r\n  const goals = prompt(\"goals (comma separated):\",\"\")||\"\";\r\r\n  await api(\"/api/invoke\",{toolId:\"create-project\",\r\r\n    slots:{title, goals:goals.split(\",\").map(x=>x.trim()).filter(Boolean)},\r\r\n    summary:\"ui create-project\"});\r\r\n  refresh();\r\r\n};\r\r\n$(\"mintBtn\").onclick = async ()=>{\r\r\n  const name = prompt(\"personality name:\"); if(!name) return;\r\r\n  const figure = prompt(\"modeled on a recognizable figure? (blank = original):\",\"\")||null;\r\r\n  const r = await api(\"/api/personas\",{name, figure});\r\r\n  const res = r.result||r;\r\r\n  if (res.admonishment) alert(\"Admonishment: \"+res.admonishment);\r\r\n  if (res.personaId)\r\r\n    await api(\"/api/invoke\",{toolId:\"persona-onboard\",\r\r\n      slots:{personaId:res.personaId},summary:\"ui onboard\"});\r\r\n  refresh();\r\r\n};\r\r\n$(\"allChatBtn\").onclick = async ()=>{\r\r\n  await api(\"/api/config\",{predicate:\"chat:all-chat\",value:true});\r\r\n  $(\"chatheadText\").textContent = \"Conversation (all respondents)\";\r\r\n};\r\r\n$(\"inboxRefresh\").onclick = async ()=>{\r\r\n  await api(\"/api/invoke\",{toolId:\"steward-tick\",slots:{},summary:\"inbox rescan\"});\r\r\n  refresh();\r\r\n};\r\r\n$(\"fsBtn\").onclick = ()=>{\r\r\n  if (document.fullscreenElement) document.exitFullscreen();\r\r\n  else document.documentElement.requestFullscreen();\r\r\n};\r\r\n$(\"themeSel\").onchange = e => applyTheme(e.target.value);\r\r\n\r\r\nlet rec = null;\r\r\n$(\"mic\").onclick = ()=>{\r\r\n  const SR = window.SpeechRecognition||window.webkitSpeechRecognition;\r\r\n  if (!SR) { alert(\"speech input: none declared on this browser\"); return; }\r\r\n  if (rec) { rec.stop(); rec=null; return; }\r\r\n  rec = new SR(); rec.lang=\"en-US\";\r\r\n  rec.onresult = async e=>{\r\r\n    const text = e.results[0][0].transcript;\r\r\n    await api(\"/api/transcribe\",{text});\r\r\n    refresh();\r\r\n  };\r\r\n  rec.onend = ()=>{ rec=null; };\r\r\n  rec.start();\r\r\n};\r\r\n\r\r\n// ---- refresh loop + SSE ------------------------------------------------------\r\r\nasync function refresh() {\r\r\n  try {\r\r\n    STATE = await api(\"/api/state\");\r\r\n  } catch(e) { return; }\r\r\n  renderRoster(); renderStage(); renderFeed(); renderBadges();\r\r\n  // status bar\r\r\n  $(\"sbVersion\").textContent = \"Vantage \"+STATE.version;\r\r\n  $(\"sbGate\").textContent = STATE.gate.passed ?\r\r\n    `gate PASS ${(STATE.gate.timeToGateMs/1000).toFixed(1)}s` : \"gate —\";\r\r\n  $(\"sbLLM\").textContent = \"llm: \"+(STATE.engines.llm&&STATE.engines.llm.mode);\r\r\n  $(\"sbSources\").textContent = \"sources: \"+\r\r\n    Object.keys(STATE.connectors||{}).join(\", \");\r\r\n  $(\"sbFloor\").textContent = \"floor: \"+STATE.speechFloor.depth+\" queued\";\r\r\n  $(\"sbNeeds\").textContent = \"needs: \"+STATE.needs.length+\" open\";\r\r\n  $(\"themeSel\").value = STATE.theme;\r\r\n  $(\"honesty\").textContent =\r\r\n    `llm ${STATE.engines.llm.mode} · tts ${STATE.engines.tts.mode}`+\r\r\n    ` · portrait ${STATE.engines.portrait.mode} · declared: `+\r\r\n    (STATE.engines.declaredAbsences||[]).join(\", \");\r\r\n  // quick-select options\r\r\n  const sel = $(\"address\");\r\r\n  const cur = sel.value;\r\r\n  sel.innerHTML = `<option value=\"\">auto</option>`+\r\r\n    (STATE.roster||[]).map(p=>`<option value=\"${p.id}\">${esc(p.name)}</option>`).join(\"\");\r\r\n  sel.value = cur;\r\r\n}\r\r\n\r\r\ntry {\r\r\n  const es = new EventSource(\"/api/events\");\r\r\n  es.onmessage = e => {\r\r\n    const ev = JSON.parse(e.data);\r\r\n    if (ev.kind===\"persona.speak\") refresh();\r\r\n    if (ev.kind===\"offer\") {\r\r\n      const f=$(\"feed\"), d=document.createElement(\"div\");\r\r\n      d.className=\"msg\"; d.innerHTML =\r\r\n        `<div class=\"who\">${esc(ev.payload.persona||\"steward\")} · offer</div>`+\r\r\n        `<div class=\"txt\">${esc(ev.payload.text)}</div>`;\r\r\n      f.appendChild(d); f.scrollTop=f.scrollHeight;\r\r\n    }\r\r\n  };\r\r\n} catch(e) {}\r\r\n\r\r\nrefresh();\r\r\nsetInterval(refresh, 5000);\r\r\n","newText":"/* Vantage UI — every control works through the control itself (G-A). */\n\"use strict\";\nconst $ = id => document.getElementById(id);\nlet STATE = null;\nlet holdTab = \"personas\";\nasync function api(path, body) {\n  if (body === undefined) {\n    const r = await fetch(path);\n    return r.json();\n  }\n  const r = await fetch(path, {method:\"POST\",\n    headers:{\"Content-Type\":\"application/json\"}, body:JSON.stringify(body)});\n  return r.json();\n}\nfunction esc(s){ return String(s??\"\").replace(/[&<>\"]/g,\n  c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c])); }\nfunction artUrl(p){ return p.art && p.art.file ?\n  \"/api/artifact?path=\"+encodeURIComponent(p.art.file) : null; }\n// ---- theme control: drive the selector, observe the restyle ----------\nasync function applyTheme(t, persist=true) {\n  document.documentElement.setAttribute(\"data-theme\", t);\n  if (persist) {\n    // the same path the tool gate uses — a real config assertion, not a\n    // visual-only tweak\n    await api(\"/api/invoke\", {toolId:\"set-theme\", slots:{theme:t},\n      summary:\"theme selector\"});\n  }\n}\n// ---- tabs -------------------------------------------------------------\ndocument.querySelectorAll(\"#tabs button\").forEach(b => {\n  b.onclick = () => {\n    document.querySelectorAll(\"#tabs button\").forEach(x=>x.classList.remove(\"on\"));\n    b.classList.add(\"on\");\n    document.querySelectorAll(\"main > section\").forEach(s=>s.classList.add(\"hidden\"));\n    $(\"tab-\"+b.dataset.tab).classList.remove(\"hidden\");\n    if (b.dataset.tab===\"library\") loadHoldings();\n    if (b.dataset.tab===\"settings\") renderSettings();\n    if (b.dataset.tab===\"workshops\") renderTools();\n    if (b.dataset.tab===\"command\") renderCommand();\n    if (b.dataset.tab===\"inbox\") renderInbox();\n  };\n});\n// ---- roster (operable: select + reorder, all personas reachable) ------\nfunction renderRoster() {\n  const r = $(\"roster\");\n  r.innerHTML = \"\";\n  (STATE.roster||[]).forEach((p, i) => {\n    const d = document.createElement(\"div\");\n    d.className = \"pcard\" + (p.id===STATE.active ? \" active\":\"\");\n    const img = artUrl(p);\n    d.innerHTML =\n      (img?`<img src=\"${img}\">`:`<img src=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' fill='${encodeURIComponent(p.color)}'/></svg>\">`)+\n      `<div style=\"flex:1\"><div class=\"nm\">${esc(p.name)}${p.mark?' <span class=\"mark\">◆</span>':''}</div>`+\n      `<div class=\"reg\">${esc(p.register)} · conf ${p.heldConfidence}</div></div>`+\n      `<div class=\"mv\"><button data-mv=\"-1\" title=\"up\">▲</button><button data-mv=\"1\" title=\"down\">▼</button></div>`;\n    d.onclick = async e => {\n      const mv = e.target.dataset.mv;\n      if (mv !== undefined) {\n        await api(\"/api/roster/move\", {personaId:p.id, direction:+mv});\n      } else {\n        await api(\"/api/roster/select\", {personaId:p.id});\n      }\n      refresh();\n    };\n    d.ondblclick = () => openEditor(p.id);\n    r.appendChild(d);\n  });\n}\n// ---- stage strip (C-PresenceStage: current-discussion participants) ---\nfunction renderStage() {\n  const s = $(\"stage\");\n  const recent = (STATE.chat||[]).slice(-6).map(c=>c.persona||c.name);\n  const parts = [...new Set(recent)];\n  s.innerHTML = parts.length\n    ? \"<span class='small'>stage:</span> \" + parts.map(nm=>{\n        const p = (STATE.roster||[]).find(x=>x.name===nm)||{};\n        const img = artUrl(p);\n        return `<span class=\"stage-chip\">${img?`<img src=\"${img}\">`:\"\"}${esc(nm)}</span>`;\n      }).join(\"\")\n    : \"<span class='small'>stage: —</span>\";\n}\n// ---- chat feed --------------------------------------------------------\nfunction renderFeed() {\n  const f = $(\"feed\");\n  f.innerHTML = \"\";\n  (STATE.chat||[]).forEach(c => {\n    const d = document.createElement(\"div\");\n    d.className = \"msg\";\n    const p = (STATE.roster||[]).find(x=>x.id===c.persona) || {};\n    const img = artUrl(p);\n    d.innerHTML = `<div class=\"who\">${img?`<img class=\"art\" src=\"${img}\">`:\"\"}${esc(c.name)}`+\n      ` <span class=\"small\">${esc(c.register||\"\")}${c.reaction?\" · reaction\":\"\"}`+\n      `${c.contextCommentary?\" · on your selection\":\"\"}</span></div>`+\n      `<div class=\"txt\">${esc(c.text)}</div>`;\n    f.appendChild(d);\n  });\n  f.scrollTop = f.scrollHeight;\n}\n// ---- composer ----------------------------------------------------------\nasync function send() {\n  const text = $(\"msg\").value.trim();\n  if (!text) return;\n  $(\"msg\").value = \"\";\n  const feed = $(\"feed\");\n  const u = document.createElement(\"div\");\n  u.className = \"msg user\";\n  u.innerHTML = `<div class=\"who\">you</div><div class=\"txt\">${esc(text)}</div>`;\n  feed.appendChild(u); feed.scrollTop = feed.scrollHeight;\n  await api(\"/api/chat\", {text, address:$(\"address\").value||null});\n  refresh();\n}\n// ---- badges -------------------------------------------------------------\nfunction renderBadges() {\n  $(\"topicbadge\").classList.toggle(\"hidden\", !STATE.topic);\n  if (STATE.topic) $(\"topicbadge\").textContent = \"topic: \"+STATE.topic;\n  $(\"ctxbadge\").classList.toggle(\"hidden\", !STATE.context);\n  if (STATE.context) $(\"ctxbadge\").textContent = \"ctx: \"+STATE.context.label;\n  $(\"focusbadge\").classList.toggle(\"hidden\", !STATE.focusNeed);\n  if (STATE.focusNeed) $(\"focusbadge\").textContent = \"focus: \"+STATE.focusNeed;\n}\n// ---- inbox ---------------------------------------------------------------\nasync function renderInbox() {\n  const list = $(\"inboxList\");\n  list.innerHTML = \"\";\n  (STATE.inbox||[]).forEach((m, i) => {\n    const d = document.createElement(\"div\");\n    d.className = \"mailrow\";\n    d.innerHTML = `<b>${esc(m.subject)}</b><div class=\"meta\">${esc(m.from)} · ${esc(m.date||\"\")}</div>`;\n    d.onclick = async () => {\n      $(\"selctx\").textContent = m.subject+\" — \"+(m.body||\"\").slice(0,300);\n      const r = await api(\"/api/context/select\",\n        {kind:\"email\", ref:m.file||m.subject, label:m.subject,\n         excerpt:(m.body||\"\")});\n      if (r.result && r.result.commentary) {\n        $(\"ctxCommentary\").innerHTML =\n          `<div class=\"msg\"><div class=\"who\">${esc(r.result.commentary.persona)} `+\n          `<span class=\"small\">${esc(r.result.commentary.register)}</span></div>`+\n          `<div class=\"txt\">${esc(r.result.commentary.text)}</div></div>`;\n      }\n      refresh();\n    };\n    list.appendChild(d);\n  });\n  if (!list.children.length)\n    list.innerHTML = \"<div class='small'>no mail — drop .eml files into fixtures/inbox and re-scan</div>\";\n}\n// ---- command ---------------------------------------------------------------\nasync function renderCommand() {\n  const np = $(\"needs\"); np.innerHTML = \"\";\n  (STATE.needs||[]).forEach(n => {\n    const d = document.createElement(\"div\");\n    d.className = \"needrow\";\n    d.innerHTML = `<b>${esc(n.summary||n.toolId)}</b>\n      <div class=\"meta\">${n.toolId} · ${n.status}${n.missing&&n.missing.length?\n        \" · missing: \"+n.missing.join(\", \"):\"\"}</div>\n      <button data-f=\"focus\">focus</button>\n      <button data-f=\"retry\">retry</button>\n      <button data-f=\"cancel\">cancel</button>`;\n    d.querySelectorAll(\"button\").forEach(b=>{\n      b.onclick = async () => {\n        if (b.dataset.f===\"focus\") await api(`/api/needs/${n.id}/focus`,{});\n        if (b.dataset.f===\"retry\") await api(`/api/needs/${n.id}/retry`,{});\n        if (b.dataset.f===\"cancel\") await api(`/api/needs/${n.id}/cancel`,{});\n        refresh();\n      };\n    });\n    np.appendChild(d);\n  });\n  if (!np.children.length) np.innerHTML = \"<div class='small'>queue empty</div>\";\n  const pj = $(\"projects\"); pj.innerHTML = \"\";\n  (STATE.projects||[]).forEach(p => {\n    const d = document.createElement(\"div\");\n    d.className = \"projrow\";\n    d.innerHTML = `<b>${esc(p.title)}</b><div class=\"meta\">${esc(p.status||\"\")} · ${(p.goals||[]).join(\"; \")}</div>`;\n    pj.appendChild(d);\n  });\n  if (!pj.children.length) pj.innerHTML = \"<div class='small'>no projects</div>\";\n  const cal = await api(\"/api/calendar\");\n  const cc = $(\"cal\");\n  cc.innerHTML = [\"current\",\"upcoming\"].map(b =>\n    `<div class=\"small\"><b>${b}:</b> ` +\n    (cal[b]||[]).map(e=>esc(e.summary)).join(\"; \") + \"</div>\").join(\"\");\n  // grant requests: deferred needs awaiting authority\n  const gr = $(\"grantReqs\"); gr.innerHTML = \"\";\n  (STATE.needs||[]).filter(n=>n.status===\"deferred\").forEach(n=>{\n    const d = document.createElement(\"div\");\n    d.className = \"grant\";\n    d.innerHTML = `<b>${esc(n.summary)}</b> awaits a witnessed grant `+\n      `<button data-scope=\"publish.creator\">grant publish.creator</button> `+\n      `<button data-scope=\"mail.send\">grant mail.send</button>`;\n    d.querySelectorAll(\"button\").forEach(b=>{\n      b.onclick = async ()=>{\n        await api(\"/api/grants\",{scope:b.dataset.scope});\n        await api(`/api/needs/${n.id}/retry`,{});\n        refresh();\n      };\n    });\n    gr.appendChild(d);\n  });\n  if (!gr.children.length) gr.innerHTML=\"<div class='small'>none pending</div>\";\n}\n// ---- library (holdings — G-D) ----------------------------------------------\nasync function loadHoldings() {\n  const h = await api(\"/api/holdings\");\n  const nav = document.querySelectorAll(\"#libnav button\");\n  nav.forEach(b=>{ b.onclick = ()=>{\n    nav.forEach(x=>x.classList.remove(\"on\")); b.classList.add(\"on\");\n    holdTab = b.dataset.hold;\n    $(\"ledgerpane\").classList.toggle(\"hidden\", holdTab!==\"ledger\");\n    renderHoldings(h);\n  };});\n  renderHoldings(h);\n}\nfunction renderHoldings(h) {\n  const list = $(\"liblist\"), det = $(\"libdetail\");\n  list.innerHTML = \"\"; det.textContent = \"select a holding to inspect it\";\n  const add = (html, detail) => {\n    const d = document.createElement(\"div\");\n    d.className = \"hrow\"; d.innerHTML = html;\n    d.onclick = () => {\n      det.innerHTML = \"\";\n      const pre = document.createElement(\"div\");\n      pre.innerHTML = detail;\n      det.appendChild(pre);\n    };\n    list.appendChild(d);\n  };\n  if (holdTab===\"personas\") h.personas.forEach(p=>{\n    const img = artUrl(p);\n    add(`${img?`<img src=\"${img}\">`:\"\"}<b>${esc(p.name)}</b>\n      <div class=\"meta\">${esc(p.register)} · held-conf ${p.heldConfidence}${p.mark?\" · ◆ IMITATION\":\"\"}</div>`,\n      `<b>${esc(p.name)}</b>${img?`<img src=\"${img}\">`:\"\"}\n      register: ${esc(p.register)}\\ntraits: ${(p.traits||[]).join(\", \")}\n      interests: ${(p.interests||[]).join(\", \")}\\nvoice: ${JSON.stringify(p.voice)}\n      held-confidence: ${p.heldConfidence}\\ncharacterization:\n      ${esc(p.characterization||\"(none yet)\")}`);\n  });\n  if (holdTab===\"tools\") h.tools.forEach(t=>{\n    add(`<b>${esc(t.title)}</b><div class=\"meta\">${t.id} · need:${t.need||\"—\"}${t.authored?\" · authored\":\"\"}</div>`,\n      `<b>${esc(t.id)}</b>\\n${esc(t.title)}\\nneed: ${t.need||\"—\"}\\nslots: `+\n      (t.slots||[]).map(s=>s.name+(s.required?\"*\":\"\")).join(\", \"));\n  });\n  if (holdTab===\"packages\") h.packages.forEach(p=>{\n    add(`<b>${esc(p.id||\"pkg\")}</b><div class=\"meta\">${esc(p.schema||\"export\")} · ${JSON.stringify(p.counts||{})}</div>`,\n      JSON.stringify(p,null,2));\n  });\n  if (holdTab===\"artifacts\") h.artifacts.forEach(a=>{\n    add(`<b>${esc(a.name)}</b><div class=\"meta\">${a.kind} · ${a.bytes}b</div>`,\n      a.name.endsWith(\".svg\")?`<img src=\"/api/artifact?path=${encodeURIComponent(a.path)}\">`+esc(a.path):esc(a.path));\n  });\n  if (holdTab===\"needs\") h.openNeeds.forEach(n=>{\n    add(`<b>${esc(n.summary)}</b><div class=\"meta\">${n.toolId} · ${n.status}</div>`,\n      JSON.stringify(n,null,2));\n  });\n  if (holdTab===\"ledger\") {\n    det.textContent = `rows: ${h.ledger.rows}\\n\\nnamespaces:\\n`+\n      Object.entries(h.ledger.predicates).map(([k,v])=>`  ${k}: ${v}`).join(\"\\n\");\n    loadLedgerRows();\n  }\n}\nasync function loadLedgerRows() {\n  const ns = $(\"libns\");\n  const preds = await api(\"/api/predicates\");\n  ns.innerHTML = \"<option value=''>(all predicates)</option>\" +\n    preds.predicates.map(p=>`<option>${p}</option>`).join(\"\");\n  $(\"libSearch\").onclick = async ()=>{\n    const r = await api(\"/api/library?limit=60\"+\n      (ns.value?\"&predicate=\"+ns.value:\"\")+\n      ($(\"libq\").value?\"&text=\"+encodeURIComponent($(\"libq\").value):\"\"));\n    $(\"librows\").innerHTML = r.rows.map(a=>\n      `<div class=\"lrow\"><b>${a.predicate}</b> ${esc(a.subject)} `+\n      `<span class=\"small\">${a.claimant} · c=${a.certainty}</span><br>`+\n      `<span class=\"small\">${esc(JSON.stringify(a.value&&a.value.v)).slice(0,140)}</span></div>`).join(\"\");\n  };\n  $(\"libSearch\").onclick();\n  $(\"edGo\").onclick = async ()=>{\n    const r = await api(\"/api/library/assert\",\n      {subject:$(\"edSubj\").value, predicate:$(\"edPred\").value,\n       value:$(\"edVal\").value, certainty:+$(\"edCert\").value,\n       supersedes:$(\"edSup\").value||null});\n    $(\"edMsg\").textContent = JSON.stringify(r);\n    $(\"libSearch\").onclick();\n  };\n}\n// ---- workshops ---------------------------------------------------------------\nasync function renderTools() {\n  const t = await api(\"/api/tools\");\n  const list = $(\"toollist\"); list.innerHTML = \"\";\n  t.tools.forEach(tool=>{\n    const d = document.createElement(\"div\");\n    d.className = \"toolrow\";\n    d.innerHTML = `<b>${esc(tool.title)}</b><div class=\"meta\">${tool.id} · need:${tool.need||\"—\"}</div>`;\n    d.onclick = ()=>openWorkshop(tool);\n    list.appendChild(d);\n  });\n}\nfunction openWorkshop(tool) {\n  const w = $(\"workshop\");\n  w.innerHTML = `<h4>${esc(tool.title)}</h4>`;\n  const slots = (tool.template&&tool.template.slots)||[];\n  slots.forEach(s=>{\n    const row = document.createElement(\"div\");\n    row.className = \"slot\";\n    row.innerHTML = `<label>${s.name}${s.required?\"*\":\"\"}</label>\n      <input data-slot=\"${s.name}\" placeholder=\"${s.required?\"required\":\"optional\"}\">`;\n    w.appendChild(row);\n  });\n  const btn = document.createElement(\"button\");\n  btn.textContent = \"invoke\";\n  btn.onclick = async ()=>{\n    const slotsIn = {};\n    w.querySelectorAll(\"input[data-slot]\").forEach(i=>{\n      if (i.value) { try{slotsIn[i.dataset.slot]=JSON.parse(i.value);}\n        catch{slotsIn[i.dataset.slot]=i.value;} }\n    });\n    const r = await api(\"/api/invoke\",{toolId:tool.id,slots:slotsIn,\n      summary:\"workshop invoke\"});\n    const pre = document.createElement(\"pre\");\n    pre.textContent = JSON.stringify(r,null,2);\n    w.appendChild(pre);\n    refresh();\n  };\n  w.appendChild(btn);\n}\n// ---- settings --------------------------------------------------------------\nasync function renderSettings() {\n  const s = $(\"settings\");\n  s.innerHTML = `<h3>Preloads (named assertion bundles)</h3>`;\n  (STATE.preloads||[]).forEach(name=>{\n    const b = document.createElement(\"button\");\n    b.textContent = \"apply \"+name; b.style.marginRight=\"6px\";\n    b.onclick = async ()=>{\n      await api(\"/api/invoke\",{toolId:\"apply-preload\",slots:{name},\n        summary:\"settings preload\"});\n      refresh();\n    };\n    s.appendChild(b);\n  });\n  const st = document.createElement(\"div\");\n  st.innerHTML = `<h3>Runtime</h3>\n    <div class=\"slot\"><label>response depth</label>\n      <input id=\"setDepth\" type=\"number\" min=\"1\" max=\"4\" value=\"${STATE.responseDepth||2}\">\n      <button id=\"depthGo\">set</button></div>\n    <div class=\"slot\"><label>persona frame</label>\n      <select id=\"setFrame\"><option>respondent</option><option>personified</option></select>\n      <button id=\"frameGo\">set</button></div>\n    <h3>Steward duties</h3><div id=\"duties\"></div>\n    <h3>Declarations</h3>\n    <div class=\"small\">${(STATE.engines.declaredAbsences||[]).map(esc).join(\" · \")}</div>`;\n  s.appendChild(st);\n  $(\"setFrame\").value = STATE.frame||\"respondent\";\n  $(\"depthGo\").onclick = async ()=>{\n    await api(\"/api/invoke\",{toolId:\"set-response-depth\",\n      slots:{depth:+$(\"setDepth\").value},summary:\"settings\"});\n    refresh();};\n  $(\"frameGo\").onclick = async ()=>{\n    await api(\"/api/config\",{predicate:\"user:persona-frame\",\n      value:$(\"setFrame\").value}); refresh();};\n  [\"drain-needs\",\"temporal-attention\",\"inbox-scan\",\n   \"confidence-review\",\"compact-check\"].forEach(d=>{\n    const row = document.createElement(\"div\");\n    row.className = \"slot\";\n    row.innerHTML = `<label>${d}</label>\n      <button data-on=\"1\">on</button><button data-on=\"0\">off</button>`;\n    row.querySelectorAll(\"button\").forEach(b=>{\n      b.onclick = async ()=>{\n        await api(\"/api/invoke\",{toolId:\"assign-stewardship\",\n          slots:{duty:d,on:b.dataset.on===\"1\"},summary:\"settings\"});\n      };});\n    $(\"duties\").appendChild(row);\n  });\n}\n// ---- editor -------------------------------------------------------------------\nfunction openEditor(pid) {\n  const p = (STATE.roster||[]).find(x=>x.id===pid);\n  if (!p) return;\n  $(\"editor\").classList.remove(\"hidden\");\n  $(\"edTitle\").textContent = \"personality editor — \"+p.name;\n  const img = artUrl(p);\n  $(\"edPortrait\").innerHTML = img?`<img src=\"${img}\">`:\"(no portrait yet)\";\n  $(\"peName\").value = p.name;\n  $(\"peTraits\").value = (p.traits||[]).join(\", \");\n  $(\"peInterests\").value = (p.interests||[]).join(\", \");\n  $(\"peRegister\").value = p.register||\"measured\";\n  $(\"peResp\").value = \"\"; // filled below if present\n  $(\"peVoice\").value = (p.voice&&p.voice.name)||\"\";\n  $(\"peRate\").value = (p.voice&&p.voice.rate)||0;\n  $(\"peColor\").value = p.color||\"#457b9d\";\n  $(\"peConf\").value = p.heldConfidence;\n  $(\"peMode\").value = p.frame||\"respondent\";\n  $(\"peSave\").onclick = async ()=>{\n    const patch = {name:$(\"peName\").value,\n      traits:$(\"peTraits\").value.split(\",\").map(x=>x.trim()).filter(Boolean),\n      interests:$(\"peInterests\").value.split(\",\").map(x=>x.trim()).filter(Boolean),\n      register:$(\"peRegister\").value,\n      voice:{name:$(\"peVoice\").value||null,rate:+$(\"peRate\").value},\n      color:$(\"peColor\").value, frame:$(\"peMode\").value};\n    const r = await api(`/api/personas/${pid}/update`,{patch});\n    $(\"peMsg\").textContent = JSON.stringify(r.result||r,null,2).slice(0,600);\n    refresh();\n  };\n  $(\"peReart\").onclick = async ()=>{\n    const r = await api(\"/api/invoke\",{toolId:\"generate-portrait\",\n      slots:{personaId:pid},summary:\"editor reart\"});\n    $(\"peMsg\").textContent = JSON.stringify(r.result||r);\n    refresh();\n  };\n  $(\"peSpeak\").onclick = async ()=>{\n    await api(\"/api/invoke\",{toolId:\"speak-voice\",\n      slots:{text:\"This is \"+p.name+\" speaking.\",persona:p.name},\n      summary:\"editor speak\"});\n  };\n  $(\"peClose\").onclick = ()=>$(\"editor\").classList.add(\"hidden\");\n}\n// ---- exchange ------------------------------------------------------------------\n$(\"expBtn\").onclick = async ()=>{\n  const r = await api(\"/api/exchange/export\",{});\n  $(\"expMsg\").textContent = JSON.stringify(r.result||r);\n};\n$(\"impBtn\").onclick = async ()=>{\n  let pkg;\n  try { pkg = JSON.parse($(\"impPkg\").value); }\n  catch(e){ $(\"impMsg\").textContent = \"bad JSON: \"+e; return; }\n  const r = await api(\"/api/exchange/import\",{package:pkg});\n  $(\"impMsg\").textContent = JSON.stringify(r.result||r,null,2);\n};\n// ---- log ------------------------------------------------------------------------\n$(\"loggo\").onclick = async ()=>{\n  const r = await api(\"/api/log?kind=\"+$(\"logkind\").value);\n  $(\"log\").textContent = r.rows.map(a=>\n    `${a.predicate} [${a.claimant}] ${JSON.stringify(a.value).slice(0,220)}`)\n    .join(\"\\n\");\n};\n// ---- misc controls -----------------------------------------------------------------\n$(\"send\").onclick = send;\n$(\"msg\").addEventListener(\"keydown\", e=>{ if(e.key===\"Enter\") send(); });\n$(\"resetBtn\").onclick = async ()=>{ await api(\"/api/chat/reset\",{}); refresh(); };\n$(\"newProj\").onclick = async ()=>{\n  const title = prompt(\"project title:\"); if(!title) return;\n  const goals = prompt(\"goals (comma separated):\",\"\")||\"\";\n  await api(\"/api/invoke\",{toolId:\"create-project\",\n    slots:{title, goals:goals.split(\",\").map(x=>x.trim()).filter(Boolean)},\n    summary:\"ui create-project\"});\n  refresh();\n};\n$(\"mintBtn\").onclick = async ()=>{\n  const name = prompt(\"personality name:\"); if(!name) return;\n  const figure = prompt(\"modeled on a recognizable figure? (blank = original):\",\"\")||null;\n  const r = await api(\"/api/personas\",{name, figure});\n  const res = r.result||r;\n  if (res.admonishment) alert(\"Admonishment: \"+res.admonishment);\n  if (res.personaId)\n    await api(\"/api/invoke\",{toolId:\"persona-onboard\",\n      slots:{personaId:res.personaId},summary:\"ui onboard\"});\n  refresh();\n};\n$(\"allChatBtn\").onclick = async ()=>{\n  await api(\"/api/config\",{predicate:\"chat:all-chat\",value:true});\n  $(\"chatheadText\").textContent = \"Conversation (all respondents)\";\n};\n$(\"inboxRefresh\").onclick = async ()=>{\n  await api(\"/api/invoke\",{toolId:\"steward-tick\",slots:{},summary:\"inbox rescan\"});\n  refresh();\n};\n$(\"fsBtn\").onclick = ()=>{\n  if (document.fullscreenElement) document.exitFullscreen();\n  else document.documentElement.requestFullscreen();\n};\n$(\"themeSel\").onchange = e => applyTheme(e.target.value);\nlet rec = null;\n$(\"mic\").onclick = ()=>{\n  const SR = window.SpeechRecognition||window.webkitSpeechRecognition;\n  if (!SR) { alert(\"speech input: none declared on this browser\"); return; }\n  if (rec) { rec.stop(); rec=null; return; }\n  rec = new SR(); rec.lang=\"en-US\";\n  rec.onresult = async e=>{\n    const text = e.results[0][0].transcript;\n    await api(\"/api/transcribe\",{text});\n    refresh();\n  };\n  rec.onend = ()=>{ rec=null; };\n  rec.start();\n};\n// ---- refresh loop + SSE ------------------------------------------------------\nasync function refresh() {\n  try {\n    STATE = await api(\"/api/state\");\n  } catch(e) { return; }\n  renderRoster(); renderStage(); renderFeed(); renderBadges();\n  // status bar\n  $(\"sbVersion\").textContent = \"Vantage \"+STATE.version;\n  $(\"sbGate\").textContent = STATE.gate.passed ?\n    `gate PASS ${(STATE.gate.timeToGateMs/1000).toFixed(1)}s` : \"gate —\";\n  $(\"sbLLM\").textContent = \"llm: \"+(STATE.engines.llm&&STATE.engines.llm.mode);\n  $(\"sbSources\").textContent = \"sources: \"+\n    Object.keys(STATE.connectors||{}).join(\", \");\n  $(\"sbFloor\").textContent = \"floor: \"+STATE.speechFloor.depth+\" queued\";\n  $(\"sbNeeds\").textContent = \"needs: \"+STATE.needs.length+\" open\";\n  $(\"themeSel\").value = STATE.theme;\n  $(\"honesty\").textContent =\n    `llm ${STATE.engines.llm.mode} · tts ${STATE.engines.tts.mode}`+\n    ` · portrait ${STATE.engines.portrait.mode} · declared: `+\n    (STATE.engines.declaredAbsences||[]).join(\", \");\n  // quick-select options\n  const sel = $(\"address\");\n  const cur = sel.value;\n  sel.innerHTML = `<option value=\"\">auto</option>`+\n    (STATE.roster||[]).map(p=>`<option value=\"${p.id}\">${esc(p.name)}</option>`).join(\"\");\n  sel.value = cur;\n}\ntry {\n  const es = new EventSource(\"/api/events\");\n  es.onmessage = e => {\n    const ev = JSON.parse(e.data);\n    if (ev.kind===\"persona.speak\") refresh();\n    if (ev.kind===\"offer\") {\n      const f=$(\"feed\"), d=document.createElement(\"div\");\n      d.className=\"msg\"; d.innerHTML =\n        `<div class=\"who\">${esc(ev.payload.persona||\"steward\")} · offer</div>`+\n        `<div class=\"txt\">${esc(ev.payload.text)}</div>`;\n      f.appendChild(d); f.scrollTop=f.scrollHeight;\n    }\n  };\n} catch(e) {}\nrefresh();\nsetInterval(refresh, 5000);\n","_meta":{"cognition.ai/linesAdded":526,"cognition.ai/linesRemoved":1112}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\ui\\index.html","oldText":"<!doctype html>\r\r\n<html>\r\r\n<head>\r\r\n<meta charset=\"utf-8\">\r\r\n<title>Vantage</title>\r\r\n<link rel=\"stylesheet\" href=\"/ui/styles.css\">\r\r\n</head>\r\r\n<body>\r\r\n<header id=\"honesty\"></header>\r\r\n<div id=\"app\">\r\r\n  <aside id=\"rail\">\r\r\n    <h2>ROSTER <span id=\"frameTag\"></span></h2>\r\r\n    <div class=\"hint\">click = select &middot; &#9650;&#9660; = reorder</div>\r\r\n    <div id=\"roster\"></div>\r\r\n    <button id=\"mintBtn\">+ mint personality</button>\r\r\n    <button id=\"allChatBtn\">ALL CHAT</button>\r\r\n  </aside>\r\r\n  <main>\r\r\n    <nav id=\"tabs\">\r\r\n      <button data-tab=\"chat\" class=\"on\">Chat</button>\r\r\n      <button data-tab=\"inbox\">Inbox</button>\r\r\n      <button data-tab=\"command\">Command</button>\r\r\n      <button data-tab=\"library\">Library</button>\r\r\n      <button data-tab=\"workshops\">Workshops</button>\r\r\n      <button data-tab=\"exchange\">Exchange</button>\r\r\n      <button data-tab=\"settings\">Settings</button>\r\r\n      <button data-tab=\"log\">Log</button>\r\r\n    </nav>\r\r\n    <section id=\"tab-chat\">\r\r\n      <div id=\"stage\"></div>\r\r\n      <div id=\"chathead\"><span id=\"chatheadText\">Conversation</span>\r\r\n        <span id=\"topicbadge\" class=\"hidden\"></span>\r\r\n        <span id=\"ctxbadge\" class=\"hidden\"></span>\r\r\n        <span id=\"focusbadge\" class=\"hidden\"></span>\r\r\n        <button id=\"resetBtn\" title=\"seal this conversation and clear context\">reset conversation</button>\r\r\n      </div>\r\r\n      <div id=\"feed\"></div>\r\r\n      <div id=\"composer\">\r\r\n        <select id=\"address\" title=\"quick-select a respondent (chorus on address)\"><option value=\"\">auto</option></select>\r\r\n        <button id=\"mic\" title=\"push to talk (browser Web Speech API, or declared-none)\">&#x1F3A4;</button>\r\r\n        <input id=\"msg\" placeholder=\"type an input — requests work AND conversation\">\r\r\n        <button id=\"send\">send</button>\r\r\n      </div>\r\r\n    </section>\r\r\n    <section id=\"tab-inbox\" class=\"hidden\">\r\r\n      <div class=\"cols\">\r\r\n        <div><h3>Mailbox <span id=\"inboxSrc\" class=\"small\"></span>\r\r\n          <button id=\"inboxRefresh\">re-scan</button></h3>\r\r\n          <div id=\"inboxList\"></div></div>\r\r\n        <div><h3>Selected context</h3>\r\r\n          <div id=\"selctx\" class=\"small\">nothing selected — pick an email to pull\r\r\n            it into conversational context; the active respondent comments.</div>\r\r\n          <div id=\"ctxCommentary\"></div></div>\r\r\n      </div>\r\r\n    </section>\r\r\n    <section id=\"tab-command\" class=\"hidden\">\r\r\n      <div class=\"cols\">\r\r\n        <div><h3>Projects <button id=\"newProj\">+ create project</button></h3>\r\r\n          <div id=\"projects\"></div></div>\r\r\n        <div><h3>Open needs (queue)</h3><div id=\"needs\"></div></div>\r\r\n        <div><h3>Focus / calendar</h3><div id=\"focus\"></div><div id=\"cal\"></div>\r\r\n          <h3>Grant requests</h3><div id=\"grantReqs\"></div></div>\r\r\n      </div>\r\r\n    </section>\r\r\n    <section id=\"tab-library\" class=\"hidden\">\r\r\n      <div class=\"liblayout\">\r\r\n        <div id=\"libnav\">\r\r\n          <h3>Holdings</h3>\r\r\n          <button data-hold=\"personas\" class=\"on\">Personalities</button>\r\r\n          <button data-hold=\"tools\">Tools</button>\r\r\n          <button data-hold=\"packages\">Packages</button>\r\r\n          <button data-hold=\"artifacts\">Artifacts</button>\r\r\n          <button data-hold=\"needs\">Open needs</button>\r\r\n          <button data-hold=\"ledger\">Ledger</button>\r\r\n        </div>\r\r\n        <div id=\"libmain\">\r\r\n          <div id=\"liblist\"></div>\r\r\n          <div id=\"libdetail\" class=\"small\"></div>\r\r\n        </div>\r\r\n      </div>\r\r\n      <div id=\"ledgerpane\" class=\"hidden\">\r\r\n        <input id=\"libq\" placeholder=\"search ledger text\"><button id=\"libSearch\">search</button>\r\r\n        <select id=\"libns\"><option value=\"\">(all predicates)</option></select>\r\r\n        <div id=\"librows\"></div>\r\r\n        <h3>Edit assertion (append-only)</h3>\r\r\n        <input id=\"edSubj\" placeholder=\"subject\"><input id=\"edPred\" placeholder=\"predicate ns:name\">\r\r\n        <input id=\"edVal\" placeholder=\"value\"><input id=\"edCert\" placeholder=\"certainty 0-1\" value=\"0.9\">\r\r\n        <input id=\"edSup\" placeholder=\"supersedes id (optional)\">\r\r\n        <button id=\"edGo\">append assertion</button><div id=\"edMsg\"></div>\r\r\n      </div>\r\r\n    </section>\r\r\n    <section id=\"tab-workshops\" class=\"hidden\">\r\r\n      <div class=\"cols\">\r\r\n        <div><h3>Tools</h3><div id=\"toollist\"></div></div>\r\r\n        <div><h3>Workshop</h3><div id=\"workshop\"></div>\r\r\n          <h3>Author a tool</h3>\r\r\n          <textarea id=\"newspec\" rows=\"8\" placeholder='{\"id\":\"my-tool\",\"title\":\"...\",\"template\":{\"slots\":[{\"name\":\"x\",\"required\":true}]},\"steps\":[{\"op\":\"result\",\"value\":\"hi\"}]}'></textarea>\r\r\n          <button id=\"validateSpec\">validate</button><button id=\"mintSpec\">mint tool</button>\r\r\n          <pre id=\"specMsg\"></pre></div>\r\r\n      </div>\r\r\n    </section>\r\r\n    <section id=\"tab-exchange\" class=\"hidden\">\r\r\n      <h3>Exchange packages</h3>\r\r\n      <button id=\"expBtn\">export package</button><span id=\"expMsg\"></span>\r\r\n      <h4>Import (vantage.exchange/v1 JSON)</h4>\r\r\n      <textarea id=\"impPkg\" rows=\"8\" placeholder='{\"schema\":\"vantage.exchange/v1\",\"id\":\"pkg-1\",\"personas\":[],\"tools\":[],\"assertions\":[],\"needs\":[]}'></textarea>\r\r\n      <button id=\"impBtn\">import below threshold</button><pre id=\"impMsg\"></pre>\r\r\n      <div id=\"impList\"></div>\r\r\n    </section>\r\r\n    <section id=\"tab-settings\" class=\"hidden\">\r\r\n      <div id=\"settings\"></div>\r\r\n    </section>\r\r\n    <section id=\"tab-log\" class=\"hidden\">\r\r\n      <div id=\"logctl\">\r\r\n        <select id=\"logkind\"><option value=\"traces\">turn traces</option>\r\r\n          <option value=\"decisions\">decision scores</option>\r\r\n          <option value=\"respondents\">respondents</option>\r\r\n          <option value=\"steward\">steward runs</option>\r\r\n          <option value=\"churn\">trust churn</option>\r\r\n          <option value=\"inference\">inference commits</option>\r\r\n          <option value=\"floor\">speech floor</option>\r\r\n          <option value=\"fidelity\">fidelity flags</option></select>\r\r\n        <button id=\"loggo\">load</button></div>\r\r\n      <pre id=\"log\"></pre>\r\r\n    </section>\r\r\n  </main>\r\r\n</div>\r\r\n<footer id=\"statusbar\">\r\r\n  <span id=\"sbVersion\"></span><span id=\"sbGate\"></span>\r\r\n  <span id=\"sbLLM\"></span><span id=\"sbSources\"></span>\r\r\n  <span id=\"sbFloor\"></span><span id=\"sbNeeds\"></span>\r\r\n  <span class=\"sb-right\">\r\r\n    <button id=\"fsBtn\" title=\"full screen\">&#x26F6;</button>\r\r\n    <label for=\"themeSel\">theme</label>\r\r\n    <select id=\"themeSel\">\r\r\n      <option value=\"light\">light</option>\r\r\n      <option value=\"dark\">dark</option>\r\r\n      <option value=\"sepia\">sepia</option>\r\r\n      <option value=\"slate\">slate</option>\r\r\n    </select>\r\r\n  </span>\r\r\n</footer>\r\r\n<div id=\"editor\" class=\"hidden\">\r\r\n  <div id=\"editorCard\">\r\r\n    <h3 id=\"edTitle\">personality editor</h3>\r\r\n    <div id=\"edPortrait\"></div>\r\r\n    <div class=\"edgrid\">\r\r\n      <label>name</label><input id=\"peName\">\r\r\n      <label>traits (comma)</label><input id=\"peTraits\">\r\r\n      <label>interests (comma)</label><input id=\"peInterests\">\r\r\n      <label>voice register</label>\r\r\n      <select id=\"peRegister\"><option>clipped</option><option>scholarly</option>\r\r\n        <option>catalogue</option><option>wry</option><option>warm</option>\r\r\n        <option>measured</option><option>expansive</option></select>\r\r\n      <label>responsibilities (comma)</label><input id=\"peResp\">\r\r\n      <label>voice name</label><input id=\"peVoice\" placeholder=\"e.g. Microsoft Zira Desktop\">\r\r\n      <label>voice rate (-10..10)</label><input id=\"peRate\" type=\"number\" min=\"-10\" max=\"10\">\r\r\n      <label>color</label><input id=\"peColor\" type=\"color\">\r\r\n      <label>held confidence (0-1)</label><input id=\"peConf\" type=\"number\" step=\"0.05\" min=\"0\" max=\"1\">\r\r\n      <label>display mode</label>\r\r\n      <select id=\"peMode\"><option>respondent</option><option>personified</option></select>\r\r\n    </div>\r\r\n    <div class=\"edbtns\">\r\r\n      <button id=\"peSave\">save</button>\r\r\n      <button id=\"peReart\">regenerate portrait</button>\r\r\n      <button id=\"peSpeak\">speak</button>\r\r\n      <button id=\"peClose\">close</button>\r\r\n    </div>\r\r\n    <pre id=\"peMsg\"></pre>\r\r\n  </div>\r\r\n</div>\r\r\n<script src=\"/ui/app.js\"></script>\r\r\n</body>\r\r\n</html>\r\r\n","newText":"<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Vantage</title>\n<link rel=\"stylesheet\" href=\"/ui/styles.css\">\n</head>\n<body>\n<header id=\"honesty\"></header>\n<div id=\"app\">\n  <aside id=\"rail\">\n    <h2>ROSTER <span id=\"frameTag\"></span></h2>\n    <div class=\"hint\">click = select &middot; &#9650;&#9660; = reorder</div>\n    <div id=\"roster\"></div>\n    <button id=\"mintBtn\">+ mint personality</button>\n    <button id=\"allChatBtn\">ALL CHAT</button>\n  </aside>\n  <main>\n    <nav id=\"tabs\">\n      <button data-tab=\"chat\" class=\"on\">Chat</button>\n      <button data-tab=\"inbox\">Inbox</button>\n      <button data-tab=\"command\">Command</button>\n      <button data-tab=\"library\">Library</button>\n      <button data-tab=\"workshops\">Workshops</button>\n      <button data-tab=\"exchange\">Exchange</button>\n      <button data-tab=\"settings\">Settings</button>\n      <button data-tab=\"log\">Log</button>\n    </nav>\n    <section id=\"tab-chat\">\n      <div id=\"stage\"></div>\n      <div id=\"chathead\"><span id=\"chatheadText\">Conversation</span>\n        <span id=\"topicbadge\" class=\"hidden\"></span>\n        <span id=\"ctxbadge\" class=\"hidden\"></span>\n        <span id=\"focusbadge\" class=\"hidden\"></span>\n        <button id=\"resetBtn\" title=\"seal this conversation and clear context\">reset conversation</button>\n      </div>\n      <div id=\"feed\"></div>\n      <div id=\"composer\">\n        <select id=\"address\" title=\"quick-select a respondent (chorus on address)\"><option value=\"\">auto</option></select>\n        <button id=\"mic\" title=\"push to talk (browser Web Speech API, or declared-none)\">&#x1F3A4;</button>\n        <input id=\"msg\" placeholder=\"type an input — requests work AND conversation\">\n        <button id=\"send\">send</button>\n      </div>\n    </section>\n    <section id=\"tab-inbox\" class=\"hidden\">\n      <div class=\"cols\">\n        <div><h3>Mailbox <span id=\"inboxSrc\" class=\"small\"></span>\n          <button id=\"inboxRefresh\">re-scan</button></h3>\n          <div id=\"inboxList\"></div></div>\n        <div><h3>Selected context</h3>\n          <div id=\"selctx\" class=\"small\">nothing selected — pick an email to pull\n            it into conversational context; the active respondent comments.</div>\n          <div id=\"ctxCommentary\"></div></div>\n      </div>\n    </section>\n    <section id=\"tab-command\" class=\"hidden\">\n      <div class=\"cols\">\n        <div><h3>Projects <button id=\"newProj\">+ create project</button></h3>\n          <div id=\"projects\"></div></div>\n        <div><h3>Open needs (queue)</h3><div id=\"needs\"></div></div>\n        <div><h3>Focus / calendar</h3><div id=\"focus\"></div><div id=\"cal\"></div>\n          <h3>Grant requests</h3><div id=\"grantReqs\"></div></div>\n      </div>\n    </section>\n    <section id=\"tab-library\" class=\"hidden\">\n      <div class=\"liblayout\">\n        <div id=\"libnav\">\n          <h3>Holdings</h3>\n          <button data-hold=\"personas\" class=\"on\">Personalities</button>\n          <button data-hold=\"tools\">Tools</button>\n          <button data-hold=\"packages\">Packages</button>\n          <button data-hold=\"artifacts\">Artifacts</button>\n          <button data-hold=\"needs\">Open needs</button>\n          <button data-hold=\"ledger\">Ledger</button>\n        </div>\n        <div id=\"libmain\">\n          <div id=\"liblist\"></div>\n          <div id=\"libdetail\" class=\"small\"></div>\n        </div>\n      </div>\n      <div id=\"ledgerpane\" class=\"hidden\">\n        <input id=\"libq\" placeholder=\"search ledger text\"><button id=\"libSearch\">search</button>\n        <select id=\"libns\"><option value=\"\">(all predicates)</option></select>\n        <div id=\"librows\"></div>\n        <h3>Edit assertion (append-only)</h3>\n        <input id=\"edSubj\" placeholder=\"subject\"><input id=\"edPred\" placeholder=\"predicate ns:name\">\n        <input id=\"edVal\" placeholder=\"value\"><input id=\"edCert\" placeholder=\"certainty 0-1\" value=\"0.9\">\n        <input id=\"edSup\" placeholder=\"supersedes id (optional)\">\n        <button id=\"edGo\">append assertion</button><div id=\"edMsg\"></div>\n      </div>\n    </section>\n    <section id=\"tab-workshops\" class=\"hidden\">\n      <div class=\"cols\">\n        <div><h3>Tools</h3><div id=\"toollist\"></div></div>\n        <div><h3>Workshop</h3><div id=\"workshop\"></div>\n          <h3>Author a tool</h3>\n          <textarea id=\"newspec\" rows=\"8\" placeholder='{\"id\":\"my-tool\",\"title\":\"...\",\"template\":{\"slots\":[{\"name\":\"x\",\"required\":true}]},\"steps\":[{\"op\":\"result\",\"value\":\"hi\"}]}'></textarea>\n          <button id=\"validateSpec\">validate</button><button id=\"mintSpec\">mint tool</button>\n          <pre id=\"specMsg\"></pre></div>\n      </div>\n    </section>\n    <section id=\"tab-exchange\" class=\"hidden\">\n      <h3>Exchange packages</h3>\n      <button id=\"expBtn\">export package</button><span id=\"expMsg\"></span>\n      <h4>Import (vantage.exchange/v1 JSON)</h4>\n      <textarea id=\"impPkg\" rows=\"8\" placeholder='{\"schema\":\"vantage.exchange/v1\",\"id\":\"pkg-1\",\"personas\":[],\"tools\":[],\"assertions\":[],\"needs\":[]}'></textarea>\n      <button id=\"impBtn\">import below threshold</button><pre id=\"impMsg\"></pre>\n      <div id=\"impList\"></div>\n    </section>\n    <section id=\"tab-settings\" class=\"hidden\">\n      <div id=\"settings\"></div>\n    </section>\n    <section id=\"tab-log\" class=\"hidden\">\n      <div id=\"logctl\">\n        <select id=\"logkind\"><option value=\"traces\">turn traces</option>\n          <option value=\"decisions\">decision scores</option>\n          <option value=\"respondents\">respondents</option>\n          <option value=\"steward\">steward runs</option>\n          <option value=\"churn\">trust churn</option>\n          <option value=\"inference\">inference commits</option>\n          <option value=\"floor\">speech floor</option>\n          <option value=\"fidelity\">fidelity flags</option></select>\n        <button id=\"loggo\">load</button></div>\n      <pre id=\"log\"></pre>\n    </section>\n  </main>\n</div>\n<footer id=\"statusbar\">\n  <span id=\"sbVersion\"></span><span id=\"sbGate\"></span>\n  <span id=\"sbLLM\"></span><span id=\"sbSources\"></span>\n  <span id=\"sbFloor\"></span><span id=\"sbNeeds\"></span>\n  <span class=\"sb-right\">\n    <button id=\"fsBtn\" title=\"full screen\">&#x26F6;</button>\n    <label for=\"themeSel\">theme</label>\n    <select id=\"themeSel\">\n      <option value=\"light\">light</option>\n      <option value=\"dark\">dark</option>\n      <option value=\"sepia\">sepia</option>\n      <option value=\"slate\">slate</option>\n    </select>\n  </span>\n</footer>\n<div id=\"editor\" class=\"hidden\">\n  <div id=\"editorCard\">\n    <h3 id=\"edTitle\">personality editor</h3>\n    <div id=\"edPortrait\"></div>\n    <div class=\"edgrid\">\n      <label>name</label><input id=\"peName\">\n      <label>traits (comma)</label><input id=\"peTraits\">\n      <label>interests (comma)</label><input id=\"peInterests\">\n      <label>voice register</label>\n      <select id=\"peRegister\"><option>clipped</option><option>scholarly</option>\n        <option>catalogue</option><option>wry</option><option>warm</option>\n        <option>measured</option><option>expansive</option></select>\n      <label>responsibilities (comma)</label><input id=\"peResp\">\n      <label>voice name</label><input id=\"peVoice\" placeholder=\"e.g. Microsoft Zira Desktop\">\n      <label>voice rate (-10..10)</label><input id=\"peRate\" type=\"number\" min=\"-10\" max=\"10\">\n      <label>color</label><input id=\"peColor\" type=\"color\">\n      <label>held confidence (0-1)</label><input id=\"peConf\" type=\"number\" step=\"0.05\" min=\"0\" max=\"1\">\n      <label>display mode</label>\n      <select id=\"peMode\"><option>respondent</option><option>personified</option></select>\n    </div>\n    <div class=\"edbtns\">\n      <button id=\"peSave\">save</button>\n      <button id=\"peReart\">regenerate portrait</button>\n      <button id=\"peSpeak\">speak</button>\n      <button id=\"peClose\">close</button>\n    </div>\n    <pre id=\"peMsg\"></pre>\n  </div>\n</div>\n<script src=\"/ui/app.js\"></script>\n</body>\n</html>\n","_meta":{"cognition.ai/linesAdded":174,"cognition.ai/linesRemoved":348}},{"type":"diff","path":"C:\\builds\\project\\version 0.3.0.004\\app\\ui\\styles.css","oldText":"/* Vantage shell — declared presentation choice set (C-DeclaredPresentation).\r\r\n   Colorways resolve through ui:shell-theme; the selector drives\r\r\n   documentElement[data-theme] AND records the config assertion. */\r\r\n:root {\r\r\n  --font: \"Segoe UI\", \"Inter\", system-ui, sans-serif;\r\r\n}\r\r\nhtml[data-theme=\"light\"] {\r\r\n  --bg:#f4f2ee; --panel:#ffffff; --ink:#1d1d22; --mut:#6b6b73;\r\r\n  --line:#d8d4cc; --accent:#2a6f9e; --badge:#eef3f6; --card:#fdfcf9;\r\r\n}\r\r\nhtml[data-theme=\"dark\"] {\r\r\n  --bg:#15161a; --panel:#1e2026; --ink:#e4e4ea; --mut:#909098;\r\r\n  --line:#33363f; --accent:#6fb3e0; --badge:#262a33; --card:#22242b;\r\r\n}\r\r\nhtml[data-theme=\"sepia\"] {\r\r\n  --bg:#efe6d8; --panel:#f7efe0; --ink:#3a2f22; --mut:#8a7a62;\r\r\n  --line:#d9c9ac; --accent:#8a5a2a; --badge:#eee2c8; --card:#faf3e3;\r\r\n}\r\r\nhtml[data-theme=\"slate\"] {\r\r\n  --bg:#dfe4e8; --panel:#eef1f4; --ink:#1f2a33; --mut:#5d6d78;\r\r\n  --line:#bfc9d1; --accent:#33657d; --badge:#dbe3e8; --card:#f4f7f9;\r\r\n}\r\r\n* { box-sizing: border-box; }\r\r\nbody { margin:0; font-family:var(--font); background:var(--bg);\r\r\n       color:var(--ink); display:flex; flex-direction:column;\r\r\n       height:100vh; overflow:hidden; }\r\r\n#honesty { padding:6px 12px; background:var(--panel); color:var(--mut);\r\r\n           font-size:12px; border-bottom:1px solid var(--line); }\r\r\n#app { flex:1; display:flex; min-height:0; }\r\r\n#rail { width:230px; background:var(--panel); border-right:1px solid var(--line);\r\r\n        padding:10px; overflow-y:auto; }\r\r\n#rail h2 { font-size:13px; letter-spacing:1px; margin:0 0 2px; }\r\r\n.hint { font-size:10px; color:var(--mut); margin-bottom:8px; }\r\r\n#rail button { width:100%; margin-top:8px; }\r\r\n.pcard { display:flex; gap:8px; align-items:center; padding:6px;\r\r\n         border:1px solid var(--line); border-radius:8px; margin-bottom:6px;\r\r\n         background:var(--card); cursor:pointer; }\r\r\n.pcard.active { border-color:var(--accent); box-shadow:0 0 0 1px var(--accent); }\r\r\n.pcard img { width:44px; height:44px; border-radius:6px; }\r\r\n.pcard .nm { font-weight:600; font-size:13px; }\r\r\n.pcard .reg { font-size:10px; color:var(--mut); }\r\r\n.pcard .mv { display:flex; flex-direction:column; }\r\r\n.pcard .mv button { padding:0 4px; margin:0; font-size:9px; line-height:1.2;\r\r\n                    width:auto; }\r\r\nmain { flex:1; display:flex; flex-direction:column; min-width:0; }\r\r\n#tabs { display:flex; gap:2px; padding:6px 10px 0; background:var(--panel);\r\r\n        border-bottom:1px solid var(--line); }\r\r\n#tabs button { border:none; background:transparent; color:var(--mut);\r\r\n               padding:8px 14px; cursor:pointer; font-size:13px; }\r\r\n#tabs button.on { color:var(--accent); border-bottom:2px solid var(--accent); }\r\r\nsection { flex:1; overflow-y:auto; padding:12px; }\r\r\n.hidden { display:none !important; }\r\r\n.cols { display:grid; grid-template-columns:1fr 1fr; gap:16px; }\r\r\n.cols > div { min-width:0; }\r\r\nh3 { font-size:13px; margin:14px 0 8px; }\r\r\n.small { font-size:11px; color:var(--mut); }\r\r\nbutton { background:var(--badge); color:var(--ink); border:1px solid var(--line);\r\r\n         border-radius:6px; padding:5px 10px; cursor:pointer; font-size:12px; }\r\r\nbutton:hover { border-color:var(--accent); }\r\r\ninput, select, textarea { background:var(--card); color:var(--ink);\r\r\n  border:1px solid var(--line); border-radius:6px; padding:6px 8px;\r\r\n  font-size:13px; font-family:inherit; }\r\r\n#stage { display:flex; gap:8px; padding:4px 0 8px; min-height:30px;\r\r\n         align-items:center; }\r\r\n.stage-chip { display:flex; align-items:center; gap:5px; font-size:11px;\r\r\n              background:var(--badge); padding:3px 8px; border-radius:12px; }\r\r\n.stage-chip img { width:18px; height:18px; border-radius:4px; }\r\r\n#chathead { display:flex; align-items:center; gap:8px; padding:4px 0;\r\r\n            font-size:13px; font-weight:600; }\r\r\n#chathead button { margin-left:auto; font-size:11px; }\r\r\n#topicbadge, #ctxbadge, #focusbadge { background:var(--badge); font-size:10px;\r\r\n  font-weight:400; padding:2px 8px; border-radius:10px; color:var(--mut); }\r\r\n#feed { border:1px solid var(--line); border-radius:8px; background:var(--card);\r\r\n        min-height:200px; max-height:52vh; overflow-y:auto; padding:10px; }\r\r\n.msg { margin-bottom:10px; }\r\r\n.msg .who { font-size:10px; color:var(--mut); margin-bottom:2px; }\r\r\n.msg .txt { font-size:13px; line-height:1.45; white-space:pre-wrap; }\r\r\n.msg.user .txt { color:var(--accent); }\r\r\n.msg .art { width:20px; height:20px; border-radius:4px; vertical-align:-5px;\r\r\n            margin-right:6px; }\r\r\n.mark { color:#b8860b; font-size:10px; }\r\r\n#composer { display:flex; gap:6px; padding-top:8px; }\r\r\n#composer input { flex:1; }\r\r\n#statusbar { display:flex; gap:14px; padding:6px 12px; background:var(--panel);\r\r\n             border-top:1px solid var(--line); font-size:11px; color:var(--mut);\r\r\n             align-items:center; }\r\r\n.sb-right { margin-left:auto; display:flex; gap:8px; align-items:center; }\r\r\n.needrow, .projrow, .mailrow, .toolrow, .pkrow {\r\r\n  border:1px solid var(--line); border-radius:6px; padding:6px 8px;\r\r\n  margin-bottom:6px; background:var(--card); font-size:12px; }\r\r\n.needrow .meta { font-size:10px; color:var(--mut); }\r\r\n.needrow button { font-size:10px; padding:2px 6px; margin-left:4px; }\r\r\n.liblayout { display:grid; grid-template-columns:140px 1fr; gap:14px; }\r\r\n#libnav button { display:block; width:100%; text-align:left; margin-bottom:4px; }\r\r\n#libnav button.on { border-color:var(--accent); color:var(--accent); }\r\r\n#libmain { display:grid; grid-template-columns:1fr 1fr; gap:12px; }\r\r\n#liblist .hrow { border:1px solid var(--line); border-radius:6px; padding:6px;\r\r\n                 margin-bottom:6px; background:var(--card); cursor:pointer;\r\r\n                 font-size:12px; }\r\r\n#liblist .hrow:hover { border-color:var(--accent); }\r\r\n#liblist .hrow img { width:30px; height:30px; border-radius:4px;\r\r\n                     vertical-align:middle; margin-right:6px; }\r\r\n#libdetail { border-left:1px solid var(--line); padding-left:12px;\r\r\n             font-size:12px; white-space:pre-wrap; overflow:auto;\r\r\n             max-height:60vh; }\r\r\n#libdetail img { max-width:180px; display:block; margin:8px 0; }\r\r\n#ledgerpane { margin-top:16px; border-top:1px solid var(--line);\r\r\n              padding-top:10px; }\r\r\n#librows { max-height:40vh; overflow:auto; font-size:11px; }\r\r\n.lrow { border-bottom:1px solid var(--line); padding:3px 0; }\r\r\npre { background:var(--badge); padding:8px; border-radius:6px;\r\r\n      font-size:11px; overflow:auto; }\r\r\n#editor { position:fixed; inset:0; background:rgba(0,0,0,0.4);\r\r\n          display:flex; align-items:center; justify-content:center; }\r\r\n#editorCard { background:var(--panel); border-radius:10px; padding:18px;\r\r\n              width:520px; max-height:86vh; overflow-y:auto; }\r\r\n#edPortrait img { width:120px; height:120px; border-radius:8px; }\r\r\n.edgrid { display:grid; grid-template-columns:150px 1fr; gap:8px;\r\r\n          margin-top:12px; align-items:center; }\r\r\n.edgrid label { font-size:11px; color:var(--mut); text-align:right; }\r\r\n.edbtns { display:flex; gap:8px; margin-top:14px; }\r\r\n.grant { border:1px dashed var(--accent); padding:8px; border-radius:6px;\r\r\n         margin-bottom:6px; font-size:12px; }\r\r\n.slot { display:flex; gap:6px; margin-bottom:4px; align-items:center; }\r\r\n.slot label { font-size:11px; width:110px; color:var(--mut); }\r\r\n","newText":"/* Vantage shell — declared presentation choice set (C-DeclaredPresentation).\n   Colorways resolve through ui:shell-theme; the selector drives\n   documentElement[data-theme] AND records the config assertion. */\n:root {\n  --font: \"Segoe UI\", \"Inter\", system-ui, sans-serif;\n}\nhtml[data-theme=\"light\"] {\n  --bg:#f4f2ee; --panel:#ffffff; --ink:#1d1d22; --mut:#6b6b73;\n  --line:#d8d4cc; --accent:#2a6f9e; --badge:#eef3f6; --card:#fdfcf9;\n}\nhtml[data-theme=\"dark\"] {\n  --bg:#15161a; --panel:#1e2026; --ink:#e4e4ea; --mut:#909098;\n  --line:#33363f; --accent:#6fb3e0; --badge:#262a33; --card:#22242b;\n}\nhtml[data-theme=\"sepia\"] {\n  --bg:#efe6d8; --panel:#f7efe0; --ink:#3a2f22; --mut:#8a7a62;\n  --line:#d9c9ac; --accent:#8a5a2a; --badge:#eee2c8; --card:#faf3e3;\n}\nhtml[data-theme=\"slate\"] {\n  --bg:#dfe4e8; --panel:#eef1f4; --ink:#1f2a33; --mut:#5d6d78;\n  --line:#bfc9d1; --accent:#33657d; --badge:#dbe3e8; --card:#f4f7f9;\n}\n* { box-sizing: border-box; }\nbody { margin:0; font-family:var(--font); background:var(--bg);\n       color:var(--ink); display:flex; flex-direction:column;\n       height:100vh; overflow:hidden; }\n#honesty { padding:6px 12px; background:var(--panel); color:var(--mut);\n           font-size:12px; border-bottom:1px solid var(--line); }\n#app { flex:1; display:flex; min-height:0; }\n#rail { width:230px; background:var(--panel); border-right:1px solid var(--line);\n        padding:10px; overflow-y:auto; }\n#rail h2 { font-size:13px; letter-spacing:1px; margin:0 0 2px; }\n.hint { font-size:10px; color:var(--mut); margin-bottom:8px; }\n#rail button { width:100%; margin-top:8px; }\n.pcard { display:flex; gap:8px; align-items:center; padding:6px;\n         border:1px solid var(--line); border-radius:8px; margin-bottom:6px;\n         background:var(--card); cursor:pointer; }\n.pcard.active { border-color:var(--accent); box-shadow:0 0 0 1px var(--accent); }\n.pcard img { width:44px; height:44px; border-radius:6px; }\n.pcard .nm { font-weight:600; font-size:13px; }\n.pcard .reg { font-size:10px; color:var(--mut); }\n.pcard .mv { display:flex; flex-direction:column; }\n.pcard .mv button { padding:0 4px; margin:0; font-size:9px; line-height:1.2;\n                    width:auto; }\nmain { flex:1; display:flex; flex-direction:column; min-width:0; }\n#tabs { display:flex; gap:2px; padding:6px 10px 0; background:var(--panel);\n        border-bottom:1px solid var(--line); }\n#tabs button { border:none; background:transparent; color:var(--mut);\n               padding:8px 14px; cursor:pointer; font-size:13px; }\n#tabs button.on { color:var(--accent); border-bottom:2px solid var(--accent); }\nsection { flex:1; overflow-y:auto; padding:12px; }\n.hidden { display:none !important; }\n.cols { display:grid; grid-template-columns:1fr 1fr; gap:16px; }\n.cols > div { min-width:0; }\nh3 { font-size:13px; margin:14px 0 8px; }\n.small { font-size:11px; color:var(--mut); }\nbutton { background:var(--badge); color:var(--ink); border:1px solid var(--line);\n         border-radius:6px; padding:5px 10px; cursor:pointer; font-size:12px; }\nbutton:hover { border-color:var(--accent); }\ninput, select, textarea { background:var(--card); color:var(--ink);\n  border:1px solid var(--line); border-radius:6px; padding:6px 8px;\n  font-size:13px; font-family:inherit; }\n#stage { display:flex; gap:8px; padding:4px 0 8px; min-height:30px;\n         align-items:center; }\n.stage-chip { display:flex; align-items:center; gap:5px; font-size:11px;\n              background:var(--badge); padding:3px 8px; border-radius:12px; }\n.stage-chip img { width:18px; height:18px; border-radius:4px; }\n#chathead { display:flex; align-items:center; gap:8px; padding:4px 0;\n            font-size:13px; font-weight:600; }\n#chathead button { margin-left:auto; font-size:11px; }\n#topicbadge, #ctxbadge, #focusbadge { background:var(--badge); font-size:10px;\n  font-weight:400; padding:2px 8px; border-radius:10px; color:var(--mut); }\n#feed { border:1px solid var(--line); border-radius:8px; background:var(--card);\n        min-height:200px; max-height:52vh; overflow-y:auto; padding:10px; }\n.msg { margin-bottom:10px; }\n.msg .who { font-size:10px; color:var(--mut); margin-bottom:2px; }\n.msg .txt { font-size:13px; line-height:1.45; white-space:pre-wrap; }\n.msg.user .txt { color:var(--accent); }\n.msg .art { width:20px; height:20px; border-radius:4px; vertical-align:-5px;\n            margin-right:6px; }\n.mark { color:#b8860b; font-size:10px; }\n#composer { display:flex; gap:6px; padding-top:8px; }\n#composer input { flex:1; }\n#statusbar { display:flex; gap:14px; padding:6px 12px; background:var(--panel);\n             border-top:1px solid var(--line); font-size:11px; color:var(--mut);\n             align-items:center; }\n.sb-right { margin-left:auto; display:flex; gap:8px; align-items:center; }\n.needrow, .projrow, .mailrow, .toolrow, .pkrow {\n  border:1px solid var(--line); border-radius:6px; padding:6px 8px;\n  margin-bottom:6px; background:var(--card); font-size:12px; }\n.needrow .meta { font-size:10px; color:var(--mut); }\n.needrow button { font-size:10px; padding:2px 6px; margin-left:4px; }\n.liblayout { display:grid; grid-template-columns:140px 1fr; gap:14px; }\n#libnav button { display:block; width:100%; text-align:left; margin-bottom:4px; }\n#libnav button.on { border-color:var(--accent); color:var(--accent); }\n#libmain { display:grid; grid-template-columns:1fr 1fr; gap:12px; }\n#liblist .hrow { border:1px solid var(--line); border-radius:6px; padding:6px;\n                 margin-bottom:6px; background:var(--card); cursor:pointer;\n                 font-size:12px; }\n#liblist .hrow:hover { border-color:var(--accent); }\n#liblist .hrow img { width:30px; height:30px; border-radius:4px;\n                     vertical-align:middle; margin-right:6px; }\n#libdetail { border-left:1px solid var(--line); padding-left:12px;\n             font-size:12px; white-space:pre-wrap; overflow:auto;\n             max-height:60vh; }\n#libdetail img { max-width:180px; display:block; margin:8px 0; }\n#ledgerpane { margin-top:16px; border-top:1px solid var(--line);\n              padding-top:10px; }\n#librows { max-height:40vh; overflow:auto; font-size:11px; }\n.lrow { border-bottom:1px solid var(--line); padding:3px 0; }\npre { background:var(--badge); padding:8px; border-radius:6px;\n      font-size:11px; overflow:auto; }\n#editor { position:fixed; inset:0; background:rgba(0,0,0,0.4);\n          display:flex; align-items:center; justify-content:center; }\n#editorCard { background:var(--panel); border-radius:10px; padding:18px;\n              width:520px; max-height:86vh