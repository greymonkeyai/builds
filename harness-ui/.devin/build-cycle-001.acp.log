($ccid)) { [void]$convIds.Add($ccid) }\n            }\n        }\n        $vscen = GP $sp.verdict 'scenarios'\n        if ($vscen) {\n            foreach ($sc in $vscen) {\n                $scid = GP $sc 'id'\n                $has = $false\n                foreach ($sx in $suite) { if ($sx.id -eq $scid) { $has = $true } }\n                if (-not $has -and $scid) { [void]$suite.Add(@{ id = $scid; title = '(scored; not in suite file)' }) }\n            }\n        }\"\"\")\n\ns = s.replace(\"\"\"    $lastVerdict = $null\n    foreach ($sp in $series) { if ($sp.verdict_ok -and $null -ne $sp.verdict.overall) { $lastVerdict = $sp } }\"\"\",\n\"\"\"    $lastVerdict = $null\n    foreach ($sp in $series) { if ($sp.verdict_ok -and $null -ne (GP $sp.verdict 'overall')) { $lastVerdict = $sp } }\"\"\")\n\ns = s.replace(\"\"\"        last_verdict = $(if ($lastVerdict) { @{ label = $lastVerdict.label; overall = $lastVerdict.verdict.overall; judge = $lastVerdict.verdict.judge_model; date = $lastVerdict.date } } else { $null })\"\"\",\n\"\"\"        last_verdict = $(if ($lastVerdict) { @{ label = $lastVerdict.label; overall = (GP $lastVerdict.verdict 'overall'); judge = (GP $lastVerdict.verdict 'judge_model'); date = $lastVerdict.date } } else { $null })\"\"\")\n\ns = s.replace(\"\"\"            state_revisions = $(if ($state -and $state.revisions) { $state.revisions } else { $null })\"\"\",\n\"\"\"            state_revisions = $(GP $state 'revisions')\"\"\")\n\ns = s.replace(\"\"\"            line = $(if ($data.state -and $data.state.line) { $data.state.line } else { $null })\n            direction = $(if ($data.state -and $data.state.direction_in_force) { $data.state.direction_in_force.ref } else { $null })\n            direction_clarity = $(if ($data.state -and $data.state.direction_in_force) { $data.state.direction_in_force.clarity } else { $null })\n            budget = $(if ($data.state -and $data.state.direction_in_force -and $data.state.direction_in_force.budget) { $data.st