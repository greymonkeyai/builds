{"jsonrpc":"2.0","id":"58a731eb-a418-4426-b690-3ab80a0f17a2","method":"fs/write_text_file","params":{"sessionId":"ubiquitous-eyebrow","path":"C:\\builds\\harness-ui\\version 0.1.0.001\\shell\\styles.css","content":":root {\r\n  --bg: #f7f7f4; --fg: #1c1c1a; --muted: #6b6b64; --line: #d8d8d0;\r\n  --accent: #295d8f; --gap: #fff3cd; --gapline: #d9b65c;\r\n  --ok: #2e7d32; --warn: #b26a00; --bad: #b3261e;\r\n  --mono: Consolas, \"Lucida Console\", monospace;\r\n}\r\n* { box-sizing: border-box; }\r\nbody { margin: 0; font: 14px/1.45 \"Segoe UI\", Tahoma, sans-serif; background: var(--bg); color: var(--fg); }\r\ncode, .mono { font-family: var(--mono); font-size: 12px; }\r\na { color: var(--accent); }\r\nh1 { font-size: 18px; margin: 0; }\r\nh2 { font-size: 15px; margin: 18px 0 6px; }\r\nh3 { font-size: 13px; margin: 14px 0 4px; }\r\nheader.top { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: baseline;\r\n  padding: 10px 16px; background: #efefe9; border-bottom: 1px solid var(--line); }\r\nheader.top .meta { color: var(--muted); font-size: 12px; }\r\n#app { max-width: 1200px; margin: 0 auto; }\r\nmain { padding: 12px 16px 40px; }\r\n.badge { display: inline-block; padding: 1px 7px; border-radius: 9px; font-size: 11px;\r\n  border: 1px solid var(--line); background: #fff; }\r\n.badge.live { border-color: var(--ok); color: var(--ok); }\r\n.badge.stale { border-color: var(--warn); color: var(--warn); }\r\ntable { border-collapse: collapse; width: 100%; margin: 8px 0; }\r\nth, td { text-align: left; padding: 4px 8px; border: 1px solid var(--line); vertical-align: top; }\r\nth { background: #efefe9; font-size: 12px; }\r\ntr.fleet-row { cursor: pointer; }\r\ntr.fleet-row:hover td { background: #eef4fa; }\r\n.absent, td.absent { color: var(--warn); font-style: italic; }\r\n.gap { background: var(--gap); border: 1px dashed var(--gapline); padding: 8px 12px;\r\n  border-radius: 4px; margin: 8px 0; }\r\n.gap::before { content: \"\\25B1 absent\"; font-family: var(--mono); font-size: 11px;\r\n  color: var(--warn); display: block; margin-bottom: 2px; }\r\n.tabs { display: flex; gap: 4px; margin: 10px 0 0; border-bottom: 1px solid var(--line); }\r\n.tabs button { border: 1px solid var(--line); border-bottom: none; background: #eceee6;\r\n  padding: 5px 14px; cursor: pointer; font-size: 13px; border-radius: 4px 4px 0 0; }\r\n.tabs button.active { background: #fff; font-weight: 600; }\r\n.pane { background: #fff; border: 1px solid var(--line); border-top: none; padding: 12px; }\r\n.kv th { width: 220px; }\r\npre { background: #f4f4ef; border: 1px solid var(--line); padding: 8px; overflow: auto;\r\n  font-family: var(--mono); font-size: 11.5px; max-height: 420px; }\r\n.status-file { white-space: pre-wrap; font-family: var(--mono); font-size: 11px;\r\n  background: #f4f4ef; border: 1px solid var(--line); padding: 6px 8px; margin: 4px 0; }\r\n.legend { display: flex; flex-wrap: wrap; gap: 10px; font-size: 12px; margin: 6px 0; }\r\n.legend .sw { display: inline-block; width: 14px; height: 4px; vertical-align: middle;\r\n  margin-right: 4px; border-radius: 2px; }\r\n.matrix td, .matrix th { font-size: 11px; padding: 3px 6px; text-align: center; }\r\n.matrix td.rowh, .matrix th.rowh { text-align: left; font-family: var(--mono); white-space: nowrap; }\r\n.cell-conformed { background: #dff0d8; color: var(--ok); }\r\n.cell-reckoned { background: #fce8c8; color: var(--warn); }\r\n.cell-silent { background: #f6d5d3; color: var(--bad); font-weight: 700; }\r\n.cell-gap { background: repeating-linear-gradient(45deg,#fff,#fff 5px,#f0e6c8 5px,#f0e6c8 8px); color: var(--warn); }\r\n.cell-na { color: var(--muted); }\r\n.point { cursor: pointer; }\r\n.point:hover { stroke: #000; stroke-width: 1.5; }\r\n.depthbar { margin: 6px 0; font-size: 12px; }\r\n.muted { color: var(--muted); }\r\nul.cite { margin: 4px 0; padding-left: 18px; }\r\nul.cite li { font-family: var(--mono); font-size: 11.5px; }\r\n.refresh-note { font-size: 11px; color: var(--muted); }\r\n","_meta":{"cognition.ai/toolCallId":"write:0#d15576810d264b46b9f0e6644bc7448c","cognition.ai/suppressApproval":true}}}
