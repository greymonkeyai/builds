/preview"},"_meta":{"cognition.ai/preview_is_shell_command":true}}}],"rawInput":{"command":"python - <<'PYEOF'\np = r\"C:\\builds\\harness-ui\\version 0.1.0.001\\emitter\\harness-emit.ps1\"\ns = open(p,'rb').read().decode('utf-8-sig').replace('\\r\\n','\\n')\nfor m in [\"        Write-Log 'payload serialize start'\\n\", \"        Write-Log 'payload serialize done'\\n\",\n          \"        Write-Log 'fleetrow start'\\n\", \"        Write-Log 'fleetrow done'\\n\",\n          \"    Write-Log 'fleet literal start'\\n\"]:\n    assert m in s, m\n    s = s.replace(m, '', 1)\nopen(p,'wb').write(b'\\xef\\xbb\\xbf' + s.replace('\\n','\\r\\n').encode('utf-8'))\nprint('ok')\nPYEOF\nnode -e \"\nconst fs=require('fs');\nglobal.window={};\neval(fs.readFileSync('C:/builds/data.js','utf8'));\nconst f=window.HARNESS_DATA;\nconsole.log('fleet kind:', f.kind, 'projects:', f.projects.length);\nf.projects.forEach(p=>console.log(' -',p.id,'dir=',p.direction,'verdict=',p.last_verdict&&p.last_verdict.overall,'live(s)=',p.liveness_seconds));\neval(fs.readFileSync('C:/builds/project/display/data.js','utf8'));\nconst d=window.HARNESS_DATA.project;\nconsole.log('project:',d.id,'series:',d.series.length,'suite:',d.suite.length,'convIds:',d.convention_ids.length,'builds:',d.builds.length,'latest:',d.latest_build);\nd.series.forEach(s=>console.log('  series',s.label,'overall=',s.verdict&&s.verdict.overall,'crit=',s.verdict&&s.verdict.criteria.length,'scen=',s.verdict&&s.verdict.scenarios&&s.verdict.scenarios.length,'build=',s.build_folder));\nconsole.log('conv cells 004:', Object.keys(d.builds[3].conventions).length);\nconsole.log('cs corpus ids:', d.current_state.corpus_convention_ids.length, 'mtime:', d.current_state.corpus_prompt_mtime);\n\""},"_meta":{"cognition.ai/commandNames":["python","node"],"cognition.ai/inferenceToolName":"exec","cognition.ai/timestamp":"2026-11-23T23:51:14.274013200+00:00"}}}}
